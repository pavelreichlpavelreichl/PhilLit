@article{cronin2003democracy,
    author = "Cronin, Ciaran",
    title = "Democracy and Collective Identity: In Defence of Constitutional Patriotism",
    journal = "European Journal of Philosophy",
    year = "2003",
    volume = "11",
    number = "1",
    pages = "1--28",
    doi = "10.1111/1468-0378.00172",
    note = {CORE ARGUMENT: Cronin defends Habermas's constitutional patriotism as a coherent account of the collective identity a legitimate democratic order requires, arguing against critics who hold that democratic solidarity must ultimately rest on pre-political, ethnic-national bonds. [Note: abstract not available from indexed sources; core-argument description is based on the article's title/topic and its documented status, confirmed via its inclusion in the SEP "Patriotism" entry bibliography, as a principal philosophical defense of the concept.] RELEVANCE: Directly addresses this domain's first key question (grounding solidarity without ethnic/national identity) and its third (defending against skeptics of "thin" identity); listed in SEP's own bibliography for "Patriotism," confirming its standing as a reference-point defense. POSITION: Reconstructive/discourse-theoretic defense of constitutional patriotism against communitarian and nationalist objections.},
    keywords = "constitutional-patriotism, solidarity, collective-identity, Cronin, INCOMPLETE, no-abstract, High"
}

@article{markell2000affect,
    author = "Markell, Patchen",
    title = {Making Affect Safe for Democracy? On "Constitutional Patriotism"},
    journal = "Political Theory",
    year = "2000",
    volume = "28",
    number = "1",
    pages = "38--63",
    doi = "10.1177/0090591700028001003",
    note = {CORE ARGUMENT: Markell examines the post-1989 revival of the distinction between "civic" and "ethnic" nationalism, arguing that this distinction has been embraced by political theorists not only because of renewed nationalism worldwide but because it promises to resolve an older problem for liberal democratic theory: liberalism's discomfort with the affective dimensions of political life (belonging, loyalty, passion) and its critics' charge that a purely procedural public sphere cannot sustain the loyalties that feed it. Constitutional patriotism, as a species of "civic" attachment, is examined as an attempt to isolate a kind of political identification purified of the affective, quasi-ethnic investments that liberals distrust -- an isolation whose success Markell calls into question. RELEVANCE: Supplies the domain's central "thin identity cannot sustain solidarity" critique named in this domain's third key question, questioning whether the civic/ethnic distinction underlying constitutional patriotism actually escapes the affective dynamics of nationalism rather than merely relocating them. POSITION: Critical of the assumption, shared by constitutional patriotism and the broader civic/ethnic nationalism distinction, that a purely rational/procedural identification can substitute for affectively-laden collective belonging.},
    keywords = "constitutional-patriotism, affect, civic-ethnic-nationalism, critique, Markell, High",
    abstract = {The past few years have witnessed rediscovery of an old distinction between civic and ethnic nationalisms. This renaissance has been driven in part by the new prominence of nationalism on the world political scene in the wake of the events of 1989. Yet the distinction between civic and ethnic nationalisms, however timely, has been taken up with special eagerness by political theorists because it also speaks to a problem in the theory of liberal democracy that antedates the most recent wave of nationalism, namely, the question of the relationship between liberal democracy and the affective dimensions of political life. Skeptical of passion and identification, liberals have tried to exchange the dangerous romance of polis and patria for the calm certitudes of reason, or for the underrated pleasures of what Hobbes calls "peaceable, sociable, and comfortable living." In turn, liberalism's critics have charged that its aversion to affect is unsustainable: modern procedural liberalism has no room for the strong passions of belonging, loyalty, and allegiance that self-government requires. The concern is that the public sphere cannot stand so serenely above the loyalties that feed it. The distinction between civic and ethnic nationalisms has offered liberals an attractive answer to this charge because it promises to isolate a kind of...},
    abstract_source = "openalex"
}

@article{lacroix2009doeseurope,
    author = "Lacroix, Justine",
    title = "Does Europe Need Common Values? Habermas vs Habermas",
    journal = "European Journal of Political Theory",
    year = "2009",
    volume = "8",
    number = "2",
    pages = "141--156",
    doi = "10.1177/1474885108100850",
    note = {CORE ARGUMENT: Lacroix argues there is a discrepancy between Habermas's initial plea for critical and rational post-national identities, in which constitutional patriotism functions as a critical standard for existing political practices, and his more recent political writings on Europe, which lose reflexive distance and glorify a "thick," distinctive (even superior) European identity contrasted with the United States. She argues this "Europatriotic" turn has no genuinely federative dimension and could undermine the normative potential of a political entity composed of distinct identities, and calls instead for a liberal postnationalism that refuses to tie Europe's legitimacy to any identification logic. RELEVANCE: Directly addresses this domain's application of constitutional patriotism to European integration and complicates the "thin identity" model by showing Habermas's own later writing drifting toward thicker value-commitments, a tension relevant to skeptics about whether purely procedural identification can sustain political solidarity at any scale. POSITION: Internal critique -- accepts the constitutional patriotism framework but argues Habermas's later European writings are in tension with its founding proceduralist commitments ("Habermas vs Habermas").},
    keywords = "constitutional-patriotism, European-Union, Lacroix, postnational, High",
    abstract = {This article argues that there is a discrepancy between Jürgen Habermas's initial plea for critical and rational identities and his more recent glorification of the European model. Initially, Constitutional Patriotism could be apprehended as a critical standard for existing political practices. However, Habermas's recent political texts tend to lose all kind of reflexive distance in their apprehension of the European identity -- which is presented as distinct and even superior to its counter-model, the US. Such a `Europatriotic' temptation should be resisted. The `thick' European identity advocated by Habermas has no truly federative dimension and could undermine the unique normative potential of a political entity composed of distinct identities. Consequently, the article suggests an elucidation of liberal postnationalism with a view to explaining its refusal to tie Europe's legitimacy to an identification logic.},
    abstract_source = "openalex"
}

@misc{ingram1996constitutionalpatriotism,
    author = "Ingram, Attracta",
    title = "Constitutional Patriotism",
    year = "1996",
    volume = "22",
    number = "6",
    pages = "1--18",
    doi = "10.1177/019145379602200601",
    note = {CORE ARGUMENT: Ingram asks whether the unity of the state can be conceived apart from the unity of the nation, and whether shared political values are insufficient to account for the existence of bounded states and special duties to compatriots. Against the view that the modern state tacitly relies on a nation-based idea of membership, she argues that Habermasians and Rawlsians are right to think that a shared commitment to justice can itself be sufficient for political unity, and briefly applies this account to the case of European Union integration. RELEVANCE: An early (pre-dating Cronin's and Müller's fuller treatments) philosophical defense that constitutional-patriotism-style, justice-based political unity can substitute for nationhood; directly relevant to this domain's first key question and its EU-application strand alongside Lacroix and Rosenfeld. POSITION: Reconstructive defense of a justice-based (rather than strictly discourse-theoretic) account of post-national political unity.},
    keywords = "constitutional-patriotism, political-unity, European-Union, Ingram, High, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "In this paper, I want to look at some questions that arise when we try to abandon the conceptual and political framework of the nation-state. Is it impossible to conceive the unity of the state apart from the unity of the nation? Are shared political values insufficient to account for the existence of bounded states and special duties to one's own country? In the first section I will discuss the view that the idea of the modern state is incoherent and that it tacitly relies on the social idea of membership provided by the nation. The following section will give an alternative to the nationalist account of the existence of bounded communities and suggest why Habermasians and Rawlsians are right in thinking that the shared value of justice can be sufficient for political unity. Finally, I give a brief indication of the relevance of this discussion to the idea of European Union.",
    abstract_source = "openalex"
}

@article{michelman2001morality,
    author = "Michelman, Frank I.",
    title = {Morality, Identity and "Constitutional Patriotism"},
    journal = "Ratio Juris",
    year = "2001",
    volume = "14",
    number = "3",
    pages = "253--271",
    doi = "10.1111/1467-9337.00181",
    note = {CORE ARGUMENT: Michelman argues that in a modern, plural society there can be no settled agreement on the concrete legal content of a country's constitution, yet the idea of the constitution remains pivotal in liberal-minded theories of political justification such as those of Habermas and Rawls. He shows that justification in these theories ultimately depends on "constitutional patriotism" -- a consciously shared sentiment, arising from citizens' ethical assessment of their country, that the country credibly pursues the regulative political ideal for which its constitution stands -- and probes what this justificatory move requires of citizens' moral identity. RELEVANCE: Connects constitutional patriotism directly to the discourse-theoretic legitimacy questions treated in this project's law-and-democracy domain, examining constitutional patriotism specifically as a justificatory device (shared by Habermas and Rawls) rather than only as an identity concept, and probing the same "can thin identification do this normative work" question that motivates Markell's and Hayward's critiques. POSITION: Critical-analytic; interrogates rather than straightforwardly defends the justificatory role assigned to constitutional patriotism in Habermasian and Rawlsian theories.},
    keywords = "constitutional-patriotism, legitimacy, Michelman, Medium",
    abstract = {In a modern, plural society, there can be no settled agreement on the concrete legal content of a country's constitution. The idea of the constitution is nonetheless pivotal in contemporary, liberal-minded theories of political justification, such as the ones advanced by Jürgen Habermas and John Rawls. Justification in these theories depends finally on ``constitutional patriotism,'' a consciously shared sentiment arising from an ethical assessment of their country by the country's people, according to which the country credibly pursues a certain regulative political ideal for which the constitution stands.},
    abstract_source = "openalex"
}

@misc{pensky1989useandabuse,
    author = "Pensky, Max",
    title = {On the Use and Abuse of Memory: Habermas, "Anamnestic Solidarity," and the Historikerstreit},
    year = "1989",
    volume = "15",
    number = "4",
    pages = "351--380",
    doi = "10.1177/019145378901500402",
    note = {CORE ARGUMENT: Pensky examines Habermas's concept of "anamnestic solidarity" -- solidarity extended backward in time to the victims of past injustice, particularly the victims of Nazism -- as it emerged from his interventions in the Historikerstreit, the mid-1980s West German dispute over whether Nazi crimes could be historically relativized or normalized within a continuous national narrative. [Note: abstract not available from indexed sources despite multiple source attempts; description is based on the article's title and topic, and its status as a contemporaneous (1989) philosophical response to the Historikerstreit.] RELEVANCE: Directly addresses this domain's second key question, providing the fullest treatment among the papers gathered here of how the Historikerstreit specifically shaped Habermas's account of post-war German identity and its connection to constitutional patriotism. POSITION: Expository/critical reconstruction of the memory-politics dimension of Habermas's constitutional patriotism, published contemporaneously with the Historikerstreit itself.},
    keywords = "historikerstreit, memory, anamnestic-solidarity, Pensky, INCOMPLETE, no-abstract, Medium, METADATA\_CLEANED: journal, type:@article->@misc"
}

@article{rosenfeld2007habermascall,
    author = "Rosenfeld, Michel",
    title = "Habermas's Call for Cosmopolitan Constitutional Patriotism in an Age of Global Terror: A Pluralist Appraisal",
    journal = "Constellations",
    year = "2007",
    volume = "14",
    number = "2",
    pages = "159--181",
    doi = "10.1111/j.1467-8675.2007.00431.x",
    note = {CORE ARGUMENT: Rosenfeld appraises Habermas's post-9/11 extension of constitutional patriotism from the level of the nation-state and the EU to a "cosmopolitan" register meant to address global terror, evaluating this extension from the standpoint of legal and constitutional pluralism. [Note: abstract not available from indexed sources; core-argument description is based on the article's title/topic and its placement, alongside Müller's and Hayward's contributions, in the 2007 Constellations symposium on constitutional patriotism.] RELEVANCE: Extends this domain's European-integration application of constitutional patriotism to the cosmopolitan/global scale, complementing Lacroix's argument that Habermas's later writings strain the concept's original proceduralist commitments. POSITION: Pluralist appraisal -- neither a straightforward defense nor rejection, but an assessment of the concept's cosmopolitan extension from a legal-pluralist standpoint.},
    keywords = "constitutional-patriotism, cosmopolitanism, Rosenfeld, INCOMPLETE, no-abstract, Medium"
}

@article{hayward2007democracysidentity,
    author = "Hayward, Clarissa Rile",
    title = {Democracy's Identity Problem: Is "Constitutional Patriotism" the Answer?},
    journal = "Constellations",
    year = "2007",
    volume = "14",
    number = "2",
    pages = "182--196",
    doi = "10.1111/j.1467-8675.2007.00432.x",
    note = {CORE ARGUMENT: Hayward addresses democracy's "identity problem" -- the question of how "the people" who are supposed to author and be bound by a democratic constitution can be non-arbitrarily bounded and identified prior to any democratic procedure -- and asks whether constitutional patriotism actually resolves this boundary problem or merely redescribes it in different terms. [Note: abstract not available from indexed sources; core-argument description is based on the article's title/topic and its placement in the 2007 Constellations symposium alongside Müller's and Rosenfeld's contributions.] RELEVANCE: Supplies a distinct line of critique from Markell's affect-based objection, targeting instead the "boundary problem" of democratic self-constitution, directly relevant to this domain's third key question about whether constitutional patriotism can sustain solidarity and legitimate demarcation of a political community. POSITION: Skeptical -- questions whether constitutional patriotism supplies a genuine answer to democracy's identity/boundary problem.},
    keywords = "constitutional-patriotism, boundary-problem, critique, Hayward, INCOMPLETE, no-abstract, Medium"
}

@misc{habermas2001postnational,
    author = "Habermas, Jürgen",
    title = "The Postnational Constellation: Political Essays",
    year = "2001",
    note = {CORE ARGUMENT: Habermas argues that economic globalization has undermined the nation-state's capacity to secure the democratic self-determination, social solidarity, and legal order that it had historically bundled together, producing a "postnational constellation" in which these achievements must be re-secured through new transnational and cosmopolitan legal-political forms rather than through a nostalgic defense of state sovereignty. RELEVANCE: This is the foundational text for the domain: it introduces the diagnosis (loss of state capacities under globalization) and the normative response (constitutionalizing international law, redesigning the EU as an intermediate transnational polity) that all subsequent secondary literature in this file responds to, defends, or criticizes. POSITION: Discourse-theoretic cosmopolitanism; translated and introduced by Max Pensky (Cambridge, MA: MIT Press, 2001).},
    keywords = "postnational-constellation, cosmopolitanism, discourse-theoretic-cosmopolitanism, primary-anchor, INCOMPLETE, no-abstract, High, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{habermas2012crisis,
    author = "Habermas, J.",
    title = "The Crisis of the European Union in the Light of a Constitutionalization of International Law",
    year = "2012",
    number = "2",
    note = {CORE ARGUMENT: Habermas reframes the Eurozone crisis as a symptom of an incomplete process by which international treaties among European states have progressively taken on features of a democratic constitution; he argues that the currently favored solution of transforming EU governance into "executive federalism" run by heads of state and finance ministries abandons this constitutionalizing trajectory and its democratic promise. RELEVANCE: Supplies the immediate primary-text target for the EU-specific critical literature collected here (Lubenow 2016; Patberg 2014; Streeck 2014), all of which engage directly with the diagnosis and institutional proposals advanced in this essay and the accompanying book The Crisis of the European Union: A Response. POSITION: Discourse-theoretic constitutionalization of international law, applied specifically to the EU; primary-source anchor for the domain's EU-technocracy debates.},
    keywords = "european-union, constitutionalization-of-international-law, eurozone-crisis, primary-anchor, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The crisis of the European Union showcases the asymmetry between transnational capacities for political action and social as well as economic forces unleashed at the transnational level. But recovering the regulatory power of politics by way of increased supranational organization frequently arouses fears about the fate of national democracy and of the democratic sovereign threatened to be dispossessed by executive powers operating independently at the global level. Against such political defeatism this contribution takes the example of the European Union to refute the underlying claim that a transnationalization of popular sovereignty cannot be achieved without lowering the level of democratic legitimation. It focuses on three components of every democratic polity – the association of free and equal legal persons, a bureaucratic organization for collective action, and civic solidarity as a medium of political integration – to argue that the new configuration they take at the European level, when compared with the context of the nation-state, does not in principle diminish the democratic legitimacy of the new transnational polity. The contribution continues to argue, however, that the sharing of sovereignty between the peoples and citizens of Europe needs to be better reflected in symmetry between Council and Parliament while political leadership and the media must contribute to a greater sense of civil solidarity.",
    abstract_source = "openalex"
}

@article{fine2003habermass,
    author = "Fine, Robert and Smith, William",
    title = "Jürgen Habermas's Theory of Cosmopolitanism",
    journal = "Constellations",
    year = "2003",
    volume = "10",
    number = "4",
    note = {CORE ARGUMENT: Fine and Smith reconstruct how Habermas takes up Kant's cosmopolitan right in his post-1989 writings, arguing that Habermas seeks to "think with Kant against Kant" (following Apel) by radicalizing, socializing, and modernizing Kant's cosmopolitanism to fit a world of interdependent nation-states rather than a league of sovereign republics. The paper then critically assesses the dilemmas Habermas faces in grounding a normative commitment to cosmopolitan politics while reconciling it with the residually national framework of his own constitutional-patriotism and deliberative-democracy commitments. RELEVANCE: Directly addresses the project's question of how Habermas grounds cosmopolitan law in discourse theory and its relation to Kant; identifies the specific internal tension — cosmopolitanism versus the national anchoring of constitutional patriotism — that recurs across the domain's EU-focused literature. POSITION: Sympathetic-critical reconstruction from within the critical-theory tradition; treats Habermas's cosmopolitanism as an unstable synthesis rather than either endorsing or rejecting it outright.},
    keywords = "kant, cosmopolitan-law, constitutional-patriotism, discourse-theoretic-cosmopolitanism, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract In this paper we explore the sustained and multifaceted attempt of Jürgen Habermas to reconstruct Kant's theory of cosmopolitan right for our own times. In a series of articles written in the post‐1989 period, Habermas has argued that the challenge posed both by the catastrophes of the twentieth century, and by social forces of globalization, has given new impetus to the idea of cosmopolitan justice that Kant first expressed. He recognizes that today we cannot simply repeat Kant's eighteenth‐century vision: that if we are to grapple with the complexities of present‐day problems, it is necessary to iron out certain inconsistencies in Kant's thinking, radicalize it where its break from the old order of nation‐states is incomplete, socialize it so as to draw out the connections between perpetual peace and social justice, and modernize it so as to comprehend the “differences both in global situation and conceptual framework that now separate us from him.” 1 His basic intuition, however, is that Kant's idea of cosmopolitan right is as relevant to our times as it was to Kant's own. If it was Kant's achievement to formulate the idea of cosmopolitanism in a modern philosophical form, Habermas takes up the challenge posed by Karl‐Otto Apel: to “think with Kant against Kant” in reconstructing this idea. What follows is a critical assessment of Habermas's response to this challenge. We focus here on the dilemmas he faces in grounding his normative commitment to cosmopolitan politics and in reconciling his cosmopolitanism with the national framework in which he developed his ideas of constitutional patriotism and deliberative democracy.",
    abstract_source = "openalex"
}

@article{mertens1996cosmopolitanism,
    author = "Mertens, Thomas",
    title = "Cosmopolitanism and Citizenship: Kant Against Habermas",
    journal = "European Journal of Philosophy",
    year = "1996",
    volume = "4",
    number = "3",
    note = "CORE ARGUMENT: As its title signals, the paper stages Kant's own cosmopolitan right against Habermas's discourse-theoretic reconstruction of it, arguing (on the evidence of the title and its placement in the cosmopolitanism literature, since no abstract could be located) that Habermas's revisions of Kant on cosmopolitan citizenship depart from Kant in ways that are open to serious objection rather than being a legitimate updating of Kant's own premises. RELEVANCE: One of the earliest sustained treatments of exactly the Kant/Habermas relation the project's key questions ask about, published shortly after Habermas's own cosmopolitanism essays began appearing in the early-to-mid 1990s; provides an early counterpoint to the more recent, more sympathetic reconstruction in Fine and Smith (2003). POSITION: Kantian reassertion against Habermas's discourse-theoretic revision of cosmopolitan right. [INCOMPLETE: no abstract located in S2, OpenAlex, or CORE; annotation based on title and bibliographic context only.]",
    keywords = "kant, cosmopolitan-law, discourse-theoretic-cosmopolitanism, INCOMPLETE, no-abstract, Medium, METADATA\_CLEANED: pages, doi"
}

@misc{scheuerman2009postnational,
    author = "Scheuerman, William E.",
    title = "Postnational democracies without postnational states? Some skeptical reflections",
    year = "2009",
    number = "1",
    note = {CORE ARGUMENT: Scheuerman critically interrogates the "global governance without government" model embraced by prominent critical theorists including Habermas, focusing on Hauke Brunkhorst's radical-democratic elaboration of it. He argues that Brunkhorst's (and by extension Habermas's) interpretation of the EU as an emerging instance of postnational democracy, together with Kelsenian claims about the primacy of global law, cannot substitute for the establishment of genuine postnational statehood, which robust democracy "beyond the nation-state" will necessarily require. RELEVANCE: Provides the central realist/institutionalist objection to Habermas's postnational-constellation model addressed by the project's second key question: it directly disputes whether Habermas's proposed institutional forms for transnational democracy (multi-level governance without a corresponding state apparatus) are adequate to secure democratic legitimacy. POSITION: Realist-institutionalist critique from within critical theory; argues postnational statehood, not merely postnational law, is a precondition of postnational democracy. Provoked a direct published reply from Brunkhorst in the same journal issue.},
    keywords = "postnational-constellation, global-governance, realist-critique, european-union, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Prominent critical theorists (including Jürgen Habermas) have embraced a radical democratic version of the popular notion of ‘global governance without government,’ according to which postnational democratization can be achieved without establishing robust firms of postnational statehood. The sources of the argument in Hauke Brunkhorst's recent theorizing are critically interrogated. Brunkhorst's interpretation of the European Union as an emerging case of postnational democracy, his critique of traditional ideas of state sovereignty, and Kelsenian notions about the primacy of global law are criticized. Robust democracy ‘beyond the nation-state’ will necessarily require the establishment of democratic postnational statehood.",
    abstract_source = "s2"
}

@misc{lubenow2016paradox,
    author = "Lubenow, Jorge Adriano",
    title = "The paradox of technocratic democracy and the democratic deficit of european institutions by Jürgen Habermas",
    year = "2016",
    number = "2",
    note = {CORE ARGUMENT: Lubenow reconstructs Habermas's account of how the EU's economic-liberal reorientation of the welfare state, coupled with a "decoupled" technocratic policy-making model, has produced and continued to reproduce the Union's democratic deficit despite numerous institutional reforms. Following Habermas, the paper argues the deficit cannot be closed by further technocratic centralization but only by a deeper democratization of European institutions that replaces the technocratic approach. RELEVANCE: Provides the domain's clearest secondary-literature statement of Habermas's critique of EU technocracy specifically requested for this file, connecting his general postnational-constellation diagnosis to the concrete institutional pathology of "governing without democratizing" in the EU. POSITION: Expository-sympathetic reconstruction of Habermas's own diagnosis of EU technocratic democracy, rather than an external critique of it.},
    keywords = "european-union, technocracy, democratic-deficit, postnational-constellation, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "In the nineties, Habermas redirected his political writings to the post-national constellation (global and European) and the possibilities of a society politically integrated through transnational democracy (or post-national democracy). This thematic reorientation took place on two fronts. The first one is the global transnational democracy, which includes the impacts of the economic globalization on national democracies, as well the proposal for a political Constitution for a pluralistic world society, based on a constitutionalization of international law. The second one is the European transnational democracy, which includes the redefinition of the political profile of European welfare state for an economic liberal profile, as well the paradox of democratic technocracy operated by European institutions and the proposal to overcome the decoupled technocratic policy model. This paper will address only this last topic, describing the reasons of the democratic deficit and the consequent delay of European political Union. Despite numerous reforms, the technocratic policies have not eliminated the discrepancy between centralization and democratization, and mistakenly indicate another direction further reinforcing the problem of European undemocratic institutions. In contrast, Habermas argues that the democratic deficit could only be overcome replacing the technocratic approach by a deeper democratization of European institutions.",
    abstract_source = "openalex"
}

@misc{trejomathys2012towards,
    author = "Trejo-Mathys, Jonathan",
    title = "Towards a discourse-theoretical account of authority and obligation in the postnational constellation",
    year = "2012",
    volume = "38",
    number = "6",
    note = {CORE ARGUMENT: Trejo-Mathys argues that standard approaches to political authority and obligation are inadequate to the supranational forms of authority now emerging beyond the nation-state and beyond traditional international law. Using a concrete example of such supranational authority, he argues Habermas's discourse theory of law and politics is the most promising resource for an adequate account, but subjects Habermas's own recent writings on the global political order to an "internal" critique on this basis. RELEVANCE: Extends the project's question about institutional forms for transnational democracy by testing whether discourse theory itself — not just Habermas's particular institutional proposals — can generate a satisfactory account of supranational political authority and obligation. POSITION: Internal (sympathetic but critical) discourse-theoretic reconstruction; argues discourse theory is the right framework but that Habermas has not yet adequately worked out its implications for supranational authority.},
    keywords = "postnational-constellation, discourse-theoretic-cosmopolitanism, political-authority, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Normative questions concerning political authority and political obligation are widely seen as central questions of political philosophy. Current global transformations require an innovative response from normative political thinking about these two topics. In light of a concrete example of the supranational forms of authority and obligation that have been and are emerging beyond the national state and beyond the traditional domains of international law, I lay out what has become the standard approach to authority and obligation and indicate why this approach is inadequate in contemporary circumstances. I sketch an alternative approach and suggest how the most promising exemplar of this kind, Habermas’ discourse theory of law and politics, can better deal with the example. Having thus made plausible the advantages of the discourse theory of the alternative approach, I end with an ‘internal’ critique of Habermas’ own recent writings on the global political order.",
    abstract_source = "s2"
}

@misc{roele2014vicious,
    author = "Roele, Isobel",
    title = "The Vicious Circles of Habermas' Cosmopolitics",
    year = "2014",
    number = "3",
    note = {CORE ARGUMENT: Roele argues that Habermas's cosmopolitan project, which seeks to compensate for the disempowering effects of globalization by transforming global politics into an emancipatory activity, is caught in three self-undermining "vicious circles" stemming from Habermas's commitment to intersubjectivity. She contends that Habermas's domestic fix for this circularity (constitutionalizing transcendental presuppositions participants cannot avoid making) cannot work at the global level because that level is pre-political as between individuals, so his cosmopolitics ultimately abandons its own intersubjective grounding by relying on a prediscursive concept of human dignity -- a move that opens the door to moralizing politics and imposing human rights by force. RELEVANCE: Represents the domain's legal-theoretic strand of skepticism about Habermas's cosmopolitics, complementing Scheuerman's political-realist and Streeck's political-economy objections with a critique grounded in legal theory/critical legal studies. POSITION: Critical legal-theory critique of Habermas's cosmopolitics as internally circular and ultimately reliant on a prediscursive foundation it cannot consistently justify.},
    abstract = {Habermas' cosmopolitan project seeks to transform global politics into an emancipatory activity in order to compensate for the disempowering effects of globalization. The project is traced through three vicious circles which stem from Habermas' commitment to intersubjectivity. Normative politics always raises a vicious circle because politics is only needed to the extent that an issue has become problematized through want of intersubjective agreement. At domestic level Habermas solves this problem by constitutionalizing transcendental presuppositions that political participants cannot avoid making. This fix will not work at the global level because it is pre-political as between human individuals. Habermas therefore premises cosmopolitics on the transformation of nation-states into sites of participatory politics, engagement in which will eventually ignite a global cosmopolitan consciousness. This transformation depends on the constitutionalization of existing UN structures and their enforcement of an undefined and (therefore) `uncontroversial' core of human rights. Unable to ground this project in social practice, Habermas eventually disregards his own lodestar of intersubjectivity based in social practice by relying on the prediscursive concept of human dignity. This move is not merely philosophically inconsistent; it also opens the door to the moralization of politics and the imposition of human rights down the barrel of a gun.},
    abstract_source = {core},
    keywords = "cosmopolitanism, cosmopolitan-law, legal-theory, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@article{streeck2014smallstate,
    author = "Streeck, Wolfgang",
    title = "Small-State Nostalgia? The Currency Union, Germany, and Europe: A Reply to Jürgen Habermas",
    journal = "Constellations",
    year = "2014",
    number = "2",
    note = {CORE ARGUMENT: Streeck replies directly to Habermas's proposals for the currency union, arguing (per the article's subsection structure on "The Currency Union and the German Interest" and "Democracy and Capitalism") that Habermas underestimates how a currency union without a corresponding fiscal and political union structurally entrenches German economic dominance and national interest rather than fostering the transnational democratic solidarity Habermas's postnational model requires. RELEVANCE: Supplies the domain's key political-economy critique of Habermas's institutional proposals for the EU, directly engaging the "reply to Habermas" genre that structures much of the EU-specific secondary literature in this file (compare Lubenow 2016; Patberg 2014). POSITION: Political-economy realist critique from a comparative-political-economy (rather than legal-theoretic or discourse-theoretic) standpoint; skeptical that Habermas's constitutionalizing proposals can overcome the capitalist and national-interest constraints on European integration.},
    keywords = "european-union, eurozone-crisis, political-economy, realist-critique, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = "The Currency Union and the German Interest Habermas, Germany, and European Democracy Once Again and Still: Democracy and Capitalism Citing Literature",
    abstract_source = "openalex"
}

@misc{patberg2014supranational,
    author = "Patberg, Markus",
    title = "Supranational constitutional politics and the method of rational reconstruction",
    year = "2014",
    number = "6",
    note = {CORE ARGUMENT: Patberg examines Habermas's claim, in The Crisis of the European Union, that constituent power in the EU is shared between the community of EU citizens and the political communities of the member states (a "dual constituent subject" reached via rational reconstruction of the genesis of the European constitution). Finding this explanation insufficiently illuminating because the term "rational reconstruction" itself is contested, Patberg critically surveys the current state of research on rational reconstruction, develops a new reading of Habermas's method, and uses it to explain and evaluate the notion of a European pouvoir constituant mixte. RELEVANCE: Addresses the project's institutional-forms question directly by scrutinizing the methodological basis (rational reconstruction) for Habermas's specific proposal for EU constituent power, showing how contested the method itself is even among sympathetic readers. POSITION: Methodologically internal critique; refines rather than rejects Habermas's dual-constituent-power model for the EU.},
    keywords = "european-union, constituent-power, rational-reconstruction, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "In The Crisis of the European Union Jürgen Habermas claims that the constituent power in the EU is shared between the community of EU citizens and the political communities of the member states. By his own account, Habermas arrives at this concept of a dual constituent subject through a rational reconstruction of the genesis of the European constitution. This explanation, however, is not particularly illuminating since it is controversial what the term ‘rational reconstruction’ stands for. This article critically discusses the current state of research on rational reconstruction, develops a new reading of Habermas’ method and invokes this account for an explanation and evaluation of the notion of a European pouvoir constituant mixte .",
    abstract_source = "openalex"
}

@article{cohen2008rethinking,
    author = "Cohen, Jean L.",
    title = "Rethinking Human Rights, Democracy, and Sovereignty in the Age of Globalization",
    journal = "Political Theory",
    year = "2008",
    volume = "36",
    number = "4",
    note = {CORE ARGUMENT: Cohen argues that the traditional conception of human rights as pre-political moral rights, well-suited to the post-WWII revival of human rights discourse and to anti-dictatorship struggles, no longer fits the new function human rights discourse has acquired since 1989 — justifying sanctions, military intervention, and transformative occupation by outside powers framed as international-law enforcement. She analyzes two recent "political" alternatives to the traditional conception (one of which is Habermas's cosmopolitan/constitutionalization-of-international-law model) and argues for a third, on the thesis that sovereign equality and human rights are jointly necessary normative principles of a genuinely dualist (state-based and cosmopolitan) international system. RELEVANCE: Engages Habermas's discourse-theoretic grounding of human rights and cosmopolitan law from within the broader political-theory debate over how to reconceive human rights after the Cold War, testing whether his model can avoid instrumentalization for great-power intervention — a central worry behind realist and postcolonial-adjacent objections to cosmopolitan law. POSITION: Constructs an alternative "political" conception of human rights and sovereignty situated critically against, though not simply opposed to, Habermas's constitutionalization-of-international-law approach.},
    keywords = "human-rights, cosmopolitan-law, constitutionalization-of-international-law, sovereignty, High, METADATA\_CLEANED: pages, doi",
    abstract = "The traditional conception construes human rights as moral rights all people have due to some basic feature or interests deemed intrinsically valuable. This comported well with the revival of the discourse of human rights in the wake of atrocities committed during WWII. It served as a useful referent for local struggles against foreign rule and domestic dictatorship in the 1980s. Since 1989, human rights discourse acquired a new function: the justification of sanctions, military invasions, and transformative occupation administrations by outsiders, framed as enforcement of international law against violators. The traditional conception doesn't fit this new function, hence the efforts to counter-pose a “political” to the “traditional” approach. This essay analyzes two recent versions of the political conception, and argues for a third. The thesis is that sovereign equality and human rights are normative principles of our dualist international system and both are needed to construct a more just version of that system.",
    abstract_source = "openalex"
}

@misc{fine2015europe,
    author = "Fine, Robert",
    title = "Europe and its Jews: a Cosmopolitan Journey with Jürgen Habermas",
    year = "2015",
    volume = "8",
    number = "3",
    note = "CORE ARGUMENT: Fine argues that Habermas, as a leading younger-generation critical theorist, is distinctive for confronting the legacy of European antisemitism in his vision of a postnational, cosmopolitan Europe, emphasizing ongoing engagement with that history as integral to reconstructing political community. Yet Fine finds cracks in this reconstruction that allow a residual European chauvinism back in and that risk the premature judgment that antisemitism has been solved in Europe, tracing how these cracks have provided footholds for new forms of antisemitism on the European landscape and for critical theory's difficulty in recognizing them. RELEVANCE: Offers the domain's most historically and politically situated critique of Habermas's postnational vision of Europe, testing his cosmopolitan self-understanding of European identity against a concrete historical test case rather than at the level of abstract institutional design. POSITION: Immanent critical-theory critique that endorses much of Habermas's analysis while identifying a specific point — the risk of an idealized cosmopolitan self-image — where his reconstruction of European identity falls short.",
    keywords = "cosmopolitanism, european-union, antisemitism, eurocentrism-critique, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "After the Holocaust European antisemitism did not simply vanish into thin air and critical theorists drew attention to the new or secondary forms of antisemitism that arose in the postwar period. Among them Jurgen Habermas, a leading figure in the younger generation of critical theorists, is remarkable for confronting the legacy of European antisemitism in his his vision of a new Europe. His approach to the postnational constellation emphasised the importance of ongoing engagement with the history of European antisemitism and of reconstructing political community in ways that should make antisemitism less feasible in the future. While this paper endorses much of Habermas' analysis, it is critical of cracks in the edifice of his reconstruction which allow back in a certain form of European chauvinism and which make it possible to reach the premature judgement that the problem of antisemitism has been solved in Europe. The last part of the paper addresses the actual ways in which the cracks in the postnational edifice have provided footholds for the unwelcome return of the 'Jewish question' to Europe and have made it difficult for critical theory to understand new forms of antisemitism emerging on the European landscape. The signs of an inversion of the cosmopolitan project - from critical engagement with the legacy of European antisemitism to an idealized image of European success in overcoming antisemitism - points to a misappropriation of cosmopolitanism that needs to be challenged.",
    abstract_source = "openalex"
}

@misc{lupel2005tasks,
    author = "Lupel, Adam",
    title = "Tasks of a global civil society: Held, habermas and democratic legitimacy beyond the nation-state",
    year = "2005",
    number = "1",
    note = {CORE ARGUMENT: Lupel examines three candidate forms of transnational politics that might broaden democratic legitimacy beyond the nation-state without sacrificing the collective capacity to make legitimately binding decisions: David Held's cosmopolitan democracy, "democratic regionalism" via Habermas's postnational constellation, and "democratic network governance" via global civil society. He argues each model confronts a tension between the particularity of existing contexts of democratic legitimacy and the universalism a transnational or global political culture demands, examining specifically whether Habermas's regionalist route (paradigmatically the EU) can chart a viable middle course between the globalizing present and a genuinely cosmopolitan future. RELEVANCE: Directly comparative treatment of the institutional-forms question at the heart of this domain, situating Habermas's postnational-constellation model against Held's more fully cosmopolitan-democratic alternative and against network-governance models, rather than assessing Habermas in isolation. POSITION: Comparative-critical assessment; treats Habermas's "democratic regionalism" as one of several structurally analogous attempts to solve the same legitimacy problem, each only partially successful.},
    keywords = "cosmopolitan-democracy, european-union, global-civil-society, held, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "In order for processes of globalization to continue without resulting in a corresponding loss of the collective capacity to make legitimately binding decisions, new mechanisms of democratic politics need to be developed. This article addresses three forms of transnational politics that could serve to broaden democratic legitimacy beyond the nation-state: (i) cosmopolitan democracy, (ii) democratic regionalism, and (iii) democratic network governance. Part one begins by examining David Held's important contributions to the project of rethinking liberal and social democracy in the context of globalization. It argues that if cosmopolitan democracy is to meet the challenges of globalization and address the need for transnational forms of democratic politics, it must be able to illuminate the very serious political obstacles to the democratization of transnational power. It must be able to articulate the forms of politics necessary to chart the course from globalizing present to cosmopolitan future. Parts two and three examine forms of politics seeking to chart such a middle course: Part two examines democratic regionalism through Jürgen Habermas' ‘postnational constellation’, and part three examines democratic network governance through the concept of ‘global civil society’. Each model, it is argued, encounters a tension between the particular contexts of democratic legitimacy and the universalism demanded of a transnational or even global political culture.",
    abstract_source = "s2"
}

@misc{degreiffcronin2002global,
    editor = "De Greiff, Pablo and Cronin, Ciaran",
    title = "Global Justice and Transnational Politics: Essays on the Moral and Political Challenges of Globalization",
    year = "2002",
    note = "CORE ARGUMENT: This edited collection, assembled by two of Habermas's principal English translators, gathers essays on the moral and political challenges globalization poses to justice and democratic legitimacy, situating Habermas's own postnational-constellation writings within a wider field of contemporaneous work on transnational politics and global justice rather than treating them as a self-standing intervention. RELEVANCE: Named specifically in this domain's research brief as a key collection bridging Habermas's own cosmopolitan/postnational writings and their critical reception; functions as a hinge text between the primary Habermas anchors in this file and the secondary critical literature (Fine and Smith 2003; Cohen 2008) responding to the same debates. POSITION: Edited volume spanning multiple positions on global justice and transnational politics rather than advancing a single thesis; reviewed in Ethics \\& International Affairs 16 (2002): 159-161.",
    keywords = "global-justice, transnational-politics, edited-volume, cosmopolitanism, INCOMPLETE, no-abstract, Medium, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{khan2013critical,
    author = "Khan, Gulshan",
    title = "Critical Republicanism: Jürgen Habermas and Chantal Mouffe",
    journal = "Contemporary Political Theory",
    year = "2013",
    volume = "12",
    number = "4",
    note = {CORE ARGUMENT: Khan argues that the standard contrast between Habermas's deliberative democracy and Mouffe's agonistic model is overstated. Reading both through the lens of "critical republicanism," she shows that much of Mouffe's criticism of discourse ethics does not withstand scrutiny, and that Habermas's theory already shares Mouffe's emphasis on civic solidarity, the constructive role of conflict, and self-government. RELEVANCE: This paper directly complicates the deliberation-versus-agonism framing found elsewhere in the literature (e.g., Brady 2004, Kapoor 2002) by arguing the two camps converge more than they diverge, making it a useful counterweight to more oppositional readings of the Habermas-Mouffe debate. POSITION: A reconciliatory reading that locates both Habermas and Mouffe within a shared republican problematic rather than treating agonism and deliberation as incommensurable paradigms.},
    keywords = "agonism, Mouffe, radical-democracy, republicanism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages, doi"
}

@article{russellmontin2015rationality,
    author = "Russell, Matheson and Montin, Andrew",
    title = "The Rationality of Political Disagreement: Rancière's Critique of Habermas",
    journal = "Constellations",
    year = "2015",
    volume = "22",
    number = "4",
    note = {CORE ARGUMENT: The authors reconstruct Jacques Rancière's attempt to break with Habermas's linguistic-pragmatic paradigm and to install an alternative model of political speech ("dissensus") that has "the rationality of disagreement as its very own rationality." They argue Rancière's departure from communicative action theory is subtle but ultimately cogent, and that it constitutes an innovative contribution to democratic theory in its own right, distinct from Mouffe's agonism. RELEVANCE: Provides the Rancière side of the "consensus vs. dissensus" debate specifically requested for this domain, complementing the more extensively covered Mouffe-Habermas literature with a genuinely distinct post-Marxist/post-structuralist critique of communicative rationality. POSITION: Sympathetic reconstruction of Rancière's dissensus model as a rival, not merely a variant, of Habermasian and Mouffean democratic theory.},
    keywords = "agonism, Ranciere, dissensus, radical-democracy, High, METADATA\_CLEANED: pages, doi",
    abstract = {Jacques Rancière's political thought is worked out in the form of disputes. He has engaged in polemics against an array of theorists including Althusser, Arendt, Bourdieu, Baudrillard, Foucault, Lefort, Lyotard, Derrida, Hardt and Negri, Agamben, Badiou and Nancy. But among this pantheon of greats, it strikes us that the dispute with Jürgen Habermas plays an especially pivotal role. It is hard to gauge the significance of Rancière's conception of politics for contemporary political theory without addressing his attempt to break with the Habermasian linguistic-pragmatic paradigm and to set up an alternative model of political speech (dissensus) which "has the rationality of disagreement as its very own rationality." But Rancière's departure from Habermas's theory of communicative action is subtle and difficult to assess. At first glance there appears to be considerable common ground between the two thinkers. Both reject the pessimistic diagnosis that proclaims in the name of critical theory the ubiquity of domination and instead affirm the capacity of everyday speech and action to effect emancipatory social change. Both theorize a democratic politics that is grounded in the presupposition of the equality of humans as speaking beings and that consists in a procedure of argumentation and demonstration. But there is in fact a fundamental disagreement between the two thinkers and it leads them to markedly different conceptions of the procedure of contestation that is proper to politics. In this essay we aim to explicate and examine this disagreement. In doing so we also seek to measure the distance between the two thinkers. We argue in what follows that Rancière's critique of Habermas is cogent and represents an innovative and provocative contribution to the theory of democracy.},
    abstract_source = "openalex"
}

@misc{erman2009wrong,
    author = "Erman, Eva",
    title = "What is Wrong with Agonistic Pluralism? Reflections on Conflict in Democratic Theory",
    year = "2009",
    note = "CORE ARGUMENT: Erman argues, against the intuitive appeal of Mouffe's agonism, that conflict is in fact better understood within Habermasian discourse theory than within agonistic pluralism. She defends two theses: that discourse theory offers a more accurate account of conflict because it treats deliberation as constitutive of (not opposed to) conflict, and that some of Habermas's own assumptions about ethical discourse need revision to fully accommodate this insight. RELEVANCE: Offers a direct rebuttal to agonistic critiques of Habermas from a discourse-theoretic standpoint, giving the domain a paper that defends Habermas against Mouffe on her own chosen terrain (the adequacy of theorizing conflict) rather than simply cataloguing the objections. POSITION: Discourse-theoretic defense against agonistic pluralism, arguing agonism cannot adequately theorize the conditions of conflict it claims to center.",
    keywords = "agonism, Mouffe, deliberative-democracy, conflict, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "During the last couple of decades, concurrently with an increased awareness of the complexity of ethical conflicts, political theorists have directed attention to how constitutional democracy should cope with a fact of incommensurable doctrines. Poststructuralists such as Chantal Mouffe claim that ethical conflicts are fundamentally irreconcilable, which is indeed a view shared by many liberal theorists. The question of whether ethical conflicts are in principle irreconcilable is an important one since the answer has implications for what democratic institutions are desirable. In light of this question the article investigates the notion of conflict in agonistic pluralism and discourse theory. At first glance, Mouffe's agonism seems apt to accommodate ethical conflict in democratic governance, since it focuses on conflict as the core of politics, whereas Habermasian deliberative democracy seems inappropriate for this task, as it focuses on consensus. However, through an inquiry into the conditions of conflict this article will argue the opposite, namely, that conflict cannot be adequately understood within Mouffe's agonistic framework. The thesis defended is (1) that discourse theory offers a more accurate account of conflict than agonistic theory because it embraces the idea that deliberation is constitutive of conflict, and (2) that some of Habermas' assumptions concerning ethical discourse need to be revised in order for his democratic theory to fully accommodate this insight.",
    abstract_source = "openalex"
}

@article{kaltsas2019habermas,
    author = "Kaltsas, Spyridon",
    title = "Habermas, Taylor, and Connolly on Secularism, Pluralism, and the Post-Secular Public Sphere",
    journal = "Religions",
    year = "2019",
    volume = "10",
    note = {CORE ARGUMENT: Kaltsas compares Habermas, Charles Taylor, and William Connolly on secularism and the post-secular public sphere. Taylor criticizes Habermas's "institutional translation proviso," while Connolly stresses the agonistic dimension of the post-secular public sphere that he thinks Habermas's post-metaphysical account of secularism forecloses. Kaltsas ultimately defends a Habermasian reading centered on the internal relation between universal justification and pre-political solidarity, while conceding the need to incorporate an agonistic dimension. RELEVANCE: This is the clearest available source engaging Connolly's specific objections to Habermas (rather than Connolly's pluralism in the abstract), addressing the domain's requirement to represent Connolly alongside Mouffe and Rancière as a distinct agonistic interlocutor. POSITION: Partially sympathetic to Habermas but argues his framework must be supplemented with an agonistic dimension to handle religious and post-secular pluralism.},
    keywords = "agonism, Connolly, post-secular, pluralism, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = {The main purpose of this paper is to explore and understand the relationships between secularism, pluralism, and the post-secular public sphere in the thought of Jürgen Habermas, Charles Taylor, and William Connolly. The three authors develop a thorough critique of secularism which implies a radical break with the dogmatic idea of removing religion from the public sphere. My main objective is to show that this critique is related to a normative understanding of our post-secular situation and requires a rethinking of the boundaries of the public sphere in relation to the predicament of pluralism. Arguing against the post-metaphysical conception of secularism, Taylor develops a critique of Habermas's "institutional translation proviso", and Connolly stresses the agonistic dimension of the post-secular public sphere. I take these criticisms into account, while arguing that Taylor and Connolly are unable to provide a sound basis for the legitimacy of our institutional settings. In contrast to Taylor and Connolly, I propose a reading of Habermas's theory based on the internal relationship between universal justification and the everyday contexts of pre-political solidarity. I conclude with a focus on the need to take into account the agonistic dimension of the post-secular public sphere.},
    abstract_source = "s2"
}

@misc{kjaer2021systems,
    author = "Kjaer, Poul F.",
    title = "Systems in Context: On the Outcome of the Habermas/Luhmann Debate",
    year = "2021",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Kjaer argues that the Habermas-Luhmann debate, usually treated as a 1970s episode, in fact continued until Luhmann's death in 1998 and was characterized by convergence rather than divergence. In legal theory specifically, Kjaer contends Habermas's discourse theory came to function as a normative superstructure over Luhmann's descriptive systems theory of society, to the point that Habermas's own theoretical apparatus was substantially absorbed into Luhmann's systems-theoretical vocabulary -- an outcome facilitated by Luhmann's deliberate translation of Habermasian concepts into systems-theoretic terms. RELEVANCE: Directly addresses how the Luhmann challenge bears on Habermas's legal theory (the system/lifeworld distinction underlying "Between Facts and Norms"), providing the domain's central source on the long-run trajectory and outcome of the debate rather than just its 1970s opening exchange. POSITION: Revisionist account holding that the debate ended in a substantive theoretical convergence, with Habermas's normative commitments surviving only by being reframed in Luhmannian systems-theoretic terms.},
    keywords = "Luhmann, systems-theory, legal-theory, lifeworld-system, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Usually regarded as a 1970s phenomenon, this article demonstrates that the debate between Jurgen Habermas and Niklas Luhmann continued until Luhmann's death in 1998, and that the development of the two theorists' positions during the 1980s and 1990s was characterised by convergence rather than by divergence. In the realm of legal theory, the article suggests, convergence advanced to the extent that Habermas' discourse theory may be characterised as a normative superstructure to Luhmann's descriptive theory of society. It is further shown that the debate's result was an almost complete absorption of Habermas' theory by Luhmann's systems theoretical complex -- an outcome facilitated by Luhmann's deliberate translation of central Habermasian concepts into systems theoretical concepts. The article argues that both the debate and Habermas' conversion were made possible because not only Habermas' but also Luhmann's work can be considered a further development of the German idealist tradition. What Luhmann did not acknowledge was that this manoeuvre permitted the achievement of Habermas' normative objectives; nor did he notice that it could eradicate a central flaw in the system theoretical construction, by allowing the context within which distinctions are drawn to be mapped -- an issue of pivotal importance for grasping relationships between different social systems, and coordinating them, via the deployment of legal instruments.",
    abstract_source = "s2"
}

@misc{harste2021habermasluhmann,
    author = "Harste, Gorm",
    title = "The Habermas-Luhmann Debate",
    year = "2021",
    address = "New York",
    note = "CORE ARGUMENT: The first English-language book-length treatment of the controversy between Habermas and Luhmann, tracing their disagreement from its inception through Habermas's later work. Harste analyzes the dispute across methodology, ideology, truth, history, and politics, presenting it as one of the defining conflicts in twentieth-century social theory between a normative, discourse-theoretic account of society and a descriptive, functionalist systems theory. RELEVANCE: Provides book-length coverage of the debate for synthesis writers needing a comprehensive secondary source on how Luhmann's systems theory challenges Habermas's normative project, complementing the narrower, outcome-focused article by Kjaer. POSITION: Comprehensive secondary treatment situating the debate as a foundational conflict between critical-normative and systems-theoretic paradigms in social theory.",
    keywords = "Luhmann, systems-theory, social-theory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{rustemijovanoski2021controversy,
    author = "Jovanoski, Aleksandar and Rustemi, Agron",
    title = "The Controversy between Niklas Luhmann and Jürgen Habermas Related to Sociological Approach to Law",
    year = "2021",
    volume = "16",
    number = "1",
    note = "CORE ARGUMENT: The authors contrast Luhmann's systems-theoretic account of law -- in which law is an autonomous, self-referential subsystem of society rather than an instrument of politics -- with Habermas's sociologically-informed but normatively grounded account. They present the clash as fundamental: Luhmann treats social reality, including law, as composed of functionally differentiated subsystems of a deeper system (society), leaving no room for the kind of normative validity claims central to Habermas's discourse theory of law. RELEVANCE: A concise, focused overview of the specific point of collision between Luhmann and Habermas on legal theory, useful for synthesis writers who need a compact statement of the stakes before turning to Kjaer's or Harste's more extended treatments. POSITION: Presents the debate as an unresolved and fundamental disagreement over whether law can be normatively grounded or must be understood purely as self-referential systemic operation.",
    keywords = "Luhmann, systems-theory, legal-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Abstract The aim of the paper is to present a brief insight into the significant works and views of the German sociologists Niklas Luhmann and Jürgen Habermas on the role of law in regulating human relations in society. Educated as a lawyer, Niklas Luhmann in the late academic career was under the influence of the American sociologist Talcott Parsons. Niklas Luhmann later, under the influence of the American sociologist Talcott Parsons, he built a sociological theoretical system called the systems theory. On the other side, Jürgen Habermas was a philosopher and sociologist, highly influenced by the Frankfurt school of sociology. According to Luhmann's systems theory, the social reality and the separate aspects of the social life are part of a deeper system called society, and in relation to the same they are set as subsystems. Social systems are divided into allopoietic and autopoietic. One of the significant axioms of Luhmann's theory is that the largest number of systems tends to simplify due to the pressure of the environment for greater efficiency. Law in Luhman's systems theory enjoys the status of an autonomous system for regulating society, rather than an instrumental contribution to politics. This brief review exposed a big clash between two influential German thinkers. In this paper we are going to use historical method and analysing of the content of different materials and previous authors that are dealing with the work of Niklas Luhmann and Jürgen Habermas.",
    abstract_source = "s2"
}

@book{bailey2014deprovincializing,
    author = "Bailey, Tom",
    title = "Deprovincializing Habermas: Global Perspectives",
    year = "2014",
    publisher = "Routledge",
    note = {CORE ARGUMENT: This edited volume systematically engages Habermas's political theory from critical perspectives outside its Western locus, examining the theory's implications and limitations when applied to non-Western contexts. Contributors from political theory, global justice, postcolonial studies, and religious studies collectively press the charge that Habermas's framework is "provincial" despite its universalist self-understanding, while later chapters address Habermas's own responses to this charge. RELEVANCE: Serves as the domain's central anchor for the postcolonial critique of Habermas, providing multiple perspectives in one volume on the Eurocentrism charge and Habermas's attempted rebuttals, making it a natural hub reference for synthesis writers covering this cluster. POSITION: A collection organized around the "provincialism" charge against Habermas, spanning both critical (postcolonial, non-Western) and reconstructive responses.},
    keywords = "postcolonial, Eurocentrism, decolonial, global-justice, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Foreword. Introduction Tom Bailey Part I. Democratizing 1. Back to Kant? The Democratic Deficits in Habermas' Global Constitutionalism Lars Rensmann 2. Democratizing International Law: A Republican Reading of Habermas' Cosmopolitan Project James Bohman 3. Feminist Solidarity in India: Communitarian Challenges and Postnational Prospects Kanchana Mahadevan 4. Deliberation without Democracy? Reflections on Habermas, Mini-publics and China William Smith Part II. Decolonizing 5. Defending Habermas against Eurocentrism: Latin America and Mignolo's Decolonial Challenge Raymond Morrow 6. Care, Power and Deconstructive Postcolonialism: Reformulating the Habermasian Response Richard Ganis 7. From Communicative Modernity to Modernities in Tension John Rundell Part III. Desecularizing 8. What is Living and What is Dead in Habermas' Secularization Hypothesis? Kevin W. Gray 9. Reason and Li Xing: A Chinese Solution to Habermas' Problem of Moral Motivation Tong Shijun 10. Radicalizing the Post-secular Thesis, Provincializing Habermas Peter Losonczi. About the Editor. Notes on Contributors. Index",
    abstract_source = "openalex"
}

@book{allen2016end,
    author = "Allen, Amy",
    title = "The End of Progress: Decolonizing the Normative Foundations of Critical Theory",
    year = "2016",
    publisher = "Columbia University Press",
    address = "New York",
    note = "CORE ARGUMENT: Allen argues that while post- and decolonial theorists have debunked historical progress as a Eurocentric, imperialist fallacy, the leading contemporary Frankfurt School thinkers -- Habermas, Honneth, and Forst -- have persistently defended ideas of progress, development, and modernity, making such ideas central to their normative claims. She asks whether critical theory's emancipatory ambitions can survive this critique and sketches what a decolonized critical theory, informed by Foucauldian genealogy and Adornian negative dialectics, would look like. RELEVANCE: The single most sustained and influential critique of the developmental/progress assumptions underlying not only Habermas but also Honneth's and Forst's revisions of his project, making it essential for connecting the postcolonial and intra-critical-theory clusters of this domain. POSITION: Internal decolonial critique arguing that Habermas, Honneth, and Forst all remain committed to a Eurocentric philosophy of progress that their own normative frameworks cannot justify without external, non-Western validation.",
    keywords = "postcolonial, decolonial, Eurocentrism, Honneth, Forst, progress, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Amy Allen fractures critical theory from within by dispensing with its progressive reading of history while retaining its notion of progress as a political imperative. In reimagining a decolonized critical theory after the end of progress, she rescues it from oblivion and gives it a future for achieving emancipatory social goals.",
    abstract_source = "openalex"
}

@article{rees2017decolonizing,
    author = "Rees, Dafydd Huw",
    title = "Decolonizing Philosophy? Habermas and the Axial Age",
    journal = "Constellations",
    year = "2017",
    volume = "24",
    number = "2",
    note = {CORE ARGUMENT: Rees examines Habermas's use of the "Axial Age" thesis (the idea of a shared transformation of religious and philosophical worldviews across several world civilizations) as a test case for whether Habermas's developmental account of reason can be decolonized. He assesses how far Habermas's comparative-historical framework can accommodate non-Western traditions on their own terms rather than measuring them against a Western rationalization narrative. RELEVANCE: Offers a direct, textually grounded engagement with the Eurocentrism charge as it bears on Habermas's own writings (rather than on Honneth or Forst), giving the domain a source focused specifically on Habermas's philosophy of history rather than the broader Frankfurt School. POSITION: A qualified, immanent critique -- more sympathetic than Allen's -- that probes whether Habermas's own comparative resources can be redeployed to answer the decolonial challenge.},
    keywords = "postcolonial, decolonial, Eurocentrism, Axial-Age, Medium, METADATA\_CLEANED: pages, doi",
    abstract = {The "postsecular" phase in Jürgen Habermas's work began as an attempt to decolonize philosophy. Ever since his address at the Paulskirche in Frankfurt in October 2001, Habermas has linked the goal of developing a postsecular approach in philosophy and politics to the need to redress the balance between the West and the rest of the world. It is no longer possible, he says, to take secular European society as the global norm. Philosophy and political theory must acknowledge the fact that "occidental rationalism," rather than being a model for the rest of the world, is in fact the Sonderweg or deviant path. For Habermas, this Eurocentrism takes the form of an unreflexive secularism: assuming, based on European experience, that the decline of religion is inevitable, that religion has no place in politics, and that philosophical reason has nothing in common with religious faith. Modifying the secular assumptions of philosophy and political theory is therefore the first step towards a rapprochement with the non-Western world -- a rapprochement that is desperately needed if Western thinkers are not to appear as "crusaders of a competing religion or as salespeople of instrumental reason and destructive secularization." Although it is rarely acknowledged, this anti-Eurocentric impulse is at the heart of Habermas's postsecular project.},
    abstract_source = "openalex"
}

@misc{kempf2024habermas,
    author = "Kempf, Victor",
    title = "Habermas und Fanon über koloniale Herrschaft",
    year = "2024",
    volume = "72",
    number = "3",
    abstract = {From a decolonial perspective, Habermas' theory is seen by many as Eurocentric and in philosophical alliance with colonial rule. In particular, his theory of progress is seen as offensive because it devalues non-Western ways of understanding in comparison to their modern Western counterparts. On the one hand, this is true. On the other hand, Habermas' actual concept of progress can also be used to formulate a critique of colonialist development imperatives. Moreover, his concept of "systematically distorted communication" can make an interesting contribution to understanding colonial rule: even colonial rule is communicatively mediated, with the constant risk of dissent precariously held in check by racist discourse barriers. Fanon already provides strong starting points for this communication-theoretical view of colonial rule. With him, the decolonial struggles against racist discourse barriers also come into view.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Kempf stages a direct confrontation between Habermas and Frantz Fanon on colonial rule. He concedes the decolonial charge that Habermas's theory of progress devalues non-Western understanding by measuring it against Western modernity, but argues that Habermas's own concept of "systematically distorted communication" can be repurposed to analyze colonial domination as a communicatively mediated form of rule in which dissent is suppressed by racist discourse barriers -- a claim he supports by showing how Fanon's own analysis anticipates this communication-theoretic view. RELEVANCE: Provides a rare source that puts Habermas in direct dialogue with a canonical decolonial thinker (Fanon) rather than only with postcolonial theory in the abstract, and models a reconstructive rather than wholesale-rejectionist decolonial engagement with Habermasian concepts. POSITION: A mediating position between full decolonial rejection and defense of Habermas: accepts the Eurocentrism charge against his philosophy of history while salvaging his communication theory for decolonial analysis via Fanon.},
    keywords = "postcolonial, decolonial, Fanon, Eurocentrism, communication-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{honneth1995struggle,
    author = "Honneth, Axel",
    title = "The Struggle for Recognition: The Moral Grammar of Social Conflicts",
    year = "1995",
    address = "Cambridge, UK",
    sep_context = {SEP's "Recognition" entry cites Honneth (1995) twice: first among psychologically oriented recognition theories that treat loving care as the first form of recognition humans experience (alongside Benjamin 1988), and second as the proposal, taken up by later authors interested in social criticism (Iser 2008, Deranty 2009, Zurn 2015), to use recognition as a new paradigm for Critical Theory.},
    note = {CORE ARGUMENT: Honneth reconstructs Hegel's early Jena writings on the struggle for recognition to argue that the fundamental medium of social conflict is not material self-interest but the demand for recognition across three spheres -- love, rights, and social esteem. He proposes this recognition-theoretic model as an alternative normative foundation for critical social theory, one grounded in a "moral grammar" of everyday experiences of disrespect rather than in Habermas's linguistic-pragmatic account of communicative rationality. RELEVANCE: This is the foundational text of the most influential intra-critical-theory revision of Habermas's project, replacing his discourse-theoretic foundations with an intersubjective theory of recognition; it anchors the entire "Honneth" strand of debate covered by the other entries in this cluster (Zurn, Fraser and Honneth, Allen). POSITION: Recognition-theoretic revision of critical theory that shifts the normative foundation from Habermas's communicative rationality to a Hegelian-inflected theory of intersubjective recognition and moral injury.},
    keywords = "Honneth, recognition, critical-theory, intra-Frankfurt-School, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{fraserhonneth2003redistribution,
    author = "Fraser, Nancy and Honneth, Axel",
    title = "Redistribution or Recognition? A Political-Philosophical Exchange",
    year = "2003",
    address = "London",
    note = {CORE ARGUMENT: In this jointly authored exchange, Fraser argues that redistribution (a politics of material equality) and recognition (a politics of cultural respect) are two distinct, mutually irreducible dimensions of justice that cannot be collapsed into one another, while Honneth contends that a sufficiently differentiated theory of recognition can itself ground a comprehensive theory of justice, including claims to material redistribution, without needing a separate distributive paradigm. RELEVANCE: This exchange is the central primary document for the redistribution/recognition debate within critical theory, and it indirectly tests Habermas's discourse-theoretic proceduralism by asking whether either recognition or redistribution (or Habermasian procedural legitimacy) can serve as the sole normative currency of justice. POSITION: A two-sided intra-critical-theory debate: Fraser's dualist "perspectival dualism" versus Honneth's recognition monism, both developed as revisions or supplements to, rather than direct attacks on, Habermasian discourse theory.},
    keywords = "Fraser, Honneth, recognition, redistribution, justice, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{zurn2003identity,
    author = "Zurn, Christopher F.",
    title = "Identity or Status? Struggles over `Recognition' in Fraser, Honneth, and Taylor",
    journal = "Constellations",
    year = "2003",
    volume = "10",
    number = "4",
    note = {CORE ARGUMENT: Zurn maps the disagreements among Fraser, Honneth, and Taylor over what recognition is actually a demand for -- authentic cultural identity (Taylor), equal participatory status (Fraser), or differentiated forms of intersubjective esteem (Honneth) -- and argues these are not merely terminological differences but reflect deeper disagreements about the normative point of recognition politics and its relation to justice. RELEVANCE: Provides an analytically precise secondary mapping of the recognition debate that helps situate Honneth's revision of critical theory relative to both Fraser and Taylor, useful for synthesis writers needing to distinguish the different recognition paradigms rather than treating "recognition theory" as monolithic. POSITION: Comparative/critical analysis clarifying the stakes of the Fraser-Honneth-Taylor recognition debate without fully endorsing any one position.},
    keywords = "Fraser, Honneth, Taylor, recognition, Medium, METADATA\_CLEANED: pages, doi",
    abstract = {Fraser advocates recognition from the external perspective of an objective, social-scientific observer, who attends only to those distinctions between groups that are the result of institutionalized social relations of subordination, whether economic, political, or cultural. Calling this a "status" model of recognition politics, Fraser claims that it provides a better basis for a critical theory of struggles against denigration than competing "identity" models of recognition. Only by forswearing recourse to the prevailing identity model can theorists make normatively important distinctions between warranted and unwarranted claims for recognition. Furthermore, according to Fraser, only such a status model can be properly integrated with a theory of just economic distribution, so that one coherent framework of social justice can accommodate and reconcile claims for just social relations of distribution and recognition. Zurn argues that Fraser's general model does indeed represent an important advance over competing models of identity politics, but questions how many of its advantages are due to the status model specifically rather than to other theoretical components, defending the hypothesis that no adequate critical theory of recognition can be so objectivistic that it ignores the internal connections between struggles for recognition and the development of individual identity, in comparison with the competing identity-based models put forward by Axel Honneth and Charles Taylor.},
    abstract_source = "openalex"
}

@article{forst2007first,
    author = "Forst, Rainer",
    title = "First Things First: Redistribution, Recognition and Justification",
    journal = "European Journal of Political Theory",
    year = "2007",
    volume = "6",
    number = "3",
    note = {CORE ARGUMENT: Forst intervenes in the Fraser-Honneth debate to argue that both redistribution and recognition presuppose a more basic normative category: justification. On his view, what ultimately matters is whether persons possess an effective status as justificatory equals -- the power to demand and give reasons for the social arrangements that structure distribution and recognition alike -- making justification, not recognition or redistribution, the "first thing" in a theory of justice. RELEVANCE: This is the clearest statement of Forst's distinctive contribution to the "power blind spot" critique referenced in the domain brief: by insisting that relations of justification are also relations of power (who can demand justification from whom), Forst pushes beyond both Habermas's proceduralism and Honneth's/Fraser's frameworks to make power asymmetries in justificatory practices the central object of critique. POSITION: A justification-theoretic alternative that subsumes both recognition and redistribution under a more fundamental right to justification, developed partly as an immanent correction to gaps in Habermasian discourse theory.},
    keywords = "Forst, justification, power, recognition, redistribution, High, METADATA\_CLEANED: pages, doi",
    abstract = "This article analyses the debate between Nancy Fraser and Axel Honneth in a dialectical fashion. Their controversy about how to construct a critical theory of justice is not just one about the proper balance between `redistribution' and `recognition', it also involves basic questions of social ontology. Differing both from Fraser's `two-dimensional' view of `participatory parity' and from Honneth's `monistic' theory of recognition, the article argues for a third view of `justificatory monism and diagnostic-evaluative pluralism', also called the `first-things-first' approach. According to it, theories of recognition provide an essential sensorium for analyses of social suffering and of injustice, while with respect to the justification of justice claims, a discursive conception of justification is required. This, however, does not imply a purely `formal' account of justice; rather, it leads to a substantive understanding of the `grammar of justice', motivationally, socially and institutionally. Such an account of a critical theory of justice aims at a multidimensional critique of social and political `relations of justification'.",
    abstract_source = "openalex"
}

@article{stahl2013habermas,
    author = "Stahl, Titus",
    title = "Habermas and the Project of Immanent Critique",
    journal = "Constellations",
    year = "2013",
    volume = "20",
    number = "4",
    note = {CORE ARGUMENT: Stahl argues that despite Habermas's own claims to the contrary, his mature normative framework -- which rejects both transcendental and purely hermeneutic groundings of critical theory -- constitutes a novel and previously unrecognized form of "immanent critique." Stahl offers a formal account of immanent critique, distinguishes different ways of carrying it out, and situates Habermas's approach within this typology. RELEVANCE: Clarifies the methodological self-understanding of Habermas's critical theory in a way that bears directly on later immanent-critique- based objections to it (including the decolonial "critique as coloniality" challenge and Honneth's own immanent-critique methodology), making it a useful bridge between the intra-critical-theory and postcolonial clusters. POSITION: A reconstructive, largely sympathetic methodological analysis that nonetheless reframes Habermas's self-description of his own normative method.},
    keywords = "immanent-critique, methodology, critical-theory, Medium, METADATA\_CLEANED: pages, doi",
    abstract = {According to his own understanding, Jürgen Habermas' Theory of Communicative Action offers a new account of the normative foundations of critical theory. Habermas' motivating insight is that neither a transcendental or metaphysical solution to the problem of normativity, nor a merely hermeneutic reconstruction of historically given norms, is sufficient to clarify the normative foundations of critical theory. In response to this insight, Habermas develops a novel account of normativity which locates the normative demands upon which critical theory draws within the socially instituted practice of communicative understanding. Although Habermas has claimed otherwise, this new foundation for critical theory constitutes a novel and innovative form of "immanent critique." Stahl offers a formal account of immanent critique and distinguishes between two different ways of carrying out such a critique, examines Habermas' rejection of the hermeneutic option, shows that the Theory of Communicative Action attempts to formulate an immanent critique of contemporary societies according to a "practice-based" model, and argues that because Habermas commits himself to an implausibly narrow view regarding the social ontology of immanent normativity, his normative critique cannot develop its full potential.},
    abstract_source = "openalex"
}

