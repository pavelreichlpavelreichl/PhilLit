@article{mansbridge2012conflict,
  author = {Mansbridge, Jane},
  title = {Conflict and Commonality in Habermas's Structural Transformation of the Public Sphere},
  journal = {Political Theory},
  year = {2012},
  volume = {40},
  number = {6},
  pages = {789--801},
  doi = {10.1177/0090591712457661},
  note = {
  CORE ARGUMENT: Mansbridge argues that Habermas's original model
  privileged reason exercised on matters of general interest while
  dismissing the "haggling" involved in negotiating compromises among
  conflicting material interests — a bias that runs deeper than the
  book's acknowledged historical restriction to propertied males. She
  traces how Habermas's own later work gradually recognizes the
  legitimacy of interest-based conflict, but argues that neither Habermas
  nor subsequent democratic theory has adequately articulated how
  common-good-oriented deliberation and interest-based bargaining should
  coexist within a single account of democratic legitimacy.

  RELEVANCE: Complements the feminist/historical exclusion critiques
  (Landes, Eley) with an internal, normative-theoretical critique: even
  apart from who was historically excluded, the ideal of rational
  consensus itself undervalues legitimate conflict of interest, a point
  directly relevant to the review's treatment of deliberative-vs-agonistic
  democracy debates elsewhere in the Habermas literature.

  POSITION: Internal critique from within democratic/deliberative theory;
  does not reject the public sphere ideal but insists it must
  accommodate interest-based conflict, not just rational-critical
  consensus.
  },
  keywords = {public-sphere, deliberative-democracy, conflict, High, INCOMPLETE, no-abstract}
}

