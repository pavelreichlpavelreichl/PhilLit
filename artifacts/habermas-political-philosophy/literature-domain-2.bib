@book{hofmann2017habermass,
  author = {Hofmann, Michael},
  title = {Habermas's Public Sphere: A Critique},
  publisher = {Lexington Books},
  year = {2017},
  doi = {10.5771/9781611479898},
  note = {
  CORE ARGUMENT: Hofmann traces the evolution of Habermas's public
  sphere concept from the 1950s to the present, arguing that its complex
  and not-always-identified methodology — combining a Marxist critique of
  ideology with a reconstruction of the Kantian liberal ideal of a
  rational-critical public — has produced persistent misunderstandings.
  He contends that Habermas's own "Further Reflections on the Public
  Sphere" (1992) still fails to acknowledge key intellectual debts (to
  Herbert Marcuse and Ernst Bloch) and that this obscured methodology
  restricts the concept's proper application largely to the French
  revolutionary and British "model" cases Habermas originally analyzed.

  RELEVANCE: Offers a methodologically focused critique distinct from the
  feminist/historical exclusion literature, useful for the review's
  account of how even sympathetic readers find Habermas's own account of
  the concept's intellectual sources and scope of application unclear.

  POSITION: Internalist/genealogical critique that seeks to reinvigorate
  the concept by correcting its methodological opacity rather than
  rejecting it.
  },
  keywords = {public-sphere, methodology, critique, Medium},
  abstract = {Habermas’s Public Sphere: A Critique analyzes the evolution of Juergen Habermas’s social and political theory from the 1950s to the present by focusing on the explicit and on the tacit changes in his thinking about The Structural Transformation of the Public Sphere, his global academic bestseller, which has been translated into 30 languages. Integrating “public sphere,” “discourse,” and “reason,” the three categories at the center of his lifelong work as a scholar and as a public intellectual, Habermas’s classic public sphere concept has deeply influenced an unusually high number of disciplines in the social sciences and in the humanities. In the process, its complex methodology, whose sources are not always identified, can be perplexing and therefore lead to misunderstandings. 
  abstract_source = {s2},
 While Habermas’s “Further Reflections on the Public Sphere” (1992) contain several far-reaching clarifications, they still do not identify a number of the most important sources for his methodology, above all Herbert Marcuse and Ernst Bloch. Hence, a key purpose of this study is to thoroughly analyze the Marxist critique of ideology that Habermas uses in dialectical fashion for his theory reconstruction of Immanuel Kant’s liberal ideal of a rational-critical public as the organizational principle of the constitutional state and as the method of Enlightenment. Such dialectical thinking allows him to appropriate the structure of Reinhart Koselleck’s Critique and Crisis and of Carl Schmitt’s writings on the modern state while simultaneously upending their conservative critique of Liberalism and of the Enlightenment. However, this strategy restricts the application of his concept to his stylizations of the French Revolution and of his British “model case.”
 This critique reinvigorates Habermas’s seminal distinction between the purely political polis of antiquity, which excludes the private economy from the res publica, and the modern public sphere with its rational-critical discourse about commodity exchange and social labor in the political economy. At the same time, it identifies the crises of seventeenth-century England and the Dutch Republic as the origins of the new channels of public communication used to constantly evaluate the role of state power as political facilitator and regulator of an increasingly complex, dynamic, and crisis-prone market economy.},
}

@article{omahony2021habermas,
  author = {O'Mahony, Patrick},
  title = {Habermas and the Public Sphere: Rethinking a Key Theoretical Concept},
  journal = {European Journal of Social Theory},
  year = {2021},
  volume = {24},
  number = {4},
  pages = {485--506},
  doi = {10.1177/1368431020983224},
  note = {
  CORE ARGUMENT: O'Mahony identifies three limitations of Habermas's
  public-sphere-based communicative social theory: an inadequate
  sociological-evolutionist account of societal differentiation drawn
  from classical sociology; learning-theoretical limits of the
  normative-proceduralist account of democratization; and a
  disconnection between the theory of communicative reason and both the
  critique of pathological reasoning and its implications for lifeworld
  rationalization. He argues these limitations should motivate a radical
  rethinking of the public sphere as intrinsic (not merely supplementary)
  to solving contemporary democratic problems.

  RELEVANCE: Offers a recent, systematic diagnosis of where Habermas's
  later deliberative-democratic elaborations (Domain 1's discourse-theory
  material) leave the public sphere concept underdeveloped, directly
  relevant to any synthesis linking this domain back to discourse ethics
  and law/democracy.

  POSITION: Sympathetic-critical reconstruction in the Calhoun/Kellner
  vein, but more systematically critical of Habermas's later
  proceduralist turn.
  },
  keywords = {public-sphere, deliberative-democracy, communicative-action, Medium},
  abstract = {The challenge of realizing the democratic power of publics through public sphere remains acute but not hopeless. While claiming that Habermas communicative social theory offers a way forward in spite of a productive but constraining turn towards a modified social liberal frame, nonetheless three limitations of the theory are identified. The first bears on the insufficiency of the sociological evolutionist description of society relevant to the public sphere drawn from classical sociological accounts of differentiation and integration. The second identifies learning theoretical limitations of the normative interactionist, proceduralist account of democracy and democratization potentials. And the third observes on the disconnection between the theory of communicative reasoning from, on the one hand, the critique of pathologies of reasoning, and, on the other, from its implications for lifeworld rationalization. These identified limitations are intended to provide new impetus to radically rethink the public sphere as intrinsic to solving contemporary problems of democracy that Habermas’s more recent account of deliberative theory, with the public sphere merely supplementary, cannot fully do. Yet, with Habermas, this should be on the basis of advancing the communication theory of democracy.},
  abstract_source = {s2},
}

@article{papacharissi2002virtual,
  author = {Papacharissi, Zizi},
  title = {The Virtual Sphere},
  journal = {New Media \& Society},
  year = {2002},
  volume = {4},
  number = {1},
  pages = {9--27},
  doi = {10.1177/14614440222226244},
  abstract = {The internet and its surrounding technologies hold the promise of reviving the public sphere; however, several aspects of these new technologies simultaneously curtail and augment that potential.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Papacharissi tests the internet's promise of reviving
  the public sphere against Habermasian criteria for rational-critical,
  inclusive discourse, arguing that internet technologies simultaneously
  expand and curtail that potential: the internet lowers barriers to
  entry and multiplies venues for political expression, but structural
  features (commercialization, fragmentation, incivility, and unequal
  access) reproduce many of the exclusions and distortions Habermas
  diagnosed in the mass-media public sphere.

  RELEVANCE: Establishes the template that later digital-public-sphere
  literature in this domain (Staab and Thiel, Fuchs, Copeland) follows:
  applying Habermas's normative criteria to a new media environment while
  identifying structural obstacles to their realization.

  POSITION: Early, foundational digital-extension text; cautiously
  skeptical rather than utopian about the internet's democratizing
  potential.
  },
  keywords = {public-sphere, digital-public-sphere, internet, High}
}

@article{staabthiel2022social,
  author = {Staab, Philipp and Thiel, Thorsten},
  title = {Social Media and the Digital Structural Transformation of the Public Sphere},
