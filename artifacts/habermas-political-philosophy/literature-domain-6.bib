}

@article{patberg2014supranational,
  author = {Patberg, Markus},
  title = {Supranational constitutional politics and the method of rational reconstruction},
  journal = {Philosophy \& Social Criticism},
  year = {2014},
  volume = {40},
  number = {6},
  pages = {501--521},
  doi = {10.1177/0191453714530987},
  note = {
  CORE ARGUMENT: Patberg examines Habermas's claim, in The Crisis of the European Union, that constituent power in the EU is shared between the community of EU citizens and the political communities of the member states (a "dual constituent subject" reached via rational reconstruction of the genesis of the European constitution). Finding this explanation insufficiently illuminating because the term "rational reconstruction" itself is contested, Patberg critically surveys the current state of research on rational reconstruction, develops a new reading of Habermas's method, and uses it to explain and evaluate the notion of a European pouvoir constituant mixte.

  RELEVANCE: Addresses the project's institutional-forms question directly by scrutinizing the methodological basis (rational reconstruction) for Habermas's specific proposal for EU constituent power, showing how contested the method itself is even among sympathetic readers.

  POSITION: Methodologically internal critique; refines rather than rejects Habermas's dual-constituent-power model for the EU.
  },
  keywords = {european-union, constituent-power, rational-reconstruction, Medium},
  abstract = {In The Crisis of the European Union Jürgen Habermas claims that the constituent power in the EU is shared between the community of EU citizens and the political communities of the member states. By his own account, Habermas arrives at this concept of a dual constituent subject through a rational reconstruction of the genesis of the European constitution. This explanation, however, is not particularly illuminating since it is controversial what the term ‘rational reconstruction’ stands for. This article critically discusses the current state of research on rational reconstruction, develops a new reading of Habermas’ method and invokes this account for an explanation and evaluation of the notion of a European pouvoir constituant mixte .},
  abstract_source = {openalex},
}

@article{cohen2008rethinking,
  author = {Cohen, Jean L.},
  title = {Rethinking Human Rights, Democracy, and Sovereignty in the Age of Globalization},
  journal = {Political Theory},
  year = {2008},
  volume = {36},
  number = {4},
  pages = {578--606},
  doi = {10.1177/0090591708317901},
  note = {
  CORE ARGUMENT: Cohen argues that the traditional conception of human rights as pre-political moral rights, well-suited to the post-WWII revival of human rights discourse and to anti-dictatorship struggles, no longer fits the new function human rights discourse has acquired since 1989 — justifying sanctions, military intervention, and transformative occupation by outside powers framed as international-law enforcement. She analyzes two recent "political" alternatives to the traditional conception (one of which is Habermas's cosmopolitan/constitutionalization-of-international-law model) and argues for a third, on the thesis that sovereign equality and human rights are jointly necessary normative principles of a genuinely dualist (state-based and cosmopolitan) international system.

  RELEVANCE: Engages Habermas's discourse-theoretic grounding of human rights and cosmopolitan law from within the broader political-theory debate over how to reconceive human rights after the Cold War, testing whether his model can avoid instrumentalization for great-power intervention — a central worry behind realist and postcolonial-adjacent objections to cosmopolitan law.

  POSITION: Constructs an alternative "political" conception of human rights and sovereignty situated critically against, though not simply opposed to, Habermas's constitutionalization-of-international-law approach.
  },
  keywords = {human-rights, cosmopolitan-law, constitutionalization-of-international-law, sovereignty, High},
  abstract = {The traditional conception construes human rights as moral rights all people have due to some basic feature or interests deemed intrinsically valuable. This comported well with the revival of the discourse of human rights in the wake of atrocities committed during WWII. It served as a useful referent for local struggles against foreign rule and domestic dictatorship in the 1980s. Since 1989, human rights discourse acquired a new function: the justification of sanctions, military invasions, and transformative occupation administrations by outsiders, framed as enforcement of international law against violators. The traditional conception doesn't fit this new function, hence the efforts to counter-pose a “political” to the “traditional” approach. This essay analyzes two recent versions of the political conception, and argues for a third. The thesis is that sovereign equality and human rights are normative principles of our dualist international system and both are needed to construct a more just version of that system.},
  abstract_source = {openalex},
}

@article{fine2015europe,
  author = {Fine, Robert},
  title = {Europe and its Jews: a Cosmopolitan Journey with Jürgen Habermas},
  journal = {Partecipazione e Conflitto},
  year = {2015},
  volume = {8},
  number = {3},
  pages = {718--735},
  doi = {10.1285/I20356609V8I3P718},
  note = {
  CORE ARGUMENT: Fine argues that Habermas, as a leading younger-generation critical theorist, is distinctive for confronting the legacy of European antisemitism in his vision of a postnational, cosmopolitan Europe, emphasizing ongoing engagement with that history as integral to reconstructing political community. Yet Fine finds cracks in this reconstruction that allow a residual European chauvinism back in and that risk the premature judgment that antisemitism has been solved in Europe, tracing how these cracks have provided footholds for new forms of antisemitism on the European landscape and for critical theory's difficulty in recognizing them.

  RELEVANCE: Offers the domain's most historically and politically situated critique of Habermas's postnational vision of Europe, testing his cosmopolitan self-understanding of European identity against a concrete historical test case rather than at the level of abstract institutional design.

  POSITION: Immanent critical-theory critique that endorses much of Habermas's analysis while identifying a specific point — the risk of an idealized cosmopolitan self-image — where his reconstruction of European identity falls short.
  },
  keywords = {cosmopolitanism, european-union, antisemitism, eurocentrism-critique, Medium},
  abstract = {After the Holocaust European antisemitism did not simply vanish into thin air and critical theorists drew attention to the new or secondary forms of antisemitism that arose in the postwar period. Among them Jurgen Habermas, a leading figure in the younger generation of critical theorists, is remarkable for confronting the legacy of European antisemitism in his his vision of a new Europe. His approach to the postnational constellation emphasised the importance of ongoing engagement with the history of European antisemitism and of reconstructing political community in ways that should make antisemitism less feasible in the future. While this paper endorses much of Habermas' analysis, it is critical of cracks in the edifice of his reconstruction which allow back in a certain form of European chauvinism and which make it possible to reach the premature judgement that the problem of antisemitism has been solved in Europe. The last part of the paper addresses the actual ways in which the cracks in the postnational edifice have provided footholds for the unwelcome return of the 'Jewish question' to Europe and have made it difficult for critical theory to understand new forms of antisemitism emerging on the European landscape. The signs of an inversion of the cosmopolitan project - from critical engagement with the legacy of European antisemitism to an idealized image of European success in overcoming antisemitism - points to a misappropriation of cosmopolitanism that needs to be challenged.},
  abstract_source = {openalex},
}

@article{lupel2005tasks,
  author = {Lupel, Adam},
  title = {Tasks of a global civil society: Held, habermas and democratic legitimacy beyond the nation-state},
  journal = {Globalizations},
  year = {2005},
  volume = {2},
  number = {1},
  pages = {117--133},
  doi = {10.1080/14747730500085171},
  note = {
  CORE ARGUMENT: Lupel examines three candidate forms of transnational politics that might broaden democratic legitimacy beyond the nation-state without sacrificing the collective capacity to make legitimately binding decisions: David Held's cosmopolitan democracy, "democratic regionalism" via Habermas's postnational constellation, and "democratic network governance" via global civil society. He argues each model confronts a tension between the particularity of existing contexts of democratic legitimacy and the universalism a transnational or global political culture demands, examining specifically whether Habermas's regionalist route (paradigmatically the EU) can chart a viable middle course between the globalizing present and a genuinely cosmopolitan future.

  RELEVANCE: Directly comparative treatment of the institutional-forms question at the heart of this domain, situating Habermas's postnational-constellation model against Held's more fully cosmopolitan-democratic alternative and against network-governance models, rather than assessing Habermas in isolation.

  POSITION: Comparative-critical assessment; treats Habermas's "democratic regionalism" as one of several structurally analogous attempts to solve the same legitimacy problem, each only partially successful.
  },
  keywords = {cosmopolitan-democracy, european-union, global-civil-society, held, Medium},
  abstract = {In order for processes of globalization to continue without resulting in a corresponding loss of the collective capacity to make legitimately binding decisions, new mechanisms of democratic politics need to be developed. This article addresses three forms of transnational politics that could serve to broaden democratic legitimacy beyond the nation-state: (i) cosmopolitan democracy, (ii) democratic regionalism, and (iii) democratic network governance. Part one begins by examining David Held's important contributions to the project of rethinking liberal and social democracy in the context of globalization. It argues that if cosmopolitan democracy is to meet the challenges of globalization and address the need for transnational forms of democratic politics, it must be able to illuminate the very serious political obstacles to the democratization of transnational power. It must be able to articulate the forms of politics necessary to chart the course from globalizing present to cosmopolitan future. Parts two and three examine forms of politics seeking to chart such a middle course: Part two examines democratic regionalism through Jürgen Habermas' ‘postnational constellation’, and part three examines democratic network governance through the concept of ‘global civil society’. Each model, it is argued, encounters a tension between the particular contexts of democratic legitimacy and the universalism demanded of a transnational or even global political culture.},
  abstract_source = {s2},
}

