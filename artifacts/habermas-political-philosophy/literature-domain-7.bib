@article{khan2013critical,
    author = "Khan, Gulshan",
    title = "Critical Republicanism: Jürgen Habermas and Chantal Mouffe",
    journal = "Contemporary Political Theory",
    year = "2013",
    volume = "12",
    number = "4",
    note = {CORE ARGUMENT: Khan argues that the standard contrast between Habermas's deliberative democracy and Mouffe's agonistic model is overstated. Reading both through the lens of "critical republicanism," she shows that much of Mouffe's criticism of discourse ethics does not withstand scrutiny, and that Habermas's theory already shares Mouffe's emphasis on civic solidarity, the constructive role of conflict, and self-government. RELEVANCE: This paper directly complicates the deliberation-versus-agonism framing found elsewhere in the literature (e.g., Brady 2004, Kapoor 2002) by arguing the two camps converge more than they diverge, making it a useful counterweight to more oppositional readings of the Habermas-Mouffe debate. POSITION: A reconciliatory reading that locates both Habermas and Mouffe within a shared republican problematic rather than treating agonism and deliberation as incommensurable paradigms.},
    keywords = "agonism, Mouffe, radical-democracy, republicanism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages, doi"
}

@article{russellmontin2015rationality,
    author = "Russell, Matheson and Montin, Andrew",
    title = "The Rationality of Political Disagreement: Rancière's Critique of Habermas",
    journal = "Constellations",
    year = "2015",
    volume = "22",
    number = "4",
    note = {CORE ARGUMENT: The authors reconstruct Jacques Rancière's attempt to break with Habermas's linguistic-pragmatic paradigm and to install an alternative model of political speech ("dissensus") that has "the rationality of disagreement as its very own rationality." They argue Rancière's departure from communicative action theory is subtle but ultimately cogent, and that it constitutes an innovative contribution to democratic theory in its own right, distinct from Mouffe's agonism. RELEVANCE: Provides the Rancière side of the "consensus vs. dissensus" debate specifically requested for this domain, complementing the more extensively covered Mouffe-Habermas literature with a genuinely distinct post-Marxist/post-structuralist critique of communicative rationality. POSITION: Sympathetic reconstruction of Rancière's dissensus model as a rival, not merely a variant, of Habermasian and Mouffean democratic theory.},
    keywords = "agonism, Ranciere, dissensus, radical-democracy, High, METADATA\_CLEANED: pages, doi",
    abstract = {Jacques Rancière's political thought is worked out in the form of disputes. He has engaged in polemics against an array of theorists including Althusser, Arendt, Bourdieu, Baudrillard, Foucault, Lefort, Lyotard, Derrida, Hardt and Negri, Agamben, Badiou and Nancy. But among this pantheon of greats, it strikes us that the dispute with Jürgen Habermas plays an especially pivotal role. It is hard to gauge the significance of Rancière's conception of politics for contemporary political theory without addressing his attempt to break with the Habermasian linguistic-pragmatic paradigm and to set up an alternative model of political speech (dissensus) which "has the rationality of disagreement as its very own rationality." But Rancière's departure from Habermas's theory of communicative action is subtle and difficult to assess. At first glance there appears to be considerable common ground between the two thinkers. Both reject the pessimistic diagnosis that proclaims in the name of critical theory the ubiquity of domination and instead affirm the capacity of everyday speech and action to effect emancipatory social change. Both theorize a democratic politics that is grounded in the presupposition of the equality of humans as speaking beings and that consists in a procedure of argumentation and demonstration. But there is in fact a fundamental disagreement between the two thinkers and it leads them to markedly different conceptions of the procedure of contestation that is proper to politics. In this essay we aim to explicate and examine this disagreement. In doing so we also seek to measure the distance between the two thinkers. We argue in what follows that Rancière's critique of Habermas is cogent and represents an innovative and provocative contribution to the theory of democracy.},
    abstract_source = "openalex"
}

@misc{erman2009wrong,
    author = "Erman, Eva",
    title = "What is Wrong with Agonistic Pluralism? Reflections on Conflict in Democratic Theory",
    year = "2009",
    note = "CORE ARGUMENT: Erman argues, against the intuitive appeal of Mouffe's agonism, that conflict is in fact better understood within Habermasian discourse theory than within agonistic pluralism. She defends two theses: that discourse theory offers a more accurate account of conflict because it treats deliberation as constitutive of (not opposed to) conflict, and that some of Habermas's own assumptions about ethical discourse need revision to fully accommodate this insight. RELEVANCE: Offers a direct rebuttal to agonistic critiques of Habermas from a discourse-theoretic standpoint, giving the domain a paper that defends Habermas against Mouffe on her own chosen terrain (the adequacy of theorizing conflict) rather than simply cataloguing the objections. POSITION: Discourse-theoretic defense against agonistic pluralism, arguing agonism cannot adequately theorize the conditions of conflict it claims to center.",
    keywords = "agonism, Mouffe, deliberative-democracy, conflict, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "During the last couple of decades, concurrently with an increased awareness of the complexity of ethical conflicts, political theorists have directed attention to how constitutional democracy should cope with a fact of incommensurable doctrines. Poststructuralists such as Chantal Mouffe claim that ethical conflicts are fundamentally irreconcilable, which is indeed a view shared by many liberal theorists. The question of whether ethical conflicts are in principle irreconcilable is an important one since the answer has implications for what democratic institutions are desirable. In light of this question the article investigates the notion of conflict in agonistic pluralism and discourse theory. At first glance, Mouffe's agonism seems apt to accommodate ethical conflict in democratic governance, since it focuses on conflict as the core of politics, whereas Habermasian deliberative democracy seems inappropriate for this task, as it focuses on consensus. However, through an inquiry into the conditions of conflict this article will argue the opposite, namely, that conflict cannot be adequately understood within Mouffe's agonistic framework. The thesis defended is (1) that discourse theory offers a more accurate account of conflict than agonistic theory because it embraces the idea that deliberation is constitutive of conflict, and (2) that some of Habermas' assumptions concerning ethical discourse need to be revised in order for his democratic theory to fully accommodate this insight.",
    abstract_source = "openalex"
}

@article{kaltsas2019habermas,
    author = "Kaltsas, Spyridon",
    title = "Habermas, Taylor, and Connolly on Secularism, Pluralism, and the Post-Secular Public Sphere",
    journal = "Religions",
    year = "2019",
    volume = "10",
    note = {CORE ARGUMENT: Kaltsas compares Habermas, Charles Taylor, and William Connolly on secularism and the post-secular public sphere. Taylor criticizes Habermas's "institutional translation proviso," while Connolly stresses the agonistic dimension of the post-secular public sphere that he thinks Habermas's post-metaphysical account of secularism forecloses. Kaltsas ultimately defends a Habermasian reading centered on the internal relation between universal justification and pre-political solidarity, while conceding the need to incorporate an agonistic dimension. RELEVANCE: This is the clearest available source engaging Connolly's specific objections to Habermas (rather than Connolly's pluralism in the abstract), addressing the domain's requirement to represent Connolly alongside Mouffe and Rancière as a distinct agonistic interlocutor. POSITION: Partially sympathetic to Habermas but argues his framework must be supplemented with an agonistic dimension to handle religious and post-secular pluralism.},
    keywords = "agonism, Connolly, post-secular, pluralism, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = {The main purpose of this paper is to explore and understand the relationships between secularism, pluralism, and the post-secular public sphere in the thought of Jürgen Habermas, Charles Taylor, and William Connolly. The three authors develop a thorough critique of secularism which implies a radical break with the dogmatic idea of removing religion from the public sphere. My main objective is to show that this critique is related to a normative understanding of our post-secular situation and requires a rethinking of the boundaries of the public sphere in relation to the predicament of pluralism. Arguing against the post-metaphysical conception of secularism, Taylor develops a critique of Habermas's "institutional translation proviso", and Connolly stresses the agonistic dimension of the post-secular public sphere. I take these criticisms into account, while arguing that Taylor and Connolly are unable to provide a sound basis for the legitimacy of our institutional settings. In contrast to Taylor and Connolly, I propose a reading of Habermas's theory based on the internal relationship between universal justification and the everyday contexts of pre-political solidarity. I conclude with a focus on the need to take into account the agonistic dimension of the post-secular public sphere.},
    abstract_source = "s2"
}

@misc{kjaer2021systems,
    author = "Kjaer, Poul F.",
    title = "Systems in Context: On the Outcome of the Habermas/Luhmann Debate",
    year = "2021",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Kjaer argues that the Habermas-Luhmann debate, usually treated as a 1970s episode, in fact continued until Luhmann's death in 1998 and was characterized by convergence rather than divergence. In legal theory specifically, Kjaer contends Habermas's discourse theory came to function as a normative superstructure over Luhmann's descriptive systems theory of society, to the point that Habermas's own theoretical apparatus was substantially absorbed into Luhmann's systems-theoretical vocabulary -- an outcome facilitated by Luhmann's deliberate translation of Habermasian concepts into systems-theoretic terms. RELEVANCE: Directly addresses how the Luhmann challenge bears on Habermas's legal theory (the system/lifeworld distinction underlying "Between Facts and Norms"), providing the domain's central source on the long-run trajectory and outcome of the debate rather than just its 1970s opening exchange. POSITION: Revisionist account holding that the debate ended in a substantive theoretical convergence, with Habermas's normative commitments surviving only by being reframed in Luhmannian systems-theoretic terms.},
    keywords = "Luhmann, systems-theory, legal-theory, lifeworld-system, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Usually regarded as a 1970s phenomenon, this article demonstrates that the debate between Jurgen Habermas and Niklas Luhmann continued until Luhmann's death in 1998, and that the development of the two theorists' positions during the 1980s and 1990s was characterised by convergence rather than by divergence. In the realm of legal theory, the article suggests, convergence advanced to the extent that Habermas' discourse theory may be characterised as a normative superstructure to Luhmann's descriptive theory of society. It is further shown that the debate's result was an almost complete absorption of Habermas' theory by Luhmann's systems theoretical complex -- an outcome facilitated by Luhmann's deliberate translation of central Habermasian concepts into systems theoretical concepts. The article argues that both the debate and Habermas' conversion were made possible because not only Habermas' but also Luhmann's work can be considered a further development of the German idealist tradition. What Luhmann did not acknowledge was that this manoeuvre permitted the achievement of Habermas' normative objectives; nor did he notice that it could eradicate a central flaw in the system theoretical construction, by allowing the context within which distinctions are drawn to be mapped -- an issue of pivotal importance for grasping relationships between different social systems, and coordinating them, via the deployment of legal instruments.",
    abstract_source = "s2"
}

@misc{harste2021habermasluhmann,
    author = "Harste, Gorm",
    title = "The Habermas-Luhmann Debate",
    year = "2021",
    address = "New York",
    note = "CORE ARGUMENT: The first English-language book-length treatment of the controversy between Habermas and Luhmann, tracing their disagreement from its inception through Habermas's later work. Harste analyzes the dispute across methodology, ideology, truth, history, and politics, presenting it as one of the defining conflicts in twentieth-century social theory between a normative, discourse-theoretic account of society and a descriptive, functionalist systems theory. RELEVANCE: Provides book-length coverage of the debate for synthesis writers needing a comprehensive secondary source on how Luhmann's systems theory challenges Habermas's normative project, complementing the narrower, outcome-focused article by Kjaer. POSITION: Comprehensive secondary treatment situating the debate as a foundational conflict between critical-normative and systems-theoretic paradigms in social theory.",
    keywords = "Luhmann, systems-theory, social-theory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{rustemijovanoski2021controversy,
    author = "Jovanoski, Aleksandar and Rustemi, Agron",
    title = "The Controversy between Niklas Luhmann and Jürgen Habermas Related to Sociological Approach to Law",
    year = "2021",
    volume = "16",
    number = "1",
    note = "CORE ARGUMENT: The authors contrast Luhmann's systems-theoretic account of law -- in which law is an autonomous, self-referential subsystem of society rather than an instrument of politics -- with Habermas's sociologically-informed but normatively grounded account. They present the clash as fundamental: Luhmann treats social reality, including law, as composed of functionally differentiated subsystems of a deeper system (society), leaving no room for the kind of normative validity claims central to Habermas's discourse theory of law. RELEVANCE: A concise, focused overview of the specific point of collision between Luhmann and Habermas on legal theory, useful for synthesis writers who need a compact statement of the stakes before turning to Kjaer's or Harste's more extended treatments. POSITION: Presents the debate as an unresolved and fundamental disagreement over whether law can be normatively grounded or must be understood purely as self-referential systemic operation.",
    keywords = "Luhmann, systems-theory, legal-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Abstract The aim of the paper is to present a brief insight into the significant works and views of the German sociologists Niklas Luhmann and Jürgen Habermas on the role of law in regulating human relations in society. Educated as a lawyer, Niklas Luhmann in the late academic career was under the influence of the American sociologist Talcott Parsons. Niklas Luhmann later, under the influence of the American sociologist Talcott Parsons, he built a sociological theoretical system called the systems theory. On the other side, Jürgen Habermas was a philosopher and sociologist, highly influenced by the Frankfurt school of sociology. According to Luhmann's systems theory, the social reality and the separate aspects of the social life are part of a deeper system called society, and in relation to the same they are set as subsystems. Social systems are divided into allopoietic and autopoietic. One of the significant axioms of Luhmann's theory is that the largest number of systems tends to simplify due to the pressure of the environment for greater efficiency. Law in Luhman's systems theory enjoys the status of an autonomous system for regulating society, rather than an instrumental contribution to politics. This brief review exposed a big clash between two influential German thinkers. In this paper we are going to use historical method and analysing of the content of different materials and previous authors that are dealing with the work of Niklas Luhmann and Jürgen Habermas.",
    abstract_source = "s2"
}

@book{bailey2014deprovincializing,
    author = "Bailey, Tom",
    title = "Deprovincializing Habermas: Global Perspectives",
    year = "2014",
    publisher = "Routledge",
    note = {CORE ARGUMENT: This edited volume systematically engages Habermas's political theory from critical perspectives outside its Western locus, examining the theory's implications and limitations when applied to non-Western contexts. Contributors from political theory, global justice, postcolonial studies, and religious studies collectively press the charge that Habermas's framework is "provincial" despite its universalist self-understanding, while later chapters address Habermas's own responses to this charge. RELEVANCE: Serves as the domain's central anchor for the postcolonial critique of Habermas, providing multiple perspectives in one volume on the Eurocentrism charge and Habermas's attempted rebuttals, making it a natural hub reference for synthesis writers covering this cluster. POSITION: A collection organized around the "provincialism" charge against Habermas, spanning both critical (postcolonial, non-Western) and reconstructive responses.},
    keywords = "postcolonial, Eurocentrism, decolonial, global-justice, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Foreword. Introduction Tom Bailey Part I. Democratizing 1. Back to Kant? The Democratic Deficits in Habermas' Global Constitutionalism Lars Rensmann 2. Democratizing International Law: A Republican Reading of Habermas' Cosmopolitan Project James Bohman 3. Feminist Solidarity in India: Communitarian Challenges and Postnational Prospects Kanchana Mahadevan 4. Deliberation without Democracy? Reflections on Habermas, Mini-publics and China William Smith Part II. Decolonizing 5. Defending Habermas against Eurocentrism: Latin America and Mignolo's Decolonial Challenge Raymond Morrow 6. Care, Power and Deconstructive Postcolonialism: Reformulating the Habermasian Response Richard Ganis 7. From Communicative Modernity to Modernities in Tension John Rundell Part III. Desecularizing 8. What is Living and What is Dead in Habermas' Secularization Hypothesis? Kevin W. Gray 9. Reason and Li Xing: A Chinese Solution to Habermas' Problem of Moral Motivation Tong Shijun 10. Radicalizing the Post-secular Thesis, Provincializing Habermas Peter Losonczi. About the Editor. Notes on Contributors. Index",
    abstract_source = "openalex"
}

@book{allen2016end,
    author = "Allen, Amy",
    title = "The End of Progress: Decolonizing the Normative Foundations of Critical Theory",
    year = "2016",
    publisher = "Columbia University Press",
    address = "New York",
    note = "CORE ARGUMENT: Allen argues that while post- and decolonial theorists have debunked historical progress as a Eurocentric, imperialist fallacy, the leading contemporary Frankfurt School thinkers -- Habermas, Honneth, and Forst -- have persistently defended ideas of progress, development, and modernity, making such ideas central to their normative claims. She asks whether critical theory's emancipatory ambitions can survive this critique and sketches what a decolonized critical theory, informed by Foucauldian genealogy and Adornian negative dialectics, would look like. RELEVANCE: The single most sustained and influential critique of the developmental/progress assumptions underlying not only Habermas but also Honneth's and Forst's revisions of his project, making it essential for connecting the postcolonial and intra-critical-theory clusters of this domain. POSITION: Internal decolonial critique arguing that Habermas, Honneth, and Forst all remain committed to a Eurocentric philosophy of progress that their own normative frameworks cannot justify without external, non-Western validation.",
    keywords = "postcolonial, decolonial, Eurocentrism, Honneth, Forst, progress, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Amy Allen fractures critical theory from within by dispensing with its progressive reading of history while retaining its notion of progress as a political imperative. In reimagining a decolonized critical theory after the end of progress, she rescues it from oblivion and gives it a future for achieving emancipatory social goals.",
    abstract_source = "openalex"
}

@article{rees2017decolonizing,
    author = "Rees, Dafydd Huw",
    title = "Decolonizing Philosophy? Habermas and the Axial Age",
    journal = "Constellations",
    year = "2017",
    volume = "24",
    number = "2",
    note = {CORE ARGUMENT: Rees examines Habermas's use of the "Axial Age" thesis (the idea of a shared transformation of religious and philosophical worldviews across several world civilizations) as a test case for whether Habermas's developmental account of reason can be decolonized. He assesses how far Habermas's comparative-historical framework can accommodate non-Western traditions on their own terms rather than measuring them against a Western rationalization narrative. RELEVANCE: Offers a direct, textually grounded engagement with the Eurocentrism charge as it bears on Habermas's own writings (rather than on Honneth or Forst), giving the domain a source focused specifically on Habermas's philosophy of history rather than the broader Frankfurt School. POSITION: A qualified, immanent critique -- more sympathetic than Allen's -- that probes whether Habermas's own comparative resources can be redeployed to answer the decolonial challenge.},
    keywords = "postcolonial, decolonial, Eurocentrism, Axial-Age, Medium, METADATA\_CLEANED: pages, doi",
    abstract = {The "postsecular" phase in Jürgen Habermas's work began as an attempt to decolonize philosophy. Ever since his address at the Paulskirche in Frankfurt in October 2001, Habermas has linked the goal of developing a postsecular approach in philosophy and politics to the need to redress the balance between the West and the rest of the world. It is no longer possible, he says, to take secular European society as the global norm. Philosophy and political theory must acknowledge the fact that "occidental rationalism," rather than being a model for the rest of the world, is in fact the Sonderweg or deviant path. For Habermas, this Eurocentrism takes the form of an unreflexive secularism: assuming, based on European experience, that the decline of religion is inevitable, that religion has no place in politics, and that philosophical reason has nothing in common with religious faith. Modifying the secular assumptions of philosophy and political theory is therefore the first step towards a rapprochement with the non-Western world -- a rapprochement that is desperately needed if Western thinkers are not to appear as "crusaders of a competing religion or as salespeople of instrumental reason and destructive secularization." Although it is rarely acknowledged, this anti-Eurocentric impulse is at the heart of Habermas's postsecular project.},
    abstract_source = "openalex"
}

@misc{kempf2024habermas,
    author = "Kempf, Victor",
    title = "Habermas und Fanon über koloniale Herrschaft",
    year = "2024",
    volume = "72",
    number = "3",
    abstract = {From a decolonial perspective, Habermas' theory is seen by many as Eurocentric and in philosophical alliance with colonial rule. In particular, his theory of progress is seen as offensive because it devalues non-Western ways of understanding in comparison to their modern Western counterparts. On the one hand, this is true. On the other hand, Habermas' actual concept of progress can also be used to formulate a critique of colonialist development imperatives. Moreover, his concept of "systematically distorted communication" can make an interesting contribution to understanding colonial rule: even colonial rule is communicatively mediated, with the constant risk of dissent precariously held in check by racist discourse barriers. Fanon already provides strong starting points for this communication-theoretical view of colonial rule. With him, the decolonial struggles against racist discourse barriers also come into view.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Kempf stages a direct confrontation between Habermas and Frantz Fanon on colonial rule. He concedes the decolonial charge that Habermas's theory of progress devalues non-Western understanding by measuring it against Western modernity, but argues that Habermas's own concept of "systematically distorted communication" can be repurposed to analyze colonial domination as a communicatively mediated form of rule in which dissent is suppressed by racist discourse barriers -- a claim he supports by showing how Fanon's own analysis anticipates this communication-theoretic view. RELEVANCE: Provides a rare source that puts Habermas in direct dialogue with a canonical decolonial thinker (Fanon) rather than only with postcolonial theory in the abstract, and models a reconstructive rather than wholesale-rejectionist decolonial engagement with Habermasian concepts. POSITION: A mediating position between full decolonial rejection and defense of Habermas: accepts the Eurocentrism charge against his philosophy of history while salvaging his communication theory for decolonial analysis via Fanon.},
    keywords = "postcolonial, decolonial, Fanon, Eurocentrism, communication-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{honneth1995struggle,
    author = "Honneth, Axel",
    title = "The Struggle for Recognition: The Moral Grammar of Social Conflicts",
    year = "1995",
    address = "Cambridge, UK",
    sep_context = {SEP's "Recognition" entry cites Honneth (1995) twice: first among psychologically oriented recognition theories that treat loving care as the first form of recognition humans experience (alongside Benjamin 1988), and second as the proposal, taken up by later authors interested in social criticism (Iser 2008, Deranty 2009, Zurn 2015), to use recognition as a new paradigm for Critical Theory.},
    note = {CORE ARGUMENT: Honneth reconstructs Hegel's early Jena writings on the struggle for recognition to argue that the fundamental medium of social conflict is not material self-interest but the demand for recognition across three spheres -- love, rights, and social esteem. He proposes this recognition-theoretic model as an alternative normative foundation for critical social theory, one grounded in a "moral grammar" of everyday experiences of disrespect rather than in Habermas's linguistic-pragmatic account of communicative rationality. RELEVANCE: This is the foundational text of the most influential intra-critical-theory revision of Habermas's project, replacing his discourse-theoretic foundations with an intersubjective theory of recognition; it anchors the entire "Honneth" strand of debate covered by the other entries in this cluster (Zurn, Fraser and Honneth, Allen). POSITION: Recognition-theoretic revision of critical theory that shifts the normative foundation from Habermas's communicative rationality to a Hegelian-inflected theory of intersubjective recognition and moral injury.},
    keywords = "Honneth, recognition, critical-theory, intra-Frankfurt-School, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{fraserhonneth2003redistribution,
    author = "Fraser, Nancy and Honneth, Axel",
    title = "Redistribution or Recognition? A Political-Philosophical Exchange",
    year = "2003",
    address = "London",
    note = {CORE ARGUMENT: In this jointly authored exchange, Fraser argues that redistribution (a politics of material equality) and recognition (a politics of cultural respect) are two distinct, mutually irreducible dimensions of justice that cannot be collapsed into one another, while Honneth contends that a sufficiently differentiated theory of recognition can itself ground a comprehensive theory of justice, including claims to material redistribution, without needing a separate distributive paradigm. RELEVANCE: This exchange is the central primary document for the redistribution/recognition debate within critical theory, and it indirectly tests Habermas's discourse-theoretic proceduralism by asking whether either recognition or redistribution (or Habermasian procedural legitimacy) can serve as the sole normative currency of justice. POSITION: A two-sided intra-critical-theory debate: Fraser's dualist "perspectival dualism" versus Honneth's recognition monism, both developed as revisions or supplements to, rather than direct attacks on, Habermasian discourse theory.},
    keywords = "Fraser, Honneth, recognition, redistribution, justice, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{zurn2003identity,
    author = "Zurn, Christopher F.",
    title = "Identity or Status? Struggles over `Recognition' in Fraser, Honneth, and Taylor",
    journal = "Constellations",
    year = "2003",
    volume = "10",
    number = "4",
    note = {CORE ARGUMENT: Zurn maps the disagreements among Fraser, Honneth, and Taylor over what recognition is actually a demand for -- authentic cultural identity (Taylor), equal participatory status (Fraser), or differentiated forms of intersubjective esteem (Honneth) -- and argues these are not merely terminological differences but reflect deeper disagreements about the normative point of recognition politics and its relation to justice. RELEVANCE: Provides an analytically precise secondary mapping of the recognition debate that helps situate Honneth's revision of critical theory relative to both Fraser and Taylor, useful for synthesis writers needing to distinguish the different recognition paradigms rather than treating "recognition theory" as monolithic. POSITION: Comparative/critical analysis clarifying the stakes of the Fraser-Honneth-Taylor recognition debate without fully endorsing any one position.},
    keywords = "Fraser, Honneth, Taylor, recognition, Medium, METADATA\_CLEANED: pages, doi",
    abstract = {Fraser advocates recognition from the external perspective of an objective, social-scientific observer, who attends only to those distinctions between groups that are the result of institutionalized social relations of subordination, whether economic, political, or cultural. Calling this a "status" model of recognition politics, Fraser claims that it provides a better basis for a critical theory of struggles against denigration than competing "identity" models of recognition. Only by forswearing recourse to the prevailing identity model can theorists make normatively important distinctions between warranted and unwarranted claims for recognition. Furthermore, according to Fraser, only such a status model can be properly integrated with a theory of just economic distribution, so that one coherent framework of social justice can accommodate and reconcile claims for just social relations of distribution and recognition. Zurn argues that Fraser's general model does indeed represent an important advance over competing models of identity politics, but questions how many of its advantages are due to the status model specifically rather than to other theoretical components, defending the hypothesis that no adequate critical theory of recognition can be so objectivistic that it ignores the internal connections between struggles for recognition and the development of individual identity, in comparison with the competing identity-based models put forward by Axel Honneth and Charles Taylor.},
    abstract_source = "openalex"
}

@article{forst2007first,
    author = "Forst, Rainer",
    title = "First Things First: Redistribution, Recognition and Justification",
    journal = "European Journal of Political Theory",
    year = "2007",
    volume = "6",
    number = "3",
    note = {CORE ARGUMENT: Forst intervenes in the Fraser-Honneth debate to argue that both redistribution and recognition presuppose a more basic normative category: justification. On his view, what ultimately matters is whether persons possess an effective status as justificatory equals -- the power to demand and give reasons for the social arrangements that structure distribution and recognition alike -- making justification, not recognition or redistribution, the "first thing" in a theory of justice. RELEVANCE: This is the clearest statement of Forst's distinctive contribution to the "power blind spot" critique referenced in the domain brief: by insisting that relations of justification are also relations of power (who can demand justification from whom), Forst pushes beyond both Habermas's proceduralism and Honneth's/Fraser's frameworks to make power asymmetries in justificatory practices the central object of critique. POSITION: A justification-theoretic alternative that subsumes both recognition and redistribution under a more fundamental right to justification, developed partly as an immanent correction to gaps in Habermasian discourse theory.},
    keywords = "Forst, justification, power, recognition, redistribution, High, METADATA\_CLEANED: pages, doi",
    abstract = "This article analyses the debate between Nancy Fraser and Axel Honneth in a dialectical fashion. Their controversy about how to construct a critical theory of justice is not just one about the proper balance between `redistribution' and `recognition', it also involves basic questions of social ontology. Differing both from Fraser's `two-dimensional' view of `participatory parity' and from Honneth's `monistic' theory of recognition, the article argues for a third view of `justificatory monism and diagnostic-evaluative pluralism', also called the `first-things-first' approach. According to it, theories of recognition provide an essential sensorium for analyses of social suffering and of injustice, while with respect to the justification of justice claims, a discursive conception of justification is required. This, however, does not imply a purely `formal' account of justice; rather, it leads to a substantive understanding of the `grammar of justice', motivationally, socially and institutionally. Such an account of a critical theory of justice aims at a multidimensional critique of social and political `relations of justification'.",
    abstract_source = "openalex"
}

@article{stahl2013habermas,
    author = "Stahl, Titus",
    title = "Habermas and the Project of Immanent Critique",
    journal = "Constellations",
    year = "2013",
    volume = "20",
    number = "4",
    note = {CORE ARGUMENT: Stahl argues that despite Habermas's own claims to the contrary, his mature normative framework -- which rejects both transcendental and purely hermeneutic groundings of critical theory -- constitutes a novel and previously unrecognized form of "immanent critique." Stahl offers a formal account of immanent critique, distinguishes different ways of carrying it out, and situates Habermas's approach within this typology. RELEVANCE: Clarifies the methodological self-understanding of Habermas's critical theory in a way that bears directly on later immanent-critique- based objections to it (including the decolonial "critique as coloniality" challenge and Honneth's own immanent-critique methodology), making it a useful bridge between the intra-critical-theory and postcolonial clusters. POSITION: A reconstructive, largely sympathetic methodological analysis that nonetheless reframes Habermas's self-description of his own normative method.},
    keywords = "immanent-critique, methodology, critical-theory, Medium, METADATA\_CLEANED: pages, doi",
    abstract = {According to his own understanding, Jürgen Habermas' Theory of Communicative Action offers a new account of the normative foundations of critical theory. Habermas' motivating insight is that neither a transcendental or metaphysical solution to the problem of normativity, nor a merely hermeneutic reconstruction of historically given norms, is sufficient to clarify the normative foundations of critical theory. In response to this insight, Habermas develops a novel account of normativity which locates the normative demands upon which critical theory draws within the socially instituted practice of communicative understanding. Although Habermas has claimed otherwise, this new foundation for critical theory constitutes a novel and innovative form of "immanent critique." Stahl offers a formal account of immanent critique and distinguishes between two different ways of carrying out such a critique, examines Habermas' rejection of the hermeneutic option, shows that the Theory of Communicative Action attempts to formulate an immanent critique of contemporary societies according to a "practice-based" model, and argues that because Habermas commits himself to an implausibly narrow view regarding the social ontology of immanent normativity, his normative critique cannot develop its full potential.},
    abstract_source = "openalex"
}
