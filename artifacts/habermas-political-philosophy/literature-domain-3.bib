  POSITION: Sympathetic but sociologically probing exposition; questions whether Habermas's social theory can bear the normative weight his legal-political theory places on it.
  },
  keywords = {discourse-theory-of-law, system-lifeworld, monograph, High, INCOMPLETE, no-abstract}
}

@article{rehgbohman1996discourse,
  author = {Rehg, William and Bohman, James},
  title = {Discourse and Democracy: The Formal and Informal Bases of Legitimacy in Habermas' Faktizität und Geltung},
  journal = {Journal of Political Philosophy},
  year = {1996},
  volume = {4},
  number = {1},
  pages = {79--99},
  doi = {10.1111/j.1467-9760.1996.tb00043.x},
  note = {
  CORE ARGUMENT: Written shortly after the German publication of Faktizität und Geltung, Rehg and Bohman examine how Habermas grounds democratic legitimacy in both the formal, legally institutionalized procedures of parliamentary will-formation and the informal communication of the political public sphere, arguing that the two levels are jointly necessary: formal procedures alone cannot generate legitimacy without input from informal public deliberation, and informal deliberation alone lacks the binding, decision-producing capacity that law supplies.

  RELEVANCE: William Rehg is the English translator of Between Facts and Norms; this co-authored article represents his earliest scholarly engagement with the book's argument and functions as an authoritative secondary anchor for the formal/informal legitimacy architecture underlying the co-originality thesis.

  POSITION: Sympathetic reconstruction of Habermas's two-track (formal/informal) model of democratic legitimacy.
  },
  keywords = {legitimacy, formal-informal-legitimacy, discourse-theory-of-law, High, INCOMPLETE, no-abstract}
}

@article{baxter2014habermassociological,
  author = {Baxter, Hugh W.},
