@incollection{ingram2016morallyenlightened,
  author = {Ingram, David},
  title = {A Morally Enlightened Positivism? Kelsen and Habermas on the Democratic Roots of Validity in Municipal and International Law},
  booktitle = {Law and Philosophy Library},
  year = {2016},
  pages = {175--213},
  publisher = {Springer International Publishing},
  doi = {10.1007/978-3-319-33130-0_10},
  note = {
  CORE ARGUMENT: Against the commonplace view that Kelsen is a one-dimensional legal positivist and Habermas a one-dimensional legal moralist, Ingram argues both actually defend a complex normative conception of democratic proceduralism straddling the positivism/naturalism divide, opposed to Schmitt's decisionism. He compares their differing methods for defending democratic proceduralism, traces how each extends this proceduralism to international law in defending a monistic human-rights regime, and critically examines their proceduralist understanding of courts and constitutional review, concluding with an assessment of the limits of constitutionalizing international humanitarian law given persistent legal pluralization.

  RELEVANCE: Provides the domain's central positivist-adjacent comparison (Kelsen/Habermas), directly addressing the third key question's request for jurisprudential critique "from legal positivists" by showing where Habermas's discourse-theoretic account of legal validity converges with and diverges from Kelsenian positivism.

  POSITION: Comparative reconstruction locating both Kelsen and Habermas as "morally enlightened" proceduralists between pure positivism and natural law.
  },
  keywords = {legal-positivism, Kelsen, legal-validity, High, INCOMPLETE, no-abstract}
}

@article{pedersen2011justification,
  author = {Pedersen, Jørgen},
  title = {Justification and Application: The Revival of the Rawls-Habermas Debate},
  journal = {Philosophy of the Social Sciences},
  year = {2011},
  volume = {42},
  number = {3},
  pages = {399--432},
  doi = {10.1177/0048393111414723},
  note = {
  CORE ARGUMENT: Pedersen argues that Rawls and Habermas develop different "freestanding" conceptions of political legitimacy that diverge over how legitimacy can be justified -- Habermas seeking a deeper justification than Rawls's political liberalism allows. Focusing on rights and popular sovereignty, Pedersen shows both thinkers conceive of a co-originality between private and public autonomy, but argues Habermas misreads Rawls: Rawls should not be read as a natural-rights theorist, Habermas misunderstands the role of the original position, and Rawls cannot be considered a strong constitutionalist. The real disagreement, Pedersen concludes, concerns their differing conceptions of political legitimacy itself.

  RELEVANCE: Shows that the co-originality thesis is not unique to Habermas but has a structural counterpart in Rawlsian political liberalism, clarifying exactly where the substantive disagreement between the two paradigms of liberal-democratic legitimacy lies -- directly relevant to situating co-originality within the broader field of theories of rights and popular sovereignty.

  POSITION: Comparative political-legitimacy theorist; defends a reading of Rawls against what he takes to be Habermas's misreading, while taking both to share the co-originality structure.
  },
  keywords = {co-originality, Rawls, political-legitimacy, popular-sovereignty, Medium},
  abstract = {The Rawls–Habermas debate is having a revival. In this article I argue that both philosophers develop different freestanding conceptions of political legitimacy, and show how they diverge when it comes to how political legitimacy can be justified. Habermas is looking for a deeper justification than Rawls will allow for. I then proceed to show how the different meta-ethical positions yield two different versions of democratic theory, focusing in particular on rights and popular sovereignty. I demonstrate how both conceive of the co-originality of private and public autonomy, and subsequently take issue with Habermas’ reading of Rawls. I argue that Rawls should not be understood as a natural rights theorist, that Habermas misunderstands the role of the original position, and that Rawls cannot be considered a strong constitutionalist. Thus, the real difference between Rawls and Habermas revolves around their different conceptions of political legitimacy.},
  abstract_source = {openalex}
}

@article{zurn2002deliberative,
  author = {Zurn, Christopher F.},
  title = {Deliberative Democracy and Constitutional Review},
  journal = {Law and Philosophy},
  year = {2002},
  volume = {21},
  number = {4-5},
  pages = {467--542},
  doi = {10.1023/A:1020969709044},
  note = {
  CORE ARGUMENT: Zurn re-examines the traditional democratic objection to judicial review as anti-democratic paternalism within the framework of deliberative constitutional-democratic theory. Using a two-by-two framework crossing aggregative-versus-deliberative democratic processes with substantive-versus-procedural legitimacy, he argues Habermas's account of constitutional review's function is superior to those of Ely, Perry, and Dworkin, while contending that Habermas's proposal for judicial review with a broad set of duties needs modification in light of commitments to participatory deliberative processes and procedural legitimacy.

  RELEVANCE: Directly answers this domain's second key question concerning Habermas's reconstruction of the rule of law and constitutionalism, situating his account of constitutional review comparatively against major rival American constitutional theories (Ely, Perry, Dworkin) and proposing internal revisions.

  POSITION: Sympathetic-but-revisionist proceduralist; argues for a more participatory, procedurally focused version of Habermas's constitutional-review theory.
  },
  keywords = {constitutional-review, rule-of-law, judicial-review, High},
  abstract = {This paper re-examines the traditional democratic objection to judicial review as an instance of anti-democratic paternalism, within the context of newer ‘deliberative’ theories of constitutional democracy. Using a framework of two cross-cutting distinctions between aggregative versus deliberative democratic processes and between substantive versus procedural legitimacy, it argues that Habermas’s account of the function of constitutional review of legislation is superior to those offered by Ely, Perry, and Dworkin. However, Habermas’s proposal for a judicial institutionalization of review with a broad set of duties needs to be modified in the light of theoretical commitments to participatory deliberative processes and procedural legitimacy.},
  abstract_source = {s2}
}

@article{shoikhedbrod2020revolution,
  author = {Shoikhedbrod, Igor},
  title = {Revolution or Legality? Confronting the Spectre of Marx in Habermas's Legal Philosophy},
  journal = {Contemporary Political Theory},
  year = {2020},
  volume = {20},
  number = {1},
  pages = {72--95},
  doi = {10.1057/s41296-020-00385-6},
  note = {
  CORE ARGUMENT: Shoikhedbrod traces Habermas's long-standing conviction, from his 1962 reading of Marx through Between Facts and Norms, that Marx's attempt to "turn Hegel right side up" resulted in a one-sided embrace of revolution and a perilous rejection of legality and rights -- a rejection Habermas thinks was vindicated by the collapse of state socialism. The article revisits this revolution/legality dichotomy in view of Habermas's ambivalent relation to "Marx's spectre" and his ongoing debate with Wolfgang Streeck over the tension between democracy and capitalism, arguing a careful reconsideration of Marx offers resources for responding to Streeck's critique and reviving a project of "radical reformism" amid contemporary attacks on the liberal constitutional order.

  RELEVANCE: Supplies the domain's Marxist/critical-legal-theory line of critique, testing whether Habermas's proceduralist, rights-based reconstruction of law forecloses more radical (Marxian) critiques of the relationship between legality, capitalism, and democracy.

  POSITION: Sympathetically critical Marxian reading; argues Habermas's legal philosophy needs supplementing rather than replacing to meet contemporary crises of democratic capitalism.
  },
  keywords = {Marx, critical-legal-theory, revolution-legality, capitalism, Medium, INCOMPLETE, no-abstract}
}

@incollection{hedrick2018reification,
  author = {Hedrick, Todd},
  title = {Reification and Reconciliation in Habermas' Theory of Law and Democracy},
  booktitle = {Reification and the Aims of Sociology: Reconciliation and Reification},
