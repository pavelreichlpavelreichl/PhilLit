  doi = {10.1177/0191453713518327},
  note = {
  CORE ARGUMENT: Replying to critics (Wirts, Flynn, and Zurn) of his 2011 book, Baxter defends and refines his reading of Habermas's social theory in Between Facts and Norms, focusing critically on the concept of "the lifeworld" and asking whether a circulation-of-power model of democratic legitimation can be mapped onto Habermas's system/lifeworld framework.

  RELEVANCE: Documents an internal scholarly debate (a full symposium in Philosophy & Social Criticism) specifically over whether Habermas's sociological premises can support his normative claims about law and democracy -- directly bearing on how robust the co-originality and proceduralist-paradigm arguments are once their social-theoretic scaffolding is scrutinized.

  POSITION: Sociologically critical but broadly sympathetic reconstruction; represents the "systems-theoretic critique" strand of the secondary literature.
  },
  keywords = {system-lifeworld, sociological-critique, discourse-theory-of-law, Medium},
  abstract = {In Between Facts and Norms (1996) Habermas presents the more straightforward normative discourse theory of law and democracy, in terms of contemporary legal orders, and then examines, in terms of social theory, whether the theory is plausible, given the complex nature of today’s conditions. The following article focuses in particular on Habermas’ social theory. It is critical of Habermas’ idea of ‘the lifeworld’ and discusses whether the circulation-of-power model might be mapped onto the system–lifeworld model.},
  abstract_source = {openalex}
