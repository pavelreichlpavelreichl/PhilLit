@misc{habermas2018europeannationstate,
    author = {Habermas, J{\"u}rgen},
    title = "The European Nation State: Its Achievements and Its Limitations. On the Past and Future of Sovereignty and Citizenship",
    year = "2018",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Habermas argues that the modern nation-state's historical success rests on a fusion of two distinct elements: a republican, legal-constitutional order of citizenship, and a "nation" understood as a pre-political community of shared ethnicity, language, or culture. He examines this tension between republicanism and nationalism built into the nation-state form and argues that the multicultural differentiation of civil society, together with trends toward globalization, exposes the limitations of this historically specific fusion -- motivating a political identity (constitutional patriotism) decoupled from national culture. RELEVANCE: This is Habermas's own programmatic statement of the republicanism/nationalism tension within the nation-state form that underlies the entire constitutional patriotism literature collected in this domain; it is the primary text against which Cronin, Ingram, Michelman, Müller, Markell, Hayward, Lacroix, and Rosenfeld are all responding. (Originally published 1996; this entry cites the 2018 reprint, the version with a verifiable DOI.) POSITION: Primary text; the object of the domain's reconstructive-defense and critical literatures alike.},
    keywords = "constitutional-patriotism, national-identity, postnational, primary-text, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "The ``global success'' of nation states is currently brought into play by the new requirements of multicultural differentiation and globalization. After commenting on the common concepts of ``state'' and ``nation'' and discussing the formation of nation states, the author explains the particular achievement of the national state and the tension between republicanism and nationalism built into it. The challenges that arise from the multicultural differentiation of civil society and from trends towards globalization throw light on the limitations of this historical type.",
    abstract_source = "openalex"
}

@misc{mueller2007constitutionalpatriotism,
    author = {M{\"u}ller, Jan-Werner},
    title = "Constitutional Patriotism",
    year = "2007",
    address = "Princeton, NJ",
    note = {CORE ARGUMENT: M{\"u}ller offers what is presented (per the publisher's synopsis) as a general theory of constitutional patriotism as a form of civic allegiance for culturally diverse liberal democracies: political attachment should center on the norms of a liberal-democratic constitution as locally interpreted, rather than on national culture or an undifferentiated "global human community." He traces the concept's origins (Sternberger, then Habermas), defends a version of it that makes room for dissent and civil disobedience while addressing a polity's need for stability, and extends the analysis to the European Union as well as to the United States, drawing out concrete implications for immigration and citizenship policy. [Note: no abstract available for a monograph; description is based on the publisher's own synopsis and confirmed by multiple contemporary book reviews found via search (Perspectives on Politics, Ethics, Persona y Derecho).] RELEVANCE: This is the fullest single treatment of constitutional patriotism as a general theory rather than a Habermas-exegetical topic, and functions as the reference point against which the domain's other reconstructive and critical papers (several by M{\"u}ller himself, in article form) can be read; it directly addresses this domain's first key question (grounding solidarity without ethnic/national identity). Confirmed as a bibliography item in the SEP "Patriotism" entry. POSITION: Reconstructive defense that also revises the concept, arguing for a version compatible with dissent and civil disobedience rather than Habermas's original formulation alone.},
    keywords = "constitutional-patriotism, citizenship, postnational, defense, Muller, INCOMPLETE, no-abstract, High, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{mueller2006origins,
    author = {M{\"u}ller, Jan-Werner},
    title = "On the Origins of Constitutional Patriotism",
    journal = "Contemporary Political Theory",
    year = "2006",
    volume = "5",
    number = "3",
    pages = "278--296",
    doi = "10.1057/palgrave.cpt.9300235",
    note = {CORE ARGUMENT: M{\"u}ller reconstructs the genealogy of constitutional patriotism, arguing that both Dolf Sternberger's earlier "protective," state-centered version and Habermas's later "purifying," public-sphere-centered version rely, contrary to their own self-understanding, on unacknowledged "supplements of particularity." He argues that the standard genealogical critique -- that constitutional patriotism was a plausible ideal only for a "half-nation" like postwar West Germany, with its deeply compromised national identity, and is not portable elsewhere -- can be answered by showing normative (not merely historically contingent) connections between constitutional patriotism, militant democracy, and an imperative to remember past injustice. [Note: abstract not available from indexed sources; description is based on a substantive PhilPapers-indexed abstract snippet located during search.] RELEVANCE: Directly addresses this domain's second key question by tracing how the Historikerstreit-era German context shaped the concept, while also defending its applicability beyond that context; provides the historical groundwork later expanded in M{\"u}ller's 2007 monograph. POSITION: Reconstructive defense against the "context-bound origins" objection to constitutional patriotism.},
    keywords = "constitutional-patriotism, historikerstreit, genealogy, Muller, INCOMPLETE, no-abstract, High"
}

