@incollection{ulam2024historiography,
  author = {Ulam, Adam B.},
  title = {Socialism in Current Soviet Historiography},
  booktitle = {Contemporary History in the Soviet Mirror},
  year = {2024},
  pages = {199--221},
  publisher = {Routledge},
  doi = {10.4324/9781003531487-10},
  note = {
  CORE ARGUMENT: Ulam argues that Soviet historians faced an intractable
  classificatory dilemma in assigning Plekhanov his "correct" place in official
  history: as "the father of Russian Marxism" he could not be denied a position of
  honor, yet his Menshevism and opposition to the October Revolution meant he could
  not be treated as a straightforward forerunner of Bolshevism either. Ulam
  memorably compares the problem to deciding what to do with "the bride's divorced
  father who shows up at the wedding" -- Plekhanov must be seated somewhere in the
  church, with a precisely calibrated degree of reverence, but the correct protocol
  is never self-evident and must track shifting party doctrine.

  RELEVANCE: Offers the single sharpest formulation in the literature of this
  domain's core problem -- the structural impossibility, within Soviet officially
  sanctioned historiography, of giving Plekhanov a stable rank -- and does so with a
  wit that itself signals a critical, non-hagiographic Western Sovietological
  perspective on Soviet historical method.

  POSITION: Critical Western Sovietological analysis of the internal contradictions
  of official Soviet historiography's treatment of Plekhanov, originally published in
  the 1964 edited volume "Contemporary History in the Soviet Mirror" and reissued by
  Routledge.
  },
  keywords = {soviet-historiography, classification-problem, cold-war-sovietology, High},
  abstract = {The Soviet historian, wrote Voprosy Istorii in March 1957 (p. 4), dare not be merely 'a by-stander, or a copyist of materials, [or] a collector of evidence which by chance has fallen into his hand.' He is an active participant in the work of socialist construction, an exponent of Marxism-Leninism, an interpreter of the past in the light of guidance laid down by his party and the state. An exasperated western observer may feel, after having absorbed a quota of contemporary Soviet historiography, that the art of writing modern history in the ussr has come to resemble that of an American writer on etiquette. The problem of what to do with the bride's divorced father who shows up at the wedding typifies the major methodological and classificatory dilemmas involved in assigning a 'correct' place in history to, say, Plekhanov. The father of Russian Marxism cannot be assigned the place of honour because of the transgressions of his later days, nor can he be pushed out of the church because of his organic connection with the proceedings. Exactly where to put him in the church and what degree of reverence and cordiality to observe towards him are the questions which confront a conscientious Soviet historian, and his answers, like those of Emily Post, have to be precise and in complete agreement with accepted theory and practice.},
  abstract_source = {openalex}
}

@book{hook2023heroinhistory,
  author = {Hook, Sydney},
  title = {The Hero in History},
  year = {2023},
  publisher = {Routledge},
  doi = {10.4324/9781003419198},
  note = {
  CORE ARGUMENT: Hook singles out orthodox Marxism as the most encompassing
  determinist system in modern social thought and subjects the historical thinking of
  Engels, Plekhanov, and Trotsky to sustained critical scrutiny, arguing that
  Plekhanov's determinist "role of the individual in history" framework cannot
