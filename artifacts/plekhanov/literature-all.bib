@article{deutscher1964review,
  author = {Deutscher, Isaac},
  title = {The Mensheviks: George Plekhanov},
  journal = {The Listener},
  year = {1964},
  url = {https://www.marxists.org/archive/deutscher/1964/mensheviks-plekhanov.htm},
  note = {
  CORE ARGUMENT: Reviewing Baron's biography, Deutscher credits Plekhanov with
  achieving "a brilliant intellectual conquest" in transplanting Marxism to Russia
  and with being, after Engels's death, Europe's foremost interpreter of dialectical
  materialism and its most irreconcilable anti-revisionist, rivaling even Rosa
  Luxemburg in orthodoxy. Yet Deutscher argues Plekhanov's very intellectual
  refinement -- he compares him to Erasmus -- left him lacking the "oaken strength"
  that history required: having stood alone with Lenin against the Mensheviks in
  1903, Plekhanov nonetheless rejected Lenin's peasant-oriented strategy as a
  regression to Populism, and World War I permanently divided them when Plekhanov
  adopted "social patriotism" against Lenin's revolutionary defeatism, so that
  Plekhanov "had exhausted himself in the great intellectual labour through which he
  had prepared the revolution" without being able to transcend his generation's
  historical limits, dying shortly after October 1917 as a broken, embittered exile.

  RELEVANCE: Offers one of the most literarily developed tragic readings of
  Plekhanov's political trajectory in the secondary literature, directly addressing
  this domain's question of whether his path from revolutionary to "father of
  Menshevism" and wartime patriot exhibits an internally coherent logic (Deutscher
  says yes: a mismatch between refined theoretical intelligence and the "ruthless"
  practical demands of revolution) rather than mere inconsistency or personal
  failing.

  POSITION: Independent Marxist-historian tragic assessment (Erasmus-to-Lenin's-
  Luther framing) of Plekhanov's political trajectory, distinct from both the
  Trotskyist-organizational critique (Cliff) and the permanent-revolution-theoretic
  account (North and Volkov) also cataloged in this domain.
  },
  keywords = {political-trajectory, menshevism, tragic-narrative, lenin-comparison, Medium, web-source, INCOMPLETE, no-abstract}
}

@misc{cliff1957plekhanov,
  author = {Cliff, Tony},
  title = {Plekhanov: Father of Russian Marxism},
  year = {1957},
  howpublished = {\url{https://www.marxists.org/archive/cliff/works/1957/01/plekhanov.htm}},
  note = {
  Originally published in Socialist Review, Vol. 4, January 1957, and reprinted in A
  Socialist Review (London, 1965).

  CORE ARGUMENT: Cliff credits Plekhanov as the pivotal figure who transplanted
  Marxist theory onto Russian soil and correctly identified the industrial working
  class, rather than the peasantry, as the force destined to overthrow Tsarism,
  praising his philosophical essays as an outstanding contribution to international
  Marxist literature. However, Cliff argues Plekhanov's decisive weakness was his
  lack of direct experience organizing actual workers -- he remained a theoretician
  rather than a mass organizer -- and that this theoretical isolation, compounded by
  his emphasis on Russia's economic backwardness, pushed him toward compromise with
  the liberal bourgeoisie, eventuating in his drift to Menshevism and his support for
  Tsarist Russia's war effort in 1914, which Cliff reads as a betrayal of Plekhanov's
  own founding revolutionary principles.

  RELEVANCE: Represents a distinct (International Socialist-tendency) Trotskyist
  diagnosis of Plekhanov's political "failure," locating its cause in organizational
  isolation from the working class rather than in the internal logic of his
  revolutionary theory (contrast North and Volkov, cataloged separately) or in a
  mismatch between intellectual temperament and revolutionary ruthlessness (contrast
  Deutscher, cataloged separately), illustrating that Marxist critics of Plekhanov do
  not speak with one voice about the causes of his political trajectory.

  POSITION: Trotskyist (International Socialist tendency) critical assessment
  attributing Plekhanov's drift to Menshevism to his organizational distance from the
  proletariat.
  },
  keywords = {political-trajectory, menshevism, trotskyist-critique, organizational-isolation, Medium, web-source, INCOMPLETE, no-abstract}
}

@misc{northvolkov2016wsws,
  author = {North, David and Volkov, Vladimir},
  title = {Georgi Valentinovich Plekhanov (1856--1918): His Place in the History of Marxism},
  year = {2016},
  howpublished = {\url{https://www.wsws.org/en/articles/2016/12/05/plek-d05.html}},
  note = {
  CORE ARGUMENT: Writing from the standpoint of the International Committee of the
  Fourth International, North and Volkov argue that Plekhanov's identification of the
  working class as Russia's decisive revolutionary force was a major theoretical
  achievement that made the October Revolution conceivable, even though Plekhanov
  himself personally opposed that revolution -- a paradox the authors attribute not
  to personal weakness but to the fact that Plekhanov's two-stage theory of
  revolution (bourgeois-democratic revolution first, socialism only after a
  protracted capitalist development) was overtaken by events; his 1914 support for
  the war and 1917 opposition to Bolshevism are read as logical extensions of that
  theoretical framework becoming incompatible with a fast-changing objective
  situation, rather than as isolated errors. They explicitly connect the study of
  Plekhanov's "tragic fate" to understanding the genesis of Trotsky's theory of
  permanent revolution.

  RELEVANCE: Offers a rival Trotskyist account of Plekhanov's political trajectory,
  explaining his "betrayal" through the specific content of his two-stage
  revolutionary theory rather than through personal or organizational failings, and
  explicitly ties assessment of Plekhanov to the historiographical genealogy of
  permanent-revolution theory addressed elsewhere in the political-trajectory domain
  of this review.

  POSITION: ICFI/Trotskyist theoretical assessment locating the cause of Plekhanov's
  political "betrayal" in the internal logic of his two-stage theory of revolution,
  contrasting with Cliff's organizational-isolation account and Deutscher's
  temperament-based tragic reading.
  },
  keywords = {political-trajectory, permanent-revolution, trotskyist-critique, two-stage-theory, Medium, web-source, INCOMPLETE, no-abstract}
}

@misc{jameswhite2023jacobin,
  author = {White, James D.},
  title = {Georgii Plekhanov Was the Father Of Russian Marxism Who Disliked His Children},
  year = {2023},
  howpublished = {\url{https://jacobin.com/2023/06/georgii-plekhanov-marxism-russian-revolution-philosophy-dialectical-materialism}},
  note = {
  CORE ARGUMENT: White -- also the author of the Routledge Encyclopedia of
  Philosophy entry on Plekhanov cataloged in the philosophical-foundations domain --
  argues in this popular-venue reassessment that Plekhanov remains comparatively
  neglected in Western scholarship despite the continuing, largely unacknowledged
