  POSITION: Primary source; Plekhanov's historiography of eighteenth-century French materialism.
  },
  keywords = {french-materialism, holbach, helvetius, primary-source, High, INCOMPLETE, no-abstract},
}

@misc{plekhanov1969fundamental,
  author = {Plekhanov, Georgii Valentinovich},
