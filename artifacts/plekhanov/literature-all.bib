}

@article{leblanc2013spider,
  author = {Le Blanc, Paul},
  title = {Spider and Fly: The Leninist Philosophy of Georg Lukács},
  journal = {Historical Materialism},
  year = {2013},
  volume = {21},
  number = {2},
  pages = {47--75},
  doi = {10.1163/1569206x-12341298},
  note = {
  CORE ARGUMENT: Argues that Lukacs's key works of 1923-9 ("History and Class Consciousness," "Lenin: A Study in the Unity of His Thought," "Tailism and the Dialectic," and "The Blum Theses") form a consistent, coherent variant of Leninism, aligned with the political orientation Lenin and Trotsky advanced at the Third and Fourth Congresses of the Communist International, during Lukacs's own leadership (with Jeno Landler) of a faction opposing Bela Kun's ultra-left sectarianism in the Hungarian Communist Party. Contests influential readings that label these works ultra-leftist or proto-Stalinist, and notes that after his political defeat Lukacs renounced practical revolutionary politics and adapted to Stalinism, redirecting his efforts to literary criticism and philosophy.

  RELEVANCE: Reframes Lukacs's reception of Lenin as a considered, practically-engaged Leninist political position rather than an abstract philosophical alternative to Plekhanov's materialism, showing that Western Marxism's most influential Hegelian reading of Lenin originated in concrete factional politics within the Comintern rather than purely in philosophical disagreement with Plekhanovite orthodoxy.

  POSITION: Revisionist account situating Lukacs's 1920s Leninism as politically orthodox (in the Lenin-Trotsky sense) rather than an ultra-left or proto-Stalinist deviation.
  },
  keywords = {Lukacs, Western-Marxism, Lenin, Comintern, Medium},
  abstract = {From 1919 to 1929, the great Hungarian Marxist philosopher Georg Lukács was one of the leaders of the Hungarian Communist Party, immersed not simply in theorising but also in significant practical-political work. Along with labour leader Jenö Landler, he led a faction opposing an ultra-left sectarian orientation represented by Béla Kun (at that time also associated with Comintern chairman Zinoviev, later aligning himself with Stalin). If seen in connection with this factional struggle, key works of Lukács in this period -- History and Class Consciousness (1923), Lenin: A Study in the Unity of His Thought (1924), Tailism and the Dialectic (1926) and 'The Blum Theses' (1929) -- can be seen as forming a consistent, coherent, sophisticated variant of Leninism. Influential readings of these works interpret them as being ultra-leftist or proto-Stalinist (or, in the case of 'The Blum Theses', an anticipation of the Popular Front perspectives adopted by the Communist International in 1935). Such readings distort the reality. Lukács's orientation and outlook of 1923-9 are, rather, more consistent with the orientation advanced by Lenin and Trotsky in the Third and Fourth Congresses of the Communist International. After his decisive political defeat, Lukács concluded that it was necessary to renounce his distinctive political orientation, and completely abandon the terrain of practical revolutionary politics, if he hoped to remain inside the Communist movement. This he did, adapting to Stalinism and shifting his efforts to literary criticism and philosophy. But the theorisations connected to his revolutionary politics of the 1920s continue to have relevance for revolutionary activists of the twenty-first century.},
  abstract_source = {openalex},
}

@article{szabadossautkin2021lukacs,
  author = {Szabados, Bettina and Sautkin, Aleksandr},
  title = {Intellectual Evolution of Georg Lukács in the Context of Developing Lenin's Idea of Revolution},
  journal = {Filosofija. Sociologija},
  year = {2021},
  volume = {32},
  number = {1},
  doi = {10.6001/fil-soc.v32i1.4379},
  note = {
  CORE ARGUMENT: Traces Lukacs's path from aesthetic essayist to Marxist theorist, showing how, after the 1918 turn to Marxism and the failure of the 1919 Hungarian Soviet Republic, Lukacs drew on Lenin's ideas of revolution to formulate his positions in "History and Class Consciousness" (1923) and "Lenin: A Study on the Unity of his Thought" (1924).

  RELEVANCE: Documents the specific intellectual mechanism by which Lenin's political-philosophical ideas were absorbed into Western Marxism through Lukacs, offering a contrasting case to the Plekhanov-Lenin materialist lineage: Lukacs's Lenin is read through Hegelian categories of totality and praxis rather than through reflection-theoretic materialism.

  POSITION: Intellectual-biographical account of Lukacs's Leninism as a distinctively Hegelian-Marxist current within Western Marxism's reception of Lenin.
  },
  keywords = {Lukacs, Lenin, Western-Marxism, Medium},
  abstract = {The Hungarian philosopher, Georg Lukács, recognized the crisis-consciousness of his generation at the turn of the 20th century and began to search for solutions in the art. However, his theory about art proved to be illusory, being unable to reshape society. After many philosophical attempts to realize his theory in praxis, in 1918 Lukács turned to Marxism and later became one of the most influential Marxist thinkers of his time. In 1919, when the Hungarian Soviet Republic fell, Lukács, like many other intellectuals, had to flee abroad. In emigration, he started to summarize the experiences of the fallen revolution and referred to Lenin's ideas in his early Marxist works, in 'History and Class Consciousness' (1923) and 'Lenin: A Study on the Unity of his Thought' (1924). This paper aims to follow Lukács' path, how he became a Marxist from an Essayist, and what solutions he found for the social crises of his era.},
  abstract_source = {s2},
}

