@article{steila2021spinoza,
  author = {Steila, Daniela},
  title = {Interpretations of Spinoza in Early Russian Marxism},
  journal = {Studies in East European Thought},
  year = {2021},
  volume = {74},
  number = {3},
  pages = {279--296},
  doi = {10.1007/s11212-021-09410-9},
  note = {
  CORE ARGUMENT: Reconstructs Plekhanov's understanding of Spinoza's ontology and epistemology, from his critique of German revisionism in the late 1890s to his later polemics against empiriocriticism, arguing that Plekhanov treated Spinoza's substance monism as a theologically-clothed anticipation of dialectical materialism while dismissing Spinoza's "theological" language as a historical relic. Contrasts this with Lunacharskii's rival reading, which took Spinoza's religious language as a genuine forerunner of Marxist feeling.

  RELEVANCE: Directly addresses how Plekhanov constructs his monism through a materialist reading of Spinoza and clarifies the philosophical stakes of the monism debates within Russian Marxism, showing this was contested territory even among self-identified materialists.

  POSITION: Historical-philosophical reconstruction of Plekhanov's Spinozist monism against rival (Machist, Lunacharskian) interpretations.
  },
  keywords = {monism, spinoza, epistemology, High},
  abstract = {The roots of the controversial readings of Spinoza during Soviet times date back to the history of Russian Marxism. Spinoza was a most influential figure whom different Marxist currents and thinkers wanted to have on their side. This article examines the most relevant interpretations. First, it sketches some fundamental traits of Plekhanov’s understanding of Spinoza’s ontology and epistemology, from his critique of German revisionism at the end of the 1890s to his polemics against empiriocriticism and its Russian impact. Spinoza was a particularly relevant and authoritative thinker for the so-called “Machists” as well, and some of their different interpretations are analyzed as representing their critical approach to Marxism. Finally, Lunacharskiiʼs discussion is considered as a peculiar alternative to Plekhanov’s orthodox understanding not only of Spinoza but of Marxism itself. While Plekhanov judged Spinoza’s “theological” language a relic of his epoch, Lunacharskii maintained that it was precisely his “religious” feelings that made Spinoza a forerunner of Marxism.},
  abstract_source = {s2},
}

@incollection{steinberg2024russianmarxism,
  author = {Steinberg, Justin},
  title = {Russian Marxism and the Materialist Interpretation of Spinoza},
  booktitle = {The History and Philosophy of Materialism},
  year = {2024},
  pages = {351--363},
  publisher = {Routledge},
  address = {New York},
  doi = {10.4324/9781003118879-30},
  note = {
  CORE ARGUMENT: Compares the rival materialist readings of Spinoza advanced by Plekhanov, Abram Deborin, and Lyubov Akselrod, arguing that Deborin's identification of Spinozist Nature with matter fails as an interpretation, Akselrod's asymmetric-dependence account fails both as Spinoza interpretation and as materialism, and Plekhanov's reading — which treats materialism as compatible with panpsychism — is the most defensible of the three, though Spinoza's own metaphysics is not best described as materialism at all.

  RELEVANCE: Provides a philosophically rigorous, non-partisan evaluation of the coherence of Plekhanov's monistic materialism as an interpretation of Spinoza, directly bearing on how philosophically defensible his core ontological framework is.

  POSITION: Analytic assessment favoring Plekhanov's Spinoza reading over Deborin's and Akselrod's among Russian Marxist interpreters.
  },
  keywords = {monism, spinoza, epistemology, High},
  abstract = {Spinoza was not a materialist, at least not as typically understood today. He was a substance monist and a pluralist about what kinds of things exist. Nevertheless, Spinoza has often been read as a materialist, and one prominent strand of this materialist reading may be traced back to the Russian Marxist Georgi Plekhanov, who, beginning in the 1890s, engaged in a series of polemics in which he defended a comprehensive materialist reading of Spinoza – one that would cover both ontological and dialectical materialism, or “old” and “new” materialism – that would cement Spinoza’s status as the great progenitor of political radicalism. In the controversies that would follow, Plekhanov’s followers Abram Deborin and Lyubov Akselrod, offered their own materialist readings of Spinoza. In this chapter, I analyze the distinct materialist readings of Spinoza advanced by Deborin, Akselrod, and Plekhanov. I argue that Deborin’s approach, according to which Spinoza identifies Nature with matter, fails as an interpretation, that Akselrod’s alternative, according to which ideas are in some sense asymmetrically dependent on bodies, fails either as an interpretation of Spinoza or as an account of materialism, leaving Plekhanov’s interpretation of Spinoza, which takes materialism to be compatible with panpsychism, as the most plausible of the bunch. While Spinoza’s metaphysics is probably not best described as materialism, it is, in crucial respects, closer than many early modern versions of materialism are to contemporary materialism.},
  abstract_source = {openalex},
}

@article{soboleva2021marxismspinozism,
  author = {Soboleva, Maja},
  title = {Marxism as Spinozism? One Episode in the History of Soviet Philosophy},
  journal = {Studies in East European Thought},
  year = {2021},
  volume = {74},
  number = {3},
  pages = {319--332},
  doi = {10.1007/s11212-021-09427-0},
  note = {
  CORE ARGUMENT: Reconstructs Aleksandr Bogdanov's critique of Plekhanov's attempt to align Spinoza's philosophy directly with Marxism. Identifies two objections: a hermeneutical/methodological one (that Plekhanov dogmatizes and instrumentalizes historical concepts by ignoring their original context) and a systematic one (concerning the proper relation between extension and thought), out of which Bogdanov developed his rival theory of cognition, "empiriomonism."

  RELEVANCE: Documents the earliest and most sustained internal Marxist challenge to Plekhanov's monism, clarifying precisely what in his account of the matter/thought relation was contested and by whom, which is essential background for evaluating the philosophical coherence of Plekhanov's monism.

  POSITION: Represents the Bogdanovite critique of Plekhanov's Spinozist monism from within Russian Marxism.
  },
  keywords = {monism, spinoza, bogdanov, High},
  abstract = {This paper seeks to reconstruct philosopher Aleksandr Bogdanov’s approach to the philosophy of Spinoza in the context of the debate against Plekhanov. I demonstrate that the Soviet interest in Spinoza’s theory has never been purely historical, but rather, it served an important function in developing the theoretical foundations for Marxist philosophy. However, Bogdanov was one of only a very few who objected strongly to Plekhanov’s attempt to relate Spinoza’s philosophy to Marxism in a direct way. Two principles underlie Bogdanov’s critique: one being methodological, the other—systematic. The methodological principle has a hermeneutical character, since it demands that we treat historical concepts by taking into account their context and their changes during the time. According to Bogdanov, failing to fulfil this principle results in the dogmatization and instrumentalization of philosophy, and transforms it into political doctrine. The systematic principle concerns Bogdanov’s radical rethinking of the relationship between extension and thought. I argue that by rethinking Spinoza’s concepts in the framework of “ideo-empirical parallelism”, Bogdanov develops his own theory of cognition, which he called “empiriomonism”. When considered in historical context, I argue that these debates can serve as a window into the foundational role the Spinoza’s philosophy has played in the formation of different versions of Russian Marxism, as well as in the development of Russian Marxism in general.},
  abstract_source = {s2},
}

@article{rumyantseva2025plekhanovkant,
  author = {Rumyantseva, Tatyana Gerardovna},
  title = {Plekhanov as ``Defender'' of Kant from Neo-Kantians},
  journal = {Kantian Journal},
  year = {2025},
  volume = {44},
  number = {1},
  pages = {89--106},
  doi = {10.5922/0207-6918-2025-1-4},
  note = {
  CORE ARGUMENT: Analyzes Plekhanov's polemics against German Neo-Kantianism and Eduard Bernstein, arguing that Plekhanov rated Kant's own philosophy highly (finding in it points of coincidence with materialism) while, following Engels, calling Neo-Kantianism "a step backwards" from Kant. Argues Plekhanov's "defence" of Kant was chiefly instrumental — aimed at defending Marx and Engels against revisionism — and that Plekhanov himself misinterpreted aspects of Kant's doctrine, notably the "thing-in-itself."

  RELEVANCE: Directly assesses the philosophical defensibility of Plekhanov's engagement with Kantian epistemology, bearing on the key question of how faithful and rigorous his epistemological polemics actually were, including the disputed thing-in-itself concept central to his materialist theory of knowledge.

  POSITION: Critical historical assessment of Plekhanov's anti-Neo-Kantian polemics and his appropriation (and, per the author, partial misreading) of Kant's thing-in-itself.
  },
  keywords = {epistemology, kant, thing-in-itself, High},
  abstract = {The history of the reception and interpretation of Neo-Kantian ideas in the late nineteenth and early twentieth centuries shows the special role played by those who took a negative stand with regard to Neo-Kantianism and sought to dissociate it from and oppose it to Kant’s legacy. A prominent place among the latter was occupied by Georgy V. Plekhanov, most of whose works were fiercely polemical. Highly rating Kant’s works, in which he even found some coincidences with materialism, Plekhanov for a number of years engaged in polemics on philosophical and political issues with the German Neo-Kantians and Eduard Bernstein, who shared many of their views. Calling Neo-Kantianism, after Friedrich Engels, “a step backwards” from Kant’s philosophy, he argued that Neo-Kantians had misunderstood Kant’s philosophy and, in advocating a return to Kant’s theoretical philosophy in order to use it to refute contemporary materialism, had distorted Kant’s doctrine. Plekhanov’s so-called “defence” of Kant against Neo-Kantians should not be understood and accepted literally. Being a Marxist, Plekhanov tried to defend above all the views of Marx and Engels by revealing the flaws in the Neo-Kantian interpretation of Kant. Although he himself in some ways misinterpreted Kant, his views command some interest today because many of them played a certain role in the perception of Kant in the Soviet and post-Soviet times and were reflected in the discussions of the Kantian philosophy as a whole, especially its fundamental concept of the “thing-in-itself”.},
  abstract_source = {s2},
}

@article{seriot2022hieroglyphics,
  author = {Sériot, Patrick},
  title = {Is Language a System of Signs? Lenin, Saussure and the Theory of Hieroglyphics},
  journal = {Sign Systems Studies},
  year = {2022},
  volume = {50},
  number = {1},
  pages = {143--162},
  doi = {10.12697/sss.2022.50.1.08},
  note = {
  CORE ARGUMENT: Traces the Soviet-era (1930s-1950s) controversy over whether Saussure's "Cours" presents a "theory of hieroglyphics" — a charge of "bourgeois idealism" rooted in the Marxist-Leninist debate over the sign/referent relation that Lenin had waged in 1909 against Ernst Mach, and situates this within a much older (seventeenth-century) controversy over the transparency or opacity of the sign.

  RELEVANCE: Provides intellectual-historical context for why the "hieroglyph" theory of knowledge — originating in Helmholtz's sign theory of sensation and adopted in modified form by Plekhanov — became a lasting flashpoint in Marxist epistemology, tracing the term's afterlife into Soviet semiotics and Lenin's polemic against it. The paper's focus is chiefly on the later (Lenin/Saussure) reception rather than Plekhanov's original formulation.

  POSITION: Intellectual history of the Soviet Marxist critique of "hieroglyph" theories of the sign, illuminating the longer trajectory of the controversy Plekhanov's epistemology provoked.
  },
  keywords = {hieroglyph-theory, epistemology, reflection-theory, Medium},
  abstract = {This paper strives to pursue two goals at the same time: how can one get to know in depth the intellectual life of the USSR in the 1930s–1950s; and, what can the virulent anti-Saussurean criticism in Russia at that time tell us about the specificity of the Marxist-Leninist theory of signs? We propose the following angle of attack: the recurring theme of this criticism, namely that Saussure’s Cours presents a “theory of hieroglyphics”, therefore a type of “bourgeois idealist” theory that Lenin assailed in his 1909 book Materialism and Empiriocriticism about Ernst Mach. Yet thinking about hieroglyphics is based on much older controversies, dating back to the 17th century and concerning the deciphering of Egyptian writing. The issue which arises here is semiotic in nature: it is the scalar opposition between transparency and opacity of the sign that is at stake. Does the sign hide or reveal? The Soviet discourse on language and signs in the 1930s–1950s seems to be based on an interrogation of the sign/referent, language/ thought, form/content relationship. A part of the history of semiotics can thus be discovered from the critique of the “hieroglyphic theory”, a little-known episode in a debate on the interpretation of Saussurism.},
  abstract_source = {s2},
}

@article{vanree2013communistmanifesto,
  author = {van Ree, Erik},
  title = {Georgii Plekhanov and the Communist Manifesto: The Proletarian Revolution Revisited},
  journal = {Revolutionary Russia},
  year = {2013},
  volume = {26},
  number = {1},
  pages = {32--51},
  doi = {10.1080/09546545.2013.787807},
  note = {
  CORE ARGUMENT: Argues that Plekhanov's proposed revolutionary strategy shifted substantively between "Socialism and the Political Struggle" (1883) and "Our Differences" (1885): although he claimed to model his Russian strategy on the Communist Manifesto's scenario, Plekhanov was in fact the first Marxist to reject Marx's original scenario of revolution by numerically small proletariats, instead predicating proletarian revolution on the prior proletarianization and industrialization of the majority of the population.

  RELEVANCE: Directly bears on the key question of how faithful Plekhanov's reading of Marx and Engels actually was, identifying a specific, textually documented point of substantive departure from the Manifesto even as Plekhanov presented himself as simply applying it to Russian conditions.

  POSITION: Textual-historical argument for a substantive revision, by Plekhanov, of Marx's revolutionary scenario, despite his self-presentation as its orthodox interpreter.
  },
  keywords = {marx-engels-reading, historical-materialism, High},
  abstract = {This article discusses the question of Georgii Plekhanov's contributions to Marxist revolutionary strategy. It argues that the strategy Plekhanov proposed in Our Differences (1885) was very different from the one he had earlier proposed in Socialism and Political Struggle (1883). Plekhanov pretended to model his Russian policies on the Communist Manifesto's policies for Germany in the mid-nineteenth century. However, in proposing that Russia's democratic revolution was to be followed by a protracted period of capitalist economic development, Plekhanov was in fact taking Marxism in a new direction. Plekhanov was the first Marxist to have rejected Marx's scenario of social revolution by numerically small proletariats and to have predicated the proletarian revolution on the proletarianisation of the majority of the population and integral industrialisation.},
  abstract_source = {openalex},
}

@book{white1996karlmarx,
  author = {White, James D.},
  title = {Karl Marx and the Intellectual Origins of Dialectical Materialism},
  year = {1996},
  publisher = {Palgrave Macmillan UK},
  address = {New York},
  doi = {10.1057/9780230374218},
  note = {
  CORE ARGUMENT: Provides a genealogy of "dialectical materialism," tracing the development of Marxist ideas from their origins in German philosophical thought (Hegel and the Left Hegelians) through Marx's own writings to the ideology of the Russian Social-Democratic groups of the 1890s, from which Plekhanov's formulation, and subsequently Lenin's, emerged.

  RELEVANCE: Essential for assessing how faithful Plekhanov's Hegel/Marx reading was to Marx's actual texts and intellectual development, since it reconstructs the path "backward" from Plekhanov's dialectical materialism to Marx's and the German Idealists' own positions, testing claims of continuity or discontinuity.

  POSITION: Intellectual-historical account questioning any unbroken continuity between Marx's own thought and the "dialectical materialism" that Plekhanov named and systematized.
  },
  keywords = {hegel, marx-engels-reading, dialectical-materialism, High},
  abstract = {The book provides a genealogy of 'dialectical materialism' by tracing the development of Marxist ideas from their origins in German philosophical thought to the ideology of the social-democratic group},
  abstract_source = {openalex},
}

@article{moore1971origindialectical,
  author = {Moore, Stanley},
  title = {Marx and the Origin of Dialectical Materialism},
  journal = {Inquiry},
  year = {1971},
  volume = {14},
  number = {1-4},
  pages = {420--429},
  doi = {10.1080/00201747108601641},
  note = {
  CORE ARGUMENT: Locates the origin of "dialectical materialism" in Marx's own 1857 return to studying Hegel, arguing Marx thereafter combined a realist epistemology (opposed to Hegel) with a Hegel-influenced dialectical method for deriving the labor theory of value, producing an internal tension between his materialism and his dialectic that Marx himself never fully resolved.

  RELEVANCE: Provides an independent philosophical account of the origin and internal coherence of "dialectical materialism" in Marx's own texts, prior to and apart from Plekhanov's naming and systematization of the term — a benchmark against which to measure whether Plekhanov's version preserves, resolves, or obscures the tension Moore identifies.

  POSITION: Argues for a substantive, unresolved tension between materialism and dialectic already present in Marx himself, independent of later Plekhanovite or Soviet systematization.
  },
  keywords = {hegel, dialectical-materialism, marx-engels-reading, Medium},
  abstract = {Dialectical materialism was born in 1857, when Marx returned to studying Hegel. In opposition to Hegel, Marx adopted a realist epistemology. Abandoning the pragmatist ambiguities of his Economic‐Philosophical Manuscripts, he became a materialist in the traditional sense of that word. Influenced by Hegel, Marx simultaneously attempted a dialectical proof for the labor theory of value. Abandoning his positivist critique in The Holy Family, he started using dialectic to discover beneath appearances an otherwise inaccessible reality. But his dialectic was incompatible with his materialism. The identification of reality with Praxis, rejected at the level of philosophical statement, was retained at the level of economic argument. Turning Hegel upside down proved harder than Marx thought.},
  abstract_source = {openalex},
}

@book{jordan1967evolutiondialectical,
  author = {Jordan, Zbigniew Antoni},
