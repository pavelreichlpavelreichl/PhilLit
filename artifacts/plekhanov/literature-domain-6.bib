@incollection{carr2021fatherrussianmarxism,
  author = {Carr, Edward Hallett},
  title = {Plekhanov: Father of Russian Marxism},
  booktitle = {Studies in Revolution},
  year = {2021},
  pages = {105--119},
  publisher = {Routledge},
  doi = {10.4324/9781003251934-7},
  note = {
  CORE ARGUMENT: Carr's essay -- originally contributed to The Times Literary
  Supplement and collected in his 1950 volume "Studies in Revolution," here reissued
  by Routledge -- assesses Plekhanov's founding role in Russian Marxism against the
  standard of Lenin's later theoretical and practical achievement, endorsing (per
  Isaiah Berlin's contemporaneous review, cataloged separately in this domain) the
  Communist historian A. Rothstein's harsh verdict that Plekhanov's "unforgivable
  sin" was his refusal to follow his former pupil Lenin into the October Revolution.

  RELEVANCE: A foundational mid-century assessment that explicitly ranks Plekhanov
  against Lenin and finds him wanting for failing to make the leap Lenin made in
  1917; its interpretive stance -- treating history-making decisiveness as the
  standard by which theorists should be judged -- is itself criticized by Berlin as a
  symptom of Carr's broader sympathy for the "Welthistorisch individuals who make
  history" over more scrupulous but less ruthless figures like Plekhanov.

  POSITION: Cold War-era assessment privileging Lenin's revolutionary decisiveness
  over Plekhanov's theoretical consistency, read by Berlin as excessively favorable
  to Lenin at Plekhanov's expense.
  },
  keywords = {lenin-comparison, father-of-russian-marxism, cold-war-historiography, High, INCOMPLETE, no-abstract}
}

