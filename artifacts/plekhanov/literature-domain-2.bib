@article{steila2021spinoza,
  author = {Steila, Daniela},
  title = {Interpretations of Spinoza in Early Russian Marxism},
  journal = {Studies in East European Thought},
  year = {2021},
  volume = {74},
  number = {3},
  pages = {279--296},
  doi = {10.1007/s11212-021-09410-9},
  note = {
  CORE ARGUMENT: Reconstructs Plekhanov's understanding of Spinoza's ontology and epistemology, from his critique of German revisionism in the late 1890s to his later polemics against empiriocriticism, arguing that Plekhanov treated Spinoza's substance monism as a theologically-clothed anticipation of dialectical materialism while dismissing Spinoza's "theological" language as a historical relic. Contrasts this with Lunacharskii's rival reading, which took Spinoza's religious language as a genuine forerunner of Marxist feeling.

  RELEVANCE: Directly addresses how Plekhanov constructs his monism through a materialist reading of Spinoza and clarifies the philosophical stakes of the monism debates within Russian Marxism, showing this was contested territory even among self-identified materialists.

  POSITION: Historical-philosophical reconstruction of Plekhanov's Spinozist monism against rival (Machist, Lunacharskian) interpretations.
  },
  keywords = {monism, spinoza, epistemology, High},
  abstract = {The roots of the controversial readings of Spinoza during Soviet times date back to the history of Russian Marxism. Spinoza was a most influential figure whom different Marxist currents and thinkers wanted to have on their side. This article examines the most relevant interpretations. First, it sketches some fundamental traits of Plekhanov’s understanding of Spinoza’s ontology and epistemology, from his critique of German revisionism at the end of the 1890s to his polemics against empiriocriticism and its Russian impact. Spinoza was a particularly relevant and authoritative thinker for the so-called “Machists” as well, and some of their different interpretations are analyzed as representing their critical approach to Marxism. Finally, Lunacharskiiʼs discussion is considered as a peculiar alternative to Plekhanov’s orthodox understanding not only of Spinoza but of Marxism itself. While Plekhanov judged Spinoza’s “theological” language a relic of his epoch, Lunacharskii maintained that it was precisely his “religious” feelings that made Spinoza a forerunner of Marxism.},
  abstract_source = {s2},
}

@incollection{steinberg2024russianmarxism,
  author = {Steinberg, Justin},
  title = {Russian Marxism and the Materialist Interpretation of Spinoza},
  booktitle = {The History and Philosophy of Materialism},
  year = {2024},
  pages = {351--363},
  publisher = {Routledge},
  address = {New York},
  doi = {10.4324/9781003118879-30},
  note = {
  CORE ARGUMENT: Compares the rival materialist readings of Spinoza advanced by Plekhanov, Abram Deborin, and Lyubov Akselrod, arguing that Deborin's identification of Spinozist Nature with matter fails as an interpretation, Akselrod's asymmetric-dependence account fails both as Spinoza interpretation and as materialism, and Plekhanov's reading — which treats materialism as compatible with panpsychism — is the most defensible of the three, though Spinoza's own metaphysics is not best described as materialism at all.

  RELEVANCE: Provides a philosophically rigorous, non-partisan evaluation of the coherence of Plekhanov's monistic materialism as an interpretation of Spinoza, directly bearing on how philosophically defensible his core ontological framework is.

  POSITION: Analytic assessment favoring Plekhanov's Spinoza reading over Deborin's and Akselrod's among Russian Marxist interpreters.
  },
  keywords = {monism, spinoza, epistemology, High},
  abstract = {Spinoza was not a materialist, at least not as typically understood today. He was a substance monist and a pluralist about what kinds of things exist. Nevertheless, Spinoza has often been read as a materialist, and one prominent strand of this materialist reading may be traced back to the Russian Marxist Georgi Plekhanov, who, beginning in the 1890s, engaged in a series of polemics in which he defended a comprehensive materialist reading of Spinoza – one that would cover both ontological and dialectical materialism, or “old” and “new” materialism – that would cement Spinoza’s status as the great progenitor of political radicalism. In the controversies that would follow, Plekhanov’s followers Abram Deborin and Lyubov Akselrod, offered their own materialist readings of Spinoza. In this chapter, I analyze the distinct materialist readings of Spinoza advanced by Deborin, Akselrod, and Plekhanov. I argue that Deborin’s approach, according to which Spinoza identifies Nature with matter, fails as an interpretation, that Akselrod’s alternative, according to which ideas are in some sense asymmetrically dependent on bodies, fails either as an interpretation of Spinoza or as an account of materialism, leaving Plekhanov’s interpretation of Spinoza, which takes materialism to be compatible with panpsychism, as the most plausible of the bunch. While Spinoza’s metaphysics is probably not best described as materialism, it is, in crucial respects, closer than many early modern versions of materialism are to contemporary materialism.},
  abstract_source = {openalex},
}

@article{soboleva2021marxismspinozism,
  author = {Soboleva, Maja},
  title = {Marxism as Spinozism? One Episode in the History of Soviet Philosophy},
  journal = {Studies in East European Thought},
  year = {2021},
  volume = {74},
  number = {3},
  pages = {319--332},
  doi = {10.1007/s11212-021-09427-0},
  note = {
  CORE ARGUMENT: Reconstructs Aleksandr Bogdanov's critique of Plekhanov's attempt to align Spinoza's philosophy directly with Marxism. Identifies two objections: a hermeneutical/methodological one (that Plekhanov dogmatizes and instrumentalizes historical concepts by ignoring their original context) and a systematic one (concerning the proper relation between extension and thought), out of which Bogdanov developed his rival theory of cognition, "empiriomonism."

  RELEVANCE: Documents the earliest and most sustained internal Marxist challenge to Plekhanov's monism, clarifying precisely what in his account of the matter/thought relation was contested and by whom, which is essential background for evaluating the philosophical coherence of Plekhanov's monism.

  POSITION: Represents the Bogdanovite critique of Plekhanov's Spinozist monism from within Russian Marxism.
  },
  keywords = {monism, spinoza, bogdanov, High},
  abstract = {This paper seeks to reconstruct philosopher Aleksandr Bogdanov’s approach to the philosophy of Spinoza in the context of the debate against Plekhanov. I demonstrate that the Soviet interest in Spinoza’s theory has never been purely historical, but rather, it served an important function in developing the theoretical foundations for Marxist philosophy. However, Bogdanov was one of only a very few who objected strongly to Plekhanov’s attempt to relate Spinoza’s philosophy to Marxism in a direct way. Two principles underlie Bogdanov’s critique: one being methodological, the other—systematic. The methodological principle has a hermeneutical character, since it demands that we treat historical concepts by taking into account their context and their changes during the time. According to Bogdanov, failing to fulfil this principle results in the dogmatization and instrumentalization of philosophy, and transforms it into political doctrine. The systematic principle concerns Bogdanov’s radical rethinking of the relationship between extension and thought. I argue that by rethinking Spinoza’s concepts in the framework of “ideo-empirical parallelism”, Bogdanov develops his own theory of cognition, which he called “empiriomonism”. When considered in historical context, I argue that these debates can serve as a window into the foundational role the Spinoza’s philosophy has played in the formation of different versions of Russian Marxism, as well as in the development of Russian Marxism in general.},
  abstract_source = {s2},
}

