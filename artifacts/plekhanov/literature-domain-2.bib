  number = {1},
  pages = {114},
  doi = {10.2307/130879},
  note = {
  CORE ARGUMENT: A review of Daniela Steila's monograph reconstructing the genesis of Plekhanov's theory of knowledge, situating his epistemology between nineteenth-century anthropological materialism (Feuerbach) and contemporary physiology/psychophysiology (Helmholtz), and tracing the sources of Plekhanov's "hieroglyph" (sign) theory of sensation. [Reviewed work: Daniela Steila's monograph of the same title; abstract of the review itself unavailable from any indexed source.]

  RELEVANCE: The only accessible route, via this search, to Steila's monograph-length treatment of the genesis of Plekhanov's "hieroglyph" theory of knowledge — the Helmholtzian view that sensations are conventional signs rather than direct copies of external objects — which Engels privately objected to and which later became a central target of Bogdanov's and Lenin's epistemological polemics. Essential for the domain's core question on the hieroglyph theory.

  POSITION: Reports and summarizes Steila's intellectual-historical study of the physiological and philosophical sources of Plekhanov's hieroglyph epistemology.
  },
  keywords = {hieroglyph-theory, epistemology, book-review, High, INCOMPLETE, no-abstract}
}

