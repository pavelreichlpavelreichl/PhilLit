@article{yassour1983empiriomonist,
  author = {Yassour, Avraham},
  title = {The Empiriomonist Critique of Dialectical Materialism: Bogdanov, Plekhanov, Lenin},
  journal = {Studies in Soviet Thought},
  year = {1983},
  volume = {26},
  number = {1},
  pages = {21--38},
  doi = {10.1007/bf00832209},
  note = {
  CORE ARGUMENT: Reconstructs the philosophical dispute between Alexander Bogdanov's "empiriomonism" (which sought to dissolve the subject/object and mind/matter distinctions into a monistic theory of organized experience) and Plekhanov's defense of an orthodox materialist ontology that retains a mind-independent material reality as the ultimate ground of historical and natural processes, with Lenin's later intervention (in "Materialism and Empiriocriticism") siding with Plekhanov against Bogdanov.

  RELEVANCE: Clarifies the metaphysical commitments underlying Plekhanov's monist materialism -- the ontological "base" that anchors his five-fold formula -- by showing what he was defending it against from within Russian Marxism itself, rather than only against external idealist or Narodnik opponents.

  POSITION: Reconstructs an intra-Marxist metaphysical controversy, situating Plekhanov as defender of realist/materialist orthodoxy against Bogdanov's monist-idealist-leaning empiriocriticism.
  },
  keywords = {materialism, Bogdanov-debate, ontology, Medium, INCOMPLETE, no-abstract}
}

@article{vanree2013plekhanov,
  author = {van Ree, Erik},
  title = {Georgii Plekhanov and the Communist Manifesto: The Proletarian Revolution Revisited},
  journal = {Revolutionary Russia},
  year = {2013},
  volume = {26},
  number = {1},
  pages = {32--51},
  doi = {10.1080/09546545.2013.787807},
  note = {
  CORE ARGUMENT: Van Ree argues that Plekhanov's revolutionary strategy shifted significantly between "Socialism and Political Struggle" (1883) and "Our Differences" (1885): rather than modeling Russian strategy directly on the Communist Manifesto's account of a small industrial proletariat leading a bourgeois revolution, Plekhanov innovated by predicating the future socialist revolution on the prior proletarianization of the majority of the Russian population and full industrialization -- a novel, more strictly stagist reading of Marxist theory of history applied to a "backward" country.

  RELEVANCE: Shows how Plekhanov's abstract philosophy of history (the necessity of passing through determinate economic stages) was operationalized into a specific, contestable prediction about Russian development, sharpening the question of how deterministic his theory of history actually was in practice.

  POSITION: Historical revision of Plekhanov's strategic thought, emphasizing his departure from, rather than simple application of, Marx's own scenario.
  },
  keywords = {stagism, historical-materialism, Russian-development, Medium},
  abstract = {This article discusses the question of Georgii Plekhanov's contributions to Marxist revolutionary strategy. It argues that the strategy Plekhanov proposed in Our Differences (1885) was very different from the one he had earlier proposed in Socialism and Political Struggle (1883). Plekhanov pretended to model his Russian policies on the Communist Manifesto's policies for Germany in the mid-nineteenth century. However, in proposing that Russia's democratic revolution was to be followed by a protracted period of capitalist economic development, Plekhanov was in fact taking Marxism in a new direction. Plekhanov was the first Marxist to have rejected Marx's scenario of social revolution by numerically small proletariats and to have predicated the proletarian revolution on the proletarianisation of the majority of the population and integral industrialisation.},
  abstract_source = {openalex},
}

@incollection{white2018plekhanov,
  author = {White, James D.},
  title = {Plekhanov, Georgii Valentinovich (1857--1918)},
  booktitle = {Routledge Encyclopedia of Philosophy},
  year = {2018},
  publisher = {Routledge},
  doi = {10.4324/9780415249126-e031-1},
  note = {
  CORE ARGUMENT: A concise overview identifying Plekhanov as the chief popularizer and philosophical interpreter of Marxism in 1880s Russia, crediting him with coining the term "dialectical materialism" and with drawing systematic attention to the Hegelian origins of Marx's system; emphasizes that Plekhanov's polemical context (disputes among Russian revolutionary factions) shaped an interpretation of Marxism that stressed the deterministic, "scientific" side of Marx's writings, which subsequently became, via Lenin, the basis of official Soviet Marxist-Leninist orthodoxy.

  RELEVANCE: Provides a compact, authoritative overview of Plekhanov's philosophical significance and the trajectory from his own writings to their canonization as Soviet dogma, useful for framing why his "five-fold formula" became the textbook schema of Soviet historical materialism.

  POSITION: Reference-work synthesis, largely concurring with Baron and Walicki that Plekhanov's determinism was politically motivated and later ossified into official doctrine.
  },
  keywords = {overview, dialectical-materialism, reception, High},
  abstract = {Known as ’the Father of Russian Marxism’, Plekhanov was the chief popularizer and interpreter of Marxism in Russia in the 1880s. His interest in the philosophical aspects of Marxism made him influential outside as well as inside Russia. He was a prolific writer, and dealt with several aspects of Marxist thought. Plekhanov was an important figure in the Russian revolutionary movement. He was a founder member of the Russian Social Democratic Party, and a leading figure in its Menshevik wing after it split into Bolsheviks and Mensheviks in 1903. As a politician, Plekhanov was constantly involved in polemics with political and ideological opponents. Most of his theoretical works are to some degree polemical, and it was the conflicts among Russian revolutionary groups that shaped Plekhanov’s interpretation of Marx’s thought. A basic feature of this interpretation was that Russia’s historical development was like that of Western European countries, and would pass through a capitalist phase before progressing to socialism. Accordingly, Plekhanov gave prominence to those of Marx’s writings which could be presented in a deterministic way. Plekhanov insisted that Marxism was a materialist doctrine (as opposed to an idealist one) and as such recognized the primacy of matter in all spheres of existence. Plekhanov was in many ways an innovator, being the writer who first coined the term ’dialectical materialism’, and who drew attention to the Hegelian origins of Marx’s system. His writings were quickly translated into several European languages. His interpretation of Marxism was much admired by Lenin, and was to form the basis of the official ideology of the Soviet Union. The conception of Marxism that Plekhanov propounded continues to exercise a profound influence on conceptions of Marxism throughout the world.},
  abstract_source = {openalex},
}

@article{pavlov2017caesar,
  author = {Pavlov, Evgeni V.},
  title = {"When Was Caesar Born?" Theory and Practice of Truth in Plekhanov and Bogdanov},
  journal = {Stasis},
  year = {2017},
  volume = {5},
  number = {2},
  pages = {50--79},
  doi = {10.33280/2310-3817-2017-5-2-50-79},
  note = {
  CORE ARGUMENT: Examines the theoretical dispute between Plekhanov and the Bogdanov circle over the nature of (absolute) truth within Russian Social-Democratic Marxism, arguing that this seemingly abstract epistemological debate was directly tied to competing understandings of the objectivity that historical-materialist claims about social development could claim, and thus to rival strategic and programmatic conclusions for the party.

  RELEVANCE: Sheds light on the epistemological status Plekhanov claimed for historical-materialist laws (as objectively, not just pragmatically, true), a presupposition underlying his confidence in the determinist five-fold schema and his dismissal of subjectivist alternatives.

  POSITION: Reconstructs Plekhanov's realist theory of truth against Bogdanov's pragmatist/constructivist alternative within early Russian Marxism.
  },
  keywords = {epistemology, truth, Bogdanov-debate, Medium},
  abstract = {Although political differences between various factions of the Russian Social­Democratic Labor Party (RSDLP) have been studied quite extensively, theoretical debates about the nature of Marxism and the role such debates had in determining Party programs and strategic decisions remains in need of a more thorough engagement. One such theoretical discussion, the question of the nature of (absolute) truth, is the subject matter of the present essay. The primary debate was between Georgi Plekhanov, one of the most respected representatives of early Russian Marxism, and a group of theoreticians united around Alexander Bogdanov, an early collaborator of Lenin (until their break in 1909) and an author of several original theoretical works that attempted to challenge the established orthodoxy of Plekhanovite Marxism. The question of the nature of truth stood at the center of the debates between Plekhanov and Bogdanov. The ultimate challenge that Bogdanov threw to the representatives of (self­proclaimed) “orthodox Marxism” was the question of the ultimate nature of Marxist theory: Is Marxism a science or a faith? If it is a science, it must operate within a scientific theory of truth and, as is the case with any genuine science, continue to grow and adapt to the changing circumstances of research. If it is indeed a faith, a set of absolute truths revealed to one person (Marx) and passed on to his disciples in sacred texts and by appointed prophets, then it contains as much value as any other faith or superstition.},
  abstract_source = {s2},
}

@article{brazevich2021genesis,
  author = {Brazevich, Svyatoslav S.},
  title = {The Genesis of Western European Sociological Thought in the Works of G. V. Plekhanov},
  journal = {Vestnik of Saint Petersburg University. Sociology},
  year = {2021},
  volume = {14},
  number = {2},
  pages = {171--184},
  doi = {10.21638/spbu12.2021.205},
  note = {
  CORE ARGUMENT: Analyzes Plekhanov's own historical-sociological account of the genesis of Western European social theory, tracing how he read the eighteenth-century French materialists, the French Restoration historians' concept of class struggle, Hegel's dialectical treatment of social change, and utopian socialism as successive approximations to a genuinely scientific sociology, culminating (in his view) in Marxist historical materialism.

  RELEVANCE: Reconstructs the intellectual-historical scaffolding behind Plekhanov's five-fold formula, showing which precursor theories he drew on for each level of the schema (e.g., class struggle from the Restoration historians, dialectical development from Hegel, the concept of "social environment" as proto-economic relations).

  POSITION: Intellectual-historical reconstruction of Plekhanov's sources rather than a critical assessment of his theory's validity.
  },
  keywords = {five-fold-formula, intellectual-history, sociology, Medium},
  abstract = {The article presents the results of the analysis by G.V.Plekhanov of the genesis of Western European sociological thought based on the consideration of the social ideas of the French materialists of the 18th century, the rudiments in their philosophical systems of the historical approach to the study of society and understanding the causes of social inequality and injustice as well as overcoming them. The sources and content of the philosophical and historical theories of the French historians of the Restoration period are revealed, those who recognized the struggle of classes as the cornerstone of the social, political and mental development of European society, including the interpretation of the concept of “social environment” as a set of economic relations of classes, which was a contribution to the history of sociology. The analysis of the sociological views of utopian socialists and representatives of German classical philosophy is conducted. It was revealed that a significant contribution to the development of the theory of society were the ideas of social progress and the creation of a new social science that served the cause of social organization, developed by the utopian socialists, as well as the statement that the future of society is decided in the sphere of social and economic relations, and not political and legal ones. It is emphasized that Hegel’s application of dialectics to the analysis of social changes meant undoubted progress in the development of sociological thought, which consisted in the advancement of the idea of the regularity of the social process. The methodological basis of the author’s study of the problem of the genesis of Western European sociological thought in the works of G.V.Plekhanov is made up of dialectical-materialistic and comparative-historical methods, as well as the method of textological analysis and historical-philosophical reconstruction.},
  abstract_source = {s2},
}

@article{steila2021interpretations,
  author = {Steila, Daniela},
  title = {Interpretations of Spinoza in Early Russian Marxism},
  journal = {Studies in East European Thought},
  year = {2021},
  volume = {74},
  number = {3},
  pages = {279--296},
  doi = {10.1007/s11212-021-09410-9},
  note = {
  CORE ARGUMENT: Traces the readings of Spinoza's ontology and epistemology within early Russian Marxism, beginning with Plekhanov's claim (reported from conversation with Engels) that "Marxism is a variety of Spinozism," and showing how Plekhanov used a Spinozist monism -- substance as the unity of extension and thought -- to underwrite his non-reductive materialism against both idealist critics and, later, the "Machist" empiriocriticists around Bogdanov.

  RELEVANCE: Identifies the specific metaphysical resource (Spinozist substance-monism) Plekhanov used to make his "monist view of history" more than a slogan, explaining the philosophical content behind describing his historical materialism as "monist" rather than merely "materialist."

  POSITION: History-of-philosophy reconstruction of Plekhanov's Spinozism as the metaphysical backbone of his monist historical materialism.
  },
  keywords = {monism, Spinoza, ontology, Medium},
  abstract = {The roots of the controversial readings of Spinoza during Soviet times date back to the history of Russian Marxism. Spinoza was a most influential figure whom different Marxist currents and thinkers wanted to have on their side. This article examines the most relevant interpretations. First, it sketches some fundamental traits of Plekhanov’s understanding of Spinoza’s ontology and epistemology, from his critique of German revisionism at the end of the 1890s to his polemics against empiriocriticism and its Russian impact. Spinoza was a particularly relevant and authoritative thinker for the so-called “Machists” as well, and some of their different interpretations are analyzed as representing their critical approach to Marxism. Finally, Lunacharskiiʼs discussion is considered as a peculiar alternative to Plekhanov’s orthodox understanding not only of Spinoza but of Marxism itself. While Plekhanov judged Spinoza’s “theological” language a relic of his epoch, Lunacharskii maintained that it was precisely his “religious” feelings that made Spinoza a forerunner of Marxism.},
  abstract_source = {s2},
}

@article{soboleva2021marxism,
  author = {Soboleva, Maja},
  title = {Marxism as Spinozism? One Episode in the History of Soviet Philosophy},
  journal = {Studies in East European Thought},
  year = {2021},
  volume = {74},
  number = {3},
  pages = {319--332},
  doi = {10.1007/s11212-021-09427-0},
  note = {
  CORE ARGUMENT: Examines the reception and eventual institutionalization of Plekhanov's Spinozist reading of Marxism among his followers (notably Lyubov Axelrod and Abram Deborin) within Soviet philosophy, showing how a formula meant to secure a non-mechanistic, "dialectical" materialism was later contested and partly displaced within Soviet philosophical orthodoxy.

  RELEVANCE: Extends Steila's account of Plekhanov's Spinozism into its institutional afterlife in the USSR, helping to distinguish what in the "five-fold formula" and monist materialism originated with Plekhanov himself from later Soviet doctrinal accretions.

  POSITION: History of philosophy tracing the rise and partial eclipse of Plekhanov's Spinozist Marxism as Soviet orthodoxy.
  },
  keywords = {monism, Spinoza, Soviet-reception, Medium},
  abstract = {This paper seeks to reconstruct philosopher Aleksandr Bogdanov’s approach to the philosophy of Spinoza in the context of the debate against Plekhanov. I demonstrate that the Soviet interest in Spinoza’s theory has never been purely historical, but rather, it served an important function in developing the theoretical foundations for Marxist philosophy. However, Bogdanov was one of only a very few who objected strongly to Plekhanov’s attempt to relate Spinoza’s philosophy to Marxism in a direct way. Two principles underlie Bogdanov’s critique: one being methodological, the other—systematic. The methodological principle has a hermeneutical character, since it demands that we treat historical concepts by taking into account their context and their changes during the time. According to Bogdanov, failing to fulfil this principle results in the dogmatization and instrumentalization of philosophy, and transforms it into political doctrine. The systematic principle concerns Bogdanov’s radical rethinking of the relationship between extension and thought. I argue that by rethinking Spinoza’s concepts in the framework of “ideo-empirical parallelism”, Bogdanov develops his own theory of cognition, which he called “empiriomonism”. When considered in historical context, I argue that these debates can serve as a window into the foundational role the Spinoza’s philosophy has played in the formation of different versions of Russian Marxism, as well as in the development of Russian Marxism in general.},
  abstract_source = {s2},
}

@article{teslya2021mikhailovsky,
  author = {Teslya, Andrey},
  title = {The Foundations of N.K. Mikhailovsky's Theory: Formation of "Subjective Sociology," Late 1860s -- Mid-1870s},
  journal = {Philosophy. Journal of the Higher School of Economics},
  year = {2021},
  volume = {5},
  number = {2},
  pages = {55--78},
  doi = {10.17323/2587-8719-2021-2-55-78},
  note = {
  CORE ARGUMENT: Reconstructs the early formation of N. K. Mikhailovsky's "subjective sociology," showing it to be a considered response to Darwinism and to sociological organicism rather than the naive theory Plekhanov's polemics suggest: Mikhailovsky, unlike Lavrov, favored a non-teleological account of progress and understood history as "logical" but free of strict determinism, resisting the idea that individual and social development are bound by scientific laws in the way natural phenomena are.

  RELEVANCE: Supplies the reconstructed target of Plekhanov's critique of "subjectivist sociology," essential for evaluating whether his polemic accurately represents Mikhailovsky's actual position or attacks a simplified caricature, and for assessing what the disagreement reveals about Plekhanov's own determinism.

  POSITION: Intellectual-historical reconstruction of subjective sociology on its own terms, implicitly a corrective to reductive polemical characterizations (including Plekhanov's) of Mikhailovsky's theory.
  },
  keywords = {subjective-sociology, Mikhailovsky, Narodnik-critique, High},
  abstract = {Nikolai Konstantinovich Mikhaylovsky (1842–1904) is one of the most well-known and influential Russian publicists of the last third of the 19th and the beginning of 20th century, ideologist of the Narodniki movement, the author of the conception known as “subjective sociology” and the editor of journal Russian wealth at the end of his life. Yet, while his role in the history of Russian social movement or literary-aesthetic views have been quite fully studied, his social theory has rarely become the object of the special analysis during the last century. On the one hand, it was shadowed by the theories which appeared earlier and had more influence even abroad (outside the Russian empire) as, for example, the ideas of Herzen, Bakunin, Chernyshevsky, Lavrov. On the other hand, Mikhaylovsky, who was severely criticized by Russian social democrats in 1894–1901, was perceived as a rather weak theorist. In this article, we demonstrate the essential differences between the early conceptual advances of Mikhaylovsky and P.L. Lavrov and assert that the conception of the former was influenced both by the rethinking of the Darwinism from a viewpoint of understanding of nature and by the conclusions for social theory. Unlike Lavrov, Mikhaylovsky, as well as Herzen, was an advocate of non-teleological understanding of progress and favored the interpretation of history as logical yet free from strict determinism. In conclusion, Mikhaylovsky’s opinion about the society, which was formed at the end of 1860s – first quarter of 1870s, appears as a quite consistent and elaborated system, an answer to the theoretical challenges. Firstly, on the part of the Darwinism and the attempt to apply it to the analysis of the society. Secondly, on the part of the organicism. Lastly, we give an interpretation to the decline of the public interest to the social theory of Mikhaylovsky at the end of the 19th – beginning of 20th century.},
  abstract_source = {s2},
}

@book{walicki1979history,
  author = {Walicki, Andrzej},
  title = {A History of Russian Thought from the Enlightenment to Marxism},
  year = {1979},
  publisher = {Stanford University Press},
  address = {Stanford, CA},
  doi = {10.1515/9781503621244},
  note = {
  CORE ARGUMENT: Walicki's synthetic intellectual history situates Plekhanov at the hinge between Russian Populism and Marxism, with a dedicated discussion of "Plekhanov and the 'rational reality'" placed alongside chapters on Lavrov's and Mikhailovsky's Populist ideologies (the "subjective method," the theory of "critically thinking individuals") and on "legal Marxism." It shows Plekhanov constructing his monist historical materialism specifically as a rebuttal of the Populist claim that Russia's historical destiny remained open and could be shaped by the moral will of an enlightened minority.

  RELEVANCE: Because it treats Lavrov, Mikhailovsky, and Plekhanov within a single continuous narrative, this is the key resource for assessing the fourth key question -- the effectiveness of Plekhanov's critique of subjectivist/Narodnik sociology -- by showing precisely what continuities and discontinuities exist between the Populist "subjective method" and the Marxist determinism that supplanted it.

  POSITION: Standard synthetic historiography of Russian thought, treating Plekhanov's Marxism as both a continuation and a decisive rupture with Populist "ethical subjectivism."
  },
  keywords = {intellectual-history, Narodnik-critique, historical-context, High},
  abstract = {Part 1 Trends in Enlightenment thought: Catherine II and Enlightenment philosophy the emergence of Russian Enlightenment philosophy Nikolai Novikov and Freemasonry the aristocratic opposition. Part 2 The culmination of the Enlightenment in Russia - Aleksandr Radishchev: Radishchev's life Radishchev's social philosophy Radishchev's views on ethics and education radical reform or revolution? the treatise on immortality. Part 3 Gentry conservatives and gentry revolutionaries: Nikolai Karamzin the Decembrists. Part 4 Anti-Enlightenment trends in the early 19th century: mysticism the Wisdom-lovers and Russian Schellingianism. Part 5 Petr Chaadaev: Chaadaev's metaphysics and philosophy of history Russia's past and future Chaadaev's place in Russian intellectual history. Part 6 The Slavophiles: the Slavophiles' philosophy of history and social ideals the concept of the "integral personality" and "new principles in philosophy" Slavophile ecclesiology Slavophilism as conservative Utopianism the disintegration of Slavophilism. Part 7 The Russian Hegelians - from "reconciliation with reality" to "philosophy of action": Nikolai Stankevich Mikhail Bakunin Vissarion Belinsky Aleksandr Herzen. Part 8 Belinsky and different variants of westernism: Belinsky's westernism the liberal westernizers. Part 9 The Petrashevtsy: the social and political ideas of the Petrashevtsy the philosophical ideas of the Petrashevtsy. Part 10 The origins of "Russian socialism": the evolution of Herzen's views Nikolai Ogarev. Part 11 Nikolai Chernyshevsky and the "Enlighteners" of the sixties: Chernyshevsky's anthropological materialism Nikolai Dobroliubov and the dispute over the "superfluous men" Dmitry Pisarev and "nihilism" critics of the "Enlighteners" Apollon Grigoriev and Nikolai Strakhov. Part 12 Populist ideologies: from "go to the people" to the "people's will" Petr Lavrov Petr Tkachev Nikolai Mikhailovsky. Part 13 Anarchism: Mikhail Bakunin Petr Kropotkin. Part 14 Ideologies of reaction after the reforms: Nikolai Danilevsky Konstantin Pobedonostsev Konstantin Leontiev. Part 15 Two prophetic writers: Fyodor Dostoevsky Lev Tolstoy Dostoevsky and Tolstoy - a comparison. Part 16 Variants of positivism: dogmatic positivism Grigory Wyrouboff critical positivism - Vladimir Lesevich positivism and psychology positivism and sociology. Part 17 Vladimir Soloviev and metaphysical idealism: Soloviev's religious philosophy Aleksei Kozlov and pan-psychism Boris Chicherin and the Hegelians of the second half of the 19th century. Part 18 From populism to Marxism: between populism and Marxism Plekhanov and the "rational reality" Plekhanov's literary criticism and aesthetics legal populism legal Marxism Lenin's early writings. Index.},
  abstract_source = {s2},
}

@article{hu2026reconstruction,
  author = {Hu, Jingduo},
  title = {Plekhanov's Reconstruction of Marx's Social Organism: A New Approach to Contemporary Ecological Marxism},
  journal = {Studies in East European Thought},
  year = {2026},
  doi = {10.1007/s11212-026-09851-0},
  note = {
  CORE ARGUMENT: Reconstructs Plekhanov's concept of society as a "social organism" as a systematic extension of Marx's historical materialism, arguing that Plekhanov's organological framework -- which distinguishes "conditions" from "causes" and situates natural/ecological constraints within mediated processes of social reproduction -- avoids both crude environmental determinism and voluntarist social constructivism, and remains conceptually useful for contemporary ecological Marxist theories such as metabolic-rift theory.

  RELEVANCE: Bears directly on how the first term of Plekhanov's five-fold formula (productive forces) is itself embedded in, and mediated by, geographic/natural conditions, refining the standard picture of his theory of history as flatly economistic.

  POSITION: Sympathetic contemporary reconstruction reading Plekhanov as a theorist of ecological mediation rather than a proto-ecological thinker in the modern sense.
  },
  keywords = {five-fold-formula, social-organism, ecological-Marxism, Medium, INCOMPLETE, no-abstract}
}

@article{rumyantseva2025defender,
  author = {Rumyantseva, Tatyana Gerardovna},
  title = {Plekhanov as "Defender" of Kant from Neo-Kantians},
  journal = {Kantian Journal},
  year = {2025},
  volume = {44},
  number = {1},
  pages = {89--106},
  note = {
  CORE ARGUMENT: Argues that, despite his general polemic against Neo-Kantian revisions of Marxism (directed at Bernstein and others), Plekhanov selectively defended aspects of Kant's own epistemology against what he saw as distortions by Russian and German Neo-Kantians, using a qualified reading of Kant to reinforce his materialist theory of knowledge rather than simply rejecting Kantian philosophy outright.

  RELEVANCE: Complicates the picture of Plekhanov as a straightforward materialist opponent of all "idealist" epistemology, relevant to understanding the philosophical resources (alongside Spinoza) he drew on to defend the objectivity of historical-materialist knowledge against subjectivist and Neo-Kantian rivals alike.

  POSITION: Revisionist history-of-philosophy argument nuancing Plekhanov's relationship to Kantianism within his broader anti-subjectivist epistemology.
  },
  keywords = {epistemology, Kant, materialism, Medium, INCOMPLETE, no-abstract}
}
