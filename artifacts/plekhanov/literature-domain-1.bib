@article{shaw1988plekhanov,
  author = {Shaw, William H.},
  title = {Plekhanov on the Role of the Individual in History},
  journal = {Studies in Soviet Thought},
  year = {1988},
  volume = {35},
  number = {3},
  pages = {247--265},
  doi = {10.1007/bf01044986},
  note = {
  CORE ARGUMENT: Shaw offers a close philosophical reconstruction and critique of Plekhanov's essay "The Role of the Individual in History," arguing that Plekhanov's attempt to reconcile strong historical determinism with a substantive causal role for talented individuals is less stable than it first appears: the very conditions Plekhanov cites to explain why a given individual's presence mattered (e.g., contingent absence of equally talented rivals) threaten to collapse his determinism into a much weaker claim about historical explanation, or alternatively make the individual's contribution look arbitrarily contingent rather than necessitated.

  RELEVANCE: This is the single most direct philosophical engagement with the freedom/necessity question central to this review's first key question, and provides the critical counterpoint needed to assess "is his solution successful?" rather than simply reporting Plekhanov's own claims.

  POSITION: Critical analytic assessment of Plekhanov's compatibilism, sympathetic to the project but skeptical that the individual/necessity synthesis is fully coherent.
  },
  keywords = {freedom-necessity, role-of-individual, critical-assessment, High, INCOMPLETE, no-abstract}
}

@article{mayer1997plekhanov,
  author = {Mayer, Robert},
  title = {Plekhanov, Lenin and Working-Class Consciousness},
  journal = {Studies in East European Thought},
