      "title": "Impact of Innovation and Exports on Productivity: Are There Complementary Effects?",
      "authors": [
        {
          "name": "Sa\u0161a Petkovi\u0107",
          "openalex_id": "A5078770179",
          "orcid": "https://orcid.org/0000-0001-7354-5931",
