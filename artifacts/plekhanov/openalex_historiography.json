    {
      "openalex_id": "W4206165577",
      "doi": "10.21209/1996-7853-2021-16-3-24-33",
      "title": "Clerical-Protective Direction in the Russian Historiography of the Old Believers of the 1850s: the Structure of Historical Research",
      "authors": [
        {
          "name": "Madzharov Alexander S.",
          "openalex_id": "A5071080492",
