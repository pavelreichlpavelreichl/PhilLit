      "paperId": "c53119a99a9dba522dd63dc8406a4a9f0e005c52",
      "title": "METHODOLOGICAL FUNCTIONS OF THE HISTORY OF PSYCHOLOGY IN MODERN SCIENCE",
      "authors": [
        {
          "name": "E. Sokolova",
          "authorId": "46957256"
        }
