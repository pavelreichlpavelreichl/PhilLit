      "title": "Cultic revelations : studies in modern historical cult personalities and phenomena",
      "authors": [
        {
          "name": "Anssi Halmesvirta",
          "openalex_id": "A5017735714",
          "orcid": "https://orcid.org/0000-0002-9865-9588"
