    {
      "openalex_id": "W2767286532",
      "doi": null,
      "title": "Spectral Socialisms: Marxism-Leninism and the Future of Marxist Thought in Post-Socialist Bulgaria",
      "authors": [
        {
          "name": "Zhivka Valiavicharska",
          "openalex_id": "A5067460794"
        }
