    {
      "openalex_id": "W4281636328",
      "doi": "10.12697/sss.2022.50.1.08",
      "title": "Is language a system of signs? Lenin, Saussure and the theory of hieroglyphics",
      "authors": [
        {
          "name": "Patrick S\u00e9riot",
