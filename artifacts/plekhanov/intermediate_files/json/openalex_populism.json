    {
      "openalex_id": "W4223972251",
      "doi": "10.26650/siyasal.2022.31.1059042",
      "title": "How to Define the Elephant: Towards a Novel Conceptualization of Populism",
      "authors": [
        {
          "name": "Giray Gerim",
          "openalex_id": "A5064941313",
          "orcid": "https://orcid.org/0000-0003-4549-3876",
