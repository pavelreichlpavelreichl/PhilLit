    {
      "openalex_id": "W4389016235",
      "doi": "10.1163/9789004679023_030",
      "title": "Theory of Ideology",
      "authors": [
        {
          "name": "Jan Rehmann",
          "openalex_id": "A5038326155"
        },
        {
          "name": "Peter D. G. Thomas",
          "openalex_id": "A5041930110",
