      "title": "Receptions of Kant\u2019s Philosophy in Russian Empiriocriticism",
      "authors": [
        {
          "name": "Aleksandr E. Rybas",
          "openalex_id": "A5039669001",
          "orcid": "https://orcid.org/0000-0003-2120-2667",
