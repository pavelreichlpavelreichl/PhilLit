    {
      "openalex_id": "W4400460898",
      "doi": "10.5209/ltdl.93337",
      "title": "Luxemburg and Gramsci. The Role of Optimism and Pessimism during the Struggle for an Alternative to Capitalism",
      "authors": [
        {
          "name": "Sevgi Do\u011fan",
          "openalex_id": "A5034738516",
          "orcid": "https://orcid.org/0000-0002-5220-5847",
