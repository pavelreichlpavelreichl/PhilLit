          "name": "\u041b\u0435\u043e\u043d\u0438\u0434 \u0414\u043c\u0438\u0442\u0440\u0438\u0435\u0432\u0438\u0447 \u0428\u0438\u0440\u043e\u043a\u043e\u0440\u0430\u0434",
