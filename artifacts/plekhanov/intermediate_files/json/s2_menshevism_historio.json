      "paperId": "a3abc8fc6a18d89841a9dcc8440986a9237c5311",
      "title": "A STUDY ABOUT THE \"ARSHIN MAL ALAN\" OPERETTA",
      "authors": [
        {
          "name": "\u00d6mer T\u00fcrkmeno\u011flu",
          "authorId": "2100762718"
