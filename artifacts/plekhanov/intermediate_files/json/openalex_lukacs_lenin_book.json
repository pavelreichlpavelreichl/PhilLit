    {
      "openalex_id": "W2171239180",
      "doi": "10.1017/s0020859000004296",
      "title": "The Works of Marx and Engels in Ethnology Compared",
      "authors": [
        {
          "name": "Lawrence Krader",
          "openalex_id": "A5039352788"
