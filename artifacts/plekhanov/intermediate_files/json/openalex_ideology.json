    {
      "openalex_id": "W4312326091",
      "doi": "10.56063/ms.2201.01105",
      "title": "Engels\u2019 Dialectics of\u2014Human Activity in\u2014Nature",
      "authors": [
        {
          "name": "Siyave\u015f Azeri",
          "openalex_id": "A5084372075"
