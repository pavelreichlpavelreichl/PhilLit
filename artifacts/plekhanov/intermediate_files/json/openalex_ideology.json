    {
      "openalex_id": "W2005957060",
      "doi": "10.2478/v10059-011-0010-1",
      "title": "The Dialogical concept of consciousness in L.S. Vygotsky and G.H. Mead and its relevance for contemporary discussions on consciousness",
      "authors": [
        {
          "name": "Leszek Koczanowicz",
          "openalex_id": "A5033851186",
          "orcid": "https://orcid.org/0000-0002-4204-1674",
