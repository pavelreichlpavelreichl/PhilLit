      "doi": "10.48010/2023.3/1999-5849.03",
      "arxivId": null,
      "url": "https://www.semanticscholar.org/paper/6ce0fe0267f001462e980b47f0e5a96f1ef1ff37",
      "venue": "Adam alemi",
