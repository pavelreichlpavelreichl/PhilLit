            "Herzen University"
          ]
        },
        {
          "name": "Olga Yakovleva",
          "openalex_id": "A5052035223",
          "orcid": "https://orcid.org/0000-0002-5878-099X",
          "institutions": [
            "Herzen University"
          ]
