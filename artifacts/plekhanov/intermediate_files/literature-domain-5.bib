@book{lukacs1971lenin,
  author = {Lukács, Georg},
  title = {Lenin: A Study on the Unity of His Thought},
  year = {1971},
  publisher = {MIT Press},
  address = {Cambridge, MA},
  note = {
  CORE ARGUMENT: Written in 1924 on the occasion of Lenin's death; per the Stanford Encyclopedia of Philosophy's Lukacs bibliography, translated by Nicholas Jacobs and published by MIT Press in 1971. Le Blanc (2013, this domain) characterizes it, alongside "History and Class Consciousness," as part of a coherent, practically-engaged Leninist-Trotskyist political and theoretical orientation developed during Lukacs's 1919-29 leadership role in the Hungarian Communist Party, rather than a purely philosophical exercise in Hegelianizing Lenin. No abstract could be independently verified for the primary text itself.

  RELEVANCE: A foundational Western Marxist text on Lenin's philosophical and political significance, offering a Hegelian-praxis-oriented reading of Leninism that stands in contrast to the reflection-theoretic materialism descending from Plekhanov, and thus a direct point of reference for assessing what in Lenin's legacy Western Marxism emphasized against the Plekhanovite inheritance.

  POSITION: Early Western Marxist (Lukacsian) canonization of Lenin as a dialectical, praxis-oriented thinker, read by Le Blanc as continuous with Lenin's and Trotsky's own Comintern-era positions rather than a deviation from them.
  },
  keywords = {Lukacs, Lenin, Western-Marxism, primary-source, INCOMPLETE, High, no-abstract}
}

@incollection{oittinen2018dialectician,
  author = {Oittinen, Vesa},
  title = {Which Kind of Dialectician Was Lenin?},
  booktitle = {The Palgrave Handbook of Leninist Political Philosophy},
  year = {2018},
  pages = {63--88},
  publisher = {Palgrave Macmillan UK},
  doi = {10.1057/978-1-137-51650-3_2},
  note = {
  CORE ARGUMENT: Argues that Lenin's idea of "dialectics" amounts, in most cases, to a demand for "concrete analysis of a concrete situation," which Lenin turned against the un-dialectical, dogmatic interpretations of Marxism current in the Second International. Crucially, Oittinen argues this conception of dialectics-as-concrete-analysis is not borrowed from Plekhanov or other Marxist theoreticians at all, but from the Narodnik writer Alexander Herzen, and that there is no textual evidence Lenin changed his position after 1914 when he began studying Hegel's "Logic": Lenin did not abandon the views of his 1907 "Materialism and Empirio-Criticism," as shown by his post-1917 criticism of Bukharin's inability to apply dialectics correctly.

  RELEVANCE: Directly contradicts a simple continuity-then-rupture narrative of Plekhanov's influence on Lenin by denying both that Plekhanov was the source of Lenin's dialectical method and that Lenin's later engagement with Hegel produced any substantive philosophical change; should be read against Bonilla (2020, this domain), who argues for exactly the rupture that Oittinen denies.

  POSITION: Revisionist historical-philosophical study arguing for continuity in Lenin's dialectics and for Herzen, rather than Plekhanov, as its true source -- directly opposed to rupture readings of Lenin's post-1914 philosophical development.
  },
  keywords = {Lenin, dialectics, Herzen, continuity-thesis, Medium},
  abstract = {The paper deals with the character of Lenin's 'dialectics,' of which there has, until recently, been many erroneous interpretations. I attempt to show that Lenin's idea of a dialectical method in most cases boils down to the demand of a "concrete analysis of a concrete situation." This demand Lenin turned against the un-dialectical and dogmatic interpretations of Marxism of the Second International. Actually, Lenin's idea of dialectics as, above all, a method of a concrete analysis is not borrowed from Plekhanov or other Marxist theoreticians, but from the Narodnik writer Alexander Herzen. As to the claim that Lenin changed his mind after 1914 when he began to study Hegel's 'Logic', there is no evidence to support the thesis. Lenin did not abandon the positions he had taken earlier, in 1907, in his 'Materialism and Empirio-Criticism.' This is obvious from his writings after the October Revolution of 1917; for example, in the notes he criticizes Bukharin's inability to use dialectics correctly (i.e. to make a concrete analysis).},
  abstract_source = {openalex},
}
