@article{salvadori1989kautsky_weber,
  author = {Salvadori, Massimo L.},
  title = {Kautsky and Weber: Common Problems and Different Approaches},
  journal = {International Journal of Comparative Sociology},
  year = {1989},
  volume = {30},
  number = {1--2},
  pages = {93--108},
  doi = {10.1177/002071528903000110},
  note = {
  CORE ARGUMENT: Salvadori compares Kautsky and Weber as contemporaries
  grappling with shared problems of modernity, capitalism, and rationalization.
  Despite opposite conclusions — Kautsky embracing socialist transformation,
  Weber skeptical of it — both grappled with the relationship between
  structural-historical forces and political agency, and both refused pure
  voluntarism. Salvadori argues this comparison illuminates the genuine
  theoretical ambitions behind Kautsky's evolutionism.

  RELEVANCE: Situates Kautsky within the broader context of late nineteenth
  and early twentieth century social theory; relevant to assessing whether
  Kautsky's philosophy of history was merely a product of Marxist
  orthodoxy or engaged with wider debates about historical causation and
  social science.

  POSITION: Contextualizing rehabilitation; treats Kautsky as a serious
  social theorist in dialogue with non-Marxist contemporaries.
  },
  keywords = {revisionist-rehabilitation, comparative-social-theory, Medium, INCOMPLETE, no-abstract}
}

@article{shandro1997kautsky,
  author = {Shandro, Alan},
  title = {Karl Kautsky: On the Relation of Theory and Practice},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {1997},
  volume = {61},
  number = {4},
  pages = {474--501},
  doi = {10.1177/003682379706100403},
  note = {
  CORE ARGUMENT: Shandro examines Kautsky's account of the relationship
  between socialist theory and working-class practice, arguing that Kautsky
  maintained a more complex and dialectical view than the "injection from
  without" model often attributed to him (and contested by Lenin). The
  article shows that Kautsky's theory assigns a constitutive role to
  working-class experience in the formation of socialist consciousness,
  complicating the charge of pure intellectualism or scientism.

  RELEVANCE: Directly bears on the "positivist" charge: if Kautsky's
  theory-practice relation is more dialectical than critics claim, the
  mechanical-determinist reading loses force. Essential for assessing the
  epistemological dimension of Kautsky's philosophy of history.

  POSITION: Revisionist; defends the theoretical sophistication of
  Kautsky's account of socialist consciousness against standard critiques.
  },
  keywords = {theory-practice, socialist-consciousness, revisionist-rehabilitation, Medium},
  abstract = {It has become customary to trace the deficiencies of Kautsky's “orthodox Marxism” to a reified social ontology that leaves no room for political will and secretes a separation of theory from practice. But this sort of interpretation does not stand up to careful examination of Kautskyan texts and their insertion in the political context of the German Social-Democratic Party (SPD); it obscures, and hence risks reproducing, the real theoretical and political limitations of Kautskyan orthodoxy. Bernstein's revisionist challenge counterposed social diversity and the diversification of the working class to the orthodox diesis of class polarization. Kautsky's failure to generate an innovative response is best explained as the product, not of a separation, but of the conjunction of an abstractly universalistic theorization of working-class unity with the parliamentary political project of the SPD. This union of theory and practice effectively depreciated any evidence of the necessary unevenness and complexity of the process of working-class unity and so, paradoxically, could reproduce divisions in the class. The appreciation of unevenness and complexity that is required in order to avoid the failures of Kautskyan orthodoxy suggests, in turn, a notion of the working-class movement as a unity-in-diversity, a community, and the need for a correspondingly rectified understanding of the unity of theory and practice.},
  abstract_source = {s2},
}

@article{blackledge2006trotsky,
