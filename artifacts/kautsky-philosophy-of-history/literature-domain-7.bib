  year = {2016},
  publisher = {Brill},
  address = {Leiden},
  doi = {10.1163/9789004306653},
  note = {
  CORE ARGUMENT: Gronow reconstructs Kautsky's theory of capitalism in
  close dialogue with Marx's Critique of Political Economy, arguing that
  Kautsky's engagement with Marx was philosophically serious and that the
  "vulgar Marxism" caricature misrepresents his actual theoretical
