@article{blackledge2006kautsky,
  author = {Blackledge, Paul},
  title = {Karl Kautsky and Marxist Historiography},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2006},
  volume = {70},
  number = {3},
  pages = {337--359},
  doi = {10.1521/siso.70.3.337},
  note = {
  CORE ARGUMENT: Blackledge argues that Kautsky's historical studies —
  including his work on the early Church, the Reformation, and the Russian
  and American social formations — demonstrate a sophisticated and powerful
  theory of history, particularly in the period before 1910. The article
  contests the standard view that Kautsky's Marxism is reducible to
  mechanical determinism, distinguishing his nuanced historical analyses
  from the cruder formulas of his political writing.

  RELEVANCE: Directly addresses the central question of whether the
  positivism/mechanism charges are fair assessments of Kautsky's actual
  historical practice; argues for a gap between his methodological
  sophistication and his political-strategic failings.

  POSITION: Revisionist rehabilitation; defends the early Kautsky's
  historical methodology while acknowledging consistent political
  weaknesses.
  },
  keywords = {revisionist-rehabilitation, Marxist-historiography, High},
  abstract = {The traditional dismissive characterization of Karl Kautsky's Marxism as a form of mechanical or even Darwinian evolutionism is a caricature that obscures the very real and important contribution he made to historical materialism in the early years of the last century. Kautsky's historical studies of both the early Church and Reformation “communism,” as well as his attempts to analyze the contemporary Russian and American social formations, show that, while Kautsky's Marxism suffered from consistent political weaknesses, his theory of history, especially as it was articulated in the years before 1910, was sophisticated and powerful. While the power of Kautsky's Marxism became muted after this period, the weaknesses of his later works should not be allowed to obscure the insights contained within his earlier work; insights that informed some of the best work of the next generation of Marxists.},
  abstract_source = {openalex},
}

@book{blackledge2006reflections,
  author = {Blackledge, Paul},
  title = {Reflections on the Marxist Theory of History},
  year = {2006},
  publisher = {Manchester University Press},
  address = {Manchester},
  doi = {10.7765/9781847791344},
  note = {
  CORE ARGUMENT: A survey of Marxist theories of history from Marx and
  Engels through the Second International, Western Marxism, and
  contemporary analytical Marxism. Kautsky figures centrally as the
  architect of "orthodox" Marxist historiosophy, and Blackledge assesses
  both the strengths (systematic integration of evolution, class struggle,
  and historical agency) and the weaknesses (tendency toward passive
  fatalism and neglect of political subjectivity) of the Kautskyan model.

  RELEVANCE: Provides a systematic comparison of Kautsky's philosophy of
  history with alternatives across the Marxist tradition; situates the
  positivism debate within a broader history of Marxist historical thought.

  POSITION: Revisionist but balanced; treats Kautsky's contribution to
  Marxist historiosophy as both significant and flawed.
  },
  keywords = {revisionist-rehabilitation, philosophy-of-history, High},
  abstract = {The recent emergence of global anti-capitalist and anti-war movements have created a space within which Marxism can flourish in a way as it has not been able to for a generation. This book shows that by disassociating Marxism from the legacy of Stalinism, Marxist historiography need not retreat before the criticisms from theorists and historians. It also shows that, once rid of this incubus, Marx's theory of history can be shown to be sophisticated, powerful and vibrant. The book argues that Marxism offers a unique basis to carry out a historical research, one that differentiates it from the twin failures of the traditional empiricist and the post-modernist approaches to historiography. It outlines Marx and Engels' theory of history and some of their attempts to actualise that approach in their historical studies. The book also offers a critical survey of debates on the application of Marx's concepts of 'mode of production' and 'relations of production' in an attempt to periodise history. Marxist debates on the perennial issue of structure and agency are considered in the book. Finally, the book discusses competing Marxist attempts to periodise the contemporary post-modern conjuncture, paying attention to the suggestion that the post-modern world is one that is characterised by the defeat of the socialist alternative to capitalism.},
  abstract_source = {openalex},
}

@book{gronow2016formation,
