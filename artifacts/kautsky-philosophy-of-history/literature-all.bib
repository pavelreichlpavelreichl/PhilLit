  },
  keywords = {internal-critique, evolutionary-model, philosophy-of-history, Medium, INCOMPLETE, no-abstract}
}

@article{steger1992historical,
  author  = {Steger, Manfred},
  title   = {Historical Materialism and Ethics: Eduard Bernstein's Revisionist Perspective},
  journal = {History of European Ideas},
  year    = {1992},
  volume  = {14},
  number  = {5},
  pages   = {647--663},
  doi     = {10.1016/0191-6599(92)90002-t},
  note    = {
  CORE ARGUMENT: Steger argues that Bernstein's 'revisionism' was fundamentally
  a reorientation of Marxist theory around ethics rather than economics: by
  introducing neo-Kantian normative constraints into socialism, Bernstein
  displaced the deterministic materialism that grounded Kautsky's orthodoxy.
