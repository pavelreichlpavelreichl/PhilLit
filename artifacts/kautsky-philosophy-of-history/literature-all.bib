  note = {
  CORE ARGUMENT: In this chapter Blackledge surveys the intellectual landscape of historical materialism in the Second International, placing Kautsky as the dominant custodian of Marxist orthodoxy. He argues that the sophisticated Second International thinkers — Kautsky, Plekhanov, Labriola — produced a more nuanced account than either Perry Anderson's "fatalism" critique or Lucio Colletti's "evolutionary interpretation" charge allows. The chapter traces the shift from Second to Third International Marxism and the contested legacy of Kautsky's framework.

  RELEVANCE: Situates Kautsky's historical materialism within the broader trajectory of the tradition, enabling comparison with Engels, Plekhanov, and Labriola. Important for understanding how Kautsky's conception shaped the next generation of Marxists and why it became the target of Western Marxist critique.

  POSITION: Contextualizing/evaluative: neither pure rehabilitation nor dismissal, emphasizes the internal diversity of Second International thought.
  },
  keywords = {kautsky-historical-materialism, second-international, plekhanov, labriola, Medium},
  abstract = {The Second International of socialist parties was the undoubted custodian of Marxist 'orthodoxy' from its formation in 1889 until its de facto collapse at the outbreak of the First World War. For the interpretation of historical materialism associated with the sophisticated Second International thinkers in their best works, Karl Kautsky was much more powerful that either Perry Anderson or Steve Rigby. Like Lucio Colletti, Anderson had interpreted the shift from Second to Third International Marxism as including a 'voluntaristic' break with 'fatalistim'. Colletti suggested the evolutionary interpretation of Marxism, which he likened unfavourably to the 'voluntarist' Marxism of the Third International, was born out of Friedrich Engels's crude systemisation of Marx's thought and reached its zenith in Kautsky's theory of history. Kautsky was the dominant intellectual within the Second International, while the works of Georgi Plekhanov and Antonio Labriola informed the best historiography produced by the succeeding generation of Marxists.},
  abstract_source = {openalex},
}

@article{baring2023vulgar,
  author = {Baring, Edward},
  title = {Who Are You Calling Vulgar? {Luk\'{a}cs}, {Kautsky}, and the Beginnings of ``{Western Marxism}''},
  journal = {Rethinking Marxism},
  year = {2023},
  volume = {35},
  number = {4},
  pages = {467--483},
  doi = {10.1080/08935696.2023.2241345},
  note = {
  CORE ARGUMENT: Baring reads Lukacs's early thought against his vexed relationship to Kautsky, arguing that Lukacs's critique of "vulgar Marxism" actually follows from and presupposes Kautsky's own distinction between proletarian class instinct and class consciousness. For Kautsky, Social Democratic intellectuals had to transmute class instinct into consciousness by disseminating a simplified scientific socialism — and Lukacs defined this transmission of conclusions without method as "vulgar Marxism," making Kautsky the condition and obstacle of class consciousness simultaneously. This reveals the "vulgar Marxism" label as an internal construction of a Kautskyian problematic, not an external critique of it.

  RELEVANCE: Directly illuminates the intellectual genealogy of the "vulgar Marxism" charge that dominates the historiography of Kautsky's historical materialism. Essential for evaluating how fairly or unfairly Kautsky has been assessed and for understanding what was actually at stake in the method/conclusions distinction in his theory of history.

  POSITION: Genealogical/deconstructive: shows the Lukacs critique is parasitic on Kautsky's framework, complicating the dismissal.
  },
  keywords = {kautsky-historical-materialism, vulgar-marxism, lukacs, western-marxism, class-consciousness, High},
  abstract = {This essay reads Georg Lukács’s early thought in light of his vexed relationship to the Social Democratic theorist Karl Kautsky. Though Lukács criticized Kautsky as the archetypal “vulgar Marxist,” Lukács’s larger project of promoting “class consciousness” follows from Kautsky’s own political and pedagogical work. For Kautsky, Social Democratic intellectuals had to transmute proletarian “class instinct” into class consciousness by disseminating a simplified version of scientific socialism, transmitting the conclusions but not the method of Marxist thought. But because Lukács had defined “vulgar Marxism” as the forgetting of Marx’s method in favor of his conclusions, “vulgar Marxism” turned out to be both the precondition and an obstacle to proletarian class consciousness and thus to revolutionary action. The essay then reads Lukács’s changing understanding of the role of the party as a response to this impasse: a response that can help us understand the heterogeneous tradition of “Western Marxism.”},
  abstract_source = {s2},
}

@article{ross2019marxism,
  author = {Ross, Lachlan},
  title = {``{Marxism}'' versus {Hegelianism-Engelsism-Stalinism}},
  journal = {Telos},
  year = {2019},
  volume = {2019},
  number = {187},
  pages = {177--186},
  doi = {10.3817/0619187177},
  note = {
  CORE ARGUMENT: Ross argues that "dialectical materialism" — the official Soviet theoretical designation — has almost nothing to do with Marx's own materialist conception of history, and that the distortion began with Engels and Kautsky's "bad reading" of Marx. While acknowledging the contestability of positing an "authentic" Marx underneath these readings, Ross endorses the view that Engels and Kautsky transformed Marx's theory into something prone to authoritarian misuse. The paper traces how Kautsky's codification of Marxism as an overarching theory of history diverged from Marx's own more immanent critique.

  RELEVANCE: Articulates the strong version of the "Engels-Kautsky distortion" thesis that many scholars treat as the default view; comparing this with Gronow and Blackledge's rehabilitation shows the range of the debate. Useful for mapping the contested reception of Kautsky's conception of historical materialism.

  POSITION: Critical: Kautsky's codification distorts Marx by turning dialectical materialism into deterministic naturalism.
  },
  keywords = {kautsky-historical-materialism, engels-kautsky, distortion-thesis, dialectical-materialism, Medium},
  abstract = {Dialectical materialism, which became the standard designation of the “official theory” of state-based Marxism, has almost nothing to do with Karl Marx's materialist conception of history. It is contentious to suggest that there is an “authentic” or “good” Marx underneath all of the false readings and applications—that “the man” Marx wrote texts that were emancipatory, and that “bad readers,” beginning with Friedrich Engels and Karl Kautsky, transformed the theory into something totalitarian—but it should not be. There is a growing movement that sees the work of Engels as the true theoretical basis of “Marxism,”1 and key Marxists themselves all but…},
  abstract_source = {s2},
}

@article{rakhinsky2024nowak,
  author = {Rakhinsky, D. V. and Musat, R. P. and Panasenko, G. V.},
  title = {Leszek {Nowak} and {His} Critique of Historical Materialism},
  journal = {Discourse-P},
  year = {2024},
  volume = {21},
  number = {3},
  pages = {25--41},
  doi = {10.17506/18179568_2024_21_3_25},
  note = {
  CORE ARGUMENT: The paper examines Leszek Nowak's reconstruction of historical materialism from the Poznan methodological school, focusing on Nowak's distinction between two interpretations of historical materialism: the "nomological" interpretation stemming from Kautsky (treating Marxism as a system of law-like historical regularities) and the "praxis" interpretation traced to Lukacs (emphasizing human agency and the self-realization of classes). Nowak endorses neither but develops a third "idealization" methodology; however, the paper attributes the nomological reading specifically to Kautsky's systematization.

  RELEVANCE: Provides a precise philosophical taxonomy of what is distinctive about Kautsky's approach to historical materialism as law-governed explanation, useful for understanding how his conception of materialist history differs structurally from both Marx and Lukacs. The nomological/praxis distinction is relevant to the base-superstructure and agency questions.

  POSITION: Taxonomic/comparative: positions Kautsky as the originator of the nomological (law-scientific) interpretation of historical materialism.
  },
  keywords = {kautsky-historical-materialism, nomological-interpretation, nowak, poznan-school, Medium},
  abstract = {The article examines the specifics and content of the critical re-evaluation of Marxist historical materialism undertaken by the renowned Polish philosopher and legal theoretician Leszek Nowak, a prominent member of the Poznań methodological school. The analysis focuses on Nowak’s insight into the significance of Karl Marx’s contributions to the history of philosophy and social sciences, and particularly those valuable advancements in philosophical methodology attributed to him. Nowak states that Marx’s methodological innovations – namely, the method of idealization – have not been fully recognized or appreciated by Marxists, and he conducts an independent exploration of them. The section dedicated to analyzing Nowak’s understanding of historical materialism highlights his development of a “non-marxist” theory of social formations, which emerges from the study of the peculiar organization of research activities by Marxist philosophers and the substantive conflicts within Marxist social philosophy. Nowak criticizes Marxist historical materialism on both theoretical and practical grounds, illustrating his arguments with examples from the history of socialist states. He identifies two existing Marxist interpretations of historical materialism: the “nomological” interpretation stemming from Karl Kautsky and the “praxis” one, which Nowak traces back to the works of György Lukács. Nowak not only demonstrates strengths and weaknesses of these two interpretations, but also proposes his own interpretation of historical materialism employing the idealization methodology he reconstructed from Marx’s works. Drawing on Nowak’s significant theoretical contributions, the authors conclude by discussing the contemporary relevance of his research for socio-philosophical reflection within entire Marxist philosophy.},
  abstract_source = {s2},
}

@article{blackledge2008macintyre,
  author = {Blackledge, Paul},
  title = {Alasdair {MacIntyre}'s Contribution to Marxism: {A} Road not Taken},
  journal = {Analyse \& Kritik},
  year = {2008},
  volume = {30},
  number = {1},
  pages = {215--227},
  doi = {10.1515/auk-2008-0113},
  note = {
  CORE ARGUMENT: Questioning MacIntyre's post-Marxist trajectory, Blackledge argues that MacIntyre was uncharitable in conflating the strongest aspects of classical Marxism with the "crudities of Kautskyian and Stalinist materialism." The essay locates in the revolutionary Left of the 1917 period a dialectical tradition that escapes both crude materialism and political voluntarism, suggesting that Kautsky's materialism represents a specific failure mode — a collapse of structure-agency dialectics — rather than being representative of the tradition as a whole.

  RELEVANCE: Helps characterize what specifically is philosophically deficient in Kautskyian materialism as opposed to the broader Marxist tradition; illuminates the distinction between Kautsky's quasi-naturalistic account and the dialectical approach centered on structure-agency interaction.

  POSITION: Critical-contextual: Kautsky's materialism is a specific, traceable failure rather than the inevitable form of Marxist historical theory.
  },
  keywords = {kautsky-historical-materialism, macintyre, structure-agency, vulgar-marxism, Medium},
  abstract = {Abstract This essay questions, through a critique of his reading of classical Marxism, the path taken by Alasdair MacIntyre since his break with the Marxist Left in the 1960s. It argues that MacIntyre was uncharitable in his criticisms of Marxism, or at least in his conflation of the most powerful aspects of the classical Marxist tradition with the crudities of Kautskyian and Stalinist materialism. Contra MacIntyre, this essay locates in the writings of the revolutionary Left which briefly flourished up to and just after the Russian Revolution a rich source of dialectical thinking on the relationship between structure and agency that escapes the twin errors of crude materialism or political voluntarism. Moreover, it suggests that by reaching back to themes reminiscent of the young Marx this tradition laid the basis for a renewed ethical Marxism, and that in his youth MacIntyre pointed to the realisation of this project.},
  abstract_source = {openalex},
}

@article{lewis2017disputed,
  author = {Lewis, Ben},
  title = {Marxism after {Marx}: {Karl Kautsky}'s Disputed Legacy},
  journal = {Historical Materialism},
  year = {2017},
  volume = {25},
  number = {3},
  pages = {141--147},
  doi = {10.1163/1569206x-12341527},
  note = {
  CORE ARGUMENT: Lewis surveys the contested legacy of Kautsky's Marxism, noting that while Kautsky is mainly remembered as Lenin's polemical target ("the renegade"), a closer reading shows the extent to which Kautsky defined the theoretical framework of the Second International — including the conception of historical materialism as scientific, law-governed theory of social development. The article situates this in the wider debate about what orthodoxy in Marxism meant for the development of socialist theory.

  RELEVANCE: Provides historiographical orientation to the reception of Kautsky's philosophy of history, noting that the "disputed legacy" turns precisely on contested interpretations of his historical materialism. Useful contextual framing for the project's coverage of how Kautsky's philosophy has been received and evaluated.

  POSITION: Historiographical/evaluative: maps the terrain of Kautsky scholarship and the contested legacy question.
  },
  keywords = {kautsky-historical-materialism, legacy, second-international, historiography, Medium},
  abstract = {Abstract Today, Karl Kautsky (1854–1938) is mainly remembered for his polemics against the young Bolshevik regime or as the ‘renegade’ in Lenin’s The Proletarian Revolution and the Renegade Kautsky (1918), which pillories him for his wavering stance in opposing World War I and his (later) outright hostility to the Russian Revolution of October 1917. Kautsky’s authority as a Marxist theoretician was seriously called into question ever since Lenin’s polemic. During the Cold War in particular, a consensus emerged which suggested that Kautsky’s views of democracy, organisation and revolutionary change had little or nothing to do with the political practice of Russian Bolshevism and the Russian Revolution of 1917. Recently, however, several studies have challenged this consensus. They highlight the profound impact which Kautsky had on the development of Russian Bolshevism and make the case that – prior to his renegacy in 1914 – thinkers such as Lenin and Trotsky viewed Kautsky as the legitimate intellectual heir of Marx and Engels. This article introduces an autobiographical essay written by Kautsky in 1924 and calls for closer engagement with his œuvre as a whole.},
  abstract_source = {openalex},
}

@article{goldstein2014reconstructing,
  author = {Goldstein, Warren},
  title = {Reconstructing the Classics},
  journal = {Method \& Theory in the Study of Religion},
  year = {2014},
  volume = {26},
  number = {4-5},
  pages = {470--507},
  doi = {10.1163/15700682-12341329},
  note = {
  CORE ARGUMENT: Goldstein reconstructs how Max Weber and Ernst Troeltsch built their theoretical frameworks in explicit debate with historical materialism, taking Marx, Engels, Bernstein, and Kautsky as interlocutors. The article shows Weber and Troeltsch appropriating Kautsky's base-superstructure and class analysis in their sociology of religion, while also critically transforming these tools. It compares Kautsky's materialist treatment of early Christianity, the Reformation, and the German Peasant Wars with Weber's and Troeltsch's analyses.

  RELEVANCE: Provides a concrete application domain for Kautsky's historical materialism — his materialist analyses of religious history — and shows how his base-superstructure framework was received and critically modified by non-Marxist contemporaries. Useful for assessing the reach and limits of Kautsky's historical-materialist method.

  POSITION: Comparative/reception: traces cross-fertilization between Kautsky's materialism and the Weber/Troeltsch tradition in sociology of religion.
  },
  keywords = {kautsky-historical-materialism, base-superstructure, weber, religion, historiography, Low},
  abstract = {Max Weber and Ernst Troeltsch constructed their theoretical frameworks in debate with historical materialism. Karl Marx and Friedrich Engels provided Weber and Troeltsch with the tools of base/superstructure and class analysis that they employed in their analysis of religion. The article places Weber and Troeltsch in the historical context of the rise of the Social Democratic Party and its splintering during World War I. It compares the writing on religion by Engels, Eduard Bernstein and Karl Kautsky with those of Weber and Troeltsch. It focuses on Ancient Judaism, the origins of Christianity, Christian heretical sects, the Reformation, the German Peasant Wars, and the Puritan Revolution. Some points in common are the origins of communism in Judaism and Christianity and the association between Protestantism and capitalism. This article shows how Weber and Troeltsch critically appropriated from historical materialism and uses this with the intent of constructing a critical sociology of religion.},
  abstract_source = {openalex},
}

@book{kautsky1927geschichtsauffassung,
  author = {Kautsky, Karl},
  title = {Die materialistische {Geschichtsauffassung}},
  year = {1927},
  publisher = {J. H. W. Dietz Nachf.},
  address = {Berlin},
  note = {
  CORE ARGUMENT: Kautsky's magnum opus, a two-volume systematic synthesis of his materialist philosophy of history. Volume 1 (Natur und Gesellschaft) treats the natural foundations of history — ecology, technology, human drives, and the relationship between nature and society — arguing that material and technological conditions are the ultimate determinants of historical change. Volume 2 (Der Staat und die Entwicklung der Menschheit) applies this framework to the development of the state and human social organization. The work integrates Darwinian evolutionary biology into a comprehensive materialist account of historical development.

  RELEVANCE: This is the primary philosophical text for the domain — the most systematic statement of Kautsky's mature historical materialism. All secondary literature on Kautsky's philosophy of history ultimately engages with this work's arguments about the role of nature, technology, and ecology in historical change, and its divergences from Marx's own formulations.

  POSITION: Primary source: represents Kautsky's own mature, systematic position and the benchmark against which all critical assessments are measured.
  },
  keywords = {kautsky-primary, materialistische-geschichtsauffassung, nature-technology, historical-materialism, High, INCOMPLETE, no-abstract}
}

@article{kautsky1907ethics,
  author = {Kautsky, Karl},
  title = {Ethics and the Materialist Conception of History},
  year = {1907},
  publisher = {C. H. Kerr},
  address = {Chicago},
  note = {
  CORE ARGUMENT: An early elaboration of how the materialist conception of history relates to ethics and normative questions. Kautsky argues that materialism need not entail amoralism and attempts to reconstruct an ethical standpoint grounded in historical-materialist premises, treating morality as a product of social conditions while also affirming the role of ethical motivation in political action. This work represents an early stage in Kautsky's engagement with the philosophical foundations of historical materialism.

  RELEVANCE: Provides insight into the pre-1927 development of Kautsky's historical-materialist thought, specifically on the contentious question of the relationship between materialist explanation and normative-ethical commitments — relevant to evaluating how his later synthesis handles determinism and agency.

  POSITION: Primary source: early Kautsky on the normative dimensions of historical materialism, predating the systematic 1927 synthesis.
  },
  keywords = {kautsky-primary, ethics-materialism, historical-materialism, second-international, Medium},
  abstract = {Translation of: Ethik und materialistische Geschichtsauffassung.Mode of access: Internet},
  abstract_source = {core},
}

@book{gronow2020deciphering,
  author = {Gronow, Jukka},
  title = {Deciphering Markets and Money: A Sociological Analysis of Economic Institutions},
  year = {2020},
  publisher = {Helsinki University Press},
  doi = {10.33134/hup-1},
  note = {
  CORE ARGUMENT: Gronow's later monograph extends his analysis of the Kautsky-Marx divergence, arguing that "orthodox Marxists-Leninists" — Kautsky centrally — largely neglected the analysis of the value form of a commodity and labour power, making their theoretical position closer to classical political economy than to Marx's critique of it. The book develops this point through a broad sociological analysis of markets, but the first sections directly address how Kautsky's framework differs from Marx's in its treatment of value and economic categories.

  RELEVANCE: Provides a sustained philosophical argument about how Kautsky's codification of Marx's theory diverged from Marx's own categories, directly addressing the base/superstructure question and the relationship between economic analysis and historical explanation.

  POSITION: Complementary to Gronow 2016: extends the argument about Kautsky's divergence from Marx to the theory of value and economic categories.
  },
  keywords = {kautsky-historical-materialism, value-theory, marx-kautsky-divergence, Low},
  abstract = {Jukka Gronow’s book Deciphering Markets and Money solves the problem of the specific social conditions of an economic order based on money and the equal exchange of commodities. Gronow scrutinizes the relation of sociology to neoclassical economics and reflects on how sociology can contribute to the analyses of the major economic institutions. The question of the comparability and commensuration of economic objects runs through the chapters of the book. The author shows that due to the multidimensionality and principal quality uncertainty of products, markets would collapse without market devices that are either procedural, consisting of technical standards and measuring instruments, or aesthetic, relying on the judgements of taste, or both. In his book, Gronow demonstrates that in this respect, financial markets share the same problem as the markets of wines, movies, or PCs and mobile phones, and hence offer a highly actual case to study their social constitution in the process of coming into being. Jukka Gronow is professor emeritus of sociology at Uppsala University, Sweden, and docent at the University of Helsinki, Finland. He has published on sociology of consumption, history of sociology and social theory.},
  abstract_source = {s2},
}

@book{weikart1999socialist,
  author = {Weikart, Richard},
  title = {Socialist Darwinism: Evolution in German Socialist Thought from Marx to Bernstein},
  year = {1999},
  publisher = {International Scholars Publications},
  address = {San Francisco and London},
  note = {
  CORE ARGUMENT: Weikart argues that major German socialist theorists from Marx
  to Bernstein -- including Kautsky, Bebel, and Lange -- developed a distinctive
  "socialist Darwinism" that integrated Darwinian evolutionary concepts into
  socialist theory. Rather than simply rejecting or uncritically adopting
  Darwinism, these thinkers selectively appropriated evolutionary ideas while
  rejecting Malthusian competition, producing a politically oriented naturalism
  that grounded socialist hopes in biological and social progress. Kautsky
  receives extended treatment as a central figure who sought to demonstrate the
  natural inevitability of socialist development.

  RELEVANCE: This is the foundational study for assessing the charge that
  Kautsky's Marxism is a form of social Darwinism. Weikart's analysis of
  Kautsky's Vermehrung und Entwicklung and Ethics and the Materialist
  Conception of History provides the primary scholarly framework for
  understanding how Kautsky integrated biological evolutionary concepts with
  historical materialism. Essential for any account of Kautsky's naturalism.

  POSITION: Argues for a distinctive "socialist Darwinist" tradition in German
  social democracy that biologizes historical progress while maintaining
  socialist political conclusions.
  },
  keywords = {Kautsky, Darwinism, socialist-Darwinism, evolution, German-socialism, Second-International, High, INCOMPLETE, no-abstract}
}

@article{weikart1993origins,
  author = {Weikart, Richard},
  title = {The Origins of Social Darwinism in Germany, 1859-1895},
  journal = {Journal of the History of Ideas},
  year = {1993},
  volume = {54},
  number = {3},
  pages = {469--488},
  doi = {10.2307/2710024},
  note = {
  CORE ARGUMENT: Weikart traces the emergence of social Darwinism in Germany
  from Darwin's reception in the 1860s through the 1890s, distinguishing
  between laissez-faire social Darwinism (appropriating Malthusian struggle)
  and socialist Darwinism (appropriating progressive evolution). The article
  shows that "social Darwinism" in Germany was not a unified ideology but
  a contested and politically diverse field, with socialist thinkers deploying
  Darwin against both capitalism and competing biologistic conservatisms.

  RELEVANCE: Provides the historical and conceptual background for locating
  Kautsky's evolutionary Marxism within the broader German reception of
  Darwinism. Distinguishes the socialist use of Darwin from the more
  familiar right-wing varieties of social Darwinism, which is essential for
  assessing whether Kautsky's naturalism is properly called "social Darwinist."

  POSITION: Identifies social Darwinism as a contested and politically
  ambivalent phenomenon in Germany, with distinct socialist and conservative
  variants.
  },
  keywords = {social-Darwinism, Germany, Darwin-reception, evolution, socialist-Darwinism, High}
}

@article{blackledge2004weikart,
  author = {Blackledge, Paul},
  title = {On Richard Weikart's Socialist Darwinism: Evolution in German Socialist Thought from Marx to Bernstein},
  journal = {Historical Materialism},
  year = {2004},
  volume = {12},
  number = {1},
  pages = {213--232},
  doi = {10.1163/156920604773564050},
  note = {
  CORE ARGUMENT: Blackledge's critical review argues that Weikart's framing
  of German socialist evolutionary thought as "socialist Darwinism" caricatures
  the actual dialectical sophistication of thinkers like Kautsky. Blackledge
  contends that Kautsky's early engagement with Darwin was embedded in a
  broader materialist framework that did not simply biologize social theory but
  sought to articulate the specific conditions of human historical development.
  The review identifies conceptual conflations and anachronistic readings in
  Weikart's account.

  RELEVANCE: Provides the major scholarly counterposition to Weikart's thesis
  and is essential for understanding the debate over whether Kautsky's
  evolutionary naturalism constitutes a form of social Darwinism. Blackledge's
  defense of Kautsky's early work as containing genuine dialectical insights
  is central to the revisionist rehabilitation of Kautsky in recent Marxist
  historiography.

  POSITION: Defends Kautsky's early evolutionary materialism against the
  "social Darwinist" label, arguing for a more dialectically complex reading.
  },
  keywords = {Kautsky, Weikart, socialist-Darwinism, historical-materialism, critique, High, INCOMPLETE, no-abstract}
}

@article{nygaard2009constructing,
  author = {Nygaard, Bertel},
  title = {Constructing Marxism: Karl Kautsky and the French Revolution},
  journal = {History of European Ideas},
  year = {2009},
  volume = {35},
  number = {4},
  pages = {450--464},
  doi = {10.1016/j.histeuroideas.2009.04.002},
  note = {
  CORE ARGUMENT: Nygaard argues that Kautsky's writings on the French Revolution were constitutive of Marxism as a comprehensive theoretical system, not merely applications of an already-formed theory. Kautsky used the Revolution to work out the relationship between bourgeois and proletarian revolutions, the role of class forces in historical ruptures, and the limits of liberal democratic forms.

  RELEVANCE: The article illuminates how Kautsky's philosophy of historical rupture -- his account of when and how class struggle produces revolutionary breaks -- was forged through historical study, with implications for understanding the proletariat's own potential revolution.

  POSITION: Kautsky's Marxism as constructed through historical case studies rather than deduced from abstract principles.
  },
  keywords = {Kautsky, French-Revolution, historical-materialism, class-struggle, historiography, High},
  abstract = {Karl Kautsky's writings on the French Revolution were crucial to the construction not only of the Marxist interpretation of the Revolution, which was perhaps the most important reference point for the historiography of that event during the 20th century, but even of Marxism itself as a comprehensive, systematic theory partly based on historical studies. However, these writings have been neglected and practically forgotten for decades, mainly because of the general rejection of Kautsky's theories after the October Revolution of 1917, in Marxist as well as non-Marxist circles. Studying these writings, spanning roughly four decades from 1889 till 1930, we may see dynamic interrelations between historical study, theory construction and contemporary political intervention. Kautsky's approach to such key Marxist concepts as class and state prove to be much more subtle and nuanced than what has commonly been assumed, incorporating the results of historical study rather than pure social theory. Yet, his account does contain important internal tensions and contradictions between agency and objective conditions and between the historical material and the normative and political perspective of the historiographer. Several of these internal tensions were carried on into mainstream Marxist accounts of the Revolution, with important historiographical as well as political consequences.},
  abstract_source = {openalex},
}

@incollection{weir2012riddles,
  author = {Weir, Todd H.},
  title = {The Riddles of Monism: An Introductory Essay},
  booktitle = {Monism},
  year = {2012},
  pages = {1--44},
  publisher = {Palgrave Macmillan US},
  doi = {10.1057/9781137011749_1},
  abstract = {Recent developments in the cognitive sciences point to a convergence, for some a clash, of the humanities and natural science. In 2004, a group of leading neurobiologists published a manifesto in the German journal Gehirn und Geist (Brain and Mind), claiming that advances in their discipline meant that it was poised to tackle the problems of consciousness and free will. In the growing field of evolutionary psychology, the leading research question "what is the evolutionary good of God?" indicates that religion has been subsumed under the explanatory framework of Darwinian natural selection. Against dualistic understandings of human reality, these varied scholarly endeavors seek to analyze nature and culture from a single vantage point. Philosophically, this stance is called monism.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Weir's introductory essay traces the history of Haeckelian
  monism as a philosophical-scientific worldview in Germany, arguing that
  monism served as the key intellectual framework linking Darwinian evolutionary
  biology to broader claims about social development, ethics, and politics.
  Weir shows that monism was politically diverse -- supporting both socialist
  and nationalist appropriations -- but that its core commitment to a unified
  naturalistic explanation of all phenomena made it a powerful vehicle for
  evolutionary social philosophy.

  RELEVANCE: Essential background for understanding the Haeckelian monist
  tradition that directly influenced Kautsky's naturalism. Kautsky's
  Vermehrung und Entwicklung and his ethics draw on monist assumptions about
  the continuity of natural and social evolution. Weir's essay provides the
  philosophical framework within which Kautsky's naturalism must be situated.

  POSITION: Analyzes monism as the philosophical mediator between Darwinian
  biology and social-political theory in Imperial Germany.
  },
  keywords = {Haeckel, monism, Darwinism, evolution, naturalism, Germany, socialist-ethics, High}
}

@article{stewart2019evolutionary,
  author = {Stewart, Ian G. and Hossfeld, Uwe and Levit, Georgy S.},
  title = {Evolutionary ethics and Haeckelian monism: the case of Heinrich Schmidt's Harmonie (1931)},
  journal = {Theory in Biosciences},
  year = {2019},
  volume = {138},
  number = {1},
  pages = {189--202},
  doi = {10.1007/s12064-019-00288-0},
  note = {
  CORE ARGUMENT: The paper examines the ethical philosophy of Heinrich Schmidt,
  Haeckel's student, as a case study in how Haeckelian monism generated a
  distinctive evolutionary ethics. Schmidt's system held that the moral good
  consists in what preserves and improves existence in accordance with
  evolutionary direction, with human social evolution following the same
  principle of increasing harmony that governs all natural evolution. The
  authors also examine Schmidt's failed attempt to adapt monist ethics to
  National Socialism, arguing that this failure shows the fundamental
  incompatibility of Haeckelian monism with fascism.

  RELEVANCE: Illuminates the specific philosophical framework -- evolutionary
  ethics grounded in monist naturalism -- that Kautsky drew upon in his Ethics
  and the Materialist Conception of History (1906). The Haeckelian tradition
  of deriving ethical norms from evolutionary naturalism is exactly the context
  in which Kautsky's own naturalistic ethics should be read.

  POSITION: Shows how Haeckelian monism produced an evolutionary ethics that
  could support socialist as well as other political conclusions, depending on
  which aspects of natural evolution were emphasized.
  },
  keywords = {Haeckel, monism, evolutionary-ethics, Schmidt, naturalism, socialism, Medium, INCOMPLETE, no-abstract}
}

@article{stack2000firstdarwinian,
  author = {Stack, D. A.},
  title = {The First Darwinian Left: Radical and Socialist Responses to Darwin, 1859--1914},
  journal = {History of Political Thought},
  year = {2000},
  volume = {21},
  number = {4},
  note = {
  CORE ARGUMENT: Stack surveys how radical and socialist thinkers from Alfred
  Russel Wallace to Ramsay MacDonald grappled with Darwinism in the period
  1859-1914. The article argues that socialist responses to Darwin were not
  simple adoption or rejection but involved selective appropriation of
  evolutionary concepts -- natural altruism, cooperative instincts,
  mutual aid -- that could support socialist rather than competitive-individualist
  conclusions. Stack distinguishes this "first Darwinian left" from the social
  Darwinist right by attending to which aspects of Darwin's theory each
  appropriated.

  RELEVANCE: Provides the comparative frame within which Kautsky's specific
  approach to Darwin can be assessed. By mapping the full range of
  socialist responses to Darwin in this period, Stack allows for a more
  precise characterization of what was distinctive about Kautsky's integration
  of evolutionary categories with Marxist social theory.

  POSITION: Argues for a specifically socialist or left-wing tradition of
  Darwinian appropriation distinct from and opposed to right-wing social
  Darwinism.
  },
  keywords = {Darwinism, socialism, Darwin-reception, left, evolution, socialist-Darwinism, Medium, INCOMPLETE, no-abstract}
}

@article{rowley2024marxism,
  author = {Rowley, David G.},
  title = {Marxism as a Natural Science: Alexander Bogdanov's Anti-Revisionist Revisionism},
  journal = {Historical Materialism},
  year = {2024},
  volume = {32},
  number = {2},
  pages = {265--294},
  doi = {10.1163/1569206x-bja10035},
  abstract = {Discussion of Alexander Bogdanov as a Marxist revisionist has largely centred on his philosophy of being and cognition and on Plekhanov's and Lenin's accusation that Bogdanov was an idealist renegade from Marxism. However, the real issue of revisionism at the time was not materialism but determinism: the question of whether socialism would appear by the working of the objective laws of nature or the subjective will of human beings. Bogdanov did indeed revise Marxism, but he did so in order to defend it as a natural science. He conceived of society as a form of life subject to biological laws of nature: the need to assimilate energy from the environment and the need to adapt to the environment in the struggle to survive. He reinterpreted the key elements of scientific socialism -- the idea that existence determines consciousness and the labour theory of value -- in terms of this worldview.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Rowley argues that Alexander Bogdanov's project -- treating
  Marxism as a natural science on Darwinian and positivist grounds -- represented
  not a deviation from orthodoxy but an alternative within the same naturalistic
  paradigm that defined Second International Marxism. Bogdanov's empirio-monism
  radicalized the naturalistic premises that Kautsky and Engels shared, pushing
  toward a fully unified scientific worldview. The article traces how Bogdanov's
  version of "Marxism as natural science" competed with and ultimately lost to
  Leninist and Kautskyan orthodoxy.

  RELEVANCE: Provides a comparative perspective on Kautsky's naturalism by
  examining a contemporary who took the same naturalistic premises further.
  Useful for understanding what distinguished Kautsky's specific form of
  evolutionary naturalism from other available options in Second International
  Marxism, including Bogdanov's more radical version.

  POSITION: Situates Kautsky within a broader naturalistic-scientific paradigm
  in Second International Marxism, with Bogdanov as the more radical variant.
  },
  keywords = {Bogdanov, Kautsky, Marxism-natural-science, Second-International, naturalism, evolution, Medium}
}

@article{lattansi2018societal,
  author = {Lattansi-Silveus, Luke},
  title = {Societal Selection and Historical Materialism},
  journal = {Science \& Society},
  year = {2018},
  volume = {82},
  number = {3},
  pages = {335--359},
  doi = {10.1521/siso.2018.82.3.335},
  abstract = {Charles Darwin's The Origin of Species was welcomed by Marx and Engels, who saw it as similar to their methodology, but applied to the natural world. Following G. A. Cohen's analytical reconstruction of historical materialism, and the difficulties of the rationalist underpinnings Cohen gives it, some authors have viewed this interest in Darwin as indicative that Marx and Engels understood historical materialism to operate in a manner akin to natural selection. In particular, the work of Alan Carling, which proposes that market and military competition selects for greater development of the means of production, is very promising in this regard. But such a selective mechanism is not sufficient to under-pin historical materialism, as some criticisms show. An analysis of imitation is necessary to bolster the theory. Furthermore, the means by which superior productive power translate into competitive advantage need to be expounded.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: The paper examines whether Cohen's analytical reconstruction
  of historical materialism can be grounded in a mechanism analogous to natural
  selection -- specifically, whether market and military competition among
  societies "selects" for greater productive development. Building on Alan
  Carling's work, Lattansi-Silveus argues that while such a selectional
  mechanism is necessary to underpin historical materialism, it is insufficient
  without an account of imitation that explains how superior productive
  power translates into competitive advantage.

  RELEVANCE: Directly addresses the philosophical question of whether Darwinian
  selection logic can be coherently applied to social evolution -- the same
  question Kautsky faced in integrating Darwin with historical materialism.
  The paper provides an analytical reconstruction of the problem that illuminates
  what precisely was at stake in Kautsky's evolutionary reading of historical
  development.

  POSITION: Takes seriously the possibility of a selectionist mechanism
  grounding historical materialism while identifying the conditions it would
  need to satisfy.
  },
  keywords = {historical-materialism, natural-selection, social-evolution, Cohen, analytical-Marxism, Low}
}

@book{tai2019pannekoek,
  editor = {Tai, Chaokang and van der Steen, Bart and van Dongen, Jeroen},
  title = {Anton Pannekoek: Ways of Viewing Science and Society},
  year = {2019},
  publisher = {Amsterdam University Press},
  doi = {10.2307/j.ctvp7d57c},
  abstract = {Anton Pannekoek (1873-1960), prominent astronomer and world-renowned socialist theorist, stood at the nexus of the revolutions in politics, science and the arts of the early twentieth century. His astronomy was uniquely visual and highly innovative, while his politics were radical. Anton Pannekoek: Ways of Viewing Science and Society collects essays on Pannekoek and his contemporaries at the crossroads of political history, the history of science and art history.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: This edited volume examines Anton Pannekoek's unique synthesis
  of astronomy, scientific socialism, and council communism, arguing that his
  approach to natural science was integral to his political philosophy. Several
  chapters address Pannekoek's conception of Marxism as a natural science --
  his view that historical materialism had the same epistemological standing as
  Darwinian biology -- and trace how this shaped his break from Kautsky and the
  SPD mainstream over the role of natural-scientific determinism in socialist
  politics.

  RELEVANCE: Pannekoek was both a Kautsky disciple and a sharp critic of
  Kautsky's evolutionary determinism; his trajectory from Kautskyan naturalism
  to council communism illuminates what was philosophically at stake in the
  debates over evolution and Marxism in the Second International. The volume
  is useful for comparative contextualization of Kautsky's position.

  POSITION: Situates Pannekoek's scientific socialism as a distinct alternative
  to Kautsky's evolutionary orthodoxy within the same naturalistic paradigm.
  },
  keywords = {Pannekoek, scientific-socialism, natural-science, council-communism, Kautsky, evolution, Medium}
}

@article{leslie2020engels,
  author = {Leslie, Christopher},
  title = {Revisiting Friedrich Engels's Dialectics of Nature in an Age of Digital Idealism},
  journal = {tripleC: Communication, Capitalism \& Critique},
  year = {2020},
  volume = {19},
  number = {1},
  pages = {78--96},
  doi = {10.31269/triplec.v19i1.1223},
  abstract = {The idealism that Friedrich Engels seeks to defeat in Dialectics of Nature today pervades online discourse and pedagogies of science, technology, engineering, and mathematics (STEM). The deterministic view that STEM is dedicated to unleashing the inherent power in objects for the service of privileged societies fails to understand the basic principles that Engels proposed. Engels exposes his contemporaries' flawed understanding of science and technology and provides interdisciplinary examples that exemplify a different way of thinking. This analysis suggests avenues of cooperation for international science studies. In addition, it provides a starting point for pedagogies to promote the development for science and technology that reduces inequality and supports the notion that the liberal arts have an important place in the study of science and engineering.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Leslie revisits Engels's Dialectics of Nature as a text that
  sought to ground Marxist historical materialism in a comprehensive philosophy
  of natural science, arguing that Engels's project of extending dialectical
  materialism to nature was the foundational move that licensed later thinkers
  like Kautsky to treat social evolution as continuous with natural evolution.
  The paper examines the legacy of Engels's naturalism for subsequent Marxist
  engagements with science and technology.

  RELEVANCE: Engels's Anti-Duhring and Dialectics of Nature were the direct
  intellectual source for Kautsky's naturalistic reading of historical
  materialism. Understanding Kautsky's evolutionary framework requires grasping
  what he inherited from Engels's project of grounding Marxism in a unified
  philosophy of nature. This paper provides a critical perspective on that
  inheritance.

  POSITION: Reads Engels's naturalistic project as foundational for the
  Second International's evolutionary determinism, including Kautsky's.
  },
  keywords = {Engels, dialectics-of-nature, Marxism, naturalism, evolution, materialism, Low}
}

@book{cohen1979karl,
  author = {Cohen, G. A.},
  title = {Karl Marx's Theory of History},
  year = {1979},
  publisher = {Princeton University Press},
  doi = {10.1515/9780691213002},
  note = {
  CORE ARGUMENT: Cohen reconstructs Marx's theory of history as a form of productive-forces determinism: the tendency of productive forces to develop explains the succession of modes of production, and the economic base explains the superstructure. This is the most rigorous analytic defense of the "technological determinist" reading of historical materialism, attributing to Marx a commitment to lawlike necessity in history.

  RELEVANCE: Establishes the philosophical benchmark against which Kautsky's own determinism must be assessed. Kautsky's reading of Marx (productive forces as the engine of history, socialism as historically necessitated) closely mirrors Cohen's reconstruction, and critics of "orthodox Marxism" often use Cohen's analysis as a proxy for the Second International position. Essential for understanding what philosophical commitments the fatalism and mechanism critiques are targeting.

  POSITION: Productive-forces determinism; analytic reconstruction of historical materialism.
  },
  keywords = {historical-materialism, productive-forces, determinism, analytic-Marxism, High},
  abstract = {First published in 1978, this book rapidly established itself as a classic of modern Marxism. In this expanded edition Cohen offers his own account of the history, and the further promise, of analytical Marxism. He also expresses reservations about traditional historical materialism, in the light of which he reconstructs the theory.},
  abstract_source = {openalex},
}

@article{cohen1986historical,
  author = {Cohen, G. A.},
  title = {Historical inevitability and human agency in {Marxism}},
  journal = {Proceedings of the Royal Society of London. A. Mathematical and Physical Sciences},
  year = {1986},
  volume = {407},
  number = {1832},
  pages = {65--87},
  doi = {10.1098/rspa.1986.0085},
  note = {
  CORE ARGUMENT: Cohen directly addresses the tension between historical inevitability in Marxism and the exercise of human agency. He argues that inevitability and agency are compatible: socialism is inevitable not despite human action but partly through it, since people's choices are themselves causally shaped by material conditions that tend to produce revolutionary agency. The paper probes how determinism in the strong sense can coexist with meaningful political will.

  RELEVANCE: This is the central philosophical problem of Kautsky's position: if socialism is inevitable, what motivates political action? Cohen provides the most precise analytic treatment of this question. The "conditional inevitability" view — socialism comes if people do what they are causally disposed to do — maps closely onto Kautsky's own stance that historical laws do not remove but rather explain revolutionary will.

  POSITION: Compatibilist reading of Marxist historical inevitability.
  },
  keywords = {determinism, agency, inevitability, Marxism, historical-materialism, High},
  abstract = {Abstract Marx and Engels believed that the advent of a socialist society was inevitable. How was that belief compatible with their advocacy of political activity to bring about socialism? I reply that Marx and Engels thought socialism was inevitable, not whatever people might do, but because of what people, being rational, were bound, predictably, to do. It is therefore no more irrational for Marxists to struggle for the goal they regard as inevitable than it is for an army of overwhelming strength to fight and thereby achieve its inevitable victory. That answer to the stated question raises problems about the relations among human rationality, human freedom, probability and predictability, which I proceed to explore. Because non-Marxist politicians often devote a lot of energy to the attempt to realize goals that they say are bound to come, the problems have a general interest that transcends the parochial Marxist context in which they most famously arise.},
  abstract_source = {openalex},
}

@article{honderich1982against,
  author = {Honderich, Ted},
  title = {Against teleological historical materialism},
  journal = {Inquiry},
  year = {1982},
  volume = {25},
  number = {4},
  pages = {451--469},
  doi = {10.1080/00201748208601980},
  note = {
  CORE ARGUMENT: Honderich argues that so-called teleological explanations in historical materialism (where present structures are explained by their future consequences) are in fact disguised causal claims. He contends that teleological interpretations of Marx conflict with the core materialist thesis that history is independent of human consciousness and will, and finds no textual evidence that Marx himself intended a teleological reading.

  RELEVANCE: Directly relevant to assessing whether Kautsky's version of historical materialism involves teleology in a philosophically problematic sense. The "inevitability of socialism" claim in Kautsky is precisely the kind of forward-looking necessity Honderich scrutinizes. His analytic framework helps distinguish legitimate causal-law claims from covert teleology.

  POSITION: Anti-teleological reading of historical materialism; naturalist causal-law interpretation.
  },
  keywords = {teleology, historical-materialism, determinism, Kautsky, Marxism, High},
  abstract = {Marx may be taken to hold that productive forces (e.g. the steam engine) explain productive relations (e.g. capitalism) more than the other way on, and that productive relations explain superstructures (e.g. the legal system) more than the other way on. There are no satisfactory standard causal understandings of these claims about explanatory primacy. That is, no standard causal understanding saves Marx from the traditional objection that relations very greatly affect forces, and superstructures very greatly affect relations. One satisfactorily articulated attempt to save Marx has been the attempt to understand the claims teleologically. Three such understandings can be distinguished, but they do not work. The first fails since it attempts to explain events by way of abstract objects. The second fails since it attempts to explain a thing by means of that thing. The third fails for a related reason. Each understanding also fails for another reason as fundamental. So‐called teleological explanations are in fact claims that standard causal explanations exist, which relevant explanations conflict with the ruling idea of Marx's philosophy, that history is somehow independent of men's consciousness and wills. There may be no evidence that Marx himself intended historical materialism to be understood teleologically. There may be evidence against.},
  abstract_source = {openalex},
}

@book{truper2015historical,
  editor = {Tr{\"u}per, Henning and Chakrabarty, Dipesh and Subrahmanyam, Sanjay},
  title = {Historical Teleologies in the Modern World},
  year = {2015},
  publisher = {Bloomsbury Publishing Plc},
  doi = {10.5040/9781474221108},
  note = {
  CORE ARGUMENT: An edited volume tracing how teleological conceptions of history — the view that history is goal-directed — proliferated, fragmented, and competed in Europe and globally throughout the 19th and into the 20th century. The volume situates socialist, nationalist, religious, and scientific teleologies in comparative perspective, tracking how the idea that history "had to" move in a certain direction structured political and intellectual life.

  RELEVANCE: Provides the broadest intellectual-historical context for Kautsky's conviction that socialism is the inevitable endpoint of historical development. Situating Kautsky within the wider culture of historical teleology in the late 19th century shows that his "scientific" claims about necessity were shaped by a general epistemic culture that naturalized teleological thinking. Also bears on the evolutionary Darwinian frameworks Kautsky employed.

  POSITION: Historical and comparative survey of teleological thinking; pluralist, non-Marxist framework.
  },
  keywords = {teleology, philosophy-of-history, Marxism, inevitability, Second-International, Medium},
  abstract = {<JATS1:p>Historical Teleologies in the Modern World tracks the fragmentation and proliferation of teleological understandings of history – the notion that history had to be explained as a goal-directed process – in Europe and beyond throughout the 19th and into the 20th century. Historical teleologies have profoundly informed a variety of other disciplines, including modern philosophy, natural history, literature, humanitarian and religious philanthropism, the political thought and practice of revolution, emancipation, imperialism, colonialism and anti-colonialism, the conceptualization of universal humankind, and the understanding of modernity in general.</JATS1:p> <JATS1:p>By exploring the extension and plurality of historical teleology, the essays in this volume revise the history of historicity in the modern period. Historical Teleologies in the Modern World casts doubt on the idea that a single, if powerful, conception of time could function as the unifying principle of all modern historicity, instead pursuing an investigation of the plurality of modern historicities and its underlying structures. By bringing together Western and non-Western histories, this book provides the first extended treatment of the idea of historical teleology. It will be of great value to students and scholars of modern global and intellectual history.</JATS1:p>},
  abstract_source = {openalex},
}

@book{bernstein1993preconditions,
  author = {Bernstein, Eduard},
  editor = {Tudor, Henry},
  title = {Eduard Bernstein: The Preconditions of Socialism},
  year = {1993},
  publisher = {Cambridge University Press},
  doi = {10.1017/cbo9780511802584},
  note = {
  CORE ARGUMENT: Bernstein's revisionist critique of orthodox Marxism (originally 1899) argues that Marx's economic predictions have not been borne out, that historical materialism is an inadequate guide because it is excessively deterministic, and that socialism must be grounded in Kantian ethics rather than scientific laws of development. Bernstein's neo-Kantian turn introduces a normative "ought" that cannot be derived from empirical historical laws, directly challenging Kautsky's claim that socialist inevitability provides sufficient motivation for political action.

  RELEVANCE: The primary text of the revisionist challenge to Kautsky's philosophy of history. Bernstein's insistence on the is/ought distinction and the need for independent ethical foundations for socialism is the central neo-Kantian challenge that Kautsky had to answer in "Ethics and the Materialist Conception of History" (1906). Essential for understanding the philosophical debate.

  POSITION: Neo-Kantian revisionism; ethical socialism as distinct from scientific determinism.
  },
  keywords = {Bernstein, revisionism, neo-Kantianism, determinism, socialism, ethics, High},
  abstract = {This 1993 book was the first complete new translation of Bernstein's famous and influential work. It will provide students with an accurate and unabridged edition of the classic defence of democratic socialism and the first significant critique of revolutionary Marxism from within the socialist movement. First published in 1899, at the height of the Revisionist Debate, it argued that capitalism was not heading for the major crisis predicted by Marx, and that socialism could be achieved by piece-meal reform within a democratic constitutional framework. Bernstein's work is the focal point of one of the most important political debates of modern times, and crucial for the light it casts on 'the crisis of Communism'. The introduction sites Bernstein's work in its historical and intellectual context, and this edition also provides students with all the necessary reference material for understanding this important text.},
  abstract_source = {openalex},
}

@book{widmer2023left,
  author = {Widmer, Elisabeth Theresia},
  title = {Left-{Kantianism} in the Marburg School},
  year = {2023},
  publisher = {De Gruyter},
  doi = {10.1515/9783111331843},
  note = {
  CORE ARGUMENT: Widmer analyzes the variety of socialist appropriations of Kant within the Marburg school (Friedrich Albert Lange, Hermann Cohen, Karl Vorländer, Paul Natorp), arguing against the view that this was a coherent unified position. Instead, she identifies "left-Kantianism" as an open, contested cluster of approaches that differed significantly on the relationship between scientific knowledge and ethical normativity, and on how to relate Kant's philosophy to Marxist theory.

  RELEVANCE: The Marburg school's left-Kantians were direct interlocutors in the debate over whether Kautsky's scientific socialism could provide an adequate ethical foundation, or whether a neo-Kantian supplement was required. Widmer's fine-grained account shows the actual diversity of the challenge Kautsky faced, which was not a single unified neo-Kantian position but a spectrum of views.

  POSITION: Historical reconstruction of the Marburg school's engagements with socialism; pluralist rather than pro-Kautsky.
  },
  keywords = {neo-Kantianism, Marburg-school, socialism, ethics, determinism, Second-International, High},
  abstract = {Widmer sheds light on a neglected aspect of the Western philosophical tradition. Following an era of Hegelianism, the members of the neo-Kantian "Marburg School," such as Friedrich Albert Lange, Hermann Cohen, Rudolf Stammler, Paul Natorp, and Ernst Cassirer defended socialism or left-wing ideals on Kantian principles. In doing so, Widmer breaks with two mistaken assumptions. First, Widmer demonstrates that the left-Hegelian and Marxist traditions were not the only significant philosophical sources of socialist critique in nineteenth-century Germany, as the left-Kantians identified problems of normativity that the left-Hegelians could not adequately address. Second, Widmer challenges the prevailing assumption that the political philosophies developed in the Marburg School can be comprehensively characterized as a unified school of "ethical socialism." By showing that they varied fundamentally regarding their political views and their philosophical foundations of socialism, Widmer fills a gap in the studies of neo-Kantianism that is long overdue.},
  abstract_source = {openalex},
}

@article{beiser2009normativity,
  author = {Beiser, Frederick C.},
  title = {Normativity in {Neo-Kantianism}: Its Rise and Fall},
  journal = {International Journal of Philosophical Studies},
  year = {2009},
  volume = {17},
  number = {1},
  pages = {9--27},
  doi = {10.1080/09672550802610941},
  note = {
  CORE ARGUMENT: Beiser traces how the Southwestern Neo-Kantian school (Windelband, Rickert, Lask) made normativity — the distinction between facts and values, the "is" and the "ought" — central to epistemology, ethics, and the interpretation of German idealism. He traces both the rise and the eventual philosophical difficulties of this normativity concept.

  RELEVANCE: The normativity concept was the key philosophical weapon that neo-Kantian critics of Kautsky deployed: if facts and values are categorically distinct, then no historical-scientific account of capitalism's trajectory can by itself justify socialism as a goal. This article provides the philosophical background for understanding why the neo-Kantian challenge had such force, and what Kautsky was contending with.

  POSITION: Historical reconstruction and analysis of the normativity concept in Neo-Kantianism.
  },
  keywords = {neo-Kantianism, normativity, ethics, Marburg-school, Southwestern-school, Medium},
  abstract = {Abstract This article discusses the historical background to the concept of normativity which has a wide use in contemporary philosophy. It locates the origin of that concept in the Southwestern Neo‐Kantian school, the writings of Windelband, Rickert and Lask. The Southwestern school made the concept of normativity central to epistemology, ethics and the interpretation of German idealism. It was their solution to the threats of psycologism and historicism. However, Windelband, Rickert and Lask found difficulties with the concept which eventually forced them to abandon it. These difficulties might be of interest to contemporary philosophers who find the concept of normativity appealing.},
  abstract_source = {openalex},
}

@article{widmer2024cohen,
  author = {Widmer, Elisabeth Theresia},
  title = {Hermann {Cohen's} {Neo-Kantian} Ethical Socialism},
  journal = {Kantian Review},
  year = {2024},
  volume = {29},
  number = {4},
  pages = {607--628},
  doi = {10.1017/s1369415424000396},
  note = {
  CORE ARGUMENT: Widmer examines Hermann Cohen's ethical socialism — the view that Kantian ethics provides an independent foundation for democratic socialism that does not depend on materialist historical laws. Cohen distinguishes scientific knowledge of historical development from the normative demand for a just social order, arguing that the latter requires a Kantian grounding in universal rational autonomy.

  RELEVANCE: Cohen's position represents the strongest philosophical formulation of the challenge to Kautsky from within neo-Kantianism. Where Bernstein was primarily a political economist, Cohen engages at the level of systematic philosophy, showing why the gap between "is" and "ought" cannot be bridged by any science of history — including Kautsky's materialist conception.

  POSITION: Defense of Cohen's neo-Kantian ethical socialism; critical of purely scientific socialism.
  },
  keywords = {Cohen, neo-Kantianism, ethical-socialism, normativity, Marburg-school, Medium},
  abstract = {
  abstract_source = {s2},
 Hermann Cohen, the founding father of Marburg neo-Kantianism, is known for criticising capitalism from a Kantian ethical perspective. Thus far, the role of the notion of humanity in this critique has been viewed as grounding what I shall call the ‘purposive labour reading’. This reading takes Cohen’s primary interest to lie in a reorganisation of work so that our humanity, which requires us to be treated as ends, remains intact. With the aim to better understand the relevant notion of humanity, I contextualise the discussion within the overall framework of Cohens’ neo-Kantian account of ethical cognition and situate his ideas in the context of his contemporary interlocutors. Revisiting Cohen’s remarks on socialism and capitalism against this backdrop reveals that his discussion of labour serves as an exemplar, showcasing how ethical rationality manifests in the liberal socialists’ demands. I argue that his primary aim was not to prepare the ground for a prescriptive labour theory – though this is likely to follow – but to argue for a framework alternative to historical materialism, allowing us to perceive and interpret social practices in an ethical light.},
}

@book{cohen_berlin1955historical,
  author = {Berlin, Isaiah},
  title = {Historical Inevitability},
  year = {1955},
  publisher = {Oxford University Press},
  note = {
  CORE ARGUMENT: Berlin's Auguste Comte Memorial Lecture attacks the doctrine of historical inevitability — the view that human history follows a necessary pattern determined by economic, psychological, or cosmic forces. He argues that this doctrine, shared by Marxists and other historicists, undermines moral responsibility and the grounds for praising or blaming historical actors, because it treats human choices as determined outputs of impersonal laws.

  RELEVANCE: The clearest liberal-pluralist attack on the type of historical determinism that underpins Kautsky's system. Berlin's target includes the Marxist tradition's claim to "scientific" knowledge of history's necessary trajectory. His arguments provide a foil for understanding what Kautsky's defenders must answer, and why the "inevitability" claim is philosophically loaded.

  POSITION: Liberal-pluralist anti-determinism; critique of historical inevitability on grounds of moral responsibility.
  },
  keywords = {Berlin, historical-inevitability, determinism, free-will, agency, Medium},
  abstract = {GUL copy owned by Charles E. Wyzanski, Jr. (1906-1986), U.S. District Judge (D. Mass) (1941-1986); GUL copy annotated by Judge WyzanskiDelivered on 12 May 1953 at the London School of Economics and Political Scienc},
  abstract_source = {core},
}

@article{suchting1972marx,
  author = {Suchting, W. A.},
  title = {Marx, {Popper}, and `{Historicism}'},
  journal = {Inquiry},
  year = {1972},
  volume = {15},
  number = {1-4},
  pages = {235--266},
  doi = {10.1080/00201747208601662},
  note = {
  CORE ARGUMENT: Suchting distinguishes two types of laws of historical development (universal laws of succession vs. tendential laws) and argues that Popper's arguments against historicism fail against both. He then offers a careful analysis of four models of historical determinism and asks which is most plausible to ascribe to Marx, concluding that Marx's commitment to historical laws is more nuanced than either Popperian critics or orthodox defenders acknowledge.

  RELEVANCE: Provides a conceptual toolkit for distinguishing what kind of historical "laws" or "necessities" Kautsky invokes: are they universal, tendential, probabilistic, or teleological? This analytic precision is essential for assessing whether Kautsky's philosophy of history falls to Popperian critiques and what philosophical resources it has.

  POSITION: Analytic defense of Marx's historical laws against Popperian historicism critique.
  },
  keywords = {historical-laws, determinism, Popper, historicism, Marxism, Medium},
  abstract = {According to Sir Karl Popper, there is a harmful approach to the social sciences called ‘historicism’. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.},
  abstract_source = {openalex},
}

@book{steger1997quest,
  author    = {Steger, Manfred B.},
  title     = {The Quest for Evolutionary Socialism: Eduard Bernstein and Social Democracy},
  year      = {1997},
  publisher = {Cambridge University Press},
  doi       = {10.1017/cbo9780511558603},
  note      = {
  CORE ARGUMENT: Steger reconstructs Bernstein's intellectual development as a
  deliberate philosophical project to replace Marxian historical materialism
  with an open-ended, neo-Kantian evolutionary framework. Bernstein is shown
  to have rejected the Zusammenbruchstheorie not primarily on empirical grounds
  but on philosophical ones: the idea of historical necessity was incompatible
  with the normative, voluntarist dimension of socialist politics. Steger
  traces the influence of British Fabianism, neo-Kantian ethics (Cohen,
  Natorp), and Spencer's social evolutionism on Bernstein's mature thought.

  RELEVANCE: Provides the most detailed English-language account of the
  philosophical foundations of the revisionist challenge to Kautsky. Essential
  for understanding what Kautsky was defending when he insisted on the
  'scientific' status of historical materialism: Bernstein was not merely
  revising tactical conclusions but rejecting the deterministic philosophy
  of history that underlay them. The contrast with Kautsky's own
  Darwinian-naturalist evolutionism is philosophically clarifying.

  POSITION: Revisionist/Bersteinian gradualism -- normative philosophy of
  history displacing structural necessity.
  },
  keywords  = {Bernstein, evolutionary-socialism, neo-Kantianism, revisionism, High},
  abstract = {The Quest for Evolutionary Socialism uses Eduard Bernstein's life and works as the basis for an examination of the interactions between European social democratic politics and socialist political ideas. It is thus a timely response to the need for a new, comprehensive biography of Bernstein, the German 'Father of Marxist Revisionism'. Professor Steger incorporates recent academic developments and addresses current debates on the 'End of Socialism' resulting from the collapse of Marxism-Leninism and the chronic ailments of European social democracy. This study is set within the historical context of the European labour movement and thus Steger interprets Bernstein's 'Evolutionary Socialism' as an ethically motivated quest for liberty, solidarity and distributive justice. Steger stresses that the future of social democracy depends on its ability to heed Bernstein's call for critical self-reflection and to reorientate towards more liberal ideals},
  abstract_source = {openalex},
}

@book{lih2006lenin,
  author = {Lih, Lars T.},
  title = {Lenin Rediscovered},
  year = {2006},
  publisher = {BRILL},
  doi = {10.1163/9789047417873},
  note = {
  CORE ARGUMENT: Lih's major scholarly work argues that Lenin's "What Is to Be Done?" has been systematically misread; properly understood, it is a Kautskyite document that reproduces Kautsky's own argument about the relationship between the socialist intelligentsia and the working class. Lih extensively reconstructs Kautsky's "erfurtian synthesis" — the unified system of historical inevitability, party organization, and socialist consciousness.

  RELEVANCE: While primarily about Lenin, this book provides the most detailed reconstruction of what Lih calls Kautsky's "heroic Marxism" and its theory of historical necessity: socialism is inevitable, the movement is destined to succeed, and the task of the party is to make workers conscious of what history demands of them. Lih shows how Kautsky's determinism generates rather than undermines political will.

  POSITION: Revisionist rehabilitation of Kautsky's orthodoxy as the dominant framework of Second International Marxism.
  },
  keywords = {Kautsky, Lenin, Second-International, historical-necessity, erfurtian-synthesis, agency, Medium},
  abstract = {Lenin’s What is to Be Done? (1902) has long been seen as the founding document of a 'party of a new type'. For some, it provided a model of ‘vanguard party’ that was the essence of Bolshevism, for others it manifested Lenin’s élitist and manipulatory attitude towards the workers. This substantial new commentary, based on contemporary Russian- and German-language sources, provides hitherto unavailable contextual information that undermines these views and shows how Lenin's argument rests squarely on an optimistic confidence in the workers' revolutionary inclinations and on his admiration of German Social Democracy in particular. Lenin's outlook cannot be understood, Lih claims here, outside the context of international Social Democracy, the disputes within Russian Social Democracy and the institutions of the revolutionary underground. The new translation focuses attention on hard-to-translate key terms. This study raises new and unsettling questions about the legacy of Marx, Bolshevism as a historical force, and the course of Soviet history, but, most of all, it will revolutionise the conventional interpretations of Lenin.},
  abstract_source = {openalex},
}

@article{blackledge2006trotsky,
  author = {Blackledge, Paul},
  title = {Leon Trotsky's Contribution to the Marxist Theory of History},
  journal = {Studies in East European Thought},
  year = {2006},
  volume = {58},
  number = {1},
  pages = {1--31},
  doi = {10.1007/s11212-005-3677-z},
  note = {
  CORE ARGUMENT: Blackledge argues that Trotsky's theory of uneven and
  combined development was a creative response to and implicit critique of
  the mechanical evolutionism of the Kautskyan model; where Kautsky posited
  a unilinear stage-sequence through which all societies must pass, Trotsky
  theorized the specific combination of "archaic" and "advanced" forms in
  late-developing capitalism. The article traces how Trotsky drew on and
  departed from Kautsky's framework.

  RELEVANCE: Illuminates the internal critique of Kautsky's philosophy of
  history from within the revolutionary Marxist tradition; shows what
  contemporaries identified as the theoretical limitations of his
