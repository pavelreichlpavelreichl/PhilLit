@article{melrose2016agents,
  author  = {Melrose, Jamie},
  title   = {Agents of Knowledge: Marxist Identity Politics in the {Revisionismusstreit}},
  journal = {History of European Ideas},
  year    = {2016},
  volume  = {42},
  number  = {8},
  pages   = {1069--1088},
  doi     = {10.1080/01916599.2016.1182043},
  note    = {
  CORE ARGUMENT: Melrose analyses the Revisionismusstreit not primarily as a
  theoretical dispute but as a contest over epistemic authority and Marxist
  identity. The article shows how claims to 'orthodox' knowledge of Marx's
  thought functioned as identity markers within the SPD, with both Kautsky
  and Bernstein positioning themselves as authentic interpreters of Marx in
  order to legitimate their political conclusions.

  RELEVANCE: Offers a sociology-of-knowledge perspective on the debate that
  complements philosophical analysis: the orthodoxy/revisionism split was not
  purely about philosophical or empirical truth but about who had the authority
  to determine what Marxism meant. This illuminates why Kautsky's response to
  Bernstein was so concerned with questions of method and scientific standing
  rather than simply political expediency.

  POSITION: Post-revisionist historiography -- epistemic identity politics in
  the debate.
  },
  keywords  = {revisionism, identity-politics, orthodoxy, epistemology, Second-International, Medium},
  abstract = {SUMMARYTo be Marxist at the turn of the twentieth century was highly contested. During this crisis of Marxism, identity politics were acute, exemplified by the private and public debate between Eduard Bernstein and Karl Kautsky. With Bernstein's celebrated turn away from the Marxist theory of his day, the grounds for being Marxist were at stake. Was it possible to criticise Marx's analysis of industrial capitalism, his account of historical change and his hard-nosed class politics, and yet still be in a position to carry his name forward? Moreover, the springing-up of another identity, Revisionist, suggested that being Marxist was ambiguous. If one accepted Bernstein's and the Revisionists' point that Marxists had become too orthodox, leaving Revisionists as the true heirs of Marx's critical socialist spirit, then the Marxist identity was so open as to be meaningless. In this article, I contend that the name-calling of this period, the Revisionismusstreit, should be seen as creative. In contrast to politico-ideological perceptions of the Streit, which construe the clash of Marxist and Revisionist as representative of foundational Social Democratic party political realities, I highlight the manner in which being Marxist—the veneration of Marx's and Friedrich Engels's word into a Marxology of sorts by Marxists and Revisionists alike—held a certain epistemic value in its own right.},
  abstract_source = {openalex},
}

@article{vanree2012german,
  author  = {van Ree, Erik},
  title   = {German Marxism and the Decline of the Permanent Revolution, 1870--1909},
  journal = {History of European Ideas},
  year    = {2012},
  volume  = {38},
  number  = {4},
  pages   = {570--589},
  doi     = {10.1080/01916599.2011.652474},
  note    = {
  CORE ARGUMENT: Van Ree argues that the evolution of German Social Democratic
  strategy from 'permanent revolution' to parliamentary gradualism reflected
  a deeper shift in how Kautsky and Engels conceptualised the proletarian
  revolution: under parliamentary conditions, 'revolution' was redefined as
  the conquest of governmental power through elections rather than insurrection.
  This transformation, traced from 1875 to 1909, helps explain the strategic
  ambiguity of Kautsky's response to revisionism: he defended revolutionary
  goals while conceding reformist means.

  RELEVANCE: Illuminates the political-historical context for Kautsky's
  philosophy of history by showing how his conception of revolution was already
  partly 'evolutionary' before the revisionism debate. This complicates the
  orthodox/revisionist binary and helps explain why Kautsky's Road to Power
  was read so differently in Germany and Russia.

  POSITION: Post-revisionist historiography -- the dissolution of revolutionary
  strategy under parliamentary conditions.
  },
  keywords  = {Kautsky, revolution, parliamentary-socialism, permanent-revolution, SPD, Medium},
  abstract = {This article discusses the development of German Social Democratic Party strategy in the fourth quarter of the nineteenth century and the first decade of the twentieth, as a result of the works of Friedrich Engels and Karl Kautsky. It ties the evolution of Marxist orthodoxy to the emergence of parliamentary democracy in different European societies. In particular, it discusses the way parliamentary conditions impacted on how the proletarian revolution was imagined. Revolution was newly defined as the establishment through parliamentary means of a new government representing a new social class. Also, the early Marxist strategy of ‘permanent revolution’, which had allowed proletarian-socialist minority rule, was abandoned.<br/>},
  abstract_source = {openalex},
}

@article{dale2014iron,
  author  = {Dale, Gareth},
  title   = {The Iron Law of Democratic Socialism: British and Austrian Influences on the Young Karl Polanyi},
  journal = {Economy and Society},
  year    = {2014},
  volume  = {43},
  number  = {4},
  pages   = {650--667},
  doi     = {10.1080/03085147.2014.898821},
  note    = {
  CORE ARGUMENT: Dale examines how Bernstein's evolutionary socialism and
  Austro-Marxism shaped Karl Polanyi's political thought, arguing that
  Bernstein's 'revision' and Austro-Marxism shared a paradox: they repudiated
  economic determinism in favour of ethical autonomy, yet simultaneously
  incorporated a quasi-fatalistic determinism about democratisation. This
  internal tension in revisionist thought -- escaping one form of necessity
  only to embrace another -- reveals a structural problem in any philosophy
  of history that tries to combine ethical voluntarism with evolutionary law.

  RELEVANCE: Provides a broader intellectual-historical perspective on the
  philosophical stakes of Bernstein's evolutionary socialism, showing that
  the revisionist attempt to ethicise historical development did not escape
  the problem of historical necessity but only displaced it. Relevant to
  Kautsky's philosophy of history because it shows the instability of the
  revisionist alternative.

  POSITION: Post-revisionist historiography -- philosophical tensions within
  evolutionary-socialist philosophy of history.
  },
  keywords  = {Bernstein, evolutionary-socialism, Austro-Marxism, determinism, philosophy-of-history, Medium},
  abstract = {Abstract A central thesis of Karl Polanyi's The great transformation concerns the tensions between capitalism and democracy: the former embodies the principle of inequality, while democracy represents that of equality. This paper explores the intellectual heritage of this thesis, in the ‘functional theory’ of G.D.H. Cole and Otto Bauer and in the writings of Eduard Bernstein. It scrutinizes Polanyi's relationship with Bernstein's ‘evolutionary socialism’ and charts his ‘double movement’ vis-à-vis Marxist philosophy: in the 1910s he reacted sharply against Marxism's deterministic excesses, but he then, in the 1920s, engaged in sympathetic dialogue with Austro-Marxist thinkers. The latter, like Bernstein, disavowed economic determinism and insisted upon the importance and autonomy of ethics. Yet they simultaneously predicted a law-like expansion of democracy from the political to the economic arena. Analysis of this contradiction provides the basis for a concluding discussion that reconsiders the deterministic threads in Polanyi's oeuvre. Whereas for some Polanyi scholars these attest to his residual attraction to Marxism, I argue that matters are more complex. While Polanyi did repudiate the more rigidly deterministic of currents in Marxist philosophy, those to which he was attracted, notably Bernstein's ‘revision’ and Austro-Marxism, incorporated a deterministic fatalism of their own, in respect of democratization. Herein lies a more convincing explanation of Polanyi's incomplete escape from a deterministic philosophy of history, as exemplified in his masterwork, The great transformation.},
  abstract_source = {s2},
}

@article{bartels2025testing,
  author  = {Bartels, Charlotte and Kersting, Felix and Wolf, Nikolaus},
  title   = {Testing Marx: Capital Accumulation, Income Inequality, and Socialism in Late Nineteenth-Century {Germany}},
  journal = {Review of Economics and Statistics},
  year    = {2025},
  volume  = {107},
  number  = {4},
  pages   = {935--950},
  doi     = {10.1162/rest_a_01305},
  note    = {
  CORE ARGUMENT: Using new panel data for Prussian regions up to 1914,
  Bartels, Kersting, and Wolf empirically evaluate the competing claims of
  the revisionism debate. They find that capital accumulation did lead to
  increased capital share and income inequality (consistent with orthodox
  Marxist prediction), but did not produce further capital concentration or
  increased socialist voting (consistent with Bernstein's critique). Trade
  unions and strikes limited inequality and fostered socialist political
  support, as revisionists argued.

  RELEVANCE: Provides the most rigorous empirical assessment of the economic
  predictions that underlay the philosophical-historical dispute. For a
  philosophy-of-history project, this tests whether the empirical/predictive
  claims that Kautsky treated as grounded in historical necessity were in
  fact borne out, illuminating the relationship between philosophical
  necessity-claims and contingent economic tendencies in his historiosophy.

  POSITION: Post-revisionist historiography -- empirical assessment of the
  economic claims underlying the debate.
  },
  keywords  = {Bernstein, Kautsky, revisionism, capitalism-collapse, empirical, Medium},
  abstract = {
  abstract_source = {s2},
 We study the dynamics of capital accumulation, income inequality, capital concentration, and voting up to 1914. Based on new panel data for Prussian regions, we re-evaluate the famous Revisionism Debate between orthodox Marxists and their critics. We show that changes in capital accumulation led to a rise in the capital share and income inequality, as predicted by orthodox Marxists. But against their predictions, this did neither lead to further capital concentration nor to more votes for the socialists. Instead, trade unions and strike activity limited income inequality and fostered political support for socialism, as argued by the Revisionists.},
}

