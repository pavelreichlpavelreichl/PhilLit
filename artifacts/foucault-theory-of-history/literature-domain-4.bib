@article{megill1990ambiguity,
    author = "Megill, Allan",
    title = "Foucault, Ambiguity, and the Rhetoric of Historiography",
    journal = "History of the Human Sciences",
    year = "1990",
    note = {CORE ARGUMENT: Megill argues that Foucault's histories are constitutively ambiguous between straightforward empirical historiography and a rhetorically driven, philosophically motivated genre, and that this ambiguity is not a defect to be resolved but a structural feature of how Foucault's texts operate on readers - alternately inviting and refusing normal historiographical scrutiny. RELEVANCE: Offers a framework, widely cited in later reception debates, for explaining why historians and philosophers talk past each other when arguing about Foucault's "accuracy": the two camps are implicitly applying different genre expectations to the same texts. Directly addresses this domain's question of whether archaeology/genealogy is usable historical method or imported philosophy. POSITION: Rhetorical/genre-reclassification reading; treats the "was Foucault a historian" dispute as partly a category error.},
    keywords = "historiography, rhetoric, reception, method, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{windschuttle1998foucaulthistorian,
    author = "Windschuttle, Keith",
    title = "Foucault as Historian",
    year = "1998",
    note = {CORE ARGUMENT: Windschuttle mounts a sustained empirical prosecution of Foucault's historical practice, arguing that across Madness and Civilization, Discipline and Punish, and The History of Sexuality Foucault repeatedly misrepresented, selectively quoted, or simply invented evidence to fit a predetermined thesis about power and exclusion, and that professional historians who have adopted Foucauldian method have imported these errors uncritically. RELEVANCE: The most uncompromising empirical-accuracy critique found in this domain; provides the concrete, itemized objections (chronology of confinement, treatment of sources, selective citation) that the research idea's "were his histories accurate?" question specifically asks for. Later expanded into Windschuttle's broader polemic against postmodern historiography in The Killing of History. POSITION: Empirical/archival rejection; represents the harshest pole of historian reception, explicitly denying Foucault standing as a historian.},
    keywords = "historiography, empirical-accuracy, madness, discipline-and-punish, critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@article{scull1990foucaultmadness,
    author = "Scull, Andrew",
    title = "Michel Foucault's History of Madness",
    journal = "History of the Human Sciences",
    year = "1990",
    note = {CORE ARGUMENT: Scull, a historian of psychiatry, revisits Histoire de la folie on the occasion of renewed English-language debate and argues that Foucault's account of a unitary "Great Confinement" and his romanticized opposition of madness to reason do not survive confrontation with the archival and comparative evidence historians of the asylum have since assembled, even as the book's rhetorical and conceptual force helped create the field of the history of psychiatry as it now exists. RELEVANCE: A leading historian of madness/psychiatry assessing Foucault's founding text from inside the discipline it helped create; central to the "empirical accuracy" controversy and to the appropriation/rejection tension this domain tracks. POSITION: Empirical/archival rejection combined with acknowledgment of field-founding influence; a historian's mixed verdict rather than wholesale dismissal.},
    keywords = "madness, history-of-psychiatry, empirical-accuracy, reception, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages, doi"
}

@article{lacapra1990foucaulthistorymadness,
    author = "LaCapra, Dominick",
    title = "Foucault, History, and Madness",
    journal = "History of the Human Sciences",
    year = "1990",
    note = {CORE ARGUMENT: LaCapra, an intellectual historian, defends a more sympathetic reading of Foucault's history of madness against purely empiricist objections, arguing that Foucault's text operates simultaneously as documentary history and as a self-consciously "excessive" or transgressive form of writing that deliberately unsettles standard historiographical protocols, and that judging it solely by archival-accuracy criteria misses this dual character. RELEVANCE: Represents the intellectual-historian counterweight to Windschuttle- and Scull-style empirical prosecution within the same 1990 special issue, illustrating the split among professional historians themselves over whether archaeology/genealogy should be judged as history or as a hybrid historical-philosophical genre. POSITION: Selective appropriation / genre-reclassification; a historian of ideas defending Foucault's method against strict empiricist standards. METADATA NOTE: The author name is truncated in both CrossRef and Semantic Scholar source metadata to "Dominick L."; a corroborating OpenAlex author record for this article lists an institutional affiliation of Cornell University, consistent with the intellectual historian Dominick LaCapra, but this attribution is flagged here for transparency rather than silently corrected.},
    keywords = "madness, intellectual-history, reception, method, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages, doi"
}

