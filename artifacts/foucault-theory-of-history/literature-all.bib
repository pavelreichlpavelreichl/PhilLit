@article{irrera2024actualitephilosophy,
  author = {Irrera, Orazio},
  title = {The Actualité of Philosophy and its History: Michel Foucault's Legacy on a Philosophy of the Present},
  journal = {Foucault Studies},
  year = {2024},
  volume = {36},
  number = {1},
  pages = {55--72},
  doi = {10.22439/fs.i36.7234},
  note = {
  CORE ARGUMENT: Irrera argues that Foucault's late conception of philosophy as an ontology of the present or actualité cannot be fully understood without tracing it back to his reflections on the status of philosophical discourse from the mid-1960s onward, and uses the recently published Le Discours philosophique to show how actualité was already shaping an archaeological framework for treating philosophy itself as an object of historicization well before the explicitly genealogical "history of the present" texts.
  RELEVANCE: Demonstrates that Foucault's history-of-the-present legacy continues to generate new interpretive work as previously unpublished material becomes available, directly relevant to this domain's question of what recent scholarship identifies as Foucault's enduring contribution to historiographical theory.
  POSITION: Archival-genetic reconstruction of continuity between Foucault's early archaeological and late genealogical/ethical periods via the concept of actualité, against readings that treat the "history of the present" as a late, discontinuous turn.
  },
  keywords = {history-of-the-present, actualite, legacy, archaeology, continuity, High},
  abstract = {From the late 1970s, and particularly in the last years of his life, Michel Foucault repeatedly returned to the status of philosophical reflection as an ontology of the present, of actualité, or an ontology of ourselves. However, the impact of these famous theoretical syntagms around a philosophy of the present or of actualité – one of Foucault's most precious legacies 40 years after his death – is not fully intelligible without considering that they were already at the heart of Foucault's reflections on the status of philosophy from the mid-1960s onwards. Today, with the recent publication of the essay Le Discours philosophique, we can better understand how the concept of actualité shaped, within an archaeological framework of analysis, the highly complex elaboration of the status of philosophy as a discourse aimed at providing a diagnosis of our actualité. The theoretical density of this latter term reveals a rich panorama of philosophical references (sometimes explicit, sometimes more implicit) that are essential for grasping both the historical-conceptual stakes of this term and the way in which it is, for the first time, inscribed at the heart of the status of philosophy, giving rise also to the very possibility of making it an object of historicization that at the time was still only archaeological. The aim of this contribution is to show how Le Discours philosophique broadens our understanding of what Foucault would later take up in a wider horizon of analysis, in which actualité would mark a renewed space of historical analysis of the contingent relationship between philosophy and its present, by redefining philosophical reflection as a practico-reflexive mode that Foucault will designate as “attitude” (and “critical attitude”).},
  abstract_source = {openalex},
}

@article{geuss2002genealogyascritique,
  author = {Geuss, Raymond},
  title = {Genealogy as Critique},
  journal = {European Journal of Philosophy},
  year = {2002},
  volume = {10},
  number = {2},
  pages = {209--215},
  doi = {10.1111/1468-0378.00157},
  note = {
  CORE ARGUMENT: Geuss examines what it would take for a genealogical account of a concept, practice, or institution's historical emergence to also function as a critique of it, distinguishing merely explanatory genealogies from genealogies that carry normative, debunking force.
  RELEVANCE: Sets much of the vocabulary and the central problem (does tracing a contingent history automatically undermine a practice's authority?) that later contributors to this domain's genealogy-as-critique cluster (Koopman and Matza, Allen, Harcourt, Lorenzini) explicitly take up and contest.
  POSITION: Skeptical/clarificatory position questioning whether genealogy alone, without additional normative argument, suffices as critique - a foil against which later, more affirmative accounts of genealogy's critical power are typically framed.
  },
  keywords = {genealogy, critique, normativity, foundational, High, INCOMPLETE, no-abstract}
}

@article{koopmanmatza2013puttingfoucaulttowork,
  author = {Koopman, Colin and Matza, Tomas},
  title = {Putting Foucault to Work: Analytic and Concept in Foucaultian Inquiry},
  journal = {Critical Inquiry},
  year = {2013},
  volume = {39},
  number = {4},
  pages = {817--840},
  doi = {10.1086/671357},
  note = {
  CORE ARGUMENT: Koopman and Matza distinguish between using Foucault's substantive concepts (power, discipline, biopolitics) and using his analytics (the methodological orientations of archaeology, genealogy, and problematization), arguing that scholars across the humanities and social sciences have far more often imported Foucauldian concepts wholesale than genuinely practiced his analytics, and that this has produced diminishing methodological returns.
  RELEVANCE: Offers a direct diagnosis of how genealogy as a live method has actually traveled across disciplines since Foucault, addressing this domain's question about genealogy's extension into other fields and providing a critical vocabulary (concept versus analytic) for evaluating whether later appropriations remain genuinely Foucauldian.
  POSITION: Methodological-reformist position urging a return to Foucault's analytics over his concepts; implicitly critiques much "Foucauldian" scholarship for methodological superficiality.
  },
  keywords = {genealogy, method, analytics, reception, interdisciplinary, High},
  abstract = {Is there a single area of intellectual inquiry in the humanities and social sciences where the work of Michel Foucault is not taken seriously? Discipline, biopolitics, governmentality, power/knowledge, subjectivation, genealogy, archaeology, problematization-these are just a few of the many Foucaultisms that have been adopted in fields such as philosophy, sociology, cultural anthropology, political science, history, literary studies, area studies, and much else besides. Just a short list of the forms of Foucault's influence would necessarily include certain of his philosophical commitments, methodological strategies, discursive resources, and materials for reflection.},
  abstract_source = {openalex},
}

@article{allen2014normativetranscendental,
  author = {Allen, Amy},
  title = {The Normative and the Transcendental: Comments on Colin Koopman's Genealogy as Critique},
  journal = {Foucault Studies},
  year = {2014},
  pages = {238--244},
  doi = {10.22439/fs.v0i18.4662},
  note = {
  CORE ARGUMENT: Allen's commentary on Koopman's Genealogy as Critique (covered in Domain 2) presses Koopman on whether his account of genealogy's transformative, problematizing function can secure genuinely normative purchase without covertly relying on transcendental or quasi-foundational commitments that genealogy is supposed to avoid.
  RELEVANCE: Exemplifies the still-open scholarly debate this domain's key questions ask about - the legitimacy and scope of Foucauldian genealogy as critique - by directly interrogating whether Koopman's influential reconstruction of genealogy actually resolves the normativity problem or merely relocates it.
  POSITION: Internal critical dialogue within the genealogy-as-critique literature, pressing the normativity objection against an affirmative reconstruction of genealogical method.
  },
  keywords = {genealogy, critique, normativity, debate, Medium},
  abstract = {Critique: Foucault and the Problems of Modernity 1 is an ambitious and exciting book that makes significant contributions to the now vast secondary literature on Foucault, and to the ongoing Foucault-Habermas "debate." Despite Foucault's enormous influence across multiple disciplines, his philosophical method, according to Koopman, has all too often been misunderstood not only by his harshest critics but also by his most ardent supporters. Hence, Koopman proposes a wholesale revision of our understanding of Foucault's work, a revision that turns on two fundamental issues: first, rethinking Foucault's relationship to Kant's notion of critique; and, second, re-interpreting Foucault's oeuvre through the lens of the master concept of problematization. Re-reading Foucault's work in light of these two issues allows us to see not only how his diverse writings hang together as a consistent whole but also how his work provides a valuable and effective model of historico-philosophical critique that has much more in common with the traditions of American pragmatism and German critical theory than it does with some of the French and Italian philosophers-Derrida and Agamben, particularly-with whom Foucault is more often associated.},
  abstract_source = {openalex},
}

@article{harcourt2024oncriticalgenealogy,
  author = {Harcourt, Bernard E.},
  title = {On Critical Genealogy},
  journal = {Contemporary Political Theory},
  year = {2024},
  volume = {24},
  number = {2},
  pages = {167--185},
  doi = {10.1057/s41296-024-00715-y},
  note = {
  CORE ARGUMENT: Harcourt argues that although most contemporary critical theorists deploying history now use some version of the Nietzschean/Foucauldian genealogical method, not every genealogical study advances the goals of critical philosophy, and proposes reserving the term "critical genealogy" for genealogical practices that positively contribute to transforming ourselves, others, and society, evaluated by that transformative criterion rather than by formal method alone.
  RELEVANCE: A recent (2024) attempt to discipline the now-dominant, diffuse use of "genealogy" across critical theory and political philosophy back into a defensible critical practice, directly engaging this domain's question about how genealogy as critique has been extended and where its legitimate scope ends.
  POSITION: Reformist/evaluative position within genealogy studies, proposing a normative criterion (contribution to self- and social transformation) to distinguish critical from merely descriptive or historicist genealogies.
  },
  keywords = {genealogy, critique, critical-theory, normativity, legacy, High},
  abstract = {Today most critical theorists who deploy history use a genealogical method forged by Nietzsche and Foucault. This genealogical approach now dominates historically inflected critique. But not all genealogical writings today, nor all philosophical debates surrounding genealogy, advance the goals of critical philosophy. It is crucial now that we assess the value of genealogical critiques. The proper metric against which to evaluate such work is whether it contributes to transforming ourselves, others, and society in a valuable way. In this article, I propose that we use the term “critical genealogy” to identify those genealogical practices that positively nourish our activity and, thereby, advance the ambition of critical philosophy.},
  abstract_source = {s2},
}

@article{nigherlenbuschanderson2020howmethodtravels,
  author = {Nigh, Amy and Erlenbusch-Anderson, Verena},
  title = {How Method Travels: Genealogy in Foucault and Castro-Gómez},
  journal = {Inquiry},
  year = {2020},
  volume = {67},
  number = {7},
  pages = {2147--2174},
  doi = {10.1080/0020174x.2020.1762726},
  note = {
  CORE ARGUMENT: Nigh and Erlenbusch-Anderson examine whether Foucauldian genealogy can travel beyond its European site of articulation by tracing Colombian philosopher Santiago Castro-Gómez's systematic use of Foucauldian inquiry for decolonial study, showing that applying the method to Latin American contexts requires significant revision of Foucauldian concepts, categories, and methods rather than straightforward transplantation.
  RELEVANCE: Directly addresses this domain's question about how genealogical critique has been extended into other fields (here, decolonial theory), while also testing the limits of genealogy's portability - a question with clear implications for assessing the scope and legitimacy of Foucauldian history more broadly.
  POSITION: Critical-comparative position that affirms genealogy's productive travel into decolonial theory while insisting the transfer necessarily transforms the method, against readings that treat genealogical inquiry as a context-neutral toolkit.
  },
  keywords = {genealogy, decolonial-theory, method, travel, Castro-Gomez, Medium},
  abstract = {This paper examines whether, and how, Foucauldian genealogy travels to contexts and problematizations beyond the method's European site of articulation. Our particular focus is on the work of Colombian philosopher Santiago Castro-Gómez, whose work includes both a systematic defense of the usefulness of Foucauldian inquiry for decolonial study and genealogical inquiry in a Foucauldian spirit but in a context beyond Foucault's own horizon of study. We show that taking up Foucault's work in the context of Latin America leads Castro-Gómez to significantly change Foucauldian concepts, categories, and methods. We further survey the potential synergies of decolonial thought and Foucauldian critique, while also highlighting how their joint mobilization requires a revision and problematization of key commitments of both approaches.},
  abstract_source = {openalex},
}

@book{lorenzini2023forceoftruth,
  author = {Lorenzini, Daniele},
  title = {The Force of Truth: Critique, Genealogy, and Truth-Telling in Michel Foucault},
  year = {2023},
  publisher = {University of Chicago Press},
  doi = {10.7208/chicago/9780226827445.001.0001},
  note = {
  CORE ARGUMENT: Lorenzini reconstructs Foucault's late work on critique, genealogy, and parrhēsia (truth-telling) as a unified philosophical project, arguing that genealogy in Foucault's mature sense is inseparable from an ethics and politics of truth-telling that gives historical critique its force, rather than being a purely descriptive historiographical technique.
  RELEVANCE: As the most recent major monograph synthesizing Foucault's genealogical method with his late ethical and political concerns, this book represents current scholarship's attempt to state what remains philosophically live and defensible in Foucauldian genealogy as critique, directly relevant to this domain's question about the method's legitimacy and continued extension.
  POSITION: Synthetic-constructive position that unifies critique, genealogy, and parrhēsia into a single account of Foucault's historically grounded practice of truth-telling, offering a comprehensive rival to more narrowly methodological readings of genealogy.
  },
  keywords = {genealogy, critique, parrhesia, truth-telling, synthesis, High, INCOMPLETE, no-abstract},
}

