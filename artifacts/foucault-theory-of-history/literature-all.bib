@article{owen2024politicshistoryfreedom,
  author = {Owen, David},
  title = {Politics, History, Freedom: Arendt, Foucault and the Politics of Genealogy},
  journal = {Journal of the Philosophy of History},
  year = {2024},
  volume = {18},
  number = {3},
  pages = {290--314},
  doi = {10.1163/18722636-12341536},
  note = {
  CORE ARGUMENT: Owen argues that Arendt and Foucault can both be understood as practicing genealogy, tracing their shared background in Heidegger and Nietzsche and their common dissatisfaction with the lack of historical groundedness in Heidegger's philosophy, and uses this shared genealogical orientation to stage a comparison of their respective diagnoses of political modernity.
  RELEVANCE: Provides a direct, recent (2024) comparative placement of Foucauldian genealogy against another major twentieth-century political-philosophical use of history, addressing this domain's question of how genealogy as critique has been theorized and extended within political philosophy; part of a themed Journal of the Philosophy of History issue that situates Foucault squarely within contemporary philosophy-of-history debates rather than only Foucault-studies venues.
  POSITION: Comparative-genealogical reading that treats Arendt and Foucault as convergent rather than opposed practitioners of historically grounded political critique, against readings that treat them as methodologically incompatible.
  },
  keywords = {genealogy, Arendt, political-philosophy, comparative, placement, High},
  abstract = {Abstract Arguing that Arendt and Foucault can both be seen as engaged in the practice of genealogy, this article starts by sketching the background figures of Heidegger and Nietzsche that they hold in common and situates their relations to Nietzsche as emerging from dissatisfaction with the lack of historical groundedness in Heidegger’s philosophy. To develop this case and to provide that basis for some comparison between their approaches and diagnoses of the contemporary condition, it then offers an analysis of each of Arendt and Foucault against this Heidegger-Nietzsche background. Finally I draw attention to some salient similarities and differences between Arendt and Foucault that can provide a basis for critical dialogue between them.},
  abstract_source = {openalex},
}

