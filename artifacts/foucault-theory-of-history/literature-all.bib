    author = "Forrester, John",
    title = "Essay Review: Michel Foucault and the History of Psychoanalysis: The Order of Things",
    journal = "History of Science",
    year = "1980",
    doi = "10.1177/007327538001800404",
    note = {CORE ARGUMENT: Forrester, writing as a historian of psychoanalysis for a history-of-science audience, assesses The Order of Things' account of the human sciences and its treatment of psychoanalysis as a "counter-science," probing whether Foucault's archaeological reconstruction of the episteme underlying nineteenth- and twentieth-century human sciences is defensible as history of science rather than as a philosophically motivated schema imposed on the material. RELEVANCE: One of the few history-of-science-journal engagements with Foucault located in this search, giving direct evidence of how the discipline of history of science (as opposed to history of medicine or general historiography) received his work; addresses the domain's question about Foucault's standing among historians of science specifically. POSITION: Cautious, discipline-internal appraisal from history of science; neither wholesale rejection nor uncritical adoption.},
    keywords = "history-of-science, order-of-things, psychoanalysis, reception, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages"
}

@misc{earle2007pleasureprovocation,
    author = "Earle, William James",
    title = "Pleasure and Provocation: Reaction-Shots to Michel Foucault's History of Madness",
    year = "2007",
    note = {CORE ARGUMENT: Earle surveys the range of critical "reaction-shots" provoked by the full English translation of History of Madness (2006), cataloguing the recurring objections - overstated unity of the classical age, selective use of sources, romanticization of unreason - while asking what remains philosophically valuable in the text once these historiographical objections are granted. RELEVANCE: A retrospective synthesis of the historian critique literature occasioned by the 2006 unabridged translation, useful for summarizing the shape of the "accuracy" controversy for readers of this review; explicitly frames the tension between provocative philosophical payoff and historiographical liability. POSITION: Synthesizes and partially endorses the rhetorical/genre-reclassification view while taking empirical objections seriously.},
    keywords = "madness, reception, historiography, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{weymans2009revisingfoucault,
    author = "Weymans, Wim",
    title = "Revising Foucault's Model of Modernity and Exclusion: Gauchet and Swain on Madness and Democracy",
    year = "2009",
    note = {CORE ARGUMENT: Weymans reconstructs how the French historians of psychiatry Marcel Gauchet and Gladys Swain revised Foucault's exclusion thesis from within the same archival territory (the birth of the asylum), arguing that modern psychiatric practice represented a new form of recognition of the mad rather than simple confinement, while nonetheless remaining indebted to Foucault's problematization of madness and modernity. RELEVANCE: A clear case of historians working inside Foucault's own field of inquiry who revise rather than simply reject his narrative, illustrating the "selective appropriation" pattern this domain is designed to capture and complicating any binary appropriation/rejection framing. POSITION: Selective appropriation via internal historiographical revision (Gauchet/Swain against Foucault, read sympathetically by Weymans).},
    keywords = "madness, history-of-psychiatry, gauchet-swain, reception, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This article reveals how Marcel Gauchet and his late wife Gladys Swain revise Foucault's history of madness and modernity by arguing that the history of modern civilization represents a recognition of the mad, rather than their exclusion. Turning to the French Revolution, the article then examines the relationship between disciplinary practices and a wider democratic context. It shows that while Foucault reduces democratic societies to proto totalitarian practices, Gauchet and Swain give a broader and more historically complex account of asylums and the democratic context in which they emerge. This allows them to see resistance in the asylum and in democratic societies in general: while Foucault thought the panoptic asylum revealed modernity's ultimate success, for Gauchet and Swain it proved only its failure. However, the article ends by arguing that, despite all their differences, Gauchet and Swain's critique of contemporary societies remains in some respects indebted to Foucault.",
    abstract_source = "openalex"
}

@misc{hanpile2005earlyfoucaulthistorian,
    author = "Han-Pile, B\'{e}atrice",
    title = "Is Early Foucault a Historian? History, History and the Analytic of Finitude",
    year = "2005",
    note = {CORE ARGUMENT: Han-Pile addresses head-on the disciplinary question "is Foucault a historian?" by examining the young Foucault's relation to the Kantian "analytic of finitude," arguing that early attacks by historians of ideas charging inaccuracy or distortion misconstrue a project that was never primarily aimed at empirical historical reconstruction but at a transcendental-historical diagnosis of the conditions of possibility for the human sciences. RELEVANCE: Explicitly engages this domain's framing question ("is early Foucault a historian?") and directly references the historians of ideas who "immediately attacked him for the alleged inaccuracy or mistaken character of his analyses" upon publication of The Order of Things, making it a useful hinge text between the philosophical and historiographical literatures. POSITION: Rhetorical/genre-reclassification; defends Foucault's early work as philosophy of history rather than empirical historiography, against historian critics.},
    keywords = "order-of-things, historicity, method, reception, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This paper is an exploration of the theme of history in The Order of Things, with a view to clarifying the relation between history and philosophy in Foucault’s early work. I argue that Foucault introduces, beyond the Hegelian distinction between res gestae (past deeds) and historia rerum gestarum(the history of past deeds), a third meaning for the notion: History (capitalized) as our current historical a priori or épistémè, succeeding Order in the Classical age. I show that methodologically speaking, this commits early Foucault to a revised form of transcendental idealism. I then examine the complex relation between History and Man, established by chapters VII and IX as the ground of our current épistémè. This involves an analysis of the theme of the origin in chapter IX, which in turn allows the core of this relation to be formally identified as the possibility of shifting from the empirical to the transcendental in order to distinguish between two forms of temporality, primordial and derived. I then argue that because Foucault still belongs to the very épistémè he is trying to describe, the content of this distinction is and must remain obscure. However, I also show that his liminary position allows him a unique insight into the problems generated by the grounding of History in Man, and examine the impact of his criticism of anthropology on his characterization of History. Finally, I draw out the consequences of these analyses for Foucault’s methodology by arguing that the latter is best characterized as a form of ‘transcendental history’, meant to de-anthropomorphize the analytic of finitude while retaining its demand for a shift from the post hoc to the a priori (in a revised sense).",
    abstract_source = "openalex"
}

@article{alford2000whatwouldmatter,
    author = "Alford, C. Fred",
    title = "What Would It Matter if Everything Foucault Said About Prison Were Wrong? Discipline and Punish After Twenty Years",
    journal = "Theory and Society",
    year = "2000",
    doi = "10.1023/A:1007014831641",
    note = "CORE ARGUMENT: Taking seriously the possibility that Foucault's historical claims about the birth of the prison are simply mistaken, Alford asks what would remain of Discipline and Punish's theoretical apparatus (panopticism, disciplinary power, the carceral continuum) if its historical narrative were stripped away, concluding that much of the book's continuing influence rests on its diagnostic power over the present rather than on the accuracy of its genealogy of the nineteenth-century prison. RELEVANCE: Directly poses this domain's central methodological question - what happens to Foucauldian analysis if the history turns out to be wrong - and offers a considered answer twenty years after publication, making it a natural anchor for the review's discussion of the stakes of the accuracy controversy for Discipline and Punish specifically. POSITION: Rhetorical/genre-reclassification stance applied specifically to Discipline and Punish; grants empirical vulnerability while defending residual theoretical value.",
    keywords = "discipline-and-punish, empirical-accuracy, method, critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages"
}

@article{white1973foucaultdecoded,
    author = "White, Hayden V.",
    title = "Foucault Decoded: Notes from Underground",
    journal = "History and Theory",
    year = "1973",
    note = {CORE ARGUMENT: White, himself a historiographer and theorist of narrative, reads The Order of Things as a species of "anti-history" that deliberately eschews the connective, developmental modes of emplotment characteristic of conventional historiography, arguing that Foucault's archaeological method should be understood through the categories of literary and rhetorical analysis rather than judged by the evidentiary standards proper to empirical history. RELEVANCE: An early and influential intervention, appearing in the flagship journal of philosophy of history (History and Theory), that frames Foucault's histories as a distinctive rhetorical/narrative mode - directly relevant to whether archaeology/genealogy constitutes usable historical method or philosophy imported into history. POSITION: Rhetorical/genre-reclassification; treats Foucault's work as continuous with, and analyzable via, the theory of historical narrative and emplotment rather than as failed empirical history.},
    keywords = "order-of-things, narrative, historiography, method, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{wilson2007porterfoucault,
    author = "Wilson, Adrian",
    title = "Porter versus Foucault on the `Birth of the Clinic'",
    year = "2007",
    note = {CORE ARGUMENT: Wilson reconstructs the historian Roy Porter's sustained empirical and methodological objections to The Birth of the Clinic, contrasting Porter's patient-centered, archivally grounded social history of medicine with Foucault's structuralist account of the "clinical gaze," and assesses which aspects of the disagreement are genuinely empirical versus differences in what counts as historical explanation. RELEVANCE: A direct, named confrontation between a professional historian of medicine (Porter) and Foucault, addressing precisely this domain's question about reception within the history of medicine and about disciplinary norms of evidence versus Foucault's structuralist/archaeological method. POSITION: Empirical/archival critique voiced through Porter, evaluated and partly qualified by Wilson; exemplifies historian resistance to Foucauldian method in medical history specifically.},
    keywords = "history-of-medicine, birth-of-clinic, roy-porter, empirical-accuracy, High, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "It is well known that Roy Porter's oeuvre in the history of psychiatry was partly stimulated by, and in no small measure pitched against, Michel Foucault's Madness and Civilization (Folie et déraison). But what was Porter's response to Foucault's Birth of the Clinic (Naissance de la clinique)?1 By the 'birth of the clinic', let us recall, Foucault referred to the remarkable change in medicine that took place in the Paris École de Santé between 1800, when Xavier Bichat's Traité des membranes initiated his new doctrine of tissues, which rapidly invigorated pathological anatomy, and 1817, when René-Théophile-Hyacinthe Laennec (1781–1826), one of the most influential pupils of the new school and himself a master of pathological anatomy, invented the stethoscope. Foucault himself, as we shall see, regarded this as the most important transformation in Western medicine's entire history, and although not all commentators would go this far, none would deny that pathological anatomy made giant strides in the Paris school, or that the stethoscope gave an unprecedented impulse to physical examination, with permanent effects. Thus we are dealing here with a momentous set of events, which means that Porter's view of Birth of the Clinic is of considerable interest.KeywordsEighteenth CenturyNormal AnatomyPathological AnatomyGreat BreakPostmortem FindingThese keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

@article{surkis2012linguisticturn,
    author = "Surkis, Judith",
    title = "When Was the Linguistic Turn? A Genealogy",
    journal = "The American Historical Review",
    year = "2012",
    note = {CORE ARGUMENT: Surkis historicizes the historians' profession's own narrative about a "linguistic turn," in which Foucauldian and poststructuralist method was popularly credited with (or blamed for) transforming Anglo-American historiography in the 1980s-90s, and argues that this standard genealogy oversimplifies a more heterogeneous and contested process of disciplinary uptake. RELEVANCE: Published in the flagship journal of the American historical profession, this article provides a historian's own reflexive account of how and when the discipline absorbed (or claims to have absorbed) Foucauldian method, directly addressing the domain's question of disciplinary uptake and resistance. POSITION: Disciplinary historiography of the reception itself; complicates rather than adjudicates the appropriation/rejection debate.},
    keywords = "historiography, linguistic-turn, reception, disciplinary-history, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{goldstein1994foucaultwriting,
    editor = "Goldstein, Jan",
    title = "Foucault and the Writing of History",
