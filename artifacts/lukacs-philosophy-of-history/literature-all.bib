@book{jameson1971marxismform,
  author = {Jameson, Fredric},
  title = {Marxism and Form: Twentieth-Century Dialectical Theories of Literature},
  year = {1971},
  publisher = {Princeton University Press},
  address = {Princeton, NJ},
  note = {
  CORE ARGUMENT: Jameson's early study introduces Anglophone readers to Western Marxist dialectical criticism--including Lukács, Adorno, Benjamin, Marcuse, Bloch, and Sartre--arguing that dialectical thought's characteristic difficulty and self-reflexivity are necessary responses to the reified, fragmented character of thought under capitalism, and defending totality and mediation as indispensable categories for a Marxist literary criticism.

