}

@article{postonebrick1982criticalpessimism,
  author = {Postone, Moishe and Brick, Barbara},
  title = {Critical Pessimism and the Limits of Traditional Marxism},
  journal = {Theory and Society},
  year = {1982},
  volume = {11},
  issue = {5},
  doi = {10.1007/bf00182262},
  note = {
