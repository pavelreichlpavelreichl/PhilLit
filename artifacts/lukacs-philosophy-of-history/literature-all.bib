}

@book{westerman2019phenomenologycapitalism,
  author = {Westerman, Richard},
  title = {Lukács's Phenomenology of Capitalism: Reification Revalued},
  year = {2019},
  publisher = {Springer},
  address = {Cham},
  doi = {10.1007/978-3-319-93287-3},
  note = {
  CORE ARGUMENT: Westerman argues that the philosophical framework underlying Lukács's analysis of reification in History and Class Consciousness was laid not primarily in Hegelian Marxism but in an unfinished pre-Marxist "Heidelberg Aesthetics" project, drawing on previously underexamined influences -- Husserl, Emil Lask, and Alois Riegl -- which together supply a phenomenological theory of subjectivity constituted within social relations, avoiding several problems of earlier (Hegelian-teleological) readings of the text.

  RELEVANCE: Provides an alternative genealogy (phenomenological/Husserlian rather than strictly neo-Kantian or Hegelian) for the theoretical apparatus of the Reification essay, complicating any account of the antinomies critique that treats it as derived solely from Kant-Hegel or Kant-Weber lineages; important counterpoint to Kavoulakos and López in this domain.

  POSITION: Phenomenological-genealogical reading: Lukács's reification theory is best understood via his unfinished pre-Marxist aesthetics (Husserl, Lask, Riegl) rather than primarily via Hegelian dialectics.
  },
  keywords = {phenomenology, Husserl, Lask, reification, Westerman, High, INCOMPLETE, no-abstract}
}

@book{rose1981hegelcontrasociology,
  author = {Rose, Gillian},
  title = {Hegel Contra Sociology},
  year = {1981},
  publisher = {Athlone Press},
  address = {London},
  note = {
  CORE ARGUMENT: Rose argues that both non-Marxist and Marxist sociology (including Lukács's critical theory) rest on a shared neo-Kantian paradigm -- one that separates form from content and imposes an abstract, dualistic method onto social life -- and that Hegel's speculative logic, properly understood, anticipates and diagnoses precisely the limitations ("methodologism" and "moralism") of this neo-Kantian sociological method, including Lukács's own reification theory insofar as it remains methodologically neo-Kantian despite its Hegelian self-understanding.

  RELEVANCE: The foundational text behind the value-form-theoretic challenge to Lukács examined by Lazarus (2020); offers an independent, Hegel-immanent critique of Lukács's reification concept that complements but predates the neo-Kantian-genealogical readings (Kavoulakos, Kinzel) by arguing Lukács has not escaped neo-Kantianism as thoroughly as he claims.

  POSITION: Independent Hegelian critique arguing that Lukács's sociology (like Weberian and Simmelian sociology) remains trapped within the neo-Kantian form/content dualism it purports to overcome.
  },
  keywords = {Hegel, neo-Kantianism, sociology, Gillian-Rose, High, INCOMPLETE, no-abstract}
}

@book{bewes2002reification,
  author = {Bewes, Timothy},
  title = {Reification: or The Anxiety of Late Capitalism},
  year = {2002},
  publisher = {Verso},
  address = {New York},
  note = {
  CORE ARGUMENT: Bewes reformulates reification for the era of "late capitalism" as a form of pervasive social and cultural anxiety rather than a discrete cognitive or social-structural error, arguing that this reformulation returns the concept to its origins in Lukács while extending it, via readings of Kierkegaard, Melville, Proust, and Flannery O'Connor, into a general theory linking politics with truth, art with experience, and philosophy with lived life.

  RELEVANCE: Represents the furthest extension, within literary-critical territory, of Lukács's diagnostic beyond its original targets (classical philosophy, neo-Kantian sociology, Second-International Marxism) into a general theory of modern cultural anxiety; useful as a limit case for assessing how much of Lukács's specific philosophical argument survives such generalization (compare Ivanova's 2026 push toward a narrower respecification).

  POSITION: Generalizes reification into a diffuse existential-cultural category of "anxiety," in contrast to the tightly philosophical/economic reconstructions offered elsewhere in this domain.
  },
  keywords = {reification, late-capitalism, cultural-theory, Bewes, Medium, INCOMPLETE, no-abstract}
}

@phdthesis{parker1981lukacsonkant,
  author = {Parker, Pamela Ann},
  title = {Lukacs on Kant: A Study in Dialectical Materialism},
  year = {1981},
  school = {Cornell University},
  note = {
  CORE ARGUMENT: Parker's dissertation is a sustained examination of Lukács's essay "The Antinomies of Bourgeois Thought," analyzing his Marxist interpretation of Kant's philosophy: the formal, subject-centered, mathematically modeled, and systematic character of Kantian philosophy generates unresolvable dichotomies and contradictions that Lukács subsumes under the general heading of "the problem of the thing-in-itself," diagnosed as ideological because it treats these Kantian thought-structures as the only ones possible. Parker discusses Lukács's proposed Marxist resolution of the Kantian problems and situates the essay as one facet of Lukács's anti-revisionist argument within History and Class Consciousness.

  RELEVANCE: The only book-length English-language study located that is devoted specifically to the "Antinomies of Bourgeois Thought" essay named in this domain's search brief; provides a dedicated, section-by-section treatment of exactly the antinomies-of-Kantian-philosophy material central to this domain's second key question.

  POSITION: Detailed exegetical study treating the antinomies essay as ideology-critique of Kantian philosophy's claim to universal necessity, read as part of Lukács's broader anti-revisionist (anti-Second-International) polemic.
  },
  keywords = {antinomies, Kant, dissertation, Parker, Medium, INCOMPLETE, no-abstract}
}

@book{lukacs1971history,
  author = {Lukács, Georg},
  title = {History and Class Consciousness: Studies in Marxist Dialectics},
  year = {1971},
  publisher = {MIT Press},
  address = {Cambridge, MA},
  note = {
  CORE ARGUMENT: The primary text for this domain. In "What Is Orthodox Marxism?," "Class Consciousness," "Reification and the Consciousness of the Proletariat," and "Towards a Methodology of the Problem of Organisation," Lukács argues that Marxism's distinguishing feature is not any particular economic thesis but "the point of view of totality"; that the proletariat's structural position as both the object of capitalist exchange and the (potential) subject of historical transformation makes it the "identical subject-object of history"; that actual, empirical working-class consciousness must be distinguished from the class consciousness "imputed" to the proletariat by its objective position; and that revolutionary organization and praxis are the practical vehicle through which this imputed consciousness becomes actual, overcoming the contemplative stance of reification diagnosed elsewhere in the volume.

  RELEVANCE: The foundational primary source for every constructive doctrine this domain surveys (totality, subject-object identity, imputed consciousness, praxis, organization); translated by Rodney Livingstone from the 1923 German original, with Lukács's own 1967 self-critical preface (treated at length in Domain 1).

  POSITION: Primary text establishing the "philosophy of praxis" reading of Marxism that virtually all subsequent secondary literature in this domain interprets, defends, or criticizes.
  },
  keywords = {totality, subject-object, class-consciousness, praxis, primary-source, High, INCOMPLETE, no-abstract},
}

@book{lukacs2000tailism,
  author = {Lukács, Georg},
  editor = {Žižek, Slavoj},
  title = {A Defence of History and Class Consciousness: Tailism and the Dialectic},
  year = {2000},
  publisher = {Verso},
  address = {London},
  note = {
  CORE ARGUMENT: Written in 1925-26 but unpublished until 1996, Lukács's manuscript defends History and Class Consciousness against contemporary party critics (principally Rudas and Deborin), who charged it with idealism, voluntarism, and a rejection of the dialectics of nature. Against the charge of "tailism" (Chvostismus, trailing behind rather than leading revolutionary consciousness), Lukács reasserts the primacy of totality and defends -- while also partially qualifying -- his account of proletarian class consciousness and the party's role in mediating it.

  RELEVANCE: The primary document for this domain's Tailism debate; translated by Esther Leslie with an introductory essay by John Rees and a postface by Slavoj Žižek. Together with the secondary Historical Materialism exchange (Fracchia, Burkett, Feenberg below), it supplies the textual basis for assessing how much of the "constructive theory" Lukács himself was prepared to defend, qualify, or concede under party pressure -- directly bearing on this domain's question of whether the standpoint of the proletariat is philosophically or organizationally (party-)determined.

  POSITION: Primary self-defense; the central textual battleground for the debate (below) over whether Lukács's concessions here undermine or merely refine the constructive theory of HCC.
  },
  keywords = {tailism, class-consciousness, party, dialectics-of-nature, primary-source, High},
  abstract = {"In the mid-1920s, Lukacs wrote Tailism and the Dialectic. Unpublished at the time, Lukacs himself thought the text had been destroyed. However, a group of researchers recently found the manuscript gathering dust in the newly opened archives of the CPSU in Moscow."--Jacket.Includes bibliographical references."In the mid-1920s, Lukacs wrote Tailism and the Dialectic. Unpublished at the time, Lukacs himself thought the text had been destroyed. However, a group of researchers recently found the manuscript gathering dust in the newly opened archives of the CPSU in Moscow."--Jacket},
  abstract_source = {core},
}

@book{jay1984marxismtotality,
  author = {Jay, Martin},
  title = {Marxism and Totality: The Adventures of a Concept from Lukács to Habermas},
  year = {1984},
  publisher = {University of California Press},
  address = {Berkeley},
  note = {
  CORE ARGUMENT: Jay traces the concept of "totality" through the Western Marxist tradition inaugurated by Lukács -- as a category of Hegelian inheritance repurposed to grasp capitalist society as an internally mediated whole rather than a collection of reified, isolated facts -- and follows its subsequent transformations, contestations, and partial abandonments through Korsch, the Frankfurt School, Sartre, Althusser, and Habermas.

  RELEVANCE: The most sustained intellectual history of exactly the category this domain's first key question addresses -- how totality functions methodologically as "the bearer of the principle of revolution in science" -- and situates Lukács's specific formulation within a much longer and more contested trajectory, showing that later Western Marxists (Althusser above all) came to see the same category as a liability rather than a resource.

  POSITION: Intellectual-historical reconstruction that treats totality as Western Marxism's defining and most contested category, with Lukács's HCC as the decisive originating formulation.
  },
  keywords = {totality, Western-Marxism, intellectual-history, Jay, High, INCOMPLETE, no-abstract},
}

@article{schmidt1975concretetotality,
  author = {Schmidt, James},
  title = {The Concrete Totality and Lukács' Concept of Proletarian Bildung},
  journal = {Telos},
  year = {1975},
  volume = {1975},
  number = {24},
  pages = {2--40},
  doi = {10.3817/0675024002},
  note = {
  CORE ARGUMENT: Schmidt examines how Lukács's concept of the "concrete totality" underwrites his account of proletarian Bildung -- the process by which the working class's self-formation as a revolutionary subject is supposed to proceed through practical self-education within, rather than abstraction from, the concrete social totality it inhabits.

  RELEVANCE: Connects this domain's totality category directly to the practical, pedagogical dimension of class-consciousness formation (the "how" of imputed consciousness becoming actual), complementing Lanning's studies of imputed consciousness with an account of totality's role in that same process.

  POSITION: Reads totality not merely as an epistemological category but as the framework for a theory of proletarian self-formation (Bildung) through revolutionary practice.
  },
  keywords = {totality, Bildung, class-formation, Telos, Medium},
  abstract = {Abstract A truly critical Marxian analysis of society does not appear full blown in the thunderclap of a coupure epistémologique, leaving all previous efforts at critical reflection on the far side of the “ideology”-“science” opposition. Rather, as a determinate, historical negation of the self-understanding achieved at those moments of bourgeois social theory's most incisive insights into the limits of its society, it reaches its “new continent of thought” at least in part by vehicles from the old world. It should not be surprising then that those Marxists who have clearly perceived the specificity of Marx's achievement have also often been equally sensitive towards this exploration of the limits of bourgeois thought which has taken place in the finest products of classical liberal social theory.},
  abstract_source = {openalex},
}

@article{alzu2020totalidadsocial,
  author = {Alzu, Alejandro Nahuel},
  title = {Consideraciones para una actualización del concepto de totalidad social con base en la obra de Georg Lukács},
  journal = {Estudios de Filosofía},
  year = {2020},
  number = {62},
  doi = {10.17533/udea.ef.n62a05},
  note = {
  CORE ARGUMENT: Alzu reviews the successive elaborations of the concept of social totality across Lukács's oeuvre -- from the "young" Lukács, through History and Class Consciousness, to Toward the Ontology of Social Being -- and argues that a radical change of position occurs between HCC and the Ontology, driven by the theoretical need to make room for a subjective practice that is not ineluctably alienated (as HCC's model of totality had implied). Alzu concludes that the Ontology's revised concept of totality enables a new, non-dogmatic type of emancipatory practice distinct from the party-centered dogmatism of much twentieth-century socialism.

  RELEVANCE: Directly addresses this domain's first key question by tracking how "totality" changes function across Lukács's career, and supplies an internal-development account of why the HCC-era totality concept (this domain's focus) required later revision -- a useful bridge to Domain 5's treatment of the Ontology.

  POSITION: Developmental account arguing that Lukács's concept of totality must be revised between HCC and the Ontology to avoid entailing that all subjective practice under totality is necessarily alienated.
  },
  keywords = {totality, ontology, praxis, alienation, Spanish-language, Medium},
  abstract = {En este artículo reviso las diversas elaboraciones del concepto de totalidad social que podemos encontrar en diferentes momentos de la obra del filósofo marxista Georg Lukács y destaco las concepciones de la praxis de los agentes sociales asociadas a cada una de ellas. Comienzo por analizar este concepto en la obra del joven Lukács, para luego presentar un radical cambio de postura entre las formulaciones que hallamos en Historia y conciencia de clase y Para una ontología del ser social. Mi argumento es que este cambio de perspectiva se asocia a la necesidad teórica de posibilitar una práctica subjetiva que no se encuentre indefectiblemente alienada, tal como parece desprenderse del modelo teórico de la obra lukácsiana de juventud. Finalmente concluyo que esta nueva concepción de la totalidad social habilita un nuevo tipo depráctica emancipatoria, alejada de los dogmatismos partidarios que caracterizaron a buena parte del socialismo del siglo XX.},
  abstract_source = {s2},
}

@incollection{thompson2011ontologytotality,
  author = {Thompson, Michael J.},
  editor = {Thompson, Michael J.},
  title = {Ontology and Totality: Reconstructing Lukács' Concept of Critical Theory},
  booktitle = {Georg Lukács Reconsidered: Critical Essays in Politics, Philosophy and Aesthetics},
  year = {2011},
  publisher = {Continuum},
  address = {London},
  pages = {229--250},
  note = {
  CORE ARGUMENT: Thompson reconstructs Lukács's category of totality as a resource for contemporary critical theory, arguing that totality's methodological function -- grasping social phenomena as internally related moments of a mediated whole rather than as discrete, positivistically isolable facts -- remains defensible and useful independently of the specific historical-teleological apparatus (the proletariat as revolutionary subject) in which Lukács originally embedded it.

  RELEVANCE: Represents an explicit attempt to detach this domain's central methodological category (totality) from the specific philosophy-of-history commitments (subject-object identity, proletarian teleology) this domain otherwise surveys, posing directly the question of how much of Lukács's constructive apparatus can survive without its original revolutionary-subject commitments.

  POSITION: Reconstructive/appropriative reading that seeks to preserve totality as a critical-theoretical method while bracketing Lukács's specific historical-teleological claims about the proletariat.
  },
  keywords = {totality, critical-theory, ontology, Thompson, Medium, INCOMPLETE, no-abstract}
}

@article{westerman2010reification,
  author = {Westerman, Richard},
  title = {The Reification of Consciousness: Husserl's Phenomenology in Lukács's Identical Subject-Object},
  journal = {New German Critique},
  year = {2010},
  volume = {37},
  number = {3},
  pages = {97--130},
  doi = {10.1215/0094033X-2010-016},
  note = {
  CORE ARGUMENT: Westerman argues that the specific philosophical mechanics of Lukács's "identical subject-object" claim -- how the proletariat's coming-to-consciousness of its own commodity status is supposed to simultaneously constitute consciousness of the social totality -- are best reconstructed via Husserlian phenomenology rather than via Hegel's Phenomenology of Spirit alone, since it is a phenomenological account of constitution (of objects for a subject) that does the technical work of explaining how self-consciousness and consciousness-of-the-totality could be the same act.

  RELEVANCE: Directly addresses this domain's second key question -- the logical structure of the identical subject-object claim -- by supplying a genealogically grounded account of its constitutive mechanics, complicating readings (including López's, below) that treat the concept as derived primarily from Hegel.

  POSITION: Phenomenological-genealogical reconstruction of the identical subject-object thesis, tracing its technical apparatus to Husserl (via Lukács's engagement with contemporary phenomenology) rather than to Hegelian dialectics alone.
  },
  keywords = {identical-subject-object, Husserl, phenomenology, Westerman, High, INCOMPLETE, no-abstract},
}

@book{lopez2019praxisabsolute,
  author = {López, Daniel Andrés},
  title = {Lukács: Praxis and the Absolute},
  year = {2019},
  publisher = {Brill},
  address = {Leiden},
  note = {
  CORE ARGUMENT: López reconstructs Lukács's philosophy of praxis as a conceptual-historical totality built on an explicitly Hegelian basis, arguing that Lukács's concept of praxis (as the culmination of mediation, logic, and genesis) is designed to both bear the full weight of Hegel's Absolute and to overcome it. López's immanent critique concludes that Lukács does not succeed in overcoming speculative Hegelian philosophy: his praxis concept remains -- unconsciously -- within the structure it claims to supersede, since Lukács's insight into praxis is won only retrospectively, after the historical event on which it is built, in the manner of Hegelian philosophical reflection rather than as a living, present truth.

  RELEVANCE: A book-length treatment of exactly this domain's second key question (the logical structure and philosophical cost of the subject-object/praxis claim) that reaches a critical conclusion: the "identical subject-object" and the praxis concept built to sustain it do not escape Hegelian speculative structure, raising the same immanent-critique concerns that Domain 2's López (2020) and Jaffe (2020) entries raise about the antinomies and the standpoint of the proletariat.

  POSITION: Sympathetic but ultimately critical immanent reconstruction: defends Lukács's philosophy of praxis as a serious and internally coherent project while arguing it fails, on its own terms, to overcome the Hegelian Absolute it was built to supersede.
  },
  keywords = {praxis, Hegel, Absolute, subject-object, López, High, INCOMPLETE, no-abstract}
}

@article{lopez2017returnpraxis,
  author = {López, Daniel},
  title = {A Return to the Philosophy of Praxis},
  journal = {Historical Materialism},
  year = {2017},
  volume = {25},
  number = {4},
  pages = {257--282},
  doi = {10.1163/1569206X-12341550},
  note = {
  CORE ARGUMENT: A review essay on Feenberg's The Philosophy of Praxis, offering a critical yet sympathetic summary of Feenberg's argument (developed via Marx, Lukács, and Marcuse) before arguing that Feenberg's treatment of Lukács's 1920s work is unparalleled in countering the systematic distortion to which it has been subject, particularly Feenberg's defense of Lukács's ontology of nature and his politics against the charge of authoritarianism. López suggests, however, that Feenberg elides the analysis of the state and politics in Marx and Lukács, and proposes instead a Hegelian interpretation of Lukács's concept of mediation parallel to the Phenomenology of Spirit.

  RELEVANCE: Provides an orientation point for how the secondary literature surveyed throughout this domain (Feenberg above all) has organized itself around the "philosophy of praxis" label and around the authoritarianism charge central to the Tailism debate (Fracchia, Burkett, Feenberg below), useful for the synthesis phase in mapping the state of the field.

  POSITION: Critical but sympathetic review of Feenberg's philosophy-of-praxis reconstruction, written from within the same interpretive tradition López's own 2019 monograph develops and criticizes via a rival Hegelian reading of mediation.
  },
  keywords = {praxis, philosophy-of-praxis, review-essay, López, Medium},
  abstract = {Abstract I review The Philosophy of Praxis by Andrew Feenberg, firstly, presenting a critical yet sympathetic summary of Feenberg’s argument, developed via Marx, Lukács and Marcuse. Despite sharing Adorno’s and Marcuse’s dismissal of proletarian revolution, he finds aspects of Marx and particularly Lukács compelling. Upon this synthesis he builds his own philosophy. Secondly, I argue that Feenberg’s treatment of Lukács’s 1920s work is unparalleled and may counter the systematic distortion to which it has been subject. He defends Lukács’s ontology with respect to nature and his politics, countering the charge of authoritarianism. Finally, I suggest that Feenberg tends to elide the analysis of the state and politics in Marx and Lukács, and that this distorts his understanding of the latter. I suggest a Hegelian interpretation of Lukács’s concept of mediation by way of parallel with The Phenomenology of Spirit . I conclude by suggesting the implications of this disagreement.},
  abstract_source = {openalex},
}

@book{lanning2009organizingclassconsciousness,
  author = {Lanning, Robert},
  title = {Georg Lukács and Organizing Class Consciousness},
  year = {2009},
  publisher = {MEP Publications},
  note = {
  CORE ARGUMENT: Lanning offers a sustained study of Lukács's concept of imputed (zugerechnetes) class consciousness, tracing its operation across "historical necessity as self-activity," the distinction between class experience and false consciousness, common-sense/market rationality in sociological studies of class, and the development of imputed consciousness within the individual, arguing that this technical distinction -- rather than reification alone -- is the organizing category of Lukács's political theory of class formation.

  RELEVANCE: The most sustained book-length Anglophone treatment located of exactly this domain's third key question: what imputed class consciousness is and how it relates to empirical, psychological proletarian consciousness. Provides the fullest reconstruction of how the concept is meant to organize political practice rather than remain a purely epistemological postulate.

  POSITION: Systematic reconstruction and defense of imputed class consciousness as Lukács's central organizing category, read against sociological accounts that treat class consciousness as a purely empirical, survey-measurable phenomenon.
  },
  keywords = {imputed-class-consciousness, class-formation, Lanning, High, INCOMPLETE, no-abstract},
}

@article{lanning2002imputedconsciousness,
  author = {Lanning, Robert},
  title = {Lukács's Concept of Imputed Consciousness in Realist Literature},
  journal = {Nature, Society, and Thought},
  year = {2002},
  volume = {15},
  number = {2},
  note = {
  CORE ARGUMENT: Lanning traces how the concept of imputed class consciousness -- developed philosophically in History and Class Consciousness -- operates in Lukács's later literary criticism, arguing that Lukács's preference for realist over modernist literature is grounded in the claim that realist form alone can represent the gap between characters' empirical consciousness and the imputed consciousness appropriate to their objective class position.

  RELEVANCE: Extends this domain's treatment of imputed class consciousness from political theory into Lukács's aesthetics, showing the concept's continuity across the disciplinary boundary between HCC-era political philosophy and the later literary-critical writings, and thereby supplying a link between this domain and the aesthetic dimension of Lukács's thought that falls outside this review's other domains.

  POSITION: Continuity thesis connecting the HCC-era concept of imputed consciousness to Lukács's later realist aesthetics, read as two applications of a single underlying theoretical distinction.
  },
  keywords = {imputed-class-consciousness, realism, aesthetics, Lanning, Medium, INCOMPLETE, no-abstract}
}

@article{fracchia2013philosophicalleninism,
  author = {Fracchia, Joseph},
  title = {The Philosophical Leninism and Eastern 'Western Marxism' of Georg Lukács},
  journal = {Historical Materialism},
  year = {2013},
  volume = {21},
  number = {1},
  pages = {69--93},
  doi = {10.1163/1569206X-12341282},
  note = {
  CORE ARGUMENT: Reviewing the English translation of Tailism and the Dialectic, Fracchia argues that Lukács -- generally heralded as a founder of a "Western Marxism" opposed to "Eastern" Soviet orthodoxy -- in fact remains, on the evidence of this text, a "philosophical Leninist": Lukács's purely conceptual derivation of reification as the necessary, immediate form of working-class consciousness leads him to conclude that workers can never attain proper class consciousness on their own, so that this consciousness must instead be attributed to the revolutionary party bearing the correct theory. Fracchia criticizes both the methodological shortcuts in this conceptual derivation and the politically dangerous consequence that the party's theoretical authority is thereby guaranteed against working-class self-activity.

  RELEVANCE: Directly targets this domain's fourth key question by locating, in Lukács's own defense of HCC, textual evidence that "imputed" class consciousness collapses into party-imputed consciousness -- a considerably more authoritarian reading of the concept than Lanning's (above), and central to the domain's internal Tailism debate together with Burkett and Feenberg below.

  POSITION: Critical reading arguing that Tailism and the Dialectic exposes an authoritarian, party-centered "philosophical Leninism" beneath Lukács's reputation as a founder of anti-Leninist Western Marxism.
  },
  keywords = {tailism, imputed-class-consciousness, party, Leninism, Fracchia, High},
  abstract = {Abstract This essay centres on the English translation (2000) of Georg Lukács’s Tailism and the Dialectic (written in either 1925 or 1926). Lukács is generally heralded as a founding theoretician of a ‘Western Marxism’, in opposition to ‘Eastern’ Soviet Marxism, and his most impressive and most influential work, History and Class Consciousness (1923), is generally treated as having rehabilitated Marxist concern with questions of subjectivity. It might therefore come as a surprise when Lukács in Tailism states that the purpose of History and Class Consciousness was to demonstrate ‘that the organisation and tactics of Bolshevism are the only possible consequence of Marxism’. In my view, however, this should already be abundantly clear from History and Class Consciousness . For Lukács’s absorption with proletarian subjectivity was motivated by an obsession with what he saw as its immaturity. And he coined the category of ‘reification’ in order to explain his disappointed expectations, to explain, that is, why the proletariat did not make a ‘socialist’ revolution in the ‘objectively ripe’ situation of an ‘imperialist war’ created by ‘moribund capitalism’. In short, Lukács did raise anew the question of the subjective, but only to then declare that workers, not even ‘the most revolutionary among them’, could never attain proper class consciousness, which he attributed instead to the ‘revolutionary party’ bearing the properly revolutionary theory. For this reason I agree with Slavoj Žižek’s characterisation of Lukács as the ‘ultimate philosopher [my emphasis] of Leninism’ – although I do think that Lenin himself would have found, as he did in connection with one of Lukács’s other works, Marxism ‘present only at a verbal level’. My concern is two-fold: with a critique of the methodological short-cuts that Lukács made in his purely conceptual derivation of the concept of reification, and his purely conceptual attribution of it as the necessary form of working-class consciousness ‘in its immediacy’; and with the dangerous political consequences that Lukács derived from his assessment of the reified character of working-class subjectivity, mainly a theoretical guarantee that the party with the proper revolutionary theory must always be right, or at least more right than anyone else.},
  abstract_source = {openalex},
}

@article{burkett2013lukacsscience,
  author = {Burkett, Paul},
  title = {Lukács on Science: A New Act in the Tragedy},
  journal = {Historical Materialism},
  year = {2013},
  volume = {21},
  number = {3},
  pages = {3--15},
  doi = {10.1163/1569206X-12341313},
  note = {
  CORE ARGUMENT: Burkett shows that in Tailism and the Dialectic, Lukács -- despite Western Marxism's general rejection of Engels's "dialectics of nature" as one of its defining features -- in fact strongly endorses the existence of an objective dialectic operating in nature, a position in tension with HCC's original restriction of dialectical method to the social realm. Burkett argues that a close reading of Lukács's writings on science nonetheless shows that he continued, in practice, to deny that dialectical method could be meaningfully applied to natural-scientific inquiry, leaving an unresolved contradiction in his position.

  RELEVANCE: Supplies primary textual evidence, internal to the Tailism debate this domain foregrounds, for a specific tension in Lukács's defense of HCC -- between his professed (concessive) endorsement of a dialectics of nature and his continued practical restriction of dialectic to history and society -- directly relevant to assessing how far Lukács's "constructive theory" extends beyond the social-historical domain.

  POSITION: Identifies an unresolved internal contradiction in Lukács's Tailism-era position on the scope of dialectical method (nature versus society), complicating any simple contrast between Lukács's "Western" and orthodox Soviet Marxism on this question.
  },
  keywords = {tailism, dialectics-of-nature, Burkett, High},
  abstract = {Abstract The rejection of the ‘dialectics of nature’ has long been thought of as the most fundamental factor distinguishing Western Marxism from official Soviet-style Marxism. Yet, in Tailism and the Dialectic , Georg Lukács – perhaps the most influential figure in Western Marxism – strongly endorses the existence of an objective dialectic in nature. A close examination of Lukács’s main writings on science shows, however, that he still in effect denied the possibility of applying dialectical method to nature. This paradox is bound up with a dualistic conception of natural and social science with distinctly adverse implications for the development of an ecological Marxism.},
  abstract_source = {openalex},
}

@article{feenberg2015fracchiaburkett,
  author = {Feenberg, Andrew},
  title = {Fracchia and Burkett on Tailism and the Dialectic: A Response},
  journal = {Historical Materialism},
  year = {2015},
  volume = {23},
  number = {2},
  pages = {228--238},
  doi = {10.1163/1569206X-12341405},
  note = {
  CORE ARGUMENT: Feenberg responds to Fracchia's and Burkett's critiques (above) of Tailism and the Dialectic, addressing in particular Lukács's theory of class consciousness and his views on the social construction of nature, and develops alternative interpretations of Lukács's positions that resist both the "philosophical Leninism" charge and the charge of an unresolved contradiction over the dialectics of nature.

  RELEVANCE: Completes the three-way Historical Materialism exchange on Tailism and the Dialectic that forms the core of this domain's treatment of the internal Tailism debate, providing the defensive counter-reading against which Fracchia's and Burkett's critiques must be assessed.

  POSITION: Defends Lukács's Tailism-era positions against the party-authoritarianism and nature-dialectics critiques, offering a more sympathetic (though not uncritical) reading than Fracchia or Burkett.
  },
  keywords = {tailism, dialectics-of-nature, class-consciousness, Feenberg, High},
  abstract = {This commentary addresses criticism of Lukács’s early book Tailism and the Dialectic: A Defence of History and Class Consciousness. Two critiques published in Historical Materialism are analysed and alternative interpretations of Lukács’s theory developed. The commentary focuses on Lukács’s theories of class consciousness and his ideas on the social construction of nature.},
  abstract_source = {openalex},
}

@article{moir2020archimedeanpoint,
  author = {Moir, Cat},
  title = {The Archimedean Point: Consciousness, Praxis, and the Present in Lukács and Bloch},
  journal = {Thesis Eleven},
  year = {2020},
  volume = {157},
  number = {1},
  pages = {3--23},
  doi = {10.1177/0725513620911790},
  abstract = {This article consists of an original translation of Ernst Bloch's 1923 review of Lukács History and Class Consciousness, preceded by a translator's introduction contextualising Bloch's review and interpreting what it tells us about the intellectual and personal relationship between Bloch and Lukács. I argue that Bloch's review highlights some of the key differences and points of intersection between their thinking. Written when their personal relationship had already soured for both political and intellectual reasons, Bloch's review makes clear his ongoing commitment to a form of utopianism Lukács had long abandoned. Unlike Lukács, who in History and Class Consciousness argued that the dialectical method could only be applied to the social realm, Bloch followed Engels in developing a dialectics of nature. However, even if Bloch was less willing to become involved in party politics than his erstwhile friend, as the review reveals, both men ultimately emphasised the present moment as the privileged locus of urgent political action.},
  abstract_source = {semanticscholar},
  note = {
  CORE ARGUMENT: Moir's introduction and translation of Ernst Bloch's contemporaneous 1923 review of History and Class Consciousness shows that Bloch, unlike Lukács, never restricted dialectical method to the social realm and retained a Blochian, utopian dialectics of nature that Lukács's HCC-era position explicitly rejected (a rejection later partially reversed in Tailism, per Burkett above). Despite this disagreement and their by-then-soured friendship, Moir argues both thinkers converged on treating the present moment -- the "Archimedean point" -- as the privileged site of revolutionary praxis.

  RELEVANCE: Provides primary-source (in translation) contemporaneous reception evidence bearing directly on the dialectics-of-nature question central to the Tailism debate, and on this domain's concern with the temporal/teleological structure of Lukácsian praxis (the "present" as the point from which totality becomes graspable and actionable).

  POSITION: Reception-historical/translation study situating Lukács's praxis concept against Bloch's rival, nature-inclusive dialectical utopianism, while identifying a shared emphasis on present-oriented revolutionary action.
  },
  keywords = {tailism, dialectics-of-nature, Bloch, praxis, Moir, Medium}
}

@article{menozzi2022readinghegel,
  author = {Menozzi, Filippo},
  title = {Reading Hegel after Marx: Lukács and the Question of Teleology},
  journal = {International Critical Thought},
  year = {2022},
  volume = {12},
  number = {1},
  pages = {98--115},
  doi = {10.1080/21598282.2022.2035792},
  abstract = {ABSTRACT This paper offers a rethinking of the concept of teleology in Marxist theory. In particular, I propose some reflections on György Lukács's teleology of labour, addressed in The Young Hegel and subsequently reworked in The Ontology of Social Being. Lukács challenged an idealist notion of teleology understood as realisation of a transcendental principle posited a priori. He redefined the concept by showing how Hegel and Marx reintroduced the question of purpose as an essential quality of human labour. Against idealist conceptions, Lukács reimagined teleology as a secular purpose inherent to human praxis and the key to thinking agency within a materialist concept of history. Accordingly, a Marxist concept of teleology should highlight what Ernst Bloch described as the "anticipatory" character of consciousness, whereby teleology means the positing of an end that does not yet exist in reality and that exceeds the temporal horizon of the present. However, in his critique of Hegel, Lukács illustrates the ambivalent and contradictory dimension of teleology, a perspective that constantly relapses into temporal closure and determinism. While proposing a radical reading of Hegel, Lukács oscillates between the two extremes of a dialectical notion of teleology that he nonetheless helped to formulate.},
  abstract_source = {semanticscholar},
  note = {
  CORE ARGUMENT: Menozzi argues that Lukács's concept of teleology -- developed in The Young Hegel and reworked in the later Ontology of Social Being -- oscillates between two incompatible poles: a genuinely materialist, "anticipatory" teleology of labor (positing an end not yet real, following Bloch's terminology) that would make agency and open-ended historical possibility central to Marxist theory, and a residual, closed determinism inherited from the very Hegelian dialectic Lukács otherwise criticizes for idealist teleology.

  RELEVANCE: Directly answers this domain's fourth key question -- whether Lukács's account entails teleology, and of what kind -- with a nuanced "both/and" answer: Lukács's teleology is neither simply Hegelian-determinist nor simply open-ended, but an unstable oscillation between the two that Lukács himself never resolves.

  POSITION: Diagnoses an internal, unresolved tension in Lukács's concept of historical teleology between anticipatory/open and determinist/closed poles, using Bloch's account of anticipatory consciousness as the normative standard against which Lukács's ambivalence is measured.
  },
  keywords = {teleology, labor, Hegel, Bloch, Menozzi, High}
}

@article{jay2018fidelitytoevent,
  author = {Jay, Martin},
  title = {Fidelity to the Event? Lukács' History and Class Consciousness and the Russian Revolution},
  journal = {Studies in East European Thought},
  year = {2018},
  volume = {70},
  number = {2-3},
  pages = {195--213},
  doi = {10.1007/s11212-018-9307-3},
  note = {
  CORE ARGUMENT: Jay argues that History and Class Consciousness presupposes that "history" can be understood as a unified, meaningful meta-narrative -- readable, structurally, like a realist novel -- in which the present contains "objective possibilities" that the proletariat, as history's destined agent, can identify and realize through revolutionary intervention. Jay contends that in the century since the Russian Revolution it has become impossible to read history as a singular, triumphalist narrative culminating in emancipation, or to identify any single group as its subjective agent, and examines attempts (by Badiou and Žižek) to salvage Lukács's revolutionary potential through a non-teleological "fidelity to the Event" that replaces historical necessity with contingent, retroactively constituted commitment.

  RELEVANCE: Addresses this domain's fourth key question at the level of narrative form: Lukács's constructive theory requires treating history as having a single meaningful direction and a single collective subject, and Jay assesses whether later attempts to detach the revolutionary charge of HCC from this teleological narrative structure (Badiou's, Žižek's "Event") actually succeed or merely substitute one figural device (Erich Auerbach's figura) for another.

  POSITION: Skeptical historical-critical reading arguing that Lukács's theory of history is inseparable from a teleological, singular-subject narrative structure that cannot survive translation into non-teleological, "Event"-based frameworks without significant loss.
  },
  keywords = {teleology, historical-narrative, Badiou, Žižek, Jay, High, INCOMPLETE, no-abstract}
}

@book{rockmore1992irrationalism,
  author = {Rockmore, Tom},
  title = {Irrationalism: Lukács and the Marxist View of Reason},
  year = {1992},
  publisher = {Temple University Press},
  address = {Philadelphia},
  note = {
  CORE ARGUMENT: Rockmore situates Lukács's account of reason -- both his critique of bourgeois "irrationalism" (elaborated later in The Destruction of Reason) and his own constructive resolution of the antinomies of bourgeois thought via the standpoint of the proletariat -- within a broader Marxist thesis that reason is historically and socially conditioned (a form of contextualism) rather than a fixed, transcendent faculty, and assesses how far this historicized conception of reason can underwrite Lukács's confidence in the proletariat's capacity to grasp the social totality rationally.

  RELEVANCE: Connects this domain's resolution of the antinomies (the standpoint of the proletariat, treated at length in Domain 2's Jaffe and López entries) to a broader argument about the historically conditioned status of reason itself, supplying philosophical grounding for why Lukács thinks a specific social position (the proletariat's) could yield superior rational insight into the totality.

  POSITION: Reconstructs Lukács's theory of reason as a historicized, contextualist alternative to both bourgeois transcendent rationalism and party-orthodox scientism, evaluating its coherence as a properly Marxist epistemology.
  },
  keywords = {reason, antinomies, standpoint, Rockmore, Medium, INCOMPLETE, no-abstract}
}

@book{lukacs1975younghegel,
  author = {Lukács, Georg},
  title = {The Young Hegel: Studies in the Relations Between Dialectics and Economics},
  year = {1975},
  publisher = {MIT Press},
  address = {Cambridge, MA},
  note = {
  CORE ARGUMENT: Written in Moscow in 1938 (defended as Lukács's doctoral thesis in 1942, published 1948) and translated by Rodney Livingstone, this study traces four phases of Hegel's intellectual development -- the early republican/theological writings, the crisis leading to the earliest dialectical method, the "objective idealism" of the Jena period, and the break with Schelling culminating in the Phenomenology of Spirit -- arguing throughout that Hegel's dialectic emerged from sustained engagement with the categories of English and Scottish political economy (labour, alienation, civil society) rather than from purely speculative theology.

  RELEVANCE: This is the primary text in which Lukács explicitly claims to locate the "materialist" or economic substratum already latent within Hegel's idealist system, providing the direct textual basis for assessing what Lukács means by "materializing" Hegel's dialectic and philosophy of history, and for tracing continuities between his 1923 reading of Hegel in HCC and his mature, post-Stalinist Hegel scholarship.

  POSITION: Primary source; the mature-Lukács counterpart to HCC's more polemical 1923 engagement with Hegel, undertaken partly to defend Hegel's dialectic against charges (associated with Lukács's own later The Destruction of Reason) that it issues in irrationalism.
  },
  keywords = {Young-Hegel, Hegel-philosophy-of-history, dialectic, primary-source, High, INCOMPLETE, no-abstract}
}

@book{meszaros1972lukacsdialectic,
  author = {Mészáros, István},
  title = {Lukács' Concept of Dialectic},
  year = {1972},
  publisher = {Merlin Press},
  address = {London},
  note = {
  CORE ARGUMENT: Mészáros, a former student of Lukács, reconstructs the categories of totality and mediation that structure Lukács's dialectic across his career, arguing that Lukács's central philosophical achievement is the demonstration that Marx's dialectical method depends on categories (totality, mediation, subject-object identity) inherited from Hegel's Logic and Phenomenology and redeployed against static, positivist Second-International Marxism.

  RELEVANCE: As an early and philosophically sympathetic account by someone with direct access to Lukács, this work anchors the "legitimate reconstruction" reading of Lukács's Hegel-Marx synthesis against later, more critical accounts (Rockmore) that treat the same synthesis as an idealist distortion.

  POSITION: Sympathetic-reconstructionist reading of Lukács's Hegelian Marxism, contemporaneous with the early reception of the 1967 self-critical preface to HCC.
  },
  keywords = {dialectic, totality, mediation, Hegelian-Marxism, Medium, INCOMPLETE, no-abstract}
}

@article{day1989dialecticfreedom,
  author = {Day, Richard B.},
  title = {Hegel, Marx, Lukács: The Dialectic of Freedom and Necessity},
  journal = {History of European Ideas},
  year = {1989},
  volume = {11},
  number = {1-6},
  pages = {907--934},
  doi = {10.1016/0191-6599(89)90279-9},
  note = {
  CORE ARGUMENT: Day traces the concept of freedom-through-recognition-of-necessity from Hegel's philosophy of history, through Marx's account of communism as the transition from the realm of necessity to the realm of freedom, to Lukács's use of this same architecture in his theory of class consciousness and historical agency.

  RELEVANCE: Provides a direct genealogical account of how a specific structural feature of Hegel's philosophy of history (freedom as the teleological outcome of necessity) survives, transformed, in Lukács's theory of proletarian class consciousness as historical agency -- a central plank of any account of Lukács's constructive theory of history.

  POSITION: Genealogical/continuity reading situating Lukács within a Hegel-Marx lineage organized around the freedom/necessity dialectic rather than around reification specifically.
  },
  keywords = {Hegel-philosophy-of-history, freedom-necessity, dialectic, Medium},
  abstract = {(1989). Hegel, Marx, Lukacs: The dialectic of freedom and necessity. History of European Ideas: Vol. 11, No. 1-6, pp. 907-934.},
  abstract_source = {openalex}
}

@book{normansayers1980debate,
  author = {Norman, Richard and Sayers, Sean},
  title = {Hegel, Marx and Dialectic: A Debate},
  year = {1980},
  publisher = {Harvester Press},
  address = {Brighton},
  note = {
  CORE ARGUMENT: In this exchange, Norman and Sayers debate whether Marx's dialectical method in Capital is continuous with Hegel's logic (Sayers's position) or whether Marx's materialism requires a decisive break from Hegelian idealist categories (Norman's position), using the status of contradiction, totality, and the abstract-to-concrete method of exposition as test cases.

  RELEVANCE: Establishes the wider methodological dispute -- continuity versus rupture between Hegel's logic and Marx's dialectical method in Capital -- against which Lukács's own claim to have "materialized" Hegel's dialectic must be assessed; Lukács's position in HCC anticipates Sayers's continuity thesis before this debate was formalized.

  POSITION: Internal debate between a continuity thesis (Sayers) and a rupture thesis (Norman) regarding Hegel's presence in Marx's mature method.
  },
  keywords = {Hegel-Marx-relation, dialectic, Capital-method, Medium, INCOMPLETE, no-abstract}
}

@article{markus1982alienationreification,
  author = {Márkus, György},
  title = {Alienation and Reification in Marx and Lukács},
  journal = {Thesis Eleven},
  year = {1982},
  volume = {5-6},
  number = {1},
  pages = {139--161},
  doi = {10.1177/072551368200500111},
  note = {
  CORE ARGUMENT: Writing against the backdrop of the 1960s-70s "Marx-Renaissance" and the rehabilitation of the young Marx's 1844 Manuscripts, Márkus argues that Marx's category of alienation (rooted in a Feuerbachian-humanist account of species-being and objectification) and Lukács's category of reification (derived from the analysis of commodity fetishism read through Weber and Simmel) are conceptually distinct despite their frequent conflation in the "humanist Marxism" literature, and traces how each concept differently diagnoses the pathology of capitalist society.

  RELEVANCE: Directly addresses the interpretive puzzle at the center of this domain: whether HCC's apparent anticipation of the 1844 Manuscripts (published nine years after HCC, in 1932) is a substantive philosophical convergence or a more superficial terminological overlap masking two distinct theoretical projects.

  POSITION: Differentiates alienation and reification as non-identical categories, cutting against readings that treat HCC as a de facto restatement of the 1844 Manuscripts avant la lettre.
  },
  keywords = {alienation, reification, 1844-Manuscripts, Marx-Renaissance, High, INCOMPLETE, no-abstract}
}

@article{rockmore1980lukacsclassicalgerman,
  author = {Rockmore, Tom},
  title = {Lukács on Classical German Philosophy and Marx},
  journal = {Idealistic Studies},
  year = {1980},
  volume = {10},
  number = {3},
  pages = {209--231},
  doi = {10.5840/idstudies19801036},
  note = {
  CORE ARGUMENT: Rockmore argues that Lukács's extensive knowledge of classical German philosophy shaped an interpretation of Marx so influential that later reconstructions of Marx's position by figures as different as Sartre and Habermas remain dependent on Lukács's own prior, philosophically loaded reading of Marx through Hegel and Fichte.

  RELEVANCE: Opens Rockmore's long-running case that Lukács's reading of Marx is not a neutral recovery of Marx's own method but an interpretive imposition whose subsequent influence has obscured what Marx's texts actually say, making it a key counterpoint to reconstructionist readings (Mészáros, Day) of Lukács's Hegelianism.

  POSITION: Early statement of Rockmore's thesis that Lukács's Marx-interpretation is philosophically overdetermined by classical German idealism and has shaped the entire subsequent reception of Marx.
  },
  keywords = {Lukacs-Marx-interpretation, Hegelianization, Rockmore, High, INCOMPLETE, no-abstract}
}

@article{rockmore1992fichtelask,
  author = {Rockmore, Tom},
  title = {Fichte, Lask, and Lukács's Hegelian Marxism},
  journal = {Journal of the History of Philosophy},
  year = {1992},
  volume = {30},
  number = {4},
  pages = {557--577},
  doi = {10.1353/hph.1992.0079},
  note = {
  CORE ARGUMENT: Rockmore reconstructs the specific philosophical channel through which Lukács's Marxism became Hegelian: not directly from Hegel, but mediated by Fichte's subject-object identity philosophy and by the neo-Kantian philosopher Emil Lask, whose theory of categorial forms shaped Lukács's pre-Marxist thought and was carried over, transformed, into HCC's account of the identical subject-object of history.

  RELEVANCE: Provides the most philosophically precise account available of the actual transmission route -- Fichte and Lask, not Hegel directly -- by which Lukács's dialectic acquired its idealist and Hegelian coloring, making it essential for evaluating whether Lukács "materializes" Hegel or instead re-idealizes Marx via a Fichtean detour.

  POSITION: Central statement of the "Hegelianization-via-Fichte/Lask" reading, treating Lukács's Marxism as a philosophically distinct, idealism-inflected construction rather than a transparent recovery of Marx's own method.
  },
  keywords = {Fichte, Lask, neo-Kantianism, subject-object-identity, High},
  abstract = {WITH KARL KORSCH, Georg Lukács is widely known as one of the two founders of Hegelian Marxism. Although Lukács is one of the most significant students of Hegel in this century, Marxist or otherwise, and although his Marxism is partially based on his reading of Hegel's position, it is an error to consider his Marxism as basically Hegelian for two reasons. First, Lukács's reading of classical German philosophy depends crucially on his creative extension of Kant's problem of the thing-in-itself to all of classical German philosophy from Kant to Hegel. Second, Lukács argues in detail that classical German philosophy is unable to resolve the problem of the thing-in-itself, but that the latter is resolved by Marx. Lukács's reading of Marx's solution of the Kantian problem, which he extends to all of classical German philosophy, depends on his appropriation of Fichte's position. The article discusses the nature and significance of Fichte's role, both directly and through the intermediary of Emil Lask, in the constitution of Lukács's distinctive form of Marxism, showing that Lukács's Marxism is not only Hegelian, but Kantian, Fichtean, and neo-Kantian as well.},
  abstract_source = {openalex}
}

@article{rockmore2023hegeloriginsmarxism,
  author = {Rockmore, Tom},
  title = {Hegel and the Origins of Marxism---Remarks on Russian and Chinese Marxism},
  journal = {Studies in East European Thought},
  year = {2023},
  volume = {76},
  number = {2},
  pages = {193--211},
  doi = {10.1007/s11212-023-09542-0},
  note = {
  CORE ARGUMENT: Rockmore extends his long-standing thesis about the Hegelian sources of Marxism to the specifically Russian and Chinese receptions of Marx, arguing that different national Marxisms constructed different, philosophically incompatible versions of "Hegel's Marx," of which Lukács's own Hegelian Marxism is one influential but historically contingent variant rather than the uniquely correct reconstruction.

  RELEVANCE: Situates Lukács's particular Hegel-Marx synthesis within a comparative field of competing national Marxist appropriations of Hegel, underscoring that Lukács's "materialization" of Hegel was one contested option among several rather than a philosophically necessary outcome.

  POSITION: Comparative extension of Rockmore's Hegelianization thesis beyond the Western-Marxist context in which Lukács is usually read.
  },
  keywords = {Hegel-Marx-relation, comparative-Marxism, Rockmore, Medium, INCOMPLETE, no-abstract}
}

@book{finelli2016failedparricide,
  author = {Finelli, Roberto},
  title = {A Failed Parricide: Hegel and the Young Marx},
  year = {2016},
  publisher = {Brill},
  address = {Leiden},
  doi = {10.1163/9789004307643},
  note = {
  CORE ARGUMENT: Finelli argues that the young Marx's critique of Hegel remained structurally subaltern to Hegel's own conception of the subject as constituted through relation to alterity: Marx's 1843-44 writings did not achieve the decisive break from Hegelian categories they claimed, but reproduced a Hegelian logic of the subject even while inverting its idealist content into materialist terms.

  RELEVANCE: Offers an influential recent counter-model to Lukács's own claim (in The Young Hegel and HCC) that Marx's dialectic represents a clean "materialization" of Hegel; if Finelli is right that even Marx's own break from Hegel was incomplete, this substantially complicates any claim that Lukács's subsequent reading of Marx achieves the fuller materialization Lukács asserts.

  POSITION: Argues for structural continuity (a "failed parricide") between Hegel's philosophy of subjectivity and the young Marx, a position with direct implications for assessing the depth of any later "materialization" of Hegel, including Lukács's.
  },
  keywords = {Hegel-Marx-relation, young-Marx, subject-object, Medium},
  abstract = {According to an established interpretation, the transition from Hegel's materialism to Marx's materialism signifies a progressive development from an abstract-idealist theory of becoming, to a theory of the concrete actions of human beings within history. A Failed Parricide by Roberto Finelli offers an innovative reading of the Marx-Hegel relationship, arguing that the young Marx remained structurally subaltern to Hegel's distinctive conception of the subject that becomes itself in relation to alterity. Marx's early critique of Hegel is represented as a 'failed parricide', relying upon an organicist and spiritualist anthropology derived from Feuerbach's presumed materialism. Only in Marx's mature critique of political economy will he be able to return to this 'primal scene' and produce a distinctive theory of the role of formal determinations in social and political modernity.},
  abstract_source = {openalex}
}

@book{arthur2004newdialectic,
  author = {Arthur, Christopher J.},
  title = {The New Dialectic and Marx's Capital},
  year = {2004},
  publisher = {Brill},
  address = {Leiden},
  doi = {10.1163/9789047402886},
  note = {
  CORE ARGUMENT: Arthur reconstructs Capital as a "systematic dialectical" exposition modeled on the categorial movement of Hegel's Science of Logic, arguing that Marx's method of presentation -- moving from the abstract commodity-form through increasingly concrete categories -- is best understood via a Hegelian logic of contradiction internal to the value-form itself, a reading subsequently contested by Finelli's emphasis on practical, production-based abstraction (Historical Materialism, 2007-2009 exchange).

  RELEVANCE: Supplies the most developed contemporary account of what a properly "Hegelian" reading of Capital's method (abstraction, the commodity-form, systematic exposition) looks like, against which Lukács's own, much earlier and less systematic invocation of Hegelian categories (totality, mediation) in HCC and the reification essay can be measured for methodological rigor and fidelity to Capital's actual argument.

  POSITION: Systematic-dialectical reading of Capital's method as internally Hegelian, representing one pole (abstraction located in exchange/value-form) of the Arthur-Finelli debate over the status of abstraction in Marx.
  },
  keywords = {Capital-method, abstraction, systematic-dialectic, Hegel-Marx-relation, Medium},
  abstract = {This book both argues for, and demonstrates, a new turn to dialectic. Marx's Capital was clearly influenced by Hegel's dialectical figures: here, case by case, the significance of these is clarified. More, it is argued that, instead of the dialectic of the rise and fall of social systems, what is needed is a method of articulating the dialectical relations characterising a given social whole. Marx learnt from Hegel the necessity for a systematic development, and integration, of categories; for example, the category of 'value' can be fully comprehended only in the context of the totality of capitalist relations. These studies thus shed new light on Marx's great work, while going beyond it in many respects.},
  abstract_source = {openalex}
}

@article{potamias2024masterslave,
  author = {Potamias, Spyros},
  title = {The Hegelian Master--Slave Dialectic in History and Class Consciousness},
  journal = {Open Philosophy},
  year = {2024},
  volume = {7},
  number = {1},
  doi = {10.1515/opphil-2024-0012},
  note = {
  CORE ARGUMENT: Potamias argues that HCC adopts from Hegel's dialectic not only the category of totality (as usually emphasized) but also, more subtly, the master-slave dialectic, shaping the Lukácsian concepts of reification, praxis, working-class self-consciousness, and the standpoint of the proletariat, largely via Kojève's labour-centered interpretation of Hegel's mastery-slavery relation together with occasional explicit references Lukács makes to it in The Young Hegel.

  RELEVANCE: Identifies a specific, previously underemphasized Hegelian source (the master-slave dialectic, mediated through the labour-centered reading later made famous by Kojève) feeding directly into Lukács's account of proletarian class consciousness as historical agency, refining the more general claim that Lukács draws on Hegel's "philosophy of history."

  POSITION: Textual-source study identifying the master-slave dialectic as an implicit but structurally important Hegelian input into HCC, alongside the more commonly cited category of totality.
  },
  keywords = {master-slave-dialectic, HCC, Kojeve, class-consciousness, Medium},
  abstract = {The central axis of the article is the argument that History and Class Consciousness adopts from the Hegelian dialectics not only the category of totality but also the master–slave dialectic, although it never refers explicitly to the latter. Hence, in this article, we aim to detect the subtle influence that the Hegelian master–slave dialectic exerts on History and Class Consciousness and, more specifically, on the constitution of the Lukacsian concepts of reification, praxis, working class-bourgeoisie interaction, working-class self-consciousness, autonomous subject. Our approach to the Hegelian master–slave dialectic is mostly -- but not only -- based on its philosophical–anthropological interpretation by A. Kojeve. Kojeve's interpretation, by attributing a crucial role to labour in the mastery–slavery dialectic, focuses on that aspect of the Hegelian dialectic which, in our estimation, was determining for HCC. In addition, our approach to the Hegelian master–slave dialectic is based on some occasional references Lukacs has to it in Young Hegel as well as on his interpretation latent in History and Class Consciousness.},
  abstract_source = {s2}
}

@article{ninos2025labourteleological,
  author = {Ninos, Giannis},
  title = {Labour as Teleological Positing in Lukács' Ontology of Social Being and Hegel's Philosophical Background: A Critical Reappraisal},
  journal = {Thesis Eleven},
  year = {2025},
  volume = {193},
  number = {1},
  pages = {124--144},
  doi = {10.1177/07255136251381380},
  note = {
  CORE ARGUMENT: Ninos argues that Lukács's late analysis of labour as teleological positing in the Ontology of Social Being is shaped by his reading of Hegel's Logic, particularly the doctrine of essence, which leads Lukács to prioritize the goal-directed and cognitive aspects of subjectivity in labour; the article identifies both methodological inconsistencies in this analysis and the absence of a more dynamic, speculative-dialectical presentation of labour that a fuller engagement with Hegel's Logic might have supplied.

  RELEVANCE: Extends the Hegel-Lukács relationship into Lukács's final, posthumously published ontology, showing that his engagement with Hegel's Logic (as opposed to the Phenomenology, the focus of The Young Hegel) remained active and unresolved throughout his career, directly bearing on how continuous or discontinuous his mature theory of history is with the Hegelian sources first mobilized in the 1920s-30s.

  POSITION: Critical reappraisal identifying persistent, unresolved tensions in Lukács's use of Hegel's Logic in his final ontological work on labour and teleology.
  },
  keywords = {teleological-positing, Ontology-of-Social-Being, Hegel-Logic, labour, Medium},
  abstract = {The article examines the interconnection between Lukács' analysis of labour as teleological positing in his late social ontology and his interpretation of Hegel's philosophy. It argues that Lukács' reading of Hegel's Logic, particularly his emphasis on the doctrine of essence, prioritizes the goal and cognitive aspects of subjectivity in his analysis of labour. By reconstructing the core aspects of Lukács' analysis of labour, the article highlights how this ontological priority of teleological positing stems from the modality of categorial relations in the doctrine of essence to which Lukács is committed. In doing so, it draws attention to both methodological inconsistencies in his analysis of labour and its crucial insights, while stressing the absence of a more speculative-dialectical presentation that could frame labour in more dynamic terms. The article thus underscores the importance of the late Lukács' unfinished social ontology for debates on the dialectical method and critical theory.},
  abstract_source = {s2}
}

@article{azeri2022engelsdialectics,
  author = {Azeri, Siyaveş},
  title = {Engels' Dialectics of---Human Activity in---Nature},
  journal = {Marxism \& Sciences},
  year = {2022},
  doi = {10.56063/ms.2201.01105},
  note = {
  CORE ARGUMENT: Azeri defends Engels against the Lukácsian charge (from HCC's famous footnote restricting dialectics to society and history) that Engels' dialectics of nature rests on a non-dialectical, non-philosophical misunderstanding of the Kantian thing-in-itself; Azeri argues Engels' account of praxis/labour as constitutive of both nature and consciousness is truthful to Marx's materialist method and anticipates later accounts of "human activity" in Ilyenkov and Vygotsky.

  RELEVANCE: Directly engages the dialectics-of-nature dispute at the heart of the Lukács-Engels methodological disagreement noted in the search brief, providing a contemporary defense of Engels against Lukács's HCC-era restriction of dialectics to the historical-social domain, a restriction Lukács himself later revised.

  POSITION: Pro-Engels rehabilitation, arguing that Lukács's HCC-era critique of Engels' dialectics of nature rests on a misreading of Engels rather than a genuine philosophical deficiency in Engels' position.
  },
  keywords = {dialectics-of-nature, Engels, HCC-critique, Ilyenkov, Medium},
  abstract = {Several Marxist theorists criticize Engels for his supposed non-dialectical and non-philosophical conceptualization of "praxis," which, according to Lukacs, amounts to Engels' alleged misunderstanding of the Kantian "thing-in-itself." This paper argues that such criticisms of Engels are based on a dualistic understanding of practical vs. theoretical. Contrary to the critiques' allegations, Engels provides an account of praxis/labour as a philosophical category that is truthful to Marx's and his own earlier efforts at constituting a materialist dialectics -- one that anticipates the concept of "human activity" elaborated particularly in the philosophical works of Evald Ilyenkov and psychological studies of Lev Vygotsky. According to Engels, the so-called laws of dialectics are historical, depending on human activity, and it is through labour that human consciousness has been constituted. Engels, truthful to Marx's materialist method, prioritizes action over substance.},
  abstract_source = {s2}
}

@article{jutten2011verdinglichung,
  author = {Jütten, Timo},
  title = {Verdinglichung und Freiheit},
  journal = {Deutsche Zeitschrift für Philosophie},
  year = {2011},
  volume = {59},
  number = {5},
  pages = {717--730},
  doi = {10.1524/dzph.2011.59.5.717},
  note = {
  CORE ARGUMENT: Jütten examines Lukács's claim, made in HCC, that overcoming reification amounts to the realization of the identity-philosophies of Fichte and Hegel, arguing that Lukács does indeed contrast reification with a recognizably Hegelian conception of social freedom that remains philosophically plausible today, since reification occurs precisely when the preconditions of freedom and social participation are eroded by commodification and juridification.

  RELEVANCE: Directly documents the specific textual point at which Lukács explicitly claims to be "materializing" or realizing Fichte's and Hegel's identity-philosophy through the overcoming of reification, supplying precise evidence for the domain's central question about where and how Lukács stakes this claim.

  POSITION: Sympathetic reconstruction defending the coherence and continued plausibility of Lukács's identification of de-reification with the realization of Hegelian/Fichtean identity-philosophy.
  },
  keywords = {reification, Fichte, identity-philosophy, freedom, Medium},
  abstract = {In this paper I examine Lukacs' claim that the overcoming of reification amounts to the realization of the identity philosophies of Fichte and Hegel. I suggest that Lukacs does indeed contrast reification with a Hegelian conception of social freedom that remains plausible today. Reification occurs when the preconditions of freedom and social participation are eroded through practices such as commodification and juridification. I conclude with the claim that reification diminishes freedom, and that criticism of reification is itself a form of freedom.},
  abstract_source = {openalex}
}

@book{kain1986marxmethod,
  author = {Kain, Philip J.},
  title = {Marx' Method, Epistemology, and Humanism: A Study in the Development of His Thought},
  year = {1986},
  publisher = {Springer},
  address = {Dordrecht},
  series = {Sovietica},
  doi = {10.1007/978-94-009-4646-0},
  abstract = {In recent writings on Marx one finds an increasing interest in his humanism. This phenomenon began in the third decade of our century as a reaction against the mechanistic and stereotyped image of Marx characteristic of the Second International and of Stalinism. Lukacs, in History and Class Consciousness (1923), was one of the first to discover this new Marx, and he did so even before the most important of the humanistic writings of the young Marx had been discovered. With the publication of these writings in 1932 -- namely, the Economic and Philosophic Manuscripts of 1844 -- this new outlook was given enormous impetus. In these Manuscripts, Marx makes the human being the creator and the goal of all reality.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Kain situates the 1920s "discovery" of Marx's humanism -- of which Lukács's HCC (1923) was among the earliest instances, preceding the 1932 publication of the 1844 Manuscripts by nine years -- within the broader development of Marx's epistemology and doctrine of nature, tracing how the humanist reading was subsequently vindicated and complicated by the Manuscripts themselves.

  RELEVANCE: Explicitly identifies Lukács's HCC as historically anticipating the humanist Marx later confirmed by the 1844 Manuscripts, directly addressing the domain's central interpretive puzzle and dating precisely how Lukács could have anticipated themes from a text not yet public.

  POSITION: Treats Lukács's 1923 anticipation of the young Marx's humanism as a genuine, historically significant convergence, in implicit tension with Márkus's more skeptical distinction between alienation and reification.
  },
  keywords = {1844-Manuscripts, humanism, Marx-method, anticipation, High}
}

@book{sayers2011marxalienation,
  author = {Sayers, Sean},
  title = {Marx and Alienation: Essays on Hegelian Themes},
  year = {2011},
  publisher = {Palgrave Macmillan},
  address = {Basingstoke},
  doi = {10.1057/9780230309142},
  note = {
  CORE ARGUMENT: Across essays on creative activity, labour, freedom and necessity, private property, and communism, Sayers argues for the deep continuity between Hegel's account of self-realization through objectifying activity and Marx's theory of alienated and unalienated labour, situating Marx's critique of capitalism within, rather than against, the Hegelian tradition of thinking human self-development through externalization and its overcoming.

  RELEVANCE: Provides the fullest recent defense of reading Marx's concept of alienation as continuous with Hegelian themes of externalization (Entäußerung) and estrangement (Entfremdung), giving a contemporary benchmark against which to assess whether Lukács's reification-based reading of HCC captures the same Hegelian inheritance as Marx's own alienation-based critique, or diverges from it as Márkus argues.

  POSITION: Defends a strongly Hegelian reading of Marx's alienation, complementing Márkus's alienation/reification distinction by specifying more precisely what "Hegelian" content Marx's own concept of alienation actually carries.
  },
  keywords = {alienation, Hegelian-themes, labour, Marx, Medium},
  abstract = {The concepts of alienation and its overcoming are central to Marx's thought. They underpin his critique of capitalism and his vision of future society. Marx's ideas are explained in rigorous and clear terms, situated in the context of the Hegelian ideas that inspired them and put into dialogue with contemporary debates.},
  abstract_source = {openalex}
}

@article{maidansky2025hegelmirrors,
  author = {Maidansky, Andrey},
  title = {Hegel in the Mirrors of Soviet Philosophy},
  journal = {The Russian Journal of Cultural Studies and Communication},
  year = {2025},
  volume = {3},
  number = {2},
  pages = {47--59},
  doi = {10.24833/rjcsc-2024-3-2-47-59},
  abstract = {The attitude towards Hegel in Soviet philosophy was contradictory and depended to a considerable extent on the ideological state of affairs. Waves of love and hate for Hegel alternated periodically... Georgy Lukács, who came to the Soviet Union, wrote his famous The Young Hegel here and defended this book as his doctoral thesis (1942). Lifshitz and Lukács concentrate on Hegel's "historical dialectic" and on his comprehension of the revolutionary events of his epoch.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Maidansky surveys the fluctuating Soviet reception of Hegel from the 1920s Deborinite "Hegelian wing" through Stalinist denunciation of Hegel as an "aristocratic reaction to the French Revolution" to Ilyenkov's postwar rehabilitation of dialectics as the method of "ascent from the abstract to the concrete," situating Lukács's Moscow-exile composition and 1942 doctoral defense of The Young Hegel within this shifting ideological landscape.

  RELEVANCE: Supplies essential institutional and biographical context for The Young Hegel, showing that Lukács's study of Hegel's historical dialectic was written and defended under specific and shifting Soviet ideological constraints on Hegel scholarship, which bears on how to read the book's argument about Hegel's "materialist" economic sources.

  POSITION: Historical-contextual account of Soviet Hegel scholarship that positions The Young Hegel as one moment (alongside Lifshitz) within a broader, ideologically fraught Soviet engagement with Hegel's historical dialectic.
  },
  keywords = {Soviet-philosophy, Young-Hegel, Ilyenkov, reception-history, Low}
}

@book{lukacs1978ontologyhegel,
  author = {Lukács, Georg},
  title = {The Ontology of Social Being, Vol. 1: Hegel's False and his Genuine Ontology},
  year = {1978},
  publisher = {Merlin Press},
  address = {London},
  note = {
  CORE ARGUMENT: The first of three translated volumes of Lukács's late Ontology, this volume works through Hegel's Logic to distinguish a "false," idealist ontology (in which categories such as teleology are illegitimately extended to nature and history as a whole) from a "genuine" ontology Lukács finds latent in Hegel and which he proposes to extract and rework materialistically as the basis for a Marxist social ontology.
  RELEVANCE: Primary source establishing the Hegelian point of departure for the labor/teleology model surveyed throughout this domain; provides the direct textual basis against which Domain 4's Ninos and Menozzi articles on Lukács's use of Hegel's Logic must be read.
  POSITION: Primary text; Lukács's own critical reconstruction of Hegel's ontology as propaedeutic to a materialist social ontology.
  },
  keywords = {primary-source, Ontology-of-Social-Being, Hegel, teleology, High, INCOMPLETE, no-abstract}
}

@book{lukacs1978ontologymarx,
  author = {Lukács, Georg},
  title = {The Ontology of Social Being, Vol. 2: Marx's Basic Ontological Principles},
  year = {1978},
  publisher = {Merlin Press},
  address = {London},
  translator = {Fernbach, David},
  note = {
  CORE ARGUMENT: This volume reconstructs Marx's method as an implicit social ontology centered on the categories of social being, historicity, and the priority of economic/material reproduction, arguing that Marxism's philosophical core is best understood ontologically rather than epistemologically.
  RELEVANCE: Direct primary source for the domain's central question of how the late Lukács reframes historical materialism in ontological rather than subject-object-of-history terms; the volume against which the Budapest School's 1976 "two ontologies" charge (Fehér, Heller, Márkus, and Vajda, this domain) is principally directed.
  POSITION: Primary text; presents Marx's method as social ontology.
  },
  keywords = {primary-source, Ontology-of-Social-Being, Marx, historical-materialism, High, INCOMPLETE, no-abstract}
}

@book{lukacs1980ontologylabour,
  author = {Lukács, Georg},
  title = {The Ontology of Social Being, Vol. 3: Labour},
  year = {1980},
  publisher = {Merlin Press},
  address = {London},
  translator = {Fernbach, David},
  note = {
  CORE ARGUMENT: Lukács's fullest exposition of labor as the "model" of teleological positing: every labor-act involves setting a goal (teleology) that must be realized by manipulating an objectively existing causal chain, and this basic structure -- irreducible to either pure teleology (idealism) or pure causality (mechanistic materialism) -- is presented as the ontological root from which all higher social categories (value, ideology, language) genetically develop.
  RELEVANCE: The core primary text for this domain's first key question (the ontological reframing of history via labor, teleological positing, and the causal nexus); directly underlies the secondary debate captured in Fuchs, Blanton, Correa Castañeda, and the Budapest School critique.
  POSITION: Primary text; the fullest statement of the labor-teleology-causality model.
  },
  keywords = {primary-source, Ontology-of-Social-Being, labour, teleological-positing, causality, High, INCOMPLETE, no-abstract}
}

@article{lukacs1970dialecticlabor,
  author = {Lukács, Georg},
  title = {The Dialectic of Labor: Beyond Causality and Teleology},
  journal = {Telos},
  year = {1970},
  volume = {1970},
  number = {6},
  pages = {162--174},
  doi = {10.3817/0970006162},
  note = {
  CORE ARGUMENT: An early English-language excerpt/preview, appearing a year before the German Ontology volumes were published, in which Lukács lays out the core claim that labor is neither purely teleological (as idealism holds) nor purely causal (as mechanistic materialism holds) but a distinctive third category combining both.
  RELEVANCE: Documents that the labor-teleology-causality model reached Anglophone readers via Telos years before the Merlin Press translations of the full Ontology volumes appeared, shaping the Telos-circle's early (1970s) reception of the late Lukács surveyed alongside Domain 1's Macciò 1972 entry.
  POSITION: Primary text; earliest English-language statement of the labor-teleology-causality model.
  },
  keywords = {primary-source, labour, teleology, causality, Telos, Medium},
  abstract = {Abstract Marx says the following concerning the essence of labor: “We presuppose labour in a form that stamps it as exclusively human. A spider conducts operations that resemble those of a weaver, and a bee puts to shame many an architect in the construction of her cells. But what distinguishes the worst architect from the best of bees is this, that the architect raises his structure in imagination before he erects it in reality. At the end of every labour-process, we get a result that already existed in the imagination of the labourer at its commencement. He not only effects a change of form in the material on which he works, but he also realises a purpose of its own that gives the law to his modus operandi, and to which he must subordinate his will.”},
  abstract_source = {openalex},
}

@article{feherheller1976notes,
  author = {Fehér, Ferenc and Heller, Ágnes and Márkus, György and Vajda, Mihály},
  title = {Notes on Lukacs' Ontology},
  journal = {Telos},
  year = {1976},
  volume = {1976},
  number = {29},
  pages = {160--181},
  doi = {10.3817/0976029160},
  note = {
  CORE ARGUMENT: Writing as Lukács's own former students (the "Budapest School"), the authors argue that the unfinished Ontology manuscript oscillates between two incompatible projects: a genuinely dialectical, historically specific "ontology of social being" and a residual, quasi-Engelsian "general ontology" that illegitimately extends categories like causality and teleology across nature, biology, and society as a single evolutionary continuum, reproducing problems of orthodox Soviet dialectical materialism that HCC's early emphasis on the historical-social specificity of dialectics had been meant to avoid.
  RELEVANCE: The founding document of the "rupture/incompatibility" reading of the Ontology's relation to HCC; every subsequent defender of the Ontology's coherence (Tosel, Duayer and Medeiros, and Domain 1's Forczek) explicitly responds to this critique, making it the indispensable starting point for the domain's central continuity-vs-rupture debate.
  POSITION: Rupture/incompatibility reading: the Ontology mixes two incompatible ontologies and regresses toward orthodox Soviet Marxism rather than deepening HCC's dialectic.
  },
  keywords = {Budapest-School, two-ontologies, rupture, Feher, Heller, Markus, Vajda, High, INCOMPLETE, no-abstract}
}

@article{joos1977ontology,
  author = {Joós, Ernest},
  title = {Georg Lukács' Ontology},
  journal = {International Philosophical Quarterly},
  year = {1977},
  volume = {17},
  number = {2},
  pages = {121--134},
  note = {
  CORE ARGUMENT: An early Anglophone introduction to the still largely untranslated Ontology, presenting Lukács's late turn to social ontology as an attempt to secure Marxism's philosophical foundations against both idealist and mechanistic-materialist readings, via the categories of labor, teleological positing, and causality.
  RELEVANCE: Precursor to Joós's 1983 book-length study (this domain) and among the earliest English-language expository treatments of the Ontology, predating the Merlin Press translations; useful for tracing how the text was introduced to Anglophone readers before it was fully available in English.
  POSITION: Expository/introductory treatment aimed at establishing the Ontology's philosophical seriousness for an Anglophone audience unfamiliar with the untranslated German text.
  },
  keywords = {periodization, exposition, Joos, INCOMPLETE, no-abstract, Medium}
}

@book{joos1983autocriticism,
  author = {Joós, Ernest},
  title = {Lukács's Last Autocriticism: The Ontology},
  year = {1983},
  publisher = {Humanities Press},
  address = {Atlantic Highlands, NJ},
  note = {
  CORE ARGUMENT: Joós argues that the Ontology should be read as Lukács's considered, final "autocriticism" of his own earlier positions -- including HCC's identical-subject-object claim and the "messianic utopianism" of his early Marxist period -- rather than as an externally imposed political retraction, reconstructing the labor-teleology model as a philosophically motivated correction of the earlier work's idealist residues.
  RELEVANCE: The first full-length English-language monograph on the Ontology; directly frames the domain's second key question (does the Ontology abandon, revise, or fulfill the subject-object problematic of HCC?) by explicitly treating it as Lukács's own self-critical fulfillment of that problematic rather than an abandonment of it.
  POSITION: Fulfillment/self-correction reading: the Ontology is Lukács's own philosophically serious autocriticism of HCC's subject-object identity claim and early messianism.
  },
  keywords = {periodization, autocriticism, self-criticism, Joos, INCOMPLETE, no-abstract, High}
}

@incollection{tertulian1988ontology,
  author = {Tertulian, Nicolas},
  editor = {Rockmore, Tom},
  title = {Lukács' Ontology},
  booktitle = {Lukács Today: Essays in Marxist Philosophy},
  series = {Sovietica},
  year = {1988},
  publisher = {Springer Netherlands},
  pages = {243--273},
  doi = {10.1007/978-94-009-2897-8_14},
  note = {
  CORE ARGUMENT: Tertulian offers a systematic overview of the Ontology's categorial architecture (labor, teleological positing, causality, the genesis of ideology and value), presenting it as Lukács's mature and most philosophically ambitious work rather than a Stalinist-era decline, and situating it within twentieth-century ontology more broadly (alongside Hartmann and Heidegger).
  RELEVANCE: A foundational statement of the "fulfillment/deepening" position in the domain's central debate, published in the same Rockmore-edited volume that gathers much of the 1980s Anglophone scholarly reassessment of Lukács; explicitly named in the search brief as key secondary literature on the Ontology.
  POSITION: Fulfillment/deepening reading: the Ontology is Lukács's most serious and original philosophical achievement, continuous with but exceeding HCC.
  },
  keywords = {Tertulian, ontology, Hartmann, exposition, INCOMPLETE, no-abstract, High}
}

@article{tertulian2009heideggerontology,
  author = {Tertulian, Nicolas},
  title = {L'ontologie chez Heidegger et chez Lukacs -- Phénoménologie et dialectique},
  journal = {Kriterion: Revista de Filosofia},
  year = {2009},
  volume = {50},
  number = {119},
  pages = {23--41},
  doi = {10.1590/s0100-512x2009000100002},
  note = {
  CORE ARGUMENT: Tertulian confronts Heidegger's and Lukács's ontologies on several fundamental questions -- being-in-the-world, thrownness (Geworfenheit), the role of labor in human evolution, and the status of causality -- arguing that Lukács's genetic, dialectical ontological method (grounded in labor and the causal nexus) offers a materialist alternative to Heideggerian hermeneutic ontology, with particular attention to Lukács's critique of Geworfenheit.
  RELEVANCE: Places the late Ontology in direct philosophical confrontation with Heidegger's fundamental ontology, clarifying by contrast what is distinctive about Lukács's labor-based, genetic-dialectical approach to being and thereby sharpening the domain's account of what "ontological reframing" means for Lukács as opposed to phenomenological ontology.
  POSITION: Comparative/expository reading situating Lukács's late ontology against Heidegger's, favoring the dialectical-genetic method over hermeneutic phenomenology.
  },
  keywords = {Tertulian, Heidegger, comparative, causality, Geworfenheit, High},
  abstract = {L'auteur de ce texte a aborde auparavant a plusieurs reprises le sujet d'une confrontation entre les pensees de Heidegger et de Lukacs. Il est parti de l'idee qu'ils existent des motifs communs entre les deux pensees, par exemple le theme de l'alienation et celui de la reification, et il a publie deux articles dans ce sens. Le texte publie ici poursuit un objectif plus ambitieux, car il se propose de remonter aux fondements ontologiques des deux pensees et confronter Heidegger et Lukacs a partir de leur opposition sur pluseurs questions philosophiques cruciales : l'autonomie ontologique du monde exterieur, la definition du concept de "monde", la "subjectivite du sujet" et la humanitas de l'homo humanus, la critique lukacsienne du concept heideggerien d'"etre-jete..." (Geworfenheit),la problematique de la finitude et de l'infini,etc. La these centrale de l'article est l'occultation par Heidegger du travail comme "phenomene originaire" de l'existence humaine et sa substitution par une categorie affective: le "Souci" (die Sorge), tandis que Lukacs a construit son ontologie de l'etre social, en suivant Hegel et Marx, sur l'idee du travail comme pivot de l'existence humaine. La partie finale du texte designe plusieurs motifs de la pensee heideggerienne (la critique de la pensee securisante, par ex.) qui prefigurent l'adhesion du philosophe a l'extreme droite de l'epoque, ce qui confirme la these de Lukacs formulee dans son livre La Destruction de la Raison sur le caractere "pre-fasciste" de certaines orientations de la philosophie heideggerienne a l'epoque qui asuccede a son livre fameux Etre et Temps.},
  abstract_source = {s2},
}

@article{tertulian2006alienation,
  author = {Tertulian, Nicolas},
  title = {Aliénation et désalienation : une confrontation Lukács-Heidegger},
  journal = {Actuel Marx},
  year = {2006},
  volume = {39},
  number = {1},
  pages = {29--53},
  doi = {10.3917/amx.039.0029},
  abstract = {It is generally agreed that the major contribution of Lukacs to twentieth century thought is to have foregrounded in philosophical inquiry the questions of alienation and reification. However, while the secondary literature on the question has been almost exclusively focused on Lukacs's early work, History and Class Consciousness, the present article addresses the wealth of innovative perspectives to be found in his Aesthetics, and in particular in his Ontology of Social Being. The second part of the article addresses the affinities with the Sartrean philosophy and proposes a confrontation with the Heideggerrian analysis of alienation, which is rarely granted a critical treatment in its own rights.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Tertulian argues that the secondary literature's near-exclusive focus on HCC has obscured a wealth of innovative treatments of alienation and de-alienation in Lukács's later work, especially the Ontology, and reconstructs these in confrontation with both Sartrean existentialism and Heidegger's analysis of alienation.
  RELEVANCE: Directly supports this domain's continuity/deepening thesis by showing that alienation -- HCC's signature theme -- receives a distinct and arguably more developed treatment in the late Ontology, complicating any simple rupture narrative between the two texts.
  POSITION: Continuity/deepening reading: the Ontology develops HCC's alienation theme further and more richly than acknowledged, in critical dialogue with Sartre and Heidegger.
  },
  keywords = {Tertulian, alienation, Heidegger, Sartre, continuity, Medium}
}

@article{duayermedeiros2005criticalontology,
  author = {Duayer, Mário and Medeiros, João},
  title = {Lukács' Critical Ontology and Critical Realism},
  journal = {Journal of Critical Realism},
  year = {2005},
  volume = {4},
  number = {2},
  pages = {395--425},
  doi = {10.1558/jocr.v4i2.395},
  note = {
  CORE ARGUMENT: Duayer and Medeiros argue that Lukács's late Ontology of Social Being should be read as an indispensable contribution to ontological investigation in general -- and to social ontology in particular -- comparable to (and in productive convergence with) the ontology developed within the Bhaskarian critical realist tradition, while also identifying questions that remain inadequately treated from an ontological perspective in both traditions.
  RELEVANCE: Brings the late Lukács into direct dialogue with contemporary (critical realist) social ontology, demonstrating the continued philosophical relevance of the labor-teleology-causality model outside strictly Lukács-exegetical debates and supporting a fulfillment/deepening reading of the Ontology's continuity with Marxist method more broadly.
  POSITION: Fulfillment/deepening reading with a comparative-appropriative dimension: treats the Ontology as underappreciated but philosophically serious, convergent with critical realist social ontology.
  },
  keywords = {critical-realism, Duayer, Medeiros, comparative, High},
  abstract = {This paper proposes that we read a late work of Georg Lukács, The Ontology of Social Being, as an indispensable contribution to ontological investigation in general and particularly to the understanding of social reality. As the ontology of Lukács tends not to be familiar even to those who have (properly) foregrounded ontological issues in recent decades, it seems to be extremely fruitful to bring it into discussion. Comparing the analysis of Lukács with the ontology of critical realism, we argue that it is not only possible to identify obvious convergences but also to shed light on many questions that still demand a proper treatment from an ontological perspective.},
  abstract_source = {openalex},
}

@article{fuchs2015communicationsscholar,
  author = {Fuchs, Christian},
  title = {Georg Lukács as a communications scholar: cultural and digital labour in the context of Lukács' Ontology of Social Being},
  journal = {Media, Culture \& Society},
  year = {2015},
  volume = {38},
  number = {4},
  pages = {506--524},
  doi = {10.1177/0163443715613637},
  abstract = {The task of this work is to apply thoughts from Georg Lukács' final book, the Ontology of Social Being, for the theoretical analysis of cultural and digital labour. It discusses Lukács' concepts of work and communication and relates them to the analysis of cultural and digital work. It also analyses his conception of the relation of labour and ideology and points out how we can make use of it for critically understanding social media ideologies. Lukács opposes the dualist separation of the realms of work and ideas. He introduces in this context the notion of teleological positing that allows us to better understand cultural and digital labour as well as associated ideologies, such as the engaging/connecting/sharing-ideology, today. The analysis shows that Lukács' Ontology is in the age of Facebook, YouTube and Twitter, still a very relevant book, although it has thus far not received the attention that it deserves. This article also introduces the Ontology's main ideas on work and culture, which is important because large parts of the book have not been translated from the German original into English. Lukács' notion of teleological positing is crucial for understanding the common features of the economy and culture.},
  abstract_source = {semanticscholar},
  note = {
  CORE ARGUMENT: Fuchs applies Lukács's categories of teleological positing and the labor/ideology relation from the late Ontology to contemporary cultural and digital labor (social media platforms), arguing that the Ontology's account of work and communication remains directly applicable to critically analyzing platform ideologies such as the "engaging/connecting/sharing" rhetoric of Facebook, YouTube, and Twitter.
  RELEVANCE: Demonstrates the continued analytic productivity of the Ontology's teleological-positing category well beyond Lukács exegesis, and notes that large parts of the German text remain untranslated into English -- corroborating this domain's note on limited Anglophone access to the full Ontology and Prolegomena.
  POSITION: Applied/extension reading: treats teleological positing as a still-usable analytic category for critical media and labor theory, independent of the continuity-vs-rupture debate.
  },
  keywords = {teleological-positing, digital-labour, Fuchs, application, Medium}
}

@article{blanton2020judgment,
  author = {Blanton, C. D.},
  title = {Judgment and Social Being},
  journal = {South Atlantic Quarterly},
  year = {2020},
  volume = {119},
  number = {4},
  pages = {725--734},
  doi = {10.1215/00382876-8663627},
  abstract = {A notion of ideology relies necessarily on deeper assumptions about a consciousness subject to misapprehension and error. But in their inversions of Hegel, the mature Marx's account of the commodity and general formula of capital dethrone consciousness altogether, assigning faculties of judgment and knowledge to the commodity instead. This essay turns to the late work of Georg Lukács to trace an alternative power of judgment formed by labor as such, in the problem of "teleological positing."},
  abstract_source = {semanticscholar},
  note = {
  CORE ARGUMENT: Blanton argues that Marx's mature account of the commodity form displaces consciousness-based theories of ideology by assigning faculties of judgment and knowledge to the commodity itself, and turns to the late Lukács's category of "teleological positing" to recover an alternative, labor-grounded account of judgment not dependent on a unified knowing subject.
  RELEVANCE: Offers a reading of teleological positing as a response to problems of ideology and judgment left unresolved by a commodity-centered (rather than subject-centered) account of capitalist consciousness, adding a further, non-exegetical angle on why Lukács turned to labor as an ontological category in his late work.
  POSITION: Applied/extension reading: uses teleological positing to reconstruct a labor-based theory of judgment distinct from subject-centered theories of ideology.
  },
  keywords = {teleological-positing, judgment, ideology, Blanton, Medium}
}

@incollection{tosel2008budapestschool,
  author = {Tosel, André},
  title = {Chapter Eight. The late Lukács and the Budapest school},
  booktitle = {Critical Companion to Contemporary Marxism},
  year = {2008},
  publisher = {Brill},
  pages = {163--173},
  doi = {10.1163/ej.9789004145986.i-813.41},
  abstract = {A survivor of the Soviet repression of the 1956 Hungarian uprising, Lukacs explicitly made his ontology of social being a new theoretical basis for a democratic revival of real socialism. Lukacs abandons the subject-object dialectic embodied in the class consciousness of the proletariat, charged with overcoming the bourgeois separation between subject and object via the teleology of history. Heller and Markus activity unfolded in two phases. The first phase involved exploiting the standpoint of the ontology of social being against Marxist-Leninist dialectical materialism and rethinking Marx's contribution. The second phase of the activity of the Budapest school thinkers initiates a chapter of post-Marxism. Heller has produced a multi-faceted, original oeuvre, close to Habermas, focused on the urgency of developing a theory of modernity. Keywords: Budapest school; Heller; Late Lukacs; Markus; Marxism},
  abstract_source = {crossref},
  note = {
  CORE ARGUMENT: Tosel argues that the late Lukács explicitly abandoned the subject-object dialectic of HCC (embodied in proletarian class consciousness) in favor of the ontology of social being, intending it as a new theoretical basis for a democratic revival of socialism after the 1956 Hungarian uprising; he then traces how Lukács's own Budapest School students used the ontology's standpoint first against Soviet dialectical materialism and subsequently as a launching point for post-Marxist theory (Heller's later turn toward a Habermasian theory of modernity).
  RELEVANCE: Directly addresses the domain's second key question by explicitly stating that Lukács abandoned (rather than merely revised) HCC's subject-object identity claim in the Ontology, while also tracing the further trajectory of the Budapest School critics (see Fehér, Heller, Márkus, Vajda 1976, this domain) beyond their initial 1976 critique into post-Marxism.
  POSITION: Rupture reading regarding the subject-object dialectic specifically: the Ontology abandons the proletarian subject-object identity thesis of HCC, replacing it with a labor-teleology-based social ontology.
  },
  keywords = {Tosel, Budapest-School, subject-object, rupture, Heller, Markus, High}
}

@book{thompson2020possibilitybook,
  editor = {Thompson, Michael J.},
  title = {Georg Lukács and the Possibility of Critical Social Ontology},
  year = {2020},
  publisher = {Brill},
  address = {Leiden},
  doi = {10.1163/9789004415522},
  note = {
  CORE ARGUMENT: An edited collection of essays reassessing Lukács's late Ontology of Social Being as a resource for contemporary critical social ontology, gathering contributions that reconstruct the labor-teleology model, its relation to critical theory, and its applicability to present-day social-philosophical problems.
  RELEVANCE: The most substantial recent (2020) English-language collection devoted specifically to the late Ontology, indicating renewed Anglophone scholarly interest in the text beyond the 1970s-80s Telos-circle debates; reviewed critically by Dorahy 2023 (this domain), whose review essay engages several of the volume's central claims.
  POSITION: Reconstructive/appropriative collection: treats the Ontology's categorial apparatus as a live resource for contemporary critical social ontology rather than primarily as an object of historical-exegetical debate.
  },
  keywords = {Thompson, edited-volume, critical-social-ontology, High},
  abstract = {Georg Lukács was one of the most important intellectuals and philosophers of the 20th century. His last great work was an systematic social ontology that was an attempt to ground an ethical and critical form of Marxism. This work has only now begun to attract the interest of critical theorists and philosophers intent on reconstructing a critical theory of society as well as a more sophisticated framework for Marxian philosophy. This collection of essays explores the concept of critical social ontology as it was outlined by Georg Lukács and the ways that his ideas can help us construct a more grounded and socially relevant form of social critique. This work will of special interest to social, moral and political philosophers as well as those who study critical theory, social theory and Marxism. It is also of interest to those working within the area of social ontology. Contributors include: Mario Duayer, Andreas Giesbert, Christoph Henning, Antonino Infranca, Reha Kadakal, Endre Kiss, Michael Morris, Michalis Skomvoulis, Matthew J. Smetona, Titus Stahl, Thomas Telios, Michael J. Thompson, Murillo van der Laan, Miguel Vedda, Claudius Vellay.},
  abstract_source = {openalex},
}

@article{dorahy2023socialontology,
  author = {Dorahy, J. F.},
  title = {Social Ontology and the Past, Present and Future of Critical Theory: A Critical Reading of Georg Lukács and the Possibility of Critical Social Ontology},
  journal = {Critical Horizons},
  year = {2023},
  volume = {24},
  number = {1},
  pages = {76--87},
  doi = {10.1080/14409917.2023.2195803},
  note = {
  CORE ARGUMENT: A critical review essay engaging Thompson's 2020 edited collection (this domain), assessing the volume's central claim that Lukács's late social ontology can ground a renewed critical theory, and evaluating how successfully its contributors reconstruct the categorial apparatus of the Ontology (labor, teleological positing, totality) for contemporary purposes against the backdrop of the discipline's history.
  RELEVANCE: Provides a synthesizing, critical vantage point on the state of Anglophone Ontology scholarship as of the early 2020s, directly useful for assessing how successfully recent scholarship has answered this domain's continuity/rupture question relative to earlier (Budapest School, Tertulian, Joós) positions.
  POSITION: Critical-synthetic reading assessing the prospects and limits of using the late Ontology to ground a renewed critical social ontology.
  },
  keywords = {Dorahy, review-essay, critical-social-ontology, High},
  abstract = {In both continental and analytical philosophy, social ontology has emerged as a particularly lively and increasingly sophisticated area of debate. This essay explores the potential contribution that social-ontological thinking can make to the continued development of critical theory via a critical reading of Georg Lukács and the Possibility of Critical Social Ontology – a collection of essays edited by Michael J. Thompson and published by Brill as part of the Studies in Critical Social Sciences series. The essay argues that whilst social ontology as such no doubt offers a fruitful avenue for contemporary critical theory, the later philosophy of Georg Lukács represents an untenable and antiquated theoretical resource for such endeavours. The conceptual and systematic barriers to the revitalisation of the late Lukács are explored with specific reference to Lukács’ specific interpretation of the paradigm of labour and, closely related to this, his philosophy of history.},
  abstract_source = {openalex},
}

@article{browne1990laterontology,
  author = {Browne, Paul},
  title = {Lukács' Later Ontology},
  journal = {Science \& Society},
  year = {1990},
  volume = {54},
  number = {2},
  pages = {193--218},
  doi = {10.1177/003682379005400206},
  note = {
  CORE ARGUMENT: Browne provides a systematic exposition and defense of the categorial structure of Lukács's later Ontology, addressing the coherence of the labor-teleology-causality model and its capacity to ground a materialist theory of social development without lapsing into either idealist teleology or mechanistic determinism.
  RELEVANCE: An early (1990) English-language, Marxist-journal (Science and Society) treatment defending the philosophical coherence of the late Ontology against charges (such as the Budapest School's) that it fails to escape the antinomies it diagnoses, directly engaging this domain's central continuity/rupture question.
  POSITION: Fulfillment/defense reading: argues for the internal coherence and continuing relevance of the late Ontology's categorial structure.
  },
  keywords = {Browne, exposition, defense, INCOMPLETE, no-abstract, High}
}

@article{thompson2024germanidealism,
  author = {Thompson, Michael J.},
  title = {German Idealism, Marxism, and Lukács' Concept of Dialectical Ontology},
  journal = {Open Philosophy},
  year = {2024},
  volume = {7},
  number = {1},
  pages = {18--36},
  doi = {10.1515/opphil-2024-0020},
  abstract = {I explore the roots of ontological thinking in the late thought of Georg Lukács via the development of the nature of praxis in German Idealism and the thought of Marx. I contend that the thesis of spontaneous, self-creation as well as social relatedness are both core themes in German Idealism that achieve definitive form in Marx's thought. In effect, I argue that the human capacities for relatedness and the formation of relations with others paired with the teleological structure of human practical agency constitute a crucial ontological ground for critical theory. It is this that Lukács focuses on in his later ontological writings and which can be used to re-orient contemporary critical theory and critical philosophy which has been dominated by post-metaphysical and neo-Idealist currents in recent decades.},
  abstract_source = {semanticscholar},
  note = {
  CORE ARGUMENT: Thompson traces the German Idealist roots (self-creation, social relatedness) of Lukács's late dialectical ontology, arguing that the teleological structure of human practical agency Lukács develops in his later writings constitutes an ontological ground that could reorient contemporary critical theory away from post-metaphysical and neo-Idealist currents.
  RELEVANCE: Locates the late Ontology's teleology-of-labor model within the broader German Idealist inheritance (beyond Hegel specifically), complementing Domain 4's Hegel-focused treatments (Ninos, Menozzi) with a wider genealogical claim about Marxism's Idealist sources for the ontological turn.
  POSITION: Reconstructive/appropriative reading: treats the late ontology's Idealist-derived teleology of practical agency as a resource for reorienting contemporary critical theory.
  },
  keywords = {Thompson, German-Idealism, praxis, teleology, Medium}
}

@article{szecsi2015knowledgereality,
  author = {Szécsi, Gábor},
  title = {Knowledge, reality and manipulation},
  journal = {Studies in East European Thought},
  year = {2015},
  volume = {67},
  number = {1-2},
  pages = {31--39},
  doi = {10.1007/s11212-015-9227-4},
  note = {
  CORE ARGUMENT: Szécsi examines Lukács's social-epistemological account, in the context of the late Ontology, of the neopositivist rejection of ontology, situating Lukács's defense of a genuinely ontological (as opposed to purely epistemological or logical-positivist) approach to social reality within debates about knowledge, reality, and ideological manipulation.
  RELEVANCE: Addresses the domain's concern with how the late Lukács's ontological turn positions itself against rival twentieth-century philosophical currents (here neopositivism, complementing Tertulian's treatments of the Heidegger and Hartmann confrontations), reinforcing the domain's account of what distinguishes the Ontology's methodological commitments.
  POSITION: Expository reading situating the late Lukács's ontological realism against neopositivist rejections of ontology.
  },
  keywords = {Szecsi, neopositivism, epistemology, INCOMPLETE, no-abstract, Medium}
}

@article{correacastaneda2024estructura,
  author = {Correa Castañeda, Diego Fernando},
  title = {Estructura ontológica lukácsiana},
  journal = {Universitas Philosophica},
  year = {2024},
  volume = {41},
  number = {82},
  pages = {17--47},
  doi = {10.11144/javeriana.uph41-82.eolu},
  abstract = {En este artículo se hará un recorrido detallado por el sistema ontológico y categorial de la obra póstuma de Georg Lukács, Ontología del ser social. En adición, se hará una comparación entre la problemática que se presenta entre la primera parte histórica y la segunda parte sistemática. Así mismo, se pondrán en juego los sistemas ontológicos del existencialismo, de Nicolai Hartmann, de Hegel y de Marx, para terminar con la propuesta de una ontología plenamente social de Lukács. Igualmente se harán aproximaciones a las categorías de trabajo, reproducción social, ideología y alienación, determinantes todas ellas del ser social.},
  abstract_source = {semanticscholar},
  note = {
  CORE ARGUMENT: Correa Castañeda gives a detailed reconstruction of the categorial system of the posthumous Ontology of Social Being, explicitly comparing the tension between its historical (genetic) first part and its systematic second part, and situating Lukács's categories of labor, social reproduction, ideology, and alienation against the ontological systems of existentialism, Hartmann, Hegel, and Marx.
  RELEVANCE: Provides a recent (2024), comprehensive overview of the Ontology's full categorial architecture and explicitly engages the historical/systematic tension that is one version of the domain's continuity/rupture question, extending it to a comparison with Hartmann's and existentialist ontology alongside Hegel and Marx.
  POSITION: Expository/comparative reading mapping the Ontology's categorial structure against rival twentieth-century ontological systems.
  },
  keywords = {CorreaCastaneda, categorial-structure, Hartmann, existentialism, Medium}
}

@article{vaisman2014politicality,
  author = {Vaisman, Ester and Fortes, Ronaldo Vielmi},
  title = {Politicality in the Late Thoughts of György Lukács},
  journal = {Revista Estudos Políticos},
  year = {2014},
  volume = {5},
  number = {9},
  doi = {10.22409/rep.v5i9.40359},
  abstract = {This article is devoted to the question of politicality in the late thoughts of the Hungarian philosopher, Gyorgy Lukacs and covers the period from 1961 to 1971 (the year of his death). It seeks to analyze the political "determinations" of the author, particularly in his work The Ontology of Social Being, where an attempt is made to clarify the more general features of his political understanding and highlight the theoretical basis and fundamental categories that underpin his reflections in this area.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Vaisman and Fortes analyze the political dimension of Lukács's thought in the final decade of his life (1961-1971), arguing that the Ontology of Social Being, though framed as a general social ontology, contains determinate political commitments and categories that clarify his late understanding of politics and its relation to social being.
  RELEVANCE: Extends the domain beyond the strictly philosophical reception of the Ontology to its political dimension, addressing how Lukács's post-1956 political situation (surveyed via Tosel's Budapest School chapter in this domain) shaped the categorial choices of his final theoretical project.
  POSITION: Expository reading foregrounding the political categories embedded in the late Ontology's ostensibly general social-ontological framework.
  },
  keywords = {Vaisman, Fortes, politics, late-Lukacs, Medium}
}

@misc{althusser1969formarx,
    author = "Althusser, Louis",
    title = "For Marx",
    year = "1969",
    address = "London",
    note = {CORE ARGUMENT: This collection of essays (1960--1965) introduces Althusser's central charges against "Hegelian" or "historicist" readings of Marx: the "epistemological break" separating the scientific mature Marx from the ideological, humanist young Marx; the rejection of an expressive, Hegelian totality in favor of a "structure in dominance" of relatively autonomous instances; and "theoretical anti-humanism," the claim that history is a "process without a subject" rather than the self-realization of Man or a class-subject. RELEVANCE: This is the founding text of the structuralist critique this domain investigates. Although Lukács is not its explicit target, its account of "historicism" (the reduction of a social totality to the "internal essence" of an epoch, knowable through a subject's lived experience) and of "expressive totality" (a whole all of whose parts express one central essence) became, via later commentators, the standard charge leveled at History and Class Consciousness's category of totality and its identical subject-object. POSITION: Structuralist Marxism / theoretical anti-humanism.},
    keywords = "althusser, expressive-totality, historicism, anti-humanism, structuralism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{althusserbalibar2016readingcapital,
    author = "Althusser, Louis and Balibar, Étienne",
    title = "Reading Capital",
    year = "2016",
    address = "London",
    note = {CORE ARGUMENT: Originally presented as seminar papers on Capital (1965), this book develops Althusser's "symptomatic reading" of Marx and his theory of "structural causality," according to which a social totality is not a hierarchical expression of one essence (as in Hegel) but a decentered structure in which the economic determines "in the last instance" which instance is dominant, without any instance being reducible to any other or to a founding subject. RELEVANCE: Supplies the positive alternative -- structural rather than expressive causality -- against which Althusser's charge that Lukácsian totality is merely "expressive" must be measured; central primary source for evaluating whether the charge of expressive totality is a fair characterization of Lukács's actual category of totality in History and Class Consciousness. POSITION: Structuralist Marxism.},
    keywords = "althusser, structural-causality, totality, expressive-totality, structuralism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{merleauponty1973adventures,
    author = "Merleau-Ponty, Maurice",
    title = "Adventures of the Dialectic",
    year = "1973",
    address = "Evanston, IL",
    note = {CORE ARGUMENT: In the chapter "'Western' Marxism," Merleau-Ponty reads Lukács's History and Class Consciousness as the most rigorous attempt to preserve a genuinely dialectical Marxism -- one in which truth is internal to a historical perspective (the proletariat's) rather than external and "objectivist." He argues this position is inherently unstable: because the proletariat's "true" class consciousness must be certified by something (the Party) external to the empirical workers' actual consciousness, the dialectic collapses either into an ungrounded, quasi-mystical wager on revolutionary spontaneity or into a dogmatic, Leninist "objectivism" in which the Party's verdict simply replaces the workers' own experience -- and this second, degenerating outcome is what Merleau-Ponty takes Bolshevism-Stalinism to have actually realized. RELEVANCE: The founding diagnosis of the impasse of the tradition Lukács inaugurates ("Western Marxism"), prior to and independent of both the Althusserian and the analytic-Marxist critiques; essential primary source for the domain's second key question. POSITION: Phenomenological/existentialist critique of Marxist dialectic from within.},
    keywords = "merleau-ponty, western-marxism, dialectic, subject-object, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{elster1985makingsense,
    author = "Elster, Jon",
    title = "Making Sense of Marx",
    year = "1985",
    address = "Cambridge",
    note = {CORE ARGUMENT: A systematic reconstruction and critique of Marx's social theory using the methods of analytic philosophy and rational-choice theory, arguing that historical materialism's central explanatory claims are defensible, if at all, only when reduced to methodologically individualist micro-foundations; Elster rejects functional explanation and teleological, holistic accounts of historical change (the productive forces "needing" or historical development "requiring" certain relations of production) as illegitimate unless an individualist causal mechanism is supplied. RELEVANCE: Supplies the general analytic-Marxist case against holistic and teleological historical explanation that this domain's third key question asks to be applied to Lukács's imputed-consciousness/totality apparatus, in which the "standpoint of the proletariat" functions as a holistic, non-individualist explanatory category; Elster does not discuss Lukács, so the application must be constructed in synthesis. POSITION: Methodological individualism / rational-choice Marxism.},
    keywords = "elster, methodological-individualism, functional-explanation, analytic-marxism, High, METADATA\_CLEANED: publisher, type:@book->@misc",
    abstract = "This book offers an analysis of transitional justice -retribution and reparation after a change of political regime -from Athens in the fifth century b.c. to the present. Part I, \&quot;The Universe of Transitional Justice,\&quot; describes more than thirty transitions, some of them in considerable detail, others more succinctly. Part II, \&quot;Analytics of Transitional Justice,\&quot; proposes a framework for explaining the variations among the cases: why after some transitions wrongdoers from the previous regime are punished severely and in other cases mildly or not at all, and why victims are sometimes compensated generously and sometimes poorly or not at all. After surveying a broad range of justifications and excuses for wrongdoings and criteria for selecting and indemnifying victims, the book concludes with a discussion of three general explanatory factors: economic and political constraints, the retributive emotions, and the play of party politics",
    abstract_source = "core"
}

@book{cohen1978karlmarxtheory,
    author = "Cohen, G. A.",
    title = "Karl Marx's Theory of History: A Defence",
    year = "1979",
    publisher = "Princeton University Press",
    address = "Princeton, NJ",
    doi = "10.1515/9780691213002",
    note = {CORE ARGUMENT: Reconstructs and defends historical materialism as a technologically-driven functional theory: relations of production are explained by their disposition to develop the productive forces, a claim Cohen defends via an explicit theory of functional explanation modeled on (but not reducible to) biological function, rather than via a Hegelian dialectic of subject and object or class consciousness. RELEVANCE: The founding text of analytic Marxism and the primary source for the "Cohen-adjacent" position named in this domain's search strategy; its defense of functional (holistic) explanation, later challenged by Elster, frames the debate over whether any holistic historical explanation -- including Lukács's -- can be made rigorous without individualist micro-foundations. POSITION: Analytic Marxism / technological-functionalist historical materialism.},
    keywords = "cohen, functional-explanation, historical-materialism, analytic-marxism, High",
    abstract = "First published in 1978, this book rapidly established itself as a classic of modern Marxism. In this expanded edition Cohen offers his own account of the history, and the further promise, of analytical Marxism. He also expresses reservations about traditional historical materialism, in the light of which he reconstructs the theory.",
    abstract_source = "openalex"
}

@article{cohen1982functionalexplanation,
    author = "Cohen, G. A.",
    title = "Functional Explanation, Consequence Explanation, and Marxism",
    journal = "Inquiry",
    year = "1982",
    volume = "25",
    number = "1",
    pages = "27--56",
    doi = "10.1080/00201748208601953",
    note = {CORE ARGUMENT: Cohen defends the legitimacy of functional (or "consequence") explanation in social theory against the charge that it illegitimately explains a cause by its effect, arguing that a consequence explanation is vindicated when there exists an appropriate "elaborating" causal mechanism (even if that mechanism is not always specified), and that historical materialism's explanations of relations of production by their effects on the productive forces fit this pattern. RELEVANCE: Directly engages the philosophical legitimacy of holistic/teleological explanation of the kind presupposed by Lukács's philosophy of history (in which the "objective possibilities" of a historical situation and the imputed consciousness of a class explain the direction of historical development); provides the strongest analytic-Marxist defense of the explanatory form Elster rejects. POSITION: Analytic Marxism, defending functional explanation.},
    keywords = "cohen, functional-explanation, teleology, analytic-marxism, High",
    abstract = "I argued in Karl Marx's Theory of History that the central claims of historical materialism are functional explanations, and I said that functional explanations are consequence explanations, ones, that is, in which something is explained by its propensity to have a certain kind of effect. I also claimed that the theory of chance variation and natural selection sustains functional explanations, and hence consequence explanations, of organismic equipment. In Section I I defend the thesis that historical materialism offers functional or consequence explanations, and I reject Jon Elster's contention that game theory can, and should, assume a central role in the Marxist theory of society. In Section II I contrast functional and consequence explanation, thereby revising the position of Karl Marx's Theory of History, and I question whether evolutionary biology supports functional explanations. Section III is a critique of Elster's views on functional explanation, and Sections IV and V defend consequence explanation against metaphysical and epistemological doubts. A concluding section summarizes my present understanding of the status of historical materialist explanations.",
    abstract_source = "openalex"
}

@article{wood1986historicalmaterialism,
    author = "Wood, Allen W.",
    title = "Historical Materialism and Functional Explanation",
    journal = "Inquiry",
    year = "1986",
    volume = "29",
    pages = "11--27",
    doi = "10.1080/00201748608602077",
    note = "CORE ARGUMENT: A critical examination of Elster's Making Sense of Marx, arguing that Elster's defense of methodological individualism and his associated critique of Marx's use of functional explanation rest on a caricature of both functional explanation and of the kind of teleological claims Marx actually makes about historical development. RELEVANCE: Provides the pro-holism rebuttal within the Elster/Cohen/Wood debate over methodological individualism, directly relevant to assessing whether Lukács's holistic, non-individualist mode of historical explanation (imputed class consciousness, totality as a standpoint) is illegitimate on the grounds Elster's framework would suggest, or defensible on grounds closer to Wood's. POSITION: Defense of Marxist functional/teleological explanation against methodological individualism.",
    keywords = "wood, functional-explanation, methodological-individualism, elster, Medium",
    abstract = "This paper is a critical examination of one central theme in Jon Elster's Making Sense of Marx; Elster's defense of ‘methodological individualism’ in social science and his related critique of Marx's use of ‘functional explanation’. The paper does not quarrel with Elster's claim that the particular instances of functional explanation advanced by Marx are defective; what it criticizes is Elster's attempt to raise principled, philosophical objections to this type of explanation in the social sciences. It is argued that Elster's philosophical critique of functional explanation rests on a caricature of this kind of explanation, just as his critique of Marx's use of teleology in the philosophy of history rests on a caricature of the kinds of teleological claims Marx is concerned to make. The paper ends with a brief discussion of a recently published passage from Marx's notebooks of 1861–1863, where Elster claims to have found Marx explicitly criticizing capitalist exploitation as an injustice to the workers.",
    abstract_source = "openalex"
}

@article{north1986worthmaking,
    author = "North, Douglass C.",
    title = "Is It Worth Making Sense of Marx?",
    journal = "Inquiry",
    year = "1986",
    volume = "29",
    number = "1-4",
    pages = "57--63",
    doi = "10.1080/00201748608602080",
    note = {CORE ARGUMENT: An economic historian's assessment of Elster's reconstruction of Marx, examining Elster's treatment of "productive forces" and "relations of production" and questioning how much analytical purchase Marx's theory of historical evolution retains once stripped of its holistic/dialectical apparatus and reduced to individualist rational-choice foundations. RELEVANCE: Offers an external, non-Marxist vantage on the stakes of the individualism/holism debate central to this domain's third key question, illustrating how far the analytic reconstruction of historical materialism travels from the kind of holistic philosophy of history Lukács represents. POSITION: Skeptical assessment of analytic-Marxist reconstruction from economic history.},
    keywords = "north, elster, methodological-individualism, historical-materialism, Low",
    abstract = "This essay explores Elster's analysis of Marx's theory of historical evolution. The meaning of the terras ‘productive forces’ and the ‘relations of production’ are examined both as specified by Marx and interpreted by Elster. The essay then goes on to demonstrate how the modern literature on transaction costs can provide a more precise and useful framework within which to explore the ongoing tension between productive forces and relations of production.",
    abstract_source = "openalex"
}

@misc{anderson1976considerations,
    author = "Anderson, Perry",
    title = "Considerations on Western Marxism",
    year = "1976",
    address = "London",
    note = {CORE ARGUMENT: Anderson's genealogy identifies History and Class Consciousness (1923) as the inaugural text of "Western Marxism," a tradition characterized by its structural divorce from revolutionary working-class practice and its consequent turn toward philosophy (epistemology, aesthetics, method) rather than economics or political strategy; he traces the tradition's subsequent fragmentation, including the later structuralist reaction against its Hegelian, subject-centered wing. RELEVANCE: Supplies the historical-sociological frame within which both the Althusserian reaction against Lukácsian Hegelian Marxism and Merleau-Ponty's own diagnosis of Western Marxism's impasse must be situated; the term "Western Marxism" itself, central to this domain's second key question, derives from this book (via Merleau-Ponty's earlier, narrower usage). POSITION: Trotskyist/New Left historical-sociological account of Western Marxism.},
    keywords = "anderson, western-marxism, historiography, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{anderson1980arguments,
    author = "Anderson, Perry",
    title = "Arguments within English Marxism",
    year = "1980",
    address = "London",
    note = {CORE ARGUMENT: A reassessment of E. P. Thompson's "socialist humanist" critique of Althusserian structuralism (given in The Poverty of Theory), in which Anderson partially retracts his earlier, more theoreticist sympathies and reconsiders the merits of the humanist/structuralist dispute over agency, structure, and historical explanation within British Marxist historiography. RELEVANCE: Extends the Althusser/humanism dispute this domain investigates into its reception within English-language Marxist historiography, providing context for how the structuralist charge of "historicism" and "humanism" against Hegelian Marxism (including Lukács) was contested on empirical-historiographical rather than purely philosophical grounds. POSITION: Reassessment of the structuralism/humanism debate from within British Marxism.},
    keywords = "anderson, althusser, humanism, historiography, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{callinicos1976althussersmarxism,
    author = "Callinicos, Alex",
    title = "Althusser's Marxism",
    year = "1976",
    address = "London",
    note = {CORE ARGUMENT: A critical exposition of Althusser's philosophy -- the epistemological break, the theory of ideology, structural causality, and the anti-humanist rejection of a historical subject -- assessing both its polemical target (Hegelian-humanist Marxism, of which Lukács is a paradigm case) and its own internal theoretical difficulties, including the problem of specifying determination "in the last instance" without lapsing back into the kind of expressive totality it claims to reject. RELEVANCE: An early, systematic reconstruction of the precise content of the "expressive totality" and "historicism" charges this domain's first key question asks about, together with an assessment of whether Althusser's own alternative avoids the same difficulties he attributes to Lukácsian Hegelian Marxism. POSITION: Critical exposition of Althusserian structuralist Marxism.},
    keywords = "callinicos, althusser, expressive-totality, historicism, structuralism, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{elliott1987althusserdetour,
    author = "Elliott, Gregory",
    title = "Althusser: The Detour of Theory",
    year = "1987",
    address = "London",
    note = {CORE ARGUMENT: A detailed intellectual-historical reconstruction of Althusser's project situating his "return to Marx" in the mid-1960s within the political and theoretical crisis of French Communism, tracing the polemic against "historicism" and "humanism" (targets that include Lukács alongside Gramsci and Sartre) through to Althusser's own later self-criticisms of "theoreticism" and his retreat from some of the anti-humanist program's stronger claims. RELEVANCE: Provides the fullest available secondary account of the political and theoretical stakes of Althusser's charge against Hegelian Marxism, including an assessment of how far Althusser's own later self-criticism concedes ground to the "humanist" and "historicist" positions he originally targeted -- directly bearing on whether the critique of Lukács was a fair reading. POSITION: Critical intellectual history of Althusserian anti-humanism.},
    keywords = "elliott, althusser, historicism, anti-humanism, structuralism, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{flynn2007merleauponty,
    author = "Flynn, Bernard",
    title = "The Development of the Political Philosophy of Merleau-Ponty",
    journal = "Continental Philosophy Review",
    year = "2007",
    volume = "40",
    number = "2",
    pages = "125--138",
    doi = "10.1007/s11007-007-9053-6",
    note = {CORE ARGUMENT: Traces the development of Merleau-Ponty's political philosophy from Humanism and Terror through the essays on Weber and Lukács collected in Adventures of the Dialectic, arguing that the concept of the proletariat as a "universal class" -- central to Merleau-Ponty's qualified sympathy for Lukács's Marxism -- is progressively dissolved across these texts as Merleau-Ponty comes to doubt that any social group can occupy the epistemically privileged, history-constituting position Lukács's theory requires. RELEVANCE: Directly reconstructs the trajectory by which Merleau-Ponty's engagement with Lukács's identical subject-object leads to his broader disillusionment with Marxist philosophy of history, addressing this domain's second key question in detail. POSITION: Reconstruction of Merleau-Ponty's break with Lukácsian Marxism.},
    keywords = "merleau-ponty, lukacs, western-marxism, universal-class, Medium, INCOMPLETE, no-abstract"
}

@article{rockmore1996merleauponty,
    author = "Rockmore, Tom",
    title = "Merleau-Ponty, Marx, and Marxism: The Problem of History",
    journal = "Studies in East European Thought",
    year = "1996",
    volume = "48",
    number = "1",
    pages = "63--81",
    doi = "10.1007/bf02342517",
    note = "CORE ARGUMENT: Argues that Merleau-Ponty's distinctive contribution to Marxist theory is his insistence on evaluating Marxist theoretical claims against political practice and historical outcomes, rather than treating theory as self-certifying; applied to Lukács, this means judging the identical-subject-object thesis and the imputed-consciousness apparatus by whether revolutionary practice actually vindicated them, which Merleau-Ponty concludes it did not. RELEVANCE: Situates Merleau-Ponty's critique of Lukács within his broader account of the proper relation between Marxist theory and historical practice, complementing Flynn's and Miller's more textually-focused reconstructions. POSITION: Practice-oriented reading of Merleau-Ponty's critique of Marxist philosophy of history.",
    keywords = "merleau-ponty, marxism, philosophy-of-history, Medium, INCOMPLETE, no-abstract"
}

@article{miller1976merleauponty,
    author = "Miller, James",
    title = "Merleau-Ponty's Marxism: Between Phenomenology and the Hegelian Absolute",
    journal = "History and Theory",
    year = "1976",
    volume = "15",
    number = "2",
    doi = "10.2307/2504820",
    note = {CORE ARGUMENT: Reconstructs the tension in Merleau-Ponty's engagement with Marxism between his phenomenological commitment to embodied, situated subjectivity and the Hegelian-Marxist demand (which he finds most fully realized in Lukács) for a subject capable of grasping and enacting the "meaning" of history as an absolute totality; Miller argues Merleau-Ponty ultimately cannot reconcile these and is driven toward a more skeptical, contingent view of historical meaning. RELEVANCE: An early and philosophically detailed account of precisely why Lukács's identical subject-object proved impossible for Merleau-Ponty to sustain phenomenologically, giving textual support for the domain's account of the impasse of Western Marxism. POSITION: Philosophical reconstruction of the phenomenology/Hegelian-Marxism tension in Merleau-Ponty.},
    keywords = "merleau-ponty, phenomenology, hegel, subject-object, Low, METADATA\_CLEANED: pages",
    abstract = "Of all the postwar Marxist philosophers, Maurice Merleau-Ponty remains among the most provocative. Although he never fashioned a systematic treatise on Marxist philosophy, his essays, reviews, and books -Humanism and Terror, Adventures of the Dialectic continue to arouse comment and interest, and with good reason. Thanks to his background in phenomenology, Merleau-Ponty was uniquely equipped to probe such problematic areas of Marxism as the theory's treatment of the human subject and its formulation of a philosophy of history. Yet in his treatment of Marxism, the French philosopher cut a curiously contradictory figure, torn between phenomenology and a neo-Hegelian account of the meaning of history. In what follows, I propose to elaborate these tensions in Merleau-Ponty's Marxism, and examine some of the consequences for his social thought; for despite its difficulties, that thought still promises insight into the nature of social existence, and its relationship to any theory of society and history.",
    abstract_source = "openalex"
}

@article{kruks1988westernmarxism,
    author = "Kruks, Sonia",
    title = "Western Marxism: A Tale of Woe?",
    journal = "Critical Review",
    year = "1988",
    volume = "2",
    number = "4",
    pages = "114--126",
    doi = "10.1080/08913818808459543",
    note = {CORE ARGUMENT: A critical review essay assessing narratives (including Anderson's and Jacoby's) of Western Marxism as a tradition of philosophical retreat and political defeat inaugurated by Lukács, questioning whether the "tale of woe" framing accurately captures the tradition's philosophical achievements or merely registers its distance from a normatively privileged, orthodox model of proletarian revolutionary practice. RELEVANCE: Offers a skeptical counterpoint to the declinist framing shared by Anderson, Merleau-Ponty, and (in a different register) the structuralist critique, useful for the review's synthesis in weighing how much of the "impasse of Western Marxism" narrative should be accepted at face value. POSITION: Skeptical reassessment of declinist narratives of Western Marxism.},
    keywords = "western-marxism, historiography, anderson, Low",
    abstract = "WESTERN MARXISM by J. G. Merquior London: Paladin Books, 1986. 247pp., £3.95",
    abstract_source = "openalex"
}

@article{elliott1987furtheradventures,
    author = "Elliott, Gregory",
    title = "Further Adventures of the Dialectic: Merleau-Ponty, Sartre, Althusser",
    journal = "Royal Institute of Philosophy Lecture Series",
    year = "1987",
    volume = "21",
    pages = "195--214",
    doi = "10.1017/s0957042x00003564",
    note = {CORE ARGUMENT: Extends Merleau-Ponty's diagnosis of the impasse of Western Marxism in Adventures of the Dialectic forward into the subsequent responses of Sartre (whose Critique of Dialectical Reason attempts a new synthesis of subject and structure) and Althusser (whose anti-dialectical structuralism rejects the subject-centered dialectic altogether), treating all three as successive "adventures" attempting to resolve the same underlying difficulty Lukács's identical subject-object first posed. RELEVANCE: Directly connects this domain's two main critiques -- Merleau-Ponty's phenomenological diagnosis and Althusser's structuralist rejection -- as successive responses to the same Lukácsian starting point, making explicit the intellectual-historical link the domain's key questions presuppose. POSITION: Intellectual history connecting phenomenological and structuralist responses to Lukácsian dialectic.},
    keywords = "merleau-ponty, sartre, althusser, western-marxism, dialectic, Low",
    abstract = "This essay is not about contemporary French philosophy, strictly speaking, but something which concerns it—an important episode in its modern history. Its intention is to deal, in very schematic terms, with the nature and evolution of French Marxism from the mid-1950s to the end of the 70s, focusing on two of its best-known and most influential representatives, Jean-Paul Sartre and Louis Althusser, and relating the internal history of their ambitious reconstructions of Marxism to the wider, non-theoretical history of which they were a part— and for whose comprehension they sought to supply the conceptual instruments. Maurice Merleau-Ponty's balance-sheet of a century of Marxism, Adventures of the Dialectic , published in 1955, provides my starting point and explains my title.",
    abstract_source = "openalex"
}

@misc{postone2009subjectsocial,
    author = "Postone, Moishe",
    title = "The Subject and Social Theory: Marx and Lukács on Hegel",
    booktitle = "Karl Marx and Contemporary Philosophy",
    year = "2009",
    pages = "205--220",
    doi = "10.1057/9780230242227\_13",
    note = {CORE ARGUMENT: Postone argues that Lukács's identification of the proletariat as the identical subject-object of history, though a brilliant reading of Hegel, ultimately remains bound within a "traditional" Marxist framework that affirms rather than critiques labor and the standpoint of the totality; he further argues that the structuralist and post-structuralist critics who reject Lukácsian totality and the historical Subject as inherently anti-emancipatory (a critique this domain associates with Althusser) throw out Marx's own critical appropriation of Hegel along with Lukács's, and that a renewed, non-Lukácsian critical theory of capitalism requires recovering what both traditions discard. RELEVANCE: The most direct point of contact between the two critiques surveyed in this domain, explicitly evaluating both the structuralist charge that Lukácsian totality/subject is inherently dominating and the adequacy of Lukács's own Hegel-Marx synthesis, and proposing that neither Lukács's position nor its structuralist rejection is fully adequate. POSITION: Critical-theoretical position distinct from both Lukácsian Hegelian Marxism and structuralist anti-humanism.},
    keywords = "postone, lukacs, hegel, subject-object, totality, structuralism, High, METADATA\_CLEANED: publisher, type:@incollection->@misc",
    abstract = "It is very difficult to imagine addressing the relation of Marx and Hegel — and, relatedly, the question of the Subject and critical social theory — without considering the towering figure of Georg Lukács.1 In History and Class Consciousness, written in the aftermath of the Russian Revolution and the failure of revolution in central Europe, Lukács (1971) effects a fundamental theoretical break with Second International Marxism by reasserting the Hegelian dimension of Marx’s thought. On this basis, he fundamentally criticized scienüsm and faith in linear historical progress, arguing that such positions were the deep theoretical grounds for the world-historical failures of Social Democracy to prevent war in 1914 and bring about radical historical change in 1918–19.",
    abstract_source = "openalex"
}

@book{adorno1973negativedialectics,
  author = {Adorno, Theodor W.},
  title = {Negative Dialectics},
  year = {1973},
  publisher = {Continuum},
  address = {New York},
  note = {
  CORE ARGUMENT: Adorno's mature statement of "negative dialectics" argues that all identity-thinking--the subsumption of the particular under the universal concept--is a form of domination, and that dialectical thought must instead register the "non-identity" between concept and object without resolving it into a higher synthesis. Historical totality is retained as the horizon within which particulars are intelligible, but any claim to have reconciled subject and object (as Lukács's "identical subject-object of history" claims to do for the proletariat) is treated as ideological.

  RELEVANCE: The primary text through which Adorno inherits Lukács's reification analysis while categorically rejecting the proletarian subject-object solution and the affirmative, reconciled totality it implies; essential for the domain's central question of continuity-with-rupture in the Frankfurt School reception of Lukács.

  POSITION: Foundational negative-dialectical critique of subject-object identity philosophy, targeting Lukácsian (and, more broadly, Hegelian-Marxist) totality claims.
  },
  keywords = {negative-dialectics, subject-object, reification, non-identity, primary-source, High, INCOMPLETE, no-abstract},
}

@book{adorno2006historyfreedom,
  author = {Adorno, Theodor W.},
  editor = {Tiedemann, Rolf},
  title = {History and Freedom: Lectures 1964--1965},
  year = {2006},
  publisher = {Polity},
  address = {Cambridge},
  note = {
  CORE ARGUMENT: These lecture courses, delivered on the road to Negative Dialectics, work through Kant's and Hegel's philosophies of history and freedom, developing Adorno's view that history is neither a meaningful, progressive totality (Hegel) nor reducible to individual moral autonomy (Kant), but a "natural-historical" process in which freedom appears only fragmentarily, against the grain of a administered, reified social totality.

  RELEVANCE: Directly engages the philosophy-of-history questions central to the wider project--what a materialist alternative to Hegelian philosophy of history looks like--while showing in lecture form the argumentative steps (critique of totality-as-reconciliation, critique of universal-historical necessity) condensed in Negative Dialectics; complements Lukács's own philosophy-of-history writings as a critical counter-model.

  POSITION: Primary source for Adorno's philosophy of history, in explicit dialogue with the Hegelian-Marxist tradition Lukács represents.
  },
  keywords = {philosophy-of-history, negative-dialectics, freedom, Hegel, Kant, primary-source, High, INCOMPLETE, no-abstract},
}

@book{korsch1970marxismphilosophy,
  author = {Korsch, Karl},
  title = {Marxism and Philosophy},
  year = {1970},
  publisher = {Monthly Review Press},
  address = {New York},
  note = {
  CORE ARGUMENT: Korsch argues, in close parallel to Lukács's History and Class Consciousness (published the same year, 1923), that orthodox Second International Marxism wrongly treated Marxist theory as a philosophically neutral science standing outside the class struggle; instead, Marxist theory is itself a historically specific, partisan moment of revolutionary practice, continuous with rather than opposed to the Hegelian dialectic it is often thought to have superseded.

  RELEVANCE: The co-foundational text of Western Marxism alongside History and Class Consciousness; essential primary source for comparing Lukács's and Korsch's near-simultaneous, independently developed critiques of scientistic Marxism and their shared reassertion of the theory-practice unity.

  POSITION: Founding Western Marxist text, historicist rather than ontological in its critique of orthodox Marxism, and more explicitly focused on the history and sociology of Marxist theory itself than Lukács's parallel work.
  },
  keywords = {Western-Marxism, theory-practice, historicism, primary-source, High, INCOMPLETE, no-abstract},
}

@book{gramsci1971prisonnotebooks,
  author = {Gramsci, Antonio},
  editor = {Hoare, Quintin and Nowell-Smith, Geoffrey},
  title = {Selections from the Prison Notebooks},
  year = {1971},
  publisher = {International Publishers},
  address = {New York},
  note = {
  CORE ARGUMENT: Written in fascist imprisonment largely without access to contemporary Marxist theory (including History and Class Consciousness), the Notebooks develop hegemony (cultural-political leadership secured through consent as well as coercion), the "philosophy of praxis" (Gramsci's coded term for a non-determinist, historicist Marxism), and the organic intellectual as tools for analyzing why revolution succeeded in Russia but stalled in the more "civil-societal" states of Western Europe.

  RELEVANCE: Provides the third term needed to assess whether "Western Marxism" names a coherent shared position or a retrospective grouping of independently developed projects; Gramsci's hegemony concept and historicism are frequently compared with and contrasted to Lukács's totality and reification.

  POSITION: Co-founding Western Marxist text, developed independently of Lukács and Korsch, emphasizing political strategy and cultural hegemony over the epistemological and ontological questions that dominate History and Class Consciousness.
  },
  keywords = {hegemony, philosophy-of-praxis, Western-Marxism, primary-source, High, INCOMPLETE, no-abstract},
}

@book{honneth2008reification,
  author = {Honneth, Axel},
  editor = {Jay, Martin},
  title = {Reification: A New Look at an Old Idea},
  year = {2008},
  publisher = {Oxford University Press},
  address = {New York},
  doi = {10.1093/acprof:oso/9780195320466.003.0002},
  note = {
  CORE ARGUMENT: In this Tanner Lecture (with responses by Judith Butler, Raymond Geuss, and Jonathan Lear), Honneth reconstructs reification as a "forgetfulness of recognition": a prior, existential form of empathetic recognition of others and of oneself that is temporarily suspended, then congeals into habitual, detached, quasi-thing-like comportment. This detaches reification from its Lukácsian anchoring in the commodity form and capitalist rationalization, generalizing it into a recognition-theoretic category that need not be capitalism-specific.

  RELEVANCE: The pivotal text in the "afterlife of reification" this domain traces: it is the point at which Lukács's concept is most thoroughly reworked outside a Marxist framework, prompting the sharp responses (Foster, Kavoulakos) that ask whether this recognition-theoretic generalization preserves or dissolves Lukács's original critical target.

  POSITION: Recognition-theoretic reconstruction of reification that explicitly supersedes Lukács's capitalism-centered account, provoking the domain's central controversy over the concept's proper scope.
  },
  keywords = {reification, recognition, Honneth, primary-source, High, INCOMPLETE, no-abstract}
}

@book{goldmann1977lukacsheidegger,
  author = {Goldmann, Lucien},
  title = {Lukács and Heidegger: Towards a New Philosophy},
  year = {1977},
  publisher = {Routledge and Kegan Paul},
  address = {London},
  note = {
  CORE ARGUMENT: Based on Goldmann's 1967--68 lectures, the book argues that Heidegger's Being and Time is deeply, if unacknowledged, indebted to Lukács's History and Class Consciousness (both published in the early 1920s), sharing a common diagnosis of inauthentic, reified everyday existence; Goldmann uses this rapprochement to stake out his own genetic-structuralist Marxist position, distinguishing it from both Lukácsian totality and Heideggerian ontology.

  RELEVANCE: The key text for the "later reception" strand concerned with how Goldmann appropriates and revises Lukács's categories (totality, reification, world-view) for his own sociology of literature and philosophy, while using the Heidegger comparison to test the limits of Lukács's framework.

  POSITION: Genetic-structuralist appropriation and partial critique of Lukács, mediated through a controversial thesis about Heidegger's debts to History and Class Consciousness.
  },
  keywords = {Goldmann, Heidegger, reification, genetic-structuralism, primary-source, High, INCOMPLETE, no-abstract},
}

@book{postone1993timelabor,
  author = {Postone, Moishe},
  title = {Time, Labor, and Social Domination: A Reinterpretation of Marx's Critical Theory},
  year = {1993},
  publisher = {Cambridge University Press},
  address = {Cambridge},
  note = {
  CORE ARGUMENT: Postone argues that "traditional Marxism," including Lukács's History and Class Consciousness, mistakenly treats labor and the proletariat as trans-historically valid standpoints of critique, when in fact abstract labor and value are themselves historically specific forms of domination unique to capitalism; a genuine critical theory must therefore criticize labor's social role under capitalism rather than counterpose an idealized concrete labor or proletarian standpoint to capital.

