  title = {Why Students of the Frankfurt School Will Have to Read Lukács},
  booktitle = {The Palgrave Handbook of Critical Theory},
  year = {2017},
  pages = {109--133},
  publisher = {Palgrave Macmillan US},
  doi = {10.1057/978-1-137-55801-5_6},
  note = {
  CORE ARGUMENT: Feenberg argues that despite the Frankfurt School's frequent silence about or distancing from Lukács, its core categories--reification, the critique of instrumental reason, the possibility of a non-dominating relation to nature and society--are unintelligible without History and Class Consciousness as their conceptual point of departure, making Lukács an indispensable, if often unacknowledged, source for critical theory.

