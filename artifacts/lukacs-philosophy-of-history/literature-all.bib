@article{nakhimovsky2022lukacsrealpolitik,
  author = {Nakhimovsky, Isaac},
  title = {Georg Lukács and Revolutionary Realpolitik, 1918--19: An Essay on Ethical Action, Historical Judgment, and the History of Political Thought},
  journal = {Journal of the History of Ideas},
  year = {2022},
  volume = {83},
  number = {1},
  pages = {63--85},
  doi = {10.1353/jhi.2022.0003},
  note = {
  CORE ARGUMENT: Nakhimovsky argues that Lukács's 1918-19 essays "Bolshevism as a Moral Problem" and "Tactics and Ethics" are best understood not as autobiographical stages in a personal conversion narrative but as contributions to a shared discourse of political ethics -- closely related to Max Weber's contemporaneous "Politics as a Vocation" -- descending from Fichte's account of Realpolitik and "ethically responsible" revolutionary action. He contends that treating these texts as mere transitional moments in a conversion story or a history-of-ideas sequence has an "inhibiting effect on historical and political judgment."

  RELEVANCE: Directly challenges the standard historiographical habit (found even in sympathetic continuity accounts) of reading the 1918 conversion essays primarily as biographical way-stations, proposing instead that they be read as autonomous contributions to political thought; this reframes what counts as evidence in the periodization debate.

  POSITION: Explicitly critiques both "conversion narrative" and simple "history of political thought" framings, arguing for a third mode of reading focused on ethical-political judgment.
  },
  keywords = {periodization, Bolshevism-conversion, political-ethics, Weber, High},
  abstract = {Abstract:"Bolshevism as a Moral Problem" and "Tactics and Ethics" were discussions of political ethics closely related to Max Weber's contemporaneous "Politics as a Vocation." They diverged from one another in their historical assessments of possibilities for ethically responsible revolutionary action. They are best understood as developments of an approach to political judgment originally forged by Johann Gottlieb Fichte, whose concerns were associated by Weber with Realpolitik and which continue to animate discussions of "political realism." Overwriting these concerns as transitional moments in personal conversion narratives or the history of political thought has an inhibiting effect on historical and political judgment.},
  abstract_source = {s2},
}

@article{westerman2017myshkintomarxism,
  author = {Westerman, Richard},
  title = {From Myshkin to Marxism: The Role of Dostoevsky Reception in Lukács's Revolutionary Ethics},
  journal = {Modern Intellectual History},
  year = {2017},
  volume = {16},
  number = {3},
  pages = {927--960},
  doi = {10.1017/s1479244317000373},
  note = {
  CORE ARGUMENT: Westerman traces how Lukács's engagement with Dostoevsky -- initially a resource for pre-Marxist ethical individualism -- is transformed into a component of his revolutionary ethics after 1917-18, arguing that Dostoevsky reception functions as a mediating link between the aesthetic-ethical concerns of the pre-Marxist period and the political theory of the Bolshevik-period essays.

  RELEVANCE: Supplies a concrete textual mechanism (the shifting function of a single recurring reference point, Dostoevsky) by which continuity theorists can specify how pre-Marxist concerns are transposed rather than abandoned, complementing the more general continuity arguments of Löwy and Arato/Breines with a focused case study.

  POSITION: Continuity-via-transposition model, focused on a single intellectual through-line (Dostoevsky) rather than a global thesis about Lukács's development.
  },
  keywords = {periodization, Dostoevsky, ethics, continuity-thesis, Medium},
  abstract = {For European literati of the early twentieth century, Fyodor Dostoevsky represented a mythically Russian spirituality in contrast to a soulless, rationalized West. One such enthusiast was Georg Lukács, who in 1915 began a never-completed book about Dostoevsky's work, a model of spiritual community that could redeem a fallen world. Though framing his analysis in the language and themes of broader Dostoevsky reception, Lukács used this idiom innovatively to go beyond the reactionary implications this model might connote. Highlighting similarities with Max Weber's account of political ethics, I argue that Lukács developed an ethic derived from his reading of Dostoevsky, which focused on the idea of a hero defined by an ability to resolve the specific ethical dilemma of adherence to duty and moral law on the one hand, and, on the other, the need to restore spontaneous human community at a time when the social institutions embodying such laws had fallen into decay. Crucially, he deployed the same framework after his conversion to Marxism to justify revolutionary terror. However different his position from Dostoevsky's, it was through engagement with these novels that Lukács not only clarified his thought but also came to identify Lenin as a Dostoevskyan hero figure.},
  abstract_source = {openalex},
}

@incollection{markus2011lifeandsoul,
  author = {Markus, György},
  title = {Life and the Soul: The Young Lukács and the Problem of Culture},
  booktitle = {Culture, Science, Society},
  publisher = {Brill},
  year = {2011},
  pages = {521--551},
  doi = {10.1163/ej.9789004202405.i-666.68},
  note = {
  CORE ARGUMENT: Markus argues that the problem of "culture" -- the possibility of a meaningful, integrated form of life -- is the organizing concern of the young Lukács's essayistic and aesthetic writings (Soul and Form and related texts), and that this problem, rather than any specific doctrine, is what persists into the Marxist-period critique of reified capitalist society.

  RELEVANCE: Cited in the SEP bibliography as a foundational statement on the young Lukács; provides the "problem of culture" as an alternative organizing category (alongside "totality" and "form") for tracing continuity across the periodization divide, originally published in 1983 in the essay collection Lukács Revalued.

  POSITION: Continuity model organized around the persistence of "the problem of culture" rather than a specific philosophical doctrine.
  },
  keywords = {periodization, culture, young-Lukacs, continuity-thesis, High},
  abstract = {With baffling suddenness, without any transition it seemed, Lukacs made a radical break with all his earlier work, work that, if only on account of its influence on his contemporaries, cannot simply be labelled dismissively as "immature" or "escapist". The year 1918 did not, however, mark Lukacs' first intellectual encounter with Marxism and socialism as representing both a problem and an alternative. The picture becomes even more paradoxical when we consider those aspects of Lukacs' thought that were central to his intellectual conversion. If one compares the essay Bolshevism as an Ethical Problem, which appeared in 1918, with Tactics and Ethics, written only a few months later, one finds that the same problem is raised in both pieces. Parallel trains of thought can be identified at more than one level, and even identical formulations.},
  abstract_source = {openalex},
}

@article{tihanov2022exilicmarxisms,
  author = {Tihanov, Galin},
  title = {Exilic Marxisms: Lukács and Balázs in Stalin's Moscow},
  journal = {Thesis Eleven},
  year = {2022},
  volume = {171},
  number = {1},
  pages = {30--46},
  doi = {10.1177/07255136221116379},
  note = {
  CORE ARGUMENT: Tihanov examines the specific institutional and existential conditions of Lukács's Moscow exile (from 1930) alongside that of his friend and fellow Hungarian exile Béla Balázs, arguing that the category of "exilic Marxism" captures features of this period -- displacement, dependence on Soviet institutions, self-censorship -- that are obscured when the Moscow years are treated simply as "the Stalinist phase" of a linear biography.

  RELEVANCE: Adds a distinct periodization category ("exile") to the more familiar young/mature/late trichotomy, relevant for assessing how far Lukács's 1930s public retraction of History and Class Consciousness reflects genuine revision versus the structural pressures of exile.

  POSITION: Situates the Moscow-period self-criticism within the material and institutional conditions of exile rather than treating it purely as philosophical development or personal capitulation.
  },
  keywords = {periodization, Moscow-exile, Stalinism, Medium},
  abstract = {This paper discusses exile and emigration as factors in the encounters of art, philosophy, cultural criticism, and political power in Soviet Russia under Stalin. While by now we possess considerable knowledge about emigration and exile from Eastern and Central Europe to the West in the 1920s and 1930s, we have tended to under-research and under-conceptualize the alternative destination. Seemingly less glamorous and lastingly tainted by the open glorification or silent acquiescence to Stalin and the purges, Moscow as a place of emigration and exile of left East-Central European intellectuals in the 1930s presents a uniquely important trajectory, the study of which contributes to enriching and refining our understanding not just of the history of international communism, but also -- and perhaps more importantly -- of the formation of the intellectual and political elites that were to shape life in the Eastern Bloc after 1945.},
  abstract_source = {openalex},
}

@article{congdon2007apotheosizing,
  author = {Congdon, Lee},
  title = {Apotheosizing the Party: Lukács's Chvostismus und Dialektik},
  journal = {Studies in East European Thought},
  year = {2007},
  volume = {59},
  number = {4},
  pages = {281--292},
  doi = {10.1007/s11212-007-9039-2},
  note = {
  CORE ARGUMENT: Congdon analyzes "Tailism and the Dialectic" (Chvostismus und Dialektik), Lukács's 1925-26 unpublished manuscript defending History and Class Consciousness against party critics, arguing that in it Lukács moves toward "apotheosizing the party" -- subordinating his own philosophical positions to the authority of the Communist Party -- a shift Congdon reads as an early stage of the self-censorship that would culminate in the 1933 public retraction.

  RELEVANCE: Locates a specific intermediate document (unpublished until 1996) between History and Class Consciousness (1923) and the 1933/1967 acts of self-criticism, complicating any simple two-stage (young/mature) periodization by identifying an internal 1925-26 turning point in Lukács's relationship to party orthodoxy.

  POSITION: Self-subordination/accommodation model; treats Lukács's growing party-deference in the mid-1920s as continuous with, and preparatory to, his later public self-criticisms.
  },
  keywords = {periodization, tailism, party-orthodoxy, self-criticism, Medium, INCOMPLETE, no-abstract}
}

@article{forczek2023postfestum,
  author = {Forczek, Ákos},
  title = {The post festum-rationality of history in Georg Lukács' Ontology},
  journal = {Studies in East European Thought},
  year = {2023},
  volume = {76},
  number = {2},
  pages = {177--192},
  doi = {10.1007/s11212-022-09536-4},
  note = {
  CORE ARGUMENT: Forczek addresses the 1968-69 "Budapest School" critique (Fehér, Heller, Márkus, Vajda) of Lukács's unfinished late work, the Ontology of Social Being, which charged that the text mixes two incompatible ontologies. Forczek argues this charge is misleading: there are not "two ontologies" in the unfinished book, and the apparent tension dissolves once Lukács's thesis of the "post festum-rationality" of history -- that historical rationality is only visible retrospectively -- is properly understood.

  RELEVANCE: Extends the periodization question to the very end of Lukács's career and to his own students' internal critique, showing that the "how many Lukácses" problem recurs even within a single late, unfinished text, not only across the pre-Marxist/Marxist divide.

  POSITION: Defends the internal coherence of the late Ontology against the Budapest School's discontinuity charge, implicitly a continuity/unity reading of the late work considered on its own terms.
  },
  keywords = {periodization, late-Lukacs, ontology, Budapest-School, Medium},
  abstract = {During the winter of 1968-69, members of the so-called Budapest School formulated a scathing "review" of Georg Lukács' late work, Ontology of Social Being. In the wake of the objections (but not in accordance with them), Lukács began to revise the text, but was unable to complete it: he died in June 1971. The disciples' critique, published in English and German in 1976, played a major role in the reception history of Ontology -- or rather in the fact that the 1500-page "philosophical fiasco" still has no remarkable reception history. The main criticism of the disciples is that Lukács' work mixes two incompatible ontologies and recalls the worst traditions of Soviet Marxism. In this paper, I will argue that the disciples' "review" is misleading (nevertheless, the historical circumstances may provide a sufficient explanation for this) because there are no "two ontologies" in Lukács' unfinished book. I will concentrate on the source of the misunderstanding, the Lukácsian thesis of the "post festum-rationality" of history, and in the light of this I will analyse how Lukács describes the open determination of individual and collective action in the process of the social reproduction of life.},
  abstract_source = {s2},
}

@article{baehrens2023preface1967,
  author = {Baehrens, Konstantin},
  title = {"Preface to the New Edition (1967)" [of G. Lukács's History and Class Consciousness]: Introducing New Agendas II},
  journal = {Dissonância: Revista de Teoria Crítica},
  year = {2023},
  volume = {7},
  pages = {1--28},
  note = {
  CORE ARGUMENT: Published in a special issue marking the centenary of History and Class Consciousness, Baehrens reads the 1967 preface as itself setting a "new agenda" for how the book should be received -- distinct from, and in tension with, the agenda set by Lukács's own 1922 preface -- rather than as a simple retraction or straightforward continuation of the original text's project.

  RELEVANCE: Offers a close, recent reading of the exact document (the 1967 preface) that the domain's key question about "repudiation, tactical accommodation, or genuine philosophical revision" turns on; its companion piece on the 1922 preface (Baehrens 2023, "Introducing New Agendas I") allows direct textual comparison of Lukács's two self-framings of the same book.

  POSITION: Treats the 1967 preface as an agenda-setting text in its own right rather than transparent autobiographical testimony, cutting across the repudiation/accommodation/revision trichotomy by reframing the interpretive question.
  },
  keywords = {periodization, 1967-preface, self-criticism, History-and-Class-Consciousness, High, INCOMPLETE, no-abstract}
}

@article{baehrens2023preface1922,
  author = {Baehrens, Konstantin},
  title = {"Preface (1922)" [to G. Lukács's History and Class Consciousness]: Introducing New Agendas I},
  journal = {Dissonância: Revista de Teoria Crítica},
  year = {2023},
  volume = {7},
  pages = {1--26},
  note = {
  CORE ARGUMENT: Companion piece to Baehrens's essay on the 1967 preface, this article analyzes the original 1922 preface to History and Class Consciousness as setting its own distinct interpretive "agenda" for the essays that follow, establishing the baseline against which the later 1967 self-criticism can be measured.

  RELEVANCE: Provides the necessary textual counterpart for any argument (e.g., about repudiation vs. revision) that depends on comparing what Lukács claimed for the book in 1922 against what he claimed against it in 1967.

  POSITION: Treats the 1922 preface as an active agenda-setting document rather than a neutral introduction, methodologically paired with the same author's treatment of the 1967 preface.
  },
  keywords = {periodization, 1922-preface, History-and-Class-Consciousness, Medium, INCOMPLETE, no-abstract}
}

@article{maccio1972latelukacs,
  author = {Macciò, Marco},
  title = {On the Late Lukács},
  journal = {Telos},
  year = {1972},
  volume = {1972},
  number = {11},
  pages = {135--141},
  doi = {10.3817/0372011135},
  note = {
  CORE ARGUMENT: Writing shortly after Lukács's death, Macciò addresses the reception and evaluation of "the late Lukács" -- the post-War aesthetic and ontological writings -- against the backdrop of the already-canonical young/early-Marxist Lukács of History and Class Consciousness, contributing to the early Telos-circle debate about how much authority to grant Lukács's own late self-understanding.

  RELEVANCE: Represents an early instance (1972) of the "young vs. late Lukács" framing device explicitly named in the domain's search strategy, showing that the periodization question was already a live category for Anglophone New Left readers immediately after Lukács's death, prior to the archivally grounded biographies of the late 1970s-80s.

  POSITION: Early statement of the young/late Lukács framing within the Telos-journal reception of Lukács in the Anglophone New Left.
  },
  keywords = {periodization, late-Lukacs, Telos, Low},
  abstract = {Abstract The recent translation of History and Class Consciousness with a new "Preface" written in 1967, and the publication of Gespräche mit Lukács now allow an all-embracing critical study of Lukács' theoretical and political thought. As is well known, after having rejected his own conceptions of the dialectic as contained in History and Class Consciousness, Lukács had never given a new all-inclusive reformulation. In the Gespräche mit Lukács, the Hungarian philosopher places as the basis of his philosophy the Marxian principle according to which there is only one science of history which goes from astronomy to sociology. Reality is a process, a development and a dialectic in each of its three fundamental forms (inorganic, organic, and social), in the connection of these forms, and in each of the many partial wholes.},
  abstract_source = {openalex},
}

@article{arato1972reification,
  author = {Arato, Andrew},
  title = {Lukacs' Theory of Reification},
  journal = {Telos},
  year = {1972},
  volume = {1972},
  number = {11},
  pages = {25--66},
  doi = {10.3817/0372011025},
  note = {
  CORE ARGUMENT: Arato offers a systematic exposition of the "Verdinglichung" chapter of History and Class Consciousness, tracing the concept of reification from its historical roots ("thingification") through two convergent derivations: Lukács's rediscovery of the subject-object dialectic in German classical philosophy and in Marx, and his critique of Weberian sociology's categories as themselves expressions of the immediately given, reified world of bourgeois society.

  RELEVANCE: One of the earliest (Anglophone New Left, Telos-circle) systematic reconstructions of the reification essay, establishing the double derivation (idealist philosophy plus Weberian sociology) that later scholarship (Bueno and Teixeira 2017; Kavoulakos 2019) continues to refine; useful as a baseline against which the more recent neo-Kantian-genealogical readings can be measured.

  POSITION: Early, comprehensive Telos-circle exposition treating reification as the synthesis of a Marxian economic category and a Hegelian-derived dialectic of subject and object.
  },
  keywords = {reification, Weber, German-idealism, Telos, High},
  abstract = {Abstract The theory of reification is an indispensable part of the dialectical theory of society. The first large scale formulation of this theory was presented by Georg Lukács in 1923, in History and Class Consciousness. The concept of reification [Verdinglichung] came to Lukács through several channels. He presents us with a Marxian definition. Reification [res: thing: das Ding] refers to the phenomenon (and the resulting phenomena) of a “definite social relation between men” appearing [emerging and seeming] in the form of a “relation between things”. It could be pointed out that Lukács also uses reification as a synonym for alienation [Entfremdung], rationalization, atomization and deactivization.},
  abstract_source = {openalex},
}

@article{colletti1971secondinternational,
  author = {Colletti, Lucio},
  title = {The Marxism of the Second International},
  journal = {Telos},
  year = {1971},
  volume = {1971},
  number = {8},
  pages = {84--91},
  doi = {10.3817/0671008084},
  note = {
  CORE ARGUMENT: Colletti characterizes Second-International Marxism (Kautsky, Plekhanov, and the theoreticians of the SPD) as having recast Marx's dialectical materialism into a positivist, evolutionary "scientific socialism" modeled on the natural sciences, collapsing the distinctively Hegelian-dialectical elements of Marx's method into a deterministic philosophy of history akin to Darwinian or Spencerian evolutionism.

  RELEVANCE: Provides the classic, non-Lukács-specific characterization of exactly the target ("vulgar"/scientistic, evolutionary Marxism) that Lukács's "What Is Orthodox Marxism?" and the Reification essay attack; essential context for assessing whether Lukács's charge of Second-International "contemplative," fact-bound positivism is historically accurate.

  POSITION: Foundational (Telos-circle) diagnosis of Second-International Marxism as scientistic positivism, independent of but historically convergent with Lukács's own critique.
  },
  keywords = {Second-International, Kautsky, positivism, Telos, Medium},
  abstract = {Abstract The very notion of “Marxism of the Second International” is a loose one which requires precise definition. It will be used here in a limited sense, i.e., as the Marxism of the two major Marxist theoreticians of the period: Kautsky and Plekhanov. This “practical” definition should not be taken to mean that the Marxism of the Second International is a self-contained phenomenon clearly defined with respect to the First International and to what followed. Actually, much of the Marxism of the Second International can be found in Engels' last works: Ludwig Feuerbach; The Origins of the Family, Private Property and the State; and the 1895 “Introduction” to the new edition of Class-Struggles in France.},
  abstract_source = {openalex},
}

@article{kavoulakos2019reification,
  author = {Kavoulakos, Konstantinos},
  title = {What is reification in Georg Lukács's early Marxist work?},
  journal = {Thesis Eleven},
  year = {2019},
  volume = {157},
  number = {1},
  pages = {41--59},
  doi = {10.1177/0725513619889693},
  note = {
  CORE ARGUMENT: Kavoulakos argues that Lukács's Reification essay deploys the neo-Kantian concept of the "form of objectivity" (inherited from his pre-Marxist work analyzing social rationalization) to grasp the constitutive form of all objects in bourgeois society; Marx's commodity form becomes the "archetype" of capitalist objectivity because it converts qualitative content into quantitative, calculable categories, so that formal/calculative rationality penetrates every kind of objectification -- producing reification as the de-historicization and political neutralization of social relations and consciousness only once rational objectification becomes universalized under capitalism.

  RELEVANCE: Directly answers the domain's diagnostic question by specifying the precise neo-Kantian mechanism (the "form of objectivity") through which reification unifies the critique of philosophy, science, and social form; central for reconstructing how Lukács's pre-Marxist neo-Kantian training supplies the conceptual architecture of the mature critique.

  POSITION: Neo-Kantian-genealogical reading: reification is fundamentally the universalization of a neo-Kantian form-concept, not simply an application of Marx's economic category of fetishism.
  },
  keywords = {reification, neo-Kantianism, form-of-objectivity, Thesis-Eleven, High},
  abstract = {After the initial formulation of the concept of reification in Georg Lukács’s History and Class Consciousness (HCC, 1923), a series of confusing uses of it within critical theory have contributed to blurring its contours. In his pre-Marxist work, while analyzing the social rationalization process, Lukács located the modern form of mediation between subject and object and connected it with certain effects on the level of human consciousness and behavior. This very scheme is repeated and refined in HCC. In the Reification essay, Lukács uses the neo-Kantian concept of the “form of objectivity” to grasp the central constitutive form of all kinds of objects in bourgeois society. He interprets Marx’s commodity form as the “archetype” of all capitalist objectivity, which consists in converting qualitative contents into quantitative categories. Thus, the formal/calculative rationality of exchange penetrates all kinds of objectification in modern society. In Lukács’s view, only in its modern, universalized form does rational objectification bring about the phenomenon of reification, i.e. the de-historicization and political neutralization of the social relations that constitute the social system and the dominant forms of consciousness. This systemic, cultural, and political understanding of reification can prove to be fruitful in the context of contemporary discussions on democratic transformative praxis.},
  abstract_source = {s2},
}

@article{jaffe2020antinomicstandpoint,
  author = {Jaffe, Aaron},
  title = {Lukács' antinomic `standpoint of the proletariat': From philosophical to socio-historical determination},
  journal = {Thesis Eleven},
  year = {2020},
  volume = {157},
  number = {1},
  pages = {60--79},
  doi = {10.1177/0725513620911841},
  note = {
  CORE ARGUMENT: Jaffe argues that in resolving the antinomies of bourgeois philosophy through the revolutionary "standpoint of the proletariat," Lukács illegitimately transposes the logical necessity proper to philosophical determinations into possibilities for revolutionary praxis embedded in socio-historical contexts; because the standpoint is posited as the singular, necessary solution to the antinomies, it is abstractly and one-sidedly determined rather than empirically or diversely constituted, reproducing at a higher level the very antinomic structure it claims to overcome.

  RELEVANCE: Provides a rigorous immanent critique of the move from "antinomies of bourgeois thought" diagnosis to constructive resolution, directly bearing on whether Lukács's critical apparatus licenses the positive philosophy of history built on it; a key text for assessing whether the antinomies are genuinely resolved or merely relocated.

  POSITION: Immanent-critique reading: the proletarian standpoint remains "antinomic," an abstractly derived philosophical solution masquerading as socio-historical determination.
  },
  keywords = {antinomies, standpoint-of-the-proletariat, Thesis-Eleven, High},
  abstract = {In History and Class Consciousness’ central essay ‘Reification and the Consciousness of the Proletariat’, Lukács resolved the antinomies of bourgeois philosophy in the revolutionary ‘standpoint of the proletariat’. Lukács’ strategy in deriving this proletarian standpoint, however, transposed the logical necessity appropriate to philosophical determinations into possibilities for revolutionary praxis imbedded in socio-historical contexts. Further, since the standpoint is determined as the necessary solution to bourgeois antinomies, it must be conceived singularly, rather than through its manifest diversity. As the key to mediating the social totality beyond antinomies, the ‘standpoint of the proletariat’ is therefore merely reflectively posited and one-sidedly determined. While many have developed logical, social-analytic, and political problems associated with determining the proletariat by way of its imputed or party-determined rather than empirical consciousness, few point to the very concept ‘standpoint of the proletariat’ as the source for these problems due to the fact that it is an abstractly derived solution to a philosophically posed problem. Socio-historical determination working with the modality of possibility can resolve Lukács’ antinomic determination of the standpoint of the proletariat.},
  abstract_source = {s2},
}

@article{lopez2020antinomies,
  author = {López, Daniel Andrés},
  title = {Lukács: The antinomies of bourgeois philosophy and the absolute},
  journal = {Thesis Eleven},
  year = {2020},
  volume = {157},
  number = {1},
  pages = {110--132},
  doi = {10.1177/0725513620911859},
  note = {
  CORE ARGUMENT: López reconstructs Lukács's immanent critique of German Idealism in the Reification essay -- his critical evaluation of the antinomies he discovers successively in Kant, Fichte, Schelling, and Hegel -- to show that Lukács's concept of praxis is explicitly built to bear the weight of, and overcome, Hegel's Absolute. López argues Lukács fails: his "solution," won after the historical event as a philosophical reflection in properly Hegelian fashion, remains unconsciously within speculative philosophy, so that the philosophy of praxis possesses a theological dimension and is itself an instance of the "conceptual mythology" Lukács sought to overcome.

  RELEVANCE: Offers the most detailed reconstruction available of exactly how Lukács "reconstructs classical German philosophy as a symptom of capitalist social structure" -- tracing the antinomies through Kant, Fichte, Schelling, and Hegel in turn -- while simultaneously showing the immanent limits of that reconstruction.

  POSITION: Immanent-critique reading: Lukács's philosophy of praxis remains within the Hegelian speculative tradition it claims to have overcome, and is best understood as a "conceptual mythology."
  },
  keywords = {antinomies, German-idealism, Hegel, Thesis-Eleven, High},
  abstract = {I reconstruct Lukács’s immanent critique of German Idealism, found within his essay ‘Reification and the Consciousness of the Proletariat’ (in History and Class Consciousness), in order to foreground his philosophical reflection on the concepts of mediation, logic, genesis and praxis. I situate this reflection within his philosophy of praxis as a whole before highlighting the dialectical development of these terms within it. They are posited initially as abstract, methodological demands and are subsequently concretised and enriched, via Lukács’s critical evaluation of the antinomies he discovers in Kant, Fichte, Schelling and Hegel. My reconstruction is both exegetical and critical. I demonstrate that Lukács’s concept of praxis (as the culmination of mediation, logic and genesis) is explicitly intended to both bear the weight of Hegel’s Absolute and overcome it. On this basis, I propose a novel immanent critique of Lukács’s philosophy of praxis, suggesting that while Lukács wishes his concept of praxis to express a living, present and ontologically novel truth, his insight is won – in the fashion of Hegelian philosophy – after the historical event upon which it is built, as a philosophical reflection. Lukács’s self-contradiction is that while he regards his philosophy of praxis as having overcome speculative, Hegelian philosophy, in fact, the position he generates remains firmly but unconsciously within it. Consequently, Lukács’s philosophy of praxis possesses a theological dimension and must be regarded as an example of the kind of ‘conceptual mythology’ he sought to overcome.},
  abstract_source = {s2},
}

@article{lazarus2020roselegacy,
  author = {Lazarus, Michael},
  title = {The legacy of reification: Gillian Rose and the value-form theory challenge to Georg Lukács},
  journal = {Thesis Eleven},
  year = {2020},
  volume = {157},
  number = {1},
  pages = {80--96},
  doi = {10.1177/0725513620911854},
  abstract = {This article examines the relationship between Marx's Capital, Georg Lukács and Critical Theory through the prism of value-form theory. Marx's theorisation of value understands commodities as expressions of the historical form of social relations defined by capital. Products of human labour become values in capitalist production, defined by the abstract quality of undifferentiated quantities of labour-power, exchangeable through the universal character of the market. The social form of this process, Marx identifies as processing a fetish quality, where humans take on the thing-like character of commodities. The impact of this theorisation on Critical Theory has been considerable, beginning with Lukács' concept of reification. In Part I, I examine the challenge to Lukács' interpretation of Marx's Capital made by Gillian Rose. She draws attention to a misidentification of reification in Marx, suggesting a strong conceptual distinction between commodity-fetishism and reification. In their conceptual flattening, Rose contends that Lukács and Critical Theory generalised Marx's value-form theory, losing its speculative character. I argue that despite Rose's suggestion remaining unfulfilled, she helps illuminate important tensions between Marx's value theory and Critical Theory. This comparison allows in Part II for the beginning level of a speculative approach to Marx's Capital to be advanced.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Lazarus reconstructs Gillian Rose's challenge that Lukács and Critical Theory generally conflate "commodity fetishism" (a specific Marxian category) with "reification" (a broader, more diffuse category), a conceptual flattening that loses the speculative character of Marx's value-form theory; Lazarus argues Rose's own proposed alternative remains unfulfilled but nonetheless illuminates real tensions between Marx's value theory and the Critical Theory tradition descending from Lukács.

  RELEVANCE: Directly engages the value-form-theoretic challenge to Lukács's foundational move of extending commodity fetishism into "reification" as a unifying diagnostic; essential for assessing the conceptual coherence of the reification-based critique of bourgeois thought and science that this domain investigates.

  POSITION: Value-form-theoretic challenge: reification and commodity fetishism are not simply identical, and Lukács's generalization of the latter into the former dissolves Marx's specifically speculative analysis of value.
  },
  keywords = {reification, commodity-fetishism, Gillian-Rose, value-form-theory, Thesis-Eleven, High}
}

@article{buenoteixeira2017spectres,
  author = {Bueno, Arthur and Teixeira, Mariana},
  title = {Spectres of reification: Weber and Simmel on History and Class Consciousness},
  journal = {Journal of Classical Sociology},
  year = {2017},
  volume = {17},
  number = {2},
  pages = {101--115},
  doi = {10.1177/1468795X17693434},
  note = {
  CORE ARGUMENT: Bueno and Teixeira trace how Lukács's reification chapter absorbs and transforms Max Weber's account of formal-calculative rationalization and Georg Simmel's diagnosis (in The Philosophy of Money and "The Tragedy of Culture") of the modern proliferation of objectified cultural forms estranged from subjective life, arguing that Lukács historicizes both by locating their "transhistorical" diagnoses of modernity within the specific social form of generalized commodity exchange.

  RELEVANCE: Provides the most direct treatment available of how Weber and Simmel function as targets and sources for the Reification essay, addressing the domain's key question of how neo-Kantian/Weberian sociology is reconstructed as symptomatic of capitalist social structure rather than a neutral description of "modernity" as such.

  POSITION: Weber/Simmel-critical reading: reification both depends on and historicizes Weberian rationalization and Simmelian cultural tragedy, converting an apparently transhistorical fate into a critique of a specific social form.
  },
  keywords = {Weber, Simmel, rationalization, sociology, High},
  abstract = {Georg Lukács’ famous essay on reification, published in 1923 in the book History and Class Consciousness, had a lasting impact on several critical philosophical and sociological currents throughout the twentieth century and remains relevant to the present day. The fruitfulness and longevity of Lukács’ approach can to a large extent be traced back to his creative and bold attempt to articulate distinct interpretations of the process of modernization within a theoretical framework inspired, for the most part, by Karl Marx’s analysis of commodity fetishism. It has been noted many times that Max Weber’s approach to the connection between Western rationalism and modern capitalism plays a crucial role in Lukács’ essay, as does Georg Simmel’s enquiry into the cultural significance of the modern monetary economy. This article intends to explore the tensions that arise out of such a challenging endeavour by way of an imaginary dialogue between Weber and Simmel, taking place shortly after the publication of History and Class Consciousness. This allows us not only to reflect on some of the intricacies of Lukács’ seminal essay but also to delve into fundamental contrasts between the Simmelian and Weberian approaches to social reality and modernity.},
  abstract_source = {openalex},
}

@article{lopez2020simmelabsolute,
  author = {López, Daniel Andrés},
  title = {The Absolute and the Relative in Lukács and Simmel},
  journal = {Zagreber germanistische Beiträge},
  year = {2020},
  volume = {29},
  pages = {79--102},
  doi = {10.17234/zgb.29.5},
  abstract = {This chapter builds on the author's earlier Hegelian critique of Lukács's philosophy of praxis by construing a conceptual dialogue between Lukács and his one-time mentor, Georg Simmel. It is argued that Lukács's philosophy in the 1920s was partially formed as a metacritique of Simmel's absolute relativism, as expressed in "The Philosophy of Money". However, Lukács's alternative generates a conceptual mythology that can be diagnosed in Simmelian terms and sublated by the philosophy of life outlined in "The View of Life". By situating it in the present, this may de-reify Lukács's concept of praxis, allowing it to satisfy its ethical and rational duty.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: López argues that Lukács's 1920s philosophy of praxis was formed partly as a metacritique of Simmel's "absolute relativism" in The Philosophy of Money, but that Lukács's own alternative generates a "conceptual mythology" diagnosable in precisely the Simmelian terms Lukács sought to transcend -- a mythology that could be "sublated" through Simmel's later philosophy of life.

  RELEVANCE: Extends López's antinomies argument (López 2020a) specifically to the Lukács-Simmel relationship, showing that Lukács's critique of neo-Kantian-adjacent Lebensphilosophie (via Simmel, his own early mentor) is structurally continuous with, and vulnerable to the same charge as, his critique of Kant/Hegel.

  POSITION: Immanent-critique reading extended to Simmel: Lukács's anti-relativist resolution of Simmelian "absolute relativism" reproduces a comparable conceptual mythology.
  },
  keywords = {Simmel, philosophy-of-money, conceptual-mythology, Medium}
}

@article{souza2024marxistmethod,
  author = {Soares de Souza, Mateus},
  title = {The Marxist Method as the Foundation of Social Criticism -- Lukács' Perspective},
  journal = {Open Philosophy},
  year = {2024},
  volume = {7},
  number = {1},
  doi = {10.1515/opphil-2024-0019},
  abstract = {Abstract The investigation into the foundations of social critique has increasingly gained importance in the tradition known as Critical Theory. In this context, I will analyze Lukács' work, particularly History and Class Consciousness, to comprehend the foundation he provides for social critique, rooted in the adoption of Marxism as a method. I posit that the escalating disjunction between the critique of the object and the critique of theory is attributable to the deepening social fragmentation engendered by capitalist structures. This inherent characteristic underscores the imperative for a cohesive amalgamation of epistemic and socio-ontological critique. To elucidate Lukács' model of critique, I will give particular attention to the chapter "What Is Orthodox Marxism?". By doing this, I aim to elucidate Lukács' assertion that the Marxist method facilitates a harmonious integration between the epistemic and socio-ontological dimensions of life, once it incorporates crucial categories such as historicity, totality, reciprocal action, and mediation. Furthermore, his method underscores the symbiotic relationship between some elements of the political economy and the German philosophical tradition, which shapes Lukács' conceptualization of critique.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Focusing on "What Is Orthodox Marxism?", Souza argues that Lukács grounds social critique in Marxism understood as method rather than as a body of economic doctrine, and that this method achieves a "harmonious integration" of epistemic and socio-ontological critique through the categories of historicity, totality, reciprocal action, and mediation -- categories Lukács presents as inherited jointly from classical political economy and German philosophy.

  RELEVANCE: Directly reconstructs the methodological essay in which Lukács most explicitly states his charge against Second-International economism (that "it is not the primacy of economic motives... but the point of view of totality" that distinguishes Marxism from bourgeois thought), supplying the domain's account of what "orthodox Marxism" positively requires against Kautsky-style determinism.

  POSITION: Reconstructs Lukács's own self-understanding of "orthodox Marxism" as a methodological (totality-and-mediation-based) rather than doctrinal (economic-determinist) commitment.
  },
  keywords = {orthodox-Marxism, totality, method, Second-International, Open-Philosophy, High}
}

@article{tripodi2024neurathhorkheimer,
  author = {Tripodi, Paolo},
  title = {"It Would be Helpful to Know Which Textbook Teaches the `Dialectic' he Advocates." Inserting Lukács into the Neurath--Horkheimer Debate},
  journal = {Open Philosophy},
  year = {2024},
  volume = {7},
  number = {1},
  doi = {10.1515/opphil-2024-0014},
  abstract = {Abstract The present article aims at providing some clarification on the Horkheimer-Neurath 1937 debate, so as to make three main claims: (a) around 1937 (even though perhaps neither in the early 1930s, at the time of his review of Mannheim's Ideology and Utopia, nor after the Second World War, at the time of Adorno's disenchanted statement, "the whole is the false"), Horkheimer belonged to the Hegelian-Marxist tradition stemming from Lukács's History and Class Conscioussness (1923); (b) notwithstanding Neurath's semantic and epistemological holism, his fallibilism, his rejection of Wertfreiheit in the social sciences, his commitment to socialism, there is still a gulf between his position and Horkheimer's, for Neurath did not accept the main methodological claim made by the latter, namely, the Lukács-inspired view that what "constitutes the decisive difference between Marxism and bourgeois thought" is the Hegelian "point of view of totality"; (c) highlighting the main differences between Neurath's and Lukács's versions of Marxism -- one concerning the very idea of dialectic, and the other concerning the epistemic privilege of the proletariat -- can throw some light on and help understand better the distinctive features of Lukács's Hegelianization of Marxism.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Tripodi uses the 1937 Horkheimer-Neurath debate to show that Horkheimer's early Critical Theory belonged to the Hegelian-Marxist tradition inaugurated by Lukács, centered on the "point of view of totality" as what distinguishes Marxism from bourgeois thought; Neurath's logical-empiricist, fallibilist Marxism rejected this totality claim along with the associated epistemic privilege granted to the proletariat, revealing a genuine methodological gulf between scientistic and Hegelian-dialectical Marxisms in the 1930s reception of Lukács.

  RELEVANCE: Extends the domain's key question about totality vs. positivist/economistic Marxism into the 1930s Frankfurt-School and Vienna-Circle-adjacent reception, showing how Lukács's totality-based charge against "bourgeois thought" was itself contested from a rival (Neurathian) anti-metaphysical standpoint that shared some Marxist commitments.

  POSITION: Reconstructs Lukács's "point of view of totality" as the fault line separating Hegelian-Marxist Critical Theory (Horkheimer) from logical-empiricist Marxism (Neurath), both of which post-date and respond to Lukács.
  },
  keywords = {totality, Horkheimer, Neurath, positivism, Open-Philosophy, High}
}

@article{miller2024objectivepossibility,
  author = {Miller, Tyrus},
  title = {"Objective Possibility" in Lukács's History and Class Consciousness},
  journal = {Open Philosophy},
  year = {2024},
  volume = {7},
  number = {1},
  doi = {10.1515/opphil-2024-0025},
  abstract = {Abstract This study explores the pivotal concept of "objective possibility" within Lukács's History and Class Consciousness, a concept that has received less attention compared to more prominent ideas such as reification or totality. Lukács frequently refers to "objective possibility" and related terms in essays like "What Is Orthodox Marxism?" and "Class Consciousness," emphasizing its importance in understanding class consciousness theoretically. The term's roots for Lukács derive from Max Weber's methodological writings, which drew from John Stuart Mill and Johannes von Kries and applied to historical and social causation. However, Lukács diverges from Weber's use, focusing not on counterfactual historical events but on latent historical tensions in the present that can be actualized through collective action. The study argues that Lukács integrates Weberian objective possibility with Marxist and Hegelian language, utilizing it within a modal social ontology. This approach allows Lukács to theorize key questions of class consciousness, historical action, and revolution. By drawing on Hegel's dialectics of possibility, actuality, and necessity, as well as Marxian contradictions in material conditions, Lukács reconfigures objective possibility from a heuristic tool for the writing of history to an ontologically significant element in the field of historical action.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Miller traces Lukács's category of "objective possibility" to Weber's methodological writings on historical causation (via Mill and von Kries), showing that Lukács redirects this originally counterfactual-historiographical tool toward latent tensions actualizable in the present through collective action, thereby fusing Weberian methodology with Hegelian modal categories (possibility/actuality/necessity) into a modal social ontology underwriting his theory of class consciousness and revolution.

  RELEVANCE: Illuminates a specific mechanism by which Lukács converts a Weberian (and so neo-Kantian-adjacent) methodological category into an ontologically loaded concept serving his anti-determinist theory of history, directly bearing on the domain's question of how neo-Kantian historicism is reconstructed as both target and resource.

  POSITION: Reconstructs "objective possibility" as a site where Weberian methodology is transformed, via Hegelian modal logic, into a non-deterministic, praxis-oriented social ontology -- an alternative to both bourgeois historicism and Second-International determinism.
  },
  keywords = {objective-possibility, Weber, modality, Open-Philosophy, Medium}
}

@article{rametta2024modalityactuality,
  author = {Rametta, Gaetano},
  title = {Modality and Actuality: Lukács's Criticism of Hegel in History and Class Consciousness},
  journal = {Open Philosophy},
  year = {2024},
  volume = {7},
  number = {1},
  doi = {10.1515/opphil-2024-0005},
  abstract = {Abstract The present article tries to show the originality of Lukács's theory of Actuality (Wirklichkeit) by comparing it with the same notion in Hegel's Logic. It results that Lukács's interpretation of Marxism and the Russian Revolution depends on a clear and independent theoretical position with regard to Hegel and his Idealistic theory of Modality. Particular importance is given to the new conception of the Dialectical interplay between the notions of Objective Possibility and Historical Necessity.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Rametta compares Lukács's theory of Actuality (Wirklichkeit) with Hegel's Logic to argue that Lukács develops an independent theoretical position on modality that departs from Hegel's idealist treatment, centered on a novel dialectical interplay between objective possibility and historical necessity that underwrites his interpretation of the Russian Revolution.

  RELEVANCE: Complements Miller (2024) and López (2020a) by showing precisely where and how Lukács's critical reconstruction of Hegel's categories diverges from Hegel himself, bearing on the domain's question of how the antinomies essay "reconstructs classical German philosophy" rather than simply reproducing it.

  POSITION: Reads Lukács's modal categories (actuality, objective possibility, necessity) as a genuine, non-Hegelian theoretical innovation rather than a straightforward application of Hegel's Logic.
  },
  keywords = {Hegel, modality, actuality, Open-Philosophy, Medium}
}

@article{kinzel2026reificationabstraction,
  author = {Kinzel, Katherina},
  title = {Reification, Abstraction, Idealism: Georg Lukács on the Categorial Form of Capitalism},
  journal = {Kantian Review},
  year = {2026},
  pages = {1--20},
  doi = {10.1017/s1369415425101039},
  abstract = {Abstract Georg Lukács's History and Class Consciousness (1923) has often been criticised for its idealism. I discuss Lukács's critique of reification in light of these charges, identifying two different idealist vocabularies of (neo-)Kantian and Hegelian origin, respectively. I show that the function of the former is critical: refracting Marx's analysis of social form through a Kantian form/content distinction allows Lukács to critique capitalism as the domination of form over content. Lukács's Hegelian leanings are more problematic, however, as they constrain his own insights into the conditioned and contingent character of political practice and history.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Kinzel distinguishes two idealist vocabularies operating in Lukács's critique of reification -- a (neo-)Kantian one, which she argues performs genuine critical work by refracting Marx's analysis of social form through the Kantian form/content distinction (allowing capitalism to be diagnosed as the domination of form over content), and a Hegelian one, which she argues is more problematic because it constrains Lukács's own insights into the conditioned, contingent character of political practice and history.

  RELEVANCE: Offers the most philosophically precise recent account of exactly how the form/content antinomy functions as critique (rather than mere description) in Lukács's hands, directly addressing the domain's question about the antinomies' diagnostic function, while also identifying where the Hegelian apparatus undercuts that same critical potential.

  POSITION: Neo-Kantian-genealogical reading with an internal caveat: the Kantian form/content vocabulary is critically productive, but Lukács's simultaneous Hegelian commitments limit the contingency his own analysis should permit.
  },
  keywords = {reification, neo-Kantianism, Hegel, form-content, idealism, Kantian-Review, High}
}

@article{vervoort2025neokantianism,
  author = {Vervoort, Tivadar},
  title = {"Nous Sommes Tous Néokantiens": Foucault, Lukács, and the Critique of Social Forms},
  journal = {HOPOS: The Journal of the International Society for the History of Philosophy of Science},
  year = {2025},
  volume = {15},
  number = {1},
  pages = {209--241},
  doi = {10.1086/734638},
  note = {
  CORE ARGUMENT: Vervoort places Lukács alongside Foucault as inheritors of a broadly neo-Kantian problematic concerning the historically constituted, non-natural character of social "forms" (of knowledge, of objectivity), arguing that Lukács's critique of reified social forms and Foucault's critique of historical epistemes share a common neo-Kantian ancestry in treating forms of objectivity as historically produced rather than given.

  RELEVANCE: Situates Lukács's neo-Kantian inheritance within a longer history-of-philosophy-of-science lineage, reinforcing the domain's central claim that Lukács's critique of bourgeois thought operates by historicizing categories neo-Kantianism itself had treated as quasi-transcendental.

  POSITION: Comparative neo-Kantian-genealogical reading connecting Lukács's reification critique to Foucauldian critique of social/epistemic forms via a shared neo-Kantian heritage.
  },
  keywords = {neo-Kantianism, Foucault, social-forms, Hopos, High},
  abstract = {In his introduction to Canguilhem’s Le normal et le pathologique, Michel Foucault claims that the “question of Enlightenment” has been taken up differently in the German and French philosophical traditions. Nevertheless, Foucault signals a “correspondence” between the works of Georg Lukács and the Frankfurt School, on the one hand, and the French epistemologists (including himself), on the other. In this article, I deepen this correspondence by assessing Foucault’s and Lukács’s respective relations to the neo-Kantian problem of the form and content of knowledge. In theorizing the problem of reification, Lukács mobilizes Emil Lask’s understanding of the concept “form of objectivity.” He starts from Lask’s unification of the form and content of knowledge by suggesting that the commodity form emerges as the form of objectivity that constitutes both objects and subjects of knowledge in capitalist societies. I show that Foucault’s use of the notions episteme, historical a priori, and regime of truth shares the neo-Kantian concern with of the content of knowledge. By arguing that Foucault’s critique of the philosophical anthropology underlying Marxism does not apply to Lukács’s neo-Kantianism, I make room for considering both of their philosophical strategies as a “critique of social forms.”},
  abstract_source = {openalex},
}

@article{ivanova2026reificationrespecified,
  author = {Ivanova, Mirela},
  title = {Reification re-specified: The power of commodity-mediated societalisation},
  journal = {Thesis Eleven},
  year = {2026},
  doi = {10.1177/07255136261459471},
  abstract = {Against broader readings that extend reification across different social spheres, this article argues that the concept gains analytical precision when anchored in the economic fabric of society. It understands reification as arising from capitalist societalisation mediated by the commodity form. The concept designates a double form of power: first, the impersonal and abstract power generated by commodity-mediated relations; and second, the ideological power through which this historically specific order appears natural and unchangeable, fostering economic fatalism. The article also distinguishes reification from capitalist rationalisation, showing how fragmented rational calculation both presupposes and reproduces an irrational social totality. It further highlights the non-essentialist account of subjectivity on which the theory relies and clarifies the relation between reification and capitalist alienation. In doing so, it outlines a more precise framework for historicising reification and analysing its relation to socio-economic and political phenomena in contemporary capitalism.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Against readings (including some in this domain's own literature) that extend reification loosely across all social spheres, Ivanova argues the concept gains analytical precision only when anchored specifically in commodity-mediated societalisation; reification names a double power (impersonal abstract power plus the ideological power of naturalization/"economic fatalism") that must be distinguished from capitalist rationalization, since fragmented rational calculation both presupposes and reproduces an irrational social totality.

  RELEVANCE: A 2026 restatement of the domain's core diagnostic claim -- that reification unifies economic, ideological, and epistemic critique -- while explicitly pushing back against overextension of the concept, making it a useful check on looser contemporary uses surveyed elsewhere in this domain (e.g., Bewes; Vervoort).

  POSITION: Argues for a narrower, economically anchored respecification of reification against diffuse extensions, while preserving Lukács's core claim that rationalization and reification are conceptually distinct.
  },
  keywords = {reification, rationalization, commodity-form, Thesis-Eleven, High}
}

@book{feenberg2014philosophyofpraxis,
  author = {Feenberg, Andrew},
  title = {The Philosophy of Praxis: Marx, Lukács and the Frankfurt School},
  year = {2014},
  publisher = {Verso},
  address = {London and New York},
  note = {
  CORE ARGUMENT: A thoroughly revised version of Feenberg's Lukács, Marx and the Sources of Critical Theory (1981), this book traces the "philosophy of praxis" from the early Marx's call for the "realization of philosophy" through Lukács's History and Class Consciousness to the Frankfurt School (Adorno and Horkheimer's Dialectic of Enlightenment, Marcuse's later work). Feenberg reconstructs Lukács's argument that the antinomies of bourgeois philosophy (freedom/necessity; the passive, contemplative stance required by natural science versus the active, constitutive role of human practice) are not resolved by classical German philosophy's own resources but require transcending the nature/humanity dualism through a Marxist theory of practice.

  RELEVANCE: One of the most sustained book-length reconstructions of exactly how Lukács's antinomies argument works and how it connects Kant and Hegel to the Frankfurt School's later critique of instrumental reason; provides the connective philosophical narrative linking the domain's critique-of-bourgeois-thought material to the broader philosophy-of-praxis tradition this review situates Lukács within.

  POSITION: Treats Lukács's antinomies critique and theory of reification as the pivotal, still-relevant moment in a continuous "philosophy of praxis" running from Marx through the Frankfurt School.
  },
  keywords = {philosophy-of-praxis, antinomies, Frankfurt-School, Feenberg, High},
  abstract = {This is a thoroughly revised version of Andrew Feenberg's first book,Lukács, Marx and the Sources of Critical Theory(1981).[1]In the Preface to the new version Feenberg writes that he often has looked back to the original version, based on his doctoral dissertation supervised by Herbert Marcuse, "with a mixture of pride and dismay" (viii). On the one hand, Feenberg is proud of the fact that the original volume has helped people understand the complicated arguments of Lukács'History and Class Consciousness. On the other hand, he has long recognized that there were problems with the original version, and in this new one he aims to solve these problems. As someone who has profited from the original volume in the way that justly gives Feenberg pride, I am happy to report that the new version is a very worthy successor and will be indispensable for a new generation of students and scholars as they try to make sense of the intellectual background of Frankfurt School critical theory.


The book can be divided into three parts. Feenberg devotes three chapters each to Marx's early writings and to Lukács'History and Class Consciousness(including some discussion of his recently published defense of this controversial book), and two chapters on how members of the Frankfurt School, in particular Adorno and Marcuse, have taken up and transformed their legacies. There also is a substantial conclusion and an Appendix, which condenses two chapters from the earlier version. Feenberg has thoroughly revised the book throughout. For example, there is a new discussion of the influence of the neo-Kantians on Lukács (e.g., 73-78), a more extended discussion of the Kantian and Hegelian background, and a new focus on the critique of science and technology, which became an important theme in Feenberg's work following the publication of his first book. Finally, the two chapters on the Frankfurt School are all new. I won't be able to do justice to all of this material, so will focus on what I consider to be the book's major strengths.

Students of Frankfurt School critical theory often are confronted with an approach to philosophy that is very alien to the mainstream but can be rendered intelligible, if its Marxist and Lukácsian background is brought to the fore. For example, consider the cryptic opening sentence of Adorno'sNegative Dialectics: "Philosophy, which once seemed obsolete, lives on, because the moment of its realization was missed."[2]It is with understanding sentences like these that Feenberg's book really helps. Both the obsolescence of philosophy and its possible realization are problems that arise in Marx's early writings and in Lukács'History and Class Consciousness, in the context of a philosophy of praxis that aims to overcome the antinomies identified by modern philosophy through collective social action and to realize the level of rationality that has been attained through theoretical reflection in social practices and institutions. For Marx and for Lukács (who didn't know Marx's early writings when he wroteHistory and Class Consciousnessin 1923 but developed very similar arguments), the German idealist tradition had reached an impasse in Hegel, who thought that the antinomies of modern philosophy had to be resolved by speculative thought. In contrast, Marx and Lukács believed that these antinomies ultimately could not be resolved either critically, as Kant thought, or speculatively, as Hegel thought, but only metacritically. Such a metacritique of philosophy would amount to a "sociological desublimationof the concepts of philosophy" (12). It would demonstrate that seemingly philosophical problems are rooted in social reality, and that only social change will resolve the antinomies. Feenberg's discussion of Lukács' metacritique of philosophy in Chapter Five is particularly insightful. As he explains,

For Lukács, traditional philosophy is in essence philosophy of culture that does not know itself as such. Philosophy reflects on cultural structures -- forms of objectivity -- that it misinterprets as eternal principles disconnected from the accidents of history and social life. (91)

Lukács' discussion applies this insight to a practical and a theoretical antinomy. Considered from a practical perspective, the antinomial conflict between freedom and determinism characterizes the social experience of modern subjects in their everyday lives. Forty years later Adorno would make the same point in his lectures on Kant and inNegative Dialectics.[3]Subjects face a practical antinomy, because their inner sense of agency and freedom is incompatible with the social determinism that they experience as a natural law in modern capitalist society. According to Lukács, Kant's moral philosophy reflects this antinomy, but its proposed resolution, the distinction between the phenomenal and noumenal realms, reifies moral freedom and cannot explain how the free subject can act in a world that is governed by the seemingly natural laws of economics. Considered from a theoretical perspective, the antinomial conflict is generated by two incompatible philosophical commitments that concern the nature of our knowledge of reality. On the one hand, the subject stands in a contemplative, passive relationship to the world when it seeks to control it. The world is governed by natural laws that exist independently of the empirical subject, and the subject must comprehend these laws in order to dominate nature. Thus, "the reified is the rational" (97). On the other hand, the subject stands in an active relationship to its world. As a transcendental subject it creates the world by imposing the form of reason onto it, and the intelligibility of the world to the subject is explained by this imposition. Lukács traces the philosophical attempts to reconcile these commitments from Kant to Hegel, but, ultimately, he argues that such a reconciliation requires a change of perspective that overcomes the dualism of humanity and nature, history and ontology.

Both the early Marx and Lukács attempt such a reconciliation, and Feenberg devotes Chapters Three and Six to these attempts. These are important parts of the book, because Feenberg grapples with problems in Marx's and Lukács' thought that long have perplexed commentators. The question is whether either operates with a concept of subject-object identity, which denies the ontological independence of nature. Thus Marx seems to argue that humans produce nature through their labour, and that, therefore, "under the appropriate social conditions it will be possible to recognize the essence of nature as human activity" (44). As Feenberg points out, this argument is implausible, because nature is not just raw material for human labour, and labour is not the only way in which humans engage with nature. In any case, Marx abandoned this whole line of thought in his writings immediately following theManuscripts. Lukács often has been criticized for a similar approach to nature, and Feenberg offers a detailed analysis ofHistory and Class Consciousnessthat aims to show the mistakes in these criticisms. In particular, he disposes of the "absurd" thesis that nature "is a purely social category, and the natural world therefore has no independence of humanity and human understanding" (129), by showing that Lukács actually talks about our knowledge of nature, rather than about nature itself. Moreover, Feenberg tries to show that Lukács is not committed to the implausible view that there is a specifically capitalist science that is reified and would be replaced by a communist science after the revolution. As I understand Feenberg's argument, science and technology always progress through a dialectic of reification and de-reification. To be sure, under capitalism the reifying aspects of science and technology, which undermine our lived experience of nature, are foregrounded due to capitalism's "formal bias" (145; cf. 166) in favour of an abstract and disembodied approach to nature that focuses on its domination and exploitation. But it is a mistake to believe that a "communist science" would not be reifying. The reification of nature in science differs from the reification of society.

This is an original way of solving a problem that has been discussed in the literature on Lukács and the Frankfurt School.[4]However, it also raises new questions, to which Feenberg could have devoted more space. For example, one may ask how exactly reification comes about and what its relationship is to market exchange in capitalist societies, given that reification and de-reification now seem to be necessary moments of social practice. I think that the concept of formal bias could potentially be extremely fruitful in answering these questions, but it remains underdeveloped in this book.

In Chapters Seven and Eight Feenberg turns to the Frankfurt School, which inherits the legacy of the philosophy of praxis from Marx and Lukács but differs from them on two very important points. First, Adorno and Marcuse place central importance on the domination of nature as a source of social pathologies that affect modern subjects. Second, they formulate their critical theories of society at a time when the "unity of theory and practice" has broken down, that is, when it has become clear that the proletariat in Western Europe is not on the verge of staging a revolution to overthrow capitalism. Of course, Adorno's and Marcuse's theories are very different. Feenberg characterizes this difference in terms of the concepts that they inherit from Marx and Lukács. Whereas Adorno takes the theory of commodity fetishism as his starting point, Marcuse's emphasizes the experience of alienation (158, 175). Feenberg's discussion of Adorno suggests that he considers him an outlier in the philosophy of praxis. His negativistic philosophy eschews the appeal to concepts such as emancipation, progress or revolution. Instead, Adorno uses the concept of reification in order to explain why no such appeal is possible. His criticism of identity thinking demonstrates the reification of reason in capitalist society, but it abstains from formulating a positive alternative. As Feenberg puts it, negative dialectics "does not resolve the antinomies but rather identifies them as such and suspends all premature resolutions. It is the logic of immanent critique and not a constructive alternative" (155).},
  abstract_source = {ndpr},
}

@book{kavoulakos2018philosophyofpraxis,
  author = {Kavoulakos, Konstantinos},
  title = {Georg Lukács's Philosophy of Praxis: From Neo-Kantianism to Marxism},
  year = {2018},
  publisher = {Bloomsbury Academic},
  address = {London and New York},
  note = {
  CORE ARGUMENT: Kavoulakos offers a major reconstruction of Lukács's early-Marxist philosophy in History and Class Consciousness that foregrounds neo-Kantian (rather than primarily Hegelian) influences, organized in three parts -- Method, Theory, and Praxis -- covering Lukács's theories of rationality, modern society, and social change and arguing against readings that treat Lukács simply as a "Hegelian Marxist."

  RELEVANCE: The book-length elaboration of the neo-Kantian-genealogical reading of reification summarized in Kavoulakos's companion article (Kavoulakos 2019); indispensable for the domain's central claim that the antinomies critique and reification diagnosis both depend on specifically neo-Kantian conceptual resources (the "form of objectivity," rationalization) rather than a straightforward Hegelian dialectic.

