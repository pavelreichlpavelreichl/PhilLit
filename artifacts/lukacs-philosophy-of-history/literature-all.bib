  },
  keywords = {reification, recognition, Honneth, Adorno, High, INCOMPLETE, no-abstract},
}

@incollection{kavoulakos2018reifyingreification,
  author = {Kavoulakos, Konstantinos},
  title = {Reifying Reification: A Critique of Axel Honneth's Theory of Reification},
  booktitle = {Political Philosophy and Public Purpose},
  year = {2018},
