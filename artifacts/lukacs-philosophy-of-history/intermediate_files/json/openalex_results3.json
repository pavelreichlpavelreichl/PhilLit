    {
      "openalex_id": "W2767439789",
      "doi": null,
      "title": "The Production of Post-Revolutionary Tehran: A study of transformation of contemporary Tehran through a Lefebvrian perspective",
      "authors": [
        {
          "name": "Seyed Hossain Sadrvaghefi",
          "openalex_id": "A5010941051"
