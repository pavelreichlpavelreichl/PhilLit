      "paperId": "79addadb41fbe28ebe6cccf2445c6279e8639e51",
      "title": "\u201cTHE PROBLEM OF PERSPECTIVE\u201d (1956)",
      "authors": [
        {
          "name": "Georg Luk\u00e1cs",
          "authorId": "2386729730"
