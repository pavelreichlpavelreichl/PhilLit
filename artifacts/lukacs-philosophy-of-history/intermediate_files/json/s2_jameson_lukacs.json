      "paperId": "8f969bc70be9f925d876cc2f3601d0e98e66d182",
      "title": "Fredric Jameson and Cultural Studies",
      "authors": [
        {
          "name": "Jr. Robert T. Tally",
          "authorId": "2226187579"
