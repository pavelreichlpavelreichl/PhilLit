      "paperId": "9e0c144473a6f009bf7e7a4c9be6299068b7cddb",
      "title": "Reading Hegel after Marx: Luk\u00e1cs and the Question of Teleology",
      "authors": [
        {
          "name": "Filippo Menozzi",
          "authorId": "117885213"
        }
