    {
      "openalex_id": "W4401596325",
      "doi": "10.1515/opphil-2024-0027",
      "title": "Critique of Reification of Art and Creativity in the Digital Age: A Luk\u00e1csian Approach to AI and NFT Art",
      "authors": [
        {
          "name": "Zoran Poposki",
          "openalex_id": "A5035431115",
