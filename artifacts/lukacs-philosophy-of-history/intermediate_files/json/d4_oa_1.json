    {
      "openalex_id": "W2136607461",
      "doi": "10.1590/1679-395115865",
      "title": "Where did Braverman go wrong? A Marxist response to the politicist critiques",
      "authors": [
        {
          "name": "Eduardo Sartelli",
          "openalex_id": "A5017821636",
          "orcid": "https://orcid.org/0000-0003-2147-3424",
          "institutions": [
            "Universidad de Buenos Aires"
          ]
        },
        {
          "name": "Marina Kabat",
          "openalex_id": "A5063079351",
          "orcid": "https://orcid.org/0000-0001-7662-4643",
          "institutions": [
