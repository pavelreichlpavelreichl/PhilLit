      "openalex_id": "W2752932194",
      "doi": "10.2458/v24i1.20802",
      "title": "What's ontology got to do with it? On nature and knowledge in a political ecology of the 'green economy'",
      "authors": [
        {
          "name": "Sian Sullivan",
          "openalex_id": "A5074094415",
          "orcid": "https://orcid.org/0000-0002-0522-8843",
