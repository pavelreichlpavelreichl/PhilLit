      "openalex_id": "W2339765316",
      "doi": null,
      "title": "Allegories of drought and of gardens in the novels of J.M. Coetzee and Dambudzo Marechera",
      "authors": [
        {
          "name": "Charles Grant Lilford",
          "openalex_id": "A5030917976"
