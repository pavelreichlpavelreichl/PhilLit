    {
      "openalex_id": "W2317358254",
      "doi": "10.1080/14735784.2010.515400",
      "title": "In the Blink of an Eye: The Augenblick of Sudden Change and Transformative Learning in Luk\u00e1cs and Benjamin",
      "authors": [
        {
          "name": "Matthew Carlin",
          "openalex_id": "A5046090593",
