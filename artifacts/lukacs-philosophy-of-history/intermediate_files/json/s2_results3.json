      "paperId": "fb2338fe958f67c236589682cb65fc24ea9df3ad",
      "title": "Socio-Historical Reading of Harold Pinter's The Room from Georg Luk\u00e1cs\u2019 Perspective",
      "authors": [
        {
          "name": "A. Masoudi",
          "authorId": "2075803764"
        },
