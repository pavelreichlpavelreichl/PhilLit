      "openalex_id": "W2581380313",
      "doi": null,
      "title": "Class for itself? : Shack/slum Dwellers International : the praxis of a transnational poor movement",
      "authors": [
        {
          "name": "LN Podlashuc",
          "openalex_id": "A5017860984"
