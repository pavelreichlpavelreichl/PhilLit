    {
      "openalex_id": "W4414947430",
      "doi": "10.1353/tae.2025.a971355",
      "title": "From a Contemplative to a Critical Attitude: Luk\u00e1cs, Foucault, and the Partisanship of Critical Theory",
      "authors": [
        {
          "name": "Tivadar Vervoort",
          "openalex_id": "A5080452644",
