      "paperId": "3b574cc788d8f465231fe815ae4da99b74c2c043",
      "title": "Go Home, Occupy Movement!! (The McFB \u2013 Was Ist Das?)",
      "authors": [
        {
          "name": "A. Bajrektarevic",
          "authorId": "96019826"
        }
