      "openalex_id": "W4400030181",
      "doi": "10.1515/opphil-2024-0019",
      "title": "The Marxist Method as the Foundation of Social Criticism \u2013 Luk\u00e1cs\u2019 Perspective",
      "authors": [
        {
          "name": "Mateus Soares de Souza",
          "openalex_id": "A5102694992",
