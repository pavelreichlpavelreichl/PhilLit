      "paperId": "509cc23a74636e4e48b24ab58f50c7652d5e2916",
      "title": "Quantifying cortical development in typically developing toddlers and young children, 1\u20136 years of age",
      "authors": [
        {
          "name": "J. Remer",
          "authorId": "2787388"
        },
