    {
      "paperId": "dcbee4f8e0574c47955d3a0b2a6234f5f6d156ab",
      "title": "AS REFORMAS EDUCACIONAIS E A \u201cNOVA MORFOLOGIA\u201d PARA O TRABALHO: DESTACANDO A \u00c1REA DAS CI\u00caNCIAS HUMANAS E SOCIAIS APLICADAS",
      "authors": [
