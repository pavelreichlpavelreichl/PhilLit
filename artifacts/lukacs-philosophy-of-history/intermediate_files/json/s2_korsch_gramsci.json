    {
      "paperId": "73dc4b14e7e18a11fa690db81c4673b661c732cf",
      "title": "Luk\u00e1cs: Philosoph eines Jahrhunderts",
      "authors": [
        {
          "name": "Wolfgang Mu\u0308ller-Funk",
