      "openalex_id": "W1988010437",
      "doi": "10.1111/j.1467-8330.2012.00981.x",
      "title": "<i>The Gramscian Moment: Philosophy, Hegemony and Marxism</i> by Peter D. Thomas",
      "authors": [
        {
          "name": "Michael Ekers",
          "openalex_id": "A5072574408",
          "orcid": "https://orcid.org/0000-0003-2859-873X",
          "institutions": [
            "University of Toronto",
