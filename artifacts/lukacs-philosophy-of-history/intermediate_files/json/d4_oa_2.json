      "title": "Philosophy of New Jazz: Reconstructing Adorno",
      "authors": [
        {
          "name": "Dustin Garlitz",
          "openalex_id": "A5056247887",
          "orcid": "https://orcid.org/0000-0002-9409-5121",
          "institutions": [
