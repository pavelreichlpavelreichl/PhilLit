    {
      "paperId": "75ba6bfab452291fe4a962018dbf7255a78c9d51",
      "title": "Luk\u00e1cs in the 1920s and the 2020s: The practice and praxis of intellectual history",
      "authors": [
        {
          "name": "R. Westerman",
          "authorId": "144550804"
