    {
      "openalex_id": "W1849671009",
      "doi": "10.18745/th.16331",
      "title": "Contrasting Debates and Perspectives from Second and Third Wave Feminists in Britain: Class, Work and Activism",
      "authors": [
        {
          "name": "Lindsey German",
          "openalex_id": "A5108495619"
