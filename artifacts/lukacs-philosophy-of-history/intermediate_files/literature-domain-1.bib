@article{maccio1972latelukacs,
  author = {Macciò, Marco},
  title = {On the Late Lukács},
  journal = {Telos},
  year = {1972},
  volume = {1972},
  number = {11},
  pages = {135--141},
  doi = {10.3817/0372011135},
  note = {
  CORE ARGUMENT: Writing shortly after Lukács's death, Macciò addresses the reception and evaluation of "the late Lukács" -- the post-War aesthetic and ontological writings -- against the backdrop of the already-canonical young/early-Marxist Lukács of History and Class Consciousness, contributing to the early Telos-circle debate about how much authority to grant Lukács's own late self-understanding.

  RELEVANCE: Represents an early instance (1972) of the "young vs. late Lukács" framing device explicitly named in the domain's search strategy, showing that the periodization question was already a live category for Anglophone New Left readers immediately after Lukács's death, prior to the archivally grounded biographies of the late 1970s-80s.

  POSITION: Early statement of the young/late Lukács framing within the Telos-journal reception of Lukács in the Anglophone New Left.
  },
  keywords = {periodization, late-Lukacs, Telos, Low},
  abstract = {Abstract The recent translation of History and Class Consciousness with a new "Preface" written in 1967, and the publication of Gespräche mit Lukács now allow an all-embracing critical study of Lukács' theoretical and political thought. As is well known, after having rejected his own conceptions of the dialectic as contained in History and Class Consciousness, Lukács had never given a new all-inclusive reformulation. In the Gespräche mit Lukács, the Hungarian philosopher places as the basis of his philosophy the Marxian principle according to which there is only one science of history which goes from astronomy to sociology. Reality is a process, a development and a dialectic in each of its three fundamental forms (inorganic, organic, and social), in the connection of these forms, and in each of the many partial wholes.},
  abstract_source = {openalex},
}
