  publisher = {Palgrave Macmillan US},
  address = {New York},
  doi = {10.1057/9781137471161},
  abstract = {Since the 1920s, scholars have promoted a set of manuscripts, long abandoned by Marx and Engels, to canonical status in book form as The German Ideology, and in particular its 'first chapter,' known as the 'Feuerbach chapter.' This book is a detailed account of the editorial and political history behind successive editions.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Carver and Blank trace the editorial history of the German
  Ideology manuscripts from their first reconstruction in the early Soviet
  period through successive editions, arguing that what is received as a
  canonical jointly-authored text is in fact an editorial construction that
  imposed a coherence the manuscripts lack. Different political contexts
  shaped which manuscripts were selected, combined, and presented as
  authoritative statements of historical materialism.

  RELEVANCE: The editorial history of German Ideology is central to evaluating
  Engels's role in shaping Marx's legacy and the joint-authorship debate.
  This book provides the most detailed primary-source treatment of how
  "Marx and Engels" as a textual unity was manufactured, directly relevant
  to assessing Engels's contribution to historical materialism.

  POSITION: Textual-editorial approach that sidesteps the divergence/fidelity
  framing in favor of historicizing the manuscripts themselves.
  },
  keywords = {German-ideology, editorial-history, MEGA, Carver, Blank, High}
}

@article{carver2010germanideology,
