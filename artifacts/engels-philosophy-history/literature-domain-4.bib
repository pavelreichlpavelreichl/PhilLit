@article{blackledge2017practical,
  author = {Blackledge, Paul},
  title = {Practical Materialism: {E}ngels's {Anti-D\"{u}hring} as {M}arxist Philosophy},
  journal = {Critique},
  year = {2017},
  volume = {45},
  number = {4},
  pages = {483--499},
  doi = {10.1080/03017605.2017.1377927},
  abstract = {Frederick Engels's Anti-D\"{u}hring was the most important theoretical response to the emerging reformist tendencies within European socialism in the 19th century. It also proved to be Engels's most influential, and controversial work. Because it is, as Hal Draper points out, 'the only more or less systematic presentation of Marxism' by either by Marx or Engels, anyone wanting to reinterpret Marx must first detach it from his seal of approval. It is thus around Anti-D\"{u}hring and related texts that debates about the relationship of Marx to 'Engelsian' Marxism have tended to focus. This essay re-engages with debates about Engels's mature work with a view to unpicking his contribution to Marxism from caricatured criticisms of his thought.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Blackledge argues that Anti-Duhring -- as the only systematic
  presentation of Marxism by either Marx or Engels -- is central to any
  reassessment of the Marx-Engels relationship. He re-engages with anti-Engelsian
  criticisms of Engels's mature work and argues these criticisms rely on
  caricatures: Engels's dialectical materialism is coherent as Marxist
  philosophy, not a positivist distortion.

  RELEVANCE: As the clearest recent philosophical defense of Engels's Anti-Duhring
  against anti-Engelsian critics, this article is directly relevant to the
  review's treatment of Engels's systematic philosophy and his relationship
  with Marx. Blackledge explicitly frames his intervention as a response to
  the divergence thesis.

  POSITION: Revisionist defense of Engels, arguing for continuity between
  Marx and Engels on fundamental philosophical commitments.
  },
  keywords = {Anti-Duhring, Blackledge, revisionist-defense, dialectical-materialism, High}
}

@article{blackledge2020engelsvmarx,
  author = {Blackledge, Paul},
  title = {Engels vs. {M}arx?: {T}wo Hundred Years of {F}rederick {E}ngels},
  journal = {Monthly Review},
  year = {2020},
  pages = {21--39},
  doi = {10.14452/mr-072-01-2020-05_3},
  abstract = {At the bicentenary of his birth, Frederick Engels's reputation as an original thinker is, among Anglophone academics at least, at its nadir. Despite the recent global economic crisis and associated increases in inequality that have tended to confirm Karl Marx and Engels's general critique of capitalism, Marxism is an optimistic doctrine that has not fared well in a context dominated by working-class retreat and demoralization. But if this context has been unpropitious for Marxism generally, criticisms of Engels's thought have a second, quite separate, source. Over the course of the twentieth century, a growing number of commentators have claimed that Engels fundamentally distorted Marx's thought, and that "Marxism" and especially Stalinism emerged out of this one-sided caricature of Marx's ideas.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Written for the bicentenary of Engels's birth, Blackledge
  surveys the history of anti-Engelsian criticism from the twentieth century
  onward, arguing that claims that Engels distorted Marx emerged from a
  specific ideological context (critiquing Stalinism by detaching it from
  "authentic" Marx) and that they rely on a selective and philosophically
  tendentious reading of the corpus. He defends Engels as an original thinker
  whose reputation is at an unwarranted nadir among Anglophone academics.

  RELEVANCE: Provides a broad historical survey of the Marx-Engels problem
  that is directly useful for the synthesis section on the debate's
  intellectual history. Blackledge's diagnosis of the Cold War origins of
  anti-Engelsian criticism is a key interpretive framework for the domain.

  POSITION: Revisionist defense that situates the divergence thesis in its
  intellectual-historical context and finds it ideologically motivated.
  },
  keywords = {Blackledge, bicentenary, anti-Engelsian, revisionist, intellectual-history, High}
}

@article{carver2017makingmarx,
  author = {Carver, Terrell},
  title = {Making {M}arx {M}arx},
  journal = {Journal of Classical Sociology},
  year = {2017},
  volume = {17},
  number = {1},
  pages = {10--27},
  doi = {10.1177/1468795X17691388},
  abstract = {The context through which readers have come to know Marx as 'Marx' was not discovered. It was constructed by Marx in the first instance, and by others during his lifetime and afterwards. What he told us about himself at different stages of his life has been assimilated in various ways to reinforce what more-or-less authorised biographers think we should know about his 'life and thought'. These accounts are based on what bibliographers present as his 'collected works', graded by significance. Intellectual biographies are couched in a genre that is neither the contingent everyday (since readers are presented with a life story that has ended) nor the publicity-minded autobiographical (as Marx's self-characterisations certainly were). After his death in 1883, Engels' republication of Marx's works with new introductions and prefaces, along with Engels' own works, promoted Engels' projects and ideas as following directly from, and intentionally supplementary to, Marx's 'thought'. Editorial practices worked to mystify the 'everyday Marx' and to erase vital and productive ways to think about politics, activism and struggle.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Carver argues that "Marx" as an intellectual identity was
  significantly constructed through editorial and interpretive practices --
  particularly Engels's posthumous editing of Marx's manuscripts, his
  prefaces to new editions, and his own summarizing texts. The "Marx" that
  scholarship typically engages was shaped by decisions that collapsed
  what were actually distinct intellectual trajectories.

  RELEVANCE: This article provides the conceptual underpinning for Carver's
  broader anti-Engelsian argument: it is not just that Engels diverged from
  Marx, but that the very category "Marx" (and hence "Marxism") was Engels's
  construction. For the review's treatment of Engels's role in shaping the
  materialist conception of history, Carver's argument about posthumous
  construction is directly relevant.

  POSITION: Extends anti-Engelsian critique into the sociology of knowledge,
  treating "Marx" as partly an Engelisian creation.
  },
  keywords = {Carver, intellectual-identity, editorial-construction, Marxism, Medium}
}

@article{carver2020engelstoday,
  author = {Carver, Terrell},
  title = {Engels Today: An Introduction},
  journal = {International Critical Thought},
  year = {2020},
  volume = {10},
  number = {3},
  pages = {323--330},
  doi = {10.1080/21598282.2020.1834685},
  abstract = {Engels today is a very large archive of texts, which generate many significant puzzles. However, most factual accounts of his life, his partnership with Marx, and his political activities are actually answers to questions that are very seldom posed directly. This article poses searching questions about the Marx-centric formation of the Engels archive, the meaning of senior/junior roles in the partnership, the nature of Marxism in relation to Marx and Engels as independent thinkers, and the commonplace presumptions of consistency and certainty characteristic of historical commentary. It reviews the five articles in this collection in order to suggest a novel "Engels-centric" approach to intellectual biography and scholarly evaluation.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Carver provides a bicentenary reassessment of Engels's
  contemporary relevance, surveying the interpretive landscape and arguing
  that treating Engels as merely "junior partner" to Marx or as "second
  fiddle" obscures his independent theoretical contributions while also
  missing the ways his posthumous presentations shaped "Marxism" as a
  tradition. Carver calls for reading Engels on his own terms.

  RELEVANCE: As a recent (2020) synthetic overview from the leading
  anti-Engelsian scholar, this article frames the state of the field
  and identifies open questions for Engels scholarship. Useful for the
  synthesis section that must situate the research project in ongoing debates.

  POSITION: Revisits anti-Engelsian themes but with more nuanced attention
  to Engels's independent intellectual contributions.
  },
  keywords = {Carver, bicentenary, Engels-scholarship, intellectual-biography, Medium}
}

@article{jimenezcontreras2021humanism,
  author = {Jim\'{e}nez Contreras, Baruc},
  title = {Engels, Humanism and Revolutionary Praxis: {T}he Centrality of the Dynamic Analysis of Historical Materialism and Its Inherent Relation to Overcoming Capitalist Alienation},
  journal = {Human Geography},
  year = {2021},
  volume = {14},
  number = {2},
  pages = {173--185},
  doi = {10.1177/19427786211010138},
  abstract = {At the end of the 19th century, a debate emerged among academics of historical materialism on the apparent divergence between Engels' and Marx's theoretical developments. During the 20th century, those who wanted to argue that there was a dichotomy between the two authors identified Engels as responsible for historical materialism's crises. This paper aims to demonstrate that Engels, far from distancing himself from Marx's central positions, contributed to the formation of historical materialism as a revolutionary praxis that seeks a more rational regulation of the human metabolism with nature through overcoming the alienating conditions of the capitalist system. For this reason, the paper analyses Ludwig Feuerbach and the End of Classical German Philosophy, one of Engels' most controversial texts, and exposes the correlation with the historical development of the revolutionary praxis in the Engels' and Marx's work.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Jimenez Contreras argues that Engels, far from distancing
  himself from Marx's central positions, contributed to the formation of
  historical materialism as revolutionary praxis. Analyzing Ludwig Feuerbach,
  he argues Engels demonstrates the demystification of Hegelian dialectics,
  resulting in a dynamic epistemic model oriented toward transforming social
  reality. The paper draws on Sanchez Vazquez's philosophy of praxis to
  reframe Engels as a humanist thinker continuous with Marx.

  RELEVANCE: Provides a recent (2021) systematic defense of Engels's
  historical materialism that directly engages anti-Engelsian criticisms
  and offers an alternative reading of Ludwig Feuerbach -- a text central
  to the review's domain on Engels's philosophy of history.

  POSITION: Revisionist defense from a humanist Marxist perspective,
  countering the thesis that Engels's Ludwig Feuerbach introduced a
  positivist distortion.
  },
  keywords = {Ludwig-Feuerbach, historical-materialism, revolutionary-praxis, revisionist, Medium}
}

@article{koryakovtsev2024privatestate,
  author = {Koryakovtsev, A. A.},
  title = {{F}. {E}ngels and {K}. {M}arx on the Origin of Private Property and the State: {O}ne Concept or Two?},
  journal = {Discourse},
  year = {2024},
  volume = {10},
  number = {1},
  pages = {15--31},
  doi = {10.32603/2412-8562-2024-10-1-15-31},
  abstract = {Introduction. The problem of incomplete coincidence of views of K. Marx and F. Engels has long been raised in marxology. We will discuss the views of classics on the origin of private property and the state. F. Engels explains the appearance of the state by class contradictions. In a paragraph entitled 'Forms Preceding Capitalist Production' in the 'Economic Manuscripts of 1857-1861', K. Marx describes how the state emerged as an organizer of forced community works. This coercion was determined not by socio-political factors but by natural factors. Conclusion. In classical Marxism there is no unified concept of the origin of the state and private property; the concepts of K. Marx and F. Engels differ from each other in the interpretation of the role of labor in this process.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Through textual analysis of Engels's Origin of the Family
  and Marx's Grundrisse manuscripts and 1844 Manuscripts, Koryakovtsev
  argues there is no unified concept of the origin of the state and private
  property in classical Marxism. Engels attributes a passive role to labor in
  explaining the state's emergence via class contradictions, while Marx's
  view is that labor actively creates its own opposite (private property and
  the state) -- a substantive philosophical divergence.

  RELEVANCE: Provides recent empirical evidence for the divergence thesis
  in a specific domain (theory of the state and private property),
  complementing Levine's broader Hegelian-philosophical argument. The
  specific comparison of Origin of the Family with Marx's manuscripts is
  directly relevant to the review's treatment of Engels's philosophy of
  history.

  POSITION: Contributes to anti-Engelsian divergence thesis with a focused
  textual comparison on a specific topic.
  },
  keywords = {origin-of-state, private-property, divergence, Engels-Marx-comparison, Medium}
}

