@comment{
====================================================================
DOMAIN: Engels' Philosophical Corpus and Its Interpretation
SEARCH_DATE: 2026-06-11
PAPERS_FOUND: 14 total (High: 8, Medium: 5, Low: 1)
SEARCH_SOURCES: SEP (no dedicated entry), IEP (no dedicated entry), PhilPapers, Semantic Scholar, OpenAlex, CORE
====================================================================

DOMAIN_OVERVIEW:
Engels' mature philosophical writings -- Anti-Duhring (1878), Dialectics of
Nature (written 1873-83, published 1925), Ludwig Feuerbach and the End of
Classical German Philosophy (1886), and Socialism: Utopian and Scientific
(1880) -- constitute the primary textual basis for all debates about his
contribution to Marxism. Anti-Duhring is the only approximately systematic
statement of Marxist philosophy by either Marx or Engels; its three parts
(philosophy, political economy, socialism) set out a materialist dialectics
applied to nature and history. Dialectics of Nature, an unfinished
posthumously edited manuscript, extends this to natural science and attempts
to derive universal dialectical laws (transformation of quantity into quality;
interpenetration of opposites; negation of the negation). Ludwig Feuerbach
traces the movement from Hegel through Feuerbach to historical materialism and
articulates Engels' realist epistemology. The late correspondence (letters to
Bloch, Schmidt, Mehring, Starkenburg, 1890-94) crucially qualifies the
"economic determinist" reading by insisting on the relative autonomy of the
superstructure and the role of political, legal, and ideological factors.

Scholarly interpretation divides broadly into three camps. A "contamination"
tradition (Carver, Levine, Schmidt) argues Engels distorted Marx by extending
dialectics to nature, constructing a closed system Marx never endorsed, and
providing Marxism-Leninism its philosophical template. A rehabilitationist
tradition (Blackledge, Foster, Boer) reads Anti-Duhring as a coherent
practical-materialist philosophy and Dialectics of Nature as a serious
scientific engagement. A hermeneutical-historical tradition (Kangal) uses
editorial and archival analysis to show the text is more fragmentary and
open-ended than either camp admits. Rigby offers a measured survey that
evaluates the logical coherence and empirical adequacy of Engels' claims.

RELEVANCE_TO_PROJECT:
This domain establishes what Engels actually argued -- the indispensable
textual basis before any question of departure from or development beyond
Marx can be adjudicated. The primary texts (especially Anti-Duhring and
the late letters) and their secondary interpretation directly set the terms
for every subsequent domain in the review.

NOTABLE_GAPS:
No dedicated SEP or IEP article on Engels exists; coverage in those
encyclopedias is absorbed into entries on Marx, Historical Materialism, and
Dialectical Materialism. The editorial and manuscript history of Dialectics
of Nature (MEGA2 volumes) is underrepresented in English-language secondary
literature; much specialist work is in German. Primary texts (Anti-Duhring,
Ludwig Feuerbach) are marked INCOMPLETE as academic abstract databases do
not index 19th-century philosophical monographs; their content is
well-documented in the secondary literature included here.

SYNTHESIS_GUIDANCE:
The debate between the contamination and rehabilitation readings should be
foregrounded; nearly every other debate in the literature (Engels vs. Marx,
dialectics of nature, economic determinism) flows from this fault-line.
The late letters should be treated as primary sources alongside the major
works, not merely as qualifications to them.

KEY_POSITIONS:
- Contamination/disjunction thesis: 3 entries -- Engels distorted Marx by naturalizing dialectics
- Rehabilitation/continuity thesis: 4 papers -- Engels' philosophy is coherent and continuous with Marx
- Hermeneutical/archival approach: 2 papers -- the textual situation is more complex than either camp admits
- Survey/evaluation: 2 papers -- balanced assessment of Engels' claims and their logical status
====================================================================
}

@book{engels1878antiduhring,
  author = {Engels, Friedrich},
  title = {Herr Eugen {D\"uhring's} Revolution in Science ({Anti-D\"uhring})},
  year = {1878},
  publisher = {International Publishers},
  note = {
  CORE ARGUMENT: Anti-Duhring is Engels' most comprehensive philosophical work, a polemical treatise in three parts -- philosophy, political economy, and socialism -- which argues that Marxism constitutes a unified scientific world-view. The philosophical section introduces the "dialectics of nature," the three laws of dialectics (transformation of quantity into quality; negation of the negation; interpenetration of opposites), and a materialist epistemology. The political-economy section defends Marx's Capital; the socialism section, published separately as Socialism: Utopian and Scientific, traces the development from utopian to scientific socialism.

  RELEVANCE: As "the only more or less systematic presentation of Marxism" by either Marx or Engels (Hal Draper's formulation), Anti-Duhring is the indispensable primary text for all debates about what Engels believed, how it relates to Marx, and whether the Marxist philosophical synthesis is coherent. Marx read and approved portions of the manuscript, making questions of joint authorship central.

  POSITION: Primary text; the fountainhead of both the "Engelsian Marxism" tradition and of critiques that see it as a distortion of Marx.
  },
  keywords = {primary-text, dialectics-of-nature, Anti-Duhring, High, INCOMPLETE, no-abstract}
}

@book{engels1925dialecticsnature,
  author = {Engels, Friedrich},
  title = {Dialectics of Nature},
  year = {1925},
  publisher = {Progress Publishers},
  address = {Moscow},
  note = {
  CORE ARGUMENT: A posthumously assembled collection of manuscripts, notes, and fragments written 1873-1883 but never completed, in which Engels attempts to demonstrate that the laws of dialectics -- primarily the transformation of quantity into quality and the law of contradiction -- operate in natural processes as studied by physics, chemistry, and biology. Engels argues that the history of science shows dialectical transitions at key points (e.g., the transition from mechanical to thermodynamic explanation) and that Darwin's evolutionary theory is implicitly dialectical.

  RELEVANCE: The unfinished, posthumously edited nature of Dialectics of Nature is central to debates about whether it represents a philosophical program Engels endorsed or merely exploratory notes; its status as a text is itself a research question. It is the main evidence for the "contamination" claim that Engels extended Marxist dialectics to nature in ways Marx never authorized.

  POSITION: Primary text; the most contested and fragmented of Engels' major philosophical works.
  },
  keywords = {primary-text, dialectics-of-nature, posthumous, High, INCOMPLETE, no-abstract}
}

@book{engels1886feuerbach,
  author = {Engels, Friedrich},
  title = {Ludwig Feuerbach and the End of Classical German Philosophy},
  year = {1886},
  publisher = {Foreign Languages Publishing House},
  address = {Moscow},
  note = {
  CORE ARGUMENT: Engels surveys the movement from Hegel through the dissolution of Hegelianism to Feuerbach's materialism and then to the materialist conception of history developed by Marx and himself. He articulates a realist epistemological position (the "reflection theory") according to which thought reflects material reality, and defends the unity of theory and practice. The text also contains his well-known account of the "basic question of all philosophy" (the relation of thought to being) which became canonical in Soviet dialectical materialism.

  RELEVANCE: This text provides the clearest statement of Engels' epistemology and his reading of the Hegel-Marx relationship, making it central to debates about how accurately he understood his own intellectual heritage and whether his realist epistemology is compatible with Marx's more practice-oriented approach.

  POSITION: Primary text; key source for Engels' epistemology and his account of the transition from Hegel to Marx.
  },
  keywords = {primary-text, epistemology, Hegel, Feuerbach, High, INCOMPLETE, no-abstract}
}

@article{carver1980dialektik,
  author = {Carver, Terrell},
  title = {Marx, Engels and Dialectics},
  journal = {Political Studies},
  year = {1980},
  volume = {28},
  number = {3},
  pages = {353--363},
  doi = {10.1111/j.1467-9248.1980.tb00474.x},
  abstract = {Two familiar 'facts' about Marx, Engels and their views are in reality fictions. The first is that Marx and Engels speak with the same voice on all important theoretical issues; that their works supplement each other; and that they had a perfect intellectual partnership. The second fiction is that as Marx grew older, he embraced the positivism and determinism fashionable at the time. The strongest evidence for the second fiction is the claim that Marx approved of Engels's Anti-Duhring of 1877-8 and agreed in principle with other works by Engels, such as the Dialectics of Nature. I attack the second fiction in detail, and then use my conclusions to attack the first. This exposes a divergence between the views of Marx and Engels on classic problems in social science.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Carver argues that there is a significant divergence between Marx's use of "dialectics" as a critical method for analyzing historical and social relations and Engels' claim to have derived dialectical laws from nature. Marx never endorsed a "dialectics of nature" or the three universal laws Engels formulates in Anti-Duhring and Dialectics of Nature; the project of extending dialectics to the natural sciences is Engels' independent contribution, and it involves a category mistake that reduces dialectics from a critical social method to a naturalistic metaphysics.

  RELEVANCE: This early article establishes the key terms of the "disjunction" debate and directly bears on whether Engels' nature-philosophy departs from Marx's philosophical framework. It is a founding text of the revisionist tradition that reads "Marx and Engels" as two distinct thinkers.

  POSITION: Disjunction/contamination thesis; argues Engels' dialectics of nature is philosophically incompatible with Marx's method.
  },
  keywords = {Carver, disjunction-thesis, dialectics-of-nature, Marx-Engels-debate, High}
}

@article{carver1984scholarship,
  author = {Carver, Terrell},
  title = {Marx, Engels and Scholarship},
  journal = {Political Studies},
  year = {1984},
  volume = {32},
  number = {2},
  pages = {249--256},
  doi = {10.1111/j.1467-9248.1984.tb00177.x},
  note = {
  CORE ARGUMENT: Carver surveys the state of Marx-Engels scholarship and argues that the editorial and textual conflation of Marx and Engels into a single voice ("MarxEngels") has systematically distorted interpretation of both thinkers. He calls for a methodological separation of their texts and argues that Engels' editorial decisions -- particularly in assembling and presenting Marx's manuscripts -- shaped how both thinkers came to be read.

  RELEVANCE: This methodological paper underpins the textual-historical approach to the Engels corpus and argues that treating "Marxism" as a joint project produces systematic interpretive errors relevant to assessing Engels' philosophy of history.

  POSITION: Methodological argument for treating Marx and Engels as distinct intellectual figures; supports the disjunction thesis.
  },
  keywords = {Carver, methodology, textual-criticism, Marx-Engels-debate, Medium, INCOMPLETE, no-abstract}
}

@book{levine1975tragicdeception,
  author = {Levine, Norman},
  title = {The Tragic Deception: {Marx} Contra {Engels}},
  year = {1975},
  publisher = {ABC-Clio},
  address = {Oxford},
  note = {
  CORE ARGUMENT: Levine argues that Engels fundamentally betrayed Marx's philosophical intentions by constructing a positivistic, naturalistic dialectical materialism that reduced Marxism to a mechanistic science of laws. He contends that Marx's method was rooted in Hegel's dialectic of self-consciousness and historical praxis, while Engels substituted a naturalistic ontology derived from empirical science. This "tragic deception" shaped the entire subsequent history of Marxism-Leninism.

  RELEVANCE: Levine's book is one of the most uncompromising statements of the thesis that Engels' philosophy constitutes a betrayal rather than a development of Marx. It directly bears on the question of what Engels actually argued in Anti-Duhring and Dialectics of Nature by measuring it against an alternative reading of Marx.

  POSITION: Strong disjunction/contamination thesis; positions Engels as philosophically responsible for Soviet diamat.
  },
  keywords = {Levine, disjunction-thesis, dialectical-materialism, High, INCOMPLETE, no-abstract}
}

@article{kangal2019intentions,
  author = {Kangal, Kaan},
  title = {Engels' Intentions in {Dialectics of Nature}},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2019},
  volume = {83},
  number = {2},
  pages = {215--243},
  doi = {10.1521/siso.2019.83.2.215},
  abstract = {Reading different or controversial intentions into Marx and Engels' works has been somewhat a common but rather unquestioned practice in the history of Marxist scholarship. Engels' Dialectics of Nature, a torso for some and a great book for others, is a case in point. A bold line seems to shape the entire Engels debate and separate two opposite views in this regard: Engels the contaminator of Marx's materialism vs. Engels the self-started genius of dialectical materialism. What Engels, unlike Marx, has not enjoyed so far is a critical reflection upon the relationship between different layers of this text: authorial, textual, editorial and interpretational. Informed by a historical hermeneutic, inquiry into the elements that structure the debate on "Dialectics of Nature," and into the different political and philosophical functions attached to it, makes it possible to relocate the meaning of "dialectics" in a more precise context. Engels' dialectics is less complete than we usually think it is, but he achieved more than most scholars would like to admit.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Kangal argues that the scholarly debate about Dialectics of Nature has been structured by a false binary -- Engels as "contaminator" of Marx's materialism versus Engels as self-sufficient genius of dialectical materialism -- and that neither position adequately attends to the layered textual situation: the manuscript is simultaneously an authorial project, an unfinished torso, an editorial construction, and an interpretive tradition. Drawing on historical hermeneutics, Kangal reconstructs what Engels' dialectics actually achieves: it is less systematic than critics claim but more coherent than dismissals allow.

  RELEVANCE: This article provides the most methodologically rigorous recent analysis of the textual status of Dialectics of Nature and directly addresses the question of whether it was intended as a closed philosophical system. It is essential background for assessing claims about Engels' philosophy of nature and its relation to his philosophy of history.

  POSITION: Hermeneutical-archival approach; challenges both the contamination and rehabilitation theses on textual grounds.
  },
  keywords = {Kangal, Dialectics-of-Nature, hermeneutics, textual-status, High}
}

@book{kangal2020friedrich,
  author = {Kangal, Kaan},
  title = {Friedrich {Engels} and the Dialectics of Nature},
  year = {2020},
  publisher = {Springer International Publishing},
  series = {Marx, Engels, and Marxisms},
  doi = {10.1007/978-3-030-34335-4},
  note = {
  CORE ARGUMENT: This book-length treatment reconstructs Engels' project in Dialectics of Nature through careful philological and philosophical analysis, distinguishing between Engels' stated program, the actual manuscripts, and the Soviet editorial tradition that shaped their reception. Kangal argues that Engels' dialectics is anchored in a philosophy of process and motion rather than a static law-governed metaphysics, and that its incompleteness is not accidental but reflects genuine conceptual difficulties Engels was working through.

  RELEVANCE: The fullest scholarly treatment of Dialectics of Nature, providing the archival and philosophical context for assessing its status as a text and a philosophical project. Directly relevant to questions about whether Engels' philosophy of nature is a systematic closed system and how it relates to his historical-materialist claims.

  POSITION: Hermeneutical-archival approach that rehabilitates the seriousness of Engels' project without claiming it constitutes a finished system.
  },
  keywords = {Kangal, Dialectics-of-Nature, book, philology, High, INCOMPLETE, no-abstract}
}

@article{blackledge2017practical,
  author = {Blackledge, Paul},
  title = {Practical Materialism: {Engels's} {Anti-D\"uhring} as {Marxist} Philosophy},
  journal = {Critique},
  year = {2017},
  volume = {45},
  number = {4},
  pages = {483--499},
  doi = {10.1080/03017605.2017.1377927},
  abstract = {Frederick Engels's Anti-Duhring was the most important theoretical response to the emerging reformist tendencies within European socialism in the 19th century. It also proved to be Engels's most influential, and controversial work. Because it is, as Hal Draper points out, 'the only more or less systematic presentation of Marxism' by either by Marx or Engels, anyone wanting to reinterpret Marx must first detach it from his seal of approval. It is thus around Anti-Duhring and related texts that debates about the relationship of Marx to 'Engelsian' Marxism have tended to focus. This essay re-engages with debates about Engels's mature work with a view to unpicking his contribution to Marxism from caricatured criticisms of his thought.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Blackledge defends Anti-Duhring as a coherent "practical materialism" -- a philosophical stance that integrates the unity of theory and practice, the materialist dialectic, and a naturalistic ontology without reducing Marxism to a crude positivism. He argues that caricatured criticisms of Engels (as the creator of Soviet diamat, as a positivist, as an enemy of praxis) fail to engage with what Anti-Duhring actually argues, and that when read carefully the work supports a non-dogmatic, open-ended Marxist philosophy adequate to the tasks of socialist politics.

  RELEVANCE: This article is the most direct philosophical rehabilitation of Anti-Duhring in recent scholarship and engages explicitly with the contamination/disjunction tradition. It is central to understanding the current debate about Engels' philosophical contribution and his relationship to subsequent Marxist thought.

  POSITION: Rehabilitation thesis; argues Anti-Duhring is philosophically serious and continuous with Marx's method.
  },
  keywords = {Blackledge, Anti-Duhring, rehabilitation-thesis, practical-materialism, High}
}

@article{blackledge2025engelsbirthmarxism,
  author = {Blackledge, Paul},
  title = {Engels, the {Dialectics of Nature}, and the Birth of ``{Marxism}''},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2025},
  volume = {89},
  number = {1},
  pages = {85--98},
  doi = {10.1177/00368237241312552},
  abstract = {Sven-Eric Liedman's The Game of Contradictions (2022) sets out to be both the most comprehensive study of Engels's work on the social implications of 19th-century developments in the natural sciences and the most detailed analysis of this aspect of the Marx-Engels relationship. While noting the richness and depth of Liedman's research, this essay argues that his critique of Engels as a system builder is one-sided. Liedman's focus on the negative aspects of system building obscures the positive implications of Engels's research. Far from damning 20th-century Marxism, Engels's historical naturalism confirms that his ideas are more relevant than ever.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Blackledge argues that Engels' elaboration of dialectical materialism in Dialectics of Nature and Anti-Duhring was not a betrayal of Marx but a necessary political-philosophical intervention in the emerging socialist movement, and that the concept of "Marxism" as a coherent doctrine owes its origin largely to Engels' synthetic work. He situates Engels' philosophical project in its political context within the Second International and argues it enabled a distinctive form of socialist politics.

  RELEVANCE: As the most recent major article on Engels' philosophy of nature (2025), it engages with contemporary scholarship on Dialectics of Nature and connects the philosophical question about system-building to the political question about what "Marxism" as a movement required.

  POSITION: Rehabilitation thesis; connects Engels' philosophy of nature to the political project of constructing Marxism as a movement ideology.
  },
  keywords = {Blackledge, Dialectics-of-Nature, Marxism-formation, rehabilitation-thesis, High}
}

@incollection{foster2008dialecticsnaturemec,
  author = {Foster, John Bellamy},
  title = {The Dialectics of Nature and {Marxist} Ecology},
  booktitle = {Dialectics for the New Century},
  year = {2008},
  pages = {50--82},
  publisher = {Palgrave Macmillan UK},
  doi = {10.1057/9780230583818_4},
  abstract = {For 'Western Marxism' -- a term introduced by Maurice Merleau-Ponty in 1955 in his Adventures of the Dialectic (1973) to describe the philosophical tendency stemming from Georg Lukacs' History and Class Consciousness (1971; originally published in 1923) -- no concept internal to Marxism has been more antithetical to the genuine development of historical materialism than the 'dialectics of nature'. Commonly attributed to Engels rather than Marx, this concept is often seen as the differentia specifica that beginning in the 1920s separated the official Marxism of the Soviet Union from Western Marxism. Yet, as Lukacs, who played the leading role in questioning the concept of the dialectic of nature, was later to admit, Western Marxism's rejection of it struck at the very heart of the classical Marxist ontology -- that of Marx no less than Engels.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Foster argues that Western Marxism's rejection of the dialectics of nature -- beginning with Lukacs' influential claim that dialectics applies only to social relations -- fundamentally weakened Marxist ecology by severing the connection between historical materialism and a materialist understanding of natural processes. He contends that Engels' project was not the crude naturalism critics allege but a dialectical ontology that is indispensable for a coherent Marxist ecology.

  RELEVANCE: This chapter provides a defense of Engels' dialectics of nature from an ecological Marxist perspective, engaging directly with the Western Marxist rejection tradition. It is relevant to understanding how Engels' philosophical claims about nature connect to broader questions about historical materialism's scope.

  POSITION: Ecological rehabilitation of Engels' dialectics of nature; argues Western Marxism's rejection of it was philosophically and politically costly.
  },
  keywords = {Foster, dialectics-of-nature, ecology, Western-Marxism, Lukacs, Medium}
}

@article{foster2022returndialecticsnature,
  author = {Foster, John Bellamy},
  title = {The Return of the Dialectics of Nature},
  journal = {Historical Materialism},
  year = {2022},
  pages = {1--26},
  doi = {10.1163/1569206x-20222279},
  abstract = {The resurrection of the classical Marxian ecological critique in the context of the current planetary emergency has led to the return of the concept of the dialectics of nature, associated with the work of Frederick Engels in particular. In the century following the deaths of Charles Darwin and Karl Marx, the dialectics-of-nature conception played a formative role in the development of the modern ecological critique within science, notably in Britain, and helped inspire the contemporary environmentalist movement. Nevertheless, all of this occurred outside the dominant streams of Marxian thought and practice, where a great chasm had arisen in this area. Whereas official Marxism in the Soviet Union reduced the dialectics of nature to a fixed dogma, Western Marxism rejected it altogether. In the current Anthropocene Epoch -- and in what is referred to here as the Capitalinian Age of the Anthropocene -- a new historical-materialist synthesis constructed on classical foundations, reintegrating the dialectics of nature, so as to address the immense ecological challenges confronting humanity, is seen as objectively and subjectively necessary.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Foster argues that twenty-first-century ecological and systems-science debates have prompted a "return" to Engels' dialectics of nature as a viable philosophical framework, particularly for understanding non-linear, emergent, and irreversible processes in nature. He surveys recent scholarship and argues that Engels' insistence on dialectical laws in nature anticipates complexity theory and has been vindicated by the crisis of reductionism in biology and ecology.

  RELEVANCE: Connects Engels' philosophy of nature directly to contemporary philosophy of science debates and provides a defense of the continued relevance of Dialectics of Nature. Important for evaluating the philosophical status of Engels' naturalistic claims and their relationship to historical materialism.

  POSITION: Rehabilitation/contemporary-relevance thesis; the dialectics of nature is vindicated by developments in natural science and complexity theory.
  },
  keywords = {Foster, dialectics-of-nature, ecology, contemporary-science, Medium}
}

@article{boer2022motionmatter,
  author = {Boer, Roland},
  title = {Motion, Matter and Dialectics: From {Marx's} Doctoral Thesis to {Engels'} {Dialectics of Nature}},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2022},
  volume = {86},
  number = {3},
  pages = {389--408},
  doi = {10.1521/siso.2022.86.3.389},
  abstract = {There is an underlying continuity between Marx's doctoral thesis and Engels' Dialectics of Nature. Although the two works are far apart in terms of time, style of writing, and specific topics, an exegesis of the core arguments reveals similar underlying interests: a focus on the materiality of motion; an identification of repulsion (and attraction) as the main dialectical feature of motion; and the philosophical implications of this dialectical interaction. The results of this exegesis raise once again the question of how we may understand the division of labor between Marx's main concern with human history and Engels' later concern with natural history and the hard sciences.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Boer argues for a line of continuity from Marx's early doctoral work on Epicurean philosophy of nature through to Engels' Dialectics of Nature, tracing a shared concern with motion, matter, and the materialist critique of teleological explanation. He contends that Engels' philosophy of nature is not an alien imposition on Marxism but develops themes already present in Marx's earliest philosophical work on Greek atomism.

  RELEVANCE: This article provides a textual argument for continuity between Marx and Engels on philosophy of nature, directly challenging the disjunction thesis by showing that Marx's own philosophical formation included a serious engagement with natural philosophy.

  POSITION: Continuity/rehabilitation thesis; links Marx's early philosophy of nature to Engels' mature project.
  },
  keywords = {Boer, Marx-Engels-continuity, philosophy-of-nature, atomism, Medium}
}

@incollection{rigby2024dialecticalmaterialism,
  author = {Rigby, S. H.},
  title = {Dialectical Materialism},
  booktitle = {Engels and the Formation of Marxism},
  year = {2024},
  publisher = {Manchester University Press},
  doi = {10.7765/9781526184191.00013},
  abstract = {In The German Ideology, Marx and Engels outlined an historical materialism which could be assessed in terms of its logical coherence and empirical validity. Yet, it is often claimed that historical materialism is something more than just another variety of social theory; it is the application to human history of a broader philosophical outlook or world-view: dialectical materialism. In 1885, Engels claimed that he and Marx were 'pretty well the only people to rescue conscious dialectics from German idealist philosophy and apply it in the materialist conception of nature and history'. Engels' materialism can only be understood in terms of what he saw as its opposite: idealism. In the Dialectics of Nature, Engels defines three such laws: the law of the transformation of quantity into quality; the law of the negation of the negation; and the law of the interpenetration of opposites.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Rigby surveys Engels' dialectical materialism in the context of his overall contribution to the formation of Marxism, examining the three laws of dialectics as stated in Dialectics of Nature and Anti-Duhring, their derivation from Hegel, and the debates about their coherence and validity. He assesses the logical relationship between Engels' claims about natural dialectics and the claims of historical materialism, arguing that the former does not provide an adequate grounding for the latter.

  RELEVANCE: As a recent (2024) chapter in a book devoted to Engels' formation of Marxism, this provides a current evaluative framework for assessing both the content and status of dialectical materialism as Engels understood it, and connects directly to broader questions about his philosophy of history.

  POSITION: Critical survey; examines Engels' claims with analytical rigor and finds the philosophical foundations of dialectical materialism insufficiently grounded.
  },
  keywords = {Rigby, dialectical-materialism, Engels-formation-Marxism, analytical-approach, Medium}
}

