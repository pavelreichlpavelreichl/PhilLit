@article{levine1975tragic,
  author  = {Levine, Norman},
  title   = {The Tragic Deception: Marx Contra Engels},
  journal = {The American Historical Review},
  year    = {1976},
  volume  = {81},
  number  = {4},
  pages   = {845},
  doi     = {10.2307/1864839},
  note    = {
  CORE ARGUMENT: This is a review of Levine's 1975 book of the same title, the earliest systematic statement of the thesis that Engels actively distorted Marx's philosophy: specifically, that Engels's deterministic, naturalistic historical materialism ("the materialist conception of history as a science of laws") was fundamentally alien to Marx's dialectical, humanist, and practice-centred account of historical change.

  RELEVANCE: Levine's "tragic deception" thesis set the agenda for the Engels-problem literature. His identification of the contrast between Marx's Theses on Feuerbach (with their emphasis on practice) and Engels's scientific systematization maps directly onto the key question about the epistemological status of historical materialism.

  POSITION: Strong Engels-divergence thesis; Hegelian-humanist reading of Marx.
  },
  keywords = {Engels-problem, tragic-deception, historical-materialism, Levine, Medium, INCOMPLETE, no-abstract}
}

@article{thomas2007gramsci,
  author  = {Thomas, Peter},
  title   = {Modernity as {``}Passive Revolution{''}: Gramsci and the Fundamental Concepts of Historical Materialism},
  journal = {Journal of the Canadian Historical Association},
  year    = {2007},
  volume  = {17},
  number  = {2},
  pages   = {61--78},
  doi     = {10.7202/016590ar},
  note    = {
  CORE ARGUMENT: Thomas argues that Gramsci's concept of "passive revolution" provides a model for reconstructing historical materialism that breaks with determinist deformations -- including those traceable to Engels's formulations -- while retaining the analytical integrity of Marxist theory. Gramsci's integration of the Theses on Feuerbach enables a dialectical unity of structure and agency absent from orthodox Engelsian base-superstructure schemas.

  RELEVANCE: The paper shows how the Theses on Feuerbach (published by Engels but authored by Marx) can be used to correct Engelsian determinism, directly addressing the project's question about the relationship between Engels's formulation and Marx's own statements on practice and agency.

  POSITION: Post-Althusserian structural Marxism; Gramsci as corrective to Engelsian determinism.
  },
  keywords  = {Gramsci, historical-materialism, agency-structure, Feuerbach-theses, Medium},
  abstract = {The recent revival of interest in Marxism within and beyond the academy has led to various proposals for contemporary reconstructions of historical materialism. This article proposes that the work of Antonio Gramsci could provide the basis for an historical materialist interdisciplinary research programme today that is capable of engaging productively in dialogue with other traditions of thought, while respecting their (and its own) differences. The article focuses in particular on Gramsci’s development of the concept of “passive revolution,” arguing that his integration of elements from Marx’s Theses on Feuerbach permits him both to break with various “determinist” deformations of Marx's thought while at the same time insisting upon the integrity of Marxist theory, as a tradition of thought capable of renewal through self-criticism. It proposes that Gramsci's thought offers resources for an explanatory historical narrative of modernity focused upon the political moment as the dialectical unity of “structure” and “agency”.},
  abstract_source = {openalex},
}

@book{steger1999engelsaftermarx,
  author    = {Steger, Manfred B. and Carver, Terrell},
