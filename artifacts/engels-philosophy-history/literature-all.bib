@book{brown2012marxgender,
  author = {Brown, Heather A.},
  title = {Marx on Gender and the Family: A Critical Study},
  year = {2012},
  publisher = {Brill},
  doi = {10.1163/9789004230484},
  note = {
  CORE ARGUMENT: A book-length critical study arguing that Marx (and, to a
  lesser extent, Engels) held a more nuanced and less economically reductive
  view of gender and the family than the orthodox and Western Marxist traditions
  have acknowledged. Brown draws on the MEGA notebooks and late manuscripts to
  show that Marx was developing an ecological and feminist sensitivity absent
  from Engels's more schematic account in The Origin of the Family.

  RELEVANCE: Implicitly distinguishes Marx from Engels on gender -- relevant to
  the question of whether the two thinkers hold a common philosophy of history
  or whether Engels's account introduces systematic distortions relative to
  Marx's own position.

  POSITION: Moderate distortion thesis applied specifically to gender theory,
  defending Marx against Engels's reductionism.
  },
  keywords = {Marx-gender, Engels-feminist, distortion-thesis, Medium},
  abstract = {This, the first book-length study devoted exclusively to Marx's perspectives on gender and the family, offers a fresh look at this topic in light of twenty-first century concerns. Although Marx's writings sometimes exhibit sexism, especially through the naturalization of certain female social functions, his work often transcends these. Brown studies those writings on gender, as well as his 1879-1882 notebooks on precapitalist societies and gender, some of them still unpublished in any language. The author argues that although Marx never fully developed these ideas, he gave important indications toward a theory of gender and society. This study attempts to fill a significant gap in the literature on Marx and offer some general insights into the intersectionality of gender and class.},
  abstract_source = {openalex},
}

@article{carver2018auxiliaries,
  author = {Carver, Terrell},
  title = {``Mere Auxiliaries to the Movement'': How Intellectual Biography Obscures {Marx}'s and {Engels}'s Gendered Political Partnerships},
  journal = {Hypatia},
  year = {2018},
  volume = {33},
  number = {4},
  pages = {593--609},
  doi = {10.1111/hypa.12439},
  note = {
  CORE ARGUMENT: Argues that the genre of intellectual biography, which
  constructs Marx and Engels as heroic male thinkers, systematically effaces the
  gendered political partnerships through which their ideas were actually
  developed and transmitted. Carver focuses on the women involved in Marx's and
  Engels's political circles to show how biography structures what counts as
  philosophical contribution.

  RELEVANCE: Opens a methodological question about how the Marx/Engels
  relationship itself has been constructed through masculinist biographical
  conventions, relevant to the broader question of whether the standard
  dichotomy between their philosophies is itself a historiographical artifact.

  POSITION: Feminist critique of the intellectual history apparatus that
  generated and sustains the "two thinkers" framework.
  },
  keywords = {Engels-feminist, intellectual-biography, methodology, Medium},
  abstract = {Four women have been conventionally framed as wives and/or mistresses and/or sexual partners in the biographical reception of Karl Marx (1818–1883) and Friedrich Engels (1820–1895) as heterosexual men. These women were Jenny Marx (née von Westphalen) (1814–1881), Helene Demuth (“Lenchen”) (1820–1890), Mary Burns (1821–1863), and Lydia Burns (1827–1878). How exactly they appear in the few contemporary texts and rare images that survive is less interesting than the determination of subsequent biographers of the two “great men” to make these women fit a familiar genre, namely intellectual biography. An analysis of Marx–Engels biographies shows how this masculinized genre enforces an incuriosity that makes gendered political partnerships unthinkable and therefore invisible. By contrast, a positive interest in these women, which rethinks what a gendered political partnership is or could be, results in a significantly different view of the two men. As historical figures, they shift from being individualized or paired‐with‐each‐other “great thinkers” to communist/socialist activists working in and through everyday spaces and material practices. Their pamphlets, articles, and books thus appear more as immediate political interventions and less as timeless theorizing or as the raw material for such intellectualizing reconstructions.},
  abstract_source = {openalex},
}

@article{royle2021introduction,
  author = {Royle, Camilla},
  title = {Introduction: Friedrich {Engels} and Geography},
  journal = {Human Geography},
  year = {2021},
  volume = {14},
  number = {2},
  pages = {165--172},
  doi = {10.1177/19427786211024211},
  note = {
  CORE ARGUMENT: Introduces a special issue revisiting Engels's relevance for
  contemporary human geography, arguing that his attention to urban
  environments, metabolic relations between humans and nature, and the spatial
  dimensions of capitalist production make him an underutilised resource for
  critical geography. Explicitly responds to the 2020 bicentenary.

  RELEVANCE: Represents the bicentenary reassessment in a discipline that
  engages with Engels's empirical work (The Condition of the Working Class in
  England) as well as his more theoretical writings, and reflects the broader
  ecological turn in Engels scholarship.

  POSITION: Sympathetic rehabilitation, focused on urban ecology and geography.
  },
  keywords = {Engels-rehabilitation, ecology, bicentenary-2020, Low},
  abstract = {Friedrich Engels (1820–1895) was Marx’s closest collaborator. He was influential in promoting Marxism both during Marx’s lifetime and after it. However, he is mentioned less often than Marx in geography. This editorial introduces a special issue of Human Geography on Friedrich Engels and Geography. It gives a brief overview of the key events in his life, discusses some of the geographical themes in Engels’ work – especially his relevance for work in political ecology, urbanism and geopolitics – and outlines the contents of the special issue.},
  abstract_source = {openalex},
}

@article{royle2021engelsian,
  author = {Royle, Camilla},
  title = {Thinking as an {Engelsian}},
  journal = {Human Geography},
  year = {2021},
  volume = {15},
  number = {1},
  pages = {66--72},
  doi = {10.1177/19427786211050982},
  note = {
  CORE ARGUMENT: Proposes "thinking as an Engelsian" as a methodological
  stance that draws on Engels's dialectics of nature, his attention to concrete
  material conditions, and his willingness to synthesise scientific findings
  within a materialist framework, as resources for contemporary critical social
  science.

  RELEVANCE: Shows how the rehabilitation of Engels operates at a methodological
  level beyond historical recovery, suggesting that his approach to the
  philosophy of nature and science is actively usable rather than merely of
  historical interest.

  POSITION: Methodological Engelsian: dialectics of nature as active research
  programme.
  },
  keywords = {Engels-ecology, dialectics-of-nature, methodology, Low},
  abstract = {In this essay, I address the question of how Marxism influences our thought and action as radical intellectuals by focusing on Friedrich Engels’ work, Dialectics of Nature, the way it has been taken up in critical environmental studies and how Engels’ thinking has influenced me. In later life, Engels made important contributions on topics that are distinct from Marx's economic work. He attempted to apply dialectical methods to the “natural sciences” and he also used his knowledge of anthropology to produce a study of the historical origins of private property and women's oppression. In both cases he has been accused of adopting a positivist approach that lacks the emphasis on human agency found in Marx. Here, I challenge this view by showing how Engels’ work has been of use to practicing scientists – particularly to Richard Levins and Richard Lewontin in their book The Dialectical Biologist. I further argue that this understanding of dialectics is fully commensurable and actually advances an approach to Marxism that is based on human self-emancipation. As an undergraduate biology student these scientists inspired me with their approach to their subject as well as their activism. The essay concludes with some brief thoughts on the importance and limitations of adopting a Marxist method when considering socio-environmental change.},
  abstract_source = {openalex},
}

@article{arboleda2025development,
  author = {Arboleda, Mart{\'i}n},
  title = {Friedrich {Engels} on Development and Nature: Rethinking Ecology beyond {Western} {Marxism}},
  journal = {Review of International Political Economy},
  year = {2025},
  volume = {32},
  number = {4},
  pages = {1100--1121},
  doi = {10.1080/09692290.2025.2459630},
  note = {
  CORE ARGUMENT: Reconstructs an Engelsian theory of ecological development by
  reading his mature work in dialogue with Latin American Marxist reception,
  arguing that Engels's political economy of nature enables a multilinear theory
  of historical and technological change that challenges both mainstream
  developmentalism and the degrowth turn in Western Marxism. Engels's writings
  on political strategy for an ecological socialism are retrieved alongside the
  theoretical arguments.

  RELEVANCE: Provides a 2025 perspective on the broader question of whether
  Engels's philosophy of history is teleological and Eurocentric or admits of
  multilinear and ecologically sensitive readings, engaging directly with the
  distortion thesis in the context of Global South reception.

  POSITION: Engelsian ecological materialism against Western Marxist and
  degrowth critiques.
  },
  keywords = {Engels-ecology, development, Western-Marxism, High},
  abstract = {Abstract This article reconstructs the theory of ecological development that underlies the mature intellectual production of Friedrich Engels. It does so by means of a dialogue between recent scholarly interpretations of his thought, on the one hand, and a contextualized discussion of its reception in Latin America, on the other. Published in the aftermath of the Cuban Revolution, the mature work of Engels enabled Latin American Marxism to challenge mainstream theories of development that framed this concept in terms of mere growth or modernization, and to provide a multilinear understanding of historical and technological change in modern societies. For Engels, the (eco)socialist development of the forces of production would require the construction of a mass movement against capital. Accordingly, the article also unearths his writings on political strategy, and discusses the ways in which they informed anti-dictatorial struggles in Latin America. By bringing together the economic and the political underpinnings of an Engelsian theory of development, the article rethinks ecological socialism beyond Western Marxism – especially after its shift towards degrowth – and points at its implications for building an environmental politics of the working class.},
  abstract_source = {s2},
}

@book{saito2023anthropocene,
  author = {Saito, Kohei},
  title = {Marx in the {Anthropocene}: Towards the Idea of Degrowth Communism},
  year = {2023},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781108933544},
  note = {
  CORE ARGUMENT: Argues for a "degrowth communism" rooted in Marx's late
  ecological notebooks, where Marx moved away from the Promethean
  productivism associated with the earlier writings that Engels systematised.
  Saito's reading implicitly treats Engels's philosophical codification as
  locking in a productivism that Marx was in the process of questioning,
  positioning the late Marx as departing from the Engels-shaped orthodoxy.

  RELEVANCE: Represents the contemporary ecosocialist tradition that draws a
  sharp methodological distinction between Marx and Engels, using ecological
  grounds rather than the Western Marxist humanist grounds. Important counterpoint
  to the rehabilitative literature (Foster, Blackledge) that defends the
  Marx/Engels continuity on ecological matters.

  POSITION: Moderate distortion thesis from an ecological angle, distinguishing
  late Marx from Engelsian orthodoxy.
  },
  keywords = {Marx-ecology, degrowth, distortion-thesis, Medium},
  abstract = {Facing global climate crisis, Karl Marx's ecological critique of capitalism more clearly demonstrates its importance than ever. This book explains why Marx's ecology had to be marginalized and even suppressed by Marxists after his death throughout the twentieth century. Marx's ecological critique of capitalism, however, revives in the Anthropocene against dominant productivism and monism. Investigating new materials published in the complete works of Marx and Engels (Marx-Engels-Gesamtausgabe), Saito offers a wholly novel idea of Marx's alternative to capitalism that should be adequately characterized as degrowth communism. This provocative interpretation of the late Marx sheds new lights on the recent debates on the relationship between society and nature and invites readers to envision a post-capitalist society without repeating the failure of the actually existing socialism of the twentieth century.},
  abstract_source = {openalex},
