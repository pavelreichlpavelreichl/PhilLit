}

@book{engels1886feuerbach,
  author = {Engels, Friedrich},
  title = {Ludwig Feuerbach and the End of Classical German Philosophy},
  year = {1886},
  publisher = {Foreign Languages Publishing House},
  address = {Moscow},
  note = {
  CORE ARGUMENT: Engels surveys the movement from Hegel through the dissolution of Hegelianism to Feuerbach's materialism and then to the materialist conception of history developed by Marx and himself. He articulates a realist epistemological position (the "reflection theory") according to which thought reflects material reality, and defends the unity of theory and practice. The text also contains his well-known account of the "basic question of all philosophy" (the relation of thought to being) which became canonical in Soviet dialectical materialism.

  RELEVANCE: This text provides the clearest statement of Engels' epistemology and his reading of the Hegel-Marx relationship, making it central to debates about how accurately he understood his own intellectual heritage and whether his realist epistemology is compatible with Marx's more practice-oriented approach.

  POSITION: Primary text; key source for Engels' epistemology and his account of the transition from Hegel to Marx.
  },
  keywords = {primary-text, epistemology, Hegel, Feuerbach, High, INCOMPLETE, no-abstract}
}

@article{carver1980dialektik,
  author = {Carver, Terrell},
  title = {Marx, Engels and Dialectics},
  journal = {Political Studies},
  year = {1980},
  volume = {28},
  number = {3},
  pages = {353--363},
  doi = {10.1111/j.1467-9248.1980.tb00474.x},
  abstract = {Two familiar 'facts' about Marx, Engels and their views are in reality fictions. The first is that Marx and Engels speak with the same voice on all important theoretical issues; that their works supplement each other; and that they had a perfect intellectual partnership. The second fiction is that as Marx grew older, he embraced the positivism and determinism fashionable at the time. The strongest evidence for the second fiction is the claim that Marx approved of Engels's Anti-Duhring of 1877-8 and agreed in principle with other works by Engels, such as the Dialectics of Nature. I attack the second fiction in detail, and then use my conclusions to attack the first. This exposes a divergence between the views of Marx and Engels on classic problems in social science.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Carver argues that there is a significant divergence between Marx's use of "dialectics" as a critical method for analyzing historical and social relations and Engels' claim to have derived dialectical laws from nature. Marx never endorsed a "dialectics of nature" or the three universal laws Engels formulates in Anti-Duhring and Dialectics of Nature; the project of extending dialectics to the natural sciences is Engels' independent contribution, and it involves a category mistake that reduces dialectics from a critical social method to a naturalistic metaphysics.

  RELEVANCE: This early article establishes the key terms of the "disjunction" debate and directly bears on whether Engels' nature-philosophy departs from Marx's philosophical framework. It is a founding text of the revisionist tradition that reads "Marx and Engels" as two distinct thinkers.

  POSITION: Disjunction/contamination thesis; argues Engels' dialectics of nature is philosophically incompatible with Marx's method.
  },
  keywords = {Carver, disjunction-thesis, dialectics-of-nature, Marx-Engels-debate, High}
}

@article{carver1984scholarship,
  author = {Carver, Terrell},
  title = {Marx, Engels and Scholarship},
  journal = {Political Studies},
  year = {1984},
  volume = {32},
  number = {2},
  pages = {249--256},
  doi = {10.1111/j.1467-9248.1984.tb00177.x},
  note = {
  CORE ARGUMENT: Carver surveys the state of Marx-Engels scholarship and argues that the editorial and textual conflation of Marx and Engels into a single voice ("MarxEngels") has systematically distorted interpretation of both thinkers. He calls for a methodological separation of their texts and argues that Engels' editorial decisions -- particularly in assembling and presenting Marx's manuscripts -- shaped how both thinkers came to be read.

  RELEVANCE: This methodological paper underpins the textual-historical approach to the Engels corpus and argues that treating "Marxism" as a joint project produces systematic interpretive errors relevant to assessing Engels' philosophy of history.

  POSITION: Methodological argument for treating Marx and Engels as distinct intellectual figures; supports the disjunction thesis.
  },
  keywords = {Carver, methodology, textual-criticism, Marx-Engels-debate, Medium, INCOMPLETE, no-abstract}
}

@book{levine1975tragicdeception,
  author = {Levine, Norman},
  title = {The Tragic Deception: {Marx} Contra {Engels}},
  year = {1975},
  publisher = {ABC-Clio},
  address = {Oxford},
  note = {
  CORE ARGUMENT: Levine argues that Engels fundamentally betrayed Marx's philosophical intentions by constructing a positivistic, naturalistic dialectical materialism that reduced Marxism to a mechanistic science of laws. He contends that Marx's method was rooted in Hegel's dialectic of self-consciousness and historical praxis, while Engels substituted a naturalistic ontology derived from empirical science. This "tragic deception" shaped the entire subsequent history of Marxism-Leninism.

  RELEVANCE: Levine's book is one of the most uncompromising statements of the thesis that Engels' philosophy constitutes a betrayal rather than a development of Marx. It directly bears on the question of what Engels actually argued in Anti-Duhring and Dialectics of Nature by measuring it against an alternative reading of Marx.

  POSITION: Strong disjunction/contamination thesis; positions Engels as philosophically responsible for Soviet diamat.
  },
  keywords = {Levine, disjunction-thesis, dialectical-materialism, High, INCOMPLETE, no-abstract}
}

@article{kangal2019intentions,
  author = {Kangal, Kaan},
  title = {Engels' Intentions in {Dialectics of Nature}},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2019},
  volume = {83},
  number = {2},
  pages = {215--243},
  doi = {10.1521/siso.2019.83.2.215},
  abstract = {Reading different or controversial intentions into Marx and Engels' works has been somewhat a common but rather unquestioned practice in the history of Marxist scholarship. Engels' Dialectics of Nature, a torso for some and a great book for others, is a case in point. A bold line seems to shape the entire Engels debate and separate two opposite views in this regard: Engels the contaminator of Marx's materialism vs. Engels the self-started genius of dialectical materialism. What Engels, unlike Marx, has not enjoyed so far is a critical reflection upon the relationship between different layers of this text: authorial, textual, editorial and interpretational. Informed by a historical hermeneutic, inquiry into the elements that structure the debate on "Dialectics of Nature," and into the different political and philosophical functions attached to it, makes it possible to relocate the meaning of "dialectics" in a more precise context. Engels' dialectics is less complete than we usually think it is, but he achieved more than most scholars would like to admit.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Kangal argues that the scholarly debate about Dialectics of Nature has been structured by a false binary -- Engels as "contaminator" of Marx's materialism versus Engels as self-sufficient genius of dialectical materialism -- and that neither position adequately attends to the layered textual situation: the manuscript is simultaneously an authorial project, an unfinished torso, an editorial construction, and an interpretive tradition. Drawing on historical hermeneutics, Kangal reconstructs what Engels' dialectics actually achieves: it is less systematic than critics claim but more coherent than dismissals allow.

  RELEVANCE: This article provides the most methodologically rigorous recent analysis of the textual status of Dialectics of Nature and directly addresses the question of whether it was intended as a closed philosophical system. It is essential background for assessing claims about Engels' philosophy of nature and its relation to his philosophy of history.

  POSITION: Hermeneutical-archival approach; challenges both the contamination and rehabilitation theses on textual grounds.
  },
  keywords = {Kangal, Dialectics-of-Nature, hermeneutics, textual-status, High}
}

@book{kangal2020friedrich,
  author = {Kangal, Kaan},
  title = {Friedrich {Engels} and the Dialectics of Nature},
  year = {2020},
  publisher = {Springer International Publishing},
  series = {Marx, Engels, and Marxisms},
  doi = {10.1007/978-3-030-34335-4},
  note = {
  CORE ARGUMENT: This book-length treatment reconstructs Engels' project in Dialectics of Nature through careful philological and philosophical analysis, distinguishing between Engels' stated program, the actual manuscripts, and the Soviet editorial tradition that shaped their reception. Kangal argues that Engels' dialectics is anchored in a philosophy of process and motion rather than a static law-governed metaphysics, and that its incompleteness is not accidental but reflects genuine conceptual difficulties Engels was working through.

  RELEVANCE: The fullest scholarly treatment of Dialectics of Nature, providing the archival and philosophical context for assessing its status as a text and a philosophical project. Directly relevant to questions about whether Engels' philosophy of nature is a systematic closed system and how it relates to his historical-materialist claims.

  POSITION: Hermeneutical-archival approach that rehabilitates the seriousness of Engels' project without claiming it constitutes a finished system.
  },
  keywords = {Kangal, Dialectics-of-Nature, book, philology, High, INCOMPLETE, no-abstract}
}

@article{blackledge2017practical,
  author = {Blackledge, Paul},
  title = {Practical Materialism: {Engels's} {Anti-D\"uhring} as {Marxist} Philosophy},
  journal = {Critique},
  year = {2017},
  volume = {45},
  number = {4},
  pages = {483--499},
  doi = {10.1080/03017605.2017.1377927},
  abstract = {Frederick Engels's Anti-Duhring was the most important theoretical response to the emerging reformist tendencies within European socialism in the 19th century. It also proved to be Engels's most influential, and controversial work. Because it is, as Hal Draper points out, 'the only more or less systematic presentation of Marxism' by either by Marx or Engels, anyone wanting to reinterpret Marx must first detach it from his seal of approval. It is thus around Anti-Duhring and related texts that debates about the relationship of Marx to 'Engelsian' Marxism have tended to focus. This essay re-engages with debates about Engels's mature work with a view to unpicking his contribution to Marxism from caricatured criticisms of his thought.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Blackledge defends Anti-Duhring as a coherent "practical materialism" -- a philosophical stance that integrates the unity of theory and practice, the materialist dialectic, and a naturalistic ontology without reducing Marxism to a crude positivism. He argues that caricatured criticisms of Engels (as the creator of Soviet diamat, as a positivist, as an enemy of praxis) fail to engage with what Anti-Duhring actually argues, and that when read carefully the work supports a non-dogmatic, open-ended Marxist philosophy adequate to the tasks of socialist politics.

  RELEVANCE: This article is the most direct philosophical rehabilitation of Anti-Duhring in recent scholarship and engages explicitly with the contamination/disjunction tradition. It is central to understanding the current debate about Engels' philosophical contribution and his relationship to subsequent Marxist thought.

  POSITION: Rehabilitation thesis; argues Anti-Duhring is philosophically serious and continuous with Marx's method.
  },
  keywords = {Blackledge, Anti-Duhring, rehabilitation-thesis, practical-materialism, High}
}

@article{blackledge2025engelsbirthmarxism,
  author = {Blackledge, Paul},
  title = {Engels, the {Dialectics of Nature}, and the Birth of ``{Marxism}''},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2025},
  volume = {89},
  number = {1},
  pages = {85--98},
  doi = {10.1177/00368237241312552},
  abstract = {Sven-Eric Liedman's The Game of Contradictions (2022) sets out to be both the most comprehensive study of Engels's work on the social implications of 19th-century developments in the natural sciences and the most detailed analysis of this aspect of the Marx-Engels relationship. While noting the richness and depth of Liedman's research, this essay argues that his critique of Engels as a system builder is one-sided. Liedman's focus on the negative aspects of system building obscures the positive implications of Engels's research. Far from damning 20th-century Marxism, Engels's historical naturalism confirms that his ideas are more relevant than ever.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Blackledge argues that Engels' elaboration of dialectical materialism in Dialectics of Nature and Anti-Duhring was not a betrayal of Marx but a necessary political-philosophical intervention in the emerging socialist movement, and that the concept of "Marxism" as a coherent doctrine owes its origin largely to Engels' synthetic work. He situates Engels' philosophical project in its political context within the Second International and argues it enabled a distinctive form of socialist politics.

  RELEVANCE: As the most recent major article on Engels' philosophy of nature (2025), it engages with contemporary scholarship on Dialectics of Nature and connects the philosophical question about system-building to the political question about what "Marxism" as a movement required.

  POSITION: Rehabilitation thesis; connects Engels' philosophy of nature to the political project of constructing Marxism as a movement ideology.
  },
  keywords = {Blackledge, Dialectics-of-Nature, Marxism-formation, rehabilitation-thesis, High}
}

@incollection{foster2008dialecticsnaturemec,
  author = {Foster, John Bellamy},
  title = {The Dialectics of Nature and {Marxist} Ecology},
  booktitle = {Dialectics for the New Century},
  year = {2008},
  pages = {50--82},
  publisher = {Palgrave Macmillan UK},
  doi = {10.1057/9780230583818_4},
  abstract = {For 'Western Marxism' -- a term introduced by Maurice Merleau-Ponty in 1955 in his Adventures of the Dialectic (1973) to describe the philosophical tendency stemming from Georg Lukacs' History and Class Consciousness (1971; originally published in 1923) -- no concept internal to Marxism has been more antithetical to the genuine development of historical materialism than the 'dialectics of nature'. Commonly attributed to Engels rather than Marx, this concept is often seen as the differentia specifica that beginning in the 1920s separated the official Marxism of the Soviet Union from Western Marxism. Yet, as Lukacs, who played the leading role in questioning the concept of the dialectic of nature, was later to admit, Western Marxism's rejection of it struck at the very heart of the classical Marxist ontology -- that of Marx no less than Engels.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Foster argues that Western Marxism's rejection of the dialectics of nature -- beginning with Lukacs' influential claim that dialectics applies only to social relations -- fundamentally weakened Marxist ecology by severing the connection between historical materialism and a materialist understanding of natural processes. He contends that Engels' project was not the crude naturalism critics allege but a dialectical ontology that is indispensable for a coherent Marxist ecology.

  RELEVANCE: This chapter provides a defense of Engels' dialectics of nature from an ecological Marxist perspective, engaging directly with the Western Marxist rejection tradition. It is relevant to understanding how Engels' philosophical claims about nature connect to broader questions about historical materialism's scope.

  POSITION: Ecological rehabilitation of Engels' dialectics of nature; argues Western Marxism's rejection of it was philosophically and politically costly.
  },
  keywords = {Foster, dialectics-of-nature, ecology, Western-Marxism, Lukacs, Medium}
}

@article{boer2022motionmatter,
  author = {Boer, Roland},
  title = {Motion, Matter and Dialectics: From {Marx's} Doctoral Thesis to {Engels'} {Dialectics of Nature}},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2022},
  volume = {86},
  number = {3},
  pages = {389--408},
  doi = {10.1521/siso.2022.86.3.389},
  abstract = {There is an underlying continuity between Marx's doctoral thesis and Engels' Dialectics of Nature. Although the two works are far apart in terms of time, style of writing, and specific topics, an exegesis of the core arguments reveals similar underlying interests: a focus on the materiality of motion; an identification of repulsion (and attraction) as the main dialectical feature of motion; and the philosophical implications of this dialectical interaction. The results of this exegesis raise once again the question of how we may understand the division of labor between Marx's main concern with human history and Engels' later concern with natural history and the hard sciences.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Boer argues for a line of continuity from Marx's early doctoral work on Epicurean philosophy of nature through to Engels' Dialectics of Nature, tracing a shared concern with motion, matter, and the materialist critique of teleological explanation. He contends that Engels' philosophy of nature is not an alien imposition on Marxism but develops themes already present in Marx's earliest philosophical work on Greek atomism.

  RELEVANCE: This article provides a textual argument for continuity between Marx and Engels on philosophy of nature, directly challenging the disjunction thesis by showing that Marx's own philosophical formation included a serious engagement with natural philosophy.

  POSITION: Continuity/rehabilitation thesis; links Marx's early philosophy of nature to Engels' mature project.
  },
  keywords = {Boer, Marx-Engels-continuity, philosophy-of-nature, atomism, Medium}
}

@incollection{rigby2024dialecticalmaterialism,
  author = {Rigby, S. H.},
  title = {Dialectical Materialism},
  booktitle = {Engels and the Formation of Marxism},
  year = {2024},
  publisher = {Manchester University Press},
  doi = {10.7765/9781526184191.00013},
  abstract = {In The German Ideology, Marx and Engels outlined an historical materialism which could be assessed in terms of its logical coherence and empirical validity. Yet, it is often claimed that historical materialism is something more than just another variety of social theory; it is the application to human history of a broader philosophical outlook or world-view: dialectical materialism. In 1885, Engels claimed that he and Marx were 'pretty well the only people to rescue conscious dialectics from German idealist philosophy and apply it in the materialist conception of nature and history'. Engels' materialism can only be understood in terms of what he saw as its opposite: idealism. In the Dialectics of Nature, Engels defines three such laws: the law of the transformation of quantity into quality; the law of the negation of the negation; and the law of the interpenetration of opposites.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Rigby surveys Engels' dialectical materialism in the context of his overall contribution to the formation of Marxism, examining the three laws of dialectics as stated in Dialectics of Nature and Anti-Duhring, their derivation from Hegel, and the debates about their coherence and validity. He assesses the logical relationship between Engels' claims about natural dialectics and the claims of historical materialism, arguing that the former does not provide an adequate grounding for the latter.

  RELEVANCE: As a recent (2024) chapter in a book devoted to Engels' formation of Marxism, this provides a current evaluative framework for assessing both the content and status of dialectical materialism as Engels understood it, and connects directly to broader questions about his philosophy of history.

  POSITION: Critical survey; examines Engels' claims with analytical rigor and finds the philosophical foundations of dialectical materialism insufficiently grounded.
  },
  keywords = {Rigby, dialectical-materialism, Engels-formation-Marxism, analytical-approach, Medium}
}

@article{foster2022return,
  author = {Foster, John Bellamy},
  title = {The Return of the Dialectics of Nature},
  journal = {Historical Materialism},
  year = {2022},
  pages = {1--26},
  doi = {10.1163/1569206x-20222279},
  note = {
  CORE ARGUMENT: Argues that the ecological crisis of the Anthropocene makes the dialectics of nature concept newly urgent; traces how the concept was reduced to Stalinist dogma in official Marxism and rejected wholesale in Western Marxism, and proposes its rehabilitation as the basis for a historical-materialist ecological synthesis.

  RELEVANCE: Represents the eco-Marxist defense of Engels' dialectics of nature, directly confronting the Western Marxist rejection (Lukacs' position). Argues that the divorce between history and nature in Western Marxism is itself an ideological position that cripples ecological thought.

  POSITION: Pro-Engels ecological rehabilitation, against both Soviet dogmatism and Western Marxist rejection.
  },
  keywords = {dialectics-of-nature, ecology, Western-Marxism, Lukacs, High},
  abstract = {
  abstract_source = {s2},
 The resurrection of the classical Marxian ecological critique in the context of the current planetary emergency has led to the return of the concept of the dialectics of nature, associated with the work of Frederick Engels in particular. In the century following the deaths of Charles Darwin and Karl Marx, the dialectics-of-nature conception played a formative role in the development of the modern ecological critique within science, notably in Britain, and helped inspire the contemporary environmentalist movement. Nevertheless, all of this occurred outside the dominant streams of Marxian thought and practice, where a great chasm had arisen in this area. Whereas official Marxism in the Soviet Union reduced the dialectics of nature to a fixed dogma, Western Marxism rejected it altogether. In the current Anthropocene Epoch in the geological time scale – and in what is referred to here as the Capitalinian Age of the Anthropocene – a new historical-materialist synthesis constructed on classical foundations, reintegrating the dialectics of nature, so as to address the immense ecological challenges confronting humanity, is seen as objectively (and subjectively) necessary.},
}

@article{shafer2023engels,
  author = {Shafer, Matt},
  title = {Engels after Frankfurt: Nature and Enlightenment in Critical Theory},
  journal = {New German Critique},
  year = {2023},
  volume = {50},
  number = {1},
  pages = {1--29},
  doi = {10.1215/0094033x-10140705},
  note = {
  CORE ARGUMENT: Reconstructs the Frankfurt Institute's early publication of Engels' Dialectics of Nature manuscripts in the 1920s and traces how the Frankfurt School subsequently turned away from Engels' philosophy of natural science; argues that a recovery of Engels' naturalism can help critical theory move beyond the pessimism about technoscience that characterized Horkheimer's mature work.

  RELEVANCE: Bridges the gap between Engels' dialectics of nature and critical theory, showing that the Western Marxist rejection was historically specific rather than philosophically inevitable. Directly addresses whether Engels' naturalism is compatible with a sophisticated critical epistemology.

  POSITION: Qualified rehabilitation of Engels' philosophy of nature within the critical theory tradition.
  },
  keywords = {dialectics-of-nature, critical-theory, Frankfurt-School, Horkheimer, naturalism, High},
  abstract = {The Institute for Social Research in Frankfurt facilitated the first publication of Friedrich Engels’s controversial Dialectics of Nature manuscripts in the 1920s. Yet the subsequent work of the institute’s most influential members almost entirely turned away from the approach to natural science that Engels had advocated. The result was an indispensably incisive critique of social domination and a deepening skepticism about natural-scientific contributions to the construction of the postcapitalist alternative. Through a new reading of the development of Max Horkheimer’s analysis of empiricism and an original reconstruction of Engels’s unjustly maligned philosophy of nature, this essay outlines how critical theory can move beyond the pessimism about technoscientific practice that characterized the Frankfurt School’s most influential early work—without forfeiting the historical insight such pessimism once animated.},
  abstract_source = {s2},
}

@article{azeri2022dialectics,
  author = {Azeri, Siyave\c{s}},
  title = {Engels' Dialectics of---Human Activity in---Nature},
  journal = {Marxism \& Sciences},
  year = {2022},
  pages = {69},
  doi = {10.56063/ms.2201.01105},
  note = {
  CORE ARGUMENT: Challenges Western Marxist critiques (especially Lukacs) of Engels for allegedly non-dialectical treatment of praxis; argues that Engels' account of labour as a philosophical category anticipates Ilyenkov's concept of human activity and that the laws of dialectics are best understood as laws of human activity in social nature, not abstract laws of a nature external to society.

  RELEVANCE: Directly engages the Lukacs-versus-Engels debate over whether dialectics can apply to nature without collapsing the subject-object relation. Offers a reading that bridges the two camps by grounding nature-dialectics in praxis.

  POSITION: Defends Engels against Lukacs by reframing the dialectics of nature as praxis-centred.
  },
  keywords = {dialectics-of-nature, Lukacs, praxis, Ilyenkov, High},
  abstract = {: Several Marxist theorists criticize Engels for his supposed non-dialectical and non-philosophical conceptualization of “praxis,” which, according to Lukacs, amounts to Engels’ alleged misunderstanding of Kantian “thing-in-itself.” I argue that such “criticisms” of Engels is based on a dualistic understanding of practical vs. theoretical. Contrary to the critiques’ allegations, Engels provides an account of prax-is/labour as a philosophical category that is truthful to Marx’s and his own earlier efforts for constituting a materialist dialectics—one that anticipates the concept of “human activity” elaborated particularly in philosophical works of Evald Ilyenkov and psychological studies of Lev Vygotsky. According to Engels, the so-called laws of dialectics are historical thus depending on human activity as it is “with man [that] we enter history.” Furthermore, it is through labour (the highest form of human activity) that not only the human hands but also social humanity and human consciousness have been constituted. Thus, laws of dialectics are the most general laws of human activity in social nature. Engels, truthful to Marx’s materialist method, prioritizes action over substance.},
  abstract_source = {s2},
}

@article{arencibia2021ilyenkov,
  author = {Piedra Arencibia, Rogney},
  title = {Ilyenkov's Dialectics of the Ideal and Engels's Dialectics of Nature},
  journal = {Historical Materialism},
  year = {2021},
  volume = {30},
  number = {3},
  pages = {145--177},
  doi = {10.1163/1569206x-12342048},
  note = {
  CORE ARGUMENT: Argues that the influence of Engels on Ilyenkov's philosophy is systematically overlooked or denied by scholars who wish to assimilate Ilyenkov to Western Marxism; demonstrates that Ilyenkov, like Engels, conceives philosophy as Logic allied with natural science and develops an original cosmological hypothesis based on Engels' hierarchy of forms of matter's movement.

  RELEVANCE: Shows how Engels' dialectics of nature was productively developed in Soviet philosophy through Ilyenkov, providing an alternative lineage to the Western Marxist critique. Relevant to assessing whether there is a philosophically credible tradition of dialectical materialism in the natural sciences.

  POSITION: Rehabilitates the Soviet philosophical tradition by emphasising Engels-Ilyenkov continuity against Western Marxist appropriations.
  },
  keywords = {Ilyenkov, dialectics-of-nature, Soviet-Marxism, forms-of-matter, Medium},
  abstract = {Abstract Within the current resurgence of interest in E.V. Ilyenkov, the influence of Engels on Ilyenkov’s work is either overlooked or denied, making Ilyenkov seem closer to Western Marxism than he actually is. In this paper, by considering Engels’s place in his philosophy, I show that Ilyenkov’s approach is fundamentally hostile to many of Western Marxism’s main views. Ilyenkov, like Engels, conceives philosophy as Logic and affirms the ‘alliance’ between philosophy and the natural sciences against speculative metaphysics. In this regard, he develops an original cosmological hypothesis based on Engels’s insights on the hierarchy of matter’s forms of movement and provides a remarkable account of the ideal as an attribute of nature that reproduces its concrete universality through social labour, the active transformation of nature’s phenomena into objects stamped with the seal of our subjectivity.},
  abstract_source = {openalex},
}

@article{zwart2020engels,
  author = {Zwart, Hub},
  title = {Friedrich Engels and the Technoscientific Reproducibility of Life: Synthetic Cells as Case Material for Practicing Dialectics of Science Today},
  journal = {Science \& Society: A Journal of Marxist Thought and Analysis},
  year = {2020},
  volume = {84},
  number = {3},
  pages = {369--400},
  doi = {10.1521/siso.2020.84.3.369},
  note = {
  CORE ARGUMENT: Examines Engels' engagement with 19th-century natural science (cell physiology, thermodynamics, evolution) and proposes that a dialectical materialist understanding of contemporary technoscience can be built on this foundation; uses synthetic cell biology as a case study for how Engelsian dialectics operates in current scientific practice.

  RELEVANCE: Tests Engels' philosophy of natural science against contemporary scientific developments, addressing directly whether dialectics of nature is scientifically credible or merely a 19th-century curiosity.

  POSITION: Constructive application of Engels' philosophy of science to contemporary technoscience.
  },
  keywords = {dialectics-of-nature, philosophy-of-science, biology, thermodynamics, Medium},
  abstract = {Friedrich Engels’ dialectical assessment of modern science resulted from his fascination with the natural sciences (cell physiology, thermodynamics, theory of evolution) in combination with his resurging interest in the work of “old Hegel.” Engels became especially interested in what he saw as the molecular essence of life, namely proteins or, more specifically, albumin (Eiweiß), seeing life as the mode of existence of these enigmatic substances. Hegelian dialectics is crucial for a dialectical materialist understanding of contemporary technoscience. The dialectical materialist understanding of technoscience as a research practice builds on Engels, but also on later (scientific) authors who were inspired by his writings, e.g., life scientists such as Haldane and Bernal. Considering the criticism raised against Engels’ dialectics by 20th-century Marxists, a dialectical diagnostic of contemporary technoscience can be achieved, which shifts the focus from artificial albumin as “living matter” (as discussed by Engels) to contemporary research on synthetic cells (as anticipated by Engels).},
  abstract_source = {s2},
}

@article{rodriguez2023kuhnian,
  author = {Rodr{\'i}guez Chiarini, Sebasti{\'a}n Mat{\'i}as},
  title = {Engels' Dialectics of Nature as an Attempt at Scientific Normalization: A Kuhnian Reading},
  journal = {Signos Filos{\'o}ficos},
  year = {2023},
  volume = {25},
  number = {50},
  pages = {42--61},
  doi = {10.24275/sfilo.v25n50.04},
  note = {
  CORE ARGUMENT: Reads Engels' efforts in Anti-Duhring and Dialectics of Nature through Kuhn's concept of a disciplinary matrix, arguing that Engels was attempting to crystallise a new scientific paradigm for Marxism, not merely applying existing dialectics to natural data.

  RELEVANCE: Offers a philosophy-of-science reading that reframes the question of whether Engels' naturalism is defensible: instead of asking whether the three laws are metaphysically correct, asks whether they constitute a productive scientific research programme.

  POSITION: Kuhnian interpretation, neither simply defending nor rejecting Engels' naturalism.
  },
  keywords = {dialectics-of-nature, philosophy-of-science, Kuhn, paradigm, Medium},
  abstract = {In this paper I study Engels’ ideas on dialectical materialism, from the per-spective of Thomas Kuhn’s philosophy of science. I argue that Engels’ efforts, in works such as Anti-Düring or (even more so) in his Dialectics of Nature, are best understood as an attempt to crystalize a new scientific paradigm, in the sense that Kuhn (2000) gives to this last word. In order to do this, I start by identifying Marx’s previous statement regarding this topic. Then I present Kuhn’s concept of a “disciplinary matrix”. Thirdly, I apply the aforementioned concept to Engels’ work, identifying all the elements of the disciplinary matrix.},
  abstract_source = {s2},
}

@article{barot2010sciences,
  author = {Barot, Emmanuel},
  title = {Sciences et dialectiques de la nature; La nature dans la pens\'ee dialectique},
  journal = {Historical Materialism},
  year = {2010},
  volume = {18},
  number = {2},
  pages = {143--164},
  doi = {10.1163/156920610x512499},
  note = {
  CORE ARGUMENT: Reviews Lucien Seve's edited collection on sciences and dialectics of nature and Eftichios Bitsakis' book on nature in dialectical thought; argues that Engels' dialectics of nature deserves rehabilitation from both Stalinist dogmatisation and Western Marxist dismissal, and that contemporary science offers resources for this.

  RELEVANCE: Provides a scholarly overview of the French-language debate on dialectics of nature, recovering positions that are often invisible in the Anglophone literature. Documents how the Stalinist dogmatisation of diamat made the entire project suspect even for sympathetic readers.

  POSITION: Rehabilitative, drawing on French Marxist philosophy of science tradition.
  },
  keywords = {dialectics-of-nature, French-Marxism, philosophy-of-science, reception, Medium},
  abstract = {Dialectics, especially Engels’s dialectics of nature, is nowadays mostly held in low esteem, even by Marxist scholars because of its Stalinist dogmatisation over the past century. The aim of this comparative review is to show some stakes and prospects, in Marxism and for Marxism, of the debate: the two reviewed books show how the dialectics of nature could, and why it should be considered in a renewed materialist approach to the natural sciences, and provides the reader with complementary outline from the cognitive sciences to physics, via mathematics.},
  abstract_source = {openalex},
}

@book{schmidt1962concept,
  author = {Schmidt, Alfred},
  title = {The Concept of Nature in Marx},
  year = {1962},
  note = {
  CORE ARGUMENT: Argues that Marx's concept of nature is a sui generis materialist naturalism -- neither idealist nor mechanically materialist -- grounded in the concept of social metabolism (Stoffwechsel) between humanity and nature through labour; explicitly distinguishes Marx's approach from Engels' naturalistic extension and from Naturphilosophie.

  RELEVANCE: Schmidt's Frankfurt School-influenced reading established the interpretive baseline from which Lukacs-inspired critics argued that Engels distorted Marx by extending dialectics to nature. Essential for understanding what is at stake in the Marx-Engels debate on nature-dialectics.

  POSITION: Western Marxist tradition; draws a sharp line between Marx's epistemologically sophisticated naturalism and Engels' reductive ontological extension.
  },
  keywords = {nature, Marx, Engels, metabolism, Western-Marxism, Frankfurt-School, High, INCOMPLETE, no-abstract}
}

@article{kuznetsov1971dialectics,
  author = {Kuznetsov, B. G.},
  title = {The Dialectics of Nature and Dialectics in Capital},
  journal = {Soviet Studies in Philosophy},
  year = {1971},
  volume = {10},
  number = {1},
  pages = {43--62},
  doi = {10.2753/rsp1061-1967100143},
  note = {
  CORE ARGUMENT: Argues for a deep connection between Engels' philosophical generalisation of natural science in Dialectics of Nature and the philosophical categories of Marx's Capital; proposes that the dialectics of nature is not an external appendage to historical materialism but its necessary ontological foundation.

  RELEVANCE: Represents the Soviet philosophical tradition's case for the internal unity of dialectical materialism, directly opposed to Western Marxist readings that treat Engels' naturalism as a category error. Relevant to the question of whether history's dialectic requires nature's dialectic.

  POSITION: Soviet dialectical materialist tradition; defends the continuity of dialectics across nature and history.
  },
  keywords = {dialectics-of-nature, Capital, Soviet-Marxism, dialectical-materialism, Low},
  abstract = {A vast literature has been devoted to the Dialectics of Nature and dialectics in Capital. There is a considerable number of works in which the connection between the philosophical generalization of natural science in the Dialectics of Nature and the philosophical aspects of the economic categories in Capital are analyzed. I should like to touch upon only one aspect of the problem — that aspect which pertains to certain new problems in philosophical and economic thought. Reference is, first, to the new, unprecedented role of philosophy and natural science in the period of the scientific and technological revolution under the conditions of the unification and planning of science and, second, to the unprecedented dynamism of the economy today. This dynamism requires a radical rethinking of categories, and that rethinking, in turn, requires a return to the fundamental categories of Capital.},
  abstract_source = {openalex},
}

@book{cohen1978kmth,
  author    = {Cohen, G. A.},
  title     = {Karl Marx's Theory of History: A Defence},
  year      = {1978},
  publisher = {Princeton University Press},
  doi       = {10.1515/9780691213002},
  note      = {
  CORE ARGUMENT: Cohen offers an analytic reconstruction of historical materialism centred on the primacy thesis -- that productive forces determine relations of production, which in turn determine the superstructure -- and defends functional explanation as the appropriate logical form for Marx's causal claims. The base-superstructure metaphor is made precise through a "rights-free" characterisation of productive relations as powers rather than normative statuses.

  RELEVANCE: Cohen's reconstruction is the standard reference point for assessing whether Engels's formulations in Anti-Duhring and the late letters faithfully represent the structure of Marx's theory. Where Engels appeals to "laws" of history and "dialectics of nature," Cohen's framework exposes what explanatory commitments those appeals entail and whether they are defensible.

  POSITION: Analytical Marxism; techno-functional primacy of productive forces.
  },
  keywords  = {historical-materialism, base-superstructure, functional-explanation, Cohen, High},
  abstract = {First published in 1978, this book rapidly established itself as a classic of modern Marxism. In this expanded edition Cohen offers his own account of the history, and the further promise, of analytical Marxism. He also expresses reservations about traditional historical materialism, in the light of which he reconstructs the theory.},
  abstract_source = {openalex},
}

@article{cohen1982functional,
  author  = {Cohen, G. A.},
  title   = {Functional Explanation, Consequence Explanation, and Marxism},
  journal = {Inquiry},
  year    = {1982},
  volume  = {25},
  number  = {1},
  pages   = {27--56},
  doi     = {10.1080/00201748208601953},
  note    = {
  CORE ARGUMENT: Cohen defends the coherence of functional explanation in Marxist historiography against Elster's critique that functional explanations without feedback mechanisms are merely "consequence laws" and explanatorily empty. He argues that the selectionist structure of Darwinian biology provides a viable analogy for functional claims in social theory.

  RELEVANCE: The debate with Elster bears directly on whether Engels's appeals to historical "laws of motion" can be given a rigorous interpretation, or whether they must be dismissed as positivist rhetoric. The article clarifies what analytical content the base-superstructure thesis could have.

  POSITION: Analytical Marxism; defence of functional explanation.
  },
  keywords  = {functional-explanation, historical-materialism, Cohen, Elster, High},
  abstract = {I argued in Karl Marx's Theory of History that the central claims of historical materialism are functional explanations, and I said that functional explanations are consequence explanations, ones, that is, in which something is explained by its propensity to have a certain kind of effect. I also claimed that the theory of chance variation and natural selection sustains functional explanations, and hence consequence explanations, of organismic equipment. In Section I I defend the thesis that historical materialism offers functional or consequence explanations, and I reject Jon Elster's contention that game theory can, and should, assume a central role in the Marxist theory of society. In Section II I contrast functional and consequence explanation, thereby revising the position of Karl Marx's Theory of History, and I question whether evolutionary biology supports functional explanations. Section III is a critique of Elster's views on functional explanation, and Sections IV and V defend consequence explanation against metaphysical and epistemological doubts. A concluding section summarizes my present understanding of the status of historical materialist explanations.},
  abstract_source = {openalex},
}

@article{elster1980cohen,
  author  = {Elster, Jon},
  title   = {Cohen on Marx's Theory of History},
  journal = {Political Studies},
  year    = {1980},
  volume  = {28},
  number  = {1},
  pages   = {121--128},
  doi     = {10.1111/j.1467-9248.1980.tb01239.x},
  note    = {
  CORE ARGUMENT: Elster argues that Cohen's functional explanations in Karl Marx's Theory of History are logically defective unless backed by explicit feedback mechanisms, which Marx's and Engels's texts do not supply. Without such mechanisms, functional explanation collapses into mere consequence-explanation, which is not genuine explanation.

  RELEVANCE: Elster's critique applies with equal force to Engels's own invocations of historical "necessity" and "dialectical laws": both rely on unexplained functional connections between base and superstructure. This exchange is the critical testing ground for assessing the explanatory rigour of Engels's formulations.

  POSITION: Methodological individualism; against functional explanation in social science.
  },
  keywords = {functional-explanation, historical-materialism, Elster, Cohen, High, INCOMPLETE, no-abstract}
}

@article{cohen1980reply,
  author  = {Cohen, G. A.},
  title   = {Functional Explanation: Reply to Elster},
  journal = {Political Studies},
  year    = {1980},
  volume  = {28},
  number  = {1},
  pages   = {129--135},
  doi     = {10.1111/j.1467-9248.1980.tb01240.x},
  note    = {
  CORE ARGUMENT: Cohen responds to Elster's challenge by insisting that functional explanation is legitimate even without specified micro-mechanisms, provided that the relevant tendencies are real and stable. He draws on selectionist analogy to defend the claim that social forms persist because they serve productive development.

  RELEVANCE: Together with Elster (1980), this exchange demarcates the analytical question that any assessment of Engels's "scientific socialism" must address: whether the historical generalizations Engels offers have the form of genuine explanations or of ideological narrative.

  POSITION: Analytical Marxism; defended functional primacy.
  },
  keywords = {functional-explanation, historical-materialism, Cohen, High, INCOMPLETE, no-abstract}
}

@book{carver2003engels,
  author    = {Carver, Terrell},
  title     = {Engels},
  year      = {2003},
  publisher = {Oxford University Press},
  doi       = {10.1093/actrade/9780192804662.001.0001},
  note      = {
  CORE ARGUMENT: Carver's short intellectual biography of Engels reads him as a significant thinker in his own right whose philosophical commitments -- especially the positivist framing of Marxism as "scientific socialism" and the dialectics of nature programme -- constituted a distinct, not always compatible, tradition alongside Marx's own work. The chapter "Engels and Marxism" argues directly that Engels shaped the reception of historical materialism in ways Marx did not intend.

  RELEVANCE: This book offers the most accessible systematic statement of Carver's lifelong argument about Engels's role in determining how historical materialism was understood: it directly addresses the base-superstructure model, the 1859 Preface's interpretation, and the late letters on "economic factors in the last instance."

  POSITION: Engels-divergence thesis; intellectual biography approach.
  },
  keywords  = {Engels-biography, historical-materialism, Marx-Engels-divergence, Carver, High},
  abstract = {Abstract Engels: A Very Short Introduction examines the man who invented Marxism. Engels' work did more than Marx to make converts to the most influential political movement of modern times. He was not only the father of dialectical and historical materialism (the official philosophies of history and science in many communist countries), he was also the first Marxist historian, anthropologist, philosopher, and commentator on early Marx. In his later years, Engels developed his materialist interpretation of history, his chief intellectual legacy. This VSI traces its source and its effect on the development of Marxist theory and practice, assesses its utility, and discusses the difficulties which Marxists have encountered in defending it.},
  abstract_source = {openalex},
}

@book{thomas2008marxism,
  author    = {Thomas, Paul},
  title     = {Marxism \& Scientific Socialism: From Engels to Althusser},
  year      = {2008},
  publisher = {Routledge},
  doi       = {10.4324/9780203927311},
  note      = {
  CORE ARGUMENT: Thomas traces the concept of "scientific socialism" from Engels's Anti-Duhring and Socialism: Utopian and Scientific through Kautsky, Plekhanov, and Lenin to Althusser, arguing that the scientistic framing Engels imposed on Marxism -- treating history as governed by discoverable laws on the model of natural science -- created a positivist tradition that distorted Marx's own epistemological intentions.

  RELEVANCE: This is the most direct book-length treatment of the core question in this domain: whether "scientific socialism" as Engels formulated it is a faithful systematization or a positivist reduction of Marx. Thomas explicitly engages the 1859 Preface, the base-superstructure metaphor, and the role of human agency.

  POSITION: Critical history of Engelsian positivism; anti-scientistic reading of Marx.
  },
  keywords  = {scientific-socialism, Engels-positivism, Althusser, historical-materialism, High},
  abstract = {Engels declared at Marx’s funeral in Highgate Cemetery that "just as Darwin discovered the law of development of organic nature, so Marx discovered the law of development of human history". Scientific socialism was the term Engels used to describe Marx's socio-economic philosophy and many later theorists sought to reinforce Marxist theory with a supposedly scientific basis. This book explains the development of the idea of scientific socialism through the 19th and 20th century from its origins in Engels to its last manifestation in the work of Althusser. It provides a detailed analysis of Engel's own conceptualisation, the impact of Darwin, the relationship to the 'official' historical materialism of the Soviet states and later reformulations by Althusser and others. In so doing it provides a vivid intellectual history of Marxist and socialist thought, exploring its significant insights as well its manifest failures. Marxism and Scientific Socialism will be of particular interest to those with an interest in the development of Marxism and socialism, political ideologies and the history of Western political thought.},
  abstract_source = {openalex},
}

@book{rigby1992engels,
  author    = {Rigby, S. H.},
  title     = {Engels and the Formation of Marxism: History, Dialectics and Revolution},
  year      = {1992},
  publisher = {Manchester University Press},
  note      = {
  CORE ARGUMENT: Rigby offers a detailed examination of Engels's philosophical and historical writings and argues against the "Engels problem" thesis that Engels substantially distorted Marx. While acknowledging divergences in emphasis and formulation, Rigby maintains that Engels and Marx shared broadly the same theoretical framework on the major issues: the primacy of productive forces, the base-superstructure model, and the dialectical method.

  RELEVANCE: Rigby represents the most sustained scholarly challenge to the Carver-Levine line of argument and provides the most detailed defence of Engels's historical materialism as a coherent, internally consistent theory. Essential for understanding the full scope of the Engels-Marx comparison debate.

  POSITION: Continuity thesis; defence of Engels's coherence as a Marxist thinker.
  },
  keywords = {Engels-Marx-continuity, historical-materialism, dialectics, Rigby, High},
  abstract = {Although Michel Foucault’s philosophical writings from beginning to end focused on deeply epistemological questions about knowledge and science, his ideas remain almost entirely absent from epistemological debates in the English-speaking world. No doubt this is due to his style, not a linguistic style but what Ian Hacking calls style of reasoning, by which he means to invoke the kinds of differences that occur between aesthetic styles and relate these to differences in scientific inquiry. In short, Foucault’s work on knowledge is not easily translatable into the more familiar problematizations of epistemology. The best attempts thus far at such philosophical translations of Foucault have been in Ian Hacking’s and Gary Gutting’s work, though Hacking can be frustratingly elusive on the core topics of justification, truth and reference and Gutting’s interpretations do not reach the stage at which Foucault developed his notion of power/knowledge, one of his most well-known, interesting, and difficult concepts.
  abstract_source = {ndpr},

In the last several years, Arnold Davidson has been filling this gap by developing an interpretive account and application of Foucault’s work on knowledge and science (as well as of Canguilhem and Bachelard’s), and these essays, together with some new ones, are now usefully collected inThe Emergence of Sexuality: Historical Epistemology and the Formation of Concepts. To be sure, this collection reaches beyond Foucault--Davidson’s own original analyses are also evident here--and his interpretation of Foucault as an epistemologist of sorts is itself original and provocative, and will no doubt raise the ire of those who would place Foucault in more of a postmodernist camp. But Davidson’s demonstration of the utility of Foucault for a host of ongoing debates in psychology, psychoanalysis, historiography as well as epistemology is persuasive and amply developed in several fascinating examples.

Historical epistemology, as Davidson develops it, is not simply doing a history of epistemology, though there is some of that, but primarily an epistemological analysis of the history of knowledges, not just with an eye toward assessing truth but more so with assessing how some things, and not others, become candidates for truth-value. Analytic epistemologists generally portray this kind of project as outside the domain of epistemology proper, unless one is offering a judgement about the epistemic viability, in today’s terms, of prior modes of knowing. If epistemology is defined as the pursuit of justification and truth, history holds no intrinsic interest. What is most valuable in this book is Davidson’s insistence that a concern with the history of concepts and with the variable ways in which statements are made candidates for truth-value should not be seen as extra-epistemic issues, or as mere sociology or ideology-critique. The pursuit of truth will be enhanced if we come to a better understanding of how the domains of knowledge emerge, are delimited, and constrained by the peculiar ways in which concepts are formed in different historical moments.

For example, Davidson shows in a fascinating chapter on sex (with pictures) that, before the last hundred and fifty years, anatomy was exhaustive of sexuality. That is, one could not fathom the idea, so commonplace today, of a person being anatomically one sex and psychologically another. The very concept of the homosexual requires this distinction, which is why we should not import current ideas of homosexuality to the past. This claim was made by Foucault, but Davidson makes an even stronger case for it through his studies of the representations of Christ’s sex (not, he argues, his sexuality, a category that did not exist), and through his detailed studies of the development of psychiatric reasoning. One way to explain the latter development, and one which could be misleadingly taken from Foucault himself, is that psychiatry appropriated for itself a domain of judgement and diagnosis previously accorded to the morality of the church. Instead, psychiatry emerged from the possibility of conceptualizing a sexual subjectivity and “mental individuality,” to quote Krafft-Ebing (63), that constituted types of persons above and beyond their physical morphology.

Whether the question of truth is related to such historical studies depends on how they illuminate the question of reference. Is the distinction between anatomy and sexuality a contemporary illusion, or a fact about human experience that was recently discovered? One of the laudable features of Davidson’s work is that he shows how we must complicate such questions, but that such complications are not ways to avoid questions about the referentiality of science’s claims. The complication is that the concepts can affect and even produce experiences, in this case, experiences of sexuality, which then have an effect on our practices, perceptions, and the perceptions that others have of us, all of which create the “feedback loop” peculiar to the human sciences that Hacking calls “dynamic nominalism.” The referentiality of medical or psychiatric terms is thus historically delimited; hence the importance of history.

Foucault was no idealist, nor did he effectively reduce the production of scientific concepts and categories to the operations of social interest. For this reason, Davidson says, against Hacking on this point, “I find the label ’social construction’ utterly inappropriate …”(xiii). This is apparently because Davidson fears that the idea of social construction conveys the relativist definition of truth as ideology, and leads people to believe that the work of historical epistemologists such as his own and Foucault’s requires rejecting the traditional attempt to uncover what was really happening in the past, or rejecting any objectivist account of how the best practices of science validate their claims. It would be interesting to hear what he has to say about Hacking’s recently publishedThe Social Construction of What?, which artfully unpacks the variable possible meanings of the idea of social construction and demonstrates that they do not all entail wholesale repudiations of realism in any form. Davidson does not explain or pursue the debates over social construction, other than to align it with a view that would eschew epistemology altogether.

Like Rorty, Putnam and other contemporary pragmatists, Davidson dismisses the “absolutist/relativist distinction” outright, but not for the reasons they give. Pragmatists generally point to the unintelligibility of the distinction, and repudiate any need to address charges of relativism since this would require a philosophical elaboration of truth and reference that is entirely unnecessary and results from a kind of category mistake. Davidson’s approach here should be much more persuasive, or at least more interesting, to those who find the pragmatist ridicule for concerns with ontology as overly glib.

In several essays, but especially in the essay that addresses the idea of evidence as developed by Carlo Ginzburg, Davidson argues that the more relevant distinction than absolutism/relativism is that between conditions of validity and conditions of possibility. Conditions of validity involve those bread-and-butter issues about which epistemologists and methodologists of the social sciences are most familiar, issues involving evidence, proof, the criteria of justification, and truth. Conditions of possibility, by contrast, are concerned with a different level of the knowledge-generating process, the level at which statements become formalizable as candidates for truth. Thus, it is not that those who are concerned with the conditions of possibility, such as Foucault, are discrediting the concern with conditions of validity, as the charge of relativism would imply, but that they are focused on a different arena.},
}

@book{rigby2024engels,
  author    = {Rigby, S. H.},
  title     = {Engels and the Formation of Marxism},
  year      = {2024},
  publisher = {Manchester University Press},
  doi       = {10.7765/9781526184191},
  note      = {
  CORE ARGUMENT: A revised and updated edition of Rigby's 1992 study, incorporating subsequent scholarship and responding to critiques. The book continues to defend the substantial coherence of Engels's historical materialism with Marx's framework, while addressing newer work on the Engels-problem by Carver and others.

  RELEVANCE: The 2024 edition makes Rigby's continuity thesis directly available to contemporary debate, including responses to post-1992 literature on Engels's agency theory, the late letters, and the Althusserian tradition.

  POSITION: Continuity thesis; updated scholarly defence of Engels.
  },
  keywords  = {Engels-Marx-continuity, historical-materialism, Rigby, Medium},
  abstract = {Engels is perhaps the most neglected, and certainly the most unfashionable, of the major socialist thinkers. Yet many of the most problematical aspects of Marxist theory, such as dialectics, materialism, base and superstructure, scientific socialism and gender, are dealt with most explicitly in the classic texts of Marxism by Engels rather than by Marx himself. This book intends to assess Engels' contribution to the genesis of Marxism in the period before 1848; to ask how far Engels departed from this paradigm in the years after 1848; and to examine the degree to which Marx himself shared Engels' intellectual trajectory. Engels has been seen as the founder of an anti-empirical Marxism based on a priori laws of matter, and also as a brilliant historian whose intellectual strength lay in empirical studies, and who demanded that all history be studied afresh rather than being compressed into some ready-made schema. One alternative to merely emphasising the differences of opinion between Marx and Engels would be to show that, although the two men differed in their views on philosophy and the natural sciences, their ideas on social theory and history were 'virtually identical'. The book argues that attempts to counterpose the views of Marx and Engels are essentially a strategy designed to forestall a confrontation with the problems which lie within Marx's works themselves.},
  abstract_source = {openalex},
}

@article{berger1977disentangling,
  author  = {Berger, Martin},
  title   = {Disentangling Engels from Marxandengels},
  journal = {International Labor and Working-Class History},
