    note = "CORE ARGUMENT: Wolff, Why Read Marx Today? (2002), a short book arguing that Marx still has something to say to us after the failure of Marxist regimes. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, introduction, philosophy, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Abstract In recent years we could be forgiven for assuming that Marx has nothing left to say to us. Marxist regimes have failed miserably, and with them, it seemed, all reason to take Marx seriously. The fall of the Berlin Wall had enormous symbolic resonance: it was taken to be the fall of Marx as well as of Marxist politics and economics. This book argues that we can detach Marx the critic of current society from Marx the prophet of future society, and that he remains the most impressive critic we have of liberal, capitalist, bourgeois society. It also shows that the value of the 'great thinkers' does not depend on their views being true, but on other features such as their originality, insight, and systematic vision. On this account too Marx still richly deserves to be read.",
    abstract_source = "openalex"
}

@article{sayers2003alienation,
    author = "Sayers, Sean",
    title = "Creative Activity and Alienation in Hegel and Marx",
    journal = "Historical Materialism",
    year = "2003",
    volume = "11",
    note = "CORE ARGUMENT: Sayers (2003) compares Hegel's and Marx's accounts of creative activity and alienation, developing a Hegelian reading of Marx's theory. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, alienation, hegel, creative-activity, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "This article sheds important new light on the philosophical assumptions about human nature in Marx's account of alienation. The key to understanding these lies in Hegel's philosophy. This paper explains Hegel's account of the role of labour in human development and shows how it underlies Marx's theory. The paper focuses particularly on Hegel's Aesthetics and demonstrates that this work contains crucial but hitherto neglected material on this topic. It then goes on to discuss how Marx's views differ from Hegel's, and to criticise Arendt.",
    abstract_source = "openalex"
