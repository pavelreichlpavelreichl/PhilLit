@article{bryan1990natural,
    author = "Bryan, Dick",
    title = {"Natural" and "Improved" Land in Marx's Theory of Rent},
    journal = "Land Economics",
    year = "1990",
    volume = "66",
    doi = "10.2307/3146367",
    note = "CORE ARGUMENT: Examines how Marx's value theory handles land and natural resources, arguing that his treatment of 'natural' versus 'improved' land in the theory of rent is difficult to reconcile with a labour-based account of value. MARX-CENTRALITY: Title and main topic: Marx's theory of rent (Capital vol. III).",
    keywords = "rent, value-theory, ground-rent, Medium, METADATA\\_CLEANED: number, pages",
    abstract = "Marxian value theory has always had some difficulty with incorporating the products of nature into the calculation of value. Right at the start of Capital, Marx ([1894] 1976) insists that it is not the purpose of his theory to explain the contribution of all phenomena to the value of output. This may be satisfactory as a general proposition of the objectives of Marxian value analysis, but it faces difficulty in the understanding of ground rent, for here the relationship between natural and (human) phenomena must be addressed directly. It is not sufficient to isolate nature as outside the value sphere. Specifically, the question must be posed: how, within Marxist theory, do we understand the relationship between and produced attributes of land; for example, how do we compare the contribution of a man-made dam and a naturally occurring dam to the value of output produced on land?",
    abstract_source = "openalex"
}

@article{murray1991respecifying,
    author = "Murray, E.G. Smith",
    title = "Respecifying Marx’s Value Categories: A Theoretical and Empirical Reconsideration of the “Law of the Falling Rate of Profit”",
    journal = "Studies in Political Economy",
    year = "1991",
    volume = "35",
    pages = "155--190",
    doi = "10.1080/19187033.1991.11675456",
    note = "CORE ARGUMENT: Reconsiders Marx's law of the falling rate of profit theoretically and empirically, proposing a respecification of Marx's value categories for measuring profitability in North American capitalism. MARX-CENTRALITY: Title: Marx's value categories and the law of the falling rate of profit; Marx's own categories are the object of reconstruction.",
    keywords = "falling-rate-of-profit, value-categories, measurement, Medium, METADATA\\_CLEANED: number",
    abstract = "Despite the much-touted prosperity (read, positive annual growth rates) of the US and Canadian economies between 1983 and 1989, the argument can be made that North American capitalism has experienced a long-term malaise over the past twenty years, a malaise which shows little sign of lifting any time soon. Slow growth rates, high unemployment levels, three severe recessions, burgeoning debt and the decline of the traditional rust-belt industries have been prominent features of what has been described as a structural crisis of North American capitalism.",
    abstract_source = "openalex"
}

@misc{lapides1992henryk,
    author = "Lapides, Kenneth",
    title = "Henryk Grossmann and the Debate on the Theoretical Status of Marx's Capital",
    year = "1992",
    volume = "56",
    pages = "133--162",
    doi = "10.1177/003682379205600202",
    note = "CORE ARGUMENT: Reconstructs Henryk Grossmann's argument on whether Capital is Marx's complete economics or a fragment of the larger six-book plan, in particular the alleged missing 'book on wage-labour'. MARX-CENTRALITY: Title and main topic: the theoretical status and plan of Capital.",
    keywords = "capital-structure, plan-of-capital, wage-labour, Medium, METADATA\\_CLEANED: journal, number, type:@article->@misc",
    abstract = {Scholars have long debated whether Capital represents Marx's complete "economics" or whether it is a fragment of a more broadly conceived project. In particular, some writers have alleged there is a missing "Book on Wage-Labor" that Marx intended to write and consequently that his wage theory is incomplete, while others have contested this. This question was first and most thoroughly examined by Henryk Grossmann in his 1929 article, "Die “nderung des ursprunglichen Aufbauplans des Marxschen Kapital und ihre Ursachen" ("The Change in the Original Plan of Composition of Marx's Capital and its Causes"). Lengthy extracts from this hitherto untranslated article, in which Grossmann argues that Capital (in its four volumes) is essentially complete, are presented. In addition, passages from Marx's correspondence bearing on his intentions with regard to his project are cited in their entirety. It is demonstrated that Capital is not a fragment but represents Marx's complete analysis.},
    abstract_source = "s2"
}

@article{lianos1992price,
    author = "Lianos, Theodore P. and Droucopoulos, Vassilis",
    title = "Price Determination in Chapter X of Volume III of Marx's Capital",
    journal = "Review of Radical Political Economics",
    year = "1992",
    volume = "24",
    doi = "10.1177/048661349202400105",
    note = "CORE ARGUMENT: Argues that Marx's concepts of individual value, market value, market price and price of production in Capital III ch. 10 can be assembled into a unified theory of price determination under competition. MARX-CENTRALITY: Title and main topic: Marx's Capital vol. III, chapter X.",
    keywords = "price-theory, capital-vol-3, market-value, Medium, METADATA\\_CLEANED: number, pages",
    abstract = "The argument of this paper is that, despite claims to the contrary, Marx provided the theoretical underpinnings necessary for the construction of a model of price determination. The paper shows how under competitive conditions the Marxian concepts of individual value, market value, market price, and price of production can become parts of a unified theory of price determination.",
    abstract_source = "openalex"
}

@misc{saadfilho1993note,
    author = "Saad-Filho, Alfredo",
    title = "A Note on Marx's Analysis of the Composition of Capital",
    year = "1993",
    volume = "17",
    pages = "127--146",
    doi = "10.1177/030981689305000106",
    note = "CORE ARGUMENT: Distinguishes technical, value and organic compositions of capital in Marx and shows that the distinctions trace to the relation between production and circulation, arguing this matters for accumulation and technical change under the labour theory of value. MARX-CENTRALITY: Title: Marx's analysis of the composition of capital.",
