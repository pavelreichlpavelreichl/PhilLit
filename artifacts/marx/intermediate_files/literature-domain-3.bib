@misc{fluxman1993rights,
    author = "Fluxman, Tony",
    title = "Marx, socialism, and rights",
    year = "1993",
    volume = "20",
    note = "CORE ARGUMENT: Examines Marx's claim that socialism need not rely on a framework of rights and argues that this strategy fails because rights are necessary for individual autonomy. MARX-CENTRALITY: Title and main topic: Marx on rights and socialism.",
    keywords = "marx-since-1990, domain3, 1990s, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This paper examines Marx's claim that socialism need not rely on a framework of rights. It is argued that this strategy fails because rights are necessary for individual autonomy. A framework of rights helps to ensure that in principle individuals can choose life plans freely. Nonetheless, Marx is right to stress that economic democracy is also a condition of individual autonomy. Finally, it is suggested that a commitment to both individual rights and economic democracy will provide a suitable framework for both pluralism and social solidarity.",
    abstract_source = "openalex"
}

@misc{corlett1994rights,
    author = "Corlett, J. Angelo",
    title = "Marx and Rights",
    year = "1994",
    volume = "33",
    note = "CORE ARGUMENT: Asks whether there is room for rights in Marx's social philosophy, against the view that Marxism, unlike liberalism, cannot respect rights. MARX-CENTRALITY: Title and main topic: Marx and rights.",
    keywords = "marx-since-1990, domain3, 1990s, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "It is often either assumed or argued that political liberalism respects rights, while Marxism does not. In fact, many believe that the omission of rights in communism counts decisively against the viability of Karl Marx's social philosophy. Is there room for rights in Marx's social philosophy? This paper examines Allen E. Buchanan's interpretation of Marx's critique of rights. Contrary to Buchanan's view, I shall argue that Marx's critique of rights is limited rather than comprehensive in scope. I shall also set forth part of a foundation of a Marxian theory of rights.",
    abstract_source = "openalex"
}

@misc{cahan1994property,
    author = "Cahan, Jean Axelrad",
    title = "The Concept of Property in Marx's Theory of History: A Defense of the Autonomy of the Socioeconomic Base",
    year = "1994",
    volume = "58",
    note = "CORE ARGUMENT: Argues that the concept of property, which appears in both base and superstructure in Marx's schema, can be used to defend the autonomy of the socioeconomic base in Marx's theory of history. MARX-CENTRALITY: Title: Marx's theory of history (property concept) is the main topic.",
    keywords = "marx-since-1990, domain3, 1990s, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This paper seeks a new perspective on a long-standing ambiguity in historical materialism. The term “property,” its apparent inclusion in both the economic base and the politicolegal superstructure in Marx's schema, and the consequent difficulty of asserting a causal connection between base and superstructure, are seen as deriving from intellectual influences on the young Marx. These influences conveyed certain central ideas from the history of Roman law and its treatment of property. Some implications for Marxist theory are considered.",
    abstract_source = "s2"
}

