@misc{panichas1990revolutionary,
    author = "Panichas, George E. and Hobart, Michael E.",
    title = "Marx's Theory of Revolutionary Change",
    year = "1990",
    volume = "20",
    note = "CORE ARGUMENT: Discusses Marx's account of revolutionary change as part of the reconsideration of historical materialism launched by G. A. Cohen's Karl Marx's Theory of History. MARX-CENTRALITY: Title and main topic: Marx's theory of revolutionary change.",
