@misc{nimtz1999democratic,
    author = "Nimtz, August",
    title = "Marx and Engels - the Unsung Heroes of the Democratic Breakthrough",
    year = "1999",
    volume = "63",
    note = "CORE ARGUMENT: Argues that Marx and Engels contributed decisively to the political self-organisation of the European working class and thus to the democratic breakthrough. MARX-CENTRALITY: Title and main topic: Marx and Engels's political practice and democracy.",
    keywords = "marx-since-1990, domain3, 1990s, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Rueschemeyer, Stephens and Stephens (1992) convincingly argue that the organized working class was crucial in the democratic breakthrough at the end of the 19th century. What's missing in their overly structural account is the role of agency. No two individuals contributed more to the political selforganization of Europe's workers than Marx and Engels. Hence, they made a decisive contribution to the democratic breakthrough, one that was not inadvertent but purposive. They could play such a role because, contrary to the usual portraits of them, they were first and foremost political activists who carried on a ceaseless effort within the workers' movement to realize their political perspective. Through their activities in the International Working Men's Association and the German workers' movement they planted the seeds for independent working-class political action - the key lesson they drew from their participation in the 1848 revolutions and the mass working-class parties that followed in their wake.",
    abstract_source = "s2"
}

