@misc{li2026law,
    author = "Li, Yawei and Huato, Julio",
    title = "Marx’s Law of the Tendency of the Profit Rate to Fall: A Re-Examination",
    year = "2026",
    doi = "10.1177/00368237261459020",
    note = "CORE ARGUMENT: Defends the logical core of Marx's law of the falling profit rate: rising capital composition with constant rate of surplus value yields a falling rate. MARX-CENTRALITY: Title: Marx's law.",
    keywords = "falling-rate-of-profit, logical-reexamination, High, METADATA\\_CLEANED: journal, type:@article->@misc",
    abstract = "abstract\\_source = {s2}, Marx’s law of the tendency of the profit rate to fall, formulated in Capital Volume III, is central to his critique of capital. A logical re-examination defends his core claim — that rising capital composition (reflecting mechanization and productivity growth) coexisting with a constant rate of surplus value necessarily yields a declining general profit rate. The claim holds when real wages rise proportionally with labor productivity — a historical possibility contingent on working-class organized strength. Not only Marx’s law holds under constant exploitation, but it extends to more general conditions: even when exploitation rises, profit rates fall if capital composition growth outpaces exploitation growth (assuming stable variable-capital turnover). Turnover slowdowns exert additional downward pressure. These relations highlight the law as expressing the tendency of capital to revolutionize the productive forces of labor while subordinating them to surplus valorization imperatives. An Appendix presents the mathematical formalization as well as an illustrative decomposition of global profit-rate trends using macroeconomic data. While not an empirical test, the illustrative exercise demonstrates the law’s analytical value for interpreting historical profitability tendencies. The analysis reaffirms the internal coherence of Marx’s proposition against criticisms questioning its foundational logic."
}

@misc{murdaco2026socialism,
    author = "Murdaco, Barry",
    title = "Socialism or state capitalism? The transformation problem and the theoretical defense of Chinese “socialism”",
    year = "2026",
    doi = "10.1177/03098168261459987",
    note = "CORE ARGUMENT: Revisits the transformation problem, criticising Sraffian defences of Chinese socialism and drawing on Moseley's critique of simultaneist approaches. MARX-CENTRALITY: Title: transformation problem in Marx's theory.",
    keywords = "transformation-problem, China, Sraffian, Medium, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "This essay revisits the transformation problem in Marxist economics and its implications for contemporary Sraffian defenses of “Chinese socialism” that separate profit from exploitation. It critiques Sraffian-derived interpretations of the transformation problem—drawing on Moseley’s extensive criticisms of simultaneist approaches—showing how such frameworks undermine Marx’s value theory. The essay then compares Moseley’s macro-monetary interpretation with the Temporal Single-System Interpretation (TSSI). While both reject simultaneism and treat values and prices as components of a single system, the TSSI preserves Marx’s temporal determination of value by valuing inputs at prices prevailing when production begins and outputs at current prices. This temporal logic resolves the alleged internal inconsistencies in Marx’s theory and clarifies the link between exploitation and profit.",
    abstract_source = "s2"
}
