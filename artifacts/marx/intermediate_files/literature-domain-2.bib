@misc{fleetwood2001what,
    author = "Fleetwood, Steve",
    title = "What Kind of Theory is Marx's Labour Theory of Value? A Critical Realist Inquiry",
    year = "2001",
    volume = "25",
    pages = "41--77",
    doi = "10.1177/030981680107300104",
    note = "CORE ARGUMENT: Uses critical realism to argue that Marx's labour theory of value should be understood as a causal-explanatory rather than deductivist theory, so that quantitative reconstructions lose explanatory power. MARX-CENTRALITY: Title: Marx's labour theory of value; methodological interpretation.",
    keywords = "labour-theory-of-value, critical-realism, method, Medium, METADATA\\_CLEANED: number, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "This paper uses critical realism to reflect upon the issue of theory in Marx's Labour Theory of Value (LTV). Like any theory, the LTV is rooted in a mode of theorisation. Rooting the LTV in an inappropriate (deductivist) mode of theorisation encourages the formulation of (quantitative) versions of the LTV that (a) have severe problems and (b) lack explanatory power. Conversely, rooting the LTV in an appropriate (causal-explanatory) mode encourages the formulation of (qualitative) versions of the LTV that (a) lack such problems and (b) have explanatory power.",
    abstract_source = "s2"
}

