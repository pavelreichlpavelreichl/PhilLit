@misc{cockshott1998does,
    author = "Cockshott, Paul and Cottrell, Allin",
    title = "Does Marx Need to Transform?",
    year = "1998",
    pages = "70--85",
    note = "CORE ARGUMENT: Argues that Marx did not need to transform values into prices of production, challenging the assumption behind the transformation-problem literature that equalised profit rates were the right target of Capital III part 2. MARX-CENTRALITY: Title: 'Does Marx need to transform?'; on the transformation problem in Marx's own theory.",
    keywords = "transformation-problem, prices-of-production, labour-values, High, METADATA\\_CLEANED: booktitle, publisher, type:@incollection->@misc, METADATA\_CLEANED: doi",
    abstract = "Almost all of the voluminous literature on the Marxian ‘transformation problem’ is predicated on the assumption that, whether or not he succeeded, what Marx was trying to do in part 2, volume III of Capital — namely to derive a set of prices consistent with the equalisation of the rate of profit across all capitals — was correct. Those neo-Ricardians who argue that there is really no transformation problem as such (on the ground that labour values are theoretically redundant — see Steedman, 1977) most emphatically share this assumption. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

