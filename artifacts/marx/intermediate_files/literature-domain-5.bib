@misc{gailey2003community,
    author = "Gailey, Christine Ward",
    title = {Community, State and Questions of Social Evolution in Marx's "Ethnological Notebooks"},
    year = "2003",
    volume = "45",
    note = "Argues that after Capital Marx turned in the Ethnological Notebooks to class and state formation in precapitalist contexts and to conflicts between producer communities and state bureaucracies, abandoning state-dependent evolutionary theory (from the French-language abstract). MARX-CENTRALITY: Title and main topic: Marx's Ethnological Notebooks.",
