@misc{weyher2012humannature,
    author = "Weyher, L. Frank",
    title = "Re-Reading Sociology via the Emotions: Karl Marx's Theory of Human Nature and Estrangement",
    year = "2012",
    volume = "55",
    note = "CORE ARGUMENT: Weyher (2012) rereads Marx's theory of human nature and estrangement as a resource for the sociology of emotions. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, human-nature, alienation, emotions, Low, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Marx's conception of human nature includes human “passions” and “emotions” as fundamental, integrative aspects of our social nature and our human capacity for “free conscious activity.” However, “emotion” has been largely excluded from the sociological lexicon and the capacity for conscious action has often been viewed at the level of the individual actor and, moreover, in overly “cognitive” and “rational” terms. As a result, the very reading of classic texts has been historically biased against the seeing of emotion, even when it is addressed. What difference does the inclusion of emotion in Marx's conception of human nature make for our understanding of both his theory of estrangement and related work today?",
    abstract_source = "openalex"
}

@misc{balibar2012anthropology,
    author = "Balibar, Étienne",
    title = "From Philosophical Anthropology to Social Ontology and Back: What to Do with Marx's Sixth Thesis on Feuerbach?",
    year = "2012",
    volume = "22",
    note = "CORE ARGUMENT: Balibar (2012) considers what to do with Marx's Sixth Thesis on Feuerbach, discussing the move between philosophical anthropology and social ontology. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, anthropology, ontology, theses-on-feuerbach, Medium, METADATA\_CLEANED: journal, number, doi, type:@article->@misc",
    abstract = {This essay is based on a reading of Marx's Theses on Feuerbach from 1845, especially Thesis 6 , which discusses its wording with reference to signifying chains tracing back to the constitution of Western Metaphysics. The claim that "the human essence is not an abstract being inhabiting the singular individual" not only rejects post-Aristotelian metaphysics, but also theologies of the interpellation of the subject. Saying that "in its reality it is the ensemble of the social relations" opens the possibility of a multifaceted ontology of relations. Further, it identifies a weakness in Marx's assessment of Feuerbach's philosophy of the "generic being." It is on this basis that applications to contemporary debates on philosophical anthropology should be reformulated.},
    abstract_source = "openalex"
}

@article{czank2012speciesbeing,
    author = "Czank, James M.",
    title = "On the Origin of Species-Being: Marx Redefined",
    journal = "Rethinking Marxism",
    year = "2012",
    volume = "24",
    note = "CORE ARGUMENT: Czank (2012) discusses the origin of Marx's concept of species-being and proposes a redefinition. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, species-being, Low, METADATA\_CLEANED: number, pages, doi",
    abstract = "I once ran a search on Karl Marx's concept of species-being; it was described by contemporary authors as a principle of social cooperation, techno-scientific competency, and awareness, a tenet of species-centrism and anthropocentrism, and a surreptitious project of imagining the other ethical subject. I found this curious for a concept that Marx himself described as constitutive essence, as the human power that alters our ecologically embedded existence, and as the emergent and engendering attribute of human life. What the search left me with, then, is the opinion that contemporary social, political, and philosophical circles have failed to provide an articulate, clear, and historically accurate depiction of species-being. My aim in this paper is to work primarily from the Economic and Philosophic Manuscripts to unpack and situate the concept of species-being, all the while striving to maintain the integrity and context of what I take to be Marx's intentions.",
    abstract_source = "openalex"
}

@article{chitty2013hegel,
    author = "Chitty, Andrew",
    title = "Recognition and Property in Hegel and the Early Marx",
    journal = "Ethical Theory and Moral Practice",
    year = "2013",
    volume = "16",
    note = "CORE ARGUMENT: Chitty (2013) argues that Hegel's account of property as expressing mutual recognition of free persons is carried over into the 1844 Marx's exposition of communist society. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, hegel, property, recognition, early-marx, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "This article attempts to show, first, that for Hegel the role of property is to enable persons both to objectify their freedom and to properly express their recognition of each other as free, and second, that the Marx of 1844 uses fundamentally similar ideas in his exposition of communist society. For him the role of ‘true property’ is to enable individuals both to objectify their essential human powers and their individuality, and to express their recognition of each other as fellow human beings with needs, or their ‘human recognition’. Marx further uses these ideas to condemn the society of private property and market exchange as characterised by ‘estranged’ forms of property and recognition. He therefore uses a structure of ideas which Hegel had used to justify the institutions of private property and market exchange, in order to condemn those same institutions.",
    abstract_source = "s2"
}

@misc{moseley2014hegel,
    editor = "Moseley, Fred and Smith, Tony",
    title = "Marx's <i>Capital</i> and Hegel's <i>Logic</i>",
    year = "2014",
    doi = "10.1163/9789004270022",
    note = "CORE ARGUMENT: Moseley and Smith (eds.), Marx's Capital and Hegel's Logic (2014), an edited volume on the relation between Hegel's Logic and the method of Capital. MARX-CENTRALITY: Marx in title or primary subject.",
    keywords = "marx, hegel, dialectic, capital, Medium, METADATA\_CLEANED: publisher, type:@book->@misc",
    abstract = "This book provides a wide-ranging and in-depth reappraisal of the relation between Marx’s economic theory in Capital and Hegel’s Logic by leading Marxian economists and philosophers from around the world. The subjects dealt with include: systematic dialectics, the New Dialectics, materialism vs. idealism, Marx’s ‘inversion’ of Hegel, Hegel’s Concept logic (universality-particularity-singularity), Hegel’s Essence logic (essence-appearance), Marx’s levels of abstraction of capital in general and competition, and capital as Hegelian Subject. The papers in this volume were originally presented at the 22nd annual meeting of the International Symposium on Marxian Theory at Mount Holyoke College in August 2011. The twelve authors are divided between seven economists and five philosophers, as is fitting for the interdisciplinary subject of the relation between Marx’s economic theory and Hegel’s logic. Contributors are: Chris Arthur, Riccardo Bellofiore, Roberto Fineschi, Gastón Caligaris, Igor Hanzel, Juan Iñigo Carrera, Mark Meaney, Fred Moseley, Patrick Murray, Geert Reuten, Mario Robles, Tony Smith, and Guido Starosta.",
    abstract_source = "openalex"
}

