@article{meiksinswood1997back,
    author = "Wood, Ellen Meiksins",
    title = "Back to Marx",
    journal = "Monthly Review",
    year = "1997",
    volume = "49",
    note = "Argues that the post-1989 moment, contrary to conventional wisdom, is the most appropriate time to bring Marx back because capitalism has become a global system. MARX-CENTRALITY: Title and main topic: the contemporary case for returning to Marx.",
    keywords = "marx-since-1990, domain6, 1990s, critical-skeptical, marx-today, METADATA\_CLEANED: number, doi",
    abstract = "Let me start with a provocative claim, which is contrary to all the conventional wisdom. The claim I want to make is that this historical moment, the one we're living in now, is the best not the worst, the most not the least appropriate moment to bring back Marx. I'll even claim that this is the moment when Marx should and can come fully into his own for the first time—not excluding the historical moment when he actually lived.This article can also be found at the Monthly Review website, where most recent articles are published in full.Click here to purchase a PDF version of this article at the Monthly Review website.",
    abstract_source = "openalex"
}

@article{ohara1997veblens,
    author = "O'Hara, Phillip Anthony",
    title = "Veblen's critique of Marx's philosophical preconceptions of political economy",
    journal = "The European Journal of the History of Economic Thought",
    year = "1997",
    volume = "4",
    pages = "65--91",
    doi = "10.1080/10427719700000020",
    note = "Explores Veblen's criticisms of Marx for relying on a natural right of labour to the full product and on teleological conscious agency. MARX-CENTRALITY: Title and main topic: Veblen's critique of Marx.",
    keywords = "marx-since-1990, domain6, 1990s, marx-and-other-thinkers, critical-skeptical, METADATA\_CLEANED: number",
    abstract = "This paper explores some of the theoretical linkages between Thorstein Veblen and Karl Marx. Special reference is placed Veblen's criticisms of Marx and the Marxist tradition for adhering to the preconceptions of (a) the natural right of labour to the full product, and (b) the teleology of conscious agents directing action towards change. Veblen was incorrect to believe that Marx adhered to the natural right of labour thesis, but he was correct to assert that Marx utilized undesirable teleologies. Overall, however, Veblen was attempting to reformulate and modernise the materialistic conception of history through an evolutionary analysis of institutions. The two thinkers complement each other in important ways, although Veblen's analysis is more evolutionary, collectivist and holistic.",
    abstract_source = "openalex"
}

@article{roseberry1997anthropology,
