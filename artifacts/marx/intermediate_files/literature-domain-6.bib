@article{chattopadhyay1992economic,
    author = "Chattopadhyay, Paresh",
    title = "The Economic Content of Socialism Marx vs. Lenin",
    journal = "Review of Radical Political Economics",
    year = "1992",
    volume = "24",
    pages = "90--110",
    note = "Contrasts Marx's socialism of free producers without private property, commodity relations, wage labour or state with Lenin's state-owned, wage-labour-based socialism. MARX-CENTRALITY: Title and main topic: Marx's conception of socialism versus Lenin's.",
