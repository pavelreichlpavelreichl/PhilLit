@article{inglis2025time,
    author = "Inglis, David",
    title = "In Time, or Too Late, for Kant? Kant-Derived Cosmopolitan Theory Beyond Post-Colonial Critique",
    year = "2025",
    doi = {10.1177/00483931251327321},
    journal = {Philosophy of the Social Sciences},
    volume = {55},
    number = {4},
    pages = {287--308},
    note = "CORE ARGUMENT: Asks whether Kantian cosmopolitanism remains viable for social theory given post-colonial critiques of Kant's racism; considers Durkheim's and Beck's extensions of its sociological dimensions as signs of ongoing timeliness, haunted by possible human extinction. RELEVANCE: Defence of cosmopolitan project against post-colonial critique. POSITION: Rescue.",
    keywords = "kant, cosmopolitanism, postcolonial, rescue, Medium",
    abstract = "Is the Kantian inheritance in cosmopolitan thought still viable for social theory, or is it hopelessly outdated because irretrievably flawed, as post-colonial assessments and critics of Kant’s “racism” would argue? This question is explored vis-à-vis Émile Durkheim’s extension of the more “sociological” dimensions in Kant’s cosmopolitanism, ideas also taken up later by Ulrich Beck. Such contributions suggest Kant’s ongoing timeliness. Haunting these relatively optimistic considerations is the possibility of the future extinction of the human species, rendering Kant’s cosmopolitanism as a viewpoint offering possibilities for humanity that may come too late for it.",
    abstract_source = "s2"
}

@article{pascoe2024juridical,
    author = "Pascoe, Jordan",
    title = "Juridical and colonial racisms: On Kant's modern/colonial gender system",
    year = "2024",
    doi = {10.4000/13tup},
    journal = {Rivista di estetica},
    volume = {87},
    pages = {99--116},
    note = "CORE ARGUMENT: Sketches Kant's juridical racism, showing how his political philosophy contains and maintains racial exclusions; mines the Doctrine of Right on women's dependency as a map for raced inequality, drawing on Nzegwu. RELEVANCE: Gender and race together in Kant's political philosophy; feminist-decolonial angle. POSITION: Intersectional critique.",
    keywords = "kant, gender, race, juridical, Low",
    abstract = "This essay examines how inequalities are structured and rendered rightful in Kant’s political philosophy in order to offer a sketch of Kant’s juridical racism, or the ways in which his political philosophy is well-equipped to contain and maintain racial exclusions. By drawing on Nkiru Nzegwu’s conception of colonial racism, it highlights the forms of institutional racism that are perpetuated through juridical and colonial orders, which exceed Kant’s own theory of race, operating as what Huaping Lu-Adler has called a “racial ideology” embedded in his political philosophy. It first mines Kant’s arguments about the dependency of women in the Doctrine of Right, showing that these arguments offer a conceptual map of how raced inequality might be organized within the rightful state, organized as a form of juridical racism. It then turns to his cosmopolitan arguments, showing that working towards a rightful cosmopolitan condition will involve developing a shared conception of possessive rights, which Kant took to be a priori. In Kant’s inclusion of domestic right in this basic scheme of rightful possessive relations, we see an example of what Maria Lugones called the “modern/colonial gender system”, through which the invention and enforcement of normative gender roles becomes a critical method of coloniality. Thus, instead of treating gender as analogous to race in Kant’s arguments, I propose that we understand the normative structure of gendered dependency as a feature of Kant’s racial ideology.",
    abstract_source = "s2"
}

@misc{madrid2025gender,
    author = "Madrid, N. S.",
