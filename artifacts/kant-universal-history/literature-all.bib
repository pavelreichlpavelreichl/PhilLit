@incollection{grenberg2009anatomy,
    author = "Grenberg, Jeanine M.",
    title = "Social Dimensions of Kant's Conception of Radical Evil",
    year = "2009",
    doi = {10.1017/cbo9780511691898.009},
    booktitle = {Kant's Anatomy of Evil},
    publisher = {Cambridge University Press},
    pages = {173--194},
    note = "CORE ARGUMENT: Chapter 'A Reaction to Wood's Account of Kant's Radical Evil': contests Wood's claim that radical evil is equivalent and reducible to unsocial sociability, so that the propensity to evil develops only in society; Grenberg asks whether one would be evil even without social interaction. RELEVANCE: Direct response to Wood on how radical evil relates to the social realm and unsocial sociability, one of the key questions of this domain. POSITION: Critical response to Wood's social-comparison account of radical evil.",
    keywords = "radical-evil, ethical-commonwealth, social-comparison, High",
    abstract = "A Reaction to Wood's Account of Kant's Radical Evil Introduction Allen Wood and I disagree about how best to understand the relationship of Kant's notion of radical evil to the social realm: is evil something that comes about only in society, or would I be evil even without social interactions? For Wood, our propensity to evil develops only within society. In quasi-Rousseauian style, he understands Kant to be saying that, left in isolation, we would be “moderate” and “disposed to contentment” (R 6: 93–4, quoted at Wood, Kant's Ethical Thought , pp. 288–9). But once we encounter other people, our anxieties increase and lead us to prefer the satisfaction of our own inclinations over the moral demand to treat other persons as ends-in-themselves. We fall into fears of inequality, and this leads us to a comparative–competitive over-assertion of ourselves. Radical evil is thus equivalent to what Kant elsewhere describes as “unsocial sociability”: we can't help but seek out human society (that is the “sociability” part). But when we do, our natural tendency is to prefer the concerns of the self over even the morally based needs of others (that is the “unsocial” part). Wood thus asserts that social interaction is a necessary condition for our development of a propensity toward evil and, further, that this propensity is equivalent and reducible to unsocial sociability. If we were entirely isolated beings, we would not have a propensity for preferring self-concerns to moral demands.",
    abstract_source = "openalex"
}

@article{papish2024race,
    author = "Papish, Laura",
    title = "Kant on Race and the Radical Evil in the Human Species",
    year = "2024",
    doi = {10.1111/ejop.12921},
    journal = {European Journal of Philosophy},
    volume = {32},
    number = {1},
    pages = {49--66},
    note = "CORE ARGUMENT: Argues that the Religion is opaque partly because it has been read mainly as moral philosophy or universal history; the paper pairs it with Kant's natural-history writings on race and the concept of human species. RELEVANCE: Resists a purely moral-psychological reading of radical evil by adding the natural-history context; connects to critiques of the philosophy of history. POSITION: Natural-historical reading of radical evil.",
    keywords = "radical-evil, race, critical, Medium",
    abstract = "Religion within the Boundaries of Mere Reason remains one of the most opaque of Kant's published writings. Though this opacity belongs, partly, to the text itself, a key claim of this article is that this opacity stems also from the narrow lenses through which his readers view this text. Often read as part of Kant's moral philosophy or his universal history, the literature has thus far neglected a different vantage point on the Religion, one that does not refute the utility of these lenses but complements them. This paper places the Religion alongside parts of Kant's corpus that it is less typically paired with, namely his natural history writings—in particular, his writings on the concept of race and the development of the human races. I argue that by doing so, we can shed much light on Kant's infamous claim that there is a radical evil in the human species. More precisely, we will come to appreciate that this evil is not, as it is usually understood, a static property or fixed characteristic of human beings. Instead, radical evil concerns a dynamic, changing defect in human nature that increasingly threatens our aspirations to collective moral perfection.",
    abstract_source = "s2"
}

