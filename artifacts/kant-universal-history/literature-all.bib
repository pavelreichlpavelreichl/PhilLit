@article{pollmann2011kummer,
    author = "Pollmann, Arnd",
    title = "Der Kummer der Vernunft. Zu Kants Idee einer allgemeinen Geschichtsphilosophie in therapeutischer Absicht",
    year = "2011",
    doi = {10.1515/kant.2011.004},
    journal = {Kant-Studien},
    volume = {102},
    number = {1},
    note = "CORE ARGUMENT: Notes that recent studies may suggest Kant was confident that the future could only bring progress, but argues that Kant was highly conscious of the disheartening picture human development presents (citing the Conjectural Beginning's melancholy remark); the title proposes a history-philosophy in therapeutic intent (per the abstract). RELEVANCE: Offers a counterweight to purely progress-centred readings of Kant's philosophy of history. POSITION: Therapeutic/practical interpretation of the essay.",
    keywords = "Pollmann, Geschichtsphilosophie, therapeutic, German-scholarship, Medium, INCOMPLETE",
    abstract = "A cursory overview of the most recent studies on Kant's philosophy of history might lead one to suspect that Kant was so confident of the moral potential of human reason that the future could only lead to human progress. But in fact Kant was very much conscious of the disheartening picture that human development presented. In the conclusion to his Conjectures on the Beginnings of Human History he writes: “The thinking person is assailed by a melancholy that can even lead to moral corruption, something of which the unthinking person knows nothing: namely a dissatisfaction with that providence that rules the course of the world.” But Kant not wish to remain in a state of “melancholy”. He sees a possible connection between melancholy and the philosophy of history. In his relevant writings Kant addresses himself directly to the threat of this despair. The horrors of history can yield a philosophical meaning. Not history itself, but rather the philosophy of history has the capacity to console us. It can “heal” that which is lacking in wholeness through human progress. And because the history of philosophy contributes to the recovery of hope and conviction, it itself becomes an important movens of history.",
    abstract_source = "openalex"
}

@article{hoeffe2007kosmopolitismus,
    author = "Höffe, Otfried",
    title = "Kants universaler Kosmopolitismus",
    year = "2007",
    doi = {10.1524/dzph.2007.55.2.179},
    journal = {Deutsche Zeitschrift für Philosophie},
    volume = {55},
    number = {2},
    pages = {179--191},
    note = "CORE ARGUMENT: Argues that Kant develops a universal cosmopolitan philosophy that combines intercultural validity with a right to cultural difference, building on knowledge and morality and on education, philosophy of history, teleology and aesthetics (per the abstract). RELEVANCE: Representative German legal-political reading of Kant's cosmopolitan content, to be set against Habermas's update. POSITION: Kantian cosmopolitanism, German legal-philosophical interpretation.",
    keywords = "Hoeffe, cosmopolitanism, German-scholarship, Medium, INCOMPLETE",
    abstract = "Kant, der Weltbürger im Wissen aus Königsberg, entwickelt eine universale kosmopolitische Philosophie, welche im heutigen Zeitalter der Globalisierung hochwillkommen und hochmodern erscheint. Sie verbindet interkulturelle Gültigkeit mit einem Recht auf kulturelle Differenz. Kants Kosmopolitismus baut nicht nur auf Wissen und Moral auf, sondern bezieht darüber hinaus auch die Gegenstandsbereiche Erziehung, Geschichtsphilosophie, Teleologie, Ästhetik und Rechtsphilosophie mit ein.",
    abstract_source = "openalex"
}

@misc{kersting2007wohlgeordnete,
    author = "Kersting, Wolfgang",
    title = "Wohlgeordnete Freiheit",
    year = "1984",
    note = "CORE ARGUMENT: Places Kant's concept of autonomy at the systematic centre of his practical philosophy and as the new foundation of both moral and legal philosophy (per the abstract). RELEVANCE: Standard German reference on the Rechtslehre against which the essay's republic-and-federation claims are read; its handling of the 1784 essay specifically was not verified. POSITION: Kant's legal-political philosophy; German scholarship.",
    keywords = "Kersting, Rechtsphilosophie, German-scholarship, Medium, INCOMPLETE, year:2007->1984, type:@book->@misc",
    abstract = "Im systematischen Zentrum der praktischen Philosophie Kants steht die Konzeption der Autonomie, die Lehre von der SelbstgeSetzgebung der reinen praktischen Vernunft. Mit ihr gibt Kant der gesamten praktischen Philosophie, der Moralphilosophie wie der Rechtsphilosophie, ein revolutionär neues geltungstheoretisches Fundament. Lange suchte man die Grundlagen und Prinzipien der praktischen Philosophie in objektiven Ideen des Guten und der Gerechtigkeit, in einer normativen Verfassung des Kosmos, im Willen Gottes, der Natur des Menschen oder in der den Interessen der Individuen dienenden Klugheit. Kant hat die epistemologische Fragwürdigkeit dieser Legitimationsinstanzen der metaphysischen Tradition deutlich gemacht und aufgezeigt, daß sie bei der Begründung allgemeingültiger praktischer GeSetze versagen, daß die menschliche Vernunft nur solche Regeln und Normen absolute praktische Notwendigkeit und Verbindlichkeit zugestehen kann, die ihrer eigenen GeSetzgebung entstammen.",
    abstract_source = "openalex"
}

@article{brandt1996origines,
    author = "Brandt, Reinhard",
    title = "Aux origines de la philosophie kantienne de l'histoire : l'anthropologie pragmatique",
    year = "1996",
    doi = {10.4000/rgi.575},
    journal = {Revue germanique internationale},
    volume = {6},
    pages = {19--34},
    note = {CORE ARGUMENT: Traces Kant's empirical psychology and then pragmatic anthropology (from the 1772-73 lectures) as the origin of his philosophy of history; the 1773 turn to a "pragmatic" practical philosophy is the key step. RELEVANCE: Brandt's anthropological genealogy of the 1784 essay, an alternative to reading it from the critical system; also supports questions on the essay's source in the anthropology lectures. POSITION: Genetic/anthropological interpretation.},
    keywords = "Brandt, anthropology, genesis, Geschichtsphilosophie, French, High",
    abstract = "Contrairement a la conception de la nature humaine de David Hume et contrairement a l’anthropologie de Feuerbach et de Nietzsche, la psychologie empirique ou anthropologique kantienne se constitue comme une discipline coexistant avec la metaphysique et le criticisme — mais elle ne constitue pas une partie de la philosophie critique proprement dite. Kant developpe d’abord, dans ses premiers cours (1772-1773), l’idee d’une psychologie empirique en tant que science theorique, dissociee du cadre metaphysique dans lequel l’inserait encore Baumgarten. Vers la fin de 1773 s’opere un tournant vers la philosophie pratique ou « pragmatique » : l’intention de Kant est alors « de reveler grâce a l’anthropologie les sources de toutes les disciplines pratiques ». L’anthropologie pragmatique a pour Kant le meme but que celui que s’etaient assigne les « philosophes populaires », avec leur philosophie « pour la vie quotidienne ».",
    abstract_source = "s2"
}

@article{muglioni1996principe,
    author = "Muglioni, Jean-Michel",
    title = "Le principe téléologique de la philosophie kantienne de l'histoire",
    year = "1996",
    doi = {10.4000/rgi.585},
    journal = {Revue germanique internationale},
    volume = {6},
    pages = {113--127},
    note = "CORE ARGUMENT: Philosophy is teleology: the critical limitation of knowledge allows metaphysics to be completed as moral teleology. A teleology of nature as a whole is founded on practical finality, so the Copernican revolution is complete only when creation is thought in terms of freedom and man as final end. RELEVANCE: Casts the teleological principle of the philosophy of history as grounded in practical reason, which bears on the regulative-versus-constitutive question for the essay's Leitfaden. POSITION: Practical-teleological interpretation; French scholarship.",
    keywords = "Muglioni, teleology, practical-reason, French, Medium",
    abstract = "La philosophie est teleologie. La limitation critique du savoir permet l’accomplissement de la metaphysique comme teleologie morale. La finalite n’est pas seulement d’un usage heuristique pour la connaissance des etres vivants. Il y a une teleologie de la nature comme tout, fondee dans la finalite pratique, seule inconditionnee. Le devoir imposant formellement la realisation d’une tâche, la philosophie a a penser sa realisation effective dans le monde. Ainsi la revolution copernicienne n’est pas achevee tant que le tout de la creation n’est pas pense en fonction de la liberte, de l’homme fin ultime. Kant retrouve le cosmos antique a partir de l’autonomie, pensant le monde comme etant le lieu de notre destination : professeur de geographie et philosophe de l’histoire.",
    abstract_source = "s2"
}

@incollection{wittwer1996eschatologie,
    author = "Wittwer, Hector",
    title = "Transzendentale Eschatologie und Kritische Geschichtsbetrachtung bei Kant",
    year = "1996",
    doi = {10.1007/978-3-476-03633-9_12},
    booktitle = {Politisches Denken Jahrbuch 1995/96},
    publisher = {J.B. Metzler},
    pages = {179--196},
    note = {CORE ARGUMENT: Chapter opening with the observation that philosophical reflection on the course of history is unavoidable in an era of talk of the 'end of history' (per the abstract's opening); the title relates a transcendental eschatology to Kant's critical view of history. RELEVANCE: German-language discussion that may connect to the Lowith "secularised eschatology" line of criticism. POSITION: Kant and eschatology; German scholarship.},
    keywords = "Wittwer, eschatology, Geschichtsbetrachtung, German-scholarship, Low, INCOMPLETE",
    abstract = "In einer Zeit, in der sich einerseits die Rede vom »Ende der Geschichte« ausbreitet und andererseits die Politik immer aufs neue von der Geschichte eingeholt wird — denken wir nur an die zahlreichen Nationalitätenkonflikte in Europa, deren Ursachen weit in die Vergangenheit zurückreichen — scheint uns die philosophische Reflexion über den Gang der Geschichte eine unabweisliche Aufgabe zu sein. Wer verantwortlich über den privaten Rahmen hinaus handeln will, muß sich zuvor denkend die immer auch geschichtlichen Bedingungen seines Handelns vor Augen führen. Kants Gedanken über Geschichte verdienen in diesem Zusammenhang unsere Aufmerksamkeit nicht nur, weil das Erscheinen seiner Friedensschrift sich nun zum 200. Male jährt; aber dies Jubiläum wird hoffentlich dazu beitragen, sich intensiver mit seiner Geschichtsphilosophie zu befassen.",
    abstract_source = "openalex"
}

@article{heisenberg2018wende,
    author = "Heisenberg, Thimo",
    title = "Die moralische Wende in Kants Philosophie der Geschichte",
    year = "2018",
    doi = {10.5771/0031-8183-2018-1-2},
    journal = {Philosophisches Jahrbuch},
    volume = {125},
    number = {1},
    pages = {2--19},
    note = "CORE ARGUMENT: Kant's philosophy of history changed significantly between the 1784 Idea and the 1790 Third Critique: in 1784 historical progress is accomplished mainly through social antagonism, while from 1790 ethical cooperation is elevated into a second significant source of progress. RELEVANCE: Direct evidence for a developmental reading of the essay's unsocial-sociability mechanism, relevant to questions about its relation to the later moral philosophy and to the Domain 4 debate. POSITION: Developmental interpretation; a shift from antagonism to moral cooperation.",
    keywords = "Heisenberg, development, unsocial-sociability, German-scholarship, High",
    abstract = "Abstract: In this paper, I argue that Kant’s philosophy of history underwent a significant change be- tween his 1784 Idea for a Universal History and his 1790 Third Critique. My proposal is that in between these two texts Kant decisively revised his conception of the sources of historical, i. e. cultural and political, progress: In 1784, he conceived of historical progress as primarily accomplished through social antagonism among human beings, whereas beginning in 1790, he elevates ethical cooperation into a second, significant source of progress. Between 1784 and the 1790s, in other words, Kant re-conceived the collaboration between moral agents as a driving force of history and of the progressing cultivation of humankind. In this paper I offer evidence for this change and suggest reasons why it might have occurred.",
    abstract_source = "s2"
}

@article{vuillerod2024naturaliste,
    author = "Vuillerod, Jean-Baptiste",
    title = "La conception naturaliste de l'histoire chez Kant",
    year = "2024",
    doi = {10.3917/dhs.056.0453},
    journal = {Dix-huitième siècle},
    volume = {n° 56},
    number = {1},
    pages = {453--472},
    note = {CORE ARGUMENT: Clarifies the articulation of nature and history in the Idee d'une histoire universelle and argues that Kant's treatment rests on his 1750s writings on nature: Kant takes the history of nature as a model for human history, a "naturalist" conception that does not determine human history by natural processes. RELEVANCE: Recent French reading that connects the 1784 essay to the Universal Natural History; informs the status-of-the-Idea debate and the reception question of how nature and history are linked. POSITION: Naturalist-model interpretation; French scholarship.},
    keywords = "Vuillerod, naturalism, nature-history, French, Medium",
    abstract = "L’article cherche à clarifier l’articulation de la nature et de l’histoire dans l’ Idée d’une histoire universelle au point de vue cosmopolitique , et montre que la manière dont Kant pense cette articulation trouve son fondement dans ses écrits sur la nature des années 1750. Il apparaît ainsi que Kant propose une conception naturaliste de l’histoire, non pas au sens où il déterminerait l’histoire humaine par des processus naturels, mais au sens où il a été chercher dans l’histoire de la nature un modèle pour penser l’histoire humaine. Une ligne directrice se fait ainsi jour à travers l’œuvre kantienne. Par là, il ne s’agit pas de nier le tournant décisif qu’introduit le projet criticiste chez Kant, mais de souligner la persistance d’un motif naturaliste qui est commun à la période précritique et à la période critique.",
    abstract_source = "s2"
}

@misc{tredanaro2024purposiveness,
    author = "Tredanaro, Emanuele",
    title = "Purposiveness, transcendental ideas, and philosophical history. Notes on the Idea for a Universal History with a Cosmopolitan Aim",
    year = "2024",
    volume = "12",
    note = "CORE ARGUMENT: Argues that the principle of purposiveness and systematicity of reason, as developed in the Transcendental Dialectic and its Appendix in the first Critique, provide the theoretical and methodological foundation for the philosophical conception of history in the 1784 essay. RELEVANCE: Recent contribution on the essay's epistemic status via the first Critique, for the regulative/constitutive debate of Domain 3. POSITION: Regulative-systematic reading of the Idea.",
    keywords = "Tredanaro, purposiveness, regulative, Idea, Medium",
    abstract = "This paper aims to point to relationship between Transcendental Dialectic of the Critique of Pure Reason (KrV) and Idea for a Universal History with a Cosmopolitan Aim (IaG). Specifically, it seeks to show the theoretical and methodological foundation that the principle of purposiveness and the systematicity of reason, as presented in the KrV, offer to Kant’s philosophical conception of history in the IaG. The paper is divided into three sections. The first section presents – as problematic – the premises that, in the introduction to the IaG, Kant adopts in his philosophical investigation of history. The second section focuses on the Appendix to the Transcendental Dialectic, examining the legitimate use of transcendental ideas, as well as their indeterminate objective necessity. Finally, the third section examines some propositions of the IaG, suggesting that the repercussion of the Transcendental Dialectic on the IaG allows us to understand Kant’s distinctive investigative method in philosophical history.",
    abstract_source = "openalex"
}

