@article{kleingeld2001nature,
    author = "Kleingeld, Pauline",
    title = "Nature or Providence? On the Theoretical and Moral Importance of Kant's Philosophy of History",
    year = "2001",
    doi = {10.5840/acpq200175216},
    journal = {American Catholic Philosophical Quarterly},
    volume = {75},
    number = {2},
    pages = {201--219},
    note = {CORE ARGUMENT: Asks about the relation of nature and providence in Kant's philosophy of history and argues, per the abstract, that Kant's preference for "providence" in the Idea for a Universal History marks a shift from the theoretical question of order in history to a moral approach to history grounded in the teleological principle. RELEVANCE: Bears on the "regulative versus immanent teleology" contrast that Herder and Hegel press against Kant; if the Idea's nature-talk is regulative and morally grounded, Hegelian criticisms of it as external or abstract change force. POSITION: Moral-practical, regulative reading of Kant's history; resists the narrative of a naturalistic teleology superseded by Hegel.},
