@article{vorlaender1900sozialismus,
    author = {Vorländer, Karl},
    title = "Kant und der Sozialismus",
    year = "1900",
    doi = {10.1515/kant.1900.4.1-3.361},
    journal = {Kant-Studien},
    volume = {4},
    number = {1-3},
    note = "CORE ARGUMENT: Argues that Kantian critical idealism, having spread to other disciplines, should now be extended to the social movement, and that theorists in the neo-Kantian camp had already approached Kant's doctrine from a socio-scientific side (abstract in Kant-Studien record). RELEVANCE: Primary text of the neo-Kantian effort to ground socialism in Kant, a key node between Kant's Idea and Marxism; relevant for the question of how ethical socialism took up Kantian ends-in-themselves and historical progress. POSITION: Ethical-socialist neo-Kantianism (Vorlaender).",
    keywords = "vorlander, ethical-socialism, neo-kantianism, primary-source, High",
    abstract = {Es ist ein gutes Zeichen von der Lebenskraft und Fruchtbarkeit des kritischen Idealismus, dass er nach mehr denn einem Jahrhundert auf neuen Gebieten frische Wurzeln treibt. Nachdem die verschiedenen philosophischen Disziplinen, nachdem die Naturwissenschaften, nachdem die Theologie vorangegangen, schickt sich nun auch die mächtigste Bewegung der Gegenwart, die soziale, an, in ihren theoretischen Betrachtungen den Weg zu dem Begründer des Kritizismus zu suchen. Auf der einen Seite haben die namhaftesten Vertreter des Neukantianismus die Kantische Lehre gerade nach der sozialwissenschaftlichen und sozialethischen Seite hin immer entschiedener auszubilden begonnen. Von der anderen Seite her antwortet dem aus Kreisen, die sich bisher dem Einflüsse des Kritizismus völlig verschlossen gezeigt hatten, aus dem parteisozialistischen Lager heraus, der Ruf „Zurück auf Kant!", sodass man fast — cum grano salis! — von sozialistischen Kantianern und Kantischen Sozialisten reden könnte. Indem wir auf Wunsch des Herausgebers für die „Kantstudien" ein zusammenfassendes Bild des Standes der Dinge zu entwerfen versuchen, entwickeln wir zunächst unsere eigene Auffassung in Beantwortung der Frage: Inwiefern hat der Sozialismus ein Recht, sich auf Kants Lehre und Weltanschauung zu berufen?) Dabei sei von vornherein bemerkt, dass wir unter dem vieldeutigen Worte Sozialismus keine bestimmte politische Partei, mit der die philosophische Untersuchung nichts zu thun hat, sondern eine sittliche Weltanschauung verstehen. Ferner interessieren uns in diesem Zusammen-},
    abstract_source = "s2"
}

@article{widmer2023stammler,
    author = "Widmer, Elisabeth",
    title = "'Left-Kantianism' and the 'Scientific Dispute' between Rudolf Stammler and Hermann Cohen",
    year = "2023",
    doi = {10.1515/agph-2021-0181},
    journal = {Archiv für Geschichte der Philosophie},
    volume = {106},
    number = {3},
    pages = {632--655},
    note = {CORE ARGUMENT: The Cohen-Stammler dispute is symptomatic of left-wing Kant interpretations around 1900; their Kantian justifications of socialism differ in their conceptions of law, history and political implications, and against scholars who treat the Marburg view on socialism as a coherent school, the paper stresses divergence. RELEVANCE: Directly assesses how Marburg neo-Kantians linked Kant's practical philosophy and philosophy of history to socialism, and warns against a unified "Marburg ethical socialism" narrative. POSITION: Revisionist history of neo-Kantian socialism; Left-Kantianism.},
    keywords = "neo-kantianism, cohen, stammler, ethical-socialism, resisting-narrative, High",
    abstract = "Abstract This paper argues that the ‘scientific dispute’ between Hermann Cohen and Rudolf Stammler is symptomatic of a philosophical movement of left-wing Kant interpretations at the turn of the twentieth century. By outlining influential predecessors that shaped Cohen’s and Stammler’s thinking, I show that their Kantian justifications of socialism differ regarding their conception of law, history, and the political implications that follow from their practical philosophies. Against scholars who suggest that the Marburg School’s view on socialism was a coherent school of thought, I introduce the concept of ‘left-Kantianism’ as an open term that includes a wide variety of novel socialist approaches to Kant at the time.",
    abstract_source = "s2"
}

