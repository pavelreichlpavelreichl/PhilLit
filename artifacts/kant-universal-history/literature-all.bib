@incollection{loewith1983weltgeschichte,
    author = "Löwith, Karl",
    title = "Weltgeschichte und Heilsgeschehen",
    year = "1983",
    doi = {10.1007/978-3-476-03166-2_2},
    booktitle = {Weltgeschichte und Heilsgeschehen},
    publisher = {J.B. Metzler},
    pages = {240--279},
    note = {CORE ARGUMENT: A chapter of Lowith's Weltgeschichte und Heilsgeschehen (German edition of Meaning in History), whose thesis, as discussed in Chorell 2021, is that modern philosophy of history and the idea of progress are secularised Christian eschatology (the chapter-level content is not available). RELEVANCE: Source of the "secularised eschatology" objection that Kant's progress thesis must answer; the record does not show how Kant is treated. The English Meaning in History (1949) was not returned as a record with usable metadata. POSITION: Secularisation critique of philosophy of history.},
    keywords = "Lowith, secularization, eschatology, progress, High, INCOMPLETE",
    abstract = "Wir setzen gewohnlich voraus, das es zwei Welten gibt: die Welt der Natur und die Welt der Geschichte. In der einen weis sich der Mensch mehr oder minder fremd, weil sie ohne ihn, von Natur aus, ist; mit der andern mehr oder minder vertraut, weil sie eine von ihm hervorgebrachte, menschliche Welt ist. In beiden Welten geschieht etwas, aber das Naturgeschehen scheint in die menschliche Welt zumeist nur herein, sofern es kulturfordernd und -hemmend ist. Wir fragen darum auch nicht nach dem Sinn der Natur, sondern nur nach dem Sinn der Geschichte. Der Mensch wird zwar immer wieder von seiner eigenen Welt und Geschichte wie von etwas Fremdem und Sinnfremdem uberwaltigt; was ihn dabei uberwaltigt, ist aber doch ein Geschehen, das auf dem Handeln des Menschen beruht. Diese Unnatur des geschichtlichen Geschehens gehort zur »Natur« des Menschen. Je kunstlicher, kultivierter und zivilisierter unsere Zustande sind, desto mehr verlangen wir zuruck zur Natur. Das seit Rousseau vernehmliche »Unbehagen in der Kultur« und die Flucht zur Natur bestatigt nur, das wir kultur-geschichtlich existieren und der Natur entfremdet sind.",
    abstract_source = "openalex"
}

@article{chorell2021unsecularizing,
    author = "Chorell, Torbjörn Gustafsson",
    title = "Unsecularizing history and politics: Jayne Svenungsson and Karl Löwith on meaning in history",
    year = "2021",
    doi = {10.1080/21692327.2021.1923558},
    journal = {International Journal of Philosophy and Theology},
    volume = {82},
    number = {2},
    pages = {176--192},
    note = "CORE ARGUMENT: Examines Jayne Svenungsson's rethinking of the concept of history in light of the crisis of the secularization thesis, in dialogue with Lowith's argument that modern philosophy of history and the idea of progress are secularised versions of Christian eschatology. RELEVANCE: Recent assessment of the Lowith thesis; background for evaluating whether Kant's progress thesis counts as a secularised eschatology. The abstract does not itself mention Kant. POSITION: Secularization debate; Lowith reception.",
    keywords = "Lowith, secularization, progress, Low",
    abstract = "ABSTRACT The debate about secularization in recent decades has challenged long-held assumptions about Western modernity and the purported decline of religion in modern societies. However, the impact of this criticism on the idea of history has so far not received as much attention as it deserves. Jayne Svenungsson’s analysis of the influence of biblical motives on contemporary political theology illustrates one way in which the concept of history might be rethought in the wake of the crisis of the secularization thesis. In dialogue with Karl Löwith’s classical argument that modern philosophy of history and the idea of historical progress are secularized versions of Christian eschatology, she argues that the prophetic vision of history as a struggle for a justice that supersedes every current law or moral system is a viable and promising alternative that ought to be considered in contemporary discussions of politics and history. Svenungsson’s analysis thus amounts to what one might call a postsecular challenge to a secular historical discourse.",
    abstract_source = "s2"
}

