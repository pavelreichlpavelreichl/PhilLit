    doi = {10.1515/kant-2012-0006},
    journal = {Kant-Studien},
    volume = {103},
    number = {1},
    note = "CORE ARGUMENT: Asks whether Kant's league admits only republics as members (per title). RELEVANCE: Links republicanism to the federation of nations, relevant to the relation between constitutional form (Proposition 5) and international order (Proposition 7). POSITION: League-of-states interpretation; republicanism question.",
