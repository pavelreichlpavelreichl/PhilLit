    note = "CORE ARGUMENT: Addresses the unwitting gender oppression in Kant's anthropological and legal approach to domestic labour, via social domination in the Anthropology and the Character of Sex section. RELEVANCE: Feminist critique of Kant's anthropology. POSITION: Feminist critique.",
    keywords = "kant, gender, anthropology, Low, INCOMPLETE, no-abstract"
}

