@article{cureton2018reasonable,
    author = "Cureton, Adam",
    title = "Reasonable Hope in Kant's Ethics",
    year = "2018",
    doi = {10.1017/s136941541800002x},
    journal = {Kantian Review},
    volume = {23},
    number = {2},
    pages = {181--203},
    note = "CORE ARGUMENT: Notes that for Kant the obstacles to a just world (selfishness, rivalry, vanity, and the strife of unsocial sociability) are nature's way of compelling us toward morally good ends, echoing Smith's 'invisible hand' and pushing toward justice and the highest good; asks what to make of these arguments given questionable empirical assumptions, natural teleology and tension with Kant's ethics, and suggests they reveal an insight about what a good and virtuous person reasonably hopes for. RELEVANCE: Treats the hope-for-progress question directly, linking antagonism, the invisible-hand comparison and the highest good; a counterpart to Woo (2023). POSITION: Hope-based reading of Kant's argument from antagonism.",
    keywords = "hope, practical-reason, Medium",
    abstract = "Abstract The most apparent obstacles to a just, enlightened and peaceful social world are also, according to Kant, nature’s way of compelling us to realize those and other morally good ends. Echoing Adam Smith’s idea of the ‘invisible hand’, Kant thinks that selfishness, rivalry, quarrelsomeness, vanity, jealousy and self-conceit, along with the oppressive social inequalities they tend to produce, drive us to perfect our talents, develop culture, approach enlightenment and, through the strife and instability caused by our unsocial sociability, push us towards justice, political equality and the highest good. What are we to make of these arguments, which seem to rely on questionable empirical assumptions, invoke dubious claims about natural teleology and sit uncomfortably with fundamental aspects of Kant’s ethical framework? I suggest that the arguments reveal one of Kant’s deep and important insights about the moral life by partially describing what a good and virtuous person reasonably hopes for.",
    abstract_source = "openalex"
}

@article{williams2024progress,
    author = "Williams, Avery",
    title = "Is Progress Possible? Moral Improvement in Kant's Renewed Attempt",
    year = "2024",
    doi = {10.53765/20512988.45.2.327},
    journal = {History of Political Thought},
    volume = {45},
    number = {2},
    pages = {327--346},
    note = "CORE ARGUMENT: Interprets the Renewed Attempt (Conflict of the Faculties) to argue that it complicates the earlier philosophy of history, conceding that rightful progress toward global republicanism is the most we can be sure of. RELEVANCE: Shows later Kant narrowing the 1784 claims to legal-political progress, bearing on the legality vs moral progress question. POSITION: Deflationary reading of historical progress.",
    keywords = "progress, moral-improvement, legality, Medium",
    abstract = "This article seeks to understand the possibility of moral improvement in human social history through a close interpretation of Kant’s A Renewed Attempt to Answer the Question: Is the Human Race Continually Improving? The article examines the ways in which Kant’s arguments in this final piece, while often overlooked, complicate his philosophy of history as put forward in earlier works. Through this comparison, one sees important complications in Kant’s thoughts on the philosophy of history at the end of his career, conceding that rightful progress towards a global republicanism is the most we can be sure of. This concession is striking considering Kant’s ambitious goal at the outset to demonstrate the theoretical certainty of moral progress, going well beyond the practical optimism he advocates in earlier works. Yet, despite this concession, Kant is still optimistic about the possibility of moral progress at the end of the piece. This article suggests that Kant’s Renewed Attempt is best understood as a window into Kant’s grappling with the difficulties of constructing a philosophy of history that is consistent with his moral philosophy. By doing so, the text reveals underappreciated complexities of Kant’s practical thought.",
    abstract_source = "openalex"
}

@article{lenczewska2022rationality,
    author = "Lenczewska, Olga",
    title = "From Rationality to Morality: The Collective Development of Practical Reason in Kant's Moral Anthropology",
    year = "2022",
    doi = {10.1017/s1369415422000152},
    journal = {Kantian Review},
    volume = {27},
    number = {3},
    pages = {363--383},
    note = "CORE ARGUMENT: Reconstructs Kant's account of the emergence of reason from his conjectural and literal remarks about humanity's transition from irrational animals to primitive rational beings, challenging the view that this account lacks philosophical value. RELEVANCE: Links the Conjectural Beginning, moral anthropology and collective development of practical reason to the Idea's progress narrative. POSITION: Collective-development reading of Kant's moral anthropology.",
    keywords = "conjectural-beginning, moral-anthropology, practical-reason, Medium",
    abstract = "Abstract While Kant’s account of humankind’s rational progress has been widely discussed, his speculative views about the way in which this progress might havebegunand the circumstances surrounding this beginning have been largely neglected. Implicit in such an omission is the assumption that Kant does not say much about the very beginning of human history or that whatever he says is of little philosophical value. This article challenges these assumptions. I reconstruct Kant’s account of the emergence of reason by looking at his various conjectural and more literal remarks about our species’ transition from mere irrational animals into primitive human beings possessing a rudimentary form of rationality. Next, I show how this account fits with Kant’s broader view of humankind’s rational progress and its subsequent stages. By doing so, I elucidate Kant’s guidelines for achieving this progress in the future by unifying them with his regulative view of reason’s past.",
    abstract_source = "openalex"
}

@article{ypi2024moral,
    author = "Ypi, Lea",
    title = "The Moral Ought in Conjectural History",
    year = "2024",
    doi = {10.1080/13698230.2024.2344386},
    journal = {Critical Review of International Social and Political Philosophy},
    volume = {27},
    number = {6},
    pages = {991--1010},
    note = "CORE ARGUMENT: Defends the importance of historical progress for constructivist justifications of moral normativity inspired by Kant, arguing that without a critical notion of purposiveness and a related philosophical analysis of history, constructivist rejection of scepticism risks circularity. RELEVANCE: Links purposive history to the justification of the moral ought, bearing on the relation between history and morality. POSITION: Constructivist defence of philosophy of history.",
    keywords = "purposiveness, conjectural-history, constructivism, Medium",
    abstract = "ABSTRACT This article defends the importance of the idea of historical progress for constructivist justifications of moral normativity inspired by Kant’s analysis of practical reason. Focusing on some key methodological requirements that must be satisfied for the constructivist vindication of practical normativity to succeed, the article focuses on the concept of purposiveness as it develops within Kant’s moral and political philosophy. It concludes that without a critical notion of ‘purposiveness’ and related philosophical analysis of history, the constructivist rejection of scepticism is at risk of circularity.",
    abstract_source = "s2"
}

@article{beller2026seeds,
    author = "Beller, Luke",
    title = "The Seeds of Peace in Kant's Unsociable Sociability",
    year = "2026",
    doi = {10.1215/01903659-12437301},
    journal = {boundary 2},
    volume = {53},
    number = {3},
    pages = {123--139},
    note = "CORE ARGUMENT: Explores unsociable sociability as a human-specific natural tendency toward community together with a desire to isolate oneself; these tendencies cannot resolve themselves, yet Kant holds that social antagonism orients humanity toward political peace, freedom and international justice based on republican principles. RELEVANCE: Recent treatment tying the Fourth Proposition to perpetual peace and the most reprehensible inclinations (ambition, domination, greed). POSITION: Political-anthropological reading.",
    keywords = "unsocial-sociability, perpetual-peace, recent, Medium",
    abstract = "abstract\\_source = {s2}, The present paper explores Kant's social-anthropological notion of “unsociable sociability” (ungesellige Geselligkeit) and its relation to his political project of perpetual peace. Kant views unsociable sociability as a human-specific natural tendency toward community accompanied by the strong desire to isolate oneself from that community. These antagonistic tendencies cannot resolve themselves. Kant states that the most morally reprehensible human inclinations (overambition, desire for domination, greed) stem from unsociable sociability. Nevertheless, Kant proposes that this social antagonism orients humanity toward political peace, freedom, and international justice based on republican principles. In an agonal sense, it demonstrates the germ of moral impetus and action within the competitive and superficially irreconcilable chaos of world-historical affairs. Thus, Kant proves his relevance for contemporary discussions of agonal democratic politics as theorized by thinkers such as Hannah Arendt, Claude Lefort, Chantal Mouffe, and Philip Pettit. Furthermore, an understanding of Kant's unsociable sociability demonstrates not only Kant's communitarian ethics, but also his hope that a more equal and freer world can arise through a progressive overcoming of the most extreme individuating tendencies."
}

@incollection{klein2026concept,
    author = "Klein, Joel Thiago",
    title = "Kant's Concept of Unsocial Sociability",
    year = "2026",
    doi = {10.1515/9783111608136-005},
    booktitle = {Kant and the Space of Feelings},
    publisher = {De Gruyter},
    pages = {33--46},
    note = "CORE ARGUMENT: Examines unsocial sociability in Kant's practical philosophy as a dynamic process of conflict that is indispensable yet perpetually subject to disciplinary constraints, and argues it should be conceptualised as morally neutral, distinct from 'evil' and 'war'. RELEVANCE: Takes a position against assimilating unsocial sociability to radical evil, contrasting with Wood (1991) and Kim's target. POSITION: Moral-neutrality reading.",
    keywords = "unsocial-sociability, recent, Medium",
    abstract = "This paper examines the intricate nuances of “unsocial sociability” in Kant's practical philosophy. It elucidates how this concept establishes a dynamic process of conflict that is both indispensable and perpetually subject to disciplinary constraints. It is argued that unsocial sociability should be conceptualized as a morally neutral concept, distinct from notions of “evil” and “war”.",
    abstract_source = "openalex"
}

@article{charpenel2019insociable,
    author = "Charpenel, Eduardo",
    title = "La insociable sociabilidad y la trama de la filosofía kantiana de la historia",
    year = "2019",
    doi = {10.4067/s0718-50652019000100207},
    journal = {Límite (Arica)},
    volume = {14},
    note = "CORE ARGUMENT: Reconstructs unsocial sociability to show its relation with radical evil, moral autonomy and the heuristic teleological history of mankind; aims to correct certain interpretative mistakes about how social and unsocial dimensions affect judicial, political and moral practices. RELEVANCE: Spanish-language work directly on the question of the concept's relation to radical evil and autonomy. POSITION: Integrative reading across Idea, Religion and teleology.",
    keywords = "unsocial-sociability, radical-evil, autonomy, Spanish, Medium",
    abstract = "In this article I present a reconstruction of the Kantian notion of unsocial sociability with the aim of showing its relation with other key elements of Kant’s philosophy such as radical evil, moral autonomy, and the history of mankind considered from a heuristic teleological viewpoint. Given the multiple connections and associations this notion can give rise to, I consider of utmost importance to elucidate how Kant understood our social and unsocial dimensions, and how these can have an impact upon the ways we develop our judicial and political institutions and our moral practices. Through the present analysis I believe, on the one hand, that certain interpretative mistakes such as those of Allen W. Wood and Jane Kneller can be corrected, and, on the other hand, that we can be in better conditions to appreciate the ongoing validity of Kant’s historical and anthropological project.",
    abstract_source = "s2"
}

@article{requejo2007somos,
    author = "Requejo, Ferrán and Valls, Ramón",
    title = "Somos conflictivos, pero... Actualidad de la tesis de Kant sobre la insociable sociabilidad de los humanos y su prolongación por parte de Hegel",
    year = "2007",
    doi = {10.3989/isegoria.2007.i37.113},
    journal = {Isegoría},
    number = {37},
    pages = {127--163},
    note = "CORE ARGUMENT: Addresses the thesis of unsocial sociability with perpetual peace, cosmopolitanism and patriotism, and its extension by Hegel; holds that the thesis shows distrust of mere moral imperatives, which are ineffective alone for humanising humanity. RELEVANCE: Bears on the Hegelian reception and on the claim that morality alone is insufficient for progress. POSITION: Neo-Hegelian updating of unsocial sociability.",
    keywords = "unsocial-sociability, hegel, Spanish, Low",
    abstract = "In this paper we address Kant’s thesis of human beings’ unsocial sociability and a number of related themes such as perpetual peace, cosmopolitanism and patriotism and how this thesis was extended by Hegel. We consider Kant’s thesis to be a more suitable framework with which to observe modern- day reality than that offered by many of the political and social theories that are currently in use. Although there is no doubt that Kant was a moral philosopher, this thesis shows a certain degree of distrust of mere moral imperatives. The latter are, on their own, ineffective for «humanizing humanity». Today we know that rationality expressed through language is what distinguishes us as a species. However, it is likely that this is not what constitutes us as individuals of this species. Unsocial sociability works well as a conceptual framework with which to address the current difficulties facing democracies, in both the international sphere and in the sphere of their internal pluralism of a cultural and, in some cases, a national, nature. Kant and Hegel are philosophers of History because both offer ways to overcome many conflicts through politics. From a contemporary perspective, unsocial sociability is a concept which complements —in an individual dimension (Kant) as well as in a socio-political dimension (Hegel)— what is an unavoidable feature of the contemporary world: the pluralism of values, interests and identities, which are usually agonistic in nature, and which are endowed with emotional components.",
    abstract_source = "s2"
}

