@misc{ginsborg2014organisms,
    author = "Ginsborg, Hannah",
    title = "Kant on Understanding Organisms as Natural Purposes",
    year = "2001",
    note = "CORE ARGUMENT: Explains why Kant thinks we must regard organisms as purposes while treating them as natural products. Kant's premise that organisms are mechanically inexplicable is read as the claim that biological regularities are irreducible to material forces, and the purposiveness is read in normative terms. RELEVANCE: Supplies the conceptual basis of CPJ natural teleology on which any extension to the species' history depends (the 'as if' normative reading). POSITION: Normative/reflective reading of teleological judgment.",
    keywords = "natural-purposes, reflective-judgment, Medium, METADATA\\\_CLEANED: publisher, booktitle, pages, year:2014->2001, type:@incollection->@misc, METADATA\_CLEANED: doi",
    abstract = "This essay explains why Kant thinks we have to regard organisms as purposes, and how we can do this while respecting their status as natural products, rather than as artefacts. Kant’s premise that organisms are mechanically inexplicable is interpreted as the claim that biological regularities are irreducible to regularities in the behaviour of matter as such (resulting from the forces of attraction and repulsion), and his conclusion that they are purposive is interpreted as the claim that they must be regarded in normative terms. This conclusion is defended on the grounds that biological enquiry cannot, even today, avoid regarding living things as subject to normative standards.",
    abstract_source = "openalex"
}

