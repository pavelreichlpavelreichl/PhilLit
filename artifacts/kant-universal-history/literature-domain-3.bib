@misc{woo2023hope,
    author = "Woo, Jaeha",
    title = "Why Kant's Hope Took a Historical Turn in Practical Philosophy",
    year = "2023",
    note = "CORE ARGUMENT: Argues that Kant, within the critical period, moved toward de-emphasizing the highest good as final end because endless pursuit offers no moral satisfaction, and ties hope to a historical turn in practical philosophy (abstract truncated). RELEVANCE: Relates practical hope and the highest good to history, a route by which the Idea could count as a postulate of practical reason. POSITION: Practical-hope reading of historical progress.",
    keywords = "hope, history, Medium, METADATA\\\_CLEANED: pages, METADATA\_CLEANED: journal, volume, doi, type:@article->@misc",
    abstract = "In the beginning of his critical period, Kant treated the perfect attainment of the highest good—the unconditioned totality of ends which would uphold the perfect proportionality between moral virtue and happiness—as both the ground of hope for deserved happiness and the final end of our moral life. But I argue that Kant moved in the direction of de-emphasizing the latter aspect of the highest good, not because it is inappropriate or impossible for us to promote this ideal, but because the endless pursuit of it offers no prospect of moral satisfaction. I take this change as one possible reason for him to shift his focus more toward social and political progress in history, which has as its main subject the human species which is in some sense immortal.",
    abstract_source = "s2"
}

