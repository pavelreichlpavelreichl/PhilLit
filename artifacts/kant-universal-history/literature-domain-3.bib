@misc{zammito2008naturalistic,
    author = "Zammito, John",
    title = "Kant's ``Naturalistic'' History of Mankind? Some Reservations",
    year = "2008",
    note = "CORE ARGUMENT: Responds to Wood's naturalist reconstruction of Kant's philosophy of history with three reservations: Kant's biology is still an emergent science; extending 'natural predisposition' (Anlage) to reason and freedom is questionable; and providence plays an excessive role, so the account is not naturalist. Concludes that the philosophy of history is among the less persuasive parts of Kant's system. RELEVANCE: Resists both the naturalist and the tidy regulative reading; targets the Anlagen-develop-in-the-species thesis (Second Proposition) and the plan-of-nature talk. POSITION: Sceptical critique of the coherence of Kant's historical teleology.",
    keywords = "critique, naturalism, teleology, resists-regulative-reading, High, METADATA\\\_CLEANED: number, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {Abstract Among many important claims, Allen Wood in Kant's Ethical ought proposes that Kant's philosophy of history can be grasped as a "naturalist" approach, grounding human nature in biology. I suggest some reservations. First, I question Kant's conception of biology as (a still emergent) science. Second, I question Kant's extension of his notion of "natural predisposition" to reason and freedom. Third, I question the naturalism of Kant's philosophy of history by suggesting the excessive role providence must play in Kant's account. The upshot is to find Kant's philosophy of history one of the less persuasive elements in his system of thought, despite Wood's energetic effort at a contemporary reconstruction.},
    abstract_source = "openalex"
}

@misc{cohen2008biological,
    author = "Cohen, Alix",
    title = "Kant's Biological Conception of History",
    year = "2008",
    note = "CORE ARGUMENT: Argues that Kant's philosophy of history is modelled on his philosophy of biology; the species resembles an organism, so the teleological view of history stems from his conception of teleology and not only from ethics. History admits a mechanical, empirical element, and teleological history is heuristically useful for scientific history. RELEVANCE: Supplies a CPJ-grounded account of why the Anlagen develop fully only in the species and of the Leitfaden's methodological role as a guide for empirical history. POSITION: Regulative-heuristic reading anchored in organism teleology (biology-first rather than ethics-first).",
    keywords = "natural-teleology, biology, history, High, METADATA\\\_CLEANED: number, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Abstract The aim of this paper is to argue that Kant's philosophy of biology has crucial implications for our understanding of his philosophy of history, and that overlooking these implications leads to a fundamental misconstruction of his views. More precisely, I will show that Kant's philosophy of history is modelled on his philosophy of biology due to the fact that the development of the human species shares a number of peculiar features with the functioning of organisms, these features entailing important methodological characteristics. From this main claim will follow three further claims: (1) Kant's teleological view of history is not simply based on ethical considerations that have to do with the moral progress of the human species; rather, it stems from his conception of teleology as developed in his philosophy of biology. (2) Kant's philosophy of history allows for the practice of scientific history. In this sense, Kant's view of history is not merely teleological but involves a mechanical (and thus empirical) element. (3) Just as teleology is useful for furthering mechanical accounts of biological phenomena, teleological history is useful for scientific history.",
    abstract_source = "openalex"
}

@misc{rauscher2002regulative,
    author = "Rauscher, Frederick",
    title = "The Regulative and the Constitutive in Kant's and Hegel's Theories of History",
    year = "2002",
    note = "CORE ARGUMENT: Finds an ambiguity in Kant's theory of history: Kant wants to separate empirical history from reason's a priori regulative role, but his account of the sciences and of reason precludes such a separation. Hegel's theory, in which understanding and reason jointly constitute history, is presented as more consistent. RELEVANCE: Raises the objection that the regulative/empirical division underlying the Leitfaden is unstable; directly relevant to the a priori versus empirical history question and the Kant-Hegel reception link. POSITION: Resists a stable regulative reading; Hegelian critique of Kant.",
    keywords = "regulative-constitutive, Hegel, High, METADATA\\\_CLEANED: number, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "I show one reason why Hegel’s theory of history is an improvement over Kant’s. There is an ambiguity in Kant’s theory of history. He wants, on the one hand, to distinguish empirical history (and, by extension, other empirical sciences which constitute experience) from reason’s a priori regulative role in theory. On the other hand, his view of the nature of sciences and the role of reason precludes such a separation. I trace this problem to different roles assigned the faculties of understanding and reason in our experience. In Hegel’s theory of history, both reason and understanding together constitute the sciences, and thus experience. Hegel argues that history is a unified field employing both understanding and reason. I conclude that the more consistent theory of history for idealists is Hegel’s, and that this consistency partially explains the movement in German Idealism from Kantian to Hegelian thought.",
    abstract_source = "openalex"
}

@misc{allison2009teleology,
    author = "Allison, Henry E.",
    title = "Teleology and history in Kant: the critical foundations of Kant's philosophy of history",
    year = "2009",
    note = "CORE ARGUMENT: Opens from the observation that the essay's title contains the technical term 'Idea', and connects the Idea of universal history to the regulative role of ideas of reason in guiding the understanding toward systematic unity (A316/B372-3 on the Platonic republic). Presents the critical foundations of the philosophy of history. RELEVANCE: Standard statement of the regulative reading tying the 1784 Leitfaden to the first Critique's Appendix and to the CPJ; the main interlocutor for the constitutive/regulative question. POSITION: Regulative reading (Allison).",
    keywords = "critical-foundations, teleology, regulative, High, METADATA\\\_CLEANED: publisher, booktitle, pages, type:@incollection->@misc, METADATA\_CLEANED: doi",
    abstract = "Although the title of Kant's essay Idea for Universal History with a Cosmopolitan Aim indicates its central theme, it reveals little or nothing about its underlying methodology and its connection with the emerging critical philosophy. Indeed, as far as the title is concerned, the only hint of a connection with the latter is provided by the inclusion of the term “Idea.” This is a technical term for Kant referring to concepts of reason, which, as distinct from concepts of the understanding, whose legitimate use is restricted to possible experience, involve the thought of an absolute totality or completeness that can never be met with in a possible experience and is, therefore, “transcendent” with respect to the latter. In the first Critique , Kant's appealed to the Platonic republic and a constitution that provides for “the greatest human freedom according to laws that permit the freedom of each to exist together with that of others ” as examples of such ideas (A 316/B 372–3); but his focus was on the “transcendental Ideas” (the soul, the world, and God), which arise from extending certain concepts of the understanding to the “unconditioned,” thereby producing the thought of a complete systematic unity. While illusory, in the sense that no real object corresponds to them, these Ideas nonetheless play an essential regulative role in guiding the understanding in its endemic search for unity in experience.",
    abstract_source = "openalex"
}

