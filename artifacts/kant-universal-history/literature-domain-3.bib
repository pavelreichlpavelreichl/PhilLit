@misc{chen2023nonconstitutive,
    author = "Chen, Bohang",
    title = "Why Is Biological Teleology Non-constitutive (Merely Regulative) for Kant?",
    year = "2023",
    note = "CORE ARGUMENT: Asks why biological teleology is merely regulative for Kant. Rejects the view that natural purposes are merely subjective heuristic maxims since Kant treats them as indispensable for identifying organisms, and argues that teleology is non-constitutive because of how the concept of natural purpose is related to the formative powers (abstract truncated). RELEVANCE: Clarifies the meaning of 'regulative' in the CPJ, which the regulative reading of the 1784 Leitfaden presupposes. POSITION: Indispensable-but-regulative account of natural teleology.",
    keywords = "regulative-constitutive, natural-purposes, Medium, METADATA\_CLEANED: journal, volume, doi, type:@article->@misc",
    abstract = "There is no doubt that Kant assigns a merely regulative function to biological teleology. But the reasons for Kant’s doing so are less clear. For some Kant scholars, Kant does so because, for him, the concept of natural purpose amounts at best to a subjective maxim of certain heuristic values. Appealing as it is, this view runs into difficulties when other Kant scholars note that Kant takes biological teleology to be indispensable and uses the natural purpose concept to identify biological organisms (or, more precisely speaking, formative powers). I argue that Kant treats biological teleology as non-constitutive (i.e., merely regulative), because the concept of natural purpose is not associated with any supporting laws (biological organisms as instances or particulars of the concept of natural purpose are given, but the concept itself as a universal is only assumed).",
    abstract_source = "s2"
}

@misc{mcnulty2022speculations,
    author = "McNulty, Michael Bennett",
    title = "A science for gods, a science for humans: Kant on teleological speculations in natural history",
    year = "2022",
    note = "CORE ARGUMENT: Shows that Kant, while rejecting speculative developmental histories (Buffon, Herder), himself uses teleological speculation in natural history, especially in the race essays; speculation about nature's purposes is argued to be needed to unify organisms into real species despite heritable variation. RELEVANCE: Bears on how teleological hypotheses about the species operate in Kant's natural history and so on the status of the species-level Anlagen claim and the Herder dispute. POSITION: Teleology as necessary speculation in natural history.",
    keywords = "natural-history, teleology, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {Kant's forthright rejection of rampant, ungrounded speculations in natural science, including in natural history, is well known. For instance, he dismisses the wild, unwarranted developmental histories of other early natural historians, such as Buffon and Herder, as "daring adventure[s] of reason." However, as I show in this paper, Kant himself made use of teleological speculations in natural history, particularly in his three essays on race. I argue that, for Kant, speculations about nature's purposes are necessary to explain and to buttress the unification of organisms in real species, despite observable and heritable variations among members of these species. Without hypothesizing about nature's intentions, a mechanical, efficient-causal account of nature cannot appropriately ground the unity of species. Hence, I depict Kant's account of natural history as threading a needle between merely mechanical accounts of nature - which are incapable of achieving the goals of the science - and freewheeling, conjectural narratives about the origin and development of the Earth, life, and humanity. In the end, I conclude that my account reveals a substantive role for the faculty of reason in natural history, which dovetails with recent work on Kant's views on the non-physical sciences.},
    abstract_source = "s2"
}

@article{marwah2022white,
    author = "Marwah, Inder S.",
    title = "White Progress: Kant, Race and Teleology",
    journal = "Kantian Review",
    year = "2022",
    note = "CORE ARGUMENT: Argues that the teleological framework of Kant's natural history and teleological judgment makes race intelligible only in relation to a teleology that limits non-whites' capacity for moral progress. RELEVANCE: Argues that historical teleology carries substantive, non-innocent commitments, resisting a purely heuristic reading of the plan of nature; links Domain 3 to Domain 6 critiques. POSITION: Critical reading of Kant's teleology as racialized.",
    keywords = "teleology, race, critique, resists-regulative-reading, Medium, METADATA\\\_CLEANED: number, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Abstract This article examines how Kant’s conceptualizations of natural history and teleological judgement shape his understanding of human difference and race. I argue that the teleological framework encasing Kant’s racial theory implies constraints on the capacity of non-whites to make moral progress. While commentators tend to approach Kant’s racial theory in relation to his political theory, his late-life cosmopolitanism, and his treatments (or non-treatments) of colonialism, empire and slavery, the problem I focus on here is that race is itself only intelligible in relation to a teleological natural history limiting certain races’ capacities to engage in humanity’s moral vocation.",
    abstract_source = "s2"
}

@article{klein2022permissive,
    author = "Klein, Joel T.",
    title = "Permissive Laws and Teleology in Kant's Juridical and Political Philosophy",
    journal = "Kantian Review",
    year = "2022",
    note = "CORE ARGUMENT: Argues that permissive law in Kant's Doctrine of Right is best understood by relating it to practical teleology, and that the system of right is itself teleologically situated, so that the Doctrine of Right plays the role of a realist utopia. RELEVANCE: Extends practical teleology of history into the juridical domain and echoes the Idea essay's republican-constitution aim. POSITION: Practical-teleology reading of Kant's political philosophy.",
    keywords = "practical-teleology, right, Low, METADATA\\\_CLEANED: number, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Abstract In this article I argue that the current readings of permissive law fall into hermeneutical difficulties and do not completely explain Kant’s complex use of the concept. I argue that the shortcomings of these interpretations can only be overcome by relating permissive law to practical teleology. That teleological thinking has a role in Kant’s moral thought by way of history is not new. Here, however, I argue that the system of rights itself is in some manner teleologically situated. This interpretation allows us to understand that Kant’s Doctrine of Right plays the role of a realist utopia.",
    abstract_source = "s2"
}

@article{ypi2010natura,
    author = "Ypi, Lea",
    title = "Natura Daedala Rerum? On the Justification of Historical Progress in Kant's Guarantee of Perpetual Peace",
    journal = "Kantian Review",
    year = "2010",
    note = "CORE ARGUMENT: Analyses the teleological argument for historical progress in the Guarantee of Perpetual Peace, starting from controversies over the claim that nature's teleology supports providential development. Argues the argument must be assessed with respect to the problem of coordination (the highest good as historical end) and the problem of continuity across generations, drawing on post-CPJ developments. RELEVANCE: Gives a CPJ-informed assessment of whether the plan-of-nature teleology justifies progress, and ties to the species-versus-individual development thesis. POSITION: Moral-teleological defence with attention to its limits.",
    keywords = "guarantee, nature, progress, High, METADATA\\\_CLEANED: number, METADATA\_CLEANED: volume, pages, doi",
    abstract = "This article analyses the teleological argument justifying historical progress in Kant's Guarantee of Perpetual Peace. It starts by examining the controversies produced by Kant's claim that the teleology of nature supports the idea of a providential development of humanity towards moral progress and the possibility of achieving a cosmopolitan political constitution. It further illustrates how Kant's teleological argument in Perpetual Peace needs to be assessed with reference to two systematically relevant issues: first, the problem of coordination linked to the necessity of realizing the ‘highest good’ as a historical end of practical reason, and secondly the problem of continuity posed by the temporal limitation of all individual efforts to cultivate moral dispositions. To illustrate the implications of both issues for the teleological argument in Perpetual Peace , the article draws attention to some important developments in Kant's analysis of teleology following the Critique of Judgment .",
    abstract_source = "openalex"
}

@misc{lenczewska2025history,
    author = "Lenczewska, Olga",
    title = "Kant on the History and Development of Practical Reason",
    year = "2025",
    note = "CORE ARGUMENT: Presents Kant's teleological history of human reason, connecting the speculative account of the beginning of rationality in 'Conjectural Beginning' to his theory of progress, and elucidating hopes for progress and guidelines for achieving it. RELEVANCE: Recent treatment of the species-level development of rational capacities, which is the thesis of the 1784 Second Proposition. POSITION: Teleological-developmental account of reason's history.",
    keywords = "history-of-reason, teleology, Medium, METADATA\\\_CLEANED: publisher, type:@book->@misc, METADATA\_CLEANED: doi",
    abstract = "This Element's focus is Kant's history of human reason: his teleological vision of the past development of our rational capacities from their very emergence until Kant's own 'age of Enlightenment.' One of the goals is to connect Kant's speculative account of the very beginning of rationality – a topic that has thus far been largely neglected in Kantian scholarship – to his well-known theory of humankind's progress. The Element elucidates Kant's hopes with regard to reason's future progress and his guidelines for how to achieve this progress by unifying them with his vision of reason's past. Another goal is to bring more attention to Kant's essay 'Conjectural Beginning of Human History,' where this account is presented, and to show that this unusual text does not stand in conflict with Kant's philosophy and is not merely tangentially related to it, but illuminates and complements certain aspects of his critical philosophy.",
    abstract_source = "s2"
}

@article{lenczewska2022collective,
    author = "Lenczewska, Olga",
    title = "From Rationality to Morality: The Collective Development of Practical Reason in Kant's Moral Anthropology",
    journal = "Kantian Review",
    year = "2022",
    note = "CORE ARGUMENT: Reconstructs Kant's account of the emergence of reason and the collective development of practical reason from his conjectural and literal remarks, against the assumption that the beginning of history is philosophically negligible. RELEVANCE: Concerns species-level development of predispositions via history rather than individual life. POSITION: Moral-anthropological reading of history.",
    keywords = "species-development, moral-anthropology, Medium, METADATA\\\_CLEANED: number, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Abstract While Kant’s account of humankind’s rational progress has been widely discussed, his speculative views about the way in which this progress might havebegunand the circumstances surrounding this beginning have been largely neglected. Implicit in such an omission is the assumption that Kant does not say much about the very beginning of human history or that whatever he says is of little philosophical value. This article challenges these assumptions. I reconstruct Kant’s account of the emergence of reason by looking at his various conjectural and more literal remarks about our species’ transition from mere irrational animals into primitive human beings possessing a rudimentary form of rationality. Next, I show how this account fits with Kant’s broader view of humankind’s rational progress and its subsequent stages. By doing so, I elucidate Kant’s guidelines for achieving this progress in the future by unifying them with his regulative view of reason’s past.",
    abstract_source = "openalex"
}

@misc{filieri2025aim,
    author = "Filieri, Luigi",
    title = "Aim of Nature, Aims of Freedom",
    year = "2025",
    note = "CORE ARGUMENT: Comments on Ostaric's chapter 'Kant's Teleological Philosophy of History' and questions the role assigned to nature's alleged aim in human history, suggesting that moral development, progress, civilization and culture mirror aims of freedom, not of nature. RELEVANCE: Recent critical challenge to the nature-as-agent teleology of the 1784 essay and its CPJ interpretation. POSITION: Critique of nature-based teleology in favour of freedom-based aims.",
    keywords = "nature-freedom, teleology, Medium, METADATA\\\_CLEANED: number, pages, METADATA\_CLEANED: journal, volume, doi, type:@article->@misc",
    abstract = "In these comments, I focus on Chapter 9 of Lara Ostaric’s The Critique of Judgment and the Unity of Kant’s Critical System, titled “Kant’s Teleological Philosophy of History.” My aim is to share some questions and critical remarks concerning the role that Ostaric assigns to nature’s alleged aim in human history, and suggest that moral development, progress, civilization, and culture all mirror aims of freedom – not of nature.",
    abstract_source = "s2"
}

