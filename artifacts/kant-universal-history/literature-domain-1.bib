@misc{beiser2011historicist,
    author = "Beiser, Frederick C.",
    title = "The German Historicist Tradition",
    year = "2012",
    note = "CORE ARGUMENT: Presents the first English-language history of German historicism, the tradition holding that history is the key to understanding human values, beliefs and actions, surveying thinkers from the mid-eighteenth to the early twentieth century (per the publisher abstract). RELEVANCE: Provides a framework in which Herder's (and later historicists') objections to Kant's Idea are read as historicist; useful for assessing how far the Kant-to-Hegel narrative (and the Kant-vs-historicism contrast) is a construction of this tradition's own self-understanding. POSITION: Historicist reading of the Herder-Kant divide; supports the standard narrative while making its categories explicit.",
    keywords = "historicism, herder, kant, reception, High, METADATA\\_CLEANED: publisher, year:2011->2012, type:@book->@misc, METADATA\_CLEANED: doi",
    abstract = "This is the first history in English of German historicism, the intellectual tradition which holds that history is the key to understanding all human values, beliefs and actions. Beiser surveys the key thinkers from the mid-18th to the early 20th century and illuminates the sources and reasons for this revolution in modern thought.",
    abstract_source = "openalex"
}

