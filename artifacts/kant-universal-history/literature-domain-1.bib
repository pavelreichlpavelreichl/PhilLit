    abstract = "Article Realitätsferner Utopismus oder hellsichtige Gegenwartskritik? Zur politischen Philosophie des späten Natorp was published on January 24, 2006 in the journal Journal for the History of Modern Theology / Zeitschrift für Neuere Theologiegeschichte (volume 12, issue 2).",
    abstract_source = "openalex"
