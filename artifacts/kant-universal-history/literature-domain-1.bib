@misc{sikka2007herder,
    author = "Sikka, Sonia",
    title = "On the Value of Happiness: Herder contra Kant",
    year = "2007",
    note = "CORE ARGUMENT: Contrasts Herder's positive valuation of happiness and its diversity across cultures with Kant's subordination of happiness to morality and to the progress of the species, presenting Herder's view as a considered rival and not a mere relativism. RELEVANCE: Bears on the Kant-Herder conflict over whether individual and cultural flourishing is a mere means to species-level development (the Idea's third and fourth propositions) and provides an ethical, not only methodological, source of Herder's objection. POSITION: Herder-contra-Kant; pluralist/eudaimonist critique of Kantian progress.",
    keywords = "herder, kant, happiness, pluralism, resisting-narrative, High, METADATA\\_CLEANED: number, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Introduction In November of 1785, Kant published a highly unsympathetic review of the second part of Johann Gottfried Herder'sIdeas for a Philosophy of the History of Mankind. Herder had once been Kant's pupil, and had greatly admired his teacher, but the content of this review shows how profound the philosophical differences between them had by then become. A central area of dispute emerging from the review concerns the nature of happiness, and its place within the ‘destiny’ or ‘vocation’ (Bestimmung) of the human race. Kant is responding, in particular, to a section of theIdeasentitled: ‘The happiness (Glückseligkeit) of human beings is everywhere an individual good; consequently, it is everywhere climatic and organic, a child of practice, tradition, and custom.’ Although Kant is not mentioned by name in this section, it clearly contains critical rejoinders, often quite harsh in tone, to aspects of his practical philosophy and philosophy of history, as Herder understands them.",
    abstract_source = "openalex"
}

@misc{sikka2011herder,
    author = "Sikka, Sonia",
    title = "Herder on Humanity and Cultural Difference",
    year = "2011",
    note = {CORE ARGUMENT: Argues that Herder defends an "enlightened relativism": a view that combines recognition of deep cultural difference with a universal conception of humanity, with chapters on history and human destiny, race, language and world, and the place of reason. RELEVANCE: The chapter "History and human destiny" bears directly on Herder's reply to Kantian universal history; the book supports reading Herder's pluralism as compatible with a developmental conception of humanity, resisting the historicism-versus-universalism opposition. POSITION: Revisionist reading of Herder, between relativism and universalism.},
    keywords = "herder, pluralism, relativism, resisting-narrative, High, METADATA\\_CLEANED: publisher, type:@book->@misc, METADATA\_CLEANED: doi",
    abstract = "Herder is often criticized for having embraced cultural relativism, but there has been little philosophical discussion of what he actually wrote about the nature of the human species and its differentiation through culture. This book focuses on Herder's idea of culture, seeking to situate his social and political theses within the context of his anthropology, metaphysics, epistemology, ethics, theory of language and philosophy of history. It argues for a view of Herder as a qualified relativist, who combined the conception of a common human nature with a belief in the importance of culture in developing and shaping that nature. Especially highlighted are Herder's understanding of the relativity of virtue and happiness, and his belief in the impossibility of constructing a single best society. The book will appeal to a wide range of readers interested both in Herder and in Enlightenment culture more generally.",
    abstract_source = "openalex"
}

