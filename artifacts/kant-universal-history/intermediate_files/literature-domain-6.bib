    note = "CORE ARGUMENT: Examines how Kant's racism relates to his moral universalism and whether the latter can be separated from the former. (Published in Philosophical Papers 45, pp. 1--36, per Semantic Scholar; no abstract retrieved.) RELEVANCE: Defence/rescue pole for the question of whether Kant's critical philosophy can be detached from his racial views. POSITION: Moral universalism versus racism debate; partial rescue.",
    keywords = "kant, race, universalism, allais, High, INCOMPLETE, no-abstract"
}

