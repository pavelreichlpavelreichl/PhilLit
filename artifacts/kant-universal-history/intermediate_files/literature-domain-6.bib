@misc{kleingeld2007second,
    author = "Kleingeld, Pauline",
    title = "Kant's Second Thoughts on Race",
    year = "2007",
    note = "CORE ARGUMENT: Kleingeld argues that Kant's views on race changed in the 1790s: he dropped his earlier hierarchy of races and the claim that racial predispositions bear on moral and political capacity, and endorsed human equality and critiques of slavery and colonialism. This is the origin of the change-of-mind thesis. (Annotation based on the paper's well-known thesis as discussed in the other entries; no abstract retrieved.) RELEVANCE: Sets the baseline against which later critics (Lu-Adler, Mills, Bernasconi) argue; bears on whether the 1784 Ninth Proposition and teleology are Kant's final word on non-European peoples. POSITION: Change-of-mind / repair reading.",
    keywords = "kant, race, change-of-mind, kleingeld, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "During the 1780s, as Kant was developing his universalistic moral theory, he published texts in which he defended the superiority of whites over non‐whites. Whether commentators see this as evidence of inconsistent universalism or of consistent inegalitarianism, they generally assume that Kant's position on race remained stable during the 1780s and 1790s. Against this standard view, I argue on the basis of his texts that Kant radically changed his mind. I examine his 1780s race theory and his hierarchical conception of the races, and subsequently address the question of the significance of these views, especially in the light of Kant's own ethical theory. I then show that during the 1790s Kant restricts the role of the concept of race, and drops his hierarchical account of the races in favour of a more genuinely egalitarian and cosmopolitan view.",
    abstract_source = "openalex"
}

@misc{kleingeld2014colonialism,
    author = "Kleingeld, Pauline",
    title = "Kant's Second Thoughts on Colonialism",
    year = "2014",
    note = "CORE ARGUMENT: Extends the second-thoughts thesis from race to colonialism: Kant's later juridical writings criticize European colonial conduct, in contrast with his earlier remarks on non-European peoples. (Based on title and volume context; no abstract retrieved.) RELEVANCE: Bears on whether cosmopolitan right in the later works corrects the Eurocentrism of the 1784 essay. POSITION: Change-of-mind / repair reading.",
    keywords = "kant, colonialism, cosmopolitan-right, kleingeld, High, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Kant is widely regarded as a fierce critic of colonialism. In Toward Perpetual Peace and the Metaphysics of Morals, for example, he forcefully condemns European conduct in the colonies as a flagrant violation of the principles of right. His earlier views on colonialism have not yet received much detailed scrutiny, however. This essay argues that Kant actually endorsed and justified European colonialism until the early 1790s. The chapter shows that Kant’s initial endorsement and his subsequent criticism of colonialism are closely related to his changing views on race, because his endorsement of a racial hierarchy plays a crucial role in his justification of European colonialism. He gave up both in the mid 1790s while he was developing his legal and political philosophy, and he adopted a more egalitarian version of the cosmopolitan relationship among peoples.",
    abstract_source = "openalex"
}

@article{lu-adler2022lazy,
    author = "Lu-Adler, Huaping",
    title = "Kant on Lazy Savagery, Racialized",
    journal = "Journal of the History of Philosophy",
    year = "2022",
    note = "CORE ARGUMENT: Kant uses a concept of savagery, partly defined by laziness, to envision a program of human progress, and racializes it: Native Americans are treated as literal savages with a hereditary physiological laziness. Though granted the same germs of perfection as Europeans, they are denied any prospect of fulfilling them, since progress runs through industry. RELEVANCE: Directly links Kant's racism to the progress narrative of the philosophy of history, the structure at issue in the 1784 Idea's account of unsocial sociability, culture and the Europe-centred course. POSITION: Continuity reading; racism internal to the teleological program of progress.",
    keywords = "kant, race, progress, savagery, lu-adler, High, METADATA\\_CLEANED: volume, number, pages, doi",
    abstract = {abstract:Kant develops a concept of savagery, partly characterized by laziness, to envision a program for human progress. He also racializes savagery, treating native Americans, in particular, as literal "savages." He ascribes to this "race" a peculiar physiological laziness, a supposedly hereditary trait of blunted life power. Accordingly, while he grants them the same "germs" for perfections as he does the "civilized" Europeans, he allows them no prospect of fulfilling any such perfection. For the road to perfection must be paved through industry, a condition that Kant denies to the "savages" by racializing their alleged laziness. This case will shed new light on the debated relation between Kant's moral universalism and his racism.},
    abstract_source = "s2"
}

@misc{lu-adler2023race,
    author = "Lu-Adler, Huaping",
    title = "Kant, Race, and Racism: Views from Somewhere",
    year = "2023",
    note = "CORE ARGUMENT: A book-length study of Kant's race theory and its relation to racism, reconceptualizing his position as philosopher and educator within power relations that shaped modern racial ideology, including the link between racism and Kant's historiography of philosophy (per the reviews and discussions in this file). RELEVANCE: Central contemporary reference for any account of Prop. 9 and teleology as racialized; see the discussion pieces by Huseyinzadegan, Mosayebi, Smith and Marwah. POSITION: Continuity reading with a structural, non-individualistic notion of racism.",
    keywords = "kant, race, racism, lu-adler, book, High, METADATA\\_CLEANED: doi, type:@book->@misc",
    abstract = "Abstract Kant scholars have paid relatively little attention to his raciology. They assume that his racism, as personal prejudice, can be disentangled from his core philosophy. They also assume that racism contradicts his moral theory. This book challenges both assumptions. It shows how Kant’s raciology—divided into racialism and racism—is integral to his philosophical system as a whole. It also rejects the individualistic approach to Kant and racism. Instead, it uses the notion of racism as ideological formation to demonstrate how Kant, from his social location both as a prominent scholar and as a lifelong educator, participated in the formation of modern racist ideology. As a scholar, Kant developed a groundbreaking scientific theory of race from the standpoint of a philosophical investigator of nature or Naturforscher. As an educator, he transmitted denigrating depictions of the racialized others and imbued them with normative relevance. In both roles, he presented a worldview that excluded nonwhites from such goods as recognitional respect and candidacy for cultural and moral achievements. Some effects of this worldview are still palpable today. Scholars who research and teach Kant’s philosophy therefore have an unshakable burden to take part in the ongoing antiracist struggles, through their teaching practices as well as their scholarship. And they must do so in a color-conscious as opposed to colorblind way, with a pragmatic attention to nonideal social realities and a clear normative orientation toward substantial racial justice, equality, and inclusion.",
    abstract_source = "openalex"
}

@misc{allais2016racism,
    author = "Allais, Lucy",
    title = "Kant's Racism",
