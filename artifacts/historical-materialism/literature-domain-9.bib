@misc{hartmann1979unhappy,
    author = "Hartmann, Heidi I.",
    title = "The Unhappy Marriage of Marxism and Feminism: Towards a More Progressive Union",
    year = "1979",
    number = "2",
    note = {CORE ARGUMENT: Hartmann argues that Marxist categories of production are, by themselves, "sex-blind": they explain the drive to accumulate capital but not why it is specifically women who perform unpaid domestic labor and occupy subordinate positions in the wage hierarchy. She proposes "dual-systems theory," treating patriarchy as a distinct social structure with its own material base -- men's control over women's labor power, secured historically through control of property, the exclusion of women from desirable occupations, and the family wage -- that predates and interacts with, but is not reducible to, capitalism. RELEVANCE: This essay is the founding statement of the dual-systems position against which Vogel's and Bhattacharya's unitary social reproduction theory is explicitly constructed; it is the primary source for the dual-systems side of the central debate in this domain, and it directly challenges the sufficiency of a single-system base/ superstructure model for explaining gender oppression. POSITION: Dual-systems theory (patriarchy and capitalism as two distinct systems).},
    keywords = "dual-systems-theory, domestic-labor, patriarchy, base-superstructure, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {This paper argues that the relation between marxism and feminism has, in all the forms it has so far taken, been an unequal one. While both marxist method and feminist analysis are necessary to an understanding of capitalist societies, and of the position of women within them, in fact feminism has consistently been subordinated. The paper presents a challenge to both marxist and radical feminist work on the "woman question", and argues that what it is necessary to analyse is the combination of patriarchy and capitalism. It is a paper which, we hope, should stimulate considerable debate.},
    abstract_source = "openalex"
}

@misc{vogel2013marxism,
    author = "Vogel, Lise",
    title = "Marxism and the Oppression of Women: Toward a Unitary Theory",
    year = "2013",
    note = {CORE ARGUMENT: Originally published in 1983, Vogel argues against dual-systems theory that women's oppression under capitalism should be explained within a single, unitary historical-materialist framework. She locates the material basis of women's subordinate position in the necessity, under capitalism, of reproducing labor power generationally (bearing and raising children) and daily (through domestic maintenance work), work that capital does not pay for but that is structurally necessary to the reproduction of the working class as a whole. RELEVANCE: This is the foundational statement of the "unitary theory" alternative to Hartmann's dual-systems approach and the direct ancestor of Bhattacharya's social reproduction theory; it reworks Marx's categories of production and reproduction rather than supplementing them with a second system, making it central to how this domain answers the question of whether the base/superstructure model needs one system or two. POSITION: Unitary theory / early social reproduction theory.},
    keywords = "unitary-theory, social-reproduction, domestic-labor, base-superstructure, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    sep_context = {Cited in SEP "Feminist Perspectives on Class and Work" (feminism-class), sec. 2 ("Marxist-Feminist Analyses"): grouped with Benston 1969 and Hennessy 2003 as Marxist-feminists who "argued that women's work in biological and social reproduction is a necessary element of all modes of production and one often ignored by Marxist economists." Also cited in sec. 4 ("Second Wave Feminist Analyses of Housework"), grouped with Federici 1975/2004 and Malos 1975, as holding that "women's housework is part of the social reproduction of capitalism," such that "the necessary work of reproducing the working class is unpaid," which "allows more profits to capitalists."},
    abstract = {Nearly thirty years after its initial publication, Marxism and the Oppression of Women remains an essential contribution to the development of an integrative theory of gender oppression under capitalism. Lise Vogel revisits classical Marxian texts, tracking analyses of "the woman question" in socialist theory and drawing on central theoretical categories of Marx's Capital to open up an original theorisation of gender and the social production and reproduction of material life. Included in this edition are Vogel's article, "Domestic Labor Revisited" (originally published in Science \\& Society in 2000) which extends and clarifies her main theoretical innovations, and a new Introduction by Susan Ferguson and David McNally situating Vogel's work in the trajectory of Marxist-feminist thought over the past forty years.},
    abstract_source = "openalex"
}

@misc{vogel1996engels,
    author = "Vogel, Lise",
    title = "Engels's Origin: Legacy, Burden and Vision",
    publisher = "Palgrave Macmillan UK",
    year = "1996",
    note = "CORE ARGUMENT: Vogel assesses the legacy of Engels's The Origin of the Family, Private Property and the State from the standpoint of her own unitary theory, arguing that Engels correctly identifies the historical link between the rise of private property and women's subordination but leaves underdeveloped the mechanism connecting reproduction of labor power to capitalist production specifically, treating the household too much as a holdover from earlier modes of production rather than as integral to capitalism itself. RELEVANCE: This is a direct, book-length engagement by the leading unitary theorist with Engels's founding materialist account of gender oppression, evaluating what in Origin survives later anthropological and Marxist-feminist critique and what must be reconstructed -- exactly the adequacy question posed for this domain. POSITION: Unitary theory's critical retrieval of Engels.",
    keywords = "engels, origin-of-the-family, unitary-theory, critique, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Friedrich Engels's The Origin of the Family, Private Property and the State has functioned as an authoritative theoretical text for two quite different social movements: the socialist movement on the one hand, and the modern women's movement on the other. Since the end of the nineteenth century, socialists have taken the book as the definitive Marxist pronouncement on women and the family. Confronting capitalist exploitation and, often, feudal social relations as well, socialist parties and movements have valued the Origin for its critique of marriage as an oppressive economic institution, its interest in women's participation in social production, and its vision of freely-chosen sexual relations in a collectively organized society.",
    abstract_source = "openalex"
}

@misc{bhattacharya2017introduction,
    author = "Bhattacharya, Tithi",
    title = "Introduction: How Not to Skip Class: Social Reproduction of Labor and the Global Working Class",
    year = "2017",
    note = {CORE ARGUMENT: Bhattacharya reframes the relationship between production and reproduction not as two separate spheres to be linked, but as a single social process viewed from two analytical vantage points: the production of things and the production of the people who produce things are both moments of one capitalist totality. She argues this "expanded" conception of class dissolves the base/superstructure dualism that treats domestic and reproductive labor as merely derivative of, or external to, "real" production. RELEVANCE: This is the programmatic statement of contemporary social reproduction theory, the volume's title essay that other entries in this file (Ferguson, Goikoetxea, Falquet, Portella and Busk) build on, criticize, or extend; it directly proposes a revision of the base/superstructure model that treats reproduction as internal to the mode of production. POSITION: Contemporary social reproduction theory (unitary).},
    keywords = "social-reproduction-theory, unitary-theory, base-superstructure, class, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@article{blackledge2018engels,
    author = "Blackledge, Paul",
    title = "Frederick Engels, Social Reproduction, and the Problem of a Unitary Theory of Women's Oppression",
    journal = "Social Theory and Practice",
    year = "2018",
    number = "3",
    note = "CORE ARGUMENT: Blackledge defends Engels's Origin of the Family as a still-usable resource for a unitary materialist theory of women's oppression, against critics who treat it as either economically reductionist or superseded by anthropological findings about kinship. He argues that Engels's core claim -- that the modern nuclear family and women's subordination arise together with class society and private property -- can be reconstructed to ground a social-reproduction account without positing a separate patriarchal system. RELEVANCE: This paper directly answers the domain's third key question (Engels's adequacy and its critiques) and explicitly sides with the unitary/social-reproduction camp against dual-systems readings of the same problem, providing a contemporary philosophical defense of Engels that can be set against Vogel's more critical retrieval. POSITION: Unitary theory, via a sympathetic reconstruction of Engels.",
    keywords = "engels, origin-of-the-family, unitary-theory, critique, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = "In this paper I argue that Frederick Engels's The Origin of the Family, Private Property and the State remains a fundamental resource for anyone wanting to understand the oppression of women as a capitalist form. By re-examining the strengths and weaknesses of Engels's historicisation of women's oppression through the lens of the debates opened by second wave feminism, I argue that, once properly understood, we can overcome the limitations of Engels's book to point to the kind of unitary theory of women's oppression essential to a strategy adequate to the needs of the struggle for women's liberation.",
    abstract_source = "s2"
}

@article{portellabusk2024formal,
    author = "Portella, Elizabeth and Busk, Larry Alan",
    title = "The Formal and Real Subsumption of Gender Relations",
    journal = "Historical Materialism",
    year = "2024",
    number = "3",
    note = {CORE ARGUMENT: The authors argue that existing responses to the transhistorical status of patriarchy fall into two camps -- dual/triple-systems approaches, which grant patriarchy autonomy relative to capitalism, and "origins-subsistence" approaches, which give patriarchal relations a foundational status in capitalism's own history. They propose using Marx's concepts of formal and real subsumption to explain both capitalism's appropriation of pre-existing patriarchal forms and its production of new, specifically capitalist forms of gendered oppression, aiming for a unitary theory that avoids transhistorical claims about patriarchy. RELEVANCE: This paper directly engages the dual-systems/unitary debate as a debate about how to use core historical-materialist categories (subsumption, mode of production) to theorize gender, making it a useful bridge piece between Hartmann's dual-systems theory and social reproduction theory for synthesis purposes. POSITION: Unitary theory, reconstructed via formal/real subsumption.},
    keywords = "unitary-theory, dual-systems-theory, subsumption, base-superstructure, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = {Attempts to unify Marxist and feminist social critique have been vexed by the fact that "patriarchy" predates the advent of capitalism (its transhistorical status). Feminists within the Marxist, socialist, and materialist traditions have responded to this point by either granting patriarchy a certain autonomy relative to capitalism (the "dual/triple systems" approach), or by suggesting that patriarchal relations have a foundational and necessary status in the history of capitalist development (which we term the "origins-subsistence" approach). This paper offers an alternative account of the relationship between capitalism and the transhistorical status of "patriarchy". In aid of a "unitary theory" of Marxist Feminism, we argue that the transhistorical status of patriarchy is better understood through an application of Marx's concepts of formal and real subsumption. A modified version of these concepts can illuminate not only capitalist appropriation of antecedent social and economic forms, but also its capacity to produce new forms of gendered exploitation and oppression.},
    abstract_source = "s2"
}

@misc{goikoetxea2024idealism,
    author = "Goikoetxea, Jule",
    title = "Idealism and Biologism in Social Reproduction Theory: A Materialist Critique",
    year = "2024",
    number = "2",
    note = {CORE ARGUMENT: Goikoetxea offers a materialist interpretation of what she calls the "first, second and third Marxist-feminist theses," arguing through a critical analysis of the unitary theory tradition that some formulations of social reproduction theory smuggle in idealist or biologistic assumptions -- treating reproductive labor's significance as rooted in bodily/biological facts rather than in historically specific social relations of production. RELEVANCE: This is an internal critique of social reproduction theory from within the unitary/materialist camp, useful for showing that the dual-systems/unitary debate has an important second axis (materialist vs. idealist/biologistic readings of reproduction) that synthesis should not collapse into the dual-systems question alone. POSITION: Unitary/materialist critique of biologistic tendencies within social reproduction theory.},
    keywords = "social-reproduction-theory, materialism, critique, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The article gives a materialist interpretation of the first, second and third Marxist-feminist Theses through a critical analysis of the Unitary Theory of Social Reproduction. It argues that Social Reproduction Theory resorts to idealism and biologism when explaining male domination. A meta-critical incision will be carried out by studying the use Social Reproduction Theory makes of categories such as 'production', 'reproduction', 'exploitation' and 'oppression', in that these categories are addressed as historical while the categories of 'women' and 'men' are de-historicized and naturalized. According to Unitary Theories, 'women' are not material, historical products of patriarchy but biological beings (biologism) that have been culturally devalued (idealism). This leads to an essentialist ontology where 'women' and 'men' precede the relations of production that create them. This idea obstructs the formation of a materialist philosophy of praxis.",
    abstract_source = "s2"
}

@misc{falquet2024francophone,
    author = "Falquet, Jules",
    title = "Francophone Materialist Feminism, the Missing Link: Towards a Marxist Feminism That Accounts for the Interlockedness of Sex, Race and Class",
    year = "2024",
    number = "2",
    note = {CORE ARGUMENT: Falquet argues that Anglophone debates over dual-systems and social reproduction theory have largely ignored francophone materialist feminism (associated with Christine Delphy and others), which independently developed a theory of a "domestic mode of production" analytically distinct from, but articulated with, the capitalist mode of production, and which anticipated later attempts to theorize the interlocking of sex, race and class. RELEVANCE: This paper supplies the francophone materialist-feminist alternative (Delphy's domestic-mode-of-production thesis) that could not be independently verified as a standalone entry in this bibliography, and situates it relative to both dual-systems and unitary/social-reproduction positions, filling an important comparative gap. POSITION: Francophone materialist feminism (a distinct national-tradition variant of dual/multiple-systems theorizing).},
    keywords = "materialist-feminism, domestic-mode-of-production, delphy, intersectionality, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {This article discusses the Marxist-Feminist Theses III and VIII. It is based on the "French-speaking materialist feminist" theoretical perspective that has been developed at the end of the 1970s by Colette Guillaumin (with the concept of "sexage"), Monique Wittig (with the concept of "straight mind"), Nicole-Claude Mathieu, Christine Delphy and other members of the Nouvelles Questions Féministes journal's board. The article first presents this theorization, which is too unknown to many English-speaking theorists. It then shows how "French-speaking materialist feminist" theoretical perspective fully demonstrated that "sex" was a structural social relation as much as class is (Gender relations are relations of production). The article also analyses how this theoretical perspective enables us to pay a deep attention to the "race question". Therefore, it appears as the missing link that can help bridging at least two important theoretical and political gaps: first, between Marxist feminism and lesbian theory, and, second, between Black feminism and Marxist feminism.},
    abstract_source = "s2"
}

@article{ferguson2016intersectionality,
    author = "Ferguson, Susan",
    title = "Intersectionality and Social-Reproduction Feminisms",
    journal = "Historical Materialism",
    year = "2016",
    number = "2",
    note = {CORE ARGUMENT: Ferguson argues that social reproduction feminism has under-theorized its relationship to intersectionality, and that a more fully integrative ontology -- one that treats "the social" as constituted by practical human activity organized capitalistically -- can capture the dialectical relationship between the capitalist totality and its differentiated parts (race, gender, class) better than an additive intersectional model. RELEVANCE: This paper addresses a live tension within unitary social reproduction theory: whether its totalizing, unitary ontology is compatible with, or in competition with, intersectionality's emphasis on the irreducibility of multiple axes of oppression -- directly relevant to assessing SRT's adequacy as an extension of historical materialism. POSITION: Unitary social reproduction theory, seeking integration with intersectionality.},
    keywords = "social-reproduction-theory, intersectionality, unitary-theory, Medium, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Seeking to capture the multi-layered, contradictory, nature of subjectivities and social positions through a framework which insists upon the complex, dynamic nature of the social, intersectionality feminism has inspired Marxist-Feminists to push the social-reproduction feminism paradigm beyond a narrow preoccupation with gender/class relations. Yet even its most politically radical articulations stop short of fully theorising the integrative logic they espouse. This article explores the roots of this under-theorisation, and suggests that a more fully integrative ontology informs certain formulations of social-reproduction feminism. In understanding the social as constituted by practical human activity whose object (the social and natural world) is organised capitalistically, social-reproduction feminism highlights the dialectical relationship between the capitalist whole and its differentiated parts. The challenge for Marxist-Feminism is to embrace this dialectical approach while building on the insights of intersectionality feminism to more convincingly capture the unity of a complex, diverse social whole.",
    abstract_source = "openalex"
}

@misc{federici2021marx,
    author = "Federici, Silvia",
    title = "Marx on Gender, Race, and Social Reproduction: A Feminist Perspective",
    year = "2021",
    note = {CORE ARGUMENT: Federici argues that Marx's own analysis of capital accumulation systematically excludes reproductive labor and racialized/colonial labor from its conception of "productive" work, and traces the consequences of this exclusion for later Marxist treatments of sexism and racism. She contends that, despite this limitation, Marx's method (particularly on primitive accumulation) supplies resources feminists have used to establish social reproduction as a crucial terrain of capital accumulation and of anti-capitalist struggle. RELEVANCE: Federici, a key figure of the original Wages for Housework/domestic-labor debate, here directly assesses how far Marx's category of production can be extended to cover reproductive labor, connecting the 1970s domestic labor debate to contemporary social reproduction theory and situating both relative to Marx's own texts rather than only Engels's. POSITION: Autonomist/Wages-for-Housework-descended materialist feminism, read back onto Marx's own texts.},
    keywords = "domestic-labor-debate, social-reproduction, marx, primitive-accumulation, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{ida2022impact,
    author = "Ida, Kumiko",
    title = "Impact of Marxist Feminism on Japanese Women's Movement: Focusing on the Domestic Labor Debates",
    year = "2022",
    note = {CORE ARGUMENT: Ida traces how the domestic labor debate, imported to Japan after the 1980s and represented especially by Ueno Chizuko, shaped Japanese Marxist feminism's distinct engagement with historical materialism, including disputes over whether housework should be analyzed through the concept of a "household mode of production" or directly through Marx's categories of value and labor power. RELEVANCE: This paper documents the international reception and reworking of the domestic labor debate outside the Anglo-American and francophone contexts already represented in this bibliography, showing that the argument over how to extend historical-materialist categories to housework was a genuinely international current within Marxist feminism. POSITION: Domestic labor debate (Japanese reception).},
    keywords = "domestic-labor-debate, marxist-feminism, mode-of-production, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "The term Marxist feminism was introduced from the West and appeared in Japan after the 1980s. The representative theorist was Ueno Chizuko, who greatly contributed to the development of feminist theories in Japan, including Marxist feminism. It should be noted that this argument was not new in Japan, and in the 1970s, when the domestic labour theories began to be discussed in Western countries, there existed in Japan the original discussions by Takenaka Emiko, Iijima Aiko and others, which go back to the issue of socialist women, such as Yamakawa Kikue, before the Second World War. Of particular note was the 1960 housewife debate by Isono Fujiko and Mizuta Tamae, which had already pioneered Marxist feminism and most of the theorists in the 1970s succeeded the argument of the 1960s. Since the 1990s, the perspective of considering housework and childcare as labour has been reflected in social support for child and elderly care enacting the related laws. The change was accompanied by the women's labour movement and women's human rights issues such as the elimination of violence against women. It can be said that the recognition that 'housework is labour', formed by the domestic labour debate, as a whole, contributed to shake the patriarchal concept of labour and empowered the emergence of various movements concerning women that had been overlooked before.",
    abstract_source = "openalex"
}

@misc{liu2024domestic,
    author = "Liu, Jiahuan",
    title = "Is Domestic Labor Productive Labor: An Inquiry Based on Historical Materialism",
    year = "2024",
    note = {CORE ARGUMENT: Liu revisits the core question of the domestic labor debate -- whether unpaid housework is "productive labor" in Marx's technical sense (labor that produces surplus value) -- and argues that Western feminist Marxists have historically split into two incompatible positions (domestic labor as a distinct, non-capitalist mode of production versus domestic labor as directly value-producing), neither of which adequately accounts for its relation to capitalist accumulation. RELEVANCE: This paper offers a recent, explicit restatement of the analytical core of the domestic labor debate directly in Marx's categories of productive/unproductive labor, useful for a synthesis section that needs to state precisely what is at stake in extending "production" to housework. POSITION: Domestic labor debate (productive-labor question).},
    keywords = "domestic-labor-debate, productive-labor, value-theory, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {An important concern in contemporary feminist Marxist studies is the concept of "domestic labor." Western feminists present two different positions in the debate surrounding the question of whether domestic labor is productive labor. However, from the perspective of Marx's critique of political economy, neither position surpasses the basic theoretical framework of the capitalist mode of production. An analysis based on Marx's theory of the correlation between productive and unproductive labor reveals that this framework alone is insufficient for theorizing domestic labor. To highlight its theoretical significance, it is necessary to examine it within the framework of Marx's historical materialism.},
    abstract_source = "s2"
}

@misc{gabrielli2024wages,
    author = "Gabrielli, Martina",
    title = "'Wages for Housework': The Evolution of the Debate in the 1970s Italian Women's Movement",
    year = "2024",
    volume = "30",
    number = "1",
    note = {CORE ARGUMENT: Gabrielli reconstructs the historical trajectory of Lotta Femminista, the Italian separatist feminist network (including Dalla Costa and Fortunati) that launched the Wages for Housework campaign, showing how the group's theoretical position -- that housework produces value for capital even though it is unwaged -- developed and fragmented over the course of the 1970s. RELEVANCE: This paper provides the historical grounding for the "value-producing housework" wing of the domestic labor debate (associated with Dalla Costa and Fortunati), which is the position against which both Hartmann's dual-systems theory and Vogel's unitary theory later defined themselves; essential background for the domain's account of how the debate over "production" originated. POSITION: Wages for Housework (housework as directly value-producing).},
    keywords = "wages-for-housework, domestic-labor-debate, italy, value-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "This article delves into the historical trajectory of Lotta Femminista, a pioneering separatist feminist network in Italy during the early 1970s, and its significant influence on feminist discourse, particularly concerning the advocacy for wages for housework. Through an examination of the group's development within the broader context of the Italian women's movement, this study illuminates the theoretical foundations and practical activism associated with the perspective on wages for housework. Drawing on archival documents and personal accounts, the essay investigates how Lotta Femminista depicted domestic labour as a form of women's exploitation within a Marxist framework. Despite facing criticism and opposition, Lotta Femminista's ideas resonated globally, leaving a legacy in feminist theory and activism. Through its engagement with issues such as the refusal to work and the recognition of unpaid care as a site of capitalist exploitation, Lotta Femminista contributed to the broader history of feminism in Italy and beyond.",
    abstract_source = "s2"
}

@misc{blank2014production,
    author = "Blank, Gary",
    title = "Production and Patriarchy in Capitalist Society: A Comparative Review of Hartmann and Young",
    year = "2014",
    howpublished = "Analize: Journal of Gender and Feminist Studies, New Series, no. 2 (16)",
    note = {CORE ARGUMENT: Blank compares Hartmann's dual-systems theory with Iris Young's "single system" reply in "The Limits of Dual Systems Theory," arguing that Hartmann's account relies on a transhistorical structure (patriarchy as a cross-epochal system of male control over female labor) while Young's alternative risks functionalist reasoning (explaining the sexual division of labor by its usefulness to capital). He argues both approaches fall short of a genuinely historical-materialist theory that would explain the material basis of capitalist patriarchy without either move. RELEVANCE: This is a direct comparative assessment of the two founding positions in the dual-systems debate (Hartmann versus Young/proto-unitary theory), making it a natural bridge for synthesis between the primary Hartmann essay and the later unitary/social reproduction literature in this file. POSITION: Critical of both dual-systems theory and functionalist single-system replies; argues for a more genuinely historical-materialist alternative.},
    keywords = "dual-systems-theory, hartmann, young, critique, web-source, Medium, INCOMPLETE, no-abstract"
}

@misc{fortunati2024domestic,
    author = "Fortunati, Leopoldina",
    title = "The Domestic Sphere",
    year = "2024",
    note = {CORE ARGUMENT: Fortunati revisits the central claims of her own The Arcane of Reproduction: Housework, Prostitution, Labor and Capital (originally 1981), restating that the domestic sphere is not politically marginal but the site where personal and social reproduction is organized, and that this reproductive activity, while distinct from directly value-producing labor, is what maintains and renews labor power for capitalist production. RELEVANCE: Fortunati's Arcane of Reproduction is a foundational text of the domestic labor debate, arguing (against a simple "housework produces surplus value" reading) that reproduction creates use-values that are only later transformed into exchange-value in production; this retrospective essay, by the original author, restates that position for a contemporary readership and clarifies a frequently misread argument central to this domain. POSITION: Domestic labor debate (reproduction of labor power as distinct from, but necessary to, value production).},
    keywords = "domestic-labor-debate, social-reproduction, fortunati, Low, METADATA\_CLEANED: journal, number, doi, type:@article->@misc",
    abstract = {Leopoldina Fortunati's book 'The Arcane of Reproduction: Housework, Prostitution, Labor and Capital' (originally published in 1981), stands as one of the most important texts within 1970s feminist critique. This book has evolved and informed Fortunati's subsequent work on domestic and affective labor as well as her interaction with politics and technology. In this text, Fortunati argues that today the most important place of politics is the domestic sphere, the 'ground zero' of reproduction. As she writes: "Personal and social reproduction has completely changed the identity of the domestic sphere: from being considered by traditional political organizations as a place of political backwardness, it has become the beating heart at the social and political level of the entire capitalist system."},
    abstract_source = "s2"
}
