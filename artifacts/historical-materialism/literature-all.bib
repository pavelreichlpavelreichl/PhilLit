@incollection{woodellen1995rational,
  author = {Wood, Ellen Meiksins},
  title = {Rational Choice Marxism: Is the Game Worth the Candle?},
  booktitle = {Rational Choice Marxism},
  year = {1995},
  pages = {79--135},
  publisher = {Palgrave Macmillan UK},
  doi = {10.1007/978-1-349-24183-5_4},
  note = {
  CORE ARGUMENT: Critically assesses the claim, made on behalf of "rational
  choice Marxism," that it constitutes "a fully fledged paradigm" capable of
  doing the explanatory work of classical Marxist theory -- historical
  explanation, the collective dynamics of class struggle, and the evolution
  and evaluation of capitalism. Wood questions whether analytical Marxism's
  rational-choice wing, including Elster's individualist program, can
  actually deliver on these large claims. Originally published in New Left
  Review (1989); this incollection version is the 1995 reprint.

  RELEVANCE: A prominent critique, from outside the September Group, of the
  rational-choice/methodological-individualist program Elster represents
  within this domain's central debate, broadening the domain beyond the
  Cohen-Elster-Wood exchange to the wider critical reception of analytical
  Marxism's individualist wing.

  POSITION: Skeptical of rational choice Marxism's (including Elster's)
  claim to supersede classical Marxist explanatory categories.

  sep_context: Cited in SEP "Analytical Marxism" (marxism-analytical),
  Section 6 "Overarching Criticisms," quoting the 1989 New Left Review
  pagination directly: "it is suggested that analytical Marxism's treatment
  of exploitation, class, and history, involves an abstract, individualistic,
  and ahistorical, framework that makes its conclusions hard to distinguish,
  in many respects, from the theories of 'bourgeois social science' (E. Wood
  1989: 55)." Also cited in the same entry on the September Group's "donnish
  remoteness" (Wood 1989: 88).
  },
  keywords = {rational-choice, methodological-individualism, september-group, Medium},
  abstract = {Some time ago, in the pages of the New Left Review , a claim was made on behalf of ‘rational choice Marxism’ as ‘a fully fledged paradigm, which deserves to take its place beside the two other constellations of theory currently discernible within the broad spectrum of progressive social thought — namely, post-structuralism and critical theory’ (see above, pp. 61–2). More than that: ‘it is now only within the rational choice context that some of the leading items on the classical agenda of Marxist theory — historical explanation and delineation of social form, the collective dynamics of class struggle, the evolution and evaluation of capitalism — can be fruitfully discussed.’ These are very large claims, and if this new ‘paradigm’ can even partially live up to them, it deserves the vogue it is now enjoying in the Anglo-American academy. A theoretical advance in any one of the ‘leading items on the classical agenda of Marxist theory’ would be a worthy accomplishment; but it would indeed be a remarkable achievement if, even without driving any likely competitors from the field, this body of thought could be shown to merit the status of a ‘fully fledged paradigm’, a comprehensive theoretical ‘constellation’ with the explanatory range of classical Marxism. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.},
  abstract_source = {openalex},
}

@misc{brenner1976agrarian,
    author = "Brenner, Robert",
    title = "Agrarian Class Structure and Economic Development in Pre-Industrial Europe",
    year = "1976",
    volume = "70",
    number = "1",
    note = {CORE ARGUMENT: Brenner argues that comparable demographic and commercial trends in late-medieval England and France produced sharply divergent long-run outcomes — agrarian capitalism in England, continued peasant proprietorship and stagnation in France — because of differences in the class structure of lordship and the outcomes of lord-peasant class struggle, not because of differing exposure to trade or population pressure. It is the balance of class power, not commercialization or demography, that determines whether productivity-raising agrarian capitalism emerges. RELEVANCE: This is the founding document of Political Marxism, launching the "Brenner Debate" and establishing the method — explaining historical transitions through contingent outcomes of class struggle over property relations — that the rest of this domain elaborates, contests, and revises. It directly rejects the commercialization model that both liberal and orthodox-Marxist historians shared. POSITION: Class-relational, anti-determinist theory of the transition to agrarian capitalism.},
    keywords = "political-marxism, brenner-debate, transition-to-capitalism, class-struggle, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{brenner1982agrarian,
    author = "Brenner, Robert",
    title = "Agrarian Class Structure and Economic Development in Pre-Industrial Europe: The Agrarian Roots of European Capitalism",
    year = "1982",
    volume = "97",
    number = "1",
    note = {CORE ARGUMENT: Brenner extends his 1976 argument with a detailed comparative account of the "agrarian roots" of European capitalism, tracing how the specific balance of lord-peasant class power in different regions of Europe (England, France, Eastern Europe) determined whether agriculture was reorganized along capitalist lines. He gives particular attention to why the English peasantry lost, and the English aristocracy won, the struggle over property rights that elsewhere entrenched small peasant proprietorship or seigneurial reaction. RELEVANCE: Together with the 1976 essay, this is the primary textual basis for everything downstream in this domain — Wood's generalization of the argument into a theory of capitalist "social property relations," Comninel's extension to France, and the entire subsequent "Transition Debate." POSITION: Comparative class-relational account of the agrarian origins of capitalism, rejecting both Malthusian-demographic and commercialization explanations.},
    keywords = "political-marxism, brenner-debate, transition-to-capitalism, agrarian-class-structure, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@book{wood1995democracy,
    author = "Wood, Ellen Meiksins",
    title = "Democracy against Capitalism",
    year = "1995",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Wood argues that capitalism is historically distinctive in separating "the economic" from "the political": unlike feudal or ancient modes of production, where surplus extraction is inseparable from direct political/coercive power, capitalism extracts surplus through purely economic compulsion — market dependence — leaving direct coercive power concentrated in a nominally separate state. This "differentiation" explains both capitalism's peculiar dynamism and the limits it places on democracy, since formal political equality (citizenship) leaves the economic sphere of appropriation untouched. RELEVANCE: This is Wood's fullest theoretical statement of Political Marxism's core concept — capitalism-specific "social property relations" — generalizing Brenner's historical argument into a systematic theory that underwrites her later historical work and the whole Political Marxism research program addressed in this domain. POSITION: Foundational theoretical statement of Political Marxism's concept of capitalism as a historically specific set of social property relations.},
    keywords = "political-marxism, social-property-relations, capitalism-and-democracy, High, METADATA\_CLEANED: doi",
    abstract = "Ellen Meiksins Wood argues that with the collapse of Communism the theoretical project of Marxism and its critique of capitalism is more timely and important than ever. Current intellectual fashions of the left which emphasise 'post-modern' fragmentation, 'difference', contingency and the 'politics of identity' can barely accommodate the idea of capitalism, let alone subject the capitalist system to critique. In this book she sets out to renew the critical programme of historical materialism by redefining its basic concepts and its theory of history in original and imaginative ways, using them to identify the specificity of capitalism as a system of social relations and political power. She goes on to explore the concept of democracy in both the ancient and modern world, examining the concept's relation to capitalism, and raising questions about how democracy might go beyond the limits imposed on it by capitalism.",
    abstract_source = "openalex"
}

@book{comninel1987rethinking,
    author = "Comninel, George C.",
    title = "Rethinking the French Revolution: Marxism and the Revisionist Challenge",
    year = "1987",
    publisher = "Verso",
    address = "London",
    note = {CORE ARGUMENT: Comninel argues that the "classic" Marxist account of the French Revolution as a bourgeois revolution against feudalism rests on a class analysis that revisionist historians (Furet, Cobban) had already empirically refuted — there was no capitalist bourgeoisie confronting a feudal aristocracy in 1789. Rather than concede the ground to non-Marxist revisionism, Comninel reconstructs the Revolution using a Brenner-style class-relational method: the revolutionary struggle is explained as an internal conflict within a single, office-holding and rent-extracting ruling class over the political forms of surplus extraction, not as a struggle between capitalist and feudal classes. RELEVANCE: Extends Political Marxism's class-relational method from the agrarian transition to capitalism (Brenner's terrain) to the paradigmatic case of "bourgeois revolution," directly informing the later Teschke/Post/Davidson debate on whether and how revolutions can be theorized as "capitalist" without assuming a pre-existing bourgeois class. POSITION: Class-relational reinterpretation of the French Revolution against both revisionist and orthodox-Marxist "bourgeois revolution" narratives.},
    keywords = "political-marxism, french-revolution, bourgeois-revolution, comninel, High, INCOMPLETE, no-abstract"
}

@article{knafo2020political,
    author = "Knafo, Samuel and Teschke, Benno",
    title = "Political Marxism and the Rules of Reproduction of Capitalism: A Historicist Critique",
    journal = "Historical Materialism",
    year = "2020",
    volume = "29",
    number = "3",
    note = {CORE ARGUMENT: Knafo and Teschke argue that Political Marxism, despite its historicist origins in Brenner's emphasis on class agency and conflict, has increasingly drifted toward a structuralist "rules of reproduction" account of capitalism that treats capitalist laws of motion as a self-reproducing system — the very kind of structural determinism Political Marxism was originally meant to displace. They trace this tension back to an unresolved ambivalence already present in Brenner's own founding contributions to the Transition Debate, and call for a more thoroughly agency-based, praxis-centered reformulation. RELEVANCE: This is the pivotal internal critique that reopened debate on Political Marxism's coherence roughly forty years after the original Brenner Debate, prompting the 2021 Historical Materialism symposium (Pal, Rioux, Salgado, Lafrance, and others) and making explicit the risk that a "corrective" to determinism can itself relapse into structural determinism — directly relevant to this review's framing of Political Marxism as a corrective current. POSITION: Internal historicist critique and reformulation of Political Marxism against its own structuralist tendencies.},
    keywords = "political-marxism, historicism, rules-of-reproduction, internal-critique, High, METADATA\_CLEANED: pages, doi",
    abstract = "Marxism has often been associated with two different legacies. The first rests on a strong exposition and critique of the logic of capitalism, grounded in a systematic analysis of the laws of motion of capitalism as a system. The second legacy refers to a strong historicist perspective grounded in a conception of social relations that emphasises the centrality of power and social conflict to the analysis of history. This article challenges the prominence of structural accounts of capitalism by showing how the tension between these legacies has played out within Political Marxism, both orientations already having co-existed, somewhat uneasily, within Robert Brenner’s original contributions to the Transition Debate. Through this internal critique and re-formulation of Political Marxism, we wish to open a broader debate within Marxism on the need for a more agency-based account of capitalism, which builds more explicitly on the concept of social relations, to recover the historicist legacy of Marxism.",
    abstract_source = "s2"
}

@article{chibber2011living,
  author = {Chibber, Vivek},
  title = {What Is Living and What Is Dead in the Marxist Theory of History},
  journal = {Historical Materialism},
  year = {2011},
  volume = {19},
  number = {2},
  pages = {60--91},
  doi = {10.1163/156920611X573798},
  note = {
  CORE ARGUMENT: Chibber examines two influential attempts (by Erik Olin Wright and colleagues, and by Alan Carling) to rescue G.A. Cohen's classical, determinist reconstruction of the Marxist theory of history from its acknowledged weaknesses, and argues these rescue attempts are largely unsuccessful; to the extent they do render the theory more plausible, he shows, they do so only by converting it, willy-nilly, into a class-struggle theory. Chibber concludes this spells the demise of the classical (technologically determinist) version of historical materialism, while insisting this does not leave a merely voluntaristic account of history in its place.

  RELEVANCE: This paper directly addresses the domain's central question of how historical materialism has been reconstructed after Cohen's own primacy-thesis debates left the classical theory in doubt, situating the ecological-Marxist revisions covered elsewhere in this domain within a broader post-Cohen effort to specify a defensible, non-technologically-determinist core for historical materialism.

  POSITION: Post-Cohen assessment concluding that the classical, determinist theory of history cannot be rescued, but that a class-struggle-centered materialism survives its collapse.
  },
  keywords = {historical-materialism-defense, post-Cohen, Chibber, High},
  abstract = {Abstract During the 1980s and 1990s, the debate on the Marxist theory of history centred largely around the work of Robert Brenner's property-relations-centred construal of it, and G.A. Cohen's attempt to revive the classical, determinist argument. This article examines two influential arguments by Erik Wright and his colleagues, and by Alan Carling, which acknowledge important weaknesses in Cohen's work, but which also try to construct a more plausible version of his theory. I show that the attempts to rescue Cohen are largely unsuccessful. And, to the extent that they render the argument plausible, they do so at the cost of turning it, willy-nilly, into a kind of class-struggle theory. I conclude that this spells the demise of the classical version of historical materialism, but also observe that this does not leave us with a voluntaristic understanding of history, as some of its defenders fear.},
  abstract_source = {openalex},
}

@misc{wood1996capitalism,
    author = "Wood, Ellen Meiksins",
    title = "Capitalism, Merchants and Bourgeois Revolution: Reflections on the Brenner Debate and its Sequel",
    year = "1996",
    number = "2",
    note = {CORE ARGUMENT: Wood addresses the "new front" opened by Brenner's later work on merchants and the English Revolution, arguing that introducing "commercial change" alongside agrarian class relations risks blurring the sharp distinction Political Marxism draws between capitalism and pre-capitalist commercial/mercantile activity. She insists that what is at stake is not merely a dispute over historical evidence about merchants, but a deeper disagreement — shared by Marxist and non-Marxist historiography alike — over what capitalism fundamentally is. RELEVANCE: Shows Wood defending and clarifying the theoretical core of Political Marxism (capitalism as a distinctive system of social property relations, not merely extensive trade) against ambiguities introduced by Brenner's own subsequent work, illustrating the internal tensions within Political Marxism well before the Knafo-Teschke critique made them explicit. POSITION: Defense of the social-property-relations definition of capitalism against commercialization-inflected readings of the Brenner thesis.},
    keywords = "political-marxism, brenner-debate, commercialization-model, bourgeois-revolution, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The “Brenner Debate” launched by Past and Present in 1976 was about “agrarian class structure and economic development in pre-industrial Europe”. Robert Brenner's recent book, Merchants and Revolution, has opened a new front in the debate by introducing merchants and “commercial change” into the equation. Although the book's massive Postscript carefully situates Brenner's analysis of commercial development in the context of his earlier account of the agrarian transition from feudalism to capitalism, this is unlikely to foreclose debate about how, or even whether, his more recent argument about the role of merchants in the English revolution can be squared with the original Brenner thesis. What is at issue here is not just divergent interpretations of historical evidence but larger differences about the nature of capitalism. The following argument has more to do with the latter than with the former, and it will be concerned with Brenner's work and the debates surrounding it not just for their own sake but for what they reveal about the dominant conceptions of capitalism, in Marxist and non-Marxist histories alike.",
    abstract_source = "openalex"
}

@article{wood1999horizontal,
    author = "Wood, Ellen Meiksins",
    title = "Horizontal Relations: A Note on Brenner's Heresy",
    journal = "Historical Materialism",
    year = "1999",
    volume = "4",
    number = "1",
    note = {CORE ARGUMENT: Responding to the controversy provoked by Brenner's application of class-relational analysis to twentieth-century capitalist crisis theory ("Uneven Development and the Long Downturn"), Wood defends the underlying logic of horizontal (capital-to-capital, competitive) as opposed to purely vertical (capital-labour) relations as an authentically Marxist analytical resource, against critics who read Brenner's move as an abandonment of Marx's value theory. RELEVANCE: Documents Political Marxism's extension beyond questions of historical transition into contemporary crisis theory, and shows Wood explicitly defending Brenner's method against charges — from other Marxists — that it is insufficiently Marxist, illuminating the boundary disputes that define Political Marxism as a distinct school. POSITION: Defense of Brenner's "horizontal," competition-centred crisis theory against value-theoretic critics within Marxism.},
    keywords = "political-marxism, brenner-debate, crisis-theory, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract One fundamental assumption seems to underlie – explicitly or implicitly – every critique of Brenner I have seen: that there can be no such thing as a Marxist theory of competition, the ‘horizontal’ relation among many capitals, that does not presuppose the ‘vertical’ class relation between capital and living labour. To start (if not also to end) with the relation between capital and living labour is the only way to establish one's Marxist credentials (establishing those credentials does, by the way, seem to be the critical, even the sole, issue for those who engage Brenner's argument on that plane, without considering the empirical or explanatory power of his argument). In support of that assumption, more than one critic has invoked Marx's comment that competition does not produce or explain capitalist laws of motion but merely executes them, as their visible manifestation in the external movements of individual capitals. Predictably, too, some critics have gleefully turned against Brenner the charge he has famously levelled against other Marxists: that his focus on competition and the market makes him a ‘neo-Smithian’.",
    abstract_source = "openalex"
}

@book{wood2002origin,
    author = "Wood, Ellen Meiksins",
    title = "The Origin of Capitalism: A Longer View",
    year = "2002",
    publisher = "Verso",
    address = "London",
    note = {CORE ARGUMENT: Wood's synthetic statement of Political Marxism's account of capitalist origins, arguing against both the "commercialization model" (capitalism as the natural outgrowth of trade and towns) and technological/demographic explanations, that capitalism emerged only once in history, in the specific and contingent conditions of English agrarian class relations, and that this historical specificity is obscured whenever capitalism is treated as a transhistorical extension of exchange or "improvement." RELEVANCE: The most widely cited single-volume statement of Political Marxism's thesis on capitalist origins, synthesizing and popularizing Brenner's historical argument for a broader audience; functions as the primary reference point for later critical engagement (Knafo and Teschke, Anievas and Nişancıoğlu, Moreno Zacarés) addressed elsewhere in this domain. POSITION: Synthetic statement of the "one-time, one-place" thesis on the origin of capitalism against commercialization and technological-determinist accounts.},
    keywords = "political-marxism, origin-of-capitalism, commercialization-model, High, INCOMPLETE, no-abstract"
}

@article{pal2021radical,
    author = "Pal, Maïa",
    title = "Radical Historicism or Rules of Reproduction? New Debates in Political Marxism",
    journal = "Historical Materialism",
    year = "2021",
    volume = "29",
    number = "3",
    note = {CORE ARGUMENT: Pal introduces the Historical Materialism symposium responding to Knafo and Teschke's 2020 critique, summarizing the theoretical foundations of Political Marxism, situating the "historicist vs. rules of reproduction" debate within broader questions of method and collective knowledge-production in Marxist historiography, and outlining the seven contributions of the symposium and their differing verdicts on how (or whether) Political Marxism should be reconstructed. RELEVANCE: Provides the most concise scholarly overview of the state of the internal Political Marxism debate as of the early 2020s, useful for orienting readers to the range of positions (radical historicism, defense of structural "rules," and various middle positions) that followed the Knafo-Teschke intervention. POSITION: Editorial overview of the post-2020 internal debate on Political Marxism's method.},
    keywords = "political-marxism, historicism, rules-of-reproduction, symposium, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "This introduction presents the symposium on Sam Knafo and Benno Teschke’s article in Historical Materialism, ‘Political Marxism and the Rules of Reproduction of Capitalism: A Historicist Critique’ (2021). It briefly summarises the foundations of Political Marxism, discusses the broader implications of the debate raised by Knafo and Teschke for questions of collective knowledge-production and methods in Marxist historiography, and outlines the seven contributions of the symposium. The introduction concludes by tracing, through the evolution of debates in Political Marxism and the contributions of its protagonists, some of the lineages of Marxist historiography as well as of the history of this journal.",
    abstract_source = "s2"
}

@article{rioux2013fiction,
    author = "Rioux, Sébastien",
    title = "The Fiction of Economic Coercion: Political Marxism and the Separation of Theory and History",
    journal = "Historical Materialism",
    year = "2013",
    number = "4",
    note = {CORE ARGUMENT: Rioux argues that Political Marxism's signature claim — that capitalism uniquely separates economic and political power, making surplus appropriation purely "economically" coerced — produces an ahistorical, "sanitised" conception of capitalism that cannot account for the extensive coercion and violence (colonial, racial, gendered) that has historically accompanied capitalist development. He proposes Jairus Banaji's historically specific, rather than formally abstract, conception of the mode of production as a corrective. RELEVANCE: An early and influential instance of the internal critique that Political Marxism's formal-abstractionist definition of capitalism separates theory from history — anticipating the Knafo-Teschke critique by several years and identifying Banaji's alternative framework as a rival pole within Marxist debates on capitalist origins that this domain's search did not otherwise pursue in depth (see NOTABLE\_GAPS). POSITION: Critique of Political Marxism's "economic coercion" thesis as ahistorical, advocating Banaji's historical conception of the mode of production instead.},
    keywords = "political-marxism, economic-coercion, social-property-relations, internal-critique, Medium, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Abstract The theory of social-property relations, or political Marxism, has argued that in contradistinction with pre-capitalist forms of exploitation, capitalism is characterised by the separation of the economic and the political, which makes surplus appropriation under this system uniquely driven by economic coercion. In spite of political Marxism’s various strengths, this article argues that the paradigm puts forward an ahistorical and sanitised conception of capitalism typical of bourgeois economics, which is an outcome of its formal-abstractionist approach to the concept of the mode of production and the separation between theory and history that it operates. A more satisfactory solution to political Marxism’s inability to make sense of past and present forms of coercion and violence under capitalism can be found in Jairus Banaji’s emphasis on Marx’s historical – rather than formal – conception of the mode of production.",
    abstract_source = "openalex"
}

@article{teschke2005bourgeois,
    author = "Teschke, Benno",
    title = "Bourgeois Revolution, State Formation and the Absence of the International",
    journal = "Historical Materialism",
    year = "2005",
    number = "2",
    note = {CORE ARGUMENT: Teschke, delivering the Deutscher Memorial Lecture, argues that Political Marxism's class-relational critique of "bourgeois revolution" narratives (following Comninel) needs to be extended to account for the international, geopolitical dimension of state formation, which orthodox theories of bourgeois revolution and Political Marxism's own domestic-class focus alike have neglected. RELEVANCE: Shows a leading Political Marxist (later co-author of the 2020 internal critique with Knafo) already identifying, over a decade earlier, a structural gap in Political Marxism's handling of "the international" — foreshadowing both his own later critique and the Eurocentrism charge pressed by Anievas and Nişancıoğlu. POSITION: Political-Marxist critique of "bourgeois revolution" theory for its neglect of international state formation.},
    keywords = "political-marxism, bourgeois-revolution, state-formation, comninel, Medium, METADATA\_CLEANED: volume, pages, doi",
    abstract = "© Koninklijke Brill NV, Leiden, 2005 Also available online – www.brill.nl 1 This is a revised version of the Isaac and Tamara Deutscher Memorial lecture, delivered on 9 October 2004 at Birkbeck College, University of London. I am grateful to the Deutscher Committee for the award of the Isaac and Tamara Deutscher Memorial Prize 2003, and, in particular, to Alfredo Saad-Filho for organisational and editorial support and George Comninel for his role as discussant on the Deutscher Lectures panel. Additionally, I would like to thank Justin Rosenberg, Kees van der Pijl, Ellen Wood, Samuel Knafo, Kamran Matin, and Robert Shilliam for detailed comments on the paper. The article was written in the register of a lecture and carries its synoptic, programmatic, and provocative marks. [Editorial note: the 2003 Deutscher Memorial Prize was won jointly by Benno Teschke (for The Myth of 1648) and Neil Davidson (for Discovering the Scottish Revolution). The following issue will carry Davidson’s Lecture. In a future issue, George Comninel will review both books.] 2 Teschke 2003. Benno Teschke Bourgeois Revolution, State Formation and the Absence of the International",
    abstract_source = "s2"
}

@article{post2019how,
    author = "Post, Charles",
    title = "How Capitalist Were the 'Bourgeois Revolutions'?",
    journal = "Historical Materialism",
    year = "2019",
    volume = "27",
    number = "3",
    note = {CORE ARGUMENT: Post critically reviews Neil Davidson's attempt (in How Revolutionary Were the Bourgeois Revolutions?) to rescue the concept of bourgeois revolution from both pro-capitalist revisionist historians and Political Marxist critics, arguing that Davidson's framework, despite distancing itself from crude Second-International formulations, still reproduces many of their historical and conceptual problems; Post defends a Political-Marxist alternative grounded in social-property-relations analysis of specific revolutionary conjunctures. RELEVANCE: Extends the Brenner/Comninel/Wood class-relational method to the broader comparative question of "bourgeois revolutions" beyond France, demonstrating Political Marxism's continued productive engagement with, and internal disagreement over, one of historical materialism's classic explanatory targets. POSITION: Political-Marxist critique of both revisionist and orthodox-Marxist theories of bourgeois revolution, via social-property-relations analysis.},
    keywords = "political-marxism, bourgeois-revolution, comninel, davidson-debate, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "The canonical version of the ‘bourgeois revolutions’ has been under attack from both pro-capitalist ‘Revisionist’ historians and ‘Political Marxists’. Neil Davidson’s book How Revolutionary Were the Bourgeois Revolutions? provides a thorough review of the intellectual history of the notion of the bourgeois revolution and attempts to rescue the concept from varied criticism. Despite distancing himself from problematic formulations of the bourgeois revolution inherited from Second-International Marxism, Davidson’s own framework reproduces many of the historical and conceptual problems of this tradition.",
    abstract_source = "s2"
}

@misc{morenozacares2018beyond,
    author = "Moreno Zacarés, Javier",
    title = "Beyond Market Dependence: The Origins of Capitalism in Catalonia",
    year = "2018",
    volume = "18",
    number = "4",
    note = "CORE ARGUMENT: Testing Brenner's own passing suggestion that Catalonia underwent an agrarian transition to capitalism parallel to England's, Moreno Zacarés finds instead that pre-capitalist social property relations persisted in Catalan agriculture throughout the relevant period, and that the region's capitalist breakthrough instead originated in sociocultural struggles within its eighteenth-century proto-industry — contrary to Brenner's agrarian-centered model. RELEVANCE: A rare empirical case study that tests the Political Marxism/Brenner thesis outside its paradigm case of England, finding it wanting and thereby illustrating both the empirical ambition and the empirical vulnerability of the class-relational transition theory that anchors this domain. POSITION: Empirical critique of Brenner's agrarian-transition thesis via a non-English case, emphasizing agency and proto-industrial subjectivity over agrarian class structure.",
    keywords = "political-marxism, brenner-debate, transition-to-capitalism, case-study, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Buried in the footnotes of his famous 1976 essay, Robert Brenner left the remark that Catalonia had experienced an agrarian transition to capitalism in parallel to England. This important claim has been completely forgotten by his followers of the political Marxist tradition, who since then have developed his views on the origins of capitalism. Building on the specialist literature, this article revisits the question of the Catalan transition through the prism of political Marxism and teases out its implications. In particular, it argues that the Catalan case illustrates the centrality of agency and subjectivity in the process of capitalist change. Contrary to Brenner's claim, this paper will argue that pre‐capitalist social property relations persisted in agriculture throughout the period of transition. Instead, the region's capitalist breakthrough was prompted by sociocultural struggles in its 18th‐century proto‐industry.",
    abstract_source = "s2"
}

@misc{anievas2013whats,
    author = "Anievas, Alexander and Nisancioglu, Kerem",
    title = "What's at Stake in the Transition Debate? Rethinking the Origins of Capitalism and the 'Rise of the West'",
    year = "2013",
    number = "1",
    note = {CORE ARGUMENT: Drawing on Trotsky's theory of "uneven and combined development," Anievas and Nişancıoğlu argue that Brenner's Anglo-centric theorization of capitalism's origins omits crucial international determinations — the Mongol invasions, Ottoman imperial expansion, and the discovery and colonization of the New World — that they claim actually determined the developmental trajectory of capitalism in north-western Europe. RELEVANCE: Represents the principal external (as opposed to Knafo-Teschke's internal) critique of Political Marxism, charging it with Eurocentrism for confining the explanation of capitalism's origins to intra-European class relations; this critique was later developed at monograph length in Anievas and Nişancıoğlu's How the West Came to Rule, described by reviewers as the most comprehensive response yet to Brenner's framework. POSITION: Uneven-and-combined-development critique of Political Marxism's Eurocentrism and its exclusively domestic/agrarian framing of capitalist origins.},
    keywords = "political-marxism, eurocentrism, uneven-and-combined-development, external-critique, Low, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "This article draws on the theory of uneven and combined development (U\&CD) to construct a non-Eurocentric and ‘internationalist’ analysis of the transition to capitalism. In doing so, we seek to respond to and rethink two challenges: exposures of Eurocentric notions of the ‘Rise of the West’ on the one hand; and recent critiques of Eurocentric assumptions in the theory of U\&CD on the other. Beginning with an assessment of Robert Brenner’s Anglo-centric theorisation of capitalism’s origins, we argue Brenner’s efforts are hamstrung by an omission of international determinations and conditions. In turn, we retrace these missing international factors through an analysis of the Mongol invasions of the 13th/14th centuries, Ottoman imperial expansion in the 15th/16th centuries and the contemporaneous discovery and colonisation of the New World. We argue that each case demonstrates the historically specific forms of U\&CD that fed into – and ultimately determined – the developmental trajectory of capitalism in north-western Europe.",
    abstract_source = "s2"
}

@misc{lafrance2026social,
    author = "Lafrance, Xavier",
    title = "Social Ontology in Open Marxism and Political Marxism: From Alienation, to Exploitation and Back Again",
    year = "2026",
    note = {CORE ARGUMENT: Lafrance compares how Open Marxism (Simon Clarke) and Political Marxism (Brenner, Wood) each critique the fetishized social ontology of orthodox Marxism, arguing that despite differences in vocabulary — social form and alienation versus social property relations and exploitation — the two currents converge on a shared rejection of a separate, asocial "economic" sphere, and that their apparent tensions are largely terminological rather than substantive. RELEVANCE: A very recent contribution that situates Political Marxism within a wider family of post-orthodox reconstructions of historical materialism's social ontology, useful for the review's account of Political Marxism's philosophical underpinnings and its relationship to cognate currents beyond the analytical-Marxism comparison already covered by Chibber. POSITION: Reconciliation of Open Marxism and Political Marxism as complementary, rather than opposed, social ontologies of capitalism.},
    keywords = "political-marxism, open-marxism, social-ontology, recent, Low, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "This article compares how Open Marxism and Political Marxism, respectively, mobilize the concepts of social form and of social property relations to produce critiques of the fetishized social ontology of mainstream or orthodox Marxism(s). Focusing on the works of Simon Clarke, Robert Brenner and Ellen Meiksins Wood, I show how these thinkers develop strikingly convergent readings of Marx’s critique of political economy as a rejection of an ontologically separate and asocial economic sphere. I then discuss how points of tension between Open Marxism and Political Marxism seem to emerge when we further specify the social ontologies of these currents. These tensions, however, appear to pertain more to differences of vocabulary than to a substantial theoretical opposition. This becomes clear once we understand how Open Marxist concepts of social form (and alienation) and Political Marxist concepts of social property relations (and exploitation) are in fact complementary. Social property relations can then be seen as an ontological elucidation of alienated social forms.",
    abstract_source = "s2"
}

@misc{popper1957poverty,
    author = "Popper, Karl",
    title = "The Poverty of Historicism",
    year = "1957",
    address = "London",
    note = {CORE ARGUMENT: Popper defines "historicism" as the view that history is governed by discoverable laws or principles yielding a determinate end-point, and that the task of social science is therefore historical prophecy. He argues this project is logically impossible because human knowledge grows unpredictably and thereby alters social conditions in ways that cannot be forecast in advance; social systems, unlike the solar system, are not isolated, stationary, or repetitive, so no "unconditional scientific prophecy" of the eclipse-prediction type is available for history. Popper explicitly names Marx's dialectical materialism as a paradigm case, linking historicism to "holism" (treating social wholes as prior to individuals) and to dangerous "utopian social engineering." RELEVANCE: This is the founding text of the critique this domain organizes around; Popper's charge that historical materialism illegitimately converts observed historical trends into inexorable laws goes to the heart of the "priority order" question the overall review must adjudicate -- whether Marx's own claims about modes of production are lawlike/predictive or looser and more conditional. POSITION: Foundational statement of the anti-historicist critique of Marxism; the target against which Suchting, Hudelson, and Passmore (below) argue in various ways that Popper's category does not cleanly capture Marx's actual textual commitments.},
    keywords = "Popper, historicism, philosophy-of-science-critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{suchting1972marx,
    author = "Suchting, W. A.",
    title = "Marx, Popper, and 'Historicism'",
    journal = "Inquiry",
    year = "1972",
    volume = "15",
    number = "1-4",
    note = {CORE ARGUMENT: Suchting distinguishes two logically distinct types of "laws of historical development" that Popper's argument might be taken to target, and shows that Popper's stated objections fail against both when carefully formulated. He then works through four different models of historical determinism that could plausibly be ascribed to Marx and asks, model by model, whether Popper's critique actually applies to any of them. RELEVANCE: Directly addresses the research question of whether Popper's charge of historicism correctly targets historical materialism as Marx himself formulated it, by disaggregating "historicism" into precise sub-claims rather than treating it as a single undifferentiated doctrine. POSITION: A close analytic rebuttal of Popper from a sympathetic-to-Marx standpoint, exemplifying the "Popper's target is underspecified" line of response.},
    keywords = "Popper, historicism, Marx-exegesis, High, METADATA\_CLEANED: pages, doi",
    abstract = "According to Sir Karl Popper, there is a harmful approach to the social sciences called ‘historicism’. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.",
    abstract_source = "openalex"
}

@misc{hudelson1980poppers,
    author = "Hudelson, Richard",
    title = "Popper's Critique of Marx",
    year = "1980",
    number = "3",
    note = "CORE ARGUMENT: Hudelson reconstructs Popper's argument against Marx's alleged historicism and isolates the specific inferential steps -- from the unpredictability of future knowledge to the impossibility of long-range social prediction -- on which the argument depends, testing whether those steps go through when applied to the particular predictive claims Marx actually makes about capitalism's trajectory. RELEVANCE: Offers a second, independent philosophical assessment of whether Popper's anti-historicist argument succeeds against Marx's real claims (rather than a caricature), useful for weighing how much of Popper's critique survives close scrutiny. POSITION: A measured philosophical evaluation, distinct from outright dismissal or endorsement of Popper's critique.",
    keywords = "Popper, historicism, prediction, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{passmore1975poverty,
    author = "Passmore, John",
    title = "The Poverty of Historicism Revisited",
    year = "1975",
    number = "4",
    note = {CORE ARGUMENT: Passmore argues that Popper's own use of "historicism" is not stable across his writings -- sometimes referring to a theory about the proper aims of social science, sometimes to a way of practicing social science, sometimes to a broader philosophical Weltanschauung (German Historismus) -- and that this instability undermines the force of the charge when leveled at any single target, including Marx. RELEVANCE: Bears directly on the question of whether Popper's charge "correctly targets" historical materialism, by showing that the charge itself may not pick out a determinate, criticizable doctrine; this is a needed methodological check before assessing Popper vs. Marx specifically. POSITION: An internal, meta-critical challenge to the coherence of Popper's category of historicism, rather than a defense of Marx as such.},
    keywords = "Popper, historicism, conceptual-analysis, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The Poverty of Historicism was designed as a political pamphlet, a tract for its times, as its dedication makes very clear: memory of the countless men and women of all creeds or nations or races who fell victims to the fascist and communist belief in Inexorable Laws of Human Destiny.' Historicism, as Popper understands it, is not just an intellectual error, of interest only to professional philosophers; it is a prime source of moral and political devastation. It carries with it, or is used to justify, a particular attitude to political reform. For a Popper-defined historicist, political reform, if it is to have any hope of being efficacious, must work with historical laws to change the entire condition of society; for Popper himself it should proceed by piece-meal engineering by setting up, in an experimental spirit, new institutions or attempting to improve, in that same spirit, the manner of working of existing institutions. In short, in attacking historicism, Popper was attacking totalitarianism and defending a meliorist democracy or, more accurately, since Popper has no great political expectations, a democracy which will do something to lessen human suffering.2 He was writing at a time, it must also be remembered, when to call Marxism scientific was to recommend it. (Nowadays to call it humanistic has the same effect.) Popper was particularly,",
    abstract_source = "openalex"
}

@misc{lowy1989weber,
    author = "Löwy, Michael",
    title = "Weber against Marx? The Polemic with Historical Materialism in the Protestant Ethic",
    year = "1989",
    number = "1",
    note = {CORE ARGUMENT: Löwy reconstructs The Protestant Ethic and the Spirit of Capitalism as a sustained, if largely implicit, polemic against monocausal materialist explanations of the rise of capitalism. Weber's demonstration that Calvinist religious doctrine had independent causal efficacy in shaping the capitalist "spirit" is read as a deliberate methodological counter-example to any account that treats ideas and culture as mere epiphenomena of economic relations, while stopping short of a simple idealist inversion of Marx. RELEVANCE: Supplies the paradigm case for the "Weberian multi-causal critique" the domain is asked to cover, clarifying exactly how Weber's methodology displaces (without simply negating) the primacy-of-the-economic thesis central to historical materialism. POSITION: Sympathetic historical-sociological reconstruction of Weber's anti-materialist argument, written from a Marxist (specifically Weberian-Marxist) vantage point that takes the challenge seriously rather than dismissing it.},
    keywords = "Weber, multicausality, Protestant-ethic, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{giddens1981contemporary,
    author = "Giddens, Anthony",
    title = "A Contemporary Critique of Historical Materialism",
    year = "1981",
    address = "London",
    note = {CORE ARGUMENT: Giddens argues that historical materialism's base/superstructure architecture, and its assumption of the "structural primacy" of economic production, fail to hold for pre-capitalist societies, where kinship, military, and normative/authoritative structures are not reducible to or determined by relations of production. He proposes that "allocative" power (over material resources) must be theorized alongside "authoritative" power (over persons and their activities) as an independent axis, undermining any general claim that the economic is always determinant "in the last instance." RELEVANCE: The central systematic sociological statement of the Weberian-inflected multi-causal critique, directly targeting the primacy-of-the-economic claim that other domains in this review examine from within Marxism (analytical Marxism's functional-explanation debates; Political Marxism's specificity-of-capitalism thesis). POSITION: A foundational non-Marxist sociological critique that rejects the general theory of history built into orthodox historical materialism while retaining an interest in class and capitalism as historically specific phenomena.},
    keywords = "Weber, multicausality, base-superstructure, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{parkin1979marxism,
    author = "Parkin, Frank",
    title = "Marxism and Class Theory: A Bourgeois Critique",
    year = "1979",
    address = "London",
    note = {CORE ARGUMENT: Parkin argues, from a Weberian sociological standpoint, that Marxist class analysis illegitimately reduces the multiple bases of social closure and stratification (property, credentials, gender, ethnicity, status) to a single relation to the means of production, and that Weber's "class, status, and party" framework captures social conflict and inequality more accurately than a two- or three-class Marxist schema. RELEVANCE: Provides the explicit "class reductionism" side of the Weberian challenge that the domain's key questions ask about, complementing Giddens's structural critique with a more directly polemical treatment of Marxist class categories -- the same reductionism charge that Laclau and Mouffe later develop from within a post-Marxist rather than Weberian framework. POSITION: Self-consciously non-Marxist ("bourgeois") sociological critique of Marxist class theory, provocative in its framing and influential in Weberian stratification theory.},
    keywords = "Weber, class-reductionism, stratification, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{bimber1990karl,
    author = "Bimber, Bruce",
    title = "Karl Marx and the Three Faces of Technological Determinism",
    year = "1990",
    volume = "20",
    number = "2",
    note = {CORE ARGUMENT: Bimber, writing from science and technology studies, distinguishes three distinct senses in which a theory of history might be called "technologically determinist" (unstructured, norm-based, and nomological) and argues that Marx's texts, and the secondary literature built on them (including Cohen's functional-explanation reconstruction), conflate these senses, producing an interpretive dispute that is partly an artifact of imprecise terminology rather than a substantive disagreement about Marx's actual view. RELEVANCE: Supplies an external (STS, non-Marxological) framework for assessing whether historical materialism is committed to technological determinism, directly informing the domain's brief to address "general critiques of economic/technological determinism." POSITION: A conceptual-clarification critique from outside both Marxism and its analytical reconstruction, showing that charges of technological determinism against Marx often trade on ambiguity.},
    keywords = "technological-determinism, STS, productive-forces, High, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "The literature on Marx reveals conflicting claims about the role of technology in social change. Much of the debate is attributable to confusion over what is meant by `technological determinism' (TD). There are several approaches to this concept: `Norm-Based Accounts' interpret TD as a chiefly cultural phenomenon; `Unintended Consequences Accounts' view it in terms of unexpected social outcomes of technological enterprise. Neither of these two approaches make claims which are strictly deterministic, and which rely upon features of technology itself; they should not be considered to be TD. `Logical Sequence Accounts', on the other hand, make an ontological claim, viewing TD in terms of universal laws of nature; these deserve the `TD' label, and suggest criteria for assessing Marx's views about technology. Marx's arguments about the forces of production do not represent a Logical Sequence Account. The primary factors in the development of the forces of production are human, involving drives for self-expression, resistance to alienation, and expanding needs. Technology plays only a facilitating role in this process, which is essentially non-technological in character.",
    abstract_source = "openalex"
}

@article{duquette1992critique,
    author = "Duquette, David A.",
    title = "A Critique of the Technological Interpretation of Historical Materialism",
    journal = "Philosophy of the Social Sciences",
    year = "1992",
    volume = "22",
    number = "2",
    note = {CORE ARGUMENT: Duquette argues against readings of historical materialism (associated with G. A. Cohen and William Shaw) that make the development of productive forces the sole independent explanatory variable driving epochal social change, contending that such technological-determinist reconstructions cannot adequately account for the causal role of class struggle and social relations of production that Marx's own texts emphasize. RELEVANCE: Directly engages "general critiques of economic/technological determinism" by contesting the most systematic technological reading of historical materialism from a position that is external to, and critical of, the analytical-Marxist reconstruction project covered in other domains of this review. POSITION: A critique of technological-determinist historical materialism that argues the productive-forces-primacy thesis distorts Marx's own dialectical account of the productive-forces/relations-of-production relationship.},
    keywords = "technological-determinism, productive-forces, Cohen-critique, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "This essay examines and criticizes G. A. Cohen's interpretation of Marx's materialistic conception of history as presented in Cohen's book Karl Marx's Theory of History. In particular, the author attacks Cohen's Primacy Thesis, the claim that (for Marx) human technology is the primary explanatory factor for economic and social change and for historical development generally. The focus of the attack is Cohen's way of distinguishing between the material and social characteristics, or the content and form, of a system of production. The argument is that Cohen's distinctions are defective and therefore fail to provide adequate support for the Primacy Thesis and that, moreover, the position that Cohen defends is not Marx's.",
    abstract_source = "openalex"
}

@misc{hindess1977mode,
    author = "Hindess, Barry and Hirst, Paul Q.",
    title = "Mode of Production and Social Formation: An Auto-Critique of Pre-Capitalist Modes of Production",
    year = "1977",
    address = "London",
    note = {CORE ARGUMENT: Hindess and Hirst repudiate the theoretical apparatus of their own earlier book, Pre-Capitalist Modes of Production, arguing that the general concept of "mode of production" -- construed as a combination of forces and relations of production capable of generating determinate laws of motion for a whole historical epoch -- is theoretically incoherent and cannot perform the explanatory work that Althusserian and orthodox historical-materialist theory assigns to it. They contend that specific historical social formations cannot be derived from, or explained by, an abstract typology of modes of production. RELEVANCE: Provides the domain's central instance of "critiques of the 'mode of production' concept," notable precisely because it is a self-critique by former structuralist Marxists rather than an external attack, showing that doubts about the transhistorical validity of the category arose from within the Althusserian tradition examined elsewhere in this review. POSITION: A structuralist-Marxist auto-critique that ends in the wholesale rejection of "mode of production" as a general theoretical category, marking an internal collapse of confidence in one of historical materialism's central concepts.},
    keywords = "mode-of-production, Althusserian-critique, auto-critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{bailey1979karl,
    author = "Bailey, Anne M. and Llobera, Josep R.",
    title = "Karl A. Wittfogel and the Asiatic Mode of Production: A Reappraisal",
    year = "1979",
    volume = "27",
    number = "3",
    note = {CORE ARGUMENT: Bailey and Llobera reassess Wittfogel's hydraulic-society thesis and its relationship to Marx's scattered remarks on an "Asiatic mode of production," arguing that the concept as deployed in twentieth-century Marxist debate conflates several distinct issues -- the specificity of state power in non-European societies, ecological/technological determinants of large-scale irrigation, and the political uses to which "Oriental despotism" was put in Cold War polemics -- and that this conflation has obstructed a clear anthropological assessment of the category's validity. RELEVANCE: Directly addresses the "Asiatic-mode-of-production controversy" specified in the domain's key questions, showing how attempts to fit non-European historical trajectories into a Marxist stagial schema generated both political and conceptual confusion. POSITION: A critical historiographical reappraisal that neither simply defends nor simply discards the concept, but diagnoses why the debate over it became so entangled with extraneous political stakes.},
    keywords = "Asiatic-mode-of-production, Wittfogel, anthropology, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{currie1984asiatic,
    author = "Currie, Kate",
    title = "The Asiatic Mode of Production: Problems of Conceptualising State and Economy",
    year = "1984",
    volume = "8",
    number = "4",
    note = {CORE ARGUMENT: Currie argues that the Asiatic-mode-of-production concept fails to specify a coherent relationship between state and economy that could give it genuine explanatory power distinct from ad hoc description, since the category has been used to designate societies with markedly different property relations, surplus-extraction mechanisms, and state forms, undermining its claim to identify a unified "mode of production" in Marx's technical sense. RELEVANCE: Strengthens the domain's anthropological-critique cluster by focusing specifically on the conceptual (rather than merely historiographical) incoherence of treating "Asiatic mode of production" as a determinate category analogous to feudalism or capitalism. POSITION: An anthropological critique that treats the AMP controversy as symptomatic of a deeper problem in extending Marx's mode-of-production concept to non-European contexts as a transhistorical category.},
    keywords = "Asiatic-mode-of-production, mode-of-production, state-theory, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, doi, type:@article->@misc"
}

@book{laclau1985hegemony,
    author = "Laclau, Ernesto and Mouffe, Chantal",
    title = "Hegemony and Socialist Strategy: Towards a Radical Democratic Politics",
    year = "1985",
    publisher = "Verso",
    address = "London",
    note = {CORE ARGUMENT: Laclau and Mouffe argue that the base/superstructure model and the classical Marxist expectation of proletarian unity around a unified class interest rest on an untenable "essentialism" -- the assumption that social agents have objectively given interests fixed by their position in relations of production. Drawing on post-structuralist discourse theory, they reconceive society as constitutively open, structured by contingent "articulations" of antagonistic elements rather than by an underlying economic logic, and generalize Gramsci's concept of "hegemony" into a general theory of the political no longer anchored in class as a privileged category. RELEVANCE: This is the primary text through which post-Marxism dissolves the base/superstructure model and class essentialism, and is the direct object of the domain's key question about "what remains 'Marxist'" in this project; every other post-Marxism entry in this domain is a response to or elaboration of the argument made here. POSITION: The founding text of "post-Marxism," retaining categories such as hegemony, antagonism, and articulation from the Marxist and Gramscian tradition while explicitly abandoning economic determination and class reductionism.},
    keywords = "post-Marxism, hegemony, discourse-theory, class-essentialism, High, INCOMPLETE, no-abstract"
}

@misc{ives2005language,
    author = "Ives, Peter",
    title = "Language, Agency and Hegemony: A Gramscian Response to Post-Marxism",
    year = "2005",
    volume = "8",
    number = "4",
    note = {CORE ARGUMENT: Ives argues that Laclau and Mouffe's appropriation of "hegemony" from Gramsci strips away Gramsci's own sophisticated, linguistically grounded understanding of how coercion and consent interrelate, in favor of an abstract post-structuralist vocabulary of discourse and articulation. Returning to Gramsci's actual writings on language, Ives contends that a more historically and linguistically attentive conception of hegemony can address the same problems Laclau and Mouffe raise without abandoning attention to concrete institutional and economic conditions. RELEVANCE: Offers a Gramscian rather than orthodox-Marxist rebuttal to post-Marxism, directly engaging the question of what, if anything, is lost or retained when Laclau and Mouffe generalize hegemony away from its original materialist moorings. POSITION: A left critique of post-Marxism from within the Gramscian tradition, arguing Laclau and Mouffe's "descent into discourse" sacrifices analytical resources Gramsci's own work still offers.},
    keywords = "post-Marxism, Gramsci, hegemony, discourse-critique, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Ernesto Laclau and Chantal Mouffe have attempted to save the concept of ‘hegemony’ from its economistic and essentialist Marxist roots by incorporating the linguistic influences of post‐structuralist theory. Their major Marxist detractors criticise their trajectory as a ‘descent into discourse’ – a decay from well‐grounded, material reality into the idealistic and problematic realm of language and discourse. Both sides of the debate seem to agree on one thing: the line from Marxism to post‐Marxism is the line from the economy to language, from ‘reality’ to discourse. This article focuses on Gramsci’s writings on language to argue against both sides of this debate. It illustrates how language is central to Gramsci’s historical materialism and that he does not oppose it to materiality. It argues that Gramsci adopted the very term hegemony substantially from his university studies in linguistics – the debates from which Ferdinand de Saussure also developed structuralism. For Gramsci, such linguistic issues were directly related to the ‘questione della lingua’ and Italian unification. Moreover, language lies at the centre of Gramsci’s understanding of the relationship between coercion and consent. This not only troubles Laclau \& Mouffe’s reading of Gramsci, but it illuminates a more productive conception of hegemony that can address recent debates around post‐structuralism and the use of ‘hegemony’ to analyse globalisation and an increasingly technological and electronic world.",
    abstract_source = "openalex"
}

@misc{jacobs2018dislocated,
    author = "Jacobs, Thomas",
    title = "The Dislocated Universe of Laclau and Mouffe: An Introduction to Post-Structuralist Discourse Theory",
    year = "2018",
    volume = "30",
    note = {CORE ARGUMENT: Jacobs surveys post-structuralist discourse theory's shift away from classical Marxian sociology's economic "structuring" of society and ideas toward a thesis of radical indeterminacy in which no deeper social foundation -- economic or otherwise -- explains political outcomes. He argues this radicalization of Marxism's own move away from economic essentialism comes at the cost of analytical purchase: class struggle and relations of production lose their explanatory role, and political practice becomes difficult to distinguish from contingent, unanalyzable contestation. RELEVANCE: Provides a critical survey (rather than a partisan intervention) of exactly how far post-Marxist discourse theory travels from historical materialism's core commitments, useful for assessing what, if anything, remains "Marxist" once economic determination and class are abandoned as explanatory anchors. POSITION: A skeptical assessment, sympathetic neither to orthodox Marxism nor uncritically to post-structuralist discourse theory, cataloguing the theoretical costs of Laclau and Mouffe's indeterminacy.},
    keywords = "post-Marxism, discourse-theory, indeterminacy, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT Post-Structuralist Discourse Theory analyzes political ideas and action from a Marxist direction. However, while classic Marxian sociology is rooted in economic processes that “structure” society and ideas, Post-Structuralist Discourse Theory emphasizes the absence of any determinative principle. Thus, it radicalizes an ongoing shift in Marxism away from economic essentialism towards indeterminacy, contingency, and openness. The ideological superstructure becomes ever more important at the expense of the economic base; class struggle and relations of production lose analytical and strategic purchase in favor of a complex and integral form of politics; there are no deeper, natural foundations determining how society is organized and structured. Post-Structuralist Discourse Theorists argue that this orientation leads to a more satisfactory analysis of political practice than is possible through positivist research. Assessing this claim requires a survey of the hermetic terminology in which Post-Structuralist Discourse Theorists express their ideas—the discourse, as it were, of Discourse Theorists—exploring their use of sociology, structuralist linguistics, psychoanalysis, and the political theory of populism.",
    abstract_source = "s2"
}

@article{townshend2017living,
    author = "Townshend, Jules",
    title = "Living with the Fragments: Further Thoughts on Norman Geras's Critique of Post-Marxism",
    journal = "International Critical Thought",
    year = "2017",
    number = "4",
    note = "CORE ARGUMENT: Townshend revisits Norman Geras's influential charge that Laclau and Mouffe's Hegemony and Socialist Strategy misreads classical Marxist texts (attributing to Marx and Engels a crude economic reductionism they did not hold), and that Laclau and Mouffe's own theory covertly reintroduces essentialist and universalist commitments even as it officially disavows them. Townshend assesses how well Geras's specific textual and logical objections have held up against subsequent post-Marxist responses and elaborations. RELEVANCE: The domain's chief source for engaging the Geras/Laclau-Mouffe exchange, one of the most sustained and influential Marxist rebuttals to post-Marxism, addressed at second hand since Geras's own original essays could not be independently verified in this search session. POSITION: A sympathetic-to-Geras retrospective assessment situating the Geras critique within the broader post-Marxism debate; flagged as a secondary source for Geras's argument.",
    keywords = "post-Marxism, Geras, class-essentialism, Low, METADATA\_CLEANED: volume, pages, doi",
    abstract = "This article revisits and re-evaluates a famous debate between Norman Geras and Ernesto Laclau. This exchange was one of the few direct confrontations between Marxism and post-Marxism in terms of its significance for the evolution of Marxist theory, characterised by increasing fragmentation often morphing into post-Marxist theory. The article also considers the significance of the debate in relation to the nature of Geras’s adherence to Marxism and his intellectual and political trajectory. It argues that Geras was more of a post-Marxist than he thought he was, and became more so over time, and that Laclau’s ethical reluctance was close to at least one of Marx’s “spirits.” Finally in raising the question of how anti/post-capitalist theorists should live with and without Marx(ism) this article suggests that the debate in many ways still has contemporary relevance.",
    abstract_source = "openalex"
}

@article{goldstein2019ernesto,
    author = "Goldstein, Philip",
    title = "Ernesto Laclau and Chantal Mouffe: The Evolution of Post-Marxism",
    journal = "Global Discourse",
    year = "2019",
    number = "2",
    note = {CORE ARGUMENT: Goldstein traces how Laclau's and Mouffe's post-Marxist positions diverged after Hegemony and Socialist Strategy: Laclau increasingly emphasized a general rhetorical/psychoanalytic theory of hegemony and populism, while Mouffe developed a normative theory of "agonistic" pluralism, and Goldstein assesses how much of the original 1985 anti-essentialist, anti-class-reductionist argument survives in each later trajectory. RELEVANCE: Useful for tracking how far post-Marxism moved from historical materialism over time, informing the synthesis question of what, if any, common Marxist inheritance still unites Laclau's and Mouffe's later, increasingly divergent projects. POSITION: A descriptive intellectual-historical account rather than a polemical intervention, mapping the internal evolution and eventual bifurcation of post-Marxist theory.},
    keywords = "post-Marxism, Laclau, Mouffe, intellectual-history, Low, METADATA\_CLEANED: volume, pages, doi",
    abstract = "In their groundbreaking Hegemony and socialist strategy (1985), Ernesto Laclau and Chantal Mouffe develop a new account of radical politics in which the subjective construction of hegemony establishes political conditions, not the objective historical stages and class contexts of traditional Hegelian Marxism. On this basis, they forcefully justify the 'identity politics' of contemporary women's, African-American, gay, and working class groups and organisations and oppose both the hegemony of the new right and the 'classism' and revolutionary orientation of the radical left. In their later work, they elaborate their accounts of hegemony and move in new directions. In On populist reason (2005) and The rhetorical foundations of society (2014), Laclau draws on poststructuralist discourse or rhetoric as well as notions of populism or the masses to show that hegemony involves what he terms antagonism, frontiers or we/they oppositions, equivalential logics, and other elements. By contrast, in On the political (2005) and Agonistics: thinking the world politically (with Wagner, 2013), Mouffe elaborates the notion of the fissured subject which, as she and Laclau argued in Hegemony, was constituted by the antagonisms of diverse social movements or the dislocation of social structures; however, her new accounts of the antagonisms or, as she says, 'agonisms' dividing the political field forcefully oppose universal norms of rationality or democracy in order to establish a genuine pluralism on a national and a global scale.",
    abstract_source = "s2"
}

@misc{hartmann1979unhappy,
    author = "Hartmann, Heidi I.",
    title = "The Unhappy Marriage of Marxism and Feminism: Towards a More Progressive Union",
    year = "1979",
    number = "2",
    note = {CORE ARGUMENT: Hartmann argues that Marxist categories of production are, by themselves, "sex-blind": they explain the drive to accumulate capital but not why it is specifically women who perform unpaid domestic labor and occupy subordinate positions in the wage hierarchy. She proposes "dual-systems theory," treating patriarchy as a distinct social structure with its own material base -- men's control over women's labor power, secured historically through control of property, the exclusion of women from desirable occupations, and the family wage -- that predates and interacts with, but is not reducible to, capitalism. RELEVANCE: This essay is the founding statement of the dual-systems position against which Vogel's and Bhattacharya's unitary social reproduction theory is explicitly constructed; it is the primary source for the dual-systems side of the central debate in this domain, and it directly challenges the sufficiency of a single-system base/ superstructure model for explaining gender oppression. POSITION: Dual-systems theory (patriarchy and capitalism as two distinct systems).},
    keywords = "dual-systems-theory, domestic-labor, patriarchy, base-superstructure, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {This paper argues that the relation between marxism and feminism has, in all the forms it has so far taken, been an unequal one. While both marxist method and feminist analysis are necessary to an understanding of capitalist societies, and of the position of women within them, in fact feminism has consistently been subordinated. The paper presents a challenge to both marxist and radical feminist work on the "woman question", and argues that what it is necessary to analyse is the combination of patriarchy and capitalism. It is a paper which, we hope, should stimulate considerable debate.},
    abstract_source = "openalex"
}

@misc{vogel2013marxism,
    author = "Vogel, Lise",
    title = "Marxism and the Oppression of Women: Toward a Unitary Theory",
    year = "2013",
    note = {CORE ARGUMENT: Originally published in 1983, Vogel argues against dual-systems theory that women's oppression under capitalism should be explained within a single, unitary historical-materialist framework. She locates the material basis of women's subordinate position in the necessity, under capitalism, of reproducing labor power generationally (bearing and raising children) and daily (through domestic maintenance work), work that capital does not pay for but that is structurally necessary to the reproduction of the working class as a whole. RELEVANCE: This is the foundational statement of the "unitary theory" alternative to Hartmann's dual-systems approach and the direct ancestor of Bhattacharya's social reproduction theory; it reworks Marx's categories of production and reproduction rather than supplementing them with a second system, making it central to how this domain answers the question of whether the base/superstructure model needs one system or two. POSITION: Unitary theory / early social reproduction theory.},
    keywords = "unitary-theory, social-reproduction, domestic-labor, base-superstructure, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    sep_context = {Cited in SEP "Feminist Perspectives on Class and Work" (feminism-class), sec. 2 ("Marxist-Feminist Analyses"): grouped with Benston 1969 and Hennessy 2003 as Marxist-feminists who "argued that women's work in biological and social reproduction is a necessary element of all modes of production and one often ignored by Marxist economists." Also cited in sec. 4 ("Second Wave Feminist Analyses of Housework"), grouped with Federici 1975/2004 and Malos 1975, as holding that "women's housework is part of the social reproduction of capitalism," such that "the necessary work of reproducing the working class is unpaid," which "allows more profits to capitalists."},
    abstract = {Nearly thirty years after its initial publication, Marxism and the Oppression of Women remains an essential contribution to the development of an integrative theory of gender oppression under capitalism. Lise Vogel revisits classical Marxian texts, tracking analyses of "the woman question" in socialist theory and drawing on central theoretical categories of Marx's Capital to open up an original theorisation of gender and the social production and reproduction of material life. Included in this edition are Vogel's article, "Domestic Labor Revisited" (originally published in Science \\& Society in 2000) which extends and clarifies her main theoretical innovations, and a new Introduction by Susan Ferguson and David McNally situating Vogel's work in the trajectory of Marxist-feminist thought over the past forty years.},
    abstract_source = "openalex"
}

@misc{vogel1996engels,
    author = "Vogel, Lise",
    title = "Engels's Origin: Legacy, Burden and Vision",
    publisher = "Palgrave Macmillan UK",
    year = "1996",
    note = "CORE ARGUMENT: Vogel assesses the legacy of Engels's The Origin of the Family, Private Property and the State from the standpoint of her own unitary theory, arguing that Engels correctly identifies the historical link between the rise of private property and women's subordination but leaves underdeveloped the mechanism connecting reproduction of labor power to capitalist production specifically, treating the household too much as a holdover from earlier modes of production rather than as integral to capitalism itself. RELEVANCE: This is a direct, book-length engagement by the leading unitary theorist with Engels's founding materialist account of gender oppression, evaluating what in Origin survives later anthropological and Marxist-feminist critique and what must be reconstructed -- exactly the adequacy question posed for this domain. POSITION: Unitary theory's critical retrieval of Engels.",
    keywords = "engels, origin-of-the-family, unitary-theory, critique, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Friedrich Engels's The Origin of the Family, Private Property and the State has functioned as an authoritative theoretical text for two quite different social movements: the socialist movement on the one hand, and the modern women's movement on the other. Since the end of the nineteenth century, socialists have taken the book as the definitive Marxist pronouncement on women and the family. Confronting capitalist exploitation and, often, feudal social relations as well, socialist parties and movements have valued the Origin for its critique of marriage as an oppressive economic institution, its interest in women's participation in social production, and its vision of freely-chosen sexual relations in a collectively organized society.",
    abstract_source = "openalex"
}

@misc{bhattacharya2017introduction,
    author = "Bhattacharya, Tithi",
    title = "Introduction: How Not to Skip Class: Social Reproduction of Labor and the Global Working Class",
    year = "2017",
    note = {CORE ARGUMENT: Bhattacharya reframes the relationship between production and reproduction not as two separate spheres to be linked, but as a single social process viewed from two analytical vantage points: the production of things and the production of the people who produce things are both moments of one capitalist totality. She argues this "expanded" conception of class dissolves the base/superstructure dualism that treats domestic and reproductive labor as merely derivative of, or external to, "real" production. RELEVANCE: This is the programmatic statement of contemporary social reproduction theory, the volume's title essay that other entries in this file (Ferguson, Goikoetxea, Falquet, Portella and Busk) build on, criticize, or extend; it directly proposes a revision of the base/superstructure model that treats reproduction as internal to the mode of production. POSITION: Contemporary social reproduction theory (unitary).},
    keywords = "social-reproduction-theory, unitary-theory, base-superstructure, class, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@article{blackledge2018engels,
    author = "Blackledge, Paul",
    title = "Frederick Engels, Social Reproduction, and the Problem of a Unitary Theory of Women's Oppression",
    journal = "Social Theory and Practice",
    year = "2018",
    number = "3",
    note = "CORE ARGUMENT: Blackledge defends Engels's Origin of the Family as a still-usable resource for a unitary materialist theory of women's oppression, against critics who treat it as either economically reductionist or superseded by anthropological findings about kinship. He argues that Engels's core claim -- that the modern nuclear family and women's subordination arise together with class society and private property -- can be reconstructed to ground a social-reproduction account without positing a separate patriarchal system. RELEVANCE: This paper directly answers the domain's third key question (Engels's adequacy and its critiques) and explicitly sides with the unitary/social-reproduction camp against dual-systems readings of the same problem, providing a contemporary philosophical defense of Engels that can be set against Vogel's more critical retrieval. POSITION: Unitary theory, via a sympathetic reconstruction of Engels.",
    keywords = "engels, origin-of-the-family, unitary-theory, critique, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = "In this paper I argue that Frederick Engels's The Origin of the Family, Private Property and the State remains a fundamental resource for anyone wanting to understand the oppression of women as a capitalist form. By re-examining the strengths and weaknesses of Engels's historicisation of women's oppression through the lens of the debates opened by second wave feminism, I argue that, once properly understood, we can overcome the limitations of Engels's book to point to the kind of unitary theory of women's oppression essential to a strategy adequate to the needs of the struggle for women's liberation.",
    abstract_source = "s2"
}

@article{portellabusk2024formal,
    author = "Portella, Elizabeth and Busk, Larry Alan",
    title = "The Formal and Real Subsumption of Gender Relations",
    journal = "Historical Materialism",
    year = "2024",
    number = "3",
    note = {CORE ARGUMENT: The authors argue that existing responses to the transhistorical status of patriarchy fall into two camps -- dual/triple-systems approaches, which grant patriarchy autonomy relative to capitalism, and "origins-subsistence" approaches, which give patriarchal relations a foundational status in capitalism's own history. They propose using Marx's concepts of formal and real subsumption to explain both capitalism's appropriation of pre-existing patriarchal forms and its production of new, specifically capitalist forms of gendered oppression, aiming for a unitary theory that avoids transhistorical claims about patriarchy. RELEVANCE: This paper directly engages the dual-systems/unitary debate as a debate about how to use core historical-materialist categories (subsumption, mode of production) to theorize gender, making it a useful bridge piece between Hartmann's dual-systems theory and social reproduction theory for synthesis purposes. POSITION: Unitary theory, reconstructed via formal/real subsumption.},
    keywords = "unitary-theory, dual-systems-theory, subsumption, base-superstructure, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = {Attempts to unify Marxist and feminist social critique have been vexed by the fact that "patriarchy" predates the advent of capitalism (its transhistorical status). Feminists within the Marxist, socialist, and materialist traditions have responded to this point by either granting patriarchy a certain autonomy relative to capitalism (the "dual/triple systems" approach), or by suggesting that patriarchal relations have a foundational and necessary status in the history of capitalist development (which we term the "origins-subsistence" approach). This paper offers an alternative account of the relationship between capitalism and the transhistorical status of "patriarchy". In aid of a "unitary theory" of Marxist Feminism, we argue that the transhistorical status of patriarchy is better understood through an application of Marx's concepts of formal and real subsumption. A modified version of these concepts can illuminate not only capitalist appropriation of antecedent social and economic forms, but also its capacity to produce new forms of gendered exploitation and oppression.},
    abstract_source = "s2"
}

@misc{goikoetxea2024idealism,
    author = "Goikoetxea, Jule",
    title = "Idealism and Biologism in Social Reproduction Theory: A Materialist Critique",
    year = "2024",
    number = "2",
    note = {CORE ARGUMENT: Goikoetxea offers a materialist interpretation of what she calls the "first, second and third Marxist-feminist theses," arguing through a critical analysis of the unitary theory tradition that some formulations of social reproduction theory smuggle in idealist or biologistic assumptions -- treating reproductive labor's significance as rooted in bodily/biological facts rather than in historically specific social relations of production. RELEVANCE: This is an internal critique of social reproduction theory from within the unitary/materialist camp, useful for showing that the dual-systems/unitary debate has an important second axis (materialist vs. idealist/biologistic readings of reproduction) that synthesis should not collapse into the dual-systems question alone. POSITION: Unitary/materialist critique of biologistic tendencies within social reproduction theory.},
    keywords = "social-reproduction-theory, materialism, critique, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The article gives a materialist interpretation of the first, second and third Marxist-feminist Theses through a critical analysis of the Unitary Theory of Social Reproduction. It argues that Social Reproduction Theory resorts to idealism and biologism when explaining male domination. A meta-critical incision will be carried out by studying the use Social Reproduction Theory makes of categories such as 'production', 'reproduction', 'exploitation' and 'oppression', in that these categories are addressed as historical while the categories of 'women' and 'men' are de-historicized and naturalized. According to Unitary Theories, 'women' are not material, historical products of patriarchy but biological beings (biologism) that have been culturally devalued (idealism). This leads to an essentialist ontology where 'women' and 'men' precede the relations of production that create them. This idea obstructs the formation of a materialist philosophy of praxis.",
    abstract_source = "s2"
}

@misc{falquet2024francophone,
    author = "Falquet, Jules",
    title = "Francophone Materialist Feminism, the Missing Link: Towards a Marxist Feminism That Accounts for the Interlockedness of Sex, Race and Class",
    year = "2024",
    number = "2",
    note = {CORE ARGUMENT: Falquet argues that Anglophone debates over dual-systems and social reproduction theory have largely ignored francophone materialist feminism (associated with Christine Delphy and others), which independently developed a theory of a "domestic mode of production" analytically distinct from, but articulated with, the capitalist mode of production, and which anticipated later attempts to theorize the interlocking of sex, race and class. RELEVANCE: This paper supplies the francophone materialist-feminist alternative (Delphy's domestic-mode-of-production thesis) that could not be independently verified as a standalone entry in this bibliography, and situates it relative to both dual-systems and unitary/social-reproduction positions, filling an important comparative gap. POSITION: Francophone materialist feminism (a distinct national-tradition variant of dual/multiple-systems theorizing).},
    keywords = "materialist-feminism, domestic-mode-of-production, delphy, intersectionality, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {This article discusses the Marxist-Feminist Theses III and VIII. It is based on the "French-speaking materialist feminist" theoretical perspective that has been developed at the end of the 1970s by Colette Guillaumin (with the concept of "sexage"), Monique Wittig (with the concept of "straight mind"), Nicole-Claude Mathieu, Christine Delphy and other members of the Nouvelles Questions Féministes journal's board. The article first presents this theorization, which is too unknown to many English-speaking theorists. It then shows how "French-speaking materialist feminist" theoretical perspective fully demonstrated that "sex" was a structural social relation as much as class is (Gender relations are relations of production). The article also analyses how this theoretical perspective enables us to pay a deep attention to the "race question". Therefore, it appears as the missing link that can help bridging at least two important theoretical and political gaps: first, between Marxist feminism and lesbian theory, and, second, between Black feminism and Marxist feminism.},
    abstract_source = "s2"
}

@article{ferguson2016intersectionality,
    author = "Ferguson, Susan",
    title = "Intersectionality and Social-Reproduction Feminisms",
    journal = "Historical Materialism",
    year = "2016",
    number = "2",
    note = {CORE ARGUMENT: Ferguson argues that social reproduction feminism has under-theorized its relationship to intersectionality, and that a more fully integrative ontology -- one that treats "the social" as constituted by practical human activity organized capitalistically -- can capture the dialectical relationship between the capitalist totality and its differentiated parts (race, gender, class) better than an additive intersectional model. RELEVANCE: This paper addresses a live tension within unitary social reproduction theory: whether its totalizing, unitary ontology is compatible with, or in competition with, intersectionality's emphasis on the irreducibility of multiple axes of oppression -- directly relevant to assessing SRT's adequacy as an extension of historical materialism. POSITION: Unitary social reproduction theory, seeking integration with intersectionality.},
    keywords = "social-reproduction-theory, intersectionality, unitary-theory, Medium, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Seeking to capture the multi-layered, contradictory, nature of subjectivities and social positions through a framework which insists upon the complex, dynamic nature of the social, intersectionality feminism has inspired Marxist-Feminists to push the social-reproduction feminism paradigm beyond a narrow preoccupation with gender/class relations. Yet even its most politically radical articulations stop short of fully theorising the integrative logic they espouse. This article explores the roots of this under-theorisation, and suggests that a more fully integrative ontology informs certain formulations of social-reproduction feminism. In understanding the social as constituted by practical human activity whose object (the social and natural world) is organised capitalistically, social-reproduction feminism highlights the dialectical relationship between the capitalist whole and its differentiated parts. The challenge for Marxist-Feminism is to embrace this dialectical approach while building on the insights of intersectionality feminism to more convincingly capture the unity of a complex, diverse social whole.",
    abstract_source = "openalex"
}

@misc{federici2021marx,
    author = "Federici, Silvia",
    title = "Marx on Gender, Race, and Social Reproduction: A Feminist Perspective",
    year = "2021",
    note = {CORE ARGUMENT: Federici argues that Marx's own analysis of capital accumulation systematically excludes reproductive labor and racialized/colonial labor from its conception of "productive" work, and traces the consequences of this exclusion for later Marxist treatments of sexism and racism. She contends that, despite this limitation, Marx's method (particularly on primitive accumulation) supplies resources feminists have used to establish social reproduction as a crucial terrain of capital accumulation and of anti-capitalist struggle. RELEVANCE: Federici, a key figure of the original Wages for Housework/domestic-labor debate, here directly assesses how far Marx's category of production can be extended to cover reproductive labor, connecting the 1970s domestic labor debate to contemporary social reproduction theory and situating both relative to Marx's own texts rather than only Engels's. POSITION: Autonomist/Wages-for-Housework-descended materialist feminism, read back onto Marx's own texts.},
    keywords = "domestic-labor-debate, social-reproduction, marx, primitive-accumulation, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{ida2022impact,
    author = "Ida, Kumiko",
    title = "Impact of Marxist Feminism on Japanese Women's Movement: Focusing on the Domestic Labor Debates",
    year = "2022",
    note = {CORE ARGUMENT: Ida traces how the domestic labor debate, imported to Japan after the 1980s and represented especially by Ueno Chizuko, shaped Japanese Marxist feminism's distinct engagement with historical materialism, including disputes over whether housework should be analyzed through the concept of a "household mode of production" or directly through Marx's categories of value and labor power. RELEVANCE: This paper documents the international reception and reworking of the domestic labor debate outside the Anglo-American and francophone contexts already represented in this bibliography, showing that the argument over how to extend historical-materialist categories to housework was a genuinely international current within Marxist feminism. POSITION: Domestic labor debate (Japanese reception).},
    keywords = "domestic-labor-debate, marxist-feminism, mode-of-production, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "The term Marxist feminism was introduced from the West and appeared in Japan after the 1980s. The representative theorist was Ueno Chizuko, who greatly contributed to the development of feminist theories in Japan, including Marxist feminism. It should be noted that this argument was not new in Japan, and in the 1970s, when the domestic labour theories began to be discussed in Western countries, there existed in Japan the original discussions by Takenaka Emiko, Iijima Aiko and others, which go back to the issue of socialist women, such as Yamakawa Kikue, before the Second World War. Of particular note was the 1960 housewife debate by Isono Fujiko and Mizuta Tamae, which had already pioneered Marxist feminism and most of the theorists in the 1970s succeeded the argument of the 1960s. Since the 1990s, the perspective of considering housework and childcare as labour has been reflected in social support for child and elderly care enacting the related laws. The change was accompanied by the women's labour movement and women's human rights issues such as the elimination of violence against women. It can be said that the recognition that 'housework is labour', formed by the domestic labour debate, as a whole, contributed to shake the patriarchal concept of labour and empowered the emergence of various movements concerning women that had been overlooked before.",
    abstract_source = "openalex"
}

@misc{liu2024domestic,
    author = "Liu, Jiahuan",
    title = "Is Domestic Labor Productive Labor: An Inquiry Based on Historical Materialism",
    year = "2024",
    note = {CORE ARGUMENT: Liu revisits the core question of the domestic labor debate -- whether unpaid housework is "productive labor" in Marx's technical sense (labor that produces surplus value) -- and argues that Western feminist Marxists have historically split into two incompatible positions (domestic labor as a distinct, non-capitalist mode of production versus domestic labor as directly value-producing), neither of which adequately accounts for its relation to capitalist accumulation. RELEVANCE: This paper offers a recent, explicit restatement of the analytical core of the domestic labor debate directly in Marx's categories of productive/unproductive labor, useful for a synthesis section that needs to state precisely what is at stake in extending "production" to housework. POSITION: Domestic labor debate (productive-labor question).},
    keywords = "domestic-labor-debate, productive-labor, value-theory, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {An important concern in contemporary feminist Marxist studies is the concept of "domestic labor." Western feminists present two different positions in the debate surrounding the question of whether domestic labor is productive labor. However, from the perspective of Marx's critique of political economy, neither position surpasses the basic theoretical framework of the capitalist mode of production. An analysis based on Marx's theory of the correlation between productive and unproductive labor reveals that this framework alone is insufficient for theorizing domestic labor. To highlight its theoretical significance, it is necessary to examine it within the framework of Marx's historical materialism.},
    abstract_source = "s2"
}

@misc{gabrielli2024wages,
    author = "Gabrielli, Martina",
    title = "'Wages for Housework': The Evolution of the Debate in the 1970s Italian Women's Movement",
    year = "2024",
    volume = "30",
    number = "1",
    note = {CORE ARGUMENT: Gabrielli reconstructs the historical trajectory of Lotta Femminista, the Italian separatist feminist network (including Dalla Costa and Fortunati) that launched the Wages for Housework campaign, showing how the group's theoretical position -- that housework produces value for capital even though it is unwaged -- developed and fragmented over the course of the 1970s. RELEVANCE: This paper provides the historical grounding for the "value-producing housework" wing of the domestic labor debate (associated with Dalla Costa and Fortunati), which is the position against which both Hartmann's dual-systems theory and Vogel's unitary theory later defined themselves; essential background for the domain's account of how the debate over "production" originated. POSITION: Wages for Housework (housework as directly value-producing).},
    keywords = "wages-for-housework, domestic-labor-debate, italy, value-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "This article delves into the historical trajectory of Lotta Femminista, a pioneering separatist feminist network in Italy during the early 1970s, and its significant influence on feminist discourse, particularly concerning the advocacy for wages for housework. Through an examination of the group's development within the broader context of the Italian women's movement, this study illuminates the theoretical foundations and practical activism associated with the perspective on wages for housework. Drawing on archival documents and personal accounts, the essay investigates how Lotta Femminista depicted domestic labour as a form of women's exploitation within a Marxist framework. Despite facing criticism and opposition, Lotta Femminista's ideas resonated globally, leaving a legacy in feminist theory and activism. Through its engagement with issues such as the refusal to work and the recognition of unpaid care as a site of capitalist exploitation, Lotta Femminista contributed to the broader history of feminism in Italy and beyond.",
    abstract_source = "s2"
}

@misc{blank2014production,
    author = "Blank, Gary",
    title = "Production and Patriarchy in Capitalist Society: A Comparative Review of Hartmann and Young",
    year = "2014",
    howpublished = "Analize: Journal of Gender and Feminist Studies, New Series, no. 2 (16)",
    note = {CORE ARGUMENT: Blank compares Hartmann's dual-systems theory with Iris Young's "single system" reply in "The Limits of Dual Systems Theory," arguing that Hartmann's account relies on a transhistorical structure (patriarchy as a cross-epochal system of male control over female labor) while Young's alternative risks functionalist reasoning (explaining the sexual division of labor by its usefulness to capital). He argues both approaches fall short of a genuinely historical-materialist theory that would explain the material basis of capitalist patriarchy without either move. RELEVANCE: This is a direct comparative assessment of the two founding positions in the dual-systems debate (Hartmann versus Young/proto-unitary theory), making it a natural bridge for synthesis between the primary Hartmann essay and the later unitary/social reproduction literature in this file. POSITION: Critical of both dual-systems theory and functionalist single-system replies; argues for a more genuinely historical-materialist alternative.},
    keywords = "dual-systems-theory, hartmann, young, critique, web-source, Medium, INCOMPLETE, no-abstract"
}

@misc{fortunati2024domestic,
    author = "Fortunati, Leopoldina",
    title = "The Domestic Sphere",
    year = "2024",
    note = {CORE ARGUMENT: Fortunati revisits the central claims of her own The Arcane of Reproduction: Housework, Prostitution, Labor and Capital (originally 1981), restating that the domestic sphere is not politically marginal but the site where personal and social reproduction is organized, and that this reproductive activity, while distinct from directly value-producing labor, is what maintains and renews labor power for capitalist production. RELEVANCE: Fortunati's Arcane of Reproduction is a foundational text of the domestic labor debate, arguing (against a simple "housework produces surplus value" reading) that reproduction creates use-values that are only later transformed into exchange-value in production; this retrospective essay, by the original author, restates that position for a contemporary readership and clarifies a frequently misread argument central to this domain. POSITION: Domestic labor debate (reproduction of labor power as distinct from, but necessary to, value production).},
    keywords = "domestic-labor-debate, social-reproduction, fortunati, Low, METADATA\_CLEANED: journal, number, doi, type:@article->@misc",
    abstract = {Leopoldina Fortunati's book 'The Arcane of Reproduction: Housework, Prostitution, Labor and Capital' (originally published in 1981), stands as one of the most important texts within 1970s feminist critique. This book has evolved and informed Fortunati's subsequent work on domestic and affective labor as well as her interaction with politics and technology. In this text, Fortunati argues that today the most important place of politics is the domestic sphere, the 'ground zero' of reproduction. As she writes: "Personal and social reproduction has completely changed the identity of the domestic sphere: from being considered by traditional political organizations as a place of political backwardness, it has become the beating heart at the social and political level of the entire capitalist system."},
    abstract_source = "s2"
}

@book{wallerstein2004worldsystems,
  author = {Wallerstein, Immanuel},
  title = {World-Systems Analysis: An Introduction},
  publisher = {Duke University Press},
  year = {2004},
  note = {
  CORE ARGUMENT: Wallerstein presents the modern world-system — not the nation-state or individual society — as the proper unit of historical-social analysis, tracing the emergence of a capitalist world-economy in the "long" sixteenth century, structured into core, periphery, and semi-periphery zones bound together by an international division of labor and a single world market, and periodized through successive phases culminating in the crises of the twentieth century.

  RELEVANCE: This is the primary methodological statement against which Brenner's "neo-Smithian Marxism" charge and all subsequent defenses and revisions of world-systems analysis must be read; it establishes the scale-shift (world-economy rather than social formation) that this domain's entire debate with orthodox and Political Marxism turns on.

  POSITION: Foundational statement of world-systems analysis as an alternative unit of analysis to the nation-state-centered variants of historical materialism.
  },
  keywords = {world-systems-theory, core-periphery, Wallerstein, High, INCOMPLETE, no-abstract}
}

@incollection{brenner1982neosmithian,
  author = {Brenner, Robert},
  title = {The Origins of Capitalist Development: A Critique of Neo-Smithian Marxism},
  booktitle = {Introduction to the Sociology of "Developing Societies"},
  publisher = {Macmillan Education UK},
  year = {1982},
  pages = {54--71},
  doi = {10.1007/978-1-349-16847-7_4},
  abstract = {The appearance of systematic barriers to economic advance in the course of capitalist expansion—the "development of under-development"—has posed difficult problems for Marxist theory. There has arisen, in response, a strong tendency sharply to revise Marx's conceptions regarding economic development. In part, this has been a healthy reaction to the Marx of the Manifesto, who envisioned a more or less direct and inevitable process of capitalist expansion: undermining old modes of production, replacing them with capitalist social productive relations and, on this basis, setting off a process of capital accumulation and economic development more or less following the pattern of the original homelands of capitalism.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Brenner argues that Wallerstein and Frank, in explaining capitalist development and underdevelopment through the world market's division into exploiting core and exploited periphery, effectively reproduce Adam Smith's commercialization model of economic development rather than Marx's analysis of historically specific class relations of production; he labels this "neo-Smithian Marxism" because it displaces class struggle over the relations of production from the center of the analysis in favor of a generic logic of trade and profit-maximization operating at the level of the world market.

  RELEVANCE: This is the direct textual source of the "neo-Smithian Marxism" charge this domain is tasked with tracing; it is the founding document of the dispute between world-systems/dependency theory and the production-centered, class-relational current (elaborated as Political Marxism in a separate domain of this review) over whether "capitalism" and "exploitation" can be theorized at the scale of the world-economy at all.

  POSITION: Class-relational critique of world-systems and dependency theory as a circulationist ("neo-Smithian") departure from Marx's theory of capitalist relations of production.
  },
  keywords = {neo-smithian-marxism, brenner-critique, world-systems-theory, dependency-theory, class-relations, High}
}

@article{denemarkthomas1988brennerwallerstein,
  author = {Denemark, Robert A. and Thomas, Kenneth P.},
  title = {The Brenner-Wallerstein Debate},
  journal = {International Studies Quarterly},
  year = {1988},
  volume = {32},
  number = {1},
  pages = {47--65},
  doi = {10.2307/2600412},
  abstract = {One of the most critical evaluations of Immanuel Wallerstein's world-systems perspective comes from Marxists who dislike the dominant role played by trade as opposed to class interaction in his analysis. At the forefront of this critique is Robert Brenner, whose article in New Left Review, "The Origins of Capitalist Development: A Critique of Neo-Smithian Marxism," has elicited far less of a debate than is warranted. In the first part of this article we carefully outline the various parts of this important critique, briefly drawing attention to some of the much more fundamental issues each addresses. In the second part we consider one of the most important of these issues, that of the most appropriate level of analysis for understanding political phenomena. The debate over this point revolves largely around events in Poland in the fifteenth and sixteenth centuries. Thus this rather arcane topic takes center stage in an argument with far broader implications. We conclude that while one should maintain a wider system level of analysis, more attention must be paid to the concrete determinants of power within political units as well.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Denemark and Thomas reconstruct the dispute between Brenner and Wallerstein as centering on two distinct, largely incommensurable questions — Brenner's concern with the causal origins of capitalism in specific agrarian class relations versus Wallerstein's concern with the systemic reproduction and expansion of an already-existing world-economy — and argue that much of the polemical heat between the two positions stems from talking past one another on the unit and level of analysis rather than a straightforward empirical disagreement.

  RELEVANCE: Provides a synthesis-ready secondary account of exactly the methodological schism this domain must characterize, disentangling the "origins" question (Political Marxism's specialty) from the "reproduction of an already-constituted system" question (world-systems theory's specialty), which is useful for showing how the two currents' disagreement is partly a difference in explanatory task.

  POSITION: Meta-theoretical reconstruction arguing the Brenner-Wallerstein dispute conflates distinct explanatory projects (origins vs. reproduction of capitalism).
  },
  keywords = {neo-smithian-marxism, brenner-critique, world-systems-theory, methodology, Medium}
}

@book{amin1976accumulation,
  author = {Amin, Samir},
  title = {Accumulation on a World Scale: A Critique of the Theory of Underdevelopment},
  year = {1976},
  note = {
  CORE ARGUMENT: Amin develops a systematic theory of "unequal exchange" and "accumulation on a world scale," arguing that the capitalist world-economy is structurally polarized between "central" (autocentric) and "peripheral" (extraverted) formations, with value continuously transferred from periphery to center through trade conducted at prices that do not reflect equal labor values, producing and reproducing peripheral underdevelopment as a systemic effect of capital accumulation rather than a residual pre-capitalist condition.

  RELEVANCE: Alongside Wallerstein and Frank, this is a founding primary text of the dependency/world-systems current this domain must characterize, and its central category — unequal exchange as a mechanism of world-scale exploitation — is precisely the target of Brenner's and Weeks and Dore's production-centered Marxist critiques.

  POSITION: Foundational statement of unequal exchange and center-periphery polarization as the mechanism of capitalist accumulation on a world scale.
  },
  keywords = {unequal-exchange, samir-amin, accumulation, dependency-theory, High, INCOMPLETE, no-abstract}
}

@book{amin2010lawworldwide,
  author = {Amin, Samir},
  title = {The Law of Worldwide Value},
  year = {2010},
  note = {
  CORE ARGUMENT: Amin reformulates his theory of unequal exchange in terms of a "law of worldwide value," arguing that Marx's law of value must itself be reconceived at the scale of the capitalist world-economy, where the international mobility of capital but not of labor systematically generates and sustains a hierarchy of wage rates and profit rates between center and periphery that no purely national analysis of value can capture.

  RELEVANCE: Shows Amin explicitly attempting to relocate a core category of historical materialism — the labor theory of value — from the national to the world scale, making the theoretical ambition of this current (rather than only its empirical claims about underdevelopment) directly visible for comparison with orthodox and Political-Marxist value theory.

  POSITION: Reformulation of Marx's law of value as a "worldwide" law operating through structured wage and profit-rate hierarchies between core and periphery.
  },
  keywords = {unequal-exchange, samir-amin, law-of-value, dependency-theory, Medium, INCOMPLETE, no-abstract}
}

@article{weeksdore1979internationalexchange,
  author = {Weeks, John and Dore, Elizabeth},
  title = {International Exchange and the Causes of Backwardness},
  journal = {Latin American Perspectives},
  year = {1979},
  volume = {6},
  number = {2},
  pages = {62--87},
  doi = {10.1177/0094582X7900600205},
  abstract = {The unequal development of the productive forces was shown by Marx to be a fundamental law of capitalist accumulation; and, in general, it is this law which produces uneven development on a world scale and inequality among countries. While all Marxists agree that the explanation of inequality in levels of development between countries lies in the laws of uneven development, there is less agreement upon the mechanism by which this uneven development is produced and reproduced on a world scale. One can distinguish two broad approaches, (a) those who explain inequality in levels of development among countries primarily in the sphere of circulation, emphasizing the appropriation of the surplus of one country by another country, and (b) those who place the cause of inequality in the sphere of production, and, thus, as a relationship between classes reproduced on a world scale. The purpose of this paper is to critique the former position and to develop further the latter.},
  note = {
  CORE ARGUMENT: Weeks and Dore argue, from within the Marxist tradition and independently of Brenner, that theories locating the cause of Third World "backwardness" in unequal exchange (circulation) rather than in class relations of production reproduced on a world scale are theoretically mistaken: exploitation is a relation between classes, not between countries, and international value transfers must be explained through this class relation rather than treated as a self-standing mechanism.

  RELEVANCE: Demonstrates that the "trade versus production" critique of dependency/unequal-exchange theory was not solely an external (Political-Marxist) attack but was also mounted from inside the Marxist development-studies literature contemporaneously with Brenner, showing the neo-Smithian-Marxism charge reflected a broader fault line within 1970s Marxism rather than a single author's idiosyncratic polemic.

  POSITION: Internal Marxist critique of circulationist unequal-exchange theory, insisting exploitation and uneven development must be theorized through class relations of production reproduced at world scale.
  },
  keywords = {unequal-exchange, dependency-theory, class-relations, marxist-critique, Medium}
}

@article{kvangraven2020beyondstereotype,
  author = {Kvangraven, Ingrid Harvold},
  title = {Beyond the Stereotype: Restating the Relevance of the Dependency Research Programme},
  journal = {Development and Change},
  year = {2020},
  volume = {52},
  number = {1},
  pages = {76--112},
  doi = {10.1111/dech.12593},
  abstract = {This article evaluates the relevance of dependency theory for understanding contemporary development challenges, especially in the light of changes in the global economy over the past 50 years. In order to do so, the article rectifies previous misunderstandings of the scholarship and offers a new definition of dependency theory as a research programme, rather than a singular theory. Four core tenets of this research programme are identified: a global historical approach; theorizing of the polarizing tendencies of global capitalism; a focus on structures of production; and a focus on the specific constraints faced by peripheral economies. While each of these elements can be found in many contemporary theories, what makes dependency theory unique — and a particularly strong research programme — is the combination of these elements. The article demonstrates how this approach provides a deep and broad understanding that is necessary to appreciate the persistence of uneven development with reference to two case studies, namely successful industrialization in South Korea, and how the fragmentation of global value chains has impacted industrialization in Indonesia.},
  note = {
  CORE ARGUMENT: Kvangraven reconstructs dependency theory as a "research programme" with four core tenets — a global historical approach, theorization of capitalism's polarizing tendencies, an explicit focus on structures of production (not merely exchange), and attention to peripheral economies' specific structural constraints — and argues that critiques such as Brenner's, which characterize the school as reducing development to external, circulationist causes, rest on a caricature that ignores the production-focused strand of the tradition (including Frank's own case studies).

  RELEVANCE: Offers the most direct, contemporary rebuttal available to the neo-Smithian-Marxism charge central to this domain, arguing that the charge mischaracterizes at least part of the dependency tradition and proposing a reconstructed definition that foregrounds production relations at the global scale rather than mere trade/circulation.

  POSITION: Contemporary defense and reconstruction of dependency theory as a production-centered, not merely circulationist, research programme, against Brenner-style critiques.
  },
  keywords = {dependency-theory, neo-smithian-marxism, brenner-critique, research-programme, High}
}

@article{song2015reorienting,
  author = {Song, Hae-Yung},
  title = {Reorienting the Critique of the Capitalist World System beyond the Dichotomy between Trade vs. Production Relations},
  journal = {Journal of World-Systems Research},
  year = {2015},
  volume = {21},
  pages = {174--183},
  doi = {10.5195/jwsr.2015.533},
  abstract = {The question of 'capitalist transition' has been one of the central themes of Marxist scholarship including world-system analysis, and much effort has been made to identify how the capitalist mode of production came into being at a particular time in a particular location, and what historical conditions gave rise to it. The debate between Andre Gunder Frank and more broadly world-system analysis and Robert Brenner in the 1970s constitutes one of the key instances of this debate. Since Brenner called world-system analysis 'neo-Smithian' and criticized it for confusing the generic concept of market economy with capitalism (namely, capitalist social relations), the debate over capitalist transition has often been described as a contention over whether trade or production should be given primacy in explaining the emergence of capitalism.},
  note = {
  CORE ARGUMENT: Song argues that framing the Frank/Wallerstein–Brenner dispute as a binary choice between "trade" and "production" primacy obscures what is actually at stake: a disagreement over the proper boundary and scale of the unit of analysis — Brenner's nationally/regionally bounded social formation versus world-systems analysis's globally totalized world-economy — and proposes reorienting the critique toward this question of scale and totality rather than the trade/production dichotomy itself.

  RELEVANCE: Directly reframes the central methodological dispute this domain must present, offering a more precise diagnostic vocabulary (unit-of-analysis and scale, rather than trade-vs-production) for characterizing what divides world-systems theory from Political Marxism and orthodox historical materialism.

  POSITION: Meta-critical reframing of the Brenner-Frank/Wallerstein debate as fundamentally about scale and unit of analysis rather than trade versus production.
  },
  keywords = {neo-smithian-marxism, brenner-critique, world-systems-theory, unit-of-analysis, Medium}
}

@article{stephens2016accidentalmarxist,
  author = {Stephens, Cody},
  title = {The Accidental Marxist: Andre Gunder Frank and the "Neo-Marxist" Theory of Underdevelopment, 1958--1967},
  journal = {Modern Intellectual History},
  year = {2016},
  volume = {15},
  number = {2},
  pages = {411--442},
  doi = {10.1017/s1479244316000123},
  abstract = {Based on newly available archival records, this article examines the life and thought of Andre Gunder Frank from his years as a graduate student in development economics to the publication of his first and most influential book. A closer look at the evolution of Frank's thought provides new insight into the relationship of his brand of "neo-Marxist" development theories with both classical Marxism and modernization theory. Frank interpreted Marxist political debates according to the categories of thought of 1950s American development economics, and in doing so he both misinterpreted fundamental aspects of Marxism and simultaneously generated lively theoretical debates that remain relevant today.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Stephens traces the intellectual formation of Frank's dependency theory in the decade before its canonical 1966/1967 statements, showing that Frank arrived at his "development of underdevelopment" thesis through an idiosyncratic synthesis of neoclassical economics, area-studies fieldwork in Latin America, and only belatedly an explicit engagement with Marxism — complicating any straightforward genealogy of dependency theory as a simple application of pre-existing Marxist categories to the periphery.

  RELEVANCE: Provides an intellectual-historical corrective useful for this domain's account of how dependency theory extended (or, on this account, only retrospectively aligned itself with) historical materialism's categories, cautioning against reading Frank's mature "neo-Marxist" self-presentation back into his formative theoretical development.

  POSITION: Intellectual history complicating the standard genealogy of Frank's dependency theory as a straightforward extension of orthodox Marxist categories.
  },
  keywords = {gunder-frank, dependency-theory, intellectual-history, Medium}
}

@article{kay2011andregunderfrank,
  author = {Kay, Cristóbal},
  title = {Andre Gunder Frank: 'Unity in Diversity' from the Development of Underdevelopment to the World System},
  journal = {New Political Economy},
  year = {2011},
  volume = {16},
  number = {4},
  pages = {523--538},
  doi = {10.1080/13563467.2011.597501},
  abstract = {The purpose of this article is to critically review the work of Andre Gunder Frank. This is no easy task given the prolific and controversial nature of his life work. His main distinction is as a paradigm breaker and a paradigm maker. Frank is one of the founders of contemporary world system theory. He coined some memorable expressions such as the 'development of underdevelopment' and 'Re-Orient'. Indeed, these two concepts highlight two distinct phases in his work. His first phase is characterised by his writings on dependency theory and his initial understanding of world system theory broadly in line with Amin, Arrighi and Wallerstein. His second phase is distinguished by what he considers to be the 'Eurocentric' interpretation of world system theory of Wallerstein and others as well as by his critique of his own earlier work. While some of Frank's analyses and assertions proved to be wrong, he provided much inspiration to a new generation of scholars and activists, some of whom provided the necessary empirical evidence and theoretical rigour lacking in parts of Frank's work.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Kay periodizes Frank's intellectual trajectory into two phases — an initial dependency-theory phase closely aligned with Amin, Arrighi, and Wallerstein's world-systems analysis, and a later phase in which Frank repudiated even Wallerstein's version of world-systems analysis as insufficiently non-Eurocentric, culminating in his ReOrient thesis of a continuous Asia-centered world economy — while noting that several of Frank's specific empirical claims did not hold up, even as his big-picture questions proved generative for later scholars.

  RELEVANCE: Establishes that world-systems/dependency theory is not a single stable current but underwent its own internal critique of Eurocentrism from within (Frank against Wallerstein), which matters for this domain's account of how thoroughly the school actually escaped a Eurocentric frame versus merely relocating it.

  POSITION: Biographical-intellectual account of Frank's shift from dependency theory and early world-systems analysis to a self-consciously anti-Eurocentric "world system" of continuous Asian centrality.
  },
  keywords = {gunder-frank, dependency-theory, world-systems-theory, eurocentrism, Medium}
}

@article{petras1981dependencyworldsystem,
  author = {Petras, James},
  title = {Dependency and World System Theory},
  journal = {Latin American Perspectives},
  year = {1981},
  volume = {8},
  number = {3-4},
  pages = {148--155},
  doi = {10.1177/0094582x8100800310},
  abstract = {World system theory (so designated by one of its major practitioners, Immanuel Wallerstein, 1975) is derived from the intellectual heritage found in the critique of the developmentalist perspective of liberal political economy. This critique was articulated in the work of Paul Baran (1957), A. G. Frank (1967, 1969), Theotonio Dos Santos (1971), and other dependency theorists. Recently, dependency has achieved a new status in the attention given to the unequal exchange theses of Arghiri Emmanuel (1972), Samir Amin's discussion (1974) of the accumulation of world capital, and Immanuel Wallerstein's historical interpretation (1974, 1976) of the rise of a single capitalist world economy. The basic framework of a world systems theorist gives rise to the basic categories of analysis: core, semiperiphery and periphery, or metropole and satellite. The real innovation of the world systems approach lies in the choice of the primary unit of analysis: the capitalist world economy. All phenomena are to be explained in terms of their consequence for both the whole of the system and its parts.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Writing while the dependency and world-systems currents were still consolidating, Petras compares and contrasts the two approaches' treatment of class, state, and the international division of labor, arguing that both need firmer grounding in concrete class analysis of specific social formations if they are to avoid collapsing global structural description into a substitute for class-based political analysis.

  RELEVANCE: An early, internally Marxist stock-taking of the dependency/world-systems current roughly contemporaneous with Brenner's critique, useful for showing that concerns about the adequacy of "class" as theorized at the world scale were being raised from within the tradition itself, not only by its Political-Marxist critics.

  POSITION: Internal Marxist comparative assessment of dependency and world-system theory's respective treatments of class and the state.
  },
  keywords = {dependency-theory, world-systems-theory, class-analysis, Medium}
}

@article{feliz2021notesunequalexchange,
  author = {Féliz, Mariano},
  title = {Notes For a Discussion on Unequal Exchange and the Marxist Theory of Dependency},
  journal = {Historical Materialism},
  year = {2021},
  volume = {29},
  number = {4},
  pages = {114--152},
  doi = {10.1163/1569206x-12341897},
  abstract = {The debate on the decline of the terms of trade in dependent countries was never fully integrated into the Marxist theory of dependency. The attempt to articulate it through the category of unequal exchange was not particularly systematic. This paper seeks to recover those debates and will attempt to account for the relevant articulations in the light of a present revitalisation of studies in the field of Marxist dependency theory. To this end, we will recover the classical discussions around unequal exchange in order to discuss their points of contact with the Marxist theory of dependency and some contemporary debates around the transfer of value and the super-exploitation of labour and nature.},
  note = {
  CORE ARGUMENT: Féliz revisits the classical debates on unequal exchange (Emmanuel, Amin) and argues they were never systematically integrated into the "Marxist theory of dependency" associated with Marini and the Latin American dependencia marxista tradition, then reconstructs the connections between unequal exchange, the transfer of value, and the "super-exploitation" of labor and nature as a basis for a revitalized Marxist dependency theory.

  RELEVANCE: Written for the flagship journal of contemporary orthodox/open Marxism, this piece exemplifies the ongoing internal reconstruction of dependency theory in explicitly Marxist (value-theoretic) terms, directly engaging the categories (value transfer, exploitation, super-exploitation) that this domain's key questions ask about, and shows the current remains an active site of theoretical development rather than a closed historical episode.

  POSITION: Reconstruction of unequal exchange and value-transfer theory as integral, underdeveloped components of the Marxist theory of dependency.
  },
  keywords = {unequal-exchange, dependency-theory, marxist-theory-of-dependency, value-transfer, High}
}

@article{chian2025wallersteinafricanist,
  author = {Chian, Sam},
  title = {Immanuel Wallerstein as Africanist: from Modernisation to Marxism in the 1960s},
  journal = {Review of African Political Economy},
  year = {2025},
  volume = {52},
  number = {183},
  doi = {10.62191/roape-2025-0001},
  abstract = {Immanuel Wallerstein's intellectual journey toward developing world-systems analysis began with his significant involvement in African studies during the 1960s. This article explores how Wallerstein's decade as an Africanist, marked by his deep engagement with the decolonisation movements across the continent, laid the foundation for his later Marxist-oriented critique of the capitalist world-economy. Through his work in Africa, Wallerstein progressively distanced himself from modernisation theory and embraced a Marxist perspective, largely informed by his interactions with figures like Frantz Fanon, Kwame Nkrumah and Amílcar Cabral. Initially focused on the nation state and independence movements in Africa, Wallerstein's scholarship increasingly recognised the limitations of methodological nationalism and the need to situate African political and economic conditions within the framework of historical capitalism.},
  note = {
  CORE ARGUMENT: Chian shows that Wallerstein's world-systems Marxism was not an a priori theoretical commitment applied to Africa from outside, but emerged out of his decade of fieldwork on African decolonization and his engagement with Fanon, Nkrumah, and Cabral, which led him to reject methodological nationalism and modernization theory in favor of situating African political economy within the framework of historical capitalism as a whole.

  RELEVANCE: Directly supports this domain's account of world-systems theory as a genuinely non-Eurocentric extension of historical materialism by tracing its origin to anti-colonial African political thought and struggle rather than to a purely metropolitan theoretical innovation later applied to the periphery.

  POSITION: Intellectual history locating the genesis of Wallerstein's Marxist world-systems analysis in his engagement with African decolonization and anti-colonial thought.
  },
  keywords = {wallerstein, world-systems-theory, decolonization, africanist, intellectual-history, Medium}
}

@article{deoliveirakvangraven2023backtodakar,
  author = {de Oliveira, Felipe Antunes and Kvangraven, Ingrid Harvold},
  title = {Back to Dakar: Decolonizing International Political Economy through Dependency Theory},
  journal = {Review of International Political Economy},
  year = {2023},
  doi = {10.1080/09692290.2023.2169322},
  abstract = {Whereas the field of International Political Economy (IPE) included a diversity of voices at its outset, histories of the field tend to marginalize certain contributions - particularly those from the Global South. The endeavor to decolonize IPE offers an opportunity to look back at IPE's history, re-discover the marginalized voices, and imagine new possible futures. This article engages with contemporary calls to decolonize IPE and proposes an alternative route to do so by recovering dependency theory. We argue that dependency theory can be conceptualized as a peripheral IPE perspective that was committed to thinking from the Global South and to producing politically engaged scholarship just as the field was being formed. The article elaborates on the key tenets of dependency theory, contrasting it with mainstream IPE, and putting it in dialogue with decolonial approaches. To demonstrate the simultaneous non-Eurocentric, anti-colonial, and policy-oriented potential of dependency theory, we recover a foundational moment that disciplinary histories of IPE have forgotten: the 1972 Dakar conference, organized by Samir Amin, with the participation of leading Latin American and African dependency scholars.},
  note = {
  CORE ARGUMENT: De Oliveira and Kvangraven recover the 1972 Dakar conference, organized by Amin and bringing together Latin American and African dependency scholars, as a suppressed founding moment of a genuinely Global South-centered international political economy, arguing that dependency theory's marginalization from mainstream IPE's disciplinary self-history was itself a form of epistemic Eurocentrism rather than a reflection of the theory's explanatory weakness.

  RELEVANCE: Substantiates this domain's claim that dependency/world-systems theory shows historical materialism's application "beyond a Eurocentric frame" with a concrete institutional and biographical episode (the Dakar conference), complementing Chian's account of Wallerstein and providing material for contrasting decolonial critiques of Eurocentrism with the separate trade-vs-production methodological critique from Political Marxism.

  POSITION: Decolonial historiographic recovery of dependency theory as a marginalized Global South current within international political economy.
  },
  keywords = {dependency-theory, samir-amin, decolonization, global-south, disciplinary-history, Medium}
}

@article{pradella2017marxglobalsouth,
  author = {Pradella, Lucia},
  title = {Marx and the Global South: Connecting History and Value Theory},
  journal = {Sociology},
  year = {2017},
  volume = {51},
  number = {1},
  doi = {10.1177/0038038516661267},
  abstract = {This article interrogates Marx's critique of political economy in the context of the global South and southern epistemologies. It first traces the contradictory roots of a non-Eurocentric conception of history within Adam Smith. Recovering Marx's silenced sociologies of colonialism in his writings and notebooks, it then shows that Marx incorporated colonialism and imperialism into his analysis of accumulation. The antagonism between wage-labour and capital needs to be understood as a global tendency, encompassing a hierarchy of forms of exploitation and oppression. Marx's support for the Taiping revolution (1850-1864) played a crucial, albeit often ignored, role in his theorisation. It allowed him to recognise the living potential for anti-colonial struggles and international solidarities, thus breaking with Eurocentric accounts of history.},
  note = {
  CORE ARGUMENT: Pradella argues, against readings of Marx as a Eurocentric stage theorist, that Marx's own later writings and notebooks incorporate colonialism and imperialism directly into his analysis of accumulation, theorizing the wage-labor/capital antagonism as a global tendency encompassing a hierarchy of exploitation forms across colonizer and colonized societies alike.

  RELEVANCE: Provides textual grounding, independent of Wallerstein/Frank/Amin's own theoretical innovations, for the claim that a world-scale, anti-Eurocentric extension of historical-materialist categories has warrant in Marx's own texts — relevant to assessing whether world-systems/dependency theory should be read as extending Marx's project or correcting a genuine Eurocentric limitation within it.

  POSITION: Textual-historical argument that Marx's own mature writings already incorporate a global, anti-Eurocentric analysis of accumulation, colonialism, and value.
  },
  keywords = {marx, eurocentrism, colonialism, value-theory, global-south, Medium}
}

@article{geneciran2024globalhistoricalmaterialism,
  author = {Geneciran, Joma},
  title = {Global Historical Materialism and Decoloniality},
  journal = {Review of African Political Economy},
  year = {2024},
  doi = {10.62191/roape-2024-0035},
  abstract = {This debate piece offers a global historical materialist critique of decolonial theory, engaging Walter Mignolo's work. It argues that decolonial literature, by creating abstract universals like modernity/coloniality, disarticulates theory from specific social formations and historical contexts. The author proposes eight methodological questions to demystify decolonial literature and reintegrate theory into history. Using Mignolo's writings, the paper demonstrates how decolonial thinking can lead to political detachment and ineffective transformative strategies. The critique emphasises grounding theory in concrete social formations to render history legible and serve national liberation movements. By contrasting decolonial abstractions with historical examples from anti-colonial struggles on and beyond the African continent, it highlights decolonial thought's limitations in addressing capitalism as a world system. It advocates for a global historical materialist analysis that integrates capitalism's interconnected nature and reintroduces the social formation as a unit of analysis for understanding social relations.},
  note = {
  CORE ARGUMENT: Geneciran defends a "global historical materialism" against decolonial theory (via a critique of Mignolo), arguing that decolonial abstractions like "modernity/coloniality" disarticulate theory from specific social formations and historical contexts, and that a properly world-scale historical materialism must reintroduce the social formation as a unit of analysis to render anti-colonial history legible and politically actionable.

  RELEVANCE: Offers a contemporary, explicitly self-identified "global historical materialist" position that both claims the world-systems/dependency legacy (world capitalism as an interconnected totality) and criticizes decolonial theory for abandoning the social-formation-level class analysis that this domain's methodological debates (Brenner vs. Wallerstein/Frank) turn on — showing the debate over scale and unit of analysis persists in a new, decolonial-theory register.

  POSITION: Defense of a social-formation-grounded "global historical materialism" against decolonial theory's abstraction from concrete class analysis.
  },
  keywords = {historical-materialism, decoloniality, world-capitalism, social-formation, Medium}
}

@article{foster1999metabolicrift,
  author = {Foster, John Bellamy},
  title = {Marx's Theory of Metabolic Rift: Classical Foundations for Environmental Sociology},
  journal = {American Journal of Sociology},
  year = {1999},
  volume = {105},
  number = {2},
  pages = {366--405},
  doi = {10.1086/210315},
  note = {
  CORE ARGUMENT: Foster reconstructs Marx's late engagement with Justus von Liebig's critique of capitalist "robbery" agriculture to argue that Marx theorized a "metabolic rift": capitalism's town/country division of labor systematically severs the material exchange (metabolism) between human beings and the soil, exporting nutrients embodied in food and fiber to the city and rupturing natural cycles of soil replenishment. Foster presents this not as a peripheral aside but as integral to Marx's mature critique of capitalist agriculture in Capital, Volume 3.

  RELEVANCE: This is the founding text of ecological Marxism as a distinct reconstruction of historical materialism, establishing that Marx's theory of history already contained an account of humanity's material relation to nature that later Marxist orthodoxy (and productivist readings of the "development of the productive forces") had suppressed or ignored. It is the reference point against which Saito's MEGA-based extensions, Moore's world-ecology critique, and Malm's defense of dualism are all positioned.

  POSITION: Founding statement of the "metabolic rift" school of ecological Marxism.
  },
  keywords = {ecological-marxism, metabolic-rift, Foster, High},
  abstract = {This article addresses a paradox: on the one hand, environmental sociology, as currently developed, is closely associated with the thesis that the classical sociological tradition is devoid of systematic insights into environmental problems; on the other hand, evidence of crucial classical contributions in this area, particularly in Marx, but also in Weber, Durkheim, and others, is too abundant to be convincingly denied. The nature of this paradox, its origins, and the means of transcending it are illustrated primarily through an analysis of Marx's theory of metabolic rift, which, it is contended, offers important classical foundations for environmental sociology.},
  abstract_source = {openalex},
}

@book{burkett1999marxnature,
  author = {Burkett, Paul},
  title = {Marx and Nature: A Red and Green Perspective},
  publisher = {St. Martin's Press},
  year = {1999},
  note = {
  CORE ARGUMENT: Burkett argues that Marx's value theory itself, not merely his scattered remarks on agriculture, presupposes and depends on nature as a material substratum of production: labor's ability to create value and use-value alike rests on nature's provision of "free gifts" (raw materials, energy, natural fertility) that capital appropriates without cost, so that treating capitalist growth as unconstrained by natural limits is a mystification internal to the value form itself, not something Marx's political economy overlooked.

  RELEVANCE: Burkett supplies the systematic, value-theoretic complement to Foster's metabolic-rift thesis, together establishing the twin textual and theoretical basis on which subsequent ecological-Marxist reconstructions of historical materialism (Saito, Foster and Burkett's joint later work) build; it directly engages -- and rejects -- the charge from earlier eco-socialist critics (e.g., Ted Benton) that Marx's productivism is incompatible with ecological limits.

  POSITION: Value-theoretic grounding of ecological Marxism, defending Marx's political economy against charges of Promethean productivism.
  },
  keywords = {ecological-marxism, value-theory, Burkett, Medium, INCOMPLETE, no-abstract},
}

@book{saito2017ecosocialism,
  author = {Saito, Kohei},
  title = {Karl Marx's Ecosocialism: Capital, Nature, and the Unfinished Critique of Political Economy},
  publisher = {Monthly Review Press},
  year = {2017},
  doi = {10.2307/j.ctt1gk099m},
  note = {
  CORE ARGUMENT: Drawing on Marx's unpublished natural-science notebooks (excerpts from Liebig and other agricultural chemists, published only in the ongoing Marx-Engels-Gesamtausgabe), Saito argues that Marx's ecological thought did not stop developing with the metabolic-rift passages of Capital but deepened continuously after 1868, as Marx pursued an increasingly systematic "theory of metabolism" intended, but never completed, as part of his critique of political economy. The book's two parts trace, first, how "alienation of nature" is built into Marx's theory of modernity, and second, how the MEGA2 notebooks document this unfinished extension.

  RELEVANCE: This is the philological anchor for the domain's central claim that historical materialism's treatment of nature is recoverable and extendable rather than a fixed, exhausted nineteenth-century doctrine; its argument that Marx's late notebooks revise rather than confirm a productivist "primacy of the productive forces" bears directly on the analytical-Marxist reconstruction of historical materialism covered elsewhere in this review.

  POSITION: MEGA2-based philological reconstruction of Marx's ecology as an unfinished, still-developing component of the critique of political economy.
  },
  sep_context = {SEP's "Karl Marx" entry (section "6 Alternative Interpretations") cites this book as evidence for a first stage of Marx's retreat from productivism: "in the period following the publication of Volume One of Capital, Marx increasingly thought of communism in eco-socialist terms, as offering sustainable economic growth (Saito 2017)."},
  keywords = {ecological-marxism, metabolic-rift, MEGA, Saito, High, INCOMPLETE, no-abstract},
}

@book{saito2023anthropocene,
  author = {Saito, Kohei},
  title = {Marx in the Anthropocene: Towards the Idea of Degrowth Communism},
  publisher = {Cambridge University Press},
  year = {2023},
  doi = {10.1017/9781108933544},
  note = {
  CORE ARGUMENT: Saito argues, again via the MEGA2 notebooks (including Marx's 1881 correspondence with Vera Zasulich on the Russian obshchina), that in his final years Marx abandoned the developmental, productive-forces-expanding vision of communism attributed to him by orthodox historical materialism and moved toward "degrowth communism": a vision of post-capitalist society organized around sustainable, non-expansionary use-value production rather than continued growth of exchange-value and productive capacity.

  RELEVANCE: This is the domain's most direct challenge to Cohen's "primacy thesis" (the claim that historical materialism explains social change via the tendency of productive forces to develop and outgrow existing relations of production): if Saito's reading is correct, Marx himself came to doubt that further development of the productive forces is either historically inevitable or emancipatory, which would require reconstructing rather than merely defending the classical theory of history's technological core.

  POSITION: Most far-reaching ecological-Marxist revision of historical materialism's productive-forces thesis, read as textual development internal to Marx's own late thought.
  },
  keywords = {ecological-marxism, degrowth, MEGA, Saito, primacy-thesis, High},
  abstract = {Facing global climate crisis, Karl Marx's ecological critique of capitalism more clearly demonstrates its importance than ever. This book explains why Marx's ecology had to be marginalized and even suppressed by Marxists after his death throughout the twentieth century. Marx's ecological critique of capitalism, however, revives in the Anthropocene against dominant productivism and monism. Investigating new materials published in the complete works of Marx and Engels (Marx-Engels-Gesamtausgabe), Saito offers a wholly novel idea of Marx's alternative to capitalism that should be adequately characterized as degrowth communism. This provocative interpretation of the late Marx sheds new lights on the recent debates on the relationship between society and nature and invites readers to envision a post-capitalist society without repeating the failure of the actually existing socialism of the twentieth century.},
  abstract_source = {s2},
}

@article{moore2017metabolicshift,
  author = {Moore, Jason W.},
  title = {Metabolic Rift or Metabolic Shift? Dialectics, Nature, and the World-Historical Method},
  journal = {Theory and Society},
  year = {2017},
  volume = {46},
  number = {4},
  pages = {285--318},
  doi = {10.1007/s11186-017-9290-6},
  abstract = {In the flowering of Red-Green Thought over the past two decades, metabolic rift thinking is surely one of its most colorful varieties. The metabolic rift has captured the imagination of critical environmental scholars, becoming a shorthand for capitalism's troubled relations in the web of life. This article pursues an entwined critique and reconstruction: of metabolic rift thinking and the possibilities for a post-Cartesian perspective on historical change, the world-ecology conversation. Far from dismissing metabolic rift thinking, my intention is to affirm its dialectical core. At stake is not merely the mode of explanation within environmental sociology. The impasse of metabolic rift thinking is suggestive of wider problems across the environmental social sciences, now confronted by a double challenge. One of course is the widespread -- and reasonable -- sense of urgency to evolve modes of thought appropriate to an era of deepening biospheric instability. The second is the widely recognized -- but inadequately internalized -- understanding that humans are part of nature.},
  abstract_source = {core},
  note = {
  CORE ARGUMENT: Moore argues that "metabolic rift" thinking, despite its dialectical intentions, tacitly reproduces a Cartesian nature/society dualism -- treating "nature" as an external object acted upon by an internal "society" -- and proposes instead a "world-ecology" method that theorizes capitalism as a way of organizing nature (capitalism-in-nature) rather than a social system that merely disrupts an external nature. He offers this as a "critique and reconstruction," not an outright rejection, of the rift tradition.

  RELEVANCE: This is the domain's central internal challenge to the Foster/Burkett/Saito metabolic-rift program, reopening -- in ecological terms -- historical materialism's long-standing base/superstructure and structure/agency dualisms; it is the direct target of Malm's "Against Hybridism" defense of dualist historical materialism included in this domain.

  POSITION: World-ecology critique of metabolic-rift dualism, proposing a monist alternative in which capital and nature are co-produced rather than externally related.
  },
  keywords = {ecological-marxism, world-ecology, metabolic-rift-debate, Moore, High}
}

@incollection{gellert2018distinctions,
  author = {Gellert, Paul K.},
  title = {Bunker's Ecologically Unequal Exchange, Foster's Metabolic Rift, and Moore's World-Ecology: Distinctions With or Without a Difference?},
  booktitle = {Ecologically Unequal Exchange},
  publisher = {Springer International Publishing},
  year = {2018},
  pages = {107--140},
  doi = {10.1007/978-3-319-89740-0_5},
  note = {
  CORE ARGUMENT: Gellert compares three ecological-Marxist frameworks -- Stephen Bunker's ecologically unequal exchange, Foster's metabolic rift, and Moore's world-ecology -- asking whether their disagreements track substantively different causal mechanisms and units of analysis or are largely terminological restatements of a shared underlying diagnosis of capitalism's ecological destructiveness.

  RELEVANCE: This is the domain's synthetic overview of the live metabolic-rift/world-ecology controversy, giving the review a secondary, adjudicating vantage point on the Foster/Saito vs. Moore dispute rather than relying solely on the disputants' own framings (Foster, Saito, Moore, Malm); it also links this domain back to the world-systems/dependency-theory domain via Bunker's unequal-exchange tradition.

  POSITION: Comparative/adjudicating overview of the metabolic-rift, world-ecology, and unequal-exchange traditions within ecological Marxism.
  },
  keywords = {ecological-marxism, metabolic-rift-debate, unequal-exchange, synthesis, Medium, INCOMPLETE, no-abstract}
}

@article{malm2019hybridism,
  author = {Malm, Andreas},
  title = {Against Hybridism: Why We Need to Distinguish between Nature and Society, Now More than Ever},
  journal = {Historical Materialism},
  year = {2019},
  volume = {27},
  number = {2},
  pages = {156--187},
  doi = {10.1163/1569206x-00001610},
  abstract = {It is fashionable to argue that nature and society are obsolete categories. The two, we are told, can no longer be distinguished from one another; continuing loyalty to the 'binary' of the natural and the social blinds us to the logic of current ecological crises. This article outlines an argument for the opposite position: now more than ever -- particularly in our rapidly warming world -- we need to sift out the social components from the natural, if we wish to understand the crises and retain the possibility of intervening in them. Tracing the current of hybridism to the writings of Bruno Latour, this article ends with a critique of the foremost proponent of a hybridism in Marxist garb: Jason W. Moore. Against his theories, it suggests that historical materialism is a form of property dualism that distinguishes between social and natural relations while considering them equally material in substance. That is also the analytical premise of ecological class hatred, the flames of which ecological Marxism seeks to fan.},
  abstract_source = {semantic_scholar},
  note = {
  CORE ARGUMENT: Malm defends a dualist reading of historical materialism -- nature and society are really distinct kinds of relations, though equally material -- against "hybridist" positions (traced to Bruno Latour) that dissolve the nature/society distinction. He argues Moore's world-ecology is hybridism "in Marxist garb," and that abandoning the distinction undermines the analytical and political work of identifying capital's specific responsibility for ecological crisis.

  RELEVANCE: This is the most explicit contemporary defense of historical materialism's ontological commitments (a "property dualism" of social and natural relations) against a rival ecological-Marxist current, directly engaging Moore's critique included in this domain and showing how metaphysical commitments inherited from classical historical materialism remain contested terrain in current ecological theory.

  POSITION: Dualist defense of historical materialism against Latourian/world-ecology hybridism.
  },
  keywords = {ecological-marxism, metabolic-rift-debate, dualism, Malm, High}
}

@book{malm2016fossilcapital,
  author = {Malm, Andreas},
  title = {Fossil Capital: The Rise of Steam Power and the Roots of Global Warming},
  publisher = {Verso},
  year = {2016},
  note = {
  CORE ARGUMENT: Malm offers a historical-materialist account of the transition from water to coal-fired steam power in the early British cotton industry, arguing against standard "energy availability" explanations that steam was adopted not because coal was cheaper or more abundant than water power but because it gave capitalists greater control over labor -- steam plants could be sited in labor markets rather than at fixed watercourse locations. He terms the resulting socio-technical formation "fossil capital," locating the origin of anthropogenic climate change in specifically capitalist relations of production and class struggle over labor discipline, not in technology or population growth as such.

  RELEVANCE: This is a sustained empirical application of historical-materialist method (relations of production and class struggle explaining a landmark technological transition) to the origins of the fossil economy, making the case that climate change itself is a class-specific rather than species-general ("Anthropocene") phenomenon -- directly relevant to how this domain's ecological Marxism reconstructs historical materialism's causal explanatory core.

  POSITION: Historical-materialist, class-struggle explanation of the fossil-fuel transition, contesting the "Anthropocene" framing of climate change as insufficiently attentive to capitalist class relations.
  },
  keywords = {ecological-marxism, fossil-capital, Malm, Medium, INCOMPLETE, no-abstract}
}

@book{chibber2013postcolonial,
  author = {Chibber, Vivek},
  title = {Postcolonial Theory and the Specter of Capital},
  publisher = {Verso},
  year = {2013},
  note = {
  CORE ARGUMENT: Chibber defends, against Subaltern Studies and postcolonial theory, the claim that capital has genuine "universalizing tendencies" -- that capitalist competition compels structurally similar forms of labor discipline, state formation, and class conflict across colonial and postcolonial social formations -- and argues that postcolonial theorists' insistence on the radical cultural and historical difference of the non-Western world rests on mischaracterizations of both Marx's theory and the actual history of bourgeois revolutions in the West.

  RELEVANCE: This is the domain's most polemical contemporary defense of historical materialism's universalizing ambitions in a changed political and academic climate (the ascendancy of postcolonial theory in the humanities), extending the world-systems/dependency-theory domain's concern with Eurocentrism into a direct confrontation with post-Marxist and postcolonial critiques of historical-materialist categories.

  POSITION: Defense of historical materialism's universalizing categories (capital, class, competition) against postcolonial-theoretical claims of Western/non-Western civilizational difference.
  },
  keywords = {historical-materialism-defense, postcolonial-theory, Chibber, Medium, INCOMPLETE, no-abstract}
}

@article{lazarus2016spectre,
  author = {Lazarus, Neil},
  title = {Vivek Chibber and the Spectre of Postcolonial Theory},
  journal = {Race \& Class},
  year = {2016},
  volume = {57},
  number = {3},
  pages = {88--106},
  doi = {10.1177/0306396815611853},
  note = {
  CORE ARGUMENT: Lazarus argues that Chibber's "Postcolonial Theory and the Specter of Capital" makes a valuable materialist contribution -- particularly its demonstration that capital's "universalizing tendency" need not entail cultural homogenization or the progressive spread of "Western" norms -- but that the book's polemical tone and its conflation of the historiographic project of Subaltern Studies with "postcolonial theory" more broadly cause it to misrepresent both traditions and their institutional relationship, weakening its own defense of historical-materialist universalism. Lazarus further argues Chibber wrongly diagnoses postcolonial theory as "Eurocentric" when it is better understood as a conjuncturally distinct version of "Third Worldism."

  RELEVANCE: This paper documents that Chibber's defense of historical materialism against postcolonial critique remains a live and unsettled controversy rather than a closed case, giving the review direct evidence of an ongoing, unresolved contemporary debate about how far historical-materialist categories can be defended against charges of Eurocentrism.

  POSITION: Sympathetic-critical response to Chibber, arguing his defense of universalizing capital succeeds on some points but overreaches and misdiagnoses its target on others.
  },
  keywords = {historical-materialism-defense, postcolonial-theory, Chibber-debate, Lazarus, Medium},
  abstract = {In this critical assessment of Vivek Chibber's Postcolonial Theory and the Specter of Capital, the author argues that the book contributes appreciably to the materialist critique of postcolonial studies, but that its effect is weakened both by its tone and its failure to identify its object precisely enough. In conflating the historiographic project of 'Subaltern Studies' with 'postcolonial theory', Chibber misrepresents the histories of each of these formations and also the institutional relationship between them. He is at his most compelling in his commentary on capital's 'universalising tendency', in which he demonstrates that arguments about capitalist globalisation do not require one to anticipate an increased homogenisation of the world or, more narrowly still, the progressive universalisation of 'western' norms, values and modes of social life. His critique of the deep-set postcolonialist conviction as to the radical difference and incommensurability between 'western' and 'non-western' worlds is also very valuable. But because he does not utilise the full resources of Marxist and anti-imperialist theory -- above all, the theory of uneven and combined development -- Chibber fails to diagnose 'postcolonial theory' for what it is: a conjuncturally distinct version of 'Third Worldism'. He wrongly accuses it, instead, of 'Eurocentrism'.},
  abstract_source = {openalex},
}

@incollection{fosterburkett2016antique,
  author = {Foster, John Bellamy and Burkett, Paul},
  title = {Marx and the Earth: An Anti-Critique},
  booktitle = {Marx and the Earth: An Anti-Critique},
  publisher = {Brill},
  year = {2016},
  doi = {10.1163/9789004288799},
  note = {
  CORE ARGUMENT: Foster and Burkett respond systematically to roughly a decade of criticism of the metabolic-rift program (including charges that it lapses into naturalistic determinism, mishandles the nature/society relation, or is superseded by Moore's world-ecology), defending the coherence of Marx's own ecological value theory and the metabolic-rift reading of Capital by elaborating the roles of dialectics, open-system thermodynamics, intrinsic value, and aesthetic understanding in Marx's original critique.

  RELEVANCE: This "anti-critique" shows the metabolic-rift program actively defending and refining itself in response to the same world-ecology and hybridism challenges (Moore, and by extension the concerns Malm later addresses) treated elsewhere in this domain, demonstrating that the rift/world-ecology dispute is a genuinely two-sided, ongoing exchange rather than a one-sided critique.

  POSITION: Sustained self-defense of the metabolic-rift program against a decade of ecological-Marxist and other criticism, proposing a "new red-green synthesis."
  },
  keywords = {ecological-marxism, metabolic-rift-debate, Foster, Burkett, Medium},
  abstract = {A decade and a half ago John Bellamy Foster and Paul Burkett introduced a new, revolutionary understanding of the ecological foundations of Marx's thought, demonstrating that Marx's concepts of the universal metabolism of nature, social metabolism, and metabolic rift prefigured much of modern systems ecology. Ecological relations were shown to be central to Marx's critique of capitalism, including his value analysis. Now in Marx and the Earth Foster and Burkett expand on this analysis in the process of responding to recent ecosocialist criticisms of Marx. The result is a full-fledged anti-critique -- pointing to the crucial roles that dialectics, open-system thermodynamics, intrinsic value, and aesthetic understandings played in the original Marxian critique, holding out the possibility of a new red-green synthesis.},
  abstract_source = {openalex},
}

@incollection{prewetal2018enduringrelevance,
  author = {Prew, Paul and Rotta, Tomás and Smith, Tony and Vidal, Matt},
  title = {The Enduring Relevance of Karl Marx},
  booktitle = {The Oxford Handbook of Karl Marx},
  publisher = {Oxford University Press},
  year = {2018},
  pages = {3--34},
  doi = {10.1093/oxfordhb/9780190695545.013.51},
  abstract = {This chapter is the introduction to The Oxford Handbook of Karl Marx. It summarizes Marx's enduring relevance by demonstrating the continuing applicability of his concepts and theories to understanding twenty-first century capitalism and its crises, along with the historical development of human society across varying modes of production. It presents an intellectual biography linking the major moments in Marx's life to his ideas and theories. The biography also gives insight into Marx's approach to research by focusing more closely on the method he outlined in the Grundrisse. It demonstrates, among other things, that Marx continually revised his ideas in light of new evidence and argumentation. The chapter concludes with brief summaries of the handbook's contributions, paying specific attention to the ongoing relevance of each chapter to societal concerns.},
  abstract_source = {core},
  note = {
  CORE ARGUMENT: Introducing a seven-part, multi-disciplinary handbook (sociology, economics, political science, philosophy, history, geography, and ecology), the editors argue that Marx's foundational categories -- including historical materialism, class, capital, value, crisis, and ideology -- continue to be "defended, elaborated and applied" in contemporary empirical social science, against repeated "obituaries" declaring Marxism's death; the handbook's Foundations section is explicitly devoted to defenses of these categories, and later sections extend them to core, peripheral, and semi-peripheral accumulation, crisis, and class struggle.

  RELEVANCE: This is the domain's synthetic, retrospective statement of where the historical-materialism debate stands across the social sciences in the late 2010s: a scholarly consensus among contributing specialists that the theory's core commitments remain live research programs rather than settled or refuted doctrine, providing this review's contemporary bookend against which the ecological and postcolonial-theory controversies (also covered in this domain) can be read as instances of exactly this kind of ongoing defense-and-elaboration.

  POSITION: Editorial/synthetic overview asserting the continued defensibility and productivity of Marx's (including historical-materialist) categories across the social sciences.
  },
  keywords = {historical-materialism-defense, synthesis, handbook, High}
}

