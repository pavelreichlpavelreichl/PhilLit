@misc{brenner1976agrarian,
    author = "Brenner, Robert",
    title = "Agrarian Class Structure and Economic Development in Pre-Industrial Europe",
    year = "1976",
    volume = "70",
    number = "1",
    note = {CORE ARGUMENT: Brenner argues that comparable demographic and commercial trends in late-medieval England and France produced sharply divergent long-run outcomes — agrarian capitalism in England, continued peasant proprietorship and stagnation in France — because of differences in the class structure of lordship and the outcomes of lord-peasant class struggle, not because of differing exposure to trade or population pressure. It is the balance of class power, not commercialization or demography, that determines whether productivity-raising agrarian capitalism emerges. RELEVANCE: This is the founding document of Political Marxism, launching the "Brenner Debate" and establishing the method — explaining historical transitions through contingent outcomes of class struggle over property relations — that the rest of this domain elaborates, contests, and revises. It directly rejects the commercialization model that both liberal and orthodox-Marxist historians shared. POSITION: Class-relational, anti-determinist theory of the transition to agrarian capitalism.},
    keywords = "political-marxism, brenner-debate, transition-to-capitalism, class-struggle, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{brenner1982agrarian,
    author = "Brenner, Robert",
    title = "Agrarian Class Structure and Economic Development in Pre-Industrial Europe: The Agrarian Roots of European Capitalism",
    year = "1982",
    volume = "97",
    number = "1",
    note = {CORE ARGUMENT: Brenner extends his 1976 argument with a detailed comparative account of the "agrarian roots" of European capitalism, tracing how the specific balance of lord-peasant class power in different regions of Europe (England, France, Eastern Europe) determined whether agriculture was reorganized along capitalist lines. He gives particular attention to why the English peasantry lost, and the English aristocracy won, the struggle over property rights that elsewhere entrenched small peasant proprietorship or seigneurial reaction. RELEVANCE: Together with the 1976 essay, this is the primary textual basis for everything downstream in this domain — Wood's generalization of the argument into a theory of capitalist "social property relations," Comninel's extension to France, and the entire subsequent "Transition Debate." POSITION: Comparative class-relational account of the agrarian origins of capitalism, rejecting both Malthusian-demographic and commercialization explanations.},
    keywords = "political-marxism, brenner-debate, transition-to-capitalism, agrarian-class-structure, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@book{wood1995democracy,
    author = "Wood, Ellen Meiksins",
    title = "Democracy against Capitalism",
    year = "1995",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Wood argues that capitalism is historically distinctive in separating "the economic" from "the political": unlike feudal or ancient modes of production, where surplus extraction is inseparable from direct political/coercive power, capitalism extracts surplus through purely economic compulsion — market dependence — leaving direct coercive power concentrated in a nominally separate state. This "differentiation" explains both capitalism's peculiar dynamism and the limits it places on democracy, since formal political equality (citizenship) leaves the economic sphere of appropriation untouched. RELEVANCE: This is Wood's fullest theoretical statement of Political Marxism's core concept — capitalism-specific "social property relations" — generalizing Brenner's historical argument into a systematic theory that underwrites her later historical work and the whole Political Marxism research program addressed in this domain. POSITION: Foundational theoretical statement of Political Marxism's concept of capitalism as a historically specific set of social property relations.},
    keywords = "political-marxism, social-property-relations, capitalism-and-democracy, High, METADATA\_CLEANED: doi",
    abstract = "Ellen Meiksins Wood argues that with the collapse of Communism the theoretical project of Marxism and its critique of capitalism is more timely and important than ever. Current intellectual fashions of the left which emphasise 'post-modern' fragmentation, 'difference', contingency and the 'politics of identity' can barely accommodate the idea of capitalism, let alone subject the capitalist system to critique. In this book she sets out to renew the critical programme of historical materialism by redefining its basic concepts and its theory of history in original and imaginative ways, using them to identify the specificity of capitalism as a system of social relations and political power. She goes on to explore the concept of democracy in both the ancient and modern world, examining the concept's relation to capitalism, and raising questions about how democracy might go beyond the limits imposed on it by capitalism.",
    abstract_source = "openalex"
}

@book{comninel1987rethinking,
    author = "Comninel, George C.",
    title = "Rethinking the French Revolution: Marxism and the Revisionist Challenge",
    year = "1987",
    publisher = "Verso",
    address = "London",
    note = {CORE ARGUMENT: Comninel argues that the "classic" Marxist account of the French Revolution as a bourgeois revolution against feudalism rests on a class analysis that revisionist historians (Furet, Cobban) had already empirically refuted — there was no capitalist bourgeoisie confronting a feudal aristocracy in 1789. Rather than concede the ground to non-Marxist revisionism, Comninel reconstructs the Revolution using a Brenner-style class-relational method: the revolutionary struggle is explained as an internal conflict within a single, office-holding and rent-extracting ruling class over the political forms of surplus extraction, not as a struggle between capitalist and feudal classes. RELEVANCE: Extends Political Marxism's class-relational method from the agrarian transition to capitalism (Brenner's terrain) to the paradigmatic case of "bourgeois revolution," directly informing the later Teschke/Post/Davidson debate on whether and how revolutions can be theorized as "capitalist" without assuming a pre-existing bourgeois class. POSITION: Class-relational reinterpretation of the French Revolution against both revisionist and orthodox-Marxist "bourgeois revolution" narratives.},
    keywords = "political-marxism, french-revolution, bourgeois-revolution, comninel, High, INCOMPLETE, no-abstract"
}

@misc{wood1989rational,
    author = "Wood, Ellen Meiksins",
    title = "Rational Choice Marxism: Is the Game Worth the Candle?",
    year = "1989",
    note = {CORE ARGUMENT: Wood argues that rational-choice/analytical Marxism (Elster, Roemer, and the "September Group") purchases methodological rigor at the cost of abandoning what is historically and politically distinctive about Marxism: by translating class, exploitation, and history into individualist, ahistorical microfoundations modeled on neoclassical economics, it produces conclusions difficult to distinguish from "bourgeois social science" and loses sight of the systemic, historically specific character of capitalist class relations that Political Marxism places at the center of analysis. RELEVANCE: This is Political Marxism's most direct and sustained polemical engagement with analytical Marxism, cited in the Stanford Encyclopedia of Philosophy's "Analytical Marxism" entry as a principal example of the "overarching criticism" that analytical Marxism's abstract, individualist framework loses what was valuable in historical materialism — making it the key bridge document between this domain and the analytical-Marxism domain of this review. POSITION: Political-Marxist critique of analytical/rational-choice Marxism as ahistorical and individualist. sep\_context: Cited in SEP "Analytical Marxism" (marxism-analytical), Section 6 "Overarching Criticisms": "it is suggested that analytical Marxism's treatment of exploitation, class, and history, involves an abstract, individualistic, and ahistorical, framework that makes its conclusions hard to distinguish, in many respects, from the theories of 'bourgeois social science' (E. Wood 1989: 55)." Also cited in Section 2 on the September Group's "donnish remoteness" (Wood 1989: 88).},
    keywords = "political-marxism, analytical-marxism, rational-choice-marxism, primacy-thesis, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@article{knafo2020political,
    author = "Knafo, Samuel and Teschke, Benno",
    title = "Political Marxism and the Rules of Reproduction of Capitalism: A Historicist Critique",
    journal = "Historical Materialism",
    year = "2020",
    volume = "29",
    number = "3",
    note = {CORE ARGUMENT: Knafo and Teschke argue that Political Marxism, despite its historicist origins in Brenner's emphasis on class agency and conflict, has increasingly drifted toward a structuralist "rules of reproduction" account of capitalism that treats capitalist laws of motion as a self-reproducing system — the very kind of structural determinism Political Marxism was originally meant to displace. They trace this tension back to an unresolved ambivalence already present in Brenner's own founding contributions to the Transition Debate, and call for a more thoroughly agency-based, praxis-centered reformulation. RELEVANCE: This is the pivotal internal critique that reopened debate on Political Marxism's coherence roughly forty years after the original Brenner Debate, prompting the 2021 Historical Materialism symposium (Pal, Rioux, Salgado, Lafrance, and others) and making explicit the risk that a "corrective" to determinism can itself relapse into structural determinism — directly relevant to this review's framing of Political Marxism as a corrective current. POSITION: Internal historicist critique and reformulation of Political Marxism against its own structuralist tendencies.},
    keywords = "political-marxism, historicism, rules-of-reproduction, internal-critique, High, METADATA\_CLEANED: pages, doi",
    abstract = "Marxism has often been associated with two different legacies. The first rests on a strong exposition and critique of the logic of capitalism, grounded in a systematic analysis of the laws of motion of capitalism as a system. The second legacy refers to a strong historicist perspective grounded in a conception of social relations that emphasises the centrality of power and social conflict to the analysis of history. This article challenges the prominence of structural accounts of capitalism by showing how the tension between these legacies has played out within Political Marxism, both orientations already having co-existed, somewhat uneasily, within Robert Brenner’s original contributions to the Transition Debate. Through this internal critique and re-formulation of Political Marxism, we wish to open a broader debate within Marxism on the need for a more agency-based account of capitalism, which builds more explicitly on the concept of social relations, to recover the historicist legacy of Marxism.",
    abstract_source = "s2"
}

@article{chibber2011living,
    author = "Chibber, Vivek",
    title = "What Is Living and What Is Dead in the Marxist Theory of History",
    journal = "Historical Materialism",
    year = "2011",
    volume = "19",
    number = "2",
    note = "CORE ARGUMENT: Chibber surveys the two dominant post-1970s reconstructions of Marxist historical theory — Robert Brenner's property-relations-centred Political Marxism and G.A. Cohen's technological-primacy defense of classical historical materialism — arguing that both, in different ways, respond to the explanatory problems of orthodox determinism, and assessing what each preserves and what each abandons of Marx's original theory of history. RELEVANCE: This paper explicitly stages the confrontation this review needs between Political Marxism and analytical Marxism's primacy thesis as the two live post-orthodox reconstructions of historical materialism, making it a natural anchor for comparing the two currents on the specific question of historical transitions. POSITION: Comparative assessment of Brenner's class-relational Political Marxism and Cohen's technological-primacy analytical Marxism as rival reconstructions of historical materialism.",
    keywords = "political-marxism, analytical-marxism, primacy-thesis, historical-materialism, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract During the 1980s and 1990s, the debate on the Marxist theory of history centred largely around the work of Robert Brenner’s property-relations-centred construal of it, and G.A. Cohen’s attempt to revive the classical, determinist argument. This article examines two influential arguments by Erik Wright and his colleagues, and by Alan Carling, which acknowledge important weaknesses in Cohen’s work, but which also try to construct a more plausible version of his theory. I show that the attempts to rescue Cohen are largely unsuccessful. And, to the extent that they render the argument plausible, they do so at the cost of turning it, willy-nilly, into a kind of class-struggle theory. I conclude that this spells the demise of the classical version of historical materialism, but also observe that this does not leave us with a voluntaristic understanding of history, as some of its defenders fear.",
    abstract_source = "openalex"
}

@misc{wood1996capitalism,
    author = "Wood, Ellen Meiksins",
    title = "Capitalism, Merchants and Bourgeois Revolution: Reflections on the Brenner Debate and its Sequel",
    year = "1996",
    number = "2",
    note = {CORE ARGUMENT: Wood addresses the "new front" opened by Brenner's later work on merchants and the English Revolution, arguing that introducing "commercial change" alongside agrarian class relations risks blurring the sharp distinction Political Marxism draws between capitalism and pre-capitalist commercial/mercantile activity. She insists that what is at stake is not merely a dispute over historical evidence about merchants, but a deeper disagreement — shared by Marxist and non-Marxist historiography alike — over what capitalism fundamentally is. RELEVANCE: Shows Wood defending and clarifying the theoretical core of Political Marxism (capitalism as a distinctive system of social property relations, not merely extensive trade) against ambiguities introduced by Brenner's own subsequent work, illustrating the internal tensions within Political Marxism well before the Knafo-Teschke critique made them explicit. POSITION: Defense of the social-property-relations definition of capitalism against commercialization-inflected readings of the Brenner thesis.},
    keywords = "political-marxism, brenner-debate, commercialization-model, bourgeois-revolution, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The “Brenner Debate” launched by Past and Present in 1976 was about “agrarian class structure and economic development in pre-industrial Europe”. Robert Brenner's recent book, Merchants and Revolution, has opened a new front in the debate by introducing merchants and “commercial change” into the equation. Although the book's massive Postscript carefully situates Brenner's analysis of commercial development in the context of his earlier account of the agrarian transition from feudalism to capitalism, this is unlikely to foreclose debate about how, or even whether, his more recent argument about the role of merchants in the English revolution can be squared with the original Brenner thesis. What is at issue here is not just divergent interpretations of historical evidence but larger differences about the nature of capitalism. The following argument has more to do with the latter than with the former, and it will be concerned with Brenner's work and the debates surrounding it not just for their own sake but for what they reveal about the dominant conceptions of capitalism, in Marxist and non-Marxist histories alike.",
    abstract_source = "openalex"
}

@article{wood1999horizontal,
    author = "Wood, Ellen Meiksins",
    title = "Horizontal Relations: A Note on Brenner's Heresy",
    journal = "Historical Materialism",
    year = "1999",
    volume = "4",
    number = "1",
    note = {CORE ARGUMENT: Responding to the controversy provoked by Brenner's application of class-relational analysis to twentieth-century capitalist crisis theory ("Uneven Development and the Long Downturn"), Wood defends the underlying logic of horizontal (capital-to-capital, competitive) as opposed to purely vertical (capital-labour) relations as an authentically Marxist analytical resource, against critics who read Brenner's move as an abandonment of Marx's value theory. RELEVANCE: Documents Political Marxism's extension beyond questions of historical transition into contemporary crisis theory, and shows Wood explicitly defending Brenner's method against charges — from other Marxists — that it is insufficiently Marxist, illuminating the boundary disputes that define Political Marxism as a distinct school. POSITION: Defense of Brenner's "horizontal," competition-centred crisis theory against value-theoretic critics within Marxism.},
    keywords = "political-marxism, brenner-debate, crisis-theory, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract One fundamental assumption seems to underlie – explicitly or implicitly – every critique of Brenner I have seen: that there can be no such thing as a Marxist theory of competition, the ‘horizontal’ relation among many capitals, that does not presuppose the ‘vertical’ class relation between capital and living labour. To start (if not also to end) with the relation between capital and living labour is the only way to establish one's Marxist credentials (establishing those credentials does, by the way, seem to be the critical, even the sole, issue for those who engage Brenner's argument on that plane, without considering the empirical or explanatory power of his argument). In support of that assumption, more than one critic has invoked Marx's comment that competition does not produce or explain capitalist laws of motion but merely executes them, as their visible manifestation in the external movements of individual capitals. Predictably, too, some critics have gleefully turned against Brenner the charge he has famously levelled against other Marxists: that his focus on competition and the market makes him a ‘neo-Smithian’.",
    abstract_source = "openalex"
}

@book{wood2002origin,
    author = "Wood, Ellen Meiksins",
    title = "The Origin of Capitalism: A Longer View",
    year = "2002",
    publisher = "Verso",
    address = "London",
    note = {CORE ARGUMENT: Wood's synthetic statement of Political Marxism's account of capitalist origins, arguing against both the "commercialization model" (capitalism as the natural outgrowth of trade and towns) and technological/demographic explanations, that capitalism emerged only once in history, in the specific and contingent conditions of English agrarian class relations, and that this historical specificity is obscured whenever capitalism is treated as a transhistorical extension of exchange or "improvement." RELEVANCE: The most widely cited single-volume statement of Political Marxism's thesis on capitalist origins, synthesizing and popularizing Brenner's historical argument for a broader audience; functions as the primary reference point for later critical engagement (Knafo and Teschke, Anievas and Nişancıoğlu, Moreno Zacarés) addressed elsewhere in this domain. POSITION: Synthetic statement of the "one-time, one-place" thesis on the origin of capitalism against commercialization and technological-determinist accounts.},
    keywords = "political-marxism, origin-of-capitalism, commercialization-model, High, INCOMPLETE, no-abstract"
}

@article{pal2021radical,
    author = "Pal, Maïa",
    title = "Radical Historicism or Rules of Reproduction? New Debates in Political Marxism",
    journal = "Historical Materialism",
    year = "2021",
    volume = "29",
    number = "3",
    note = {CORE ARGUMENT: Pal introduces the Historical Materialism symposium responding to Knafo and Teschke's 2020 critique, summarizing the theoretical foundations of Political Marxism, situating the "historicist vs. rules of reproduction" debate within broader questions of method and collective knowledge-production in Marxist historiography, and outlining the seven contributions of the symposium and their differing verdicts on how (or whether) Political Marxism should be reconstructed. RELEVANCE: Provides the most concise scholarly overview of the state of the internal Political Marxism debate as of the early 2020s, useful for orienting readers to the range of positions (radical historicism, defense of structural "rules," and various middle positions) that followed the Knafo-Teschke intervention. POSITION: Editorial overview of the post-2020 internal debate on Political Marxism's method.},
    keywords = "political-marxism, historicism, rules-of-reproduction, symposium, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "This introduction presents the symposium on Sam Knafo and Benno Teschke’s article in Historical Materialism, ‘Political Marxism and the Rules of Reproduction of Capitalism: A Historicist Critique’ (2021). It briefly summarises the foundations of Political Marxism, discusses the broader implications of the debate raised by Knafo and Teschke for questions of collective knowledge-production and methods in Marxist historiography, and outlines the seven contributions of the symposium. The introduction concludes by tracing, through the evolution of debates in Political Marxism and the contributions of its protagonists, some of the lineages of Marxist historiography as well as of the history of this journal.",
    abstract_source = "s2"
}

@article{rioux2013fiction,
    author = "Rioux, Sébastien",
    title = "The Fiction of Economic Coercion: Political Marxism and the Separation of Theory and History",
    journal = "Historical Materialism",
    year = "2013",
    number = "4",
    note = {CORE ARGUMENT: Rioux argues that Political Marxism's signature claim — that capitalism uniquely separates economic and political power, making surplus appropriation purely "economically" coerced — produces an ahistorical, "sanitised" conception of capitalism that cannot account for the extensive coercion and violence (colonial, racial, gendered) that has historically accompanied capitalist development. He proposes Jairus Banaji's historically specific, rather than formally abstract, conception of the mode of production as a corrective. RELEVANCE: An early and influential instance of the internal critique that Political Marxism's formal-abstractionist definition of capitalism separates theory from history — anticipating the Knafo-Teschke critique by several years and identifying Banaji's alternative framework as a rival pole within Marxist debates on capitalist origins that this domain's search did not otherwise pursue in depth (see NOTABLE\_GAPS). POSITION: Critique of Political Marxism's "economic coercion" thesis as ahistorical, advocating Banaji's historical conception of the mode of production instead.},
    keywords = "political-marxism, economic-coercion, social-property-relations, internal-critique, Medium, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Abstract The theory of social-property relations, or political Marxism, has argued that in contradistinction with pre-capitalist forms of exploitation, capitalism is characterised by the separation of the economic and the political, which makes surplus appropriation under this system uniquely driven by economic coercion. In spite of political Marxism’s various strengths, this article argues that the paradigm puts forward an ahistorical and sanitised conception of capitalism typical of bourgeois economics, which is an outcome of its formal-abstractionist approach to the concept of the mode of production and the separation between theory and history that it operates. A more satisfactory solution to political Marxism’s inability to make sense of past and present forms of coercion and violence under capitalism can be found in Jairus Banaji’s emphasis on Marx’s historical – rather than formal – conception of the mode of production.",
    abstract_source = "openalex"
}

@article{teschke2005bourgeois,
    author = "Teschke, Benno",
    title = "Bourgeois Revolution, State Formation and the Absence of the International",
    journal = "Historical Materialism",
    year = "2005",
    number = "2",
    note = {CORE ARGUMENT: Teschke, delivering the Deutscher Memorial Lecture, argues that Political Marxism's class-relational critique of "bourgeois revolution" narratives (following Comninel) needs to be extended to account for the international, geopolitical dimension of state formation, which orthodox theories of bourgeois revolution and Political Marxism's own domestic-class focus alike have neglected. RELEVANCE: Shows a leading Political Marxist (later co-author of the 2020 internal critique with Knafo) already identifying, over a decade earlier, a structural gap in Political Marxism's handling of "the international" — foreshadowing both his own later critique and the Eurocentrism charge pressed by Anievas and Nişancıoğlu. POSITION: Political-Marxist critique of "bourgeois revolution" theory for its neglect of international state formation.},
    keywords = "political-marxism, bourgeois-revolution, state-formation, comninel, Medium, METADATA\_CLEANED: volume, pages, doi",
    abstract = "© Koninklijke Brill NV, Leiden, 2005 Also available online – www.brill.nl 1 This is a revised version of the Isaac and Tamara Deutscher Memorial lecture, delivered on 9 October 2004 at Birkbeck College, University of London. I am grateful to the Deutscher Committee for the award of the Isaac and Tamara Deutscher Memorial Prize 2003, and, in particular, to Alfredo Saad-Filho for organisational and editorial support and George Comninel for his role as discussant on the Deutscher Lectures panel. Additionally, I would like to thank Justin Rosenberg, Kees van der Pijl, Ellen Wood, Samuel Knafo, Kamran Matin, and Robert Shilliam for detailed comments on the paper. The article was written in the register of a lecture and carries its synoptic, programmatic, and provocative marks. [Editorial note: the 2003 Deutscher Memorial Prize was won jointly by Benno Teschke (for The Myth of 1648) and Neil Davidson (for Discovering the Scottish Revolution). The following issue will carry Davidson’s Lecture. In a future issue, George Comninel will review both books.] 2 Teschke 2003. Benno Teschke Bourgeois Revolution, State Formation and the Absence of the International",
    abstract_source = "s2"
}

@article{post2019how,
    author = "Post, Charles",
    title = "How Capitalist Were the 'Bourgeois Revolutions'?",
    journal = "Historical Materialism",
    year = "2019",
    volume = "27",
    number = "3",
    note = {CORE ARGUMENT: Post critically reviews Neil Davidson's attempt (in How Revolutionary Were the Bourgeois Revolutions?) to rescue the concept of bourgeois revolution from both pro-capitalist revisionist historians and Political Marxist critics, arguing that Davidson's framework, despite distancing itself from crude Second-International formulations, still reproduces many of their historical and conceptual problems; Post defends a Political-Marxist alternative grounded in social-property-relations analysis of specific revolutionary conjunctures. RELEVANCE: Extends the Brenner/Comninel/Wood class-relational method to the broader comparative question of "bourgeois revolutions" beyond France, demonstrating Political Marxism's continued productive engagement with, and internal disagreement over, one of historical materialism's classic explanatory targets. POSITION: Political-Marxist critique of both revisionist and orthodox-Marxist theories of bourgeois revolution, via social-property-relations analysis.},
    keywords = "political-marxism, bourgeois-revolution, comninel, davidson-debate, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "The canonical version of the ‘bourgeois revolutions’ has been under attack from both pro-capitalist ‘Revisionist’ historians and ‘Political Marxists’. Neil Davidson’s book How Revolutionary Were the Bourgeois Revolutions? provides a thorough review of the intellectual history of the notion of the bourgeois revolution and attempts to rescue the concept from varied criticism. Despite distancing himself from problematic formulations of the bourgeois revolution inherited from Second-International Marxism, Davidson’s own framework reproduces many of the historical and conceptual problems of this tradition.",
    abstract_source = "s2"
}

@misc{morenozacares2018beyond,
    author = "Moreno Zacarés, Javier",
    title = "Beyond Market Dependence: The Origins of Capitalism in Catalonia",
    year = "2018",
    volume = "18",
    number = "4",
    note = "CORE ARGUMENT: Testing Brenner's own passing suggestion that Catalonia underwent an agrarian transition to capitalism parallel to England's, Moreno Zacarés finds instead that pre-capitalist social property relations persisted in Catalan agriculture throughout the relevant period, and that the region's capitalist breakthrough instead originated in sociocultural struggles within its eighteenth-century proto-industry — contrary to Brenner's agrarian-centered model. RELEVANCE: A rare empirical case study that tests the Political Marxism/Brenner thesis outside its paradigm case of England, finding it wanting and thereby illustrating both the empirical ambition and the empirical vulnerability of the class-relational transition theory that anchors this domain. POSITION: Empirical critique of Brenner's agrarian-transition thesis via a non-English case, emphasizing agency and proto-industrial subjectivity over agrarian class structure.",
    keywords = "political-marxism, brenner-debate, transition-to-capitalism, case-study, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Buried in the footnotes of his famous 1976 essay, Robert Brenner left the remark that Catalonia had experienced an agrarian transition to capitalism in parallel to England. This important claim has been completely forgotten by his followers of the political Marxist tradition, who since then have developed his views on the origins of capitalism. Building on the specialist literature, this article revisits the question of the Catalan transition through the prism of political Marxism and teases out its implications. In particular, it argues that the Catalan case illustrates the centrality of agency and subjectivity in the process of capitalist change. Contrary to Brenner's claim, this paper will argue that pre‐capitalist social property relations persisted in agriculture throughout the period of transition. Instead, the region's capitalist breakthrough was prompted by sociocultural struggles in its 18th‐century proto‐industry.",
    abstract_source = "s2"
}

@misc{anievas2013whats,
    author = "Anievas, Alexander and Nisancioglu, Kerem",
    title = "What's at Stake in the Transition Debate? Rethinking the Origins of Capitalism and the 'Rise of the West'",
    year = "2013",
    number = "1",
    note = {CORE ARGUMENT: Drawing on Trotsky's theory of "uneven and combined development," Anievas and Nişancıoğlu argue that Brenner's Anglo-centric theorization of capitalism's origins omits crucial international determinations — the Mongol invasions, Ottoman imperial expansion, and the discovery and colonization of the New World — that they claim actually determined the developmental trajectory of capitalism in north-western Europe. RELEVANCE: Represents the principal external (as opposed to Knafo-Teschke's internal) critique of Political Marxism, charging it with Eurocentrism for confining the explanation of capitalism's origins to intra-European class relations; this critique was later developed at monograph length in Anievas and Nişancıoğlu's How the West Came to Rule, described by reviewers as the most comprehensive response yet to Brenner's framework. POSITION: Uneven-and-combined-development critique of Political Marxism's Eurocentrism and its exclusively domestic/agrarian framing of capitalist origins.},
    keywords = "political-marxism, eurocentrism, uneven-and-combined-development, external-critique, Low, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "This article draws on the theory of uneven and combined development (U\&CD) to construct a non-Eurocentric and ‘internationalist’ analysis of the transition to capitalism. In doing so, we seek to respond to and rethink two challenges: exposures of Eurocentric notions of the ‘Rise of the West’ on the one hand; and recent critiques of Eurocentric assumptions in the theory of U\&CD on the other. Beginning with an assessment of Robert Brenner’s Anglo-centric theorisation of capitalism’s origins, we argue Brenner’s efforts are hamstrung by an omission of international determinations and conditions. In turn, we retrace these missing international factors through an analysis of the Mongol invasions of the 13th/14th centuries, Ottoman imperial expansion in the 15th/16th centuries and the contemporaneous discovery and colonisation of the New World. We argue that each case demonstrates the historically specific forms of U\&CD that fed into – and ultimately determined – the developmental trajectory of capitalism in north-western Europe.",
    abstract_source = "s2"
}

@misc{lafrance2026social,
    author = "Lafrance, Xavier",
    title = "Social Ontology in Open Marxism and Political Marxism: From Alienation, to Exploitation and Back Again",
    year = "2026",
    note = {CORE ARGUMENT: Lafrance compares how Open Marxism (Simon Clarke) and Political Marxism (Brenner, Wood) each critique the fetishized social ontology of orthodox Marxism, arguing that despite differences in vocabulary — social form and alienation versus social property relations and exploitation — the two currents converge on a shared rejection of a separate, asocial "economic" sphere, and that their apparent tensions are largely terminological rather than substantive. RELEVANCE: A very recent contribution that situates Political Marxism within a wider family of post-orthodox reconstructions of historical materialism's social ontology, useful for the review's account of Political Marxism's philosophical underpinnings and its relationship to cognate currents beyond the analytical-Marxism comparison already covered by Chibber. POSITION: Reconciliation of Open Marxism and Political Marxism as complementary, rather than opposed, social ontologies of capitalism.},
    keywords = "political-marxism, open-marxism, social-ontology, recent, Low, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "This article compares how Open Marxism and Political Marxism, respectively, mobilize the concepts of social form and of social property relations to produce critiques of the fetishized social ontology of mainstream or orthodox Marxism(s). Focusing on the works of Simon Clarke, Robert Brenner and Ellen Meiksins Wood, I show how these thinkers develop strikingly convergent readings of Marx’s critique of political economy as a rejection of an ontologically separate and asocial economic sphere. I then discuss how points of tension between Open Marxism and Political Marxism seem to emerge when we further specify the social ontologies of these currents. These tensions, however, appear to pertain more to differences of vocabulary than to a substantial theoretical opposition. This becomes clear once we understand how Open Marxist concepts of social form (and alienation) and Political Marxist concepts of social property relations (and exploitation) are in fact complementary. Social property relations can then be seen as an ontological elucidation of alienated social forms.",
    abstract_source = "s2"
}
