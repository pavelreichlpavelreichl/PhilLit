@article{fisk1982concept,
  author = {Fisk, Milton},
  title = {The Concept of Primacy in Historical Explanation},
  journal = {Analyse & Kritik},
  year = {1982},
  volume = {4},
  number = {2},
  pages = {182--196},
  doi = {10.1515/auk-1982-0203},
  note = {
  CORE ARGUMENT: Challenges Cohen's technological-materialist reading of
  Marx on three fronts: that for Marx technology is neither always nor
  predominantly the direct causal or functional stimulus of the relations of
  production; that primacy in explanation for Marx concerns an underlying
  framework rather than a direct stimulus, and that framework is the
  relations of production, not technology; and that technological
  development is not an autonomous process but depends on the cooperation of
  producers, which reintroduces class struggle into the primacy thesis
  Cohen aims to render purely functional.

  RELEVANCE: One of the earliest sustained challenges to the primacy thesis,
  part of the Analyse & Kritik exchange to which Cohen responds directly in
  "Reply to Four Critics" (1983); bears directly on whether the primacy
  thesis survives analytical scrutiny.

  POSITION: Rejects Cohen's technological reading of primacy in favor of a
  class-struggle-centered account of the relations of production as the true
  explanatory framework.
  },
  keywords = {primacy-thesis, technological-determinism, class-struggle, Medium},
  abstract = {Abstract G.A. Cohen interprets Marx as a technological materialist: the productive forces are “primary” in history. There are several mistakes here. First, for Marx technology is neither always nor predominantly the direct stimulus - either causal or functional - of the social relations of production. Second, it is not even the case that for Marx primacy in explanation is a matter of being a direct stimulus. It has to do rather with being a framework that underlies interconnections between direct stimuli and their results. It turns out that this framework cannot be technology but only the relations of production. Third, technological development is not an autonomous process but is for Marx one that is dependent on the cooperation of producers. This introduces the political element of the class struggle into technological development and refutes a technological reading of why a given class rules.},
  abstract_source = {openalex},
}

