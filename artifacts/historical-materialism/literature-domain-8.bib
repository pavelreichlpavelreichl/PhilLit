@misc{popper1957poverty,
    author = "Popper, Karl",
    title = "The Poverty of Historicism",
    year = "1957",
    address = "London",
    note = {CORE ARGUMENT: Popper defines "historicism" as the view that history is governed by discoverable laws or principles yielding a determinate end-point, and that the task of social science is therefore historical prophecy. He argues this project is logically impossible because human knowledge grows unpredictably and thereby alters social conditions in ways that cannot be forecast in advance; social systems, unlike the solar system, are not isolated, stationary, or repetitive, so no "unconditional scientific prophecy" of the eclipse-prediction type is available for history. Popper explicitly names Marx's dialectical materialism as a paradigm case, linking historicism to "holism" (treating social wholes as prior to individuals) and to dangerous "utopian social engineering." RELEVANCE: This is the founding text of the critique this domain organizes around; Popper's charge that historical materialism illegitimately converts observed historical trends into inexorable laws goes to the heart of the "priority order" question the overall review must adjudicate -- whether Marx's own claims about modes of production are lawlike/predictive or looser and more conditional. POSITION: Foundational statement of the anti-historicist critique of Marxism; the target against which Suchting, Hudelson, and Passmore (below) argue in various ways that Popper's category does not cleanly capture Marx's actual textual commitments.},
    keywords = "Popper, historicism, philosophy-of-science-critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{suchting1972marx,
    author = "Suchting, W. A.",
    title = "Marx, Popper, and 'Historicism'",
    journal = "Inquiry",
    year = "1972",
    volume = "15",
    number = "1-4",
    note = {CORE ARGUMENT: Suchting distinguishes two logically distinct types of "laws of historical development" that Popper's argument might be taken to target, and shows that Popper's stated objections fail against both when carefully formulated. He then works through four different models of historical determinism that could plausibly be ascribed to Marx and asks, model by model, whether Popper's critique actually applies to any of them. RELEVANCE: Directly addresses the research question of whether Popper's charge of historicism correctly targets historical materialism as Marx himself formulated it, by disaggregating "historicism" into precise sub-claims rather than treating it as a single undifferentiated doctrine. POSITION: A close analytic rebuttal of Popper from a sympathetic-to-Marx standpoint, exemplifying the "Popper's target is underspecified" line of response.},
    keywords = "Popper, historicism, Marx-exegesis, High, METADATA\_CLEANED: pages, doi",
    abstract = "According to Sir Karl Popper, there is a harmful approach to the social sciences called ‘historicism’. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.",
    abstract_source = "openalex"
}

@misc{hudelson1980poppers,
    author = "Hudelson, Richard",
    title = "Popper's Critique of Marx",
    year = "1980",
    number = "3",
    note = "CORE ARGUMENT: Hudelson reconstructs Popper's argument against Marx's alleged historicism and isolates the specific inferential steps -- from the unpredictability of future knowledge to the impossibility of long-range social prediction -- on which the argument depends, testing whether those steps go through when applied to the particular predictive claims Marx actually makes about capitalism's trajectory. RELEVANCE: Offers a second, independent philosophical assessment of whether Popper's anti-historicist argument succeeds against Marx's real claims (rather than a caricature), useful for weighing how much of Popper's critique survives close scrutiny. POSITION: A measured philosophical evaluation, distinct from outright dismissal or endorsement of Popper's critique.",
    keywords = "Popper, historicism, prediction, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{passmore1975poverty,
    author = "Passmore, John",
    title = "The Poverty of Historicism Revisited",
    year = "1975",
    number = "4",
    note = {CORE ARGUMENT: Passmore argues that Popper's own use of "historicism" is not stable across his writings -- sometimes referring to a theory about the proper aims of social science, sometimes to a way of practicing social science, sometimes to a broader philosophical Weltanschauung (German Historismus) -- and that this instability undermines the force of the charge when leveled at any single target, including Marx. RELEVANCE: Bears directly on the question of whether Popper's charge "correctly targets" historical materialism, by showing that the charge itself may not pick out a determinate, criticizable doctrine; this is a needed methodological check before assessing Popper vs. Marx specifically. POSITION: An internal, meta-critical challenge to the coherence of Popper's category of historicism, rather than a defense of Marx as such.},
    keywords = "Popper, historicism, conceptual-analysis, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The Poverty of Historicism was designed as a political pamphlet, a tract for its times, as its dedication makes very clear: memory of the countless men and women of all creeds or nations or races who fell victims to the fascist and communist belief in Inexorable Laws of Human Destiny.' Historicism, as Popper understands it, is not just an intellectual error, of interest only to professional philosophers; it is a prime source of moral and political devastation. It carries with it, or is used to justify, a particular attitude to political reform. For a Popper-defined historicist, political reform, if it is to have any hope of being efficacious, must work with historical laws to change the entire condition of society; for Popper himself it should proceed by piece-meal engineering by setting up, in an experimental spirit, new institutions or attempting to improve, in that same spirit, the manner of working of existing institutions. In short, in attacking historicism, Popper was attacking totalitarianism and defending a meliorist democracy or, more accurately, since Popper has no great political expectations, a democracy which will do something to lessen human suffering.2 He was writing at a time, it must also be remembered, when to call Marxism scientific was to recommend it. (Nowadays to call it humanistic has the same effect.) Popper was particularly,",
    abstract_source = "openalex"
}

@misc{lowy1989weber,
    author = "Löwy, Michael",
    title = "Weber against Marx? The Polemic with Historical Materialism in the Protestant Ethic",
    year = "1989",
    number = "1",
    note = {CORE ARGUMENT: Löwy reconstructs The Protestant Ethic and the Spirit of Capitalism as a sustained, if largely implicit, polemic against monocausal materialist explanations of the rise of capitalism. Weber's demonstration that Calvinist religious doctrine had independent causal efficacy in shaping the capitalist "spirit" is read as a deliberate methodological counter-example to any account that treats ideas and culture as mere epiphenomena of economic relations, while stopping short of a simple idealist inversion of Marx. RELEVANCE: Supplies the paradigm case for the "Weberian multi-causal critique" the domain is asked to cover, clarifying exactly how Weber's methodology displaces (without simply negating) the primacy-of-the-economic thesis central to historical materialism. POSITION: Sympathetic historical-sociological reconstruction of Weber's anti-materialist argument, written from a Marxist (specifically Weberian-Marxist) vantage point that takes the challenge seriously rather than dismissing it.},
    keywords = "Weber, multicausality, Protestant-ethic, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{giddens1981contemporary,
    author = "Giddens, Anthony",
    title = "A Contemporary Critique of Historical Materialism",
    year = "1981",
    address = "London",
    note = {CORE ARGUMENT: Giddens argues that historical materialism's base/superstructure architecture, and its assumption of the "structural primacy" of economic production, fail to hold for pre-capitalist societies, where kinship, military, and normative/authoritative structures are not reducible to or determined by relations of production. He proposes that "allocative" power (over material resources) must be theorized alongside "authoritative" power (over persons and their activities) as an independent axis, undermining any general claim that the economic is always determinant "in the last instance." RELEVANCE: The central systematic sociological statement of the Weberian-inflected multi-causal critique, directly targeting the primacy-of-the-economic claim that other domains in this review examine from within Marxism (analytical Marxism's functional-explanation debates; Political Marxism's specificity-of-capitalism thesis). POSITION: A foundational non-Marxist sociological critique that rejects the general theory of history built into orthodox historical materialism while retaining an interest in class and capitalism as historically specific phenomena.},
    keywords = "Weber, multicausality, base-superstructure, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{parkin1979marxism,
    author = "Parkin, Frank",
    title = "Marxism and Class Theory: A Bourgeois Critique",
    year = "1979",
    address = "London",
    note = {CORE ARGUMENT: Parkin argues, from a Weberian sociological standpoint, that Marxist class analysis illegitimately reduces the multiple bases of social closure and stratification (property, credentials, gender, ethnicity, status) to a single relation to the means of production, and that Weber's "class, status, and party" framework captures social conflict and inequality more accurately than a two- or three-class Marxist schema. RELEVANCE: Provides the explicit "class reductionism" side of the Weberian challenge that the domain's key questions ask about, complementing Giddens's structural critique with a more directly polemical treatment of Marxist class categories -- the same reductionism charge that Laclau and Mouffe later develop from within a post-Marxist rather than Weberian framework. POSITION: Self-consciously non-Marxist ("bourgeois") sociological critique of Marxist class theory, provocative in its framing and influential in Weberian stratification theory.},
    keywords = "Weber, class-reductionism, stratification, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{bimber1990karl,
    author = "Bimber, Bruce",
    title = "Karl Marx and the Three Faces of Technological Determinism",
    year = "1990",
    volume = "20",
    number = "2",
    note = {CORE ARGUMENT: Bimber, writing from science and technology studies, distinguishes three distinct senses in which a theory of history might be called "technologically determinist" (unstructured, norm-based, and nomological) and argues that Marx's texts, and the secondary literature built on them (including Cohen's functional-explanation reconstruction), conflate these senses, producing an interpretive dispute that is partly an artifact of imprecise terminology rather than a substantive disagreement about Marx's actual view. RELEVANCE: Supplies an external (STS, non-Marxological) framework for assessing whether historical materialism is committed to technological determinism, directly informing the domain's brief to address "general critiques of economic/technological determinism." POSITION: A conceptual-clarification critique from outside both Marxism and its analytical reconstruction, showing that charges of technological determinism against Marx often trade on ambiguity.},
    keywords = "technological-determinism, STS, productive-forces, High, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "The literature on Marx reveals conflicting claims about the role of technology in social change. Much of the debate is attributable to confusion over what is meant by `technological determinism' (TD). There are several approaches to this concept: `Norm-Based Accounts' interpret TD as a chiefly cultural phenomenon; `Unintended Consequences Accounts' view it in terms of unexpected social outcomes of technological enterprise. Neither of these two approaches make claims which are strictly deterministic, and which rely upon features of technology itself; they should not be considered to be TD. `Logical Sequence Accounts', on the other hand, make an ontological claim, viewing TD in terms of universal laws of nature; these deserve the `TD' label, and suggest criteria for assessing Marx's views about technology. Marx's arguments about the forces of production do not represent a Logical Sequence Account. The primary factors in the development of the forces of production are human, involving drives for self-expression, resistance to alienation, and expanding needs. Technology plays only a facilitating role in this process, which is essentially non-technological in character.",
    abstract_source = "openalex"
}

@article{duquette1992critique,
    author = "Duquette, David A.",
    title = "A Critique of the Technological Interpretation of Historical Materialism",
    journal = "Philosophy of the Social Sciences",
    year = "1992",
    volume = "22",
    number = "2",
    note = {CORE ARGUMENT: Duquette argues against readings of historical materialism (associated with G. A. Cohen and William Shaw) that make the development of productive forces the sole independent explanatory variable driving epochal social change, contending that such technological-determinist reconstructions cannot adequately account for the causal role of class struggle and social relations of production that Marx's own texts emphasize. RELEVANCE: Directly engages "general critiques of economic/technological determinism" by contesting the most systematic technological reading of historical materialism from a position that is external to, and critical of, the analytical-Marxist reconstruction project covered in other domains of this review. POSITION: A critique of technological-determinist historical materialism that argues the productive-forces-primacy thesis distorts Marx's own dialectical account of the productive-forces/relations-of-production relationship.},
    keywords = "technological-determinism, productive-forces, Cohen-critique, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "This essay examines and criticizes G. A. Cohen's interpretation of Marx's materialistic conception of history as presented in Cohen's book Karl Marx's Theory of History. In particular, the author attacks Cohen's Primacy Thesis, the claim that (for Marx) human technology is the primary explanatory factor for economic and social change and for historical development generally. The focus of the attack is Cohen's way of distinguishing between the material and social characteristics, or the content and form, of a system of production. The argument is that Cohen's distinctions are defective and therefore fail to provide adequate support for the Primacy Thesis and that, moreover, the position that Cohen defends is not Marx's.",
    abstract_source = "openalex"
}

@misc{hindess1977mode,
    author = "Hindess, Barry and Hirst, Paul Q.",
    title = "Mode of Production and Social Formation: An Auto-Critique of Pre-Capitalist Modes of Production",
    year = "1977",
    address = "London",
    note = {CORE ARGUMENT: Hindess and Hirst repudiate the theoretical apparatus of their own earlier book, Pre-Capitalist Modes of Production, arguing that the general concept of "mode of production" -- construed as a combination of forces and relations of production capable of generating determinate laws of motion for a whole historical epoch -- is theoretically incoherent and cannot perform the explanatory work that Althusserian and orthodox historical-materialist theory assigns to it. They contend that specific historical social formations cannot be derived from, or explained by, an abstract typology of modes of production. RELEVANCE: Provides the domain's central instance of "critiques of the 'mode of production' concept," notable precisely because it is a self-critique by former structuralist Marxists rather than an external attack, showing that doubts about the transhistorical validity of the category arose from within the Althusserian tradition examined elsewhere in this review. POSITION: A structuralist-Marxist auto-critique that ends in the wholesale rejection of "mode of production" as a general theoretical category, marking an internal collapse of confidence in one of historical materialism's central concepts.},
    keywords = "mode-of-production, Althusserian-critique, auto-critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{bailey1979karl,
    author = "Bailey, Anne M. and Llobera, Josep R.",
    title = "Karl A. Wittfogel and the Asiatic Mode of Production: A Reappraisal",
    year = "1979",
    volume = "27",
    number = "3",
    note = {CORE ARGUMENT: Bailey and Llobera reassess Wittfogel's hydraulic-society thesis and its relationship to Marx's scattered remarks on an "Asiatic mode of production," arguing that the concept as deployed in twentieth-century Marxist debate conflates several distinct issues -- the specificity of state power in non-European societies, ecological/technological determinants of large-scale irrigation, and the political uses to which "Oriental despotism" was put in Cold War polemics -- and that this conflation has obstructed a clear anthropological assessment of the category's validity. RELEVANCE: Directly addresses the "Asiatic-mode-of-production controversy" specified in the domain's key questions, showing how attempts to fit non-European historical trajectories into a Marxist stagial schema generated both political and conceptual confusion. POSITION: A critical historiographical reappraisal that neither simply defends nor simply discards the concept, but diagnoses why the debate over it became so entangled with extraneous political stakes.},
    keywords = "Asiatic-mode-of-production, Wittfogel, anthropology, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{currie1984asiatic,
    author = "Currie, Kate",
    title = "The Asiatic Mode of Production: Problems of Conceptualising State and Economy",
    year = "1984",
    volume = "8",
    number = "4",
    note = {CORE ARGUMENT: Currie argues that the Asiatic-mode-of-production concept fails to specify a coherent relationship between state and economy that could give it genuine explanatory power distinct from ad hoc description, since the category has been used to designate societies with markedly different property relations, surplus-extraction mechanisms, and state forms, undermining its claim to identify a unified "mode of production" in Marx's technical sense. RELEVANCE: Strengthens the domain's anthropological-critique cluster by focusing specifically on the conceptual (rather than merely historiographical) incoherence of treating "Asiatic mode of production" as a determinate category analogous to feudalism or capitalism. POSITION: An anthropological critique that treats the AMP controversy as symptomatic of a deeper problem in extending Marx's mode-of-production concept to non-European contexts as a transhistorical category.},
    keywords = "Asiatic-mode-of-production, mode-of-production, state-theory, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, doi, type:@article->@misc"
}

@book{laclau1985hegemony,
    author = "Laclau, Ernesto and Mouffe, Chantal",
    title = "Hegemony and Socialist Strategy: Towards a Radical Democratic Politics",
    year = "1985",
    publisher = "Verso",
    address = "London",
    note = {CORE ARGUMENT: Laclau and Mouffe argue that the base/superstructure model and the classical Marxist expectation of proletarian unity around a unified class interest rest on an untenable "essentialism" -- the assumption that social agents have objectively given interests fixed by their position in relations of production. Drawing on post-structuralist discourse theory, they reconceive society as constitutively open, structured by contingent "articulations" of antagonistic elements rather than by an underlying economic logic, and generalize Gramsci's concept of "hegemony" into a general theory of the political no longer anchored in class as a privileged category. RELEVANCE: This is the primary text through which post-Marxism dissolves the base/superstructure model and class essentialism, and is the direct object of the domain's key question about "what remains 'Marxist'" in this project; every other post-Marxism entry in this domain is a response to or elaboration of the argument made here. POSITION: The founding text of "post-Marxism," retaining categories such as hegemony, antagonism, and articulation from the Marxist and Gramscian tradition while explicitly abandoning economic determination and class reductionism.},
    keywords = "post-Marxism, hegemony, discourse-theory, class-essentialism, High, INCOMPLETE, no-abstract"
}

@misc{ives2005language,
    author = "Ives, Peter",
    title = "Language, Agency and Hegemony: A Gramscian Response to Post-Marxism",
    year = "2005",
    volume = "8",
    number = "4",
    note = {CORE ARGUMENT: Ives argues that Laclau and Mouffe's appropriation of "hegemony" from Gramsci strips away Gramsci's own sophisticated, linguistically grounded understanding of how coercion and consent interrelate, in favor of an abstract post-structuralist vocabulary of discourse and articulation. Returning to Gramsci's actual writings on language, Ives contends that a more historically and linguistically attentive conception of hegemony can address the same problems Laclau and Mouffe raise without abandoning attention to concrete institutional and economic conditions. RELEVANCE: Offers a Gramscian rather than orthodox-Marxist rebuttal to post-Marxism, directly engaging the question of what, if anything, is lost or retained when Laclau and Mouffe generalize hegemony away from its original materialist moorings. POSITION: A left critique of post-Marxism from within the Gramscian tradition, arguing Laclau and Mouffe's "descent into discourse" sacrifices analytical resources Gramsci's own work still offers.},
    keywords = "post-Marxism, Gramsci, hegemony, discourse-critique, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Ernesto Laclau and Chantal Mouffe have attempted to save the concept of ‘hegemony’ from its economistic and essentialist Marxist roots by incorporating the linguistic influences of post‐structuralist theory. Their major Marxist detractors criticise their trajectory as a ‘descent into discourse’ – a decay from well‐grounded, material reality into the idealistic and problematic realm of language and discourse. Both sides of the debate seem to agree on one thing: the line from Marxism to post‐Marxism is the line from the economy to language, from ‘reality’ to discourse. This article focuses on Gramsci’s writings on language to argue against both sides of this debate. It illustrates how language is central to Gramsci’s historical materialism and that he does not oppose it to materiality. It argues that Gramsci adopted the very term hegemony substantially from his university studies in linguistics – the debates from which Ferdinand de Saussure also developed structuralism. For Gramsci, such linguistic issues were directly related to the ‘questione della lingua’ and Italian unification. Moreover, language lies at the centre of Gramsci’s understanding of the relationship between coercion and consent. This not only troubles Laclau \& Mouffe’s reading of Gramsci, but it illuminates a more productive conception of hegemony that can address recent debates around post‐structuralism and the use of ‘hegemony’ to analyse globalisation and an increasingly technological and electronic world.",
    abstract_source = "openalex"
}

@misc{jacobs2018dislocated,
    author = "Jacobs, Thomas",
    title = "The Dislocated Universe of Laclau and Mouffe: An Introduction to Post-Structuralist Discourse Theory",
    year = "2018",
    volume = "30",
    note = {CORE ARGUMENT: Jacobs surveys post-structuralist discourse theory's shift away from classical Marxian sociology's economic "structuring" of society and ideas toward a thesis of radical indeterminacy in which no deeper social foundation -- economic or otherwise -- explains political outcomes. He argues this radicalization of Marxism's own move away from economic essentialism comes at the cost of analytical purchase: class struggle and relations of production lose their explanatory role, and political practice becomes difficult to distinguish from contingent, unanalyzable contestation. RELEVANCE: Provides a critical survey (rather than a partisan intervention) of exactly how far post-Marxist discourse theory travels from historical materialism's core commitments, useful for assessing what, if anything, remains "Marxist" once economic determination and class are abandoned as explanatory anchors. POSITION: A skeptical assessment, sympathetic neither to orthodox Marxism nor uncritically to post-structuralist discourse theory, cataloguing the theoretical costs of Laclau and Mouffe's indeterminacy.},
    keywords = "post-Marxism, discourse-theory, indeterminacy, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT Post-Structuralist Discourse Theory analyzes political ideas and action from a Marxist direction. However, while classic Marxian sociology is rooted in economic processes that “structure” society and ideas, Post-Structuralist Discourse Theory emphasizes the absence of any determinative principle. Thus, it radicalizes an ongoing shift in Marxism away from economic essentialism towards indeterminacy, contingency, and openness. The ideological superstructure becomes ever more important at the expense of the economic base; class struggle and relations of production lose analytical and strategic purchase in favor of a complex and integral form of politics; there are no deeper, natural foundations determining how society is organized and structured. Post-Structuralist Discourse Theorists argue that this orientation leads to a more satisfactory analysis of political practice than is possible through positivist research. Assessing this claim requires a survey of the hermetic terminology in which Post-Structuralist Discourse Theorists express their ideas—the discourse, as it were, of Discourse Theorists—exploring their use of sociology, structuralist linguistics, psychoanalysis, and the political theory of populism.",
    abstract_source = "s2"
}

@article{townshend2017living,
    author = "Townshend, Jules",
    title = "Living with the Fragments: Further Thoughts on Norman Geras's Critique of Post-Marxism",
    journal = "International Critical Thought",
    year = "2017",
    number = "4",
    note = "CORE ARGUMENT: Townshend revisits Norman Geras's influential charge that Laclau and Mouffe's Hegemony and Socialist Strategy misreads classical Marxist texts (attributing to Marx and Engels a crude economic reductionism they did not hold), and that Laclau and Mouffe's own theory covertly reintroduces essentialist and universalist commitments even as it officially disavows them. Townshend assesses how well Geras's specific textual and logical objections have held up against subsequent post-Marxist responses and elaborations. RELEVANCE: The domain's chief source for engaging the Geras/Laclau-Mouffe exchange, one of the most sustained and influential Marxist rebuttals to post-Marxism, addressed at second hand since Geras's own original essays could not be independently verified in this search session. POSITION: A sympathetic-to-Geras retrospective assessment situating the Geras critique within the broader post-Marxism debate; flagged as a secondary source for Geras's argument.",
    keywords = "post-Marxism, Geras, class-essentialism, Low, METADATA\_CLEANED: volume, pages, doi",
    abstract = "This article revisits and re-evaluates a famous debate between Norman Geras and Ernesto Laclau. This exchange was one of the few direct confrontations between Marxism and post-Marxism in terms of its significance for the evolution of Marxist theory, characterised by increasing fragmentation often morphing into post-Marxist theory. The article also considers the significance of the debate in relation to the nature of Geras’s adherence to Marxism and his intellectual and political trajectory. It argues that Geras was more of a post-Marxist than he thought he was, and became more so over time, and that Laclau’s ethical reluctance was close to at least one of Marx’s “spirits.” Finally in raising the question of how anti/post-capitalist theorists should live with and without Marx(ism) this article suggests that the debate in many ways still has contemporary relevance.",
    abstract_source = "openalex"
}

@article{goldstein2019ernesto,
    author = "Goldstein, Philip",
    title = "Ernesto Laclau and Chantal Mouffe: The Evolution of Post-Marxism",
    journal = "Global Discourse",
    year = "2019",
    number = "2",
    note = {CORE ARGUMENT: Goldstein traces how Laclau's and Mouffe's post-Marxist positions diverged after Hegemony and Socialist Strategy: Laclau increasingly emphasized a general rhetorical/psychoanalytic theory of hegemony and populism, while Mouffe developed a normative theory of "agonistic" pluralism, and Goldstein assesses how much of the original 1985 anti-essentialist, anti-class-reductionist argument survives in each later trajectory. RELEVANCE: Useful for tracking how far post-Marxism moved from historical materialism over time, informing the synthesis question of what, if any, common Marxist inheritance still unites Laclau's and Mouffe's later, increasingly divergent projects. POSITION: A descriptive intellectual-historical account rather than a polemical intervention, mapping the internal evolution and eventual bifurcation of post-Marxist theory.},
    keywords = "post-Marxism, Laclau, Mouffe, intellectual-history, Low, METADATA\_CLEANED: volume, pages, doi",
    abstract = "In their groundbreaking Hegemony and socialist strategy (1985), Ernesto Laclau and Chantal Mouffe develop a new account of radical politics in which the subjective construction of hegemony establishes political conditions, not the objective historical stages and class contexts of traditional Hegelian Marxism. On this basis, they forcefully justify the 'identity politics' of contemporary women's, African-American, gay, and working class groups and organisations and oppose both the hegemony of the new right and the 'classism' and revolutionary orientation of the radical left. In their later work, they elaborate their accounts of hegemony and move in new directions. In On populist reason (2005) and The rhetorical foundations of society (2014), Laclau draws on poststructuralist discourse or rhetoric as well as notions of populism or the masses to show that hegemony involves what he terms antagonism, frontiers or we/they oppositions, equivalential logics, and other elements. By contrast, in On the political (2005) and Agonistics: thinking the world politically (with Wagner, 2013), Mouffe elaborates the notion of the fissured subject which, as she and Laclau argued in Hegemony, was constituted by the antagonisms of diverse social movements or the dislocation of social structures; however, her new accounts of the antagonisms or, as she says, 'agonisms' dividing the political field forcefully oppose universal norms of rationality or democracy in order to establish a genuine pluralism on a national and a global scale.",
    abstract_source = "s2"
}
