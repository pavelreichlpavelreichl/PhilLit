      "openalex_id": "W3017994143",
      "doi": "10.1111/ejop.12538",
      "title": "What if the private linguist were a poet? Iris Murdoch on privacy and ethics",
      "authors": [
        {
          "name": "Rachael Wiseman",
          "openalex_id": "A5012436920",
          "institutions": [
            "University of Liverpool"
          ]
