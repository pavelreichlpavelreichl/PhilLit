    {
      "paperId": "2448a341e56d06966ef0ac52ceef458172949876",
      "title": "Taking the Teleology of History Seriously: Lessons from Hegel's Logic",
      "authors": [
        {
          "name": "Chen Yang",
          "authorId": "145370858"
        },
        {
          "name": "Christopher Yeomans",
          "authorId": "108658546"
