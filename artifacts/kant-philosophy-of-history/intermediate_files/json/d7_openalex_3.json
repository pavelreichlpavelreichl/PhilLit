      "title": "Measuring and assessing resilience: broadening understanding through multiple disciplinary perspectives",
      "authors": [
        {
          "name": "Allyson Quinlan",
          "openalex_id": "A5033425635",
          "orcid": "https://orcid.org/0000-0003-3818-9358",
