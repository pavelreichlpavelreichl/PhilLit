    {
      "openalex_id": "W2743062033",
      "doi": "10.26530/oapen_630732",
      "title": "The Principle of Unrest : Activist Philosophy in the Expanded Field",
      "authors": [
        {
          "name": "Brian Massumi",
          "openalex_id": "A5010878774",
          "orcid": "https://orcid.org/0000-0001-9559-7767",
