    {
      "paperId": "770709ecfe3673b4bc22171ad2e2fb46e71b20b4",
      "title": "Towards public health ethics",
      "authors": [
        {
          "name": "M. Royo-Bordonada",
          "authorId": "1398648000"
        },
        {
          "name": "B. Rom\u00e1n-Maestre",
          "authorId": "1398863753"
