    {
      "paperId": "06cab9c0514bf6e6c2df67bcad09965bef8f7724",
      "title": "DISCUSSION IN THE HISTORY OF PHILOSOPHICAL KNOWLEDGE",
      "authors": [
        {
          "name": "Dmytro Strilko",
