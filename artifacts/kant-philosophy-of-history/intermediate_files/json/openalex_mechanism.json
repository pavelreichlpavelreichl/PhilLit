    {
      "openalex_id": "W2292958921",
      "doi": "10.1007/s11245-016-9365-4",
      "title": "Autonomy and Enactivism: Towards a Theory of Sensorimotor Autonomous Agency",
      "authors": [
        {
          "name": "Xabier E. Barandiaran",
          "openalex_id": "A5001513750",
