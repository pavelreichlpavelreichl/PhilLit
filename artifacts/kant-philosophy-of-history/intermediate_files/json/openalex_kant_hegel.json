    {
      "openalex_id": "W1484794259",
      "doi": "10.1093/oxfordhb/9780199696543.001.0001",
      "title": "The Oxford Handbook of German Philosophy in the Nineteenth Century",
      "authors": [
        {
          "name": "Michael \u039d. Forster",
