  RELEVANCE: The major book-length treatment of the radical evil/moral progress nexus. Directly
  addresses the project's question about whether the Religion's doctrine of radical evil creates
  internal tension with the historical optimism of the political essays.

  POSITION: Integrative reading; defends coherence between Religion and political essays while
  granting that radical evil requires revising naive progressive optimism.
  },
  keywords = {kant-philosophy-of-history, radical-evil, moral-progress, religion, High, INCOMPLETE, no-abstract}
}

@article{buddeberg2019kantReligion,
  author = {Buddeberg, Eva},
  title = {Kant on the {Role} of {Religion} for {Moral} {Progress}},
  journal = {Kantian Review},
  year = {2019},
  volume = {24},
  number = {3},
  pages = {335--357},
  doi = {10.1017/s1369415419000165},
  abstract = {This article examines Kant's understanding of moral progress, especially in his Religion where he argues that religion and, more importantly, the foundation of an ethical community are necessary to promote moral progress.},
  note = {
  CORE ARGUMENT: Buddeberg argues that for Kant, the promotion of moral progress requires not
  just individual moral striving but the social and institutional context of an ethical community
  (a "kingdom of God on earth"). The Religion's ecclesiology is thus not a digression from Kant's
