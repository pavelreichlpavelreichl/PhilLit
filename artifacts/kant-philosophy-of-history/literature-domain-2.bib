@comment{
====================================================================
DOMAIN: Kant's Philosophy of History Across the Writings --- Systematic Development
SEARCH_DATE: 2026-03-13
PAPERS_FOUND: 19 total (High: 9, Medium: 7, Low: 3)
SEARCH_SOURCES: SEP, IEP, PhilPapers, Semantic Scholar, OpenAlex, CORE, CrossRef
====================================================================

DOMAIN_OVERVIEW:
The question of whether Kant has a systematic philosophy of history --- or only scattered political
essays plus teleological appendices --- has been the central controversy in this field since Yovel's
1980 Princeton monograph argued for a coherent teleological structure spanning all three Critiques.
That systematic reading is contested by those who see Kant's historical writings as heuristic or
regulative at best, lacking the transcendental grounding of his theoretical or practical philosophy.
Three interconnected sub-debates drive the literature: (1) the relation between reflective judgment
in the third Critique and the providential or teleological claims of the political essays; (2) the
impact of radical evil in the Religion within the Limits of Reason Alone on the progress narrative
of the 1784 "Idea" essay and the 1798 "Contest of Faculties"; (3) the status of the Anthropology
from a Pragmatic Point of View --- whether its empirical, pragmatic register is compatible with
transcendental idealism's constraints on historical knowledge. Kleingeld (1999) is the crucial
article articulating the "moral development" reading of historical progress. Allison's chapter in
the Rorty/Schmidt volume (2009) defends a teleological foundation for history in the third Critique.
Anderson-Gold's monograph (2000) is the major book-length treatment connecting radical evil to the
problem of moral progress. Recent work by Buddeberg (2019), Woo (2023), Papish (2024), and
Lenczewska (2025) shows the field is still highly active, focusing especially on how Kant's concept
of hope mediates between the idealism of moral progress and the empirical reality of human
wickedness.

RELEVANCE_TO_PROJECT:
This domain provides the primary literature on whether Kant's writings on history form a system,
how the 1784 "Idea" essay relates to later systematic works, and how the teleological framework
of the Critique of Judgment either supports or undermines the political essays' progressive
optimism. The highest-good discussions and the debate over moral eschatology are directly relevant
to the project's treatment of Kant's position in the broader history of philosophies of history.

NOTABLE_GAPS:
The treatment of "Conjectures on the Beginning of Human History" and "On the Common Saying" as
systematic texts --- rather than occasional pieces --- remains relatively thin compared with work
on the 1784 "Idea" and the "Contest of Faculties." German-language scholarship (e.g., Kleingeld's
1995 Habilitationsschrift Fortschritt und Vernunft) is largely inaccessible via English-language
search tools, and several papers lack abstracts in S2 or OpenAlex, marked INCOMPLETE below.

SYNTHESIS_GUIDANCE:
The Yovel vs. anti-systematist debate should be foregrounded; the highest-good/moral-eschatology
strand (Engstrom, Palatnik, Fonnesu, Rossi) connects the systematic to the religious dimension.
The recent "race and progress" literature (Basevich, Papish 2024) represents a significant critical
revision of the progress narrative that the synthesis should address.

KEY_POSITIONS:
- Systematic/teleological reading: 5 papers --- Yovel, Kleingeld, Allison, Rorty/Schmidt (eds.), Lenczewska
- Highest good and moral eschatology: 5 papers --- Engstrom, Palatnik, Fonnesu, Woo, Rossi
- Radical evil and moral progress: 3 papers --- Anderson-Gold, Buddeberg, Papish (2024)
- Anthropology and history: 2 papers --- Cohen, Oh
- Critical revisions (race): 1 paper --- Basevich
- Teleology in Critique of Judgment: 2 papers --- Krijnen, Cha
====================================================================
}

@book{rortySchmidt2009kantIdea,
  editor = {Rorty, Amélie Oksenberg and Schmidt, James},
  title = {Kant's {Idea} for a {Universal} {History} with a {Cosmopolitan} {Aim}},
  year = {2009},
  publisher = {Cambridge University Press},
  doi = {10.1017/cbo9780511581434},
  note = {
  CORE ARGUMENT: This edited volume collects nine new essays responding directly to Kant's 1784
  "Idea" essay, covering its relationship to the third Critique, to Rousseau, to political philosophy,
  and to contemporary cosmopolitanism. Contributors include Allison, Wood, Schneewind, and Lloyd.
  The volume establishes the "Idea" essay as the pivotal text for debating the systematic character
  of Kant's philosophy of history.

  RELEVANCE: Provides the standard reference collection for the 1784 essay, with essays bearing
  directly on the project's central questions: whether Kant's historical writings form a system
  and how the political essays relate to the teleological framework of the Critiques.

  POSITION: Pluralistic --- contributors disagree on whether the "Idea" essay's teleology is
  transcendentally grounded or merely heuristic, making the volume itself a map of the debate.
  },
  keywords = {kant-philosophy-of-history, teleology, cosmopolitanism, political-essays, High},
  abstract = {Lively debates about narratives of historical progress, the conditions for international justice, and the implications of globalisation have prompted a renewed interest in Kant's Idea for a Universal History with a Cosmopolitan Aim. The essays in this volume, written by distinguished contributors, discuss the questions that are at the core of Kant's investigations. Does the study of history convey any philosophical insight? Can it provide political guidance? How are we to understand the destructive and bloody upheavals that constitute so much of human experience? What connections, if any, can be traced between politics, economics, and morality? What is the relation between the rule of law in the nation state and the advancement of a cosmopolitan political order? These questions and others are examined and discussed in a book that will be of interest to philosophers, social and political theorists, and intellectual and cultural historians.},
  abstract_source = {openalex},
}

@incollection{allison2009teleologyHistory,
  author = {Allison, Henry E.},
  title = {Teleology and history in {Kant}: the critical foundations of {Kant}'s philosophy of history},
  booktitle = {Kant's {Idea} for a {Universal} {History} with a {Cosmopolitan} {Aim}},
  year = {2009},
  publisher = {Cambridge University Press},
  pages = {24--45},
  doi = {10.1017/cbo9780511581434.003},
  note = {
  CORE ARGUMENT: Allison argues that Kant's philosophy of history has genuine transcendental
  foundations in the third Critique's account of teleological judgment, specifically in the notion
  of nature as exhibiting purposiveness with respect to the development of human rational capacities.
  The "Idea" essay's nine propositions are not merely empirical speculation but are underwritten
  by the framework of reflective judgment.

  RELEVANCE: Directly addresses the domain's central question --- whether the Critique of Judgment
  provides systematic grounding for the political essays --- and offers the most philosophically
  careful defense of the affirmative answer.

  POSITION: Systematic/teleological reading; defends the compatibility of reflective judgment
  with genuinely progressive historical claims.
  },
  keywords = {kant-philosophy-of-history, teleology, critique-of-judgment, systematic-reading, High},
  abstract = {Although the title of Kant's essay Idea for Universal History with a Cosmopolitan Aim indicates its central theme, it reveals little or nothing about its underlying methodology and its connection with the emerging critical philosophy. Indeed, as far as the title is concerned, the only hint of a connection with the latter is provided by the inclusion of the term "Idea." This is a technical term for Kant referring to concepts of reason, which, as distinct from concepts of the understanding, whose legitimate use is restricted to possible experience, involve the thought of an absolute totality or completeness that can never be met with in a possible experience and is, therefore, "transcendent" with respect to the latter. In the first Critique, Kant's appealed to the Platonic republic and a constitution that provides for "the greatest human freedom according to laws that permit the freedom of each to exist together with that of others" as examples of such ideas (A 316/B 372–3); but his focus was on the "transcendental Ideas" (the soul, the world, and God), which arise from extending certain concepts of the understanding to the "unconditioned," thereby producing the thought of a complete systematic unity. While illusory, in the sense that no real object corresponds to them, these Ideas nonetheless play an essential regulative role in guiding the understanding in its endemic search for unity in experience.},
  abstract_source = {openalex},
}

@article{kleingeld1999kantHistory,
  author = {Kleingeld, Pauline},
  title = {Kant, {History}, and the {Idea} of {Moral} {Development}},
  journal = {History of Philosophy Quarterly},
  year = {1999},
  volume = {16},
  pages = {59--80},
  note = {
  CORE ARGUMENT: Kleingeld distinguishes two components in Kant's philosophy of history: an
  empirical-teleological account of the development of human capacities under nature's guidance,
  and a moral account of the progress in freedom and moral character. She argues that these two
  components are related but not identical, and that Kant consistently holds that moral progress
  is real but not guaranteed by natural mechanism.

  RELEVANCE: This article provides the most careful analytical reconstruction of the relationship
  between Kant's natural teleology and his account of moral progress, bearing directly on the
  project's question about the coherence of Kant's historical thinking across the writings.

  POSITION: Systematic reading that nonetheless acknowledges significant tensions between the
  natural-teleological and freedom-based strands of Kant's historical thought.
  },
  keywords = {kant-philosophy-of-history, moral-progress, teleology, systematic-reading, High, INCOMPLETE, no-abstract}
}

@book{lenczewska2025kantHistory,
  author = {Lenczewska, Olga},
  title = {Kant on the {History} and {Development} of {Practical} {Reason}},
  year = {2025},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781009216760},
  note = {
  CORE ARGUMENT: Lenczewska argues that Kant's practical philosophy contains an underappreciated
  developmental and historical dimension: pure practical reason itself has a history of its
  articulation, and Kant's moral writings track this development in ways that are philosophically
  significant rather than merely biographical. The book connects the critical writings to the
  political essays as stages in a unified account of rational self-development.

  RELEVANCE: Provides the most recent book-length treatment of the systematic question, arguing
  from within the practical philosophy outward to history rather than from teleology inward. This
  reverses the standard approach and is directly relevant to how the project frames Kant's
  philosophy of history.

  POSITION: Systematic reading grounded in the development of practical reason rather than
  natural teleology; published 2025, represents state of the art.
  },
  keywords = {kant-philosophy-of-history, practical-reason, systematic-reading, High},
  abstract = {This Element's focus is Kant's history of human reason: his teleological vision of the past development of our rational capacities from their very emergence until Kant's own 'age of Enlightenment.' One of the goals is to connect Kant's speculative account of the very beginning of rationality – a topic that has thus far been largely neglected in Kantian scholarship – to his well-known theory of humankind's progress. The Element elucidates Kant's hopes with regard to reason's future progress and his guidelines for how to achieve this progress by unifying them with his vision of reason's past. Another goal is to bring more attention to Kant's essay 'Conjectural Beginning of Human History,' where this account is presented, and to show that this unusual text does not stand in conflict with Kant's philosophy and is not merely tangentially related to it, but illuminates and complements certain aspects of his critical philosophy.},
  abstract_source = {s2},
}

@book{andersonGold2000unnecessaryEvil,
  author = {Anderson-Gold, Sharon},
  title = {Unnecessary {Evil}: {History} and {Moral} {Progress} in the {Philosophy} of {Immanuel} {Kant}},
  year = {2000},
  publisher = {State University of New York Press},
  note = {
  CORE ARGUMENT: Anderson-Gold argues that Kant's account of radical evil in the Religion within
  the Limits of Reason Alone is not a pessimistic retraction of the progress narrative in the
  political essays but rather its necessary complement. Evil is "unnecessary" in the sense that
  it is not part of the natural order but a product of free choice, and its contingency is what
