  },
  keywords = {kant-philosophy-of-history, radical-evil, moral-progress, religion, ethical-community, High}
}

@article{engstrom1992highestGood,
  author = {Engstrom, Stephen},
  title = {The {Concept} of the {Highest} {Good} in {Kant}'s {Moral} {Theory}},
  journal = {Philosophy and Phenomenological Research},
  year = {1992},
  volume = {52},
  number = {4},
  pages = {747--780},
  doi = {10.2307/2107910},
  note = {
  CORE ARGUMENT: Engstrom argues that the concept of the highest good --- the union of complete
  virtue and happiness --- plays a structural role in Kant's moral theory: it articulates the
  complete object of moral willing and provides the teleological structure within which Kant's
  postulates of practical reason (immortality, God) are demanded. The highest good is not an
  optional appendage but a necessary element of Kant's system.

  RELEVANCE: The highest good is the concept that links Kant's moral philosophy to his philosophy
  of history, since historical moral progress can be understood as the collective approximation
  toward the highest good. This article provides the systematic grounding for that connection.

  POSITION: Systematic reading; defends the indispensability of the highest good concept for
  Kant's practical philosophy as a whole.
  },
  keywords = {kant-philosophy-of-history, highest-good, moral-theology, systematic-reading, High},
  abstract = {Kant claims that the concept of the highest good, the idea of a state or condition in which happiness is proportioned to virtue, follows as a consequence from the moral law. But it is not clear how it follows, nor indeed whether it follows at all. How, it has often been asked, can a law that requires us to act morally regardless of whether our personal happiness follows as a consequence be the source of an obligation to promote a state in which moral conduct has as its necessary consequence precisely such personal happiness?1 And on the other hand, if it can be shown that happiness does in fact belong in the highest good, why should it be limited to the virtuous? Can the moral law really oblige or even entitle us to undertake the seemingly presumptuous task of adjusting others' happiness to the degree of virtue we deem them to have? It is true that Kant often characterizes virtue as the worthiness to be happy, and it would no doubt be good if happiness were secured for those worthy of it. But of course this provides no solution to the problem, but only new terms in which it can be expressed. What needs to be explained is why virtue should be identified as the worthiness to be happy. One reason for pursuing this question is that an answer to it should help determine what place and importance, if any, the concept of the highest good},
  abstract_source = {openalex},
}

@article{palatnik2022endlessProgress,
  author = {Palatnik, Nataliya},
  title = {Towards the {Highest} {Good}: {Endless} {Progress} and {Its} {Totality} in {Kant}'s {Moral} {Argument} for the {Postulate} of {Immortality}},
  journal = {Journal of Transcendental Philosophy},
  year = {2022},
  volume = {3},
  number = {3},
  pages = {321--344},
  doi = {10.1515/jtph-2021-0021},
  abstract = {Kant's moral proof of the postulate of immortality in the Critique of Practical Reason is often dismissed as a failed argument that trades on illicit conceptual shifts. I argue that Kant's argument can be reconstructed as a coherent argument for endless progress.},
  note = {
  CORE ARGUMENT: Palatnik defends Kant's argument for the postulate of immortality as grounding
  an infinite progress toward the highest good, arguing that the "endlessness" of progress is not
  a flaw but a structural requirement: only an infinite temporal series can satisfy the demand
  for the totality of moral perfection. The postulate thus connects the practical demand for moral
  completion to the eschatological dimension of Kant's historical thinking.

  RELEVANCE: Connects the immortality postulate in the second Critique directly to the temporal
  and historical dimension of moral progress, providing a philosophical account of how the moral
  eschatology of the practical philosophy underlies the optimism of the political essays.

  POSITION: Systematic/moral-eschatological reading; recent defense of the coherence of the
  highest good doctrine as grounding historical progressivism.
  },
  keywords = {kant-philosophy-of-history, highest-good, immortality-postulate, moral-eschatology, Medium}
}

@article{fonnesu2022highestGoodCrisis,
  author = {Fonnesu, Luca},
  title = {The {Highest} {Good} and {Its} {Crisis} in {Kant}'s {Thought}},
  journal = {Journal of Transcendental Philosophy},
  year = {2022},
  volume = {3},
  number = {3},
  pages = {369--384},
  doi = {10.1515/jtph-2021-0032},
  abstract = {The article has the aim to show that Kant's standard conception of the highest good does not represent his last word about the problem. Kant moves from a conception of the highest good closely connected with happiness to one in which this connection becomes problematic.},
  note = {
  CORE ARGUMENT: Fonnesu argues that Kant's concept of the highest good undergoes a significant
  internal shift: from the first Critique's "canon" to the second Critique and the Religion,
  the connection between virtue and happiness becomes increasingly strained, reflecting a "crisis"
  in Kant's attempt to integrate moral theory with a teleological conception of history.

  RELEVANCE: Directly relevant to the question of whether there is coherent development or
  significant internal tension in Kant's historical thinking, since the transformation of the
  highest good concept tracks the broader systematic tensions the project investigates.

  POSITION: Identifies tensions within Kant's system rather than defending its coherence;
  usefully counterbalances purely systematic readings.
  },
  keywords = {kant-philosophy-of-history, highest-good, internal-tension, systematic-development, Medium}
}

@article{woo2023kantHope,
  author = {Woo, Jaeha},
  title = {Why {Kant}'s {Hope} {Took} a {Historical} {Turn} in {Practical} {Philosophy}},
