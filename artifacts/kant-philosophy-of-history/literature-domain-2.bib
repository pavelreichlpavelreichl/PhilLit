@incollection{krijnen2011teleologyCultureHistory,
  author = {Krijnen, Christian},
  title = {Teleology in {Kant}'s {Philosophy} of {Culture} and {History}: {A} {Problem} for the {Architectonic} of {Reason}},
  booktitle = {The {Sublime} and {Its} {Teleology}},
  year = {2011},
  publisher = {Brill},
  pages = {115--132},
  doi = {10.1163/9789004221413_007},
  note = {
  CORE ARGUMENT: Krijnen identifies a structural tension between the teleological framework of
  the third Critique --- which concerns nature's purposiveness --- and the teleology operative in
  Kant's philosophy of culture and history, which concerns the realization of freedom. He argues
  this tension is not resolvable within the architectonic of reason as Kant presents it.

  RELEVANCE: Articulates the anti-systematic position on the teleology-history connection,
  arguing that the third Critique's teleology cannot straightforwardly ground the political essays'
  historical optimism. Provides the strongest internal-tension reading as a counterweight to
  Allison's systematic interpretation.

  POSITION: Identifies architectonic tension; represents the anti-systematic reading most
  clearly focused on the Critique of Judgment.
  },
  keywords = {kant-philosophy-of-history, teleology, internal-tension, architectonic, critique-of-judgment, Medium},
  abstract = {This chapter concerns the problem of Kant's division of philosophy itself into a theoretical and a practical dimension and its meaning for the philosophy of culture and history. For understanding the teleology in Kant's philosophy of culture and history, within the context of the problem sketched above, Kant's critique of teleological judgment, especially the doctrine on the final purpose (Endzwecklehre), is very important. The Kant's philosophy of culture deals with the purposeful development of the natural dispositions (Naturanlagen) of humans. It is especially Kant's philosophy of history, based on his philosophy of culture, which is a philosophical attempt to determine the universal of the world to the plan of nature in its aiming at a perfect civil union on the level of mankind (VIII, 29). Kant formulates his concept of a philosophical history (VIII, 31, cf. 18) in his Idee zu einer allgemeinen Geschichte in weltburgerlicher Absicht . Keywords:culture; history; Kant's philosophy},
  abstract_source = {openalex},
}

@incollection{basevich2021progressRace,
  author = {Basevich, Elvira},
  title = {On {Progress}: {The} {Role} of {Race} in {Kant}'s {Philosophy} of {History}},
  booktitle = {The {Court} of {Reason}},
  year = {2021},
  publisher = {De Gruyter},
  pages = {1697--1706},
  doi = {10.1515/9783110701357-169},
  note = {
  CORE ARGUMENT: Basevich argues that Kant's philosophy of historical progress is structurally
  implicated in his racial hierarchy: the teleological narrative of human development toward
  moral freedom and cosmopolitan right is racialized in ways that render the "universal" subject
  of history a specifically European (white) subject. The problem is not incidental racism but
  a structural feature of Kant's teleological framework.

  RELEVANCE: Represents the critical race-theory revision of Kantian philosophy of history, which
  any contemporary engagement with Kant's progressivism must address. Directly challenges whether
  a coherent and defensible Kantian philosophy of history is possible.

  POSITION: Critical-revisionary; challenges the systematic reading on normative grounds,
  arguing that the teleological framework is corrupted by racial assumptions.
  },
  keywords = {kant-philosophy-of-history, race, progress, critical-revision, Low, INCOMPLETE, no-abstract}
}

@article{cha2020cultureUltimateEnd,
  author = {Cha, Seunghan},
  title = {Culture as an ultimate end of nature in {Kant}'s teleology: {Focused} on {\S\S}83--84 '{Critique} of the {Teleological} {Power} of {Judgment}'},
  journal = {Journal of Moral \& Ethics Education},
  year = {2020},
  volume = {66},
  pages = {251--283},
  doi = {10.18338/kojmee.2020..66.251},
  note = {
  CORE ARGUMENT: Cha provides a detailed reading of sections 83-84 of the Critique of Judgment,
  arguing that culture (Kultur) is Kant's candidate for the "ultimate end of nature" --- nature's
  highest product in the sense relevant to teleological judgment --- while the "final end" (Endzweck)
  is moral humanity. Culture is thus the bridge between natural teleology and the moral vocation
  of human beings, and this bridge is what grounds the philosophy of history.

  RELEVANCE: Directly addresses the teleological sections of the third Critique that the project
  identifies as central (paragraphs 83-84), providing a careful reading of how culture and moral
  humanity relate within the teleological framework.

  POSITION: Systematic reading focused on the internal argument of the Critique of Judgment;
  supports the view that the third Critique provides systematic grounding for the historical essays.
  },
  keywords = {kant-philosophy-of-history, teleology, culture, critique-of-judgment, final-end, Medium},
  abstract = {칸트의 『판단력비판』은 단지 취미 판단에 관한 저작이 아니다. 「미감적 판단력 비판」과 「목적론적 판단력 비판」을 목적론의 견지에서 통합적으로 해석할 때에야 비로소 칸트가 의도한 철학적 체계의 완결성을 담보할 수 있다. 칸트의 목적론은 합목적성이라는 개념을 중시하며, 이를 통해 ‘자연의 통일적 이해’ 뿐만 아니라, ‘감성계의 인간과 예지계의 인간의 통합’까지 목표로 한다. 본 연구는 칸트 목적론에서 ‘목적 일반 → 최종목적 → 궁극목적’으로 상승하는 논의 구조를 일별한 후, ‘도덕 법칙 아래에 있는 인간’이 칸트 목적론의 귀결점으로 설정된 궁극목적이라는 점을 확인할 것이다. 또한, 이러한 구조를 가능하게 하는 힘이 ‘자연의 최종목적’으로 제시된 ‘인간의 문화’에 있다는 점에 착안하여 문화의 의미를 궁구하고자 했다.},
  abstract_source = {openalex},
}

@incollection{guyer2005natureMorality,
  author = {Guyer, Paul},
  title = {From {Nature} to {Morality}: {Kant}'s {New} {Argument} in the '{Critique} of {Teleological} {Judgment}'},
  booktitle = {Kant's {System} of {Nature} and {Freedom}},
  year = {2005},
  publisher = {Oxford University Press},
  pages = {314--342},
  doi = {10.1093/acprof:oso/9780199273461.003.0013},
  note = {
  CORE ARGUMENT: Guyer argues that in the "Critique of Teleological Judgment," Kant introduces
  a new argument --- not present in the earlier Critiques --- for the connection between natural
  teleology and morality: nature provides the conditions for the realization of the moral end,
  and the concept of the "final end of nature" (moral humanity) is what unifies the two parts of
  the Critique of Judgment. This is Kant's most direct argument for the dependence of the
  philosophy of history on the teleological framework.

  RELEVANCE: Provides the most detailed analysis of the "new argument" in sections 83-84 of the
  third Critique, which is the systematic foundation for reading Kant's historical philosophy as
  grounded in the critical system.

  POSITION: Systematic reading that credits the Critique of Judgment with a philosophically
  original argument connecting natural teleology to moral history.
  },
  keywords = {kant-philosophy-of-history, teleology, critique-of-judgment, final-end, nature-morality, High},
  abstract = {Abstract This chapter argues that the ‘Critique of Teleological Judgment’ in the Critique of the Power of Judgment complements Kant's earlier argument, on practical grounds, that the possibility of the highest good requires postulating the harmony of the laws of nature and the moral law with a new argument that an expectation of the systematicity of nature as a whole (that follows from our experience of organisms) requires the identification of a final end for the system of nature, which can only be the realization of human freedom in accordance with the moral law. Kant thus argues that our experience of nature as well as the demands of morality leads us to a conception of the harmony between nature and morality.},
  abstract_source = {openalex},
}

@article{sargentis2015crisisEvil,
  author = {Sargentis, Konstantinos},
  title = {Crisis, {Evil}, and {Progress} in {Kant}'s {Philosophy} of {History}},
  journal = {Journal of the Philosophy of History},
  year = {2015},
  volume = {9},
  number = {1},
  pages = {71--96},
  doi = {10.1163/18722636-12341292},
  note = {
  CORE ARGUMENT: Sargentis examines how Kant's notion of crisis --- the Streit or conflict that
  drives historical development through the "unsocial sociability" of human beings --- interacts
  with the doctrine of radical evil from the Religion. He argues that the experience of moral and
  political crisis is not merely an obstacle to progress but, for Kant, a necessary condition
  for the realization of freedom.

  RELEVANCE: Addresses the tension between radical evil and historical progress by focusing on
  the concept of crisis as a mediating structure, contributing to the project's analysis of how
  the Religion's pessimism and the political essays' optimism can be reconciled.

  POSITION: Integrative reading emphasizing the dialectical structure of Kantian progress through
  crisis and conflict.
  },
  keywords = {kant-philosophy-of-history, radical-evil, progress, crisis, Low, INCOMPLETE, no-abstract}
}

@article{fackenheim1957conceptHistory,
  author = {Fackenheim, Emil L.},
  title = {Kant's {Concept} of {History}},
  journal = {Kant-Studien},
  year = {1957},
  volume = {48},
  number = {1-4},
  pages = {381--398},
  note = {
  CORE ARGUMENT: Fackenheim argues that Kant's concept of history is neither a speculative system
  nor a merely empirical generalization but a regulative idea: we are required by practical reason
  to view history as if it were progressing toward the realization of freedom, without being able
  to prove theoretically that it is. This makes Kant's philosophy of history irreducibly practical
  and normative in character.

  RELEVANCE: Provides an early influential statement of the anti-systematic "regulative idea"
  reading, which contrasts sharply with later systematic interpretations (Yovel, Allison, Kleingeld).
  Understanding the regulative reading is essential for mapping the debate the project surveys.

  POSITION: Anti-systematic/regulative-idea reading; foundational for one major strand of
  interpretive debate.
  },
  keywords = {kant-philosophy-of-history, regulative-idea, practical-reason, historical-knowledge, Low, INCOMPLETE, no-abstract}
}
