@article{papish2024kantHope,
  author = {Papish, Laura},
  title = {Kant's {Revised} {Account} of {Hope} in {Human} {Progress}},
  journal = {History of Philosophy Quarterly},
  year = {2024},
  volume = {41},
  number = {4},
  pages = {305--322},
  doi = {10.5406/21521026.41.4.01},
  note = {
  CORE ARGUMENT: Papish traces a development in Kant's account of hope for human progress from
  the early political essays to the Religion, arguing that the recognition of radical evil leads
  Kant to revise his account: hope in progress cannot be grounded in natural teleology alone but
  requires a moral-religious commitment that is compatible with, but not reducible to, the empirical
  evidence for progress.

  RELEVANCE: Directly addresses the relationship between the political essays and the Religion
  on the question of progress, and engages the race-and-progress critique (Basevich) as a challenge
  to any coherent Kantian progressivism. Highly relevant to the project's concern with radical evil.

  POSITION: Revisionary systematic reading; acknowledges the tensions while defending a coherent
  if chastened account of Kantian hope for progress.
  },
  keywords = {kant-philosophy-of-history, radical-evil, hope, moral-progress, High},
  abstract = {Kant remained throughout his life committed to the idea that we can justifiably hope humankind is progressing. But there are important changes in how he conceptualized this hope. This paper maps out two underappreciated shifts in Kant's thinking between his final word on the subject, in his 1797 An Old Question Raised Again, and his accounts of hope in progress in earlier texts, including the Common Saying essay and Toward Perpetual Peace. The paper also shows that this new account remedies some problems with his pre-1797 discussions.},
  abstract_source = {s2},
}

@article{rossi2021highestGoodSocial,
  author = {Rossi, Philip J.},
  title = {The {Highest} {Good}, {The} {Social} {Character} of {Reason}, and the {Anthropological} {Enterprise} of {Kant}'s {Critique}},
