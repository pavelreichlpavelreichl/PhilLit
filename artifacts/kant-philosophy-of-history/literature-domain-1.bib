}

@article{williams2024progress,
  author = {Williams, Avery},
  title = {Is Progress Possible? {Moral} Improvement in {Kant}'s
    {Renewed Attempt}},
  journal = {History of Political Thought},
  year = {2024},
  volume = {45},
  number = {2},
  pages = {327--346},
  doi = {10.53765/20512988.45.2.327},
  abstract = {This article seeks to understand the possibility of
    moral improvement in human social history through a close
    interpretation of Kant's A Renewed Attempt to Answer the
    Question: Is the Human Race Continually Improving? The article
    examines the ways in which Kant's arguments in this final piece,
    while often overlooked, complicate his philosophy of history as
    put forward in earlier works. Through this comparison, one sees
    important complications in Kant's thoughts on the philosophy of
    history at the end of his career, conceding that rightful progress
    towards a global republicanism is the most we can be sure of.
    This concession is striking considering Kant's ambitious goal at
    the outset to demonstrate the theoretical certainty of moral
    progress, going well beyond the practical optimism he advocates
    in earlier works.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Williams examines Kant's late essay "A Renewed
  Attempt to Answer the Question: Is the Human Race Continually
  Improving?" and argues that it complicates his earlier
  philosophy of history in an underappreciated way: Kant concedes
  that only rightful progress toward global republicanism (not
  moral progress in the strong sense) can be grounded, making
  the 1784 essay's more ambitious goals harder to sustain.
  Williams reads the concession as revealing Kant's ongoing
  struggle to reconcile the philosophy of history with his moral
  philosophy.

  RELEVANCE: Provides a late-career perspective that complicates
  the 1784 essay's claims about nature's plan, showing that
  Kant himself recognized tensions that the secondary literature
  debates. Relevant to the project's question about the epistemic
  status of nature's "guarantee" of progress.

  POSITION: Developmental/complication reading; late Kant as
  moderating early optimism.
  },
  keywords = {kant-philosophy-of-history, progress, moral-improvement,
    republicanism, Medium}
}

@article{lenczewska2022rationality,
  author = {Lenczewska, Olga},
  title = {From Rationality to Morality: {The} Collective
    Development of Practical Reason in {Kant}'s Moral
    Anthropology},
  journal = {Kantian Review},
  year = {2022},
  volume = {27},
  number = {3},
  pages = {363--383},
  doi = {10.1017/s1369415422000152},
  abstract = {While Kant's account of humankind's rational progress
    has been widely discussed, his speculative views about the way in
    which this progress might have begun and the circumstances
    surrounding this beginning have been largely neglected. Implicit
    in such an omission is the assumption that Kant does not say much
    about the very beginning of human history or that whatever he says
    is of little philosophical value. This article challenges these
    assumptions. I reconstruct Kant's account of the emergence of
    reason by looking at his various conjectural and more literal
    remarks about our species' transition from mere irrational animals
    into primitive human beings possessing a rudimentary form of
    rationality. Next, I show how this account fits with Kant's
    broader view of humankind's rational progress and its subsequent
    stages.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Lenczewska reconstructs Kant's account of the
  emergence of rationality from the "Conjectural Beginning of
  Human History" (1786) and integrates it with the broader
  account of collective rational progress in the 1784 essay.
  She argues that the speculative origin-story is philosophically
  significant, not merely illustrative, and that it illuminates
  both the mechanism of unsocial sociability and the guidelines
  for moral education that Kant derives from his vision of
  reason's development.

  RELEVANCE: Connects the 1784 essay to the "Conjectural
  Beginning" and to Kant's moral anthropology, enriching the
  account of unsocial sociability with a developmental dimension.
  Addresses the project's question about how the essay relates
  to the broader critical project, especially practical reason.

  POSITION: Developmental/moral-anthropology reading; integrates
  1784 and 1786 essays.
  },
  keywords = {kant-philosophy-of-history, moral-anthropology,
    practical-reason, conjectural-beginning, Low}
}

@book{lenczewska2025kant,
  author = {Lenczewska, Olga},
  title = {Kant on the History and Development of Practical
    Reason},
  year = {2025},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781009216760},
  abstract = {This Element's focus is Kant's history of human
    reason: his teleological vision of the past development of our
    rational capacities from their very emergence until Kant's own
    "age of Enlightenment." One of the goals is to connect Kant's
    speculative account of the very beginning of rationality -- a
    topic that has thus far been largely neglected in Kantian
    scholarship -- to his well-known theory of humankind's progress.
    The Element elucidates Kant's hopes with regard to reason's
    future progress and his guidelines for how to achieve this
    progress by unifying them with his vision of reason's past.
    Another goal is to bring more attention to Kant's essay
    "Conjectural Beginning of Human History," where this account is
    presented, and to show that this unusual text does not stand in
    conflict with Kant's philosophy and is not merely tangentially
    related to it, but illuminates and complements certain aspects of
    his critical philosophy.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Lenczewska offers a systematic study of Kant's
  teleological vision of the past development of rational
  capacities, from their speculative pre-human origins through
  the historical emergence described in the 1784 and 1786 essays
  to Kant's "age of Enlightenment." The book connects Kant's
  account of the very beginning of rationality (from "Conjectural
  Beginning") to the well-known theory of humankind's progress,
  arguing that the Conjectural Beginning is not tangentially
  related to the critical philosophy but illuminates and
  complements it.

  RELEVANCE: The most recent book-length treatment specifically
  addressing the developmental and historical dimension of Kant's
  practical philosophy. Connects the 1784 essay to the
  conjectural essays and the broader practical system, directly
  addressing the project's question about how history relates
  to practical philosophy.

  POSITION: Integrated systematic reading; history as
  constitutive of practical philosophy's developmental
  dimension.
  },
  keywords = {kant-philosophy-of-history, practical-reason,
    development, conjectural-beginning, High}
}
