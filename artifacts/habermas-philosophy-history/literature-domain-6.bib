@article{gursoy2018unconscious,
  author = {Gürsoy, A. Özgür},
  title = {Unconscious reasons: Habermas, Foucault, and psychoanalysis},
  journal = {Continental Philosophy Review},
  year = {2018},
  volume = {52},
  number = {1},
  pages = {35--50},
  doi = {10.1007/S11007-018-9453-9},
  note = {
  CORE ARGUMENT: Gürsoy examines the relationship between Habermas' discourse
  theory and Foucault's genealogy through the lens of psychoanalysis, arguing
  that both thinkers draw on Freudian resources but in fundamentally different
  ways. Habermas uses psychoanalysis as a model for ideology-critique (the
  emancipation from distorted communication), while Foucault uses genealogy
  to show how reason itself is constituted through power relations. This
  difference maps onto their divergent philosophies of history.

  RELEVANCE: Shows how the Habermas-Foucault debate about rationality and
  power is connected to fundamentally different philosophies of history.
  Important for understanding why Foucault's genealogy is a genuine alternative
  to Habermas' reconstructive approach rather than merely a variant of it.

  POSITION: Critical secondary source; illuminates the philosophical stakes
  of the Habermas-Foucault debate for the philosophy of history.
  },
  keywords = {Foucault, psychoanalysis, genealogy, rationality, power, Medium, INCOMPLETE, no-abstract}
}

@article{payrow2017ineliminability,
  author = {Payrow Shabani, Omid},
  title = {The Ineliminability of the Idea of Progress},
  journal = {The Journal of Value Inquiry},
  year = {2017},
  volume = {51},
  number = {4},
  pages = {663--680},
  doi = {10.1007/s10790-017-9617-6},
  note = {
  CORE ARGUMENT: Payrow Shabani defends the concept of progress against
  postmodern and postcolonial critiques, arguing that some notion of progress
  is ineliminable from any normative political theory. Drawing on Habermas'
  learning-process model and Frankfurt School critical theory, he argues that
  the postcolonial critique of progress (as in Allen) conflates the concept of
  progress with particular Eurocentric narratives of progress, and that a
  "thin" concept of progress can be defended without these problematic features.

  RELEVANCE: Represents a neo-Habermasian defense of the philosophy of history
  against the most powerful contemporary critiques. Important for assessing
  whether the learning-process model survives the postcolonial challenge.

  POSITION: Sympathetic defence; argues for the continued viability of a
  reconstructed Habermasian philosophy of history.
  },
  keywords = {progress, postcolonial, Allen, learning-processes, neo-Habermasian, High, INCOMPLETE, no-abstract}
}

@article{ahmad2025ethnic,
  author = {Ahmad, Irfan},
  title = {Habermas as an ethnic thinker par excellence: on critique, Palestine, and beyond},
  journal = {Teaching in Higher Education},
  year = {2025},
  doi = {10.1080/13562517.2025.2466001},
  note = {
  CORE ARGUMENT: Ahmad argues that Habermas' public statements on the
  Israel-Palestine conflict (2023) reveal that his philosophy of history —
  nominally committed to universalist norms — is in practice applied
  selectively in ways that privilege Western liberal-democratic identity.
  He argues this is not merely a failure of application but reflects
  structural features of Habermas' reconstructive account of modernity,
  which grants normative primacy to the "occidental constellation" at the
  expense of non-Western claims.

  RELEVANCE: A recent and pointed critique of the practical implications of
  Habermas' philosophy of history, connecting the theoretical Eurocentrism
  critique (Allen, postcolonial theory) to concrete political judgments.
  Important for assessing the prospects of Habermas' framework in a
  genuinely global context.

  POSITION: Critical counter-position; charges Habermas with structural
  Eurocentrism with contemporary political implications.
  },
  keywords = {Eurocentrism, postcolonial, Palestine, universalism, contemporary-debate, Medium},
  abstract = {This article argues that Habermas' public statements on Palestine reveal structural features of his philosophy of history: a reconstruction of Western modernity as the normative standard that systematically disadvantages non-Western claims to justice and recognition.},
  abstract_source = {s2},
}

@article{vasterling2014hermeneutic,
  author = {Vasterling, Veronica},
  title = {The Hermeneutic Phenomenological Approach to Plurality: Arendt, Habermas, Derrida},
  year = {2014},
  doi = {10.1163/9789004281820_012},
  note = {
  CORE ARGUMENT: Vasterling compares Habermas' communicative account of
  political plurality with Arendt's and Derrida's approaches, arguing that
  Habermas' proceduralism flattens the political significance of irreducible
  plurality — the fact that communicative actors bring incommensurable
  perspectives that cannot be resolved through discourse alone. She argues
  for a phenomenological account of plurality that preserves what is lost
  in Habermas' proceduralist reduction.

  RELEVANCE: Extends the critique of Habermas' philosophy of history from a
  phenomenological direction, showing how the Habermas-Arendt-Derrida triangle
  generates competing accounts of historical plurality and political agency.

  POSITION: Critical counter-position; phenomenological critique of the
  proceduralism underlying Habermas' philosophy of history.
  },
  keywords = {Arendt, Derrida, plurality, phenomenology, proceduralism, Medium, INCOMPLETE, no-abstract}
}
