@article{schoolman2005avoiding,
  author = {Schoolman, Morton},
  title = {Avoiding "Embarrassment": Aesthetic Reason and Aporetic Critique in Dialectic of Enlightenment},
  journal = {Polity},
  year = {2005},
  volume = {37},
  number = {3},
  pages = {335--364},
  doi = {10.1057/palgrave.polity.2300019},
  note = {
  CORE ARGUMENT: Schoolman argues that Habermas' reading of Adorno and
  Horkheimer in The Philosophical Discourse of Modernity is distorted by
  his desire to preserve a non-aporetic normative theory. He argues that the
  "aesthetic reason" at work in the Dialectic of Enlightenment — the capacity
