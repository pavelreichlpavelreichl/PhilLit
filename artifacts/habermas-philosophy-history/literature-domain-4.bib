}

@book{dentreves1996habermas,
  author = {D'Entrèves, Maurizio Passerin and Benhabib, Seyla},
  title = {Habermas and the Unfinished Project of Modernity: Critical Essays on The Philosophical Discourse of Modernity},
  year = {1996},
  note = {
  CORE ARGUMENT: This collection of critical essays assembles some of the most
  important responses to The Philosophical Discourse of Modernity, covering
  Habermas' readings of Hegel, Nietzsche, Heidegger, Foucault, and Derrida,
  as well as the adequacy of communicative rationality as an alternative. The
  editors' introduction situates Habermas in the broader context of debates
  about modernity and argues for the continuing relevance of the "unfinished
  project" thesis. Contributors include Benhabib, McCarthy, Wellmer, and others.

  RELEVANCE: The key secondary collection for assessing Habermas' theory of
  modernity. Essential reading for the debate around the "unfinished project"
  thesis and for understanding both sympathetic and critical responses.

  POSITION: Central secondary source; the main critical forum for Habermas'
  theory of modernity as unfinished project.
  },
  keywords = {modernity, unfinished-project, critical-essays, PDM, High, INCOMPLETE, no-abstract}
}

@article{chernilo2002theorization,
  author = {Chernilo, Daniel},
  title = {The theorization of social co-ordinations in differentiated societies: the theory of generalized symbolic media in Parsons, Luhmann and Habermas},
  journal = {The British Journal of Sociology},
  year = {2002},
  volume = {53},
  number = {3},
  pages = {431--449},
  doi = {10.1080/0007131022000000581},
  note = {
  CORE ARGUMENT: Chernilo examines the concept of generalized symbolic media
  in Parsons, Luhmann, and Habermas, arguing that Habermas' appropriation
  of this concept — through money and power as system media that "uncouple"
  from communicative action — is both creative and problematic. He argues
  that Habermas' theory of modernization as differentiation retains more of
  Parsons than he acknowledges, raising questions about its critical potential.

  RELEVANCE: Provides the social-theoretic context for Habermas' theory of
  modernity as differentiation and colonization. Important for understanding
  the sociological infrastructure of his philosophy of history of modernity.

  POSITION: Critical secondary source; examines the sociological foundations
  of Habermas' theory of modernity.
  },
  keywords = {Parsons, Luhmann, differentiation, symbolic-media, social-theory, Medium, INCOMPLETE, no-abstract}
}

@article{fleming1996working,
  author = {Fleming, Marie},
  title = {Working in the Philosophical Discourse of Modernity},
  journal = {Philosophy Today},
  year = {1996},
  volume = {40},
  number = {1},
  pages = {169--178},
  doi = {10.5840/PHILTODAY199640143},
  note = {
  CORE ARGUMENT: Fleming examines Habermas' engagement with Foucault in
  The Philosophical Discourse of Modernity, arguing that Habermas misreads
  Foucault's genealogical critique as a covert continuation of the philosophy
  of the subject. She contends that Foucault's account of historical
  transformation is more nuanced than Habermas allows and that the "unfinished
  project" thesis consequently fails to engage with Foucault's strongest
  arguments.

  RELEVANCE: A focused critical analysis of Habermas' engagement with the
  postmodern challenge to his theory of modernity. Important for assessing
  the limits of the "unfinished project" thesis when confronted with
  alternative accounts of historical reason.

  POSITION: Critical secondary source; challenges Habermas' reading of
  poststructuralism as continuous with the philosophy of the subject.
  },
  keywords = {Foucault, PDM, poststructuralism, modernity, genealogy, Medium, INCOMPLETE, no-abstract}
}

@article{visker1992habermas,
  author = {Visker, Rudi},
  title = {Habermas on Heidegger and Foucault. Meaning and validity in 'The philosophical discourse of modernity'},
  year = {1992},
  note = {
  CORE ARGUMENT: Visker offers a careful reading of Habermas' chapters on
  Heidegger and Foucault in The Philosophical Discourse of Modernity,
  arguing that Habermas systematically reduces both thinkers to versions of
  the philosophy of the subject in order to make them fit his framework of
  critique. He shows that this involves misreadings of Heidegger's concept
  of Dasein and Foucault's genealogy of the subject that the texts themselves
  do not support.

  RELEVANCE: One of the most exacting critiques of Habermas' readings of
  the post-Hegelian tradition in the PDM. Important for assessing the cogency
  of his critique of the alternatives to the "unfinished project" of modernity.

  POSITION: Critical secondary source; challenges the exegetical basis of
  Habermas' theory of modernity.
  },
  keywords = {Heidegger, Foucault, PDM, meaning, validity, Medium, INCOMPLETE, no-abstract}
}

