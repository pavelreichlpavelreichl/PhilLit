  title = {The Antinomies of Habermas' Reconstruction of Historical Materialism},
  journal = {Revista Inter-Legere},
  year = {2019},
  volume = {2},
  number = {24},
  pages = {17--50},
  doi = {10.21680/1982-1662.2019v2n24id17477},
  note = {
  CORE ARGUMENT: Browne argues that the major innovation of Habermas' reconstruction---replacing the paradigm of production with a theory of communication and redefining relations of production as forms of social integration---generates productive theoretical possibilities but also significant antinomies. Specifically, the framework's inflexible developmental logic, which orders social formations by normative-structural competence, prevents engagement with the internal conflicts and creative dynamics of material production. Browne proposes that contemporary social theories focused on social creativity, institutional variation, and the dialectics of social struggle can correct these limitations.

  RELEVANCE: Browne provides one of the most thorough analyses of what Habermas gained and lost by replacing production with communication as the theoretical paradigm. The paper directly addresses the research project's question about the relationship between Habermas' reconstruction and Marx's original theory.

  POSITION: Critical reception; argues the communication paradigm introduces theoretical antinomies that undermine the explanatory power of the social evolution framework.
  },
  keywords = {historical-materialism, social-evolution, communication-paradigm, production, Medium},
  abstract = {There are few attempts to reformulate the historical perspective of classical sociological theory comparable to that of Jürgen Habermas’ reconstruction of historical materialism. Habermas considered historical materialism to be principally a theory of social evolution and he sought to revise its conception of historical development. In Habermas’ opinion, the logic of the development of normative structures, social identities and cultural understandings differs from that of material production and the organizational complexity of social systems. My analysis reveals how the major innovation of Habermas’ reconstruction of historical materialism is the ensuing conceptualizations of the social relations of production as forms of social integration and the function of systematically distorted communication in their historical institution. Despite the significant implications of this supplementation of the paradigm of production with a theory of communication, Habermas’ reconstruction of historical materialism is shown to be limited by its inflexible logic of development and disengagement from the conflicts internal to processes of material production. It is proposed that the historical perspective of other strands of contemporary social theory may rectify these limitations through their concern with social creativity, institutional variations and the dialectics of social struggle.},
  abstract_source = {s2},
}

@article{oh2023developmental,
  author = {Oh, Keunchang},
  title = {A Developmental Logic: Habermas's Theory of Social Evolution},
  journal = {Theoria},
  year = {2023},
  volume = {90},
  number = {1},
  pages = {81--97},
  doi = {10.1111/theo.12509},
  note = {
  CORE ARGUMENT: Oh elucidates the distinction between developmental logic and developmental dynamics in Habermas' theory of social evolution, arguing that Habermas underestimates the importance of developmental dynamics. The key problem is that Habermas conceives learning processes too narrowly: unlike cumulative cultural learning at the phylogenetic level, individual ontogenetic learning is non-cumulative, and this tension is not adequately resolved in the framework. As a result, learning processes at the species level do not straightforwardly guarantee social evolution in the way Habermas requires.

  RELEVANCE: This is the most recent sustained philosophical analysis of the developmental logic/dynamics distinction, directly addressing one of the four key questions in this research project. Oh's reconstruction also situates Habermas in relation to contemporary philosophy of biology and learning theory.

  POSITION: Critical reconstruction; argues the developmental-logic/dynamics framework is internally unstable due to the non-cumulativity of individual learning.
  },
  keywords = {developmental-logic, developmental-dynamics, social-evolution, learning-processes, High},
  abstract = {In the paper, I first consider how his theory of social norms is connected to his theory of social evolution by examining the importance of learning in his theory of both social norms and social evolution. Then I turn to David Owen and Amy Allen's critiques of Jürgen Habermas. My aim is to develop their critique of Habermas by elucidating an important but neglected distinction between the developmental logic and the developmental dynamics in Habermas's theory of social evolution. Drawing on this distinction, I claim that Habermas's theory is problematic in that he underestimates the importance of the developmental dynamics. By introducing the distinction between individual learning and social learning, I also question his account of progress as accumulative experience of learning. This is because, unlike cumulative culture at the level of phylogenesis, individuals ontogenetically experience a kind of non‐cumulative social learning. Unlike cumulative culture, each individual has to undergo a kind of non‐cumulative social learning. The problem is that Habermas conceives the learning process too narrowly such that learning does not guarantee social evolution.},
  abstract_source = {s2},
}

@book{owen2002betweenreason,
  author = {Owen, David},
  title = {Between Reason and History: Habermas and the Idea of Progress},
  year = {2002},
  publisher = {State University of New York Press},
  doi = {10.1353/book4544},
  note = {
  CORE ARGUMENT: This is the first book-length treatment in English of Habermas' theory of social evolution and progress. Owen reconstructs the developmental theory of social evolution across Habermas' career, examining the critical theory context, the relationship between progress and social evolution, and the developmental logic thesis specifically. The book also addresses the Eurocentrism charge: Owen's essay "Habermas's Developmental Logic Thesis: Universal or Eurocentric?" (1998) asks whether the cognitive-moral stage sequence is genuinely universal or reflects a parochial Western developmental path.

  RELEVANCE: Owen's monograph provides comprehensive secondary coverage of the research project's domain, synthesizing the evolution of Habermas' position and contextualizing the developmental logic thesis within critical theory. Its treatment of the Eurocentrism problem adds a dimension absent from other English-language secondary literature.

  POSITION: Sympathetic critical reconstruction; the most comprehensive English-language monograph on Habermas' social evolution theory.
  },
  keywords = {social-evolution, developmental-logic, progress, critical-theory, High},
  abstract = {Part of the enduring fascination of the German intellectual tradition must surely be located in the richness of religious thought within it. John H. Smith probes this tradition, bringing out the complexities and ambiguities of nearly five-hundred years of philosophical and theological reflection. Specifically, Smith sees in post-Reformation German thought a compelling instantiation of the more general thesis that "a certain logic in modern thought about Christianity brought about both its own undoing and the seeds for a revival of faith from a new perspective" (viii-ix).
  abstract_source = {ndpr},

In his Introduction, Smith sets forth the basic framework of his ambitious historical reconstruction. Like Faust in Part One of Goethe's masterful drama, Smith takes his cue from the famous Prologue to the Gospel of John ("In the beginning was thelogos"), insisting thatlogos, in its many meanings ("reason" and "discourse" being the most well-known), is implicated in the very heart of the Christian conception of the divine (2). The resulting story is summarized thusly:

it is precisely the attempt of reason and philosophy to define a rational God and then to define themselvesasthat God, followed by the perceived failure of that endeavor, that has opened the way to a return of religion to replace the binding force lost by the collapse . . . of reason (8).

Smith rightly views this story as one of conflict, compromise, and even contradiction. Yet, what ultimately interests him in (re-)telling the story is the possibility nascent within it of "an understanding that sees both a rational core to faith (i.e., its inherent drive to express itself in a language of reasons) and an unfathomable and self-transcending aspect to rationality and language (i.e., their inherent drives to their own limits and their reliance on ungrounded assumptions)" (19).

As these remarks indicate, Smith's project can be seen as fundamentally Hegelian. It was Hegel, after all, who famously articulated the creative potential hidden in the contradictions of history. Further, it was Hegel who, perhaps more than any other thinker of his era, took his Enlightenment predecessors (both pro- and anti-religious) to task for thinking of rationality (logos, in Smith's terms) in too narrow a fashion, resulting in an impoverishment of religious life and thought. Hegel likewise defends his own "speculative" approach to religion by pointing to the manner in which reason had (at least until his time) been inseparably bound up with the heart of Christianity itself. Smith's narrative, while perhaps less optimistic than Hegel's (at least according to some readings of Hegel), nevertheless aims to bring out the productive tensions in modern German religious thought with one eye towards the future of religious discourse in a post-Enlightenment age.

After setting out the basic terms of his narrative in the Introduction, Smith turns in Chapter 1 to the famous debate between Erasmus and Luther on (among other things) freedom of the will. For Smith, this exchange establishes "the basic paradigm in which modern Western treatments of religion, faith, rationality, and agency unfold" (26). In Chapter 2, Smith moves on to the fragmented situation of post-Reformation Christendom, detouring outside of the German context to some extent to consider three figures (Descartes, Spinoza, Leibniz) who sought a "rationalistic" solution to the intellectual dilemmas of the age. Here, "The irony turns out to be that the very tools used to slow down the progress of Western thought toward a godless world would end up hastening it and making it more final in the end" (47). In this same chapter, Smith also examines Pascal, a figure who represents the tensions within the unfolding tradition insomuch as he "turned from thelogosof the mathematical natural sciences to a conception of faith based on feeling and nonrational experience" (62), rejecting the so-called "God of the philosophers."

Chapter 3 focuses largely on a single figure, Kant; the central question for Smith is whether Kant's critical philosophy is ultimately "responsible for a major acceleration down the slippery slope to atheism" (70). He seems to answer his own question in the affirmative, maintaining that, for Kant, "God appears as a need or result ofourethics and rationality"; hence, the critical philosophy "exposes God to a final coup de grâce" from Nietzsche a century later (70). In addition to Kant, Smith also briefly discusses G.E. Lessing as a key source for the claim that religion is essentially about morality, not metaphysics (80-84). Yet, as with Kant, Smith asserts that "in Lessing we have a typical case of someone who had every intention ofstrengtheningreligious faith -- as opposed to Enlightenment atheists -- and yet who might have contributed to the opposite" (81).

In Chapter 4, Smith turns to the figure that I have suggested is really the central hero of the narrative, Hegel. Smith argues that Hegel's key concept of "spirit [Geist]" is deployed in the philosophy of religion to challenge inherited dichotomies between reason and faith and between intellectual comprehension and political action (96-7). As mentioned previously, Smith seems to largely endorse Hegel's criticisms of the dominant theological trends of the late eighteenth century (100). At the same time, Hegel too belongs on the "slippery slope" to the "death of God," for "in developing theology or philosophy of religion as a science of spirit, aGeistes-Wissenschaftthat is its own product, the human spirit is graspingitselfas much as it isGod. The reality of God in human history makes human history divine" (98). Chapter 5 examines four anti-Hegelian figures: Schleiermacher, Schelling, Schopenhauer, and Feuerbach. What these otherwise diffuse thinkers share, according to Smith, is the assumption that "onlyby attacking the dominance and apparent self-sufficiency of rationality can the truly religious be understood and, perhaps, salvaged" (120). The difficulty is that, given the apparent comprehensiveness of Hegel's system, does such a critique leave anything left to salvage? (121).},
}

@article{strydom1987collective,
  author = {Strydom, Piet},
  title = {Collective Learning: Habermas's Concessions and Their Theoretical Implications},
  journal = {Philosophy \& Social Criticism},
  year = {1987},
  volume = {13},
  number = {3},
  pages = {265--281},
  doi = {10.1177/019145378701300304},
  note = {
  CORE ARGUMENT: Strydom analyzes Habermas' concessions about the difficulty of extending individual learning theory to the species level, arguing that these concessions have deeper theoretical implications than Habermas acknowledges. The problem of collective learning---how individual cognitive-moral competences can be aggregated or institutionalized at the societal level---exposes a gap between the ontogenetic model (drawn from Piaget and Kohlberg) and the phylogenetic claims of social evolution theory. Strydom argues that Habermas needs a more robust theory of collective cognitive processes.

  RELEVANCE: This article identifies the key tension between individual developmental psychology and social-level learning that is central to the research project's question about how Habermas conceptualizes learning processes at the species level. It anticipates many of the concerns raised by Oh (2023).

  POSITION: Early critical reception; identifies the collective learning problem as a structural weakness in the social evolution framework.
  },
  keywords = {collective-learning, social-evolution, developmental-logic, ontogenesis, Medium, INCOMPLETE, no-abstract}
}

@article{kirkpatrick2003evolution,
  author = {Kirkpatrick, Graeme},
  title = {Evolution or Progress? A (Critical) Defence of Habermas's Theory of Social Development},
  journal = {Thesis Eleven},
  year = {2003},
  volume = {72},
  number = {1},
  pages = {91--112},
  doi = {10.1177/0725513603072001135},
  note = {
  CORE ARGUMENT: Kirkpatrick defends Habermas' theory of social development against the charge that it is an implausible evolutionary model, arguing that the framework is better understood as a theory of progress than of biological-style evolution. He distinguishes the normative-rational reconstruction of social development from empirical evolutionary claims, and argues that the developmental logic framework retains validity as an account of the logical preconditions of communicative rationalization even if it cannot predict historical dynamics.

  RELEVANCE: Kirkpatrick's partial defense clarifies the precise nature of Habermas' claims about social evolution and helps distinguish what is defensible from what is vulnerable in the framework---directly relevant to assessing the reconstructive alternative to speculative philosophy of history.

  POSITION: Partial defense; argues the framework is more modest (and more defensible) than critics assume.
  },
  keywords = {social-evolution, progress, developmental-logic, communicative-rationality, Medium},
  abstract = {Habermas's theory of social evolution has been subjected to critique by environmentally motivated sociologists. They argue that his decision to recast social theory in terms of an extended, if selective analogy with biology leads him into a set of practical positions that are irreconcilable with Green politics and inconsistent with the goals of traditional critical theory. This article argues that these criticisms are based on an inaccurate assessment of the role of evolutionary concepts in Habermas's thought. By drawing out the similarities between Habermas and Kant on the question of the relationship between history and natural history, it is possible to see that Habermas's use of evolutionary metaphors plays a regulative rather than a constitutive role in his thinking on society. This strategy does not save Habermas's position, but shows instead that it may be vulnerable to an immanent critique that pulls out the real underlying antagonisms in his system.},
  abstract_source = {openalex},
}

@article{delanty1997habermas,
  author = {Delanty, Gerard},
  title = {Habermas and Occidental Rationalism: The Politics of Identity, Social Learning, and the Cultural Limits of Moral Universalism},
  journal = {Sociological Theory},
  year = {1997},
  volume = {15},
  number = {1},
  pages = {30--59},
  doi = {10.1111/0735-2751.00022},
  note = {
  CORE ARGUMENT: Delanty examines Habermas' theory of Western rationalization---his reconstruction of Weber's analysis of Occidental rationalism---and argues that it faces a fundamental problem: the universalism it claims for communicative rationality is embedded in a particular cultural-political history of Western identity formation. The analysis of social learning processes through the lens of moral universalism has limited applicability to non-Western social formations, and the politics of collective identity cannot be adequately captured by cognitive-moral developmental sequences.

  RELEVANCE: Delanty's critique bears directly on the question of whether Habermas' developmental-logic thesis is a genuinely universal account of social evolution or a culturally specific rationalization of Western modernity. This connects the social evolution framework to broader debates about Eurocentrism in critical theory.

  POSITION: Cultural-limits critique; argues moral universalism in the social evolution framework is contaminated by Occidental cultural particularism.
  },
  keywords = {Occidental-rationalism, moral-universalism, social-learning, identity, Medium},
  abstract = {While Habermas's theory of communicative action is deeply critical of all kinds of ethnocentrism, proposing a discursive concept of universal morality which transcends culture, a residual Eurocentrism still pervades it. Habermas's theory rests on a notion of modernity which is tied to Occidental rationalism, and when viewed in the global context or in the context of deeply divided societies it is problematic. The theory fails to grasp that universal morality can be articulated in more than one cultural form and in more than one logic of development. However, his theory can be defended against its Eurocentric bias if it shifts its emphasis from a de-contexualized and transcendental critique of communication rooted in Occidental rationalism to a cosmopolitan model of contemporary cultural transformation. Crucial to that task is a weaker notion of rationality which recognizes that the problem of universality is also a cognitive cultural problem and not just a normative one. Bringing culture and identity to the foreground will involve making room for a level of discourse focused less on consensual agreement than on cultural understanding.},
  abstract_source = {openalex},
}

@article{ortega2018recepcion,
  author = {Ortega Esquembre, César},
  title = {La recepción del pensamiento de Marx en el joven Habermas},
  journal = {Ideas y Valores},
  year = {2018},
  volume = {67},
  number = {167},
  doi = {10.15446/ideasyvalores.v67n167.57601},
  note = {
  CORE ARGUMENT: Ortega Esquembre traces the influence of Marx on Habermas' early theoretical development, focusing on how Habermas reconstructs Marxian historical materialism on the basis of a new theory of social evolution. The analysis identifies which Marxian postulates are preserved (the materialist emphasis on reproduction conditions), which are transformed (the productive forces model replaced by a communicative competence model), and which are abandoned (the primacy of labor as the paradigmatic form of human self-constitution). The paper shows how Wellmer's critique of Marx serves as an important relay.

  RELEVANCE: This paper provides background on the intellectual trajectory from Marx to Habermas, helping situate Habermas' reconstructive project in relation to the Marxist tradition it criticizes. It directly addresses the research question about how Habermas' reconstruction differs from Marx's original.

  POSITION: Developmental reception history; traces the Marx-Habermas relationship through the lens of early theoretical formation.
  },
  keywords = {Marx, historical-materialism, social-evolution, early-Habermas, Medium},
  abstract = {The article analyzes the influence of Marx’s thought on the formulation of Habermas’ early theory, starting out from Albrecht Wellmer’s and Jurgen Habermas’ critiques of the Marxian conception of historical materialism. The paper then goes on to examine the reconstruction of some of the postulates of Marxism carried out by Habermas on the basis of a new theory of social evolution. This brings to light some basic assumptions of Marx’s theory that are transformed in Habermas’ conceptualization and constitute the necessary basis to understand the author’s later thought.},
  abstract_source = {s2},
}

@article{mejia2022social,
  author = {Mejía Fernández, Ricardo and Romero, Javier},
  title = {Social Evolution in Jürgen Habermas: Towards a Weak Anthropological Naturalism between Kant and Darwin},
  journal = {Theoria},
  year = {2022},
  volume = {88},
  number = {3},
  pages = {607--628},
  doi = {10.1111/theo.12383},
  note = {
  CORE ARGUMENT: Mejía Fernández and Romero argue that Habermas' mature position on social evolution represents a "weak anthropological naturalism" that steers between Kantian idealism (universal a priori structures of communicative reason) and Darwinian naturalism (biological evolution as the basis for social development). They reconstruct how Habermas incorporates insights from evolutionary biology and cognitive science into the social evolution framework without reducing normative structures to natural selection, maintaining that communicative competences have evolutionary roots but cannot be explained reductively.

  RELEVANCE: This recent paper brings Habermas' social evolution framework into dialogue with contemporary debates in philosophy of biology and naturalism, offering a sympathetic reconstruction of his position that addresses objections to the developmental logic framework. It updates the reception of Habermas' evolutionism for a post-Darwinian context.

  POSITION: Naturalist rehabilitation; argues Habermas' social evolution theory is defensible as a form of weak naturalism.
  },
  keywords = {naturalism, social-evolution, Darwinism, anthropology, Medium},
  abstract = {Issues concerning naturalism have increasingly become the subject of philosophical reflections involving ontological, epistemological, and even ethics affairs. The most popular topic for contemporary philosophy has been the relationship between ontological results of Darwinism and epistemology. Despite the varied circumstances of its establishment, naturalism almost always produces recommendations that reflect a worldview much “ weaker ” (as in the case of Habermas) than the strong one more common among scientism. There are good structural reasons for this difference. The aim of this paper is to elucidate some of distinctive social features of Habermas ’ s conception of the human being and its implications in the Theory of Communicative Action (1982). Therefore, it is shown that his anthropology takes a naturalistic and Darwinist perspective in the weak naturalism perspective. In the first part, Darwin ́ s legacy is analysed as a research program, and Habermas ́ s studies on biological anthropology are compared with the latest research in genetics and palaeontology. In the second part, we will show Habermas ’ s proposal to confront an epistemological dualism through a weak non-reductionist naturalism as a critique of modern metaphysics, which structures a new pragmatic realism.},
  abstract_source = {s2},
}

@article{wolkenstein2025dialectic,
  author = {Wolkenstein, Fabio},
  title = {The Dialectic of Backsliding: Thinking with Habermas About Democratic Progress and Regression},
  journal = {European Journal of Philosophy},
  year = {2025},
  volume = {33},
  number = {4},
  pages = {1274--1290},
  doi = {10.1111/ejop.13080},
  note = {
  CORE ARGUMENT: Wolkenstein employs Habermas' theory of social evolution and communicative rationalization to analyze the phenomenon of democratic backsliding, arguing that the developmental logic framework---despite its critics---provides resources for understanding democratic regression as a historically intelligible pattern. The paper proposes a "dialectic of backsliding" in which regressions mobilize the very normative resources that communicative rationalization has deposited in the lifeworld, generating counter-movements.

  RELEVANCE: This 2025 paper demonstrates the contemporary applicability of Habermas' social evolution framework to political theory, connecting the developmental logic thesis to pressing debates about democratic regression and progress. It shows that Habermas' positive theory of history remains productive for contemporary political philosophy.

  POSITION: Contemporary application; uses the social evolution framework to theorize democratic backsliding.
  },
  keywords = {democratic-backsliding, social-evolution, developmental-logic, political-theory, Low},
  abstract = {There is widespread agreement that we are living in an age of “democratic backsliding,” in which a growing number of formally democratic countries are falling behind previously achieved levels of democratization. But on what grounds can we claim that one level of democratic development is “higher” or “lower” than another? This question has rarely been systematically addressed in recent scholarship, despite the popularity of the language of “backsliding.” Reacting to this, this article aims to retrieve a philosophically sophisticated account of democratic progress and regression from the work of Jürgen Habermas, a major figure of Frankfurt School Critical Theory. The article derives from Habermas's thought a distinctive conception of democratic progress, as well as three different meanings of “democratic regression.” It also discusses some implications for social science research on democratization.},
  abstract_source = {s2},
}

@article{mendieta2018axial,
  author = {Mendieta, Eduardo},
  title = {The Axial Age, Social Evolution, and Postsecular Consciousness},
  journal = {Critical Research on Religion},
  year = {2018},
  volume = {6},
  number = {3},
  pages = {289--308},
  doi = {10.1177/2050303218800379},
  note = {
  CORE ARGUMENT: Mendieta examines Habermas' engagement with Karl Jaspers' "Axial Age" thesis as an instance of Habermas' broader concern with the long-run historical processes of rationalization and social evolution. The paper argues that Habermas' recent postsecular turn---his interest in religious learning processes and the cognitive content of religion---represents a revisiting and partial revision of the social evolution framework: religious traditions are now seen not only as pre-modern residues but as carriers of semantic potential not yet cashed out in secular modernity.

  RELEVANCE: This paper connects the early social evolution framework to Habermas' later postsecular writings, tracking continuity and revision across his career. It situates the rationalization of the lifeworld within a longer civilizational history, relevant to the research project's interest in Habermas' philosophy of history across different periods.

  POSITION: Continuity tracking; links the social evolution framework to Habermas' postsecular turn via the Axial Age concept.
  },
  keywords = {axial-age, postsecular, social-evolution, religion, Low},
  abstract = {This article focuses on Karl Jaspers’s notion of the Axial Age, some of its critical appropriation, and how in particular Habermas has returned to this idea, after several critical engagements with Jaspers’s work through his long scholarly productivity. The article, however, centers on Habermas’s selective and critical use of Jaspers’s notion in his own latest and extensive engagement with what he calls “a genealogy of postmetaphysical thinking.” The goal of the article is to identify the ways in which Habermas is refurbishing Jaspers’s generative concept, but at the same time, how his work on postsecular consciousness opens itself to some liabilities by not taking enough distance from the concept.},
  abstract_source = {s2},
}

@article{teymoori2025rational,
  author = {Teymoori, Ali and Mataji, Amin},
  title = {Is It Possible to Form a Rational Identity? A Critical Reading of Habermas' Account of Social Identity},
  journal = {Philosophy \& Social Criticism},
  year = {2025},
  doi = {10.1177/01914537251348412},
  note = {
  CORE ARGUMENT: Teymoori and Mataji argue that Habermas' account of social identity---grounded in communicative rationality and procedural democracy---is inadequate due to a "problematic stage-based framework in his historical account of societal evolution." The stage model is said to be both normatively too thin (the procedural account of identity is insubstantial) and historically too rigid (the developmental sequence presupposes modernity as an endpoint). The paper proposes that a more defensible framework requires both a substantive account of politics and a revised relationship between system and lifeworld.

  RELEVANCE: This recent paper targets the stage-based developmental framework directly, arguing that the social evolution model generates distorted accounts of collective identity. It provides a contemporary critical perspective on the research project's question about developmental logic in Habermas' theory.

  POSITION: Critical reception; argues the developmental stage model distorts Habermas' account of social identity.
  },
  keywords = {social-identity, developmental-logic, system-lifeworld, modernity, Medium, INCOMPLETE},
  abstract = {Habermas’ account of social identity is the most sophisticated among various deliberative and expansive democratic models and aligns with his long-standing theoretical commitment to communicative rationality that is tailored to the democratic organization of society. Taking a normative stance, he proposes a procedural account of social identity within communicative rationality, achievable only in modernity and deliberative democracy. We argue that his formulation of social identity is inadequate, given a problematic stage-based framework in his historical account of societal evolution and the insubstantial nature of social identity in his linguistic and procedural accounts of social identity. Nonetheless, Habermas’ approach can serve as a starting point to develop a more inclusive and empirically defensible conceptual framework for collective identity, grounded in robust institutional foundations and a substantive account of the political. Finally, by challenging Habermas’ separation of system and lifeworld, we argue that a rational social identity should be rooted in both domains.},
  abstract_source = {s2},
}

@book{habermas1987philosophical,
  author = {Habermas, Jürgen},
  title = {The Philosophical Discourse of Modernity: Twelve Lectures},
  year = {1987},
  note = {
  CORE ARGUMENT: Habermas traces the "discourse of modernity" from Hegel through
  Nietzsche, Heidegger, Derrida, Foucault, and the Young Conservatives. He argues
  that the tradition of the philosophy of the subject — inaugurated by Hegel's
  attempt to make Geist the carrier of a self-reflexive historical process —
  generates an antinomy: it can neither ground normative critique nor avoid
  collapsing reason into power. The solution is the "paradigm shift" from
  subject-centred to communicative reason, which abandons the metaphysical
  ambitions of speculative philosophy of history while retaining the normative
  content of the Enlightenment project.

  RELEVANCE: This is Habermas' most sustained and direct engagement with the
  tradition of speculative philosophy of history. It is the locus classicus of
  his critique of Hegel's "philosophy of the subject" and his argument that
  philosophy of history must be reconstructed rather than continued or abandoned.

  POSITION: Central primary source for the critique of speculative philosophy
  of history; foundational for understanding Habermas' relationship to Hegel,
  Nietzsche, Heidegger, and poststructuralism.
  },
  keywords = {philosophy-of-subject, modernity, Hegel, Nietzsche, postmodernism, High, INCOMPLETE, no-abstract}
}

@book{horkheimerAdorno2002dialectic,
  author = {Horkheimer, Max and Adorno, Theodor W.},
  title = {Dialectic of Enlightenment},
  year = {2002},
  doi = {10.1515/9780804788090},
  note = {
  CORE ARGUMENT: Horkheimer and Adorno argue that the Enlightenment's drive
  towards domination of nature through instrumental reason leads to the
  self-destruction of reason. Myth and Enlightenment are intertwined: the
  rationalisation of the world produces new forms of barbarism. History is
  not progress towards emancipation but a catastrophic dialectic in which
  rational mastery turns against human beings.

  RELEVANCE: This is the text against which Habermas defines his own position
  most explicitly. He inherits the Frankfurt School's concern with the pathologies
  of modernity but rejects the "total critique of reason" as performatively
  self-contradictory. His reconstruction of communicative rationality is partly
  a response to what he sees as the impasse Adorno and Horkheimer reach by
  equating all rationalization with instrumental reason.

  POSITION: Essential background; the negative foil against which Habermas
  articulates the communicative alternative in his critique of speculative
  philosophy of history.
  },
  keywords = {Frankfurt-School, instrumental-reason, enlightenment, modernity, High},
  abstract = {Dialectic of Enlightenment is, quite justifiably, one of the most celebrated and often cited works of modern social philosophy. It has been identified as the keystone of the 'Frankfurt School', of which Theodor Adorno and Max Horkheimer were the leading members, and does not cease to impress in its wide-ranging ambition and panache. Adorno and Horkheimer addressees themselves to a question which was felt with particular urgency in the aftermath of National Socialism: how was it possible that science, technology and rational thought could have led to barbarism rather than emancipation?},
  abstract_source = {s2},
}

@article{hohendahl1985dialectic,
  author = {Hohendahl, Peter U.},
  title = {The Dialectic of Enlightenment Revisited: Habermas' Critique of the Frankfurt School},
  journal = {New German Critique},
  year = {1985},
  number = {35},
  pages = {3},
  doi = {10.2307/488198},
  note = {
  CORE ARGUMENT: Hohendahl examines Habermas' critique of Adorno and Horkheimer
  in detail, focusing on the charge that the Dialectic of Enlightenment forfeits
  any normative standard for critique by totalizing the concept of instrumental
  reason. He assesses whether Habermas' communicative rationality can do the
  critical work that Adorno's negative dialectics cannot, and identifies
