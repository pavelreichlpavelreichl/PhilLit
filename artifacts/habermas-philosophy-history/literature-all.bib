@article{tam2025reviving,
  author = {Tam, Agnes},
  title = {Reviving the Project of Moral Progress: A Pragmatist Attempt and Its Limits},
  journal = {Analysis},
  year = {2025},
  doi = {10.1093/analys/anad094},
  note = {
  CORE ARGUMENT: Tam revisits the concept of moral progress in light of
  contemporary pragmatism, arguing that the Habermasian learning-process
  model can be revived by grounding it in pragmatist accounts of inquiry
  rather than the formal-pragmatic account of validity claims. She assesses
  the limits of this pragmatist revision, arguing that it purchases empirical
  plausibility at the cost of the normative universalism that Habermas' project
  requires.

  RELEVANCE: Directly relevant to whether the learning-process model at the
  heart of Habermas' philosophy of history can be sustained in contemporary
  philosophy. Shows the ongoing engagement with the project of reconstructive
  philosophy of history.

  POSITION: Recent secondary source; assesses the contemporary viability of
  Habermas' theory of moral progress.
  },
  keywords = {moral-progress, pragmatism, learning-processes, contemporary-debate, Low},
  abstract = {If I were to ask you to name the most important concept in moral and political philosophy today, your answer might be 'justice', 'equality' or 'freedom'. But for an intellectual in eighteenth-century Europe, the most likely answer would have been 'progress'. This article revisits the concept of moral progress in light of recent pragmatist philosophy and assesses its relationship to the Habermasian learning-process model.},
  abstract_source = {s2},
}

@book{allen2016end,
  author = {Allen, Amy},
  title = {The End of Progress: Decolonizing the Normative Foundations of Critical Theory},
  year = {2016},
  doi = {10.7312/alle17324},
  note = {
  CORE ARGUMENT: Allen argues that the normative foundations of Habermas'
  critical theory — and of the Frankfurt School tradition more broadly —
  are contaminated by a crypto-teleological account of progress that
  unreflectively privileges the Western developmental trajectory. Drawing
  on postcolonial theory (Spivak, Chakrabarty) and Foucauldian genealogy,
  she argues that Habermas' theory of social evolution and learning processes
  presupposes a developmental logic that ranks non-Western societies as
  more or less advanced along a single scale derived from Western modernity.
  She proposes a "postcolonial" critical theory that abandons the progress
  narrative while retaining the emancipatory commitment.

  RELEVANCE: The most sustained and systematic challenge to Habermas'
  philosophy of history from a postcolonial perspective. Allen's critique
  directly targets the core of Habermas' alternative to speculative philosophy
  of history — the learning-process model — and argues that it reintroduces
  teleology in a covert form. Essential for any balanced assessment of the
  prospects for Habermas' alternative.

  POSITION: Strong critical counter-position; the most important recent
  challenge to the Habermasian philosophy of history.
  },
  keywords = {postcolonial, Eurocentrism, progress, learning-processes, critical-theory, High, INCOMPLETE, no-abstract}
}

@article{rorty1991habermas,
  author = {Rorty, Richard},
  title = {Habermas and Lyotard on postmodernity},
  booktitle = {Essays on Heidegger and Others},
  year = {1991},
  pages = {164--176},
  doi = {10.1017/CBO9780511609039.011},
  note = {
  CORE ARGUMENT: Rorty intervenes in the Habermas-Lyotard debate to argue
  that both positions are problematic: Habermas' defense of the Enlightenment
  project retains too much of the "philosophy of representation" he claims to
  have overcome, while Lyotard's radical anti-foundationalism offers no basis
  for political solidarity. Rorty's pragmatist alternative — solidarity without
  foundations — challenges both parties and raises the question of whether a
  philosophy of history is necessary for emancipatory politics.

  RELEVANCE: A key triangulation of the Habermas-Lyotard debate from the
  perspective of pragmatism. Rorty's challenge — that Habermas' communicative
  rationality is itself a kind of foundationalism — is one of the most
  persistent objections to Habermas' philosophy of history.

  POSITION: Critical counter-position; introduces pragmatism as a third
  alternative between Habermasian rationalism and postmodern skepticism.
  },
  keywords = {Lyotard, postmodernity, pragmatism, meta-narratives, foundations, High, INCOMPLETE, no-abstract}
}

@book{steuerman2003bounds,
  author = {Steuerman, Emilia},
  title = {The Bounds of Reason: Habermas, Lyotard and Melanie Klein on Rationality},
  year = {2003},
  doi = {10.4324/9780203165669},
  note = {
  CORE ARGUMENT: Steuerman examines the Habermas-Lyotard debate on rationality
  and meta-narratives, bringing Melanie Klein's psychoanalytic theory of reason
  to bear on both positions. She argues that Habermas' universalist account of
  communicative reason and Lyotard's skepticism about meta-narratives both miss
  the psychodynamic dimensions of historical reason — the ways in which the
  constitution of rational subjects involves affective processes that neither
  formal pragmatics nor anti-foundationalist pragmatics can capture.

  RELEVANCE: Provides a novel perspective on the Habermas-Lyotard debate by
  introducing psychoanalytic theory, raising questions about whether Habermas'
  account of historical reason is adequately attentive to the non-rational
  dimensions of social learning.

  POSITION: Critical counter-position; challenges both Habermas and Lyotard
  through a psychoanalytic lens.
  },
  keywords = {Lyotard, meta-narratives, psychoanalysis, rationality, Medium, INCOMPLETE, no-abstract}
}

@article{mendelson1979habermas,
  author = {Mendelson, Jack},
  title = {The Habermas-Gadamer Debate},
  journal = {New German Critique},
  year = {1979},
  number = {18},
  pages = {44},
  doi = {10.2307/487850},
  note = {
  CORE ARGUMENT: Mendelson reconstructs the Habermas-Gadamer debate of the
  late 1960s and early 1970s, focusing on the question of whether hermeneutic
  understanding is inherently conservative or can serve emancipatory ends.
  He argues that Habermas' critique of Gadamer — that the rehabilitation of
  tradition cannot distinguish legitimate from ideologically distorted
  traditions — remains the more defensible position, but that Gadamer's
  insistence on the embeddedness of all critique in tradition poses a genuine
  challenge to Habermas' quasi-transcendental standpoint.

  RELEVANCE: A foundational text for the hermeneutic-communitarian critique
  of Habermas' philosophy of history. The Gadamer-Habermas debate is essential
  context for understanding the limits of the emancipatory orientation that
  Habermas brings to the philosophy of history.

  POSITION: Secondary analysis of the central hermeneutic critique; key for
  understanding the tradition/critique dimension of the reception.
  },
  keywords = {Gadamer, hermeneutics, tradition, ideology-critique, Medium, INCOMPLETE, no-abstract}
}

@article{piercey2004ricoeur,
  author = {Piercey, Robert},
  title = {Ricoeur's Account of Tradition and the Gadamer-Habermas Debate},
  journal = {Human Studies},
  year = {2004},
  volume = {27},
  number = {3},
  pages = {259--280},
  doi = {10.1023/B:HUMA.0000042126.34909.1F},
  note = {
  CORE ARGUMENT: Piercey argues that Ricoeur's hermeneutics offers a mediation
  of the Gadamer-Habermas debate by showing that tradition and critique are
  mutually constitutive rather than opposed. Ricoeur's account of narrative
  identity — in which historical understanding always involves both belonging
  to a tradition and distancing from it — dissolves the sharp opposition
  between Gadamer's rehabilitation of tradition and Habermas' ideology-critique.

  RELEVANCE: Extends the Gadamer-Habermas debate to Ricoeur, introducing
  narrative theory as a resource for the philosophy of history that Habermas'
  own framework does not fully accommodate. Relevant to the prospects for
  Habermas' alternative in dialogue with hermeneutic philosophy of history.

  POSITION: Mediating secondary source; offers a Ricoeurian alternative
  to the Gadamer-Habermas opposition.
  },
  keywords = {Ricoeur, Gadamer, hermeneutics, tradition, narrative, Medium, INCOMPLETE, no-abstract}
}

@book{fraser1998social,
  author = {Fraser, Nancy},
  title = {Social justice in the age of identity politics: redistribution, recognition, and participation},
  year = {1998},
  note = {
  CORE ARGUMENT: Fraser's distinction between redistribution (economic
  justice) and recognition (cultural justice) challenges Habermas' system/
  lifeworld framework, which she argues fails to adequately theorize the
  cultural dimensions of injustice. Her critique of Habermas targets the
  reduction of cultural struggles to "lifeworld" phenomena, arguing that
  this misrepresents the structural character of misrecognition. The paper
  (which later became part of a debate with Honneth) is foundational for
  feminist and critical-race critiques of Habermas' theory of society and
  history.

  RELEVANCE: The most influential feminist critique of the social-theoretic
  infrastructure of Habermas' philosophy of history. Shows how the system/
  lifeworld framework systematically marginalizes struggles that do not fit
  the paradigm of communicative distortion.

  POSITION: Critical counter-position; key feminist and feminist-political
  critique of the framework underlying Habermas' philosophy of history.
  },
  keywords = {Fraser, redistribution, recognition, feminist, lifeworld, High, INCOMPLETE, no-abstract}
}

