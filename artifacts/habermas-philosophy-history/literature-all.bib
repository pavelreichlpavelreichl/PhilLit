  journal = {European Journal of Social Theory},
  year = {2020},
  volume = {24},
  number = {4},
  pages = {507--525},
  doi = {10.1177/1368431020970780},
  note = {
  CORE ARGUMENT: Condon proposes a novel application of Habermas' colonization
  thesis to neoliberalism, arguing that neoliberal rationality represents not
  simply the further colonization of the lifeworld by money and power but a
  "relinguistification" — the penetration of market logic into communicative
  domains in the guise of communicative norms (transparency, accountability,
  performativity). This reframes colonization as a process that operates through
  communication rather than despite it.

  RELEVANCE: Updates the colonization thesis — Habermas' central historical
  diagnosis — for contemporary conditions, showing both the ongoing relevance
  and the need for revision of the system/lifeworld framework. Relevant to
  the contemporary prospects of Habermas' philosophy of history.

  POSITION: Neo-Habermasian application; extends Habermas' historical diagnosis
  to contemporary capitalism.
  },
  keywords = {colonization, neoliberalism, lifeworld, contemporary-application, Medium},
  abstract = {While the critique of neoliberalism, as the form of contemporary capitalism, has been advanced from Marxian and Foucauldian perspectives, it has had limited attention from the perspective of Critical Theory. Largely unrecognized is the suitability of Habermas' colonization thesis to the neoliberal context. This article proposes a reading of neoliberalism as a form of "relinguistification" — the normative colonization of the lifeworld by market rationality — using Habermas' system/lifeworld distinction.},
  abstract_source = {s2},
}

@article{schaefer2013communicative,
  author = {Schaefer, Michael and Heinze, Hans-Jochen},
