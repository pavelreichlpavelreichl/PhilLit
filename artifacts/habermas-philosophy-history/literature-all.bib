  journal = {Teaching in Higher Education},
  year = {2025},
  doi = {10.1080/13562517.2025.2466001},
  note = {
  CORE ARGUMENT: Ahmad argues that Habermas' public statements on the
  Israel-Palestine conflict (2023) reveal that his philosophy of history —
  nominally committed to universalist norms — is in practice applied
  selectively in ways that privilege Western liberal-democratic identity.
  He argues this is not merely a failure of application but reflects
  structural features of Habermas' reconstructive account of modernity,
  which grants normative primacy to the "occidental constellation" at the
  expense of non-Western claims.

  RELEVANCE: A recent and pointed critique of the practical implications of
  Habermas' philosophy of history, connecting the theoretical Eurocentrism
  critique (Allen, postcolonial theory) to concrete political judgments.
  Important for assessing the prospects of Habermas' framework in a
  genuinely global context.

  POSITION: Critical counter-position; charges Habermas with structural
  Eurocentrism with contemporary political implications.
  },
  keywords = {Eurocentrism, postcolonial, Palestine, universalism, contemporary-debate, Medium},
  abstract = {This article argues that Habermas' public statements on Palestine reveal structural features of his philosophy of history: a reconstruction of Western modernity as the normative standard that systematically disadvantages non-Western claims to justice and recognition.},
  abstract_source = {s2},
}

@article{vasterling2014hermeneutic,
  author = {Vasterling, Veronica},
  title = {The Hermeneutic Phenomenological Approach to Plurality: Arendt, Habermas, Derrida},
  year = {2014},
  doi = {10.1163/9789004281820_012},
  note = {
  CORE ARGUMENT: Vasterling compares Habermas' communicative account of
  political plurality with Arendt's and Derrida's approaches, arguing that
  Habermas' proceduralism flattens the political significance of irreducible
  plurality — the fact that communicative actors bring incommensurable
  perspectives that cannot be resolved through discourse alone. She argues
  for a phenomenological account of plurality that preserves what is lost
  in Habermas' proceduralist reduction.

  RELEVANCE: Extends the critique of Habermas' philosophy of history from a
  phenomenological direction, showing how the Habermas-Arendt-Derrida triangle
  generates competing accounts of historical plurality and political agency.

  POSITION: Critical counter-position; phenomenological critique of the
  proceduralism underlying Habermas' philosophy of history.
  },
  keywords = {Arendt, Derrida, plurality, phenomenology, proceduralism, Medium, INCOMPLETE, no-abstract}
}

