  year = {2023},
  note = {
  CORE ARGUMENT: The first volume of Habermas' late magnum opus reconstructs
  the history of Western philosophy from the Greek axial age through early
  modernity as a learning process oriented toward "rational freedom." Habermas
  argues that the encounter between Greek philosophy and the Abrahamic
  religions produced a unique constellation of faith and knowledge that
  generated the conceptual resources for communicative reason. The "occidental"
  trajectory is not presented as the only path but as the historically specific
  source of the normative resources Habermas defends.

  RELEVANCE: This is Habermas' most sustained and explicit contribution to the
  philosophy of history — an account of how communicative reason emerged
  historically and what normative resources that history provides. It is the
  culmination of his attempt to articulate a non-speculative philosophy of
  history grounded in reconstructive method.

  POSITION: Core primary source; the culmination of Habermas' philosophy of
  history. Essential for understanding his late position on the normative
  content of historical learning processes.
  },
  keywords = {Auch-eine-Geschichte, faith-knowledge, learning-processes, rational-freedom, High, INCOMPLETE, no-abstract}
}

@book{habermas2001postnational,
