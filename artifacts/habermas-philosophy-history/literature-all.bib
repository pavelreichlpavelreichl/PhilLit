  number = {5},
  pages = {e65111},
  doi = {10.1371/journal.pone.0065111},
  note = {
  CORE ARGUMENT: Schaefer and Heinze test Habermas' distinction between
  communicative rationality (oriented to mutual understanding) and strategic
  rationality (oriented to individual success) using neuroscientific methods.
  They find experimental evidence that subjects activate different neural
  systems depending on whether they are engaged in cooperative communication or
  strategic interaction, providing an indirect empirical corroboration of
  Habermas' fundamental distinction.

  RELEVANCE: Although peripheral to the philosophical dimensions of Habermas'
  philosophy of history, this paper is relevant to the claim that the
  communicative/strategic distinction is more than a normative postulate —
  it has empirical grounding in human social cognition.

  POSITION: Peripheral empirical support; shows the formal distinction between
  communicative and strategic action has empirical correlates.
  },
  keywords = {communicative-action, strategic-rationality, neuroscience, Low},
  abstract = {In the philosophical theory of communicative action, rationality refers to interpersonal communication rather than to a knowing subject. Thus, a social view of rationality is suggested. The theory differentiates between two kinds of rationality, the communicative rationality (focusing on reaching understanding) and the strategic rationality (focusing on reaching a goal). Experimental evidence shows that these two types of rationality engage different neural systems in the human brain.},
  abstract_source = {s2},
}

@book{habermas1987pdm,
  author = {Habermas, Jürgen},
  title = {The Philosophical Discourse of Modernity: Twelve Lectures},
  year = {1987},
  note = {
  CORE ARGUMENT: In Lectures 1 and 2 Habermas traces the "discourse of
  modernity" from Hegel's first formulations through Nietzsche, Heidegger,
  Bataille, Derrida, and Foucault, arguing that each represents a failed
  attempt to exit modernity while remaining within its self-understanding as
  "a new age" that must find its normativity from itself. The book defends
  the thesis that modernity is an unfinished rather than exhausted project,
  and that the postmodern exit is premature.

  RELEVANCE: The fullest statement of Habermas' theory of modernity as an
  unfinished project, situated against postmodernist alternatives. Central
  to understanding both his historical diagnosis and his normative claims.

  POSITION: Core primary source (see also Domain 2 entry habermas1987philosophical).
  },
  keywords = {modernity, unfinished-project, postmodernism, Enlightenment, High, INCOMPLETE, no-abstract}
}

@incollection{habermas2001modernity,
