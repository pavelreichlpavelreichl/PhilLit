@book{habermas1992postmetaphysical,
  author = {Habermas, Jürgen},
  title = {Postmetaphysical Thinking: Philosophical Essays},
  year = {1992},
  note = {
  CORE ARGUMENT: This collection develops Habermas' concept of "postmetaphysical
  thinking" — philosophy after the death of speculative metaphysics. He argues
  that philosophy must relinquish the claim to be an architectonic science
  that grounds all other disciplines, accepting the finitude of reason,
  fallibilism, and the turn to ordinary language and communicative practice.
  The essays develop the implications of this stance for the philosophy of
  history: the latter cannot be a speculative account of the logic of history
  but must be a reconstructive analysis of the normative structures implicit
  in communicative practice.

  RELEVANCE: The key theoretical statement of Habermas' methodological stance
  vis-à-vis speculative philosophy of history: what "postmetaphysical thinking"
  requires of any legitimate successor to the philosophical tradition.

  POSITION: Primary source; foundational for understanding the methodological
  commitments that underpin Habermas' critique of speculative philosophy
  of history as a whole.
  },
  keywords = {postmetaphysical-thinking, philosophy-subject, fallibilism, reconstructive-method, High, INCOMPLETE, no-abstract}
}
