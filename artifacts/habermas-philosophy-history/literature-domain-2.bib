@article{cooke2014limits,
  author = {Cooke, Maeve},
  title = {The Limits of Learning: Habermas' Social Theory and Religion},
  journal = {European Journal of Philosophy},
  year = {2014},
  volume = {24},
  number = {3},
  pages = {694--711},
  doi = {10.1111/EJOP.12099},
  note = {
  CORE ARGUMENT: Cooke examines how Habermas' social evolution theory — with
  its learning-process model — handles the role of religion in historical
  development. She argues that Habermas' account of learning processes is
  insufficiently sensitive to the cognitive content of religious traditions,
  and that this reveals a structural limitation in his reconstructive account
  of history: it cannot adequately explain transformations of meaning that do
  not take the form of cognitive problem-solving.

  RELEVANCE: Illuminates a critical dimension of Habermas' alternative to
  speculative philosophy of history — the learning model — and identifies
  where it may not improve on the traditions it criticizes, particularly in
  handling non-secular historical agents.

  POSITION: Critical secondary source; relevant to the assessment of
  Habermas' anti-teleological alternative and its limitations.
  },
  keywords = {social-evolution, learning-processes, religion, critique, Medium, INCOMPLETE, no-abstract}
}

@article{freyenhagen2023linguistic,
  author = {Freyenhagen, Fabian},
  title = {The Linguistic Turn in the Early Frankfurt School: Horkheimer and Adorno},
  journal = {Journal of the History of Philosophy},
  year = {2023},
  volume = {61},
  number = {1},
  pages = {127--148},
  doi = {10.1353/hph.2023.0005},
  note = {
  CORE ARGUMENT: Freyenhagen argues that Horkheimer and Adorno anticipated a
  "linguistic turn" in critical theory before Habermas' communicative reorientation,
  drawing on later Wittgenstein. He challenges the standard narrative in which
  Habermas introduces language and communication into a first-generation Frankfurt
  School that had no resources for it, suggesting instead that the transition to
  Habermas involves continuity as well as rupture.

  RELEVANCE: Refines understanding of Habermas' critique of the Frankfurt School
  as a philosophy of history, complicating the idea that communicative reason
  is a wholly new departure from the tradition Habermas inherited.

  POSITION: Revisionist secondary analysis; challenges Habermas' self-presentation
  as inaugurating a new paradigm through his critique of Adorno and Horkheimer.
  },
  keywords = {Frankfurt-School, Horkheimer, Adorno, language, communicative-reason, Medium},
  abstract = {abstract:Was there a linguistic turn in Frankfurt School Critical Theory before Habermas's communications-theoretic one? Might later Wittgenstein and the early Frankfurt School have adopted similar pictures of language? I propose that both questions should be answered affirmatively, focusing on Horkheimer's Eclipse of Reason. I argue that, thanks to the picture of language that Horkheimer and Adorno adopted, they were able to approach Habermas's communications-theoretic account in key ways},
  abstract_source = {s2},
}

