@book{habermas1993justification,
  author = {Habermas, Jürgen},
  title = {Justification and Application: Remarks on Discourse Ethics},
  year = {1993},
  note = {
  CORE ARGUMENT: Habermas clarifies and defends discourse ethics against
  critiques, distinguishing the justification of moral norms (a matter of
  universal discourse) from their application (a matter of context-sensitive
  judgment). He responds to objections about the monological character of
  Kantian ethics, the alleged formalism of proceduralist ethics, and the
  relationship between discourse ethics and moral progress. The essays also
  clarify the relationship between discourse ethics and Habermas' broader
  social theory.

  RELEVANCE: Directly relevant to the question of how Habermas' philosophy
  of history avoids teleology while still making claims about moral progress.
  Discourse ethics provides the normative standard against which historical
  progress can be measured without presupposing a fixed end-state.

  POSITION: Primary source; clarifies the normative dimension of Habermas'
  philosophy of history and its relationship to moral theory.
  },
  keywords = {discourse-ethics, moral-norms, justification, application, High, INCOMPLETE, no-abstract}
}

