@book{kervegan2018actual,
  author = {Kervégan, Jean-François and Ginsburg, Daniela and Shuster, Martin},
  title = {The Actual and the Rational: Hegel and Objective Spirit},
  year = {2018},
  publisher = {University of Chicago Press},
  doi = {10.7208/chicago/9780226023946.001.0001},
  abstract = {As its title implies, Jean-François Kervégan's book is a comprehensive and systematic reconstruction of Hegel's complex doctrine of objective spirit. It is comprehensive because it aims to explain the whole of that doctrine as set out in the Philosophy of Right, and it is systematic because, unlike many recent accounts of objective spirit, Kervégan refuses to read that text in abstraction from the rest of Hegel's system, within which the Science of Logic occupies pride of place. Kervégan takes a strong position on this issue: "the doctrine of objective spirit, like every part of the system, rests not only on the 'spirit' of the logic but on its letter." An example of this approach is Kervégan's claim that Hegel's equation of the rational with the actual can avoid the dilemma of being either tautological or fanatically rationalist only by re-examining the meaning of Wirklichkeit as deduced in the Logic. There is, however, a certain ambiguity, as Kervégan recognizes, in emphasizing the importance of reading the Philosophy of Right in relation to the system -- and hence to Hegel's metaphysics -- since it is unclear whether we should equate his metaphysics with the Logic or with the entire doctrine of Absolute Spirit. Another distinctive feature of Kervégan's book is that it affirms the significance of "abstract law" (abstract right) in the doctrine of objective spirit, emphasizing not the limits of abstract right but the positive role it plays in the rational social order and hence in realizing practical freedom, combating a familiar picture of Hegel as an antilegalist that remains popular in certain strands of left-Hegelian Frankfurt School critical theory.},
  abstract_source = {ndpr},
  note = {
  CORE ARGUMENT: Per the NDPR review of the book, Kervégan offers a comprehensive and systematic reconstruction of Hegel's doctrine of objective spirit that refuses to read the Philosophy of Right apart from the rest of the system, arguing that objective spirit "rests not only on the 'spirit' of the logic but on its letter": Hegel's equation of the rational with the actual can escape the charge of tautology or fanatical rationalism only by re-examining Wirklichkeit as deduced in the Logic. The book also defends the positive, freedom-enabling role of "abstract right" against readings of Hegel as an antilegalist.

  RELEVANCE: Provides the fullest systematic treatment of Objective Spirit found in this search, the sphere within which Philosophy of Right §§341-360 (world history as the transition out of Objective Spirit) is located; its central claim that objective spirit cannot be read independently of the Logic directly supports this domain's contention that the philosophy of history likewise depends on Logic-derived categories (see Sedgwick 2016; Yang and Yeomans 2023).

  POSITION: A systematic, Logic-grounded reconstruction of Objective Spirit, opposed both to readings that treat the Philosophy of Right independently of Hegel's metaphysics and to the "antilegalist" reading of Hegel associated with left-Hegelian critical theory.
  },
  keywords = {objective-spirit, systematic-location, philosophy-of-right, High}
}

@article{oehl2018spirits,
  author = {Oehl, Thomas},
  title = {Spirit's Self-Knowledge, History, and the Absolute},
  journal = {Revista Eletrônica Estudos Hegelianos},
  year = {2018},
  volume = {15},
  number = {25},
  doi = {10.70244/reh.v15i25.312},
  abstract = {The paper offers an answer to John McDowell's question of why it matters to Hegel that Geist has a history. Spirit's content is revelation (Enc. § 383), and spirit realizes itself as what it is – revelation – by unfolding into two dimensions: a finite and an infinite subject. The infinite subject successively gives new forms of thinking to the finite subject, and this succession is history. This is shown more concretely with regard to the historical development of (philosophical) conceptions of self-consciousness from Descartes via Kant to Hegel. From this an overall picture of Hegel's philosophy of spirit emerges through which its culmination in absolute spirit and, in particular, religion becomes conceivable and according to which there is a leap between Hegel's philosophy and the pagan world. Thus, the paper is directed against two widespread tendencies in current readings of Hegel: the tendency to cut off or downplay absolute spirit in favor of subjective and objective spirit, and the tendency to assimilate Hegel's philosophy of spirit to Aristotle's philosophy of soul and life.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Oehl argues that history matters to Hegel because spirit's content is revelation (Encyclopedia §383), and spirit realizes this content by unfolding into finite and infinite subjects whose successive relation constitutes history; he traces this through the historical development of conceptions of self-consciousness from Descartes to Hegel, culminating in Absolute Spirit and especially religion.

  RELEVANCE: Directly addresses the domain's question of how the philosophy of history relates systematically to Absolute Spirit, arguing against readings that downplay Absolute Spirit relative to Objective and Subjective Spirit, and against assimilating Hegel's philosophy of spirit to Aristotelian psychology.

  POSITION: Argues for the systematic centrality of Absolute Spirit (and thus of history as its vehicle) against deflationary readings of Hegel's philosophy of spirit.
  },
  keywords = {absolute-spirit, systematic-location, encyclopedia, High}
}

@article{alznauer2021review,
  author = {Alznauer, M.},
  title = {Martina F. Bykova (ed). Hegel's Philosophy of Spirit: A Critical Guide. Cambridge: Cambridge University Press, 2019},
  journal = {Hegel Bulletin},
  year = {2021},
  volume = {42},
  number = {2},
  pages = {309--312},
  doi = {10.1017/hgl.2021.4},
  abstract = {To accommodate the numerous changes Hegel made to his Encyclopedia of the Philosophical Sciences after it was published, as well as remarks gathered from the lecture notes of his students, the Encyclopedia was posthumously broken up into three separate books each corresponding to one of its major parts—logic, nature and spirit. This critical guide, edited by Marina F. Bykova, attempts to renew attention to the systematic presentation of Geist in the third of these books, the Encyclopedia Philosophy of Spirit. There is no question that Encyclopedia Philosophy of Spirit covers many topics of deep interest in contemporary philosophy. Under the aegis of 'subjective spirit', we find the most detailed presentation of Hegel's mature philosophy of mind. The abbreviated but substantive treatment of 'objective spirit' adds to our understanding of his social and political philosophy. And although the treatment of art, religion and philosophy in 'absolute spirit' is quite sketchy compared to the lectures he gave on these topics, it is the only place where we see this crucial notion treated in its proper context, as the culmination of spirit's attempt to know itself.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Reviewing Bykova's edited critical guide, Alznauer explains that the Encyclopedia's Philosophy of Spirit alone presents subjective, objective, and absolute spirit within a single systematic unit and proper sequence, even though objective spirit's Encyclopedia treatment is abbreviated relative to the Philosophy of Right and absolute spirit's is sketchy relative to the separate lecture series on art, religion, and philosophy; Bykova's volume aims to counter a scholarly tendency to study these topics outside their Encyclopedia context.

  RELEVANCE: Explains exactly why the Encyclopedia §§548-552 transition matters for systematic location: it is the only place objective and absolute spirit (and hence world history's position between them) are presented in their proper architectonic sequence, even though the fuller elaborations appear elsewhere (Philosophy of Right, Lectures on world history/aesthetics/religion/history of philosophy).

  POSITION: Endorses reading objective and absolute spirit (and by extension the philosophy of history) within their Encyclopedia sequence rather than treating the Philosophy of Right and the various lecture series as self-standing.
  },
  keywords = {encyclopedia, objective-spirit, absolute-spirit, systematic-location, Medium}
}

@incollection{delaurentiis2005philosophy,
  author = {de Laurentiis, Allegra},
  title = {A Philosophy of the History of Philosophy},
  booktitle = {Subjects in the Ancient and Modern World},
  year = {2005},
  pages = {13--38},
  publisher = {Palgrave Macmillan UK},
  doi = {10.1057/9780230509443_2},
  abstract = {Philosophic concepts are incomprehensible unless the history of their formation is included in the investigation of their meaning. This thesis can be generalized to include the whole of the philosophical enterprise: rational philosophizing is only possible on the basis of a rational reconstruction of the history of philosophy.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: De Laurentiis reconstructs Hegel's thesis that philosophical concepts cannot be understood apart from the history of their formation, generalizing this into the claim that rational philosophizing as such depends on a rational reconstruction of the history of philosophy.

  RELEVANCE: Complements the domain's focus on world-history lectures by addressing the companion Lectures on the History of Philosophy, which occupy an analogous systematic position (bridging Objective and Absolute Spirit) and raise parallel questions about how Hegel's own conceptual apparatus governs his narration of a historical sequence.

  POSITION: Treats Hegel's history of philosophy as methodologically continuous with, rather than merely descriptive of, systematic philosophy.
  },
  keywords = {history-of-philosophy, systematic-location, Medium}
}

@incollection{sedgwick2016remarks,
  author = {Sedgwick, Sally},
  title = {Remarks on History, Contingency, and Necessity in Hegel's Logic},
  booktitle = {Hegel on Philosophy in History},
  year = {2016},
  pages = {33--49},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781316145012.003},
  note = {
  CORE ARGUMENT: [No abstract available from queried sources.] Sedgwick examines how the categories of contingency and necessity, as developed in Hegel's Science of Logic, bear on the status of historical events and processes discussed in the philosophy of history.

  RELEVANCE: Directly targets the domain's question of how the Logic's categories of necessity structure the philosophy of history, appearing in an edited volume (Hegel on Philosophy in History) explicitly devoted to this systematic connection.

  POSITION: Represents the view that the philosophy of history's key concepts (necessity, contingency) must be interpreted through the logical categories Hegel develops independently in the Science of Logic, rather than as sui generis historiographical concepts.
  },
  keywords = {science-of-logic, necessity, contingency, systematic-location, High, INCOMPLETE, no-abstract}
}

@book{rojek2017hegels,
  author = {Rojek, Tim},
  title = {Hegels Begriff der Weltgeschichte},
  year = {2017},
  publisher = {De Gruyter},
  doi = {10.1515/9783110502343},
  abstract = {For the first time this volume reconstructs Hegel's philosophy of history from the perspective of the philosophy of science (in a broad sense, i.e. including humanities). The volume focuses on the relationship between historiography and the philosophy of history. The analysis of this relationship provides the foundation for the reconstruction of the philosophy of history as a conceptual history of "freedom".},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Rojek reconstructs Hegel's concept of world history from a philosophy-of-science perspective (broadly construed to include the humanities), analyzing the relationship between historiography (Geschichtsschreibung) and philosophy of history, and on this basis reinterprets Hegel's philosophy of history as a conceptual history of freedom.

  RELEVANCE: Offers a methodological framework for the domain's systematic-location questions by treating Hegel's philosophy of history as answerable to standards drawn from philosophy of science/historiography rather than treating it as free-standing metaphysical speculation; reviewed in Hegel Bulletin by Eric Michael Dale (2019, doi 10.1017/hgl.2019.3).

  POSITION: A "Wissenschaftstheoretische" (philosophy-of-science) reading of Hegel's philosophy of history, distinct from purely metaphysical or purely historiographical approaches.
  },
  keywords = {methodology, historiography, freedom, systematic-location, High}
}

@book{mccarney2012routledge,
  author = {Mccarney, Joseph},
  title = {Routledge Philosophy Guidebook to Hegel on History},
  year = {2012},
  publisher = {Routledge},
  doi = {10.4324/9780203136737},
  abstract = {Hegel's Introduction to the Philosophy of History remains one of the most profound and influential books on the philosophy of history. In clear and cogent terms this book:* examines the ideas and arguments of the Introduction to the Philosophy of History* explains key concepts of Hegel's system, a knowledge of which is essential for fully understanding his philosophy of history* assesses the continuing relevance of Hegel to the contemporary debate about the nature of history.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: McCarney's guidebook works systematically through the ideas and arguments of the Introduction to the Philosophy of History, explicating the system-level concepts (freedom, reason, spirit) needed to understand it and assessing its continuing relevance to contemporary philosophy of history.

  RELEVANCE: Functions as the standard English-language guidebook-level overview of the text this domain is centrally concerned with, explicitly linking the Introduction's arguments to "key concepts of Hegel's system" — i.e., precisely the systematic-location question posed by this domain.

  POSITION: A synthetic, textbook-level overview rather than an original interpretive intervention; useful as the entry point against which more specialized studies (Kervégan, Rojek, Sedgwick) can be read.
  },
  keywords = {overview, guidebook, introduction-to-philosophy-of-history, High}
}

@article{pinkard2025sedgwick,
  author = {Pinkard, Terry},
  title = {On Sally Sedgwick, Time and History in Hegelian Thought and Spirit},
  journal = {Hegel Bulletin},
  year = {2025},
  volume = {46},
  number = {3},
  pages = {603--612},
  doi = {10.1017/hgl.2025.10063},
  abstract = {Sally Sedgwick seems to be incapable of writing dull books, and she has once again given proof of this. She has written a short but very ambitious book, nominally on Hegel's philosophy of history, but really about Hegel in general and how we should understand him. Her idea is that Hegel's philosophy of history is a special entry point to Hegel's thought as a whole so that instead of Hegel-the-philosopher-of-the-necessary-Absolute, we should see Hegel as fundamentally a philosopher of finitude, a proponent of the contingency and historical situatedness of all of our thoughts, who, as a philosopher of finite humility, did not think that we could ever assume the viewpoint of God as he is sometimes alleged to have tried to do.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Reviewing Sedgwick's 2025 book, Pinkard reports her central claim that Hegel's philosophy of history functions as a special entry point into his thought as a whole, supporting a revisionist picture of Hegel as a philosopher of finitude and historical contingency rather than as a philosopher who claims access to a necessary, God's-eye Absolute.

  RELEVANCE: Demonstrates that treating the philosophy of history as systematically privileged (rather than as one region of the system among others) is itself an actively contested interpretive strategy in the most recent literature (2025), directly bearing on this domain's systematic-location question.

  POSITION: Reports and largely endorses a "finitist"/contingency-emphasizing reading of Hegel that uses the philosophy of history to push back against necessitarian, Absolute-centered interpretations.
  },
  keywords = {reception, necessity, contingency, systematic-location, Medium}
}

@misc{chetelat2009hegels,
    author = "Chételat, Pierre",
    title = "Hegel's Philosophy of World History as Theodicy",
    year = "2009",
    note = {CORE ARGUMENT: Chételat examines Hegel's explicit characterization of the philosophy of world history as a theodicy -- a "justification of the ways of God" -- and asks how this framing bears on Hegel's treatment of evil and freedom in history. He situates Hegel's theodicy language against the Leibnizian tradition it explicitly answers. RELEVANCE: Provides a dedicated, focused treatment of exactly the theodicy question this domain's brief asks about (does theodicy language commit Hegel to theological determinism), making it a central reference point for the theodicy/providence debate. POSITION: Reads Hegel's theodicy as engaging seriously with the problem of evil in a way not reducible to either pure theology or pure secular optimism.},
    keywords = "theodicy, evil, freedom, cunning-of-reason, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{ahlers2000history,
    author = "Ahlers, Rolf",
    title = "History and Philosophy as Theodicy: On World History as the World's Judgment",
    year = "2000",
    volume = "30",
    note = {CORE ARGUMENT: Ahlers takes up Hegel's dictum that "world history is the world's court of judgment" (Weltgeschichte ist das Weltgericht) as the key to understanding history-as-theodicy, arguing that judgment and justification are internally linked in Hegel's conception rather than externally imposed by a providential deity standing outside the historical process. RELEVANCE: Directly addresses whether Hegel's theodicy language entails a providential/theological metaphysics, arguing for a reading where judgment is immanent to the historical process itself rather than externally adjudicated -- central to this domain's third key question. POSITION: Immanent/rationalist reading of theodicy as self-judgment of history rather than external divine verdict.},
    keywords = "theodicy, providence, judgment, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Etude de la conception de l'histoire universelle comme jugement du monde developpee par Hegel dans les cours de Heidelberg et les cours de Berlin. A la rencontre de l'abstrait et du concret, l'A. interprete la philosophie hegelienne de l'histoire dans le sens d'une theodicee illustree par la raison dans l'histoire.",
    abstract_source = "openalex"
}

@misc{amengual2015philosophy,
    author = "Amengual, Gabriel",
    title = "Philosophy of History as Theodicy",
    year = "2015",
    volume = "5",
    note = "CORE ARGUMENT: Taking Adorno's critique of Hegel's philosophy of history as its point of departure, this paper argues that Hegel's treatment of pain and the negative in history marked a genuine turning point in the philosophy of history, since he explicitly framed the discipline as theodicy. Amengual argues that Hegel's theodical intention, unlike Leibniz's abstract metaphysical theodicy, was not actually fulfilled within the philosophy of history itself (which only supplies a framework of meaning for action) but rather in absolute spirit, via Hegel's account of Christianity, incarnation, and Christ's death. RELEVANCE: Offers a precise account of how Hegel's theodicy both continues and departs from the Leibnizian model referenced in this domain's brief, and locates the actual resolution of theodicy outside the philosophy of history proper -- a distinctive and citable position on the metaphysics-vs-retrospective-device question. POSITION: Theodicy as an unfulfilled promise within the philosophy of history, completed only at the level of absolute spirit/religion.",
    keywords = "theodicy, evil, Leibniz, Adorno, absolute-spirit, High, METADATA\\_CLEANED: journal, pages, type:@article->@misc",
    abstract = "Taking Adornos critique of Hegels Philosophy of History as point of abstract\\_source = {core}, departure, this paper: (1) sketches the general outlines of the modern Philosophy of History in order to (2) spotlight their commonalities and differences. Hegels Philosophy of History (3) can be described by considering pain and the negative. It highlights these topics in a way that had never been done before, so it became a turning point, as revealed by the fact that he treated the Philosophy of History as theodicy. Despite his initial intention of carrying out theodicy, which Leibniz depicted in a metaphysical and abstract way, in the specific field of history, this intention was realised not in the Philosophy of History (it only conceptualises theodicy as viewed as a framework of meaning for action) but instead in the absolute spirit, in his reference to Christianity and specifically to incarnation and Christ's death"
}

@article{drydyk1985who,
    author = "Drydyk, J. J.",
    title = {Who Is Fooled by the "Cunning of Reason"?},
    journal = "History and Theory",
    year = "1985",
    volume = "24",
    number = "2",
    note = "CORE ARGUMENT: Drydyk critically interrogates Hegel's cunning-of-reason metaphor, asking who exactly is deceived when reason uses individual passions as its instrument -- the historical agents themselves, the philosophical observer, or neither. He probes whether the metaphor can bear the explanatory weight Hegel places on it without collapsing into either vacuity or an implausibly strong metaphysical claim about reason's agency. RELEVANCE: A sustained critical examination of exactly the mechanism this domain's brief asks about, directly interrogating whether the cunning of reason is a substantive explanatory device or a rhetorical gesture masking explanatory gaps. POSITION: Skeptical/critical reading that presses on the coherence of the cunning-of-reason device rather than simply expounding it.",
    keywords = "cunning-of-reason, List-der-Vernunft, methodology, High, METADATA\\_CLEANED: pages, doi",
    abstract = "To Hegel's supporters, the of reason is in various ways a source of embarrassment. In my view, some reasons for this embarrassment are less enlightening than others. What enlightens me least is the belief evinced by some Hegel interpreters that there is no coherent model of how the of reason might work. A foray into Hegelian metaphysics enables us to dismiss these difficulties. In doing so, we free ourselves to evaluate Hegel's theory in terms of a larger problem, which has been with us at least since the Enlightenment.1 The issue I have in mind is whether one is obliged or even able to invoke history in support of progressive politics. That is, no matter what I recommend as progress, am I not obligated to show that it is humanly achievable? If so, should I not expect to find evidence for its achievability somewhere in the historical record? Hegel did not answer these questions consistently, and the deeper one delves into the metaphysics behind the cunning of reason, the clearer this inconsistency becomes.",
    abstract_source = "openalex"
}

@article{parkinson1989hegel,
    author = "Parkinson, G. H. R.",
    title = "Hegel, Marx and the Cunning of Reason",
    journal = "Philosophy",
    year = "1989",
    note = "CORE ARGUMENT: Parkinson compares Hegel's and Marx's theories of history through the lens of the cunning of reason, arguing that Marx's materialist inversion of Hegel retains a structurally similar device (individuals pursuing particular interests unwittingly advance a universal historical process) even while rejecting Hegel's idealist metaphysics of Spirit. RELEVANCE: Clarifies what is distinctively metaphysical (vs. structurally reusable) in Hegel's cunning-of-reason argument by tracing its afterlife in Marx, helping to isolate whether the device requires Hegel's theological/idealist apparatus or admits of a naturalistic reconstruction. POSITION: Structural continuity between Hegel's idealist and Marx's materialist versions of the cunning-of-reason mechanism, suggesting the device is separable from Hegel's theology.",
    keywords = "cunning-of-reason, Marx, materialism, comparative, High, METADATA\\_CLEANED: volume, number, pages, doi",
    abstract = "This paper is concerned with two theories of history—those of Hegel and of Marx. Its primary aim is to clarify. The writings of Hegel are notoriously obscure, and those of Marx have been variously interpreted, so there is room for a paper which tries to ensure that when the theories of history propounded by Marx and Hegel are criticized, what are criticized are views which they actually held. It is no part of this paper's thesis that, in his theory of history, Marx consciously borrowed from Hegel. But it will be argued that there is more of Hegel in Marx than is sometimes supposed, and that if this fact is ignored one seriously distorts Marx.",
    abstract_source = "openalex"
}

@article{jaeschke2008die,
    author = "Jaeschke, Walter",
    title = "Die List der Vernunft",
    journal = "Hegel-Studien",
    year = "2008",
    volume = "43",
    note = {CORE ARGUMENT: Jaeschke provides a philologically grounded reconstruction of the "List der Vernunft" (cunning of reason) as a technical term within Hegel's system, tracing its precise formulations across Hegel's lectures and situating it in relation to Hegel's broader logic of teleology and the concept. RELEVANCE: A dedicated, source-critical treatment of the exact German term this domain's brief highlights, offering the most systematically careful account of what "cunning of reason" technically means within Hegel's philosophical vocabulary as opposed to its looser popular usage. POSITION: Careful textual/systematic reconstruction rather than either strong defense or dismissal of the concept.},
    keywords = "cunning-of-reason, List-der-Vernunft, textual-scholarship, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: pages"
}

@article{marmasse2017die,
    author = "Marmasse, Gilles",
    title = "Die List in der Geschichte bei Kant und Hegel",
    journal = "Hegel-Jahrbuch",
    year = "2017",
    volume = "2017",
    number = "1",
    note = {CORE ARGUMENT: Marmasse directly compares the "cunning" (List) of nature/reason in Kant and in Hegel, examining how Hegel's cunning of reason both draws on and transforms Kant's earlier idea (in the Idea for a Universal History) that nature uses human antagonism and unsocial sociability to advance a hidden plan for humanity. RELEVANCE: This is the most direct extant treatment of the specific Kant-Hegel genealogy this domain's brief asks about (cunning of reason and unsocial sociability), making it essential for tracing how much of Kant's regulative, agnostic framing survives Hegel's constitutive metaphysical claim. POSITION: Traces continuity and transformation between Kant's regulative "cunning of nature" and Hegel's constitutive "cunning of reason."},
    keywords = "cunning-of-reason, Kant, unsocial-sociability, comparative, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: pages, doi"
}

@misc{requejovalls2007somos,
    author = "Requejo, Ferrán and Valls, Ramón",
    title = "Somos conflictivos, pero... Actualidad de la tesis de Kant sobre la insociable sociabilidad de los humanos y su prolongación por parte de Hegel",
    year = "2007",
    note = {CORE ARGUMENT: Requejo and Valls examine the continued relevance of Kant's thesis of "unsocial sociability" -- that humans' very antagonism drives social and historical progress -- and trace how Hegel extends and transforms this Kantian thesis in his own philosophy of history. RELEVANCE: Directly addresses the domain brief's question of how the cunning of reason relates to Kantian unsocial sociability, providing a sustained comparative account of the "prolongation" (continuation/extension) of Kant's thesis in Hegel. POSITION: Continuity thesis -- Hegel's cunning of reason is best understood as an extension of Kant's unsocial sociability rather than a wholly novel theological device.},
    keywords = "unsocial-sociability, Kant, cunning-of-reason, comparative, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "In this paper we address Kant’s thesis of human beings’ unsocial sociability and a number of related themes such as perpetual peace, cosmopolitanism and patriotism and how this thesis was extended by Hegel. We consider Kant’s thesis to be a more suitable framework with which to observe modern- day reality than that offered by many of the political and social theories that are currently in use. Although there is no doubt that Kant was a moral philosopher, this thesis shows a certain degree of distrust of mere moral imperatives. The latter are, on their own, ineffective for «humanizing humanity». Today we know that rationality expressed through language is what distinguishes us as a species. However, it is likely that this is not what constitutes us as individuals of this species. Unsocial sociability works well as a conceptual framework with which to address the current difficulties facing democracies, in both the international sphere and in the sphere of their internal pluralism of a cultural and, in some cases, a national, nature. Kant and Hegel are philosophers of History because both offer ways to overcome many conflicts through politics. From a contemporary perspective, unsocial sociability is a concept which complements —in an individual dimension (Kant) as well as in a socio-political dimension (Hegel)— what is an unavoidable feature of the contemporary world: the pluralism of values, interests and identities, which are usually agonistic in nature, and which are endowed with emotional components.",
    abstract_source = "s2"
}

@misc{james2021practical,
    author = "James, David",
    title = "Practical Necessity, Ethical Freedom, and History",
    year = "2021",
    abstract = "It is explained how the conceptual order of Hegel's system of right concerns the actualization of 'ethical' freedom, which consists in self-determination and self-constraint. Practical necessity plays a key role in explaining not only how agents come to exercise and thereby develop their capacity for ethical freedom, but also how they act in accordance with a normative necessity whose sources are the social and institutional conditions of this form of freedom. This is shown to explain how freedom and necessity are reconciled in Hegel's theory of ethical life. I argue that ethical freedom is, however, prematurely displaced by a negative idea of freedom that has expansionary implications, despite how this 'global' freedom becomes explicit only later in Hegel's account of world history. I explore the tension between ethical freedom and global freedom in connection with Hegel's claims concerning the essentially progressive character of world history.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: James argues that Hegel's account of world history reconciles freedom and necessity via "practical necessity" -- the normative necessity grounded in social and institutional conditions through which agents develop ethical freedom -- but that this ethical freedom is later displaced by a more expansive, negative conception of "global" freedom that drives the progressive character of world history. RELEVANCE: Directly engages the necessity/freedom axis of this domain's teleology debate, showing how Hegel's supposedly progressive, rational world-historical necessity is internally in tension with the more local, ethical necessity operative in Sittlichkeit -- complicating any simple "robust metaphysical necessity" reading. POSITION: Identifies an internal tension between ethical (local, institutional) necessity and global (world-historical, progressive) necessity in Hegel's account, rather than treating "reason governs history" as a single unified claim.},
    keywords = "necessity, freedom, ethical-life, progress, High, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@book{rosen2022shadow,
    author = "Rosen, Michael",
    title = "The Shadow of God: Kant, Hegel, and the Passage from Heaven to History",
    year = "2022",
    publisher = "Harvard University Press",
    doi = "10.4159/9780674276055",
    note = {CORE ARGUMENT: Rosen traces the secularization of theological ideas -- providence, judgment, redemption -- as they pass from Kant's philosophy of history into Hegel's, arguing that central features of Hegel's account of history (including the cunning of reason and the theodicy framing) are transformations of Christian theological concepts rather than either straightforward theology or a fully secular rationalism. RELEVANCE: Provides the fullest book-length treatment of the Kant-to-Hegel genealogy of providential/theological language in the philosophy of history, directly bearing on this domain's third key question of whether Hegel's theodicy commits him to theological determinism, and situating the cunning of reason within this broader "passage from heaven to history." POSITION: Genealogical/secularization thesis -- Hegel's philosophy of history retains a theological "shadow" even as it purports to be a rational, this-worldly account.},
    keywords = "theodicy, providence, secularization, Kant, theology, High",
    abstract = "A bold and beautifully written exploration of the “afterlife” of God, showing how apparently secular habits of mind in fact retain the structure of religious thought. Once in the West, our lives were bounded by religion. Then we were guided out of the darkness of faith, we are often told, by the cold light of science and reason. To be modern was to reject the religious for the secular and rational. In a bold retelling of philosophical history, Michael Rosen explains the limits of this story, showing that many modern and apparently secular ideas were in fact profoundly shaped by religion. The key thinkers, Rosen argues, were the German Idealists, as they sought to reconcile faith and reason. It was central to Kant’s philosophy that, if God is both just and assigns us to heaven or hell for eternity, we must know what is required of us and be able to choose freely. As we thus pursue the moral law, Kant argued, we are engaged in a collective enterprise as members of a “Church invisible” working together to achieve justice in history. As later Idealists moved away from Kant’s ideas about personal immortality, this idea of “historical immortality” took center stage. Through social projects that outlive us we maintain a kind of presence after death. Conceptions of historical immortality moved not just into the universalistic ideologies of liberalism and revolutionary socialism but into nationalist and racist doctrines that opposed them. But how, after global wars and genocide, can we retain faith in any conception of shared moral progress? That is our present predicament. A seamless blend of philosophy and intellectual history, The Shadow of God is a profound exploration of secular modernity’s theistic inheritance.",
    abstract_source = "openalex"
}

@misc{obrien1975hegel,
    author = "O'Brien, George Dennis",
    title = "Hegel on Reason and History: A Contemporary Interpretation",
    year = "1975",
    note = {CORE ARGUMENT: O'Brien offers a systematic contemporary interpretation of Hegel's claim that reason governs history, examining the philosophical machinery (teleology, necessity, the role of the state and world-historical individuals) that makes this claim intelligible as more than theological assertion, and asking how far it can be defended by twentieth-century philosophical standards. RELEVANCE: Listed in the SEP bibliography on Hegel's philosophy of history as a dedicated treatment of "reason in history," and remains the earliest sustained English-language monograph attempting a non-theological, philosophically rigorous reconstruction of Hegel's central methodological claim. POSITION: Rationalist reconstruction that seeks to separate defensible philosophical content from Hegel's theological framing.},
    keywords = "reason-in-history, methodology, foundational, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@misc{beiser2005hegel,
    author = "Beiser, Frederick",
    title = "Hegel",
    year = "2005",
    note = {CORE ARGUMENT: Beiser's introductory monograph covers the full range of Hegel's philosophy, including a dedicated treatment of Hegel's philosophy of history that situates the claim "reason governs the world" within Hegel's broader metaphysics of Spirit, his critique of both Enlightenment progressivism and Romantic historicism, and his theory of freedom's historical actualization. RELEVANCE: Offers an accessible but systematically grounded account of reason-in-history as part of Hegel's overall philosophical system, useful for establishing how the teleology/theodicy debates in this domain connect to Hegel's logic, metaphysics, and political philosophy more broadly. POSITION: Situates the reason-in-history thesis within Hegel's systematic idealism, treating it as continuous with (rather than an anomaly within) his broader metaphysics.},
    keywords = "reason-in-history, introduction, systematic, Medium, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Hegel (1770-1831) is one of the major philosophers of the nineteenth century. Many of the major philosophical movements of the twentieth century - from existentialism to analytic philosophy - grew out of reactions against Hegel. He is also one of the hardest philosophers to understand and his complex ideas, though rewarding, are often misunderstood. In this magisterial and lucid introduction, Frederick Beiser covers every major aspect of Hegel's thought. He places Hegel in the historical context of nineteenth-century Germany whilst clarifying the deep insights and originality of Hegel's philosophy.A masterpiece of clarity and scholarship, Hegel is both the ideal starting point for those coming to Hegel for the first time and essential reading for any student or scholar of nineteenth century philosophy.Additional features: glossary chapter summaries chronology annotated further reading.",
    abstract_source = "openalex"
}

@book{pinkard2017does,
    author = "Pinkard, Terry",
    title = "Does History Make Sense? Hegel on the Historical Shapes of Justice",
    year = "2017",
    publisher = "Harvard University Press",
    note = {CORE ARGUMENT: Pinkard argues that Hegel's philosophy of history should be read as tracking historically successive "shapes" of justice and normative authority rather than as a metaphysical guarantee that history progresses toward a predetermined end; historical sense-making is agents' retrospective achievement of coherence, not evidence of an antecedently operative cosmic plan. RELEVANCE: A major recent book-length argument for the retrospective/reconstructive rather than robust-metaphysical reading of Hegelian teleology, directly answering this domain's second key question and offering a systematic alternative to providentialist readings of "reason governs history." POSITION: Deflationary/retrospective reading -- history "making sense" is an achievement of collective self-understanding rather than the unfolding of a pre-given metaphysical end.},
    keywords = "teleology, retrospective, justice, methodology, High, METADATA\\_CLEANED: doi",
    abstract = "Hegel’s philosophy of history—which most critics view as a theory of inevitable progress toward modern European civilization—is widely regarded as a failure today. Terry Pinkard’s spirited defense of the Hegelian view, based on a subtle understanding of human subjectivity, will play a central role in contemporary reevaluations of Hegel’s work.",
    abstract_source = "openalex"
}

@book{neuhouser2000foundations,
    author = "Neuhouser, Frederick",
    title = "Foundations of Hegel's Social Theory: Actualizing Freedom",
    year = "2000",
    publisher = "Harvard University Press",
    address = "Cambridge, MA",
    note = {CORE ARGUMENT: Neuhouser reconstructs the normative standards implicit in Hegel's claim that the central social institutions of modernity (family, civil society, state) are rational, articulating a theory of "social freedom" on which individual autonomy is actualized only through participation in rational social institutions rather than being prior to or independent of them. The book distinguishes personal, moral, and social components of freedom and examines the "objective" institutional conditions Hegel takes to be necessary for full self-determination, while also confronting Hegel's methodological rejection of atomistic individualism. RELEVANCE: Because Neuhouser treats freedom as the internal standard by which Hegel judges institutional rationality in the Philosophy of Right, his account supplies the systematic background for interpreting the historical claim that world history is progress in the consciousness of freedom: if social freedom requires determinate institutional forms, Hegel's four-stage historical narrative can be read as tracking the successive emergence of institutions capable of realizing, rather than merely feeling or believing in, freedom. POSITION: canonical statement of the "social freedom" interpretation of Hegel, methodologically indebted to Rousseau's general will and later taken up by Honneth and the Frankfurt School.},
    keywords = "Hegel, social-freedom, Philosophy-of-Right, institutions, High, INCOMPLETE"
}

@book{patten1999hegels,
    author = "Patten, Alan",
    title = "Hegel's Idea of Freedom",
    year = "1999",
    publisher = "Oxford University Press",
    address = "Oxford",
    doi = "10.1093/0199251568.001.0001",
    note = {CORE ARGUMENT: Patten argues against both purely juridical and strongly metaphysical readings of Hegel's theory of freedom, defending instead a "civic humanist" interpretation on which full or "concrete" freedom requires that individuals identify with, and find their particular ends confirmed by, the shared ethical life of a political community. The introductory chapter explicitly traces the connections Hegel draws between freedom, convention, history, and spirit. RELEVANCE: Because Patten directly addresses how freedom connects to history and spirit, the book is a key reference for assessing whether the progress-of-freedom thesis in the history lectures is continuous with, or a departure from, the systematic theory of freedom developed in the Philosophy of Right. POSITION: civic-humanist reading of Hegelian freedom, positioned against both libertarian/negative-liberty readings and strongly metaphysical (cosmic-Spirit) readings of Hegel.},
    keywords = "Hegel, freedom, civic-humanism, Philosophy-of-Right, High, METADATA\_CLEANED: year:1999->2002",
    abstract = "The book offers the first full-length treatment in English of Hegel's idea of freedom. It explores his theory of what it is for an individual to be free and his account of the social and political contexts in which freedom is developed, realized, and sustained. The book investigates a number of central questions concerning Hegel's ethics and political theory. Is Hegel's outlook unacceptably conservative? Can freedom be equated with rational self-determination? Is there any special connection between freedom and citizenship? By offering interpretations of Hegel's views on these and other questions, the book develops a novel 'civic humanist' reading of Hegel's social philosophy, one that restores to its proper, central place Hegel's idea of freedom.",
    abstract_source = "openalex"
}

@book{franco1999hegels,
    author = "Franco, Paul",
    title = "Hegel's Philosophy of Freedom",
    year = "1999",
    publisher = "Yale University Press",
    address = "New Haven, CT",
    doi = "10.12987/9780300148091",
    note = {CORE ARGUMENT: Franco offers a systematic account of Hegel's conception of freedom centered on the Philosophy of Right, arguing that Hegel's central philosophical achievement is to understand the modern state as the institutional realization of human freedom, synthesizing themes from Hegel's early theological and political writings through the mature system. RELEVANCE: Establishes a baseline account of "objective freedom" realized in modern ethical institutions against which the historical thesis of progress in the consciousness of freedom must be assessed -- namely, whether the history lectures narrate the same freedom analyzed systematically in the Philosophy of Right or a distinct, more phenomenological notion of "consciousness." POSITION: institutionalist, state-centered reading of Hegelian freedom.},
    keywords = "Hegel, freedom, Philosophy-of-Right, state, High, METADATA\_CLEANED: year:1999->2017",
    abstract = "Human freedom is the central theme of modern political philosophy, and G. W. F. Hegel offers perhaps the most profound and systematic modern attempt to understand the state as the realization of human freedom. In this comprehensive examination of Hegel's philosophy of freedom, Paul Franco traces the development of Hegel's ideas of freedom, situates them within his general philosophical system, and relates them to the larger tradition of modern political philosophy. Franco argues that Hegel offers a powerful reformulation of liberalism that escapes many of the problematic assumptions of traditional liberal doctrine and yet avoids falling into the romantic and relativistic excesses of a substantial communitarianism. Devoting the major portion of his attention to Hegel's Philosophy of Right, Franco provides a clear and nontechnical guide to the challenging arguments Hegel presents.",
    abstract_source = "openalex"
}

@book{hardimon1994hegels,
    author = "Hardimon, Michael O.",
    title = "Hegel's Social Philosophy: The Project of Reconciliation",
    year = "1994",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    doi = "10.1017/cbo9780511624773",
    note = {CORE ARGUMENT: Hardimon argues that the central aim of Hegel's social philosophy (the Rechtsphilosophie) is to reconcile modern individuals to the social world by demonstrating that its central institutions -- family, civil society, and the state -- are rational and hence worthy of allegiance; reconciliation is achieved through a philosophical demonstration that these institutions embody and make possible the freedom of their members. RELEVANCE: The reconciliation thesis provides a normative framework for interpreting the endpoint of Hegel's philosophy of history: if world history's telos is the realization of institutions in which subjects can be "at home," the question of whether the modern state as Hegel describes it actually achieves this reconciliation is inseparable from assessing the truth of the progress-in-freedom thesis. POSITION: reconciliationist reading of Hegel's social philosophy, influential on subsequent debates (Franco, Patten, Pippin) about whether Hegel's political philosophy is essentially conservative or retains critical resources.},
    keywords = "Hegel, reconciliation, social-philosophy, ethical-life, High",
    abstract = "This book provides an authoritative account of Hegel's social philosophy at a level that presupposes no specialised knowledge of the subject. Hegel's social theory is designed to reconcile the individual with the modern social world. Michael Hardimon explores the concept of reconciliation in detail and discusses Hegel's views on the relationship between individuality and social membership, and on the family, civil society, and the state.",
    abstract_source = "openalex"
}

@article{houlgate1990worldhistory,
    author = "Houlgate, Stephen",
    title = "World History as the Progress of Consciousness",
    journal = "Owl of Minerva",
    year = "1990",
    volume = "22",
    number = "1",
    pages = "69--80",
    doi = "10.5840/owl199022127",
    note = {CORE ARGUMENT: Houlgate examines the sentence at the heart of Hegel's philosophy of history -- "world history is the progress of the consciousness of freedom, a progress whose necessity it is our business to comprehend" -- and argues against two influential misreadings: the Marxist charge (that this formula reflects a one-sided idealism ignoring material and economic factors in historical development) and the assumption that "consciousness of freedom" designates a merely subjective awareness disconnected from freedom's actual institutional realization. RELEVANCE: Directly interprets the sentence at the center of this domain's inquiry and defends its philosophical coherence, providing a touchstone against which later Eurocentrism-focused critiques (Stone, Murthy, Stibor) and "demystifying" readings (Bykova) of the philosophy of history can be compared. POSITION: defends a non-reductive, non-determinist reading on which consciousness of freedom and freedom's institutional actuality are internally related, against Marxist economic-determinist readings.},
    keywords = "Hegel, philosophy-of-history, consciousness, freedom, progress, High, INCOMPLETE"
}

@article{stone2020hegelcolonialism,
    author = "Stone, Alison",
    title = "Hegel and Colonialism",
    journal = "Hegel Bulletin",
    year = "2020",
    volume = "41",
    number = "2",
    pages = "247--270",
    doi = "10.1017/hgl.2017.17",
    note = "CORE ARGUMENT: Stone argues that Hegel's philosophy of history legitimizes European colonization of non-European peoples as a harsh but necessary means by which those peoples can eventually attain freedom, since Hegel holds that their existing social and political forms preclude full freedom; she then asks whether Hegel's general account of freedom can be extricated from this Eurocentric, pro-colonial narrative of world history or whether the connection between the two is internal to the theory itself. RELEVANCE: Poses in sharp form the normative question central to this domain -- whether the content of freedom Hegel tracks across the Oriental, Greek, Roman, and Germanic stages is a genuinely universal norm or one so bound up with a Eurocentric historiography that the normative and the historiographical elements cannot be cleanly separated. POSITION: critical reading holding that Hegel's account of freedom is constitutively, not merely contingently, linked to his Eurocentrism; a key interlocutor for Murthy's more recuperative response.",
    keywords = "Hegel, colonialism, Eurocentrism, freedom, High",
    abstract = "This article explores the implications of Hegel's Philosophy of World History with respect to colonialism. For Hegel, freedom can be recognized and practised only in classical, Christian and modern Europe; therefore, the world's other peoples can acquire freedom only if Europeans impose their civilization upon them. Although this imposition denies freedom to colonized peoples, this denial is legitimate for Hegel because it is the sole condition on which these peoples can gain freedom in the longer term. The article then considers whether Hegel's basic account of freedom can be extricated from his Eurocentric and pro-colonialist interpretation of the course of history, and argues that matters are more complicated because that interpretation has significant connections with Hegel's conception of freedom as self-determination.",
    abstract_source = "openalex"
}

@article{murthy2024rescuing,
    author = "Murthy, Viren",
    title = "Rescuing Hegel from Eurocentrism: Oriental Reconstructions of Hegel's Orient",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "2",
    pages = "368--395",
    doi = "10.1017/hgl.2024.13",
    note = {CORE ARGUMENT: Murthy responds to Alison Stone's claim that Hegel's idea of freedom is premised on his Eurocentrism and colonialism and so cannot be "saved" from itself. He argues instead that Hegel's own philosophical resources, and their creative appropriation by modern Asian thinkers such as Okakura Tenshin, show how a broadly Hegelian conception of freedom can be mobilized to criticize -- rather than merely legitimate -- Western self-interested individualism and Eurocentric world history. RELEVANCE: Directly engages the debate over whether the content of freedom in Hegel's philosophy of history is separable from its Eurocentric historiographical packaging, offering a counterpoint to Stone and Stibor and bearing on whether the four-stage schema is a corrigible historiographical artifact rather than a normatively essential feature of Hegel's theory of freedom. POSITION: reconstructive reading that attempts to detach Hegel's concept of freedom from his Eurocentric historical narrative via non-Western appropriations of Hegel.},
    keywords = "Hegel, Eurocentrism, Orient, freedom, reception, Medium",
    abstract = "Hegel's Eurocentrism has become something of an elephant in the room, too obvious to merit discussion. The secondary literature on Hegel often concedes that many of Hegel's comments about the Orient are misguided and uninformed, and then declares that such remarks are of no consequence to his philosophy. However, recently, some scholars have contended that Hegel's view of freedom is fundamentally connected to his negative vision of the Orient and Africa. For example, Alison Stone asserts that Hegel's idea of freedom is premised on his Eurocentrism and colonialism. Drawing on Peter Sahota's essay on Hegel and Hinduism, she argues that Hegel's idea of freedom as liberation from nature tends to exclude non-Western conceptions of freedom. Murthy argues that we can move some way towards rescuing Hegel by noting how scholars from modern Asia incorporated some of Hegel's ideas to struggle against Eurocentrism, examining how the Japanese scholar Okakura Tenshin (1863--1913) constructs a Hegel-inspired defense of the concept of Asia or the Orient that rethinks Asia as overcoming the abstract individualist freedom of the West.",
    abstract_source = "s2"
}

@article{stibor2024hegelwhite,
    author = "Stibor, Leonie",
    title = "Hegel and White Freedom",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "2",
    pages = "210--236",
    doi = "10.1017/hgl.2024.36",
    note = {CORE ARGUMENT: Stibor argues, against readings that treat Hegel's racist remarks about Africa in the Lectures on the Philosophy of History as inessential to his practical philosophy, that Hegel's very idea of freedom -- conceived as appropriation and thereby linked to the Western concept of property -- is itself an idea of "white freedom." On this account the racism of the Philosophy of History is grounded in, rather than merely juxtaposed with, Hegel's theory of freedom. RELEVANCE: Pushes the domain's central question about the normative content of Hegel's freedom concept to its most critical conclusion: not simply that Hegel's history is Eurocentric in application, but that the concept of freedom driving the progress-in-consciousness thesis is itself racially and culturally particular rather than an "impartial criterion" for social critique. POSITION: strong critical reading, more radical than Stone's, denying that Hegelian freedom can serve as a universal normative standard at all.},
    keywords = "Hegel, race, freedom, property, whiteness, High",
    abstract = {Hegel's Lectures on the Philosophy of History are notorious for their racist portrayal of Africa. Few scholars, however, have considered their racism to be significant for Hegel's practical philosophy. This is largely because colonialism and Black enslavement appear to conflict with the idea of universal freedom at the heart of Hegel's practical philosophy. Stibor argues against this view and defends the claim that Hegel's idea of freedom is linked to white identity, grounding his racist comments in the Philosophy of History rather than opposing them. Tracing the connections of Hegel's conception of freedom with the Western idea of property, the paper argues that Hegel conceptualizes freedom as appropriation, thereby linking freedom to property and white identity, and concludes that Hegel's idea of freedom is an idea of "white freedom" and thus not an "impartial criterion" for social critique.},
    abstract_source = "s2"
}

@article{lima2024hegelcontra,
    author = "Lima, Erick",
    title = "Hegel contra Hegel: Eurocentrism, Colonialism, and Progress",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "2",
    pages = "237--264",
    doi = "10.1017/hgl.2024.8",
    note = {CORE ARGUMENT: Lima investigates whether Hegel's own philosophical resources can be turned against the Eurocentric and colonialist content of his thought, reconstructing the connection between "spirit" and "progress" and, following Adorno's critique of Hegel, asking whether "progress in the consciousness of freedom" can be read to include an experiential dimension capable of registering history's regressive moments rather than only its advances. The article compares Hegel's account of colonization with Marx's theory of primitive accumulation. RELEVANCE: Offers an immanent-critique approach to the same problem addressed by Stone, Murthy, and Stibor, testing whether "progress in consciousness of freedom" can be reconstructed as a genuinely critical rather than merely legitimating category once its Eurocentric applications are subjected to Hegel's own dialectical standards. POSITION: immanent-critical, Adorno-influenced reading that seeks resources internal to Hegel's philosophy for criticizing its own Eurocentrism.},
    keywords = "Hegel, progress, Eurocentrism, Adorno, colonialism, Medium",
    abstract = {This study aims to investigate whether some of the Eurocentric and colonialist contents of Hegel's thought are open to criticism with elements of his own philosophy. Lima shows that some of these contents can be organized around the connection between "spirit" and "progress," discussing the possibly pro-colonialist tendencies of Hegel's notion of spirit while arguing that, disconnected from the philosophy of history, it establishes a connection of autonomy and critique crucial even for anti-colonialist thought. Following Adorno's criticism of Hegel, the article investigates the possibility of finding in "progress in the consciousness of freedom" an experiential dimension capable of capturing its regressive moments, leading to a discussion of colonization in the reconstruction of capitalist society presented in the Philosophy of Right, and a comparison of Hegel's discussion of colonization with Marx's theory of "primitive accumulation."},
    abstract_source = "s2"
}

@incollection{desmond2020historycosmos,
    author = "Desmond, William",
    title = "History, Cosmos, Mind, and (Not Quite) Everything",
    booktitle = "Hegel's Antiquity",
    year = "2020",
    pages = "329--352",
    publisher = "Oxford University Press",
    address = "Oxford",
    doi = "10.1093/oso/9780198839064.003.0006",
    note = {CORE ARGUMENT: Desmond situates Hegel's account of world history within ancient historiography, arguing that Hegel's threefold typology of histories (original, reflective, philosophical) makes the case that history and philosophy essentially converge in the modern era. He shows that in Hegel's vision of Spirit developing through four stages -- the Oriental, Greek, Roman, and Germanic worlds -- the middle (Greek and Roman) stages are pivotal to the story of progressive freedom and self-knowledge, with the Mediterranean functioning as both historical fact and organizing metaphor "long before Braudel." RELEVANCE: Directly bears on this domain's question of whether the four-stage schema is a defensible philosophical typology or an artifact of nineteenth-century historiography, by showing that the schema is, in many respects, Hegel's own systematization of a long-held historiographical consensus about the ancient Mediterranean world rather than a sui generis philosophical invention. POSITION: contextualist reading that treats the four-stage schema as largely continuous with established ancient historiography while defending the internal coherence of its Greek/Roman "middle."},
    keywords = "Hegel, philosophy-of-history, typology, antiquity, Mediterranean, High",
    abstract = "Hegel's Lectures on the Philosophy of History explore the legacies of ancient history and historiography, at the levels of both theory and empirical detail. Their threefold typology of histories into 'original', 'reflective', and 'philosophical' constitutes a concise argument that history has and must, in the course of its development, become theoretical, and that therefore history and philosophy have essentially converged in the modern era. With their vision of a Spirit that develops through four essential stages of the 'Oriental', Greek, Roman and 'Germanic' worlds, these lectures reveal that, for Hegel, the middle (Greek and Roman) stages are pivotal to the story of progressive human freedom and self-knowledge. The Mediterranean as the 'middle sea' (Mittelmeer) is a central historical fact and metaphor for Hegel, long before Braudel. This narrative is, in many respects, simply Hegel's systematization of a long-held consensus.",
    abstract_source = "s2"
}

@misc{bykova2025realcontent,
    author = "Bykova, Marina",
    title = "On the Real Content of Hegel's Philosophy of History: An Attempt at Demystification",
    year = "2025",
    volume = "40",
    pages = "175",
    doi = "10.21146/0134-8655-2025-40-175-221",
    note = {CORE ARGUMENT: Bykova argues that Hegel's philosophy of history is often misread as deterministic, providentialist, or narrowly teleological because key concepts -- the "cunning of Reason," the "march of Spirit in history," and the "end of history" -- are taken to imply an externally imposed goal, a fixed historical trajectory, or a predetermined conclusion. She contends that, properly understood, Hegel conceives history as a rational and necessary process emerging from the concrete actions of individuals and nations, through which Spirit progressively attains self-consciousness and freedom, reconciling human agency with the rational structure of historical development. RELEVANCE: Directly addresses this domain's question of how "progress in consciousness of freedom" relates to actual institutional and political progress, arguing that Hegel's rational necessity is compatible with, rather than opposed to, the agency of concrete historical actors, against readings that treat Hegelian history as fatalistic or externally predetermined. POSITION: anti-determinist, "demystifying" reading of Hegel's philosophy of history that reconciles rational necessity with historical agency.},
    keywords = "Hegel, philosophy-of-history, determinism, cunning-of-reason, agency, Medium, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = {Hegel's philosophy of history is often misinterpreted through the lens of determinism, providentialism, or teleology, leading to widespread misconceptions about the true significance of his understanding of history. Such Hegelian concepts as the "cunning of Reason," the "march of Spirit in history," and the so-called "end of history" are frequently misread as implying an external goal and as asserting external control over historical events, a fixed historical trajectory, or a predetermined conclusion to human development. Bykova conceives history as a rational and necessary process emerging from the concrete actions of individuals and nations, through which the World Spirit progressively attains self-consciousness and freedom, neither mechanistically predetermined nor imposed from outside, demonstrating how Hegel reconciles human agency with the rational logic of history.},
    abstract_source = "s2"
}

@incollection{matejckova2019historyprogress,
    author = "Matějčková, Tereza",
    title = "History as the Progress in the (Un)Consciousness of Freedom?",
    booktitle = "Concepts of Normativity: Kant or Hegel?",
    year = "2019",
    pages = "196--215",
    publisher = "Brill",
    doi = "10.1163/9789004409712\_014",
    note = {CORE ARGUMENT: Matejckova's title directly interrogates Hegel's own formula, asking whether world history should be understood, without qualification, as progress toward consciousness of freedom, or whether it instead involves moments of a distinctive unconsciousness of freedom that complicate a straightforwardly progressive reading -- situating the question within a broader volume comparing Kantian and Hegelian conceptions of normativity. RELEVANCE: Poses, in its very title, the interpretive problem central to this domain: whether "progress in the consciousness of freedom" names a smooth developmental process or one punctuated by regression and non-recognition, a question that bears directly on how the normative and the historical-institutional dimensions of Hegel's thesis relate. POSITION: raises an internal complication to the standard progressivist reading of Hegel's philosophy of history within a Kant/Hegel normativity debate.},
    keywords = "Hegel, consciousness, freedom, normativity, Kant, Medium, INCOMPLETE"
}

@article{reichl2025leopoldozea,
    author = "Reichl, Pavel",
    title = "Leopoldo Zea on the Role of Hegel's Master--Slave Dialectic in the Philosophy of Latin American History",
    journal = "European Journal of Philosophy",
    year = "2025",
    volume = "34",
    number = "1",
    pages = "152--162",
    doi = "10.1111/ejop.70017",
    note = "CORE ARGUMENT: Reichl examines how the Mexican philosopher Leopoldo Zea, in one of the most influential works of twentieth-century Latin American philosophy, draws on Hegel's Master-Slave Dialectic (rather than the Lectures on the Philosophy of History directly) to construct a philosophy of Latin American history running from colonialism to the present, reconstructing Zea's underexplored motives for organizing this project around Hegel's brief but suggestive dialectical passages. RELEVANCE: Shows how the normative structure of Hegelian freedom -- recognition, struggle, and self-consciousness -- has been redeployed outside Hegel's own four-stage schema to narrate a non-European history of freedom, offering a concrete case study of postcolonial appropriation that complements the more purely exegetical debates over Hegel's own Eurocentrism (Stone, Murthy, Stibor). POSITION: reception-history study documenting a postcolonial, non-Hegelian extension of Hegelian categories of freedom and history to Latin America.",
    keywords = "Hegel, Master-Slave-Dialectic, Latin-America, Zea, reception, Medium",
    abstract = "In one of the most influential works in 20th-century Latin America, Leopoldo Zea draws on Hegel's Master--Slave Dialectic to construct a philosophy of Latin American History from colonialism to the present. Yet his motives for organizing his work around these brief but suggestive passages from Hegel's Phenomenology of Spirit have not been well understood. In this article, Reichl explores these motives with the aim of shedding light on Zea's philosophy of history and on his strategy for appropriating Hegel in a post-colonial context.",
    abstract_source = "openalex"
}

@article{parkinson1971hegelsconcept,
    author = "Parkinson, G. H. R.",
    title = "Hegel's Concept of Freedom",
    journal = "Royal Institute of Philosophy Lectures",
    year = "1971",
    volume = "5",
    pages = "174--195",
    doi = "10.1017/S008044360000145X",
    note = {CORE ARGUMENT: Parkinson takes up Isaiah Berlin's charge that Hegel's conception of freedom exemplifies "positive freedom," a type of freedom-concept Berlin held to lie "at the heart of many of the nationalist, communist, authoritarian and totalitarian creeds" of the twentieth century, and assesses how far this characterization, and its critical implications, actually fit Hegel's own texts, given that Hegel treated freedom as the central concept of human history. RELEVANCE: Provides an early and direct test of the positive/negative liberty framework against Hegel's philosophy of history, addressing this domain's question of what conception of freedom -- positive/social versus negative -- Hegel is tracking in the progress-of-history thesis, and whether that conception carries the authoritarian implications Berlin attributed to it. POSITION: critically evaluates, and partially resists, Berlin's assimilation of Hegel to a dangerous "positive liberty" tradition.},
    keywords = "Hegel, positive-liberty, Berlin, freedom, High",
    abstract = "The concept of freedom is one which Hegel thought of very great importance; indeed, he believed that it is the central concept in human history. 'Mind is free', he wrote, 'and to actualise this, its essence, is the endeavour of the worldmind in world-history'. Parkinson recalls that Isaiah Berlin argued (Four Essays on Liberty, 1969) that Hegel's concept of freedom is one of a type, called by him the concept of positive freedom, which is 'at the heart of many of the nationalist, communist, authoritarian and totalitarian creeds of our day', and sets out to show to what extent this characterization is true of Hegel, and to what extent Hegel's views about freedom are true.",
    abstract_source = "openalex"
}

@article{buchwalter2009ishegels,
    author = "Buchwalter, Andrew",
    title = "Is Hegel's Philosophy of History Eurocentric?",
    journal = "Proceedings of the Hegel Society of America",
    year = "2009",
    volume = "19",
    pages = "87--110",
    doi = "10.5840/hsaproceedings2009207",
    note = "CORE ARGUMENT: Buchwalter directly addresses whether Hegel's philosophy of history is Eurocentric, engaging the question of how the four-stage schema (Oriental, Greek, Roman, Germanic) and its ordering by degrees of freedom should be assessed in light of post-colonial critiques of Hegel's historiography. No abstract could be retrieved through available bibliographic sources, so the specific line of argument and conclusion cannot be verified beyond the title and its place in the secondary literature. RELEVANCE: An early (2009) contribution to the same Eurocentrism debate that Stone, Murthy, Lima, and Stibor continue in the 2020s, useful for tracing the development of the debate over time, though its specific conclusions should be verified against the primary text before use in synthesis. POSITION: contributes to the Eurocentrism-critique debate on Hegel's philosophy of history; specific position undetermined from available metadata.",
    keywords = "Hegel, Eurocentrism, philosophy-of-history, Medium, INCOMPLETE"
}

@misc{hartmann1972nonmetaphysical,
    author = "Hartmann, Klaus",
    editor = "MacIntyre, Alasdair",
    title = "Hegel: A Non-Metaphysical View",
    year = "1972",
    address = "New York",
    note = {CORE ARGUMENT: Hartmann inaugurates the "non-metaphysical" reading program by arguing that Hegel's system should be understood as a categorial theory of the conditions of intelligible thought and objectivity rather than as a speculative ontology positing a cosmic Spirit-subject that exists prior to or independently of finite subjects and their concepts. RELEVANCE: This essay is the origin point of the interpretive vocabulary ("metaphysical" vs. "non-metaphysical") that structures this entire domain; every later non-metaphysical reading of Hegel's philosophy of history (Pippin, Pinkard, Hardimon) traces its lineage to Hartmann's proposal that Hegel's "logic" replaces rather than presupposes traditional ontology. POSITION: Founding statement of the non-metaphysical/categorial reading of Hegel.},
    keywords = "non-metaphysical-reading, foundational, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc"
}

@book{taylor1975hegel,
    author = "Taylor, Charles",
    title = "Hegel",
    year = "1975",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    note = {CORE ARGUMENT: Taylor reads Hegel's system, including the philosophy of history, as animated by a genuinely cosmological ambition: Spirit is a real, self-positing subjectivity that requires nature and human history as the vehicle of its own necessary self-realization, reconciling Enlightenment autonomy with expressivist notions of self-realizing life drawn from Herder and Romanticism. RELEVANCE: As one of the works that reopened serious Anglophone engagement with Hegel, Taylor's book is the canonical mid-century statement of the metaphysical reading against which Pippin's and Pinkard's later post-Kantian reconstructions explicitly define themselves; his treatment of Spirit's "necessary embodiment" in history underwrites strong teleological readings of the cunning of reason. POSITION: Metaphysical reading: Spirit as a cosmic subject realizing itself through nature and history.},
    sep_context = {SEP "Georg Wilhelm Friedrich Hegel" entry (sec. "Life, Work, and Influence") lists Taylor (1975) alongside H.S. Harris, Pippin, and Pinkard as a landmark of the late-twentieth-century Anglophone revival of Hegel scholarship.},
    keywords = "metaphysical-reading, teleology, foundational, High",
    abstract = "Originally published: Berkeley : University of California Press, c1980. With a new introduction.Electronic access restricted; authentication may be required:0823220583082322059",
    abstract_source = "core"
}

@article{beiser1995nonmetaphysician,
    author = "Beiser, Frederick C.",
    title = "Hegel, A Non-Metaphysician? A Polemic Review of H T Engelhardt and Terry Pinkard (eds), Hegel Reconsidered",
    journal = "Bulletin of the Hegel Society of Great Britain",
    year = "1995",
    volume = "16",
    number = "2",
    note = "CORE ARGUMENT: In this polemical review of Engelhardt and Pinkard's edited volume Hegel Reconsidered: Beyond Metaphysics and the Authoritarian State, Beiser directly attacks the non-metaphysical program, arguing that stripping Hegel's Logic and Phenomenology of ontological commitments renders central Hegelian claims -- about the unity of thought and being, and about the rationality of the historical process -- either trivial or unintelligible. RELEVANCE: This is the clearest programmatic statement of the metaphysical camp's objection to the non-metaphysical reading as such, articulating exactly the worry (that a deflated Hegel cannot sustain strong claims about history's rational necessity) that the project's key question about the philosophy of history poses directly. POSITION: Metaphysical camp's direct polemical rebuttal of the non-metaphysical program associated with Pinkard and Engelhardt.",
    keywords = "metaphysical-reading, polemic, non-metaphysical-critique, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: pages, doi"
}

@misc{houlgate1991introduction,
    author = "Houlgate, Stephen",
    title = "An Introduction to Hegel: Freedom, Truth and History",
    year = "1991",
    address = "Oxford",
    note = {CORE ARGUMENT: Houlgate argues that Hegel's central concepts of freedom, truth, and history are inseparable from his speculative logic and metaphysics of the Idea: history is the process by which Spirit comes to know itself as free, and this self-knowing is a genuine ontological achievement, not merely a normative reconstruction of human practices. RELEVANCE: As the title makes explicit, Houlgate builds the connection between metaphysics and the philosophy of history into the very structure of his introduction, making this the primary textbook-length statement of the metaphysical camp's reading of Hegelian history and a direct counterpart to Pinkard's Does History Make Sense?; Houlgate's later dispute with Pippin over "logic as ontology" versus "logic as metaphysics" (see Suther 2023) descends directly from positions staked out here. POSITION: Metaphysical reading connecting Hegel's Logic directly to a substantive teleology of history.},
    sep_context = {SEP "Georg Wilhelm Friedrich Hegel" entry lists Houlgate (1991) alongside Stern (1990) as part of the British contribution to the late-twentieth-century revival of Hegel scholarship, and elsewhere frames the ongoing "Pippin-Houlgate" dispute over whether Hegel's Logic is "logic as ontology" (Houlgate) or "logic as metaphysics" (Pippin).},
    keywords = "metaphysical-reading, teleology, freedom, foundational, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@misc{pippin2019realm,
    author = "Pippin, Robert B.",
    title = "Hegel's Realm of Shadows: Logic as Metaphysics in the Science of Logic",
    year = "2018",
    address = "Chicago",
    note = {CORE ARGUMENT: Pippin argues that Hegel's Science of Logic is indeed a metaphysics, but a distinctively post-Kantian one: an account of the intelligibility of being as such, achieved through pure thought's self-reflective determination of its own categories, rather than an account of any special ontological domain or transcendent object such as a cosmic Spirit-subject. RELEVANCE: This is Pippin's most developed statement of what "metaphysics" can mean for a post-Kantian, non-cosmological Hegel, directly bearing on whether a deflationary reading can still underwrite the strong claim that history is rationally intelligible; Pippin insists it can, since intelligibility itself, not providence, is what does the explanatory work in his account of reason's presence in history. POSITION: Revised/post-Kantian reading: Hegel is a metaphysician of intelligibility, not of a cosmic subject -- explicitly resists being classified as simply "non-metaphysical."},
    sep_context = {SEP "Georg Wilhelm Friedrich Hegel" entry (sec. 4, "The revised metaphysical reaction to the post-Kantian view of Hegel") discusses Pippin's 2019 monograph at length, noting that "while Hegel has a metaphysics, it is a metaphysics in a new sense (Pippin 2019, 5)," involving a "speculative identity" between the forms of pure thinking and the forms of being.},
    keywords = "non-metaphysical-reading, post-Kantian, logic-as-metaphysics, foundational, High, METADATA\\_CLEANED: doi, METADATA\_CLEANED: publisher, type:@book->@misc",
    abstract = {Hegel frequently claimed that the heart of his entire system was a book widely regarded as among the most difficult in the history of philosophy, The Science of Logic. This is the book that presents his metaphysics, an enterprise that he insists can only be properly understood as a "logic," or a "science of pure thinking." Since he also wrote that the proper object of any such logic is pure thinking itself, it has always been unclear in just what sense such a science could be a "metaphysics." Robert B. Pippin offers here a bold, original interpretation of Hegel's claim that only now, after Kant's critical breakthrough in philosophy, can we understand how logic can be a metaphysics. Pippin addresses Hegel's deep, constant reliance on Aristotle's conception of metaphysics, the difference between Hegel's project and modern rationalist metaphysics, and the links between the "logic as metaphysics" claim and modern developments in the philosophy of logic. Pippin goes on to explore many other facets of Hegel's thought, including the significance for a philosophical logic of the self-conscious character of thought, the dynamism of reason in Kant and Hegel, life as a logical category, and what Hegel might mean by the unity of the idea of the true and the idea of the good in the "Absolute Idea." The culmination of Pippin's work on Hegel and German idealism, no Hegel scholar or historian of philosophy will want to miss this book},
    abstract_source = "openalex"
}

@misc{pinkard2017metaphysicsagency,
    author = "Pinkard, Terry",
    editor = "Moyar, Dean",
    title = "Hegel's Philosophy of History as the Metaphysics of Agency",
    year = "2017",
    address = "Oxford",
    note = {CORE ARGUMENT: Pinkard reframes what "metaphysics" means for Hegel's philosophy of history: rather than a metaphysics of a supra-individual Spirit-substance, Hegel offers a "metaphysics of agency," an account of the categorial structure that any collective, self-conscious, norm-governed agency must have in order for its historical development to be intelligible to itself as progress. RELEVANCE: This chapter directly addresses the project's key question about the cunning of reason, reinterpreting it not as external manipulation by a cosmic subject but as the structural feature by which individual and collective purposes only become determinately what they are through their unintended historical consequences and subsequent reappropriation by later generations. POSITION: Non-metaphysical/post-Kantian reading, specifically targeting the "cunning of reason" and teleology-of-history debates.},
    keywords = "non-metaphysical-reading, cunning-of-reason, agency, High, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "Rather than understanding history as a process guided by an entity (Geist) that is aiming at the goal of coming to a full self-consciousness, this chapter argues that Hegel’s philosophy should be understood against the background of his Aristotelian- and Kantian-inspired metaphysics. Using his Logic as the background, the author argues that his philosophy of history is an examination of the metaphysical contours of subjectivity and how the self-interpreting, self-developing collective human enterprise has moved from one such shape to another in terms of deeper logic of sense-making, and how this has meant that subjectivity itself has reshaped itself over the course of history. The role of the “infinite end” of justice thereby is shown to play an essential role in making sense of history.",
    abstract_source = "openalex"
}

@misc{kreines2006changingdebate,
    author = "Kreines, James",
    title = "Hegel's Metaphysics: Changing the Debate",
    year = "2006",
    volume = "1",
    note = {CORE ARGUMENT: Kreines argues that the metaphysical/non-metaphysical dichotomy, as usually posed, is unhelpful and ultimately unconvincing as a "non-metaphysical" reading, because Hegel's theoretical philosophy is irreducibly metaphysical in the sense of being concerned with explanatory grounds, universals, and kinds; the productive question is not whether Hegel has a metaphysics but what specific character that metaphysics has. RELEVANCE: This survey article reframes the entire debate this domain covers, arguing that both camps have made compelling points that are actually independent of the "non-metaphysical" label, which directly shapes how a literature review should present the debate -- not as a binary choice but as competing accounts of what kind of metaphysics (if any cosmological, providential one) underwrites Hegel's philosophy of history. POSITION: Dichotomy-skeptical "third way": Hegel has a metaphysics, but debate should shift to its specific character rather than metaphysical-vs-non-metaphysical labels.},
    keywords = "metaphysics-debate, survey, dichotomy-skeptical, foundational, High, METADATA\\_CLEANED: journal, pages, doi, type:@article->@misc, METADATA\_CLEANED: number",
    abstract = "Abstract There are two general approaches to Hegel's theoretical philosophy which are broadly popular in recent work. Debate between them is often characterized, by both sides, as a dispute between those favoring a more traditional “metaphysical” approach and those favoring a newer “non‐metaphysical” approach. But I argue that the most important and compelling points made by both sides are actually independent of the idea of a “non‐metaphysical” interpretation of Hegel, which is itself simply unconvincing. The most promising directions for future research, for those on both sides of recent debates, will require recognizing that Hegel's theoretical philosophy includes a metaphysics, and engaging new debates about the specific character of that metaphysics.",
    abstract_source = "openalex"
}

@misc{kreines2015reason,
    author = "Kreines, James",
    title = "Reason in the World: Hegel's Metaphysics and its Philosophical Appeal",
    year = "2015",
    address = "Oxford",
    note = {CORE ARGUMENT: Kreines offers a book-length defense of the claim that Hegel's Science of Logic pursues a genuine metaphysics of reason -- concerned with grounds, explanatory conditions, and the possibility of complete reasons for why things are as they are -- that is metaphysically ambitious yet distinct from pre-critical foundationalism, scientism, or theology, and that survives Kant's Transcendental Dialectic critique of traditional metaphysics. RELEVANCE: Kreines's account of Hegelian explanatory metaphysics provides resources for understanding what "reason in history" could mean on a metaphysically substantive but non-theological reading -- relevant to whether teleological talk of history's rational intelligibility can be non-providential yet still more than a merely retrospective normative reconstruction. POSITION: Substantive-metaphysics reading that explicitly rejects both scientistic/theological foundationalism and non-metaphysical deflationism.},
    keywords = "metaphysics-debate, explanatory-grounds, dichotomy-skeptical, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Abstract This book defends a new interpretation of Hegel’s theoretical philosophy. It is argued that Hegel’s project in his central Science of Logic has a single organizing focus, provided by the metaphilosophical commitment that metaphysics is fundamental to philosophy. Hegel pursues more specifically the metaphysics of reason, concerned with the reasons, or conditions in terms of which things can be explained. Straightforward epistemological or skeptical worries do not threaten this project. The real threat is Kant’s Transcendental Dialectic from the Critique of Pure Reason, arguing that metaphysics comes into conflict with itself. But Hegel has a powerful case that Kant’s own insights here can be turned to the purpose of constructive metaphysics. And the unified focus of the seemingly disparate arguments at the conclusion of Hegel’s Science of Logic can be understood in these terms. Hegel defends, first, his general claim that the reasons which explain are always found in immanent concepts, universals, or kinds. And he will argue from here to conclusions which are distinctive in being metaphysically ambitious, yet surprisingly distant from any form of metaphysical foundationalism, whether scientistic, theological, rationalist, or otherwise. This means that Hegel’s project will be fundamentally neither Kantian nor Spinozist. The aim of his project is more distinctively his own: it is to turn the most powerful criticism of metaphysics, from Kant’s Dialectic, to the end of a systematic reconstruction of metaphysics. Finally, we can still learn a great deal from Hegel about ongoing philosophical debates concerning everything from metaphysics, to the philosophy of science, to the nature of philosophy itself.",
    abstract_source = "openalex"
}

@article{suther2023overcoming,
    author = "Suther, Jensen",
    title = "Hegel's Metaphysics of Rational Life: Overcoming the Pippin-Houlgate Dispute",
    journal = "Hegel Bulletin",
    year = "2023",
    volume = "46",
    number = "1",
    note = {CORE ARGUMENT: Suther reframes the Pippin-Houlgate dispute as a contest between "logic as ontology" (Houlgate) and "logic as metaphysics" (Pippin, following Rödl), argues that Houlgate's ontological approach cannot secure the objective validity of the categories, that Pippin's logic-as-metaphysics succeeds where Houlgate fails on this point, but that Pippin's program remains incomplete because it neglects Hegel's account of cognition as a form of life. RELEVANCE: This is the most current systematic attempt to adjudicate the specific metaphysical/non-metaphysical dispute between two of the domain's key figures (Pippin and Houlgate), offering the review a state-of-the-art map of where the technical logic debate stands as of the early 2020s and how it might bear on questions of rational life and, by extension, historical agency. POSITION: Attempts to synthesize and move beyond both the Pippin (post-Kantian/logic-as-metaphysics) and Houlgate (metaphysical/logic-as-ontology) positions via a "metaphysics of rational life."},
    keywords = "metaphysics-debate, Pippin-Houlgate-dispute, dichotomy-skeptical, Medium, METADATA\\_CLEANED: pages, doi",
    abstract = "Abstract In the past decade, the meaning of Hegel's idea of a ‘science of logic’ has become a matter of intense philosophical debate. This article examines the two most influential yet opposed contemporary readings of the Science of Logic—often referred to as the ‘metaphysical’ and ‘non-metaphysical’ interpretations. I argue that this debate should be reframed as a contest between logic as ontology (LAO) and logic as metaphysics (LAM). According to Stephen Houlgate's interpretation of logic as ontology, the science of logic is a progressively explicit unfolding of the categories of thought, which is at the same time the process by which being itself determines what it is to be. A second interpretation has been pursued by Sebastian Rödl and Robert Pippin, who read Hegel's logic as metaphysics. On this reading, the science of logic is a progressively coherent unfolding of the categories of thought, which articulate all that it could intelligibly mean to be. This article intervenes in this debate in three key ways. First, I argue that Houlgate's ontological approach undermines his attempt to establish the objective validity of the categories. Second, I show that the LAM emphasis on the crucial idea of apperception enables it to succeed where Houlgate fails by doing justice to the rational necessity with which the Logic unfolds. Third, I argue that, despite this success, the LAM program remains unrealized because of its neglect of Hegel's understanding of cognition as a form of life. While LAM has compellingly unfolded the ‘thought of being’, it has ignored the inverse question of the ‘being of thought’. I attempt to fulfil the LAM program by elaborating Hegel's account of what it means to be a thinker.",
    abstract_source = "s2"
}

@misc{lumsden2007rise,
    author = "Lumsden, Simon",
    title = "The Rise of the Non-Metaphysical Hegel",
    year = "2007",
    volume = "3",
    number = "1",
    note = {CORE ARGUMENT: Lumsden surveys the emergence and development of the non-metaphysical reading tradition from Hartmann and Klaus through Pippin, Pinkard, and their critics, tracing how the label has been used to cover quite different projects (deflating Hegel's ontology, emphasizing his social/normative theory of self-consciousness, or reading him as a proto-pragmatist) and assessing the main lines of criticism the tradition has faced. RELEVANCE: As a companion survey to Kreines (2006), this article gives synthesis writers a concise map of the non-metaphysical camp's internal variety and its critics, useful for organizing the domain's presentation of "the non-metaphysical reading" as itself a family of positions rather than a single view. POSITION: Historiographical survey of the non-metaphysical reading tradition and its critics.},
    keywords = "non-metaphysical-reading, survey, historiography, Medium, METADATA\\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Abstract There has been a resurgence of interest in Hegel's thought by Anglo‐American philosophers in the last 25 years. That expansion of interest was initiated with the publication of Charles Taylor's Hegel (1975). That work stills stands as one of7 the important branches of Hegel interpretation. However the dominance of the strongly metaphysical interpretation of Hegel, which dominated the understanding of Hegel until the 1980s, and of which Taylor's work represents the culmination, has now, at least among the major interpreters of Hegel, given way to what has come to be known as the non‐metaphysical reading of Hegel. This article charts the emergence and development of the non‐metaphysical Hegel, which takes his thought to be a continuation of the Kantian project of critically examining the presuppositions of any normative claim. This article provides an overview of the latest developments in Hegel research, primarily focusing on the English‐language literature. Recent research has placed Hegel's concerns at the centre of contemporary debates in analytic philosophy, particularly concerning the status of norms, the ‘space of reasons’ and the ‘myth of the given’. This research has in turn been influential on the two most important figures in English‐language Hegel scholarship (Robert Pippin and Terry Pinkard). The article will position this new wave of Hegel scholarship and its influence in relation to the metaphysical interpretation of Hegel and will also provide a brief overview of Hegel's reception in French post‐structuralism, which has largely accepted and promoted a view of Hegel as a metaphysician.",
    abstract_source = "openalex"
}

@article{baumann2020authoritarian,
    author = "Baumann, Charlotte",
    title = "Was Hegel an Authoritarian Thinker? Reading Hegel's Philosophy of History on the Basis of his Metaphysics",
    journal = "Archiv für Geschichte der Philosophie",
    year = "2020",
    volume = "103",
    number = "1",
    pages = "120--147",
    doi = "10.1515/agph-2017-0128",
    note = "CORE ARGUMENT: Rather than defending Hegel by deflating his metaphysics (as Pippin and Brandom do), Baumann argues that critics from Marx to Popper and Habermas are broadly correct that Hegel's central concepts of reason and history are metaphysically loaded, but mistaken about what this metaphysics entails: examined closely, even a traditionally metaphysical reading of the Philosophy of History yields a non-authoritarian argument for freedom as requiring collective oversight of social structures for the benefit of all. RELEVANCE: This article directly tests the project's key question about what is at stake in reading Hegel's teleology metaphysically versus deflationarily, arguing against the common assumption (shared by many non-metaphysical readers) that a metaphysical reading of reason in history is politically dangerous, and thereby reframing the ethical stakes of the debate. POSITION: Metaphysical reading defended against the authoritarianism charge, without recourse to deflationary strategies.",
    keywords = "metaphysical-reading, authoritarianism, politics-of-history, High",
    abstract = "Abstract With Hegel’s metaphysics attracting renewed attention, it is time to address a long-standing criticism: Scholars from Marx to Popper and Habermas have worried that Hegel’s metaphysics has anti-individualist and authoritarian implications, which are particularly pronounced in his Philosophy of History, since Hegel identifies historical progress with reason imposing itself on individuals. Rather than proposing an alternative non-metaphysical conception of reason, as Pippin or Brandom have done, this article argues that critics are broadly right in their metaphysical reading of Hegel’s central concepts. However, they are mistaken about what Hegel’s approach entails, when one examines the specific types of states discussed (and rejected) by the philosopher in his Philosophy of History. Even on a traditional metaphysical reading, Hegel is not only non-authoritarian; he also makes a powerful argument concerning freedom, whereupon the freest society involves collective oversight and the shaping of social structures so as to ensure that they benefit everybody.",
    abstract_source = "s2"
}

@article{schulting2021review,
    author = "Schulting, Dennis",
    title = "Robert Pippin. Hegel's Realm of Shadows: Logic as Metaphysics in the 'Science of Logic'",
    journal = "Hegel Bulletin",
    year = "2021",
    volume = "42",
    note = {CORE ARGUMENT: Schulting's review argues that Pippin has long been mischaracterized as offering a "non-metaphysical" or merely "Kantianizing" reading of Hegel, when in fact Hegel's Realm of Shadows makes clear that Pippin's Hegel is a metaphysician "as much as you would want," albeit one who has fully absorbed Kant's critical revolution -- the Science of Logic being, for Pippin, an Aristotelian-style metaphysics of the intelligibility of being, not an account of any special ontological domain. RELEVANCE: This review is a useful secondary source for clarifying a common terminological confusion in the domain: that "post-Kantian" readings like Pippin's are not thereby "non-metaphysical" in any simple sense, which matters for accurately representing the current state of the debate rather than the older 1980s-90s framing. POSITION: Clarifies and defends Pippin's self-description as a metaphysician of a specifically post-Kantian kind, against both "non-metaphysical" and "Kantianizing" mischaracterizations.},
    keywords = "non-metaphysical-reading, terminology, review, Low, METADATA\\_CLEANED: pages, doi, METADATA\_CLEANED: number",
    abstract = "One of the persistent conundrums in Hegel scholarship concerns the precise relation betweenKant andHegel. It is clear fromHegel’s many pronouncements, from early on in his Faith and Knowledge until the last edition of the Doctrine of Being from 1832, that Kant features prominently among the central influences on Hegel’s thought. However, commentators have more often sought to divorce Hegel’s logic from transcendental philosophy than they have tried to explain the precise nature of Hegel’s allegiance to Kant. Nobody of course denies that Hegel is a post-Kantian in some sense, but one has the impression that generally this is explained away in temporal terms without it being qualified what is specifically post-Kantian about Hegel’s thinking in any meaningful sense. One prominent exception in the literature is, as is well known, the work of Robert Pippin, starting with his magisterialHegel’s Idealism (1989). Pippin has often been criticized, mistakenly, for propounding a non-metaphysical reading of Hegel, or indeed for a ‘Kantianizing’ reading of Hegel, as if this meant that the real, speculative, or, if you will, ontological Hegel had to be bowdlerized for a modern philosophical public less enamoured of good old metaphysics. In his new book, Pippin makes it clear that his reading of Hegel is neither ‘Kantianizing’ nor non-metaphysical. This is not a correction of his earlier views in light of the criticisms, but rather a further elaboration on and clarification of the claims already made inHegel’s Idealism. Pippin’s Hegel is as much of a metaphysician as you would want, albeit one who has fully taken on board Kant’s ‘revolution in the way of our thinking’ (cf. 123). One of the central claims of Hegel’s Realm of Shadows is in fact that the Science of Logic is a metaphysics full stop, in the sense of Aristotelian metaphysics, an account of the intelligibility of Being itself, but importantly, ‘not an account of any special ontological domain or object’ (299). At the same time, more than any other commentator, Pippin is able to parse in detail those passages in Hegel—which are too often taken at face value by other commentators—that show the intimate relation between Kant’s and Hegel’s thinking and demonstrate that Hegel is, in spirit if not letter, a Kantian through and through. In other words, there is no need for any ‘Kantianizing’. Explaining this doi:10.1017/hgl.2021.12 Hegel Bulletin, 42/3, 480–485 © The Authors, 2021. Published by Cambridge University Press on behalf of The Hegel Society of Great Britain",
    abstract_source = "s2"
}

@misc{yonover2021tragedy,
    author = "Yonover, Jason M.",
    title = "Hegel on Tragedy and the World-Historical Individual's Right of Revolutionary Action",
    year = "2021",
    volume = "25",
    abstract = {This chapter analyzes overlooked connections between Hegel's theory of tragedy and his account of revolutionary action from a world-historical perspective. Although commentators have recently noticed parallels amid Hegel's discussion of tragedy and his philosophy of action or his philosophy of history, they haven't yet turned to questions concerning Hegel's thought and revolutionary action with his theory of tragedy in mind. In fact, relatively little has been said in recent years about the prospect of a right of revolutionary action in Hegel's ethical thought, let alone from the perspective I take here. This may be because Hegel holds the state in rather high esteem, infamously proclaiming it "the march of God in the world" (PR 258a), and therefore unsurprisingly rejects the idea that freedom of speech could license incitement to rebellion (PR 319r). My aim in this chapter is to offer an interpretation of Hegel that affirms a right of revolutionary action, overcoming these and other barriers while responding to recent accounts in the literature.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Yonover connects Hegel's theory of tragedy with his account of world-historical action, arguing that Hegel's framework can support a right of revolutionary action for world-historical individuals despite Hegel's evident reverence for the existing state (famously called "the march of God in the world") and his rejection of speech that incites rebellion. Reading world-historical agency through the lens of tragedy clarifies how such agents can be simultaneously justified by the outcome and implicated, tragically, in guilt for the means they use. RELEVANCE: Directly addresses whether world-historical individuals possess a distinctive kind of moral-political agency (and responsibility) rather than being mere passive instruments of Reason, using the tragic structure of guilt and justification as the key interpretive tool. POSITION: Revisionist, agency- and responsibility-centered reading of world-historical individuals via the theory of tragedy.},
    keywords = "world-historical-individuals, moral-responsibility, tragedy, High, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@article{hristov2022courage,
    author = "Hristov, Djordje",
    title = "Political and world-historical courage in Hegel's philosophy",
    journal = "Filozofija i drustvo",
    year = "2022",
    volume = "33",
    number = "4",
    abstract = {The aim of this article is to develop a distinction between two types of courage in Hegel's philosophy: political and world-historical, in order to show the limitations of the former. The concept of political courage, or Tapferkeit, features in Hegel's political philosophy, and signifies the wartime form of mutual trust required of the modern citizen for defense of an established constitution. World-historical courage, on the other hand, relates to the personal virtue of the "great individual", which acts as a force of destruction against decaying constitutions. The article shows that political courage for Hegel serves as an alternative to the idea of the contract as the foundation of state unity. However, when placed in comparison with world-historical courage, political courage does not fully correspond to its concept as defined by Hegel. I begin with Hegel's critique of Hobbes, his rejection of the social contract theory, and his introduction of the concept of Tapferkeit as an alternative principle of political unity. In the next step I show that world-historical courage differs but also shares many similarities with political courage, which taken together reveal the limitations of the latter. In the end, I argue that only in the instance of Hegel's conception of total war do political and world-historical courage coincide.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Hristov distinguishes two forms of courage (Tapferkeit) in Hegel: "political courage," the wartime civic virtue of the modern citizen defending an established constitution (which Hegel offers as an alternative to Hobbesian social-contract foundations of state unity), and "world-historical courage," the personal virtue of the "great individual" who acts destructively against decaying constitutions. The article argues political courage does not fully live up to its own concept except in the limit case of total war, where the two forms of courage converge. RELEVANCE: Offers a precise conceptual apparatus for distinguishing the agency of ordinary citizens sustaining the ethical state from the agency of world-historical individuals who destroy and refound it, bearing directly on how Hegel's political philosophy of legitimate institutions relates to his philosophy of history. POSITION: Revisionist reading recovering a substantive, virtue-based conception of world-historical agency rather than mere instrumentality.},
    keywords = "world-historical-individuals, state, courage, High, METADATA\_CLEANED: pages, doi"
}

@misc{james2021terror,
    author = "James, David",
    title = "Hegel and Marx on the Historical Necessity of the Terror",
    year = "2021",
    abstract = "Hegel is shown to explain the historical necessity of the phase of the French Revolution known as the Terror in terms of conceptual necessity. This conceptual necessity concerns the self-conception and understanding of how the world ought to be characteristic of agents who are committed to the idea of 'absolute' freedom. Practical necessity here plays a key role, in that it is the mediating factor between this conceptual necessity and historical necessity. It also enables Hegel to avoid introducing a standpoint that is external to the one of the agents caught up in the historical process that is being explained. Marx explains the Terror in similar terms, and his explanation of it is shown to be related to his critique of the modern state and his critique of Hegel's Philosophy of Right.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: James examines Hegel's (and, comparatively, Marx's) treatment of the Reign of Terror during the French Revolution as a test case for the claim that certain violent world-historical episodes are "historically necessary." He asks in what sense such necessity can be asserted without either exculpating the individual agents involved or collapsing into a fatalism that makes moral evaluation of the Terror pointless. RELEVANCE: Provides a concrete case study for the review's central question about world-historical individuals and events: whether historical-necessity claims are compatible with retaining moral responsibility for those who enact them, using the paradigmatic case of revolutionary violence. POSITION: Critical, responsibility-preserving reading of historical necessity applied to a limit case of political violence.},
    keywords = "determinism-contingency, moral-responsibility, world-historical-individuals, High, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@article{hodel2024prophet,
    author = "Hodel, Jonas",
    title = "Hegel as a 'backward-looking prophet'?: Kierkegaard's critique of Hegel's philosophy of history",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "46",
    number = "2",
    pages = "268--286",
    doi = "10.1017/hgl.2024.44",
    abstract = "Kierkegaard presents his critique of a Hegelian philosophy of history in the works of his Climacus pseudonym, the Philosophical Fragments and the corresponding Concluding Unscientific Postscript. It has been contested whether he addressed his arguments toward Hegel directly. In this paper, I argue that these arguments are systematically pertinent to central issues both of Hegel's as well as any other philosophical engagement with history. To make this point I proceed in three steps. First, the basic outlines of Hegel's philosophy of history are given concerning its exact subject matter, what the aim of history is, and whether the reason inherent in it allows us to conceive of historical events as necessary. Second, I will show that, though agreeing with Hegel on some points, Climacus holds that we can ascribe neither a determinist nor a conceptual kind of necessity to historical events. Finally, I will expand on Climacus's account of radical metaphysical contingency and its ethical implications which prompt some objections against philosophy of history in general.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Hodel reconstructs Kierkegaard's (Climacus's) critique of Hegelian philosophy of history from the Philosophical Fragments and Concluding Unscientific Postscript, arguing that the objection is systematically pertinent beyond its polemical target. Climacus holds that neither a determinist nor a purely conceptual kind of necessity can be ascribed to historical events, and develops instead an account of radical metaphysical contingency with ethical implications that challenge philosophy of history as such. RELEVANCE: Presents the strongest external critique of Hegelian historical necessity, giving the review a contrasting non-Hegelian (Kierkegaardian) standpoint from which to assess whether Hegel's reconciliation of necessity and contingency succeeds. POSITION: Critical, contingency-first alternative to Hegelian necessity, reconstructed via Kierkegaard/Climacus.",
    keywords = "determinism-contingency, Kierkegaard, critique, Medium"
}

@article{yang2023teleology,
    author = "Yang, Chen and Yeomans, Christopher",
    title = "Taking the Teleology of History Seriously: Lessons from Hegel's Logic",
    journal = "Hegel Bulletin",
    year = "2023",
    volume = "44",
    number = "1",
    pages = "219--240",
    doi = "10.1017/hgl.2023.7",
    abstract = "To oversimplify quite a bit, scholars' presentation of Hegel's teleology constitutes a continuum according to how more-or-less secured the progress towards the goal is supposed to be, which tracks roughly the nature of the end and its necessity. In this article, rather than focus on the end and progress towards it, we will focus on the means and structure of teleological relationships on Hegel's account. This focus follows from an essential feature of Hegel's discussion of teleology in the Logic, in which teleology is introduced to solve a problem in the individuation of entities. It will turn out that the fullest actualization of the end is in the durable means, which is also thereby individuated. And it will turn out that the paradigmatic historical means -- the state -- is tensed, as it were, between the end and its realization that makes it synchronically historical. This synchronic historicity is missing in the usual progressive and thus diachronic accounts of the teleological process of history. But first we step back even farther (at least historically). We begin by taking up the two most important philosophical accounts of teleology for Hegel, namely those of Aristotle and Kant. Then we go to Hegel's Logic for his reconstruction of teleological processes against the background of the explanatory need for individuation. We focus on four aspects of Hegel's account: that teleology is a structure of reciprocal interaction, that the purpose is an immanent governing principle, that change is the price of immanence, and that the durable means is the teleological object par excellence. Finally, we trace these features through Hegel's account of world history and conclude with some brief remarks on the historicity of the state described in the Philosophy of Right.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: Yang and Yeomans argue that Hegel's teleology, properly understood via the Science of Logic, centers not on how secured an end's realization is but on the structure of the means through which it is realized -- teleology as reciprocal interaction, with the durable means as the fullest actualization of the end. Applied to world history, they argue the state is the paradigmatic "durable means": historically produced yet also, synchronically, a stable institutional structure that individuates the teleological process. RELEVANCE: Directly addresses how the state functions as vehicle of historical progress (the second key question of this domain) by giving a logically rigorous account of the state's dual status as both product and instrument of world-historical teleology, connecting Hegel's Logic to his philosophy of history. POSITION: Structural/logical reading of the state as "durable means" of world-historical teleology, developed against both overly secured and overly loose readings of Hegelian progress.},
    keywords = "state, teleology, world-history, Medium"
}

@misc{wolsing2022nation,
    author = "Wolsing, Peter",
    title = "Hegel on Nation, Ethical Life, and the Modern State",
    year = "2022",
    number = "2",
    abstract = "This paper examines Hegel's idea of nation and its significance for his theory of the modern state, namely, the role that 'the national' plays for his justification of right in the Philosophy of Right. It is argued that Hegel strikes a balance between historicism and a rational justification of state and law. He bases the state on a notion of Sittlichkeit (ethical life) that is both national and subjected to a world historical development toward rationality and universal right. Consequently, 'nation,' in the sense of a group of people invoking identity and rights based on a primordial common language, culture, and territory, does not cover what Hegel means by the modern nation state. 'Ethical life' is national, but it also constitutes a historically changeable community of values supported by citizens' conscious participation in communal life (patriotism). Today, Hegel's idea undermines the legitimacy of nationalistic invocations of primordial ethnic cultures within politics.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Wolsing examines Hegel's idea of nation and its role in justifying the modern state's right in the Philosophy of Right, arguing that Hegel strikes a balance between historicism and rational justification: the state rests on a Sittlichkeit (ethical life) that is simultaneously national in character and subject to a world-historical development toward rationality and universal right. On this reading, "nation" for Hegel does not denote a primordial ethnic community, so his account actually undermines nationalistic invocations of primordial ethnic culture. RELEVANCE: Clarifies how the state-centered account of world history connects to Hegel's account of legitimate institutions (the second key question of this domain), showing that the ethical life underlying the state is historically dynamic rather than a fixed, naturalized foundation. POSITION: Balances historicist and rationalist readings of the Hegelian state, against nationalist appropriations of Hegel.},
    keywords = "state, ethical-life, nation, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@book{avineri1972state,
    author = "Avineri, Shlomo",
    title = "Hegel's Theory of the Modern State",
    year = "1972",
    publisher = "Cambridge University Press",
    abstract = "This study in English of Hegel's political philosophy presents an overall view of the development of Hegel's political thinking. The author has drawn on Hegel's philosophical works, his political tracts and his personal correspondence. Professor Avineri shows that although Hegel is primarily thought of as a philosopher of the state, he was much concerned with social problems and his concept of the state must be understood in this context.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Avineri argues, against readings of Hegel as primarily a metaphysical system-builder, that Hegel's theory of the state must be understood in light of his sustained concern with concrete social problems of modernity -- poverty, civil society, corporate representation -- drawing on Hegel's philosophical works, political tracts, and correspondence. The state, for Avineri's Hegel, is the institutional resolution of tensions generated within civil society, not an abstract metaphysical postulate imposed on history from outside. RELEVANCE: Foundational account of the state as "the actuality of the ethical idea," providing the baseline against which more recent treatments (Wolsing, Yang and Yeomans) of the state's role in world history should be read, and directly relevant to whether Hegel's philosophy of history and his account of legitimate institutions share a common normative ground. POSITION: Historicist-institutionalist reading of the Hegelian state grounded in social problems of modernity rather than pure metaphysics.},
    keywords = "state, ethical-life, institutions, High, METADATA\_CLEANED: doi"
}

@article{alznauer2012ethics,
    author = "Alznauer, Mark",
    title = "Ethics and History in Hegel's Practical Philosophy",
    journal = "Review of Metaphysics",
    year = "2012",
    volume = "65",
    note = "CORE ARGUMENT: Alznauer examines how Hegel's account of ethical life is structured by, and structures, his understanding of history, arguing that Hegel's practical philosophy cannot be adequately understood apart from its historical dimension -- ethical norms and the agents who act on them are themselves products of, and contributors to, historical development. (No abstract available from indexing sources; summary based on title, venue, and citation context. DOI could not be verified via CrossRef and is therefore omitted.) RELEVANCE: Connects this domain's account of agency and historical necessity to Alznauer's broader project (developed at book length in his subsequent Hegel's Theory of Responsibility) on how Hegel grounds moral and legal responsibility in historically situated ethical life, directly bearing on the responsibility of individual agents within Hegel's philosophy of history. POSITION: Historicized reading of Hegelian ethical agency, precursor to Alznauer's responsibility-centered interpretation of Hegel's practical philosophy.",
    keywords = "agency, ethical-life, moral-responsibility, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages"
}

@book{pippin2008practical,
    author = "Pippin, Robert B.",
    title = "Hegel's Practical Philosophy",
    year = "2008",
    publisher = "Cambridge University Press",
    abstract = "This fresh and original book argues that the central questions in Hegel's practical philosophy are the central questions in modern accounts of freedom: What is freedom, or what would it be to act freely? Is it possible so to act? And how important is leading a free life? Robert Pippin argues that the core of Hegel's answers is a social theory of agency, the view that agency is not exclusively a matter of the self-relation and self-determination of an individual but requires the right sort of engagement with and recognition by others. Using a detailed analysis of key Hegelian texts, he develops this interpretation to reveal the bearing of Hegel's claims on many contemporary issues, including much-discussed core problems in the liberal democratic tradition. His important study will be valuable for all readers who are interested in Hegel's philosophy and in the modern problems of agency and freedom.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Pippin argues that the core of Hegel's practical philosophy is a social theory of agency: agency is not exclusively a matter of an individual's self-relation and self-determination but essentially requires the right sort of mutual engagement with, and recognition by, others within institutionally structured ethical life (Sittlichkeit). Freedom, on this reading, is achieved only through social and institutional mediation, not by an isolated will. RELEVANCE: Supplies the theory of socially-mediated rational agency presupposed by debates over world-historical individuals and the state, clarifying why, for Hegel, individual agency (including world-historical agency) cannot be assessed apart from its institutional and social conditions. POSITION: Social/recognition-theoretic account of Hegelian rational agency as ethical life, foundational for subsequent agency-centered readings of Hegel's philosophy of history.",
    keywords = "agency, ethical-life, recognition, High, METADATA\_CLEANED: doi"
}

@misc{brinkmann2000system,
    author = "Brinkmann, Klaus",
    title = "System and History in Hegel",
    year = "2000",
    note = {CORE ARGUMENT: Brinkmann poses a sharp version of the determinism problem: Hegel's claim (Encyclopaedia Sec. 14) that the historical development of spirit follows its systematic development implies both that the system's structure precedes its historical unfolding and that history is thereby rendered deterministic, in tension with Hegel's simultaneous description of that development as a "play" of the Idea with itself. Brinkmann argues that preserving the primacy of system over history while avoiding determinism requires amending Hegel's position with the Aristotelian distinction (which Hegel himself neglects) between hypothetical and absolute necessity. (No abstract available from indexing sources; summary based on title, venue, and PhilPapers snippet.) RELEVANCE: States the strong-determinism worry in its most precise logical form and proposes a specific conceptual repair (hypothetical vs. absolute necessity), giving the review a rigorous benchmark against which the "demystifying" readings (Bykova, Hodel, Pinkard) can be measured. POSITION: Diagnoses a genuine determinism problem in Hegel's system/history relation and proposes an Aristotelian-inspired revision rather than an interpretive dissolution of the problem.},
    keywords = "determinism-contingency, system, necessity, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{bernasconi2000withwhat,
    author = "Bernasconi, Robert",
    title = "With What Must the Philosophy of World History Begin? On the Racial Basis of Hegel's Eurocentrism",
    year = "2000",
    volume = "22",
    number = "2",
    note = {CORE ARGUMENT: Bernasconi argues that Hegel held members of racial groups to share fundamental, heritable moral, intellectual, and cultural characteristics not shared across races, and that these differences supported an objective ranking -- i.e., that Hegel's use of "race" was philosophically racialist rather than a loose or incidental figure of speech. The article traces how Hegel revised his account of the "geographical basis of world history" across successive lecture cycles as new travel and ethnographic literature became available, showing the exclusions hardened rather than softened over time. RELEVANCE: This is a foundational statement of the "structural" reading that the review's key questions ask about directly: it argues Hegel's exclusion of non-European peoples from "genuine" history is not incidental prejudice but bound up with his conception of how spirit, freedom, and historical development are conceptually linked to race. POSITION: Structural/thoroughgoing critique -- racism as internal to Hegel's methodology, not merely his data.},
    keywords = "Hegel, Eurocentrism, race, philosophy of history, High, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "(2000). With what must the philosophy of world history begin? On the racial basis of Hegel's eurocentrism. Nineteenth-Century Contexts: Vol. 22, Race and social theory, pp. 171-201.",
    abstract_source = "openalex"
}

@misc{bernasconi2002ashanti,
    author = "Bernasconi, Robert",
    editor = "Barnett, Stuart",
    title = "Hegel at the Court of the Ashanti",
    publisher = "Routledge",
    year = "2002",
    note = {CORE ARGUMENT: Using Hegel's specific (and inaccurate) remarks about the Ashanti kingdom as a case study, Bernasconi examines how Hegel's ethnographic sourcing -- drawn from travel narratives and colonial reports rather than direct engagement -- shaped his depiction of African societies as lacking law, subjectivity, and historical agency, feeding directly into the "no historical part of the World" verdict on Africa in the Introduction to the Lectures on the Philosophy of World History. RELEVANCE: Provides a concrete textual case bearing directly on the review's question of exactly what Hegel says about Africa and how these specific claims function within the teleological schema that excludes Africa from history proper. POSITION: Structural/thoroughgoing critique, via close textual-historical analysis of Hegel's sources.},
    keywords = "Hegel, Africa, Ashanti, philosophy of history, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Eating My God - 1",
    abstract_source = "openalex"
}

@article{bernasconi2024egypt,
    author = "Bernasconi, Robert",
    title = "Hegel and Egypt's African Element",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "1",
    pages = "6--22",
    doi = "10.1017/hgl.2024.2",
    abstract = "Contrary to the widespread view that Hegel excluded Africa from what he called world history proper, the specifically African element of Egypt was indispensable to his account of the pivotal dialectical moment that saw spirit's release from its immersion in nature. Hegel's racist caricature of Africans in the early part of the lectures was not gratuitous, something that commentators can leave to one side. It was integral to his dialectical account of world history because it served to generate the contradiction that saw the Persian Empire give way to Greece. This understanding is confirmed by the newly completed four-volume edition of Hegel's Lectures on the Philosophy of World History in the Gesammelte Werke.",
    note = {CORE ARGUMENT: Bernasconi complicates the standard reading that Hegel simply excludes Africa wholesale: Egypt's "African element" was in fact indispensable to Hegel's dialectic, since the racialized caricature of sub-Saharan Africa in the early lectures generated the very contradiction whose resolution (the passage from Persia to Greece) drives world history forward. The racism is thus shown to be functionally integrated into, not merely appended to, the dialectical narrative. RELEVANCE: Directly answers the review's key question of whether exclusion is incidental or structurally required -- Bernasconi's answer here is that even Hegel's partial "inclusion" of Africa (via Egypt) is itself in the service of the racial hierarchy, strengthening the structural reading. POSITION: Structural/thoroughgoing critique, refining the thesis with new archival evidence from the Gesammelte Werke edition.},
    keywords = "Hegel, Africa, Egypt, race, philosophy of history, Medium"
}

@misc{bernasconi2003reply,
    author = "Bernasconi, Robert",
    title = "Hegel's Racism: A Reply to McCarney",
    year = "2003",
    note = {CORE ARGUMENT: Written as a direct reply within a published exchange, Bernasconi responds to Joseph McCarney's objection that Hegel's racial remarks are separable from his core philosophical claims about freedom and history. Bernasconi reasserts that the racial hierarchy is embedded in Hegel's account of how peoples become vehicles of Spirit, rather than being an extraneous empirical error that could in principle be excised without damage to the system. RELEVANCE: This short exchange piece makes the "incidental vs. structural" debate explicit and adversarial, directly modeling the interpretive fork the review needs to represent -- it shows a contextualizing/defensive reading (McCarney's, addressed but not separately verifiable here) being directly contested by the leading critical voice. POSITION: Structural/thoroughgoing critique, articulated polemically against a defense/contextualization reading.},
    keywords = "Hegel, racism, Eurocentrism, McCarney, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@misc{buckmorss2009haiti,
    author = "Buck-Morss, Susan",
    title = "Hegel, Haiti, and Universal History",
    year = "2009",
    note = {CORE ARGUMENT: Buck-Morss argues that Hegel's master-slave dialectic in the Phenomenology of Spirit was shaped by his likely awareness, via widely circulated periodicals, of the Haitian Revolution -- making the dialectic of lordship and bondage a response to a real, contemporary, non-European struggle for freedom rather than a purely abstract or intra-European construction. She contends this makes Hegel's account, at least in this moment, more genuinely universal-historical than his later, more explicitly Eurocentric philosophy of history, which she reads as a retreat from this earlier universalism. RELEVANCE: Offers the review's clearest case of "selective retrieval" rather than wholesale rejection: it locates a moment of genuine universal-historical insight within Hegel's corpus and argues this stands in tension with, rather than simply confirming, his subsequent explicit exclusion of Africa and the Americas from world history. POSITION: Selective retrieval / immanent critique -- recovers a radical universalist moment against Hegel's own later Eurocentrism.},
    keywords = "Hegel, Haiti, universal history, slavery, dialectic, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Buck-Morss draws new connections between history, inequality, social conflict, and human emancipation through a fundamental reinterpretation of Hegel's master-slave dialectic. Historicizing the thought of Hegel and the actions taken in the Haitian Revolution, Buck-Morss examines the startling connections between the two and challenges us to widen the boundaries of our historical imagination",
    abstract_source = "openalex"
}

@misc{serequeberhan1989idea,
    author = "Serequeberhan, Tsenay",
    title = "The Idea of Colonialism in Hegel's Philosophy of Right",
    year = "1989",
    number = "3",
    note = "CORE ARGUMENT: Serequeberhan argues that for Hegel freedom can be practiced and recognized only in classical, Christian, and modern Europe, so that non-European peoples can acquire freedom only through Europe's colonial imposition of its own civilization upon them -- a denial of freedom Hegel treats as legitimate because it is, on his view, the sole route by which colonized peoples can eventually attain freedom themselves. The article then asks whether Hegel's account of freedom as self-determination can be extricated from this Eurocentric, pro-colonial application of it. RELEVANCE: A founding text of the Africana immanent-critique response named explicitly in the task brief: rather than simply rejecting Hegel, Serequeberhan interrogates whether Hegel's own concept of freedom can be turned against his Eurocentric deployment of it, directly informing the review's question about how Africana philosophers have responded to Hegel's exclusions. POSITION: Immanent critique -- uses Hegel's own concept of freedom against his Eurocentric application of it in the Philosophy of Right.",
    keywords = "Hegel, colonialism, Africana philosophy, Serequeberhan, philosophy of right, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@book{park2013africa,
    author = "Park, Peter K. J.",
    title = "Africa, Asia, and the History of Philosophy: Racism in the Formation of the Philosophical Canon, 1780--1830",
    publisher = "State University of New York Press",
    year = "2013",
    note = {CORE ARGUMENT: Park documents a decisive historiographical shift between 1780 and 1830 in which Africa and Asia -- previously included as sources of philosophy in Enlightenment-era histories -- were systematically written out of the history of philosophy, redefined as belonging only to religion, myth, or "pre-philosophical" thought. He argues Hegel's lectures on the history of philosophy were a decisive instrument in consolidating this exclusively European definition of "philosophy" itself. RELEVANCE: Situates Hegel's exclusion of Africa and much of Asia from "genuine" history within the much broader canon-formation process the review's key questions ask about -- showing the philosophy-of-history exclusions are continuous with, and partly constitutive of, the exclusion of non-European thought from the history of philosophy as a discipline. POSITION: Structural/thoroughgoing critique, extended to the historiography of philosophy as a discipline rather than only the philosophy of history.},
    keywords = "Eurocentrism, canon formation, history of philosophy, racism, Hegel, High, METADATA\_CLEANED: doi",
    abstract = {While its title might suggest a relatively straightforward overview of moral philosophy in the classical Indian tradition, Shyam Ranganathan's book is no mere survey.Instead, it is a critical, revisionist, and systematic argument for the centrality of ethics in classical Indian philosophy, as against the more common view that, while there is an abundance of rigorous work in epistemology, metaphysic, logic, etc., in the Indian tradition, there is a paucity of such work in ethics.In order to make his case for the centrality of ethics in Indian philosophy, Ranganathan develops an ambitious and controversial account of the term "dharma" (a term that has a wide variety of referents and is generally thought to have widely divergent uses) as fundamentally and always a moral term.Further, in the course of defending his revisionist account of the term "dharma," he develops novel -- and again controversial -- approaches to determining the meaning of terms in general and of moral terms in particular.Thus the first two-thirds of the book is taken up with issues in the philosophy of language and meta-ethics.Then, having laid the groundwork for his approach to Indian ethics, in the final third of the book Ranganathan turns his attention to an examination of some of the key ethical themes in the various schools of classical Indian philosophy.This section is quite comprehensive, with chapters on Buddhism, Jainism, Såîkhya and Yoga, Nyåya-Vaiùeúika, Mëmåîsa, Vedånta, Cårvåka, and a summary of Indian ethics.Finally, he concludes the book with a thoughtful discussion of the importance of ethics to Indian philosophy and of the importance of Indian ethics as such. abstract\_source = {ndpr}, Renowned scholar of Indian philosophy, B. K. Matilal, expresses a fairly common view of the tradition when he remarks: Professional philosophers of India over the last two thousand years have been consistently concerned with the problems of logic and epistemology, metaphysics and soteriology, and sometimes they have made very important contributions to the global heritage of philosophy.But, except some cursory comments and some insightful observations, the professional philosophers of India have very seldom discussed what we call "moral philosophy" today.(4) It is this type of view that Ranganathan sets out to argue against and, as mentioned above, he does so by putting forward a hermeneutically ambitious and controversial reading of the term "dharma."It is widely agreed that "dharma" can refer to moral and social norms, and thus that it can sometimes mean "ethics" or "morality".Hence, as Ranganathan argues, "if we could translate 'dharma' into 'ethics' or 'morality', consistently, we would then be justified in viewing references to 'dharma' in Indian philosophical literature as marking Indian thought on moral matters" (6).And from there one could begin to assess the importance of ethics in Indian thought. However, a problem with this approach immediately arises in that, on the standard view, not all dharma discourse is moral discourse.According to what the author terms the Orthodox View, "dharma" has a number of different meanings (it can denote morality, justice, intrinsic quality, an ontologically basic event or property, etc.) and therefore the term cannot be consistently translated by a single term.Alternatively, according to the so-called Conservative View, the various uses of "dharma" are explained etymologically.(For instance, "dharma" is said to derive from the root "dhô", meaning to support or uphold.Hence, the term can refer to moral lawandto ontologically basic entities.)Ranganathan rejects both of these views in favor of what he calls the Reform View, which consists of two theses.First, "'dharma', in the language of Indian philosophy, stands for one concept with a clear moral meaning -- the concept ofethicalormoral."Second, "the concept that the terms 'dharma' and 'moral' stand for furnishes the common, semantic ground for the meaningful philosophical disagreement on the topic of ethics" (13). But if, as the author admits, "dharma" can, in different contexts, refer to quite a disparate range of things -- attributes, ritual, constituents of reality, and so on (22) -- on what basis can he claim that the term always means "moral"?It would appear that the Orthodox View is supported; "dharma" sometimes means "moral" and sometimes it does not.Ranganathanrespondsto this line of thought by arguing that "dharma" should not be defined in terms of its referents, but rather in terms of the intention with which it is used.In his terminology, a term can be defined either by its typicalextention(i.e., its typical referents) or by the typicalintentionwith which the term is used, or some combination thereof.Thus anextentionaldefinition of a term will be based primarily on the (kinds of) objects to which that term refers, while anintentionaldefinition will be based primarily on the attitude or intentions of the user of the term.For instance, the term "pleasurable" may be applied to a very wide and internally inconsistent range of extentions.If one were to try to define it extentionally, one might be led to hold that the masochist and the nonmasochist simply do notmeanthe same thing when using the term.However, defined intentionally, in terms of a having a positive disposition toward one's referent (whatever it is), "pleasure" can mean the same thing for the masochist and the nonmasochist alike (19). So, on Ranganathan's account, the Orthodox View rests on the faulty assumption that "dharma" should be defined extentionally.Once this assumption is made, recognizing the disparate extentions of the term naturally leads to the conclusion that it has no single meaning, and hence no single English equivalent.In contrast, the author holds that while "dharma" has quite disparate extentions, it has only one intentional meaning: "moral." Moreover, he argues that moral terms (like "dharma" on his view) should be defined purely intentionally -- that is, there should be no extentionalist constraints on whether "dharma" should (always) be defined as a moral term.Thus, for example, Buddhist philosophers at times use "dharma" to refer to the basic constituents of reality in the context of discussions about, for instance, the number and types of these constituents, whether composite entities are reducible to them, how they interact causally, and so on.In such a case it would be tempting to think that what the Buddhist philosophers are up to here isontologyand not ethics, and therefore, given what it refers to in this context, that "dharma" is being used in a non-moral sense.But Ranganathan argues that we ought to resist this temptation because it is likely to lead to question-begging assumptions about the scope of morality in the Indian tradition (26). The idea here is that, "the only plausible way that the Extentionalist could exclude considering 'dharma' as a persistent moral term in Indian philosophy is by having decided, in advance, whatextentionsare moral in nature, and what are not" (26).If it is decided in advance that, whatever morality is about, it isn't about the constituents of reality, then we may have begged the question against those in the Indian tradition who might hold that this is a proper subject-matter for moral philosophy.The Buddhist philosophers may look like they are doing ontology and not ethics, and therefore that "dharma" is not being used as a moral term in this context, but that might well be because there is a substantive philosophical disagreement over the proper scope of the moral.}
}

@article{james2024introduction1,
    author = "James, Daniel and Knappik, Franz",
    title = "Introduction to Part 1 of the Themed Issue, `Racism and Colonialism in Hegel's Philosophy': Rationale and Topics",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "1",
    pages = "1--5",
    doi = "10.1017/hgl.2024.14",
    abstract = "It is increasingly realized today that Western modernity has not only promoted progressive ideals such as scientific thought, human rights and democratic political systems. Its history is also marked by a much darker side, one of brutal conquest, biological and cultural destruction, enslavement and exploitation of non-European peoples in the context of European colonialism. This dark side of Western modernity was legitimized by pro-colonial ideologies of property, war, civilization, progress and race. Such ideologies emerged in areas like jurisprudence and philosophy since the 16th century, often building on views from classical antiquity. They shaped academic paradigms such as `scientific racism', colonial anthropology and Orientalism in the 19th and early 20th centuries, and in many ways continue to influence contemporary societies and their academic practices.",
    note = "CORE ARGUMENT: This editorial introduction frames a major Hegel Bulletin themed issue by situating Hegel's racism and pro-colonial views within the wider history of philosophical legitimations of European colonialism since the sixteenth century, and outlines the issue's guiding questions about how deeply these views are embedded in Hegel's systematic philosophy. RELEVANCE: Provides the review with an authoritative, current (2024) statement of why this debate matters and how it has been organized by leading specialists, useful for framing the synthesis section on Eurocentrism and race. POSITION: Framing/metaphilosophical overview, editorially neutral between structural-critique and contextualizing positions represented in the issue.",
    keywords = "Hegel, colonialism, racism, Hegel Bulletin, themed issue, Medium"
}

@article{james2024introduction2,
    author = "James, Daniel and Knappik, Franz",
    title = "Introduction to Part 2 of the Themed Issue, `Racism and Colonialism in Hegel's Philosophy': Common Objections and Questions for Future Research",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "2",
    abstract = "In the first part of our editorial introduction to the themed issue `Racism and Colonialism in Hegel's Philosophy' we outlined its rationale and some of its main topics. Here we address some common objections against research of this kind and formulate questions for further research.",
    note = {CORE ARGUMENT: The editors catalogue and respond to standard objections to the project of critically examining Hegel's racism and colonialism (e.g., presentism, selective reading, separability of the "core" philosophy from incidental remarks), and propose an agenda of open questions -- notably whether racial hierarchy is required by the logic of Hegel's Concept (Begriff) or only contingently associated with it. RELEVANCE: Directly addresses the review's key question of whether exclusion is incidental or structurally required by cataloguing the standard defensive moves and assessing their force, making it useful for structuring a balanced presentation of both critical and contextualizing positions. POSITION: Framing/metaphilosophical overview, explicitly cataloguing objections raised by contextualizing/defense positions.},
    keywords = "Hegel, colonialism, racism, Hegel Bulletin, themed issue, Medium, METADATA\_CLEANED: pages, doi"
}

@article{goggin2024race,
    author = "Goggin, W. Ezekiel",
    title = "Race and Colonialism in Hegel's Philosophy of Religion",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "2",
    abstract = "Scholars have paid limited attention to the crucial relationship between Hegel's racism, his support for colonialism and his views on religion. This essay offers a critical reconstruction of how race and coloniality shape the question of religion (and vice versa) throughout Hegel's attempts to critique and ultimately vindicate European modernity. Paying special attention to the seminal role of `fetishism' in his works, I argue that Hegel's intellectual concerns are racialized from the inception of his project. I conclude by suggesting an alternative philosophical approach to the concept of the `fetish' and `fetishism' to resist Hegel's racist and pro-colonial tendencies.",
    note = {CORE ARGUMENT: Goggin argues that Hegel's account of African "fetishism" as the paradigmatically primitive form of religion is not a peripheral anthropological aside but is racialized "from the inception" of Hegel's project of vindicating European modernity through the philosophy of religion, tying religious development directly to the same racial hierarchy operative in the philosophy of history. RELEVANCE: Extends the review's account of Hegel's exclusion of Africa beyond the Philosophy of History narrowly construed, showing the same hierarchical logic operating in the Philosophy of Religion's account of "fetishism," reinforcing the structural reading. POSITION: Structural/thoroughgoing critique, extended into the philosophy of religion.},
    keywords = "Hegel, race, religion, fetishism, colonialism, Medium, METADATA\_CLEANED: pages, doi"
}

@article{mascat2024postcolonial,
    author = "Mascat, Jamila M. H.",
    title = "Hegel, Colonialism and Postcolonial Hegelianism",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "45",
    number = "1",
    abstract = {This article aims to shed light on Hegel's conception of colonialism and its implications for the postcolonial reception of Hegel. Drawing on the abundant literature on the topic, it begins by engaging with Hegel's understanding of colonialism through a close reading of relevant passages of his works... the article argues that his account of Europe's modern colonial expansion is based primarily on economic considerations, rather than on civilizational assumptions proclaiming the spiritual superiority of European peoples -- to which Hegel nevertheless subscribes. The conclusion explores distinct and divergent postcolonial perspectives for engaging with the contemporary legacy of Hegelianism, contrasting Tibebu's reading of Hegel's enterprise as "the coldest rationalisation of genocidal murder and carnage" with Brennan's more redemptive reading of Hegel's contribution to twentieth-century anticolonial thought.},
    note = "CORE ARGUMENT: Mascat reconstructs Hegel's conception of colonialism across the Naturrecht lectures, the Grundlinien, and the Weltgeschichte lectures, arguing it rests primarily on economic considerations about surplus population and civil society's internal contradictions, even though Hegel nevertheless also subscribes to claims of European spiritual superiority. She then surveys sharply divergent postcolonial receptions of Hegel, from Tibebu's wholesale condemnation to more redemptive readings of Hegel's influence on anticolonial thought. RELEVANCE: Directly addresses the review's question about how the postcolonial reception has ranged from thoroughgoing rejection to selective retrieval, providing a synoptic map of that spectrum of responses (Tibebu vs. more redemptive readings) alongside its own textual argument about the economic basis of Hegel's colonialism. POSITION: Postcolonial reception survey combined with a contextualizing argument about the economic (rather than purely civilizational) basis of Hegel's account of colonialism.",
    keywords = "Hegel, colonialism, postcolonialism, civil society, Medium, METADATA\_CLEANED: pages, doi"
}

@misc{terada2019racism,
    author = "Terada, Rei",
    title = "Hegel's Racism for Radicals",
    year = "2019",
    note = {CORE ARGUMENT: Terada develops the notion of "metaracial logic" -- the transposition of racial hierarchy from biological essence into stances toward reality itself -- and locates its rise in Hegel's World History and Philosophy of Religion lectures. She argues this metaracial pattern, which conflates Blackness with "racialism" and treats it as mutually exclusive with mature political identity, persists not only in liberal thought but within radical philosophy and left political activity that takes itself to have moved beyond racism. RELEVANCE: Extends the review's engagement with Hegel's racism beyond historical exegesis into a claim about its afterlife in contemporary "postracial" and even radical/left political thought, relevant to any assessment of the continuing stakes of the debate. POSITION: Structural/thoroughgoing critique, with an emphasis on the concept's contemporary political afterlife rather than only its historical-textual basis.},
    keywords = "Hegel, racism, radical philosophy, race theory, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@article{egid2024hatata,
    author = "Egid, Jonathan",
    title = {Hegel and the Hatätá Zär'a Ya`èqob: Africa in the Philosophy of History and the History of Philosophy},
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "46",
    number = "2",
    pages = "287--310",
    doi = "10.1017/hgl.2024.33",
    abstract = {This article explores an episode in the reception of Hegel's philosophy of history and historiography of philosophy with reference to the question of the possibility of non-Western philosophy, in particular African philosophy. Section I briefly outlines the contents of the Hatätá Zär'a Yaèqob and the controversy over its authorship... Section II suggests that a major component of the intellectual background to the notion of the impossibility of philosophy in Africa can be traced to Hegel's philosophy of history... Section III connects this Hegelian conception to Carlo Conti Rossini's work, both his article on the Hatata and as apologist for Italian imperialism, reflecting on what this underexplored connection might mean for attempts to construct global histories of philosophy.},
    note = {CORE ARGUMENT: Egid traces how Hegel's philosophy of history -- which links historical development to cultural production culminating in philosophy, and maps both onto particular geographical-historical populations -- became the intellectual background for early-twentieth-century Ethiopianist scholar Carlo Conti Rossini's denial that "rationalistic" philosophy was possible in Ethiopia, despite the existence of the seventeenth-century Hatata Zera Yacob text. He argues this connection, though not Hegel's intention, provided a cultural justification for political domination: peoples judged unfree because unphilosophical, and unphilosophical because unfree. RELEVANCE: Provides a concrete historical case study of how Hegel's exclusion of Africa from "genuine" history and philosophy was operationalized by later scholars to deny the existence of an actual African philosophical tradition, directly bearing on the review's question about the historiographical function of Hegel's "peoples without history" thesis. POSITION: Structural/thoroughgoing critique, traced through its reception history and its use in early-twentieth-century colonial apologetics.},
    keywords = "Hegel, Africa, Ethiopia, Africana philosophy, historiography, Medium"
}

@misc{habib2017india,
    author = "Habib, M. A. R.",
    title = "Hegel and India: The Aesthetics of Eurocentrism",
    year = "2017",
    note = {CORE ARGUMENT: Habib examines Hegel's treatment of Indian thought and religion, arguing that Hegel's aesthetic and philosophical judgments about India's "immediate" and undifferentiated form of spirituality function to place India within, yet subordinate to, the world-historical narrative -- a "childhood" stage of Spirit rather than the wholesale exclusion Hegel applies to Africa. RELEVANCE: Provides material directly relevant to the review's question about how Hegel treats China and India differently from Africa within his teleological schema -- India is assigned a place within history's early stages rather than excluded from history altogether, a distinction the review needs to represent accurately. POSITION: Structural/thoroughgoing critique, applied specifically to the case of India rather than Africa.},
    keywords = "Hegel, India, Eurocentrism, Orientalism, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{smith2018china,
    author = "Smith, Justin E. H.",
    title = "Hegel, China, and the 19th Century Europeanization of Philosophy",
    year = "2018",
    volume = "45",
    note = {CORE ARGUMENT: Smith situates Hegel's dismissal of Chinese thought as lacking genuine philosophical (as opposed to merely moral or proverbial) content within the broader nineteenth-century process by which "philosophy" was redefined as an exclusively European category, arguing Hegel's specific judgments about Confucian and Daoist thought were decisive in excluding Chinese thought from the emerging disciplinary self-understanding of philosophy. RELEVANCE: Fills the review's need for material specifically addressing Hegel's treatment of China (distinct from India and Africa), showing a parallel but distinct exclusionary mechanism operating in the historiography of philosophy proper rather than only the philosophy of history. POSITION: Structural/thoroughgoing critique, applied specifically to the case of China and connected to the disciplinary history of philosophy (complementing Park's broader canon-formation thesis).},
    keywords = "Hegel, China, Eurocentrism, history of philosophy, Low, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "I clarify Hegel's role in the Europeanization of philosophy over the course of the 19th century. I begin with an investigation of the way non-Western philosophy was conceptualized in Europe before, and after, I move on to a consideration of the debates about philosophy that emerged in late 19th century China because of European attempts, such as that of Hegel, to circumscribe the geographical and civilizational scope of this discipline. How may we see the emergence of a distinctly modern, generally nationalist, discourse about “Chinese philosophy” within China as a reflection of larger global processes then taking place?",
    abstract_source = "openalex"
}

@misc{mowad2012nationality,
    author = "Mowad, Nicholas",
    editor = "Nuzzo, Angelica",
    title = "The Place of Nationality in Hegel's Philosophy of Politics and Religion: A Defense of Hegel on the Charges of National Chauvinism and Racism",
    publisher = "State University of New York Press",
    year = "2012",
    note = "CORE ARGUMENT: Mowad analyzes Hegel's conception of nationality and its relation to the state and religion, arguing that when properly understood in context, Hegel's claims about different peoples' historical roles do not amount to national chauvinism or racism in any objectionable sense, since Hegel's account of a people's Volksgeist is compatible with mutual recognition and does not entail the fixed biological hierarchy attributed to him by critics. RELEVANCE: Provides the review with an explicit, sustained defense position responding directly to the racism and chauvinism charges, necessary for the critically balanced presentation of positions the review requires rather than treating the critique of Hegel as uncontested. POSITION: Defense/contextualization -- denies that Hegel's claims about national/historical difference amount to racism or chauvinism as usually charged.",
    keywords = "Hegel, nationality, defense, racism, chauvinism, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@incollection{buchwalter2010eurocentric,
    author = "Buchwalter, Andrew",
    editor = "Dudley, Will",
    title = "Is Hegel's Philosophy of History Eurocentric?",
    booktitle = "Hegel and History",
    publisher = "State University of New York Press",
    year = "2010",
    pages = "87--110",
    doi = "10.2307/jj.18253369.9",
    note = "CORE ARGUMENT: Buchwalter argues that while Hegel's philosophy of history contains genuinely Eurocentric elements, its deeper theoretical commitments -- particularly its account of freedom as requiring mutual recognition and its critique of one-sided, non-reciprocal relations of domination -- provide resources for a self-correcting critique of Eurocentrism from within Hegel's own framework, rather than requiring its wholesale rejection. RELEVANCE: Offers the review a sophisticated contextualizing position distinct from simple denial of Hegel's Eurocentrism: it grants the charge partially while arguing Hegel's systematic commitments to mutual recognition can be mobilized against his own Eurocentric applications, informing the review's question of whether exclusion is incidental or structurally required. POSITION: Contextualization with an immanent-critique dimension -- concedes real Eurocentrism while arguing the system contains internal resources against it.",
    keywords = "Hegel, Eurocentrism, recognition, philosophy of history, High, INCOMPLETE, no-abstract"
}

@misc{harris2026debating,
    author = "Harris, Kimberly Ann and James, Daniel",
    title = "Debating Hegel's Racism",
    year = "2026",
    volume = "21",
    number = "1",
    abstract = "This article examines the debate over Hegel's views on race and their place within his philosophical system. While some scholars regard his racial remarks as incidental or environmentally based, others argue they reflect a hierarchical racialism embedded in his metaphysics and methodology. The article contends that Hegel's framework links natural and cultural traits to normative and political status, shaping key concepts such as spirit, freedom and historical development. It concludes that Hegel's philosophy exemplifies philosophical racism, raising important questions about the enduring influence of his ideas on conceptions of freedom, personhood and historical progress.",
    note = "CORE ARGUMENT: Harris and James survey the contemporary debate over whether Hegel's racial remarks are incidental/environmentally based or reflect a hierarchical racialism embedded in his metaphysics and methodology, concluding that the evidence supports the latter: Hegel's framework links natural and cultural traits to normative and political status in a way that makes his philosophy an instance of philosophical racism proper. RELEVANCE: Functions as an up-to-date synoptic overview of exactly the interpretive fork structuring this domain (incidental vs. structural), making it an ideal framing/orientation piece for the review's treatment of Hegel's Eurocentrism and racism. POSITION: Survey/framing piece that ultimately endorses the structural/thoroughgoing critique position after canvassing the alternatives.",
    keywords = "Hegel, racism, survey, metaphysics, freedom, High, METADATA\_CLEANED: journal, doi, type:@article->@misc"
}

@book{hegel1991elements,
    author = "Hegel, Georg Wilhelm Friedrich",
    editor = "Wood, Allen W.",
    title = "Elements of the Philosophy of Right",
    year = "1991",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    howpublished = "Cambridge University Press, 1991",
    note = {CORE ARGUMENT: In §324 (with its Remark and Addition), Hegel argues that war is not merely an external accident befalling ethical life but has "the higher significance that through it... the ethical health of peoples is preserved in their indifference towards the stabilization of finite institutions," just as the motion of the winds preserves the sea from the stagnation that a prolonged calm would produce; §338 nonetheless affirms that war "is that of something which ought to come to an end" and that even in war a "possibility of peace" and mutual recognition between states must be maintained, while §340 subordinates all international right to "world history as the world's court of judgement." RELEVANCE: This is the primary text at the center of Key Question 1 and cannot be omitted from any treatment of war in Hegel's philosophy of history; §340's invocation of world history as final judge also connects directly to the end-of-history debates addressed by Kojève and Fukuyama. POSITION: Primary source; the textual basis contested by all the secondary literature on Hegel and war collected in this domain.},
    keywords = "war, PR-324, primary-source, High",
    abstract = "This book is a translation of a classic work of modern social and political thought, Elements of the Philosophy of Right. Hegel's last major published work, is an attempt to systematize ethical theory, natural right, the philosophy of law, political theory and the sociology of the modern state into the framework of Hegel's philosophy of history. Hegel's work has been interpreted in radically different ways, influencing many political movements from far right to far left, and is widely perceived as central to the communication tradition in modern ethical, social and political thought. This edition includes extensive editorial material informing the reader of the historical background of Hegel's text, and explaining his allusions to Roman law and other sources, making use of lecture materials which have only recently become available. The new translation is literal, readable and consistent, and will be informative and scholarly enough to serve the needs of students and specialists alike",
    abstract_source = "core"
}

@article{avineri1961problem,
    author = "Avineri, Shlomo",
    title = "The Problem of War in Hegel's Thought",
    journal = "Journal of the History of Ideas",
    year = "1961",
    volume = "22",
    number = "4",
    pages = "463",
    doi = "10.2307/2708025",
    note = {CORE ARGUMENT: Avineri examines the apparent tension between Hegel's insistence that war has a positive, ethically preservative function (PR §324) and his simultaneous rejection of any straightforward militarism, arguing that Hegel's account of war must be situated within his broader theory of the state and international recognition rather than read as a stand-alone endorsement of conflict. RELEVANCE: One of the earliest and most frequently cited treatments of Hegel on war; the Stanford Encyclopedia entry on Hegel's Social and Political Philosophy cites this paper directly in its own discussion of whether war plays "a positive, and troubling, role" in Hegel's philosophy (SEP §11, "War and International Relations"), making it a natural anchor for Key Question 1. POSITION: Foundational statement of the "qualified/functional" reading of Hegel on war, against which later commentators (Walt, Tyler) position their own arguments.},
    sep_context = {SEP "Hegel's Social and Political Philosophy" §11 (War and International Relations) cites Avineri 1961 alongside Black 1973, Shelton 2000, and Walt 1989 as evidence that Hegel's rejection of Kantian perpetual peace, combined with his claim that war tests "the relative health of states," "has led some to question whether or not war plays a positive, and troubling, role in his philosophy."},
    keywords = "war, PR-324, ethical-life, High, INCOMPLETE, no-abstract"
}

@article{walt1989hegel,
    author = "Walt, Steven",
    title = "Hegel on War: Another Look",
    journal = "History of Political Thought",
    year = "1989",
    volume = "10",
    howpublished = "History of Political Thought 10 (1989): 113--124",
    note = {CORE ARGUMENT: Walt revisits and reassesses prior interpretations of Hegel's account of war (including Avineri's), arguing for a reading of PR §324 attentive to the precise logical role war plays within Hegel's account of sovereignty and ethical life, rather than treating the passage as either a simple glorification of conflict or a merely descriptive aside. RELEVANCE: Directly engages Key Question 1 ("How do interpreters read §324?") as an explicit response to earlier scholarship, and is itself cited by the Stanford Encyclopedia entry on Hegel's Social and Political Philosophy as part of the debate over whether war carries positive normative weight in Hegel's system. POSITION: A revisionist contribution to the "qualified/functional" camp, explicitly framed as a second look at claims made by Avineri and others.},
    sep_context = {SEP "Hegel's Social and Political Philosophy" §11 (War and International Relations) cites Walt 1989 alongside Avineri 1961, Black 1973, and Shelton 2000 as part of the scholarship questioning "whether or not war plays a positive, and troubling, role" in Hegel's philosophy.},
    keywords = "war, PR-324, ethical-life, sep-sourced-metadata, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages"
}

@article{tyler2004hegel,
    author = "Tyler, Colin",
    title = "Hegel, war and the tragedy of imperialism",
    journal = "History of European Ideas",
    year = "2004",
    volume = "30",
    number = "4",
    pages = "403--431",
    doi = "10.1016/j.histeuroideas.2003.11.017",
    note = {CORE ARGUMENT: Tyler contextualizes Hegel's remarks on war within his interpretation of Napoleon's "world-historic mission" and distinguishes three categories of conflict in Hegel's international theory: wars among "civilised" states, colonial expansion driven by capitalist under-consumption, and conflict between "civilised" and "barbarous" peoples; he traces a "tragic dynamic" underlying Hegel's discussion of war in the Philosophy of Right and concludes that it is "misleading to claim that Hegel glorified conflict and war." RELEVANCE: Provides a direct, explicit answer to Key Question 1 ("Does Hegel glorify or merely explain the necessity of war?") and complicates the picture by showing how Hegel's account of war intersects with his (more troubling) treatment of colonialism and non-European peoples — a point of contact with the Eurocentrism literature (Buchwalter) also collected in this domain. It also denies that Hegel treats domination by "civilised states" as the final stage of world history, which bears on how §340's "world history as world court" should be read in relation to end-of-history questions. POSITION: Explicitly anti-glorification reading that nonetheless takes seriously the imperial and colonial dimensions of Hegel's international theory, distinguishing it from both apologetic and simplistically damning readings.},
    keywords = "war, imperialism, PR-324, Napoleon, High",
    abstract = "This article contextualises Hegel's writings on international order, especially those concerning war and imperialism. The recurring theme is the tragic nature of the struggles for recognition which are instantiated by these phenomena. Section one examines Hegel's analysis of the Holy Roman Empire in the context of French incursions into German territories, as that analysis was developed in his early essay on ‘The German Constitution’ (1798–1802). The significance of his distinction between the political and civil spheres is explored, with particular attention being paid to its implications for Hegel's theory of nationalism. The second section examines Hegel's development of the latter theory in The Phenomenology of Spirit (1807), stressing the tragic interpenetration of ‘culture’ and intersubjective recognition. A recurring theme here is the influence of this theory on Hegel's interpretation of Napoleon's World-Historic mission, as that was revealed in his contemporaneous letters. Section three traces the tragic dynamic underlying the discussion of war between civilised states in The Philosophy of Right (1821). Section four examines three other types of imperial action in Hegel's mature writings, particularly The Philosophy of History (1832). These are relations between civilised states and culturally developed yet politically immature societies; colonial expansion motivated by capitalist under-consumption; and conflict between civilised states and barbarous peoples. It is concluded that it is misleading to claim that Hegel glorified conflict and war, and that he did not see domination by ‘civilised states’ as the ‘final stage’ of World History. ☆ I wish to thank the participants in the Security Studies Seminar, Politics Department, University of Hull, as well as those in the ‘European Radicalism, 1789–1919’ conference, University of Hull, 9 July 2002, for their comments on earlier versions of this paper. I have benefited particularly from the input of Peter Nicholson, Tom Kane and Justin Morris.",
    abstract_source = "s2"
}

@article{lee2017freedom,
    author = "Lee, Shinkyu",
    title = "Freedom, the state, and war: Hegel's challenge to world peace",
    journal = "International Politics",
    year = "2017",
    volume = "54",
    number = "2",
    pages = "203--220",
    doi = "10.1057/s41311-017-0026-z",
    note = {CORE ARGUMENT: Lee examines how conflict theorists have appropriated Hegel's "struggle for recognition" to illuminate both the destructive and potentially reconciliatory dimensions of conflict, distinguishing scholars who focus on interpersonal reconciliation from those who apply the recognition framework to interstate reconciliation, and asks what resources (if any) Hegel's account of freedom and the state offers for thinking about world peace despite his rejection of Kantian perpetual peace. RELEVANCE: Extends Key Question 1 beyond exegesis of §324 into contemporary international-relations theory, showing how the recognition-based reading of war continues to shape debates about whether a broadly Hegelian framework can accommodate — or only explain the impossibility of — lasting peace. POSITION: A contemporary IR-theoretic engagement with the "struggle for recognition" tradition of reading Hegel on conflict, published decades after the Avineri/Walt/Tyler exchanges and reflecting how the debate has migrated into international relations scholarship.},
    keywords = "war, recognition, international-relations, Medium, INCOMPLETE, no-abstract"
}

@article{hammer2013hegel,
    author = "Hammer, Espen",
    title = "Hegel as a Theorist of Secularization",
    journal = "Hegel Bulletin",
    year = "2013",
    volume = "34",
    number = "2",
    pages = "223--244",
    doi = "10.1017/hgl.2013.13",
    note = {CORE ARGUMENT: Hammer argues that Hegel is caught between claiming to be a Christian thinker — for whom Christianity, as the "consummate" religion, manifests the absolute — and describing modernity as a largely secular order lacking any recourse to an authoritative, transcendent God. Drawing on Charles Taylor's account of secularization, Hammer contends that Hegel's dialectic of religious development itself describes a process of secularization, such that Hegel's system ultimately presents the absolute as immanent, making secularization (rather than transcendent religious authority) the "end-point of spirit's development." RELEVANCE: Directly addresses Key Question 2 by arguing that the relation between Christian freedom and Hegel's philosophy of history is best understood as one of philosophical secularization, not straightforward theological continuation — bearing on whether history "ends" with Christian revelation as such or with its secular, philosophical successor-form. POSITION: A "secularization thesis" reading of Hegel's philosophy of religion, positioned against both straightforwardly theistic and straightforwardly atheistic interpretations of Hegel; complements Rosen's book-length treatment of the same question.},
    keywords = "christianity, secularization, religion, High",
    abstract = "Hegel's philosophy of religion is characterized by what seems to be a deep tension. On the one hand, Hegel claims to be a Christian thinker, viewing religion, and in particular Christianity, as a manifestation of the absolute. On the other hand, however, he seems to view modernity as largely secular, devoid of authoritative claims to transcendence. Modernity is secular in the political sense of requiring the state to be neutral when it comes to matters of religion. However, it is also secular in the sense of there being no recourse to authoritative representations of a transcendent God. Drawing on Charles Taylor's view of secularization, the article focuses on the second strand of his religious thinking, exploring how Hegel can be thought of as a theorist of secularization. It is claimed that his dialectic of religious development describes a process of secularization. Ultimately, Hegel's system offers a view of the absolute as immanent, suggesting that an adequate account of religion will necessarily have to accept secularization as the end-point of spirit's development. This is how the tension between religion and secularization can be resolved.",
    abstract_source = "openalex"
}

@book{kojeve1969introduction,
  author = {Kojève, Alexandre},
  title = {Introduction to the Reading of Hegel: Lectures on the Phenomenology of Spirit},
  editor = {Bloom, Allan},
  publisher = {Basic Books},
  address = {New York},
  year = {1969},
  note = {
  CORE ARGUMENT: Kojève's influential 1930s Paris lectures read Hegel's Phenomenology through Marx and Heidegger, arguing that the master-slave dialectic and the struggle for recognition are the true motor of world history, that history is essentially the story of human desire for recognition working itself out through labor and conflict, and that history reaches a genuine "end" once universal mutual recognition (realized, on Kojève's controversial reading, in the post-revolutionary homogeneous state) is achieved.

  RELEVANCE: Kojève's synthesis of Hegel, Marx, and Heidegger shaped mid-twentieth-century French reception of Hegel's philosophy of history and directly transmitted the "end of history" trope into later political philosophy; it is a crucial mediating text between the Marxist inversion narrative and later post-Hegelian appropriations.

  POSITION: Influential mid-century Marxian-existentialist reading of Hegelian history as recognition-driven and terminable.
  },
  keywords = {Kojeve, Hegel, Marx, recognition, end-of-history, High, INCOMPLETE, no-abstract}
}

@misc{fukuyama1992end,
    author = "Fukuyama, Francis",
    title = "The End of History and the Last Man",
    year = "1992",
    address = "New York",
    howpublished = "Free Press, New York, 1992",
    note = {CORE ARGUMENT: Fukuyama argues that the collapse of Soviet communism and the apparent global consensus around liberal democracy and market capitalism mark, in a Hegelian-Kojèvian sense, the "end of history" — not the end of events, but the end of the ideological evolution of humanity's fundamental political and economic organization, since no rival system remains capable of satisfying the human desire for recognition ("thymos") as well as liberal democracy does. RELEVANCE: The central primary text for the liberal-triumphalist appropriation of "the end of history" that Key Question 3 requires distinguishing from Hegel's own claims; the critical secondary literature on the end-of-history thesis collected in this domain (Dale, Buchwalter) treats Fukuyama's argument as derived from Kojève's Hegel rather than from an independent reading of Hegel's own texts. POSITION: The paradigm case of a post-Cold-War liberal-democratic "end of history" thesis, explicitly built on Kojève's anthropological reading rather than on an independent exegesis of Hegel; the "universal and homogeneous state" Fukuyama and Kojève attribute to Hegel is, on Dale's and Buchwalter's readings, a considerably more determinate and finished political form than anything Hegel's own texts establish.},
    keywords = "fukuyama, end-of-history, liberal-democracy, secondary-reception, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{dale2014hegel,
    author = "Dale, Eric Michael",
    title = "Hegel, the End of History, and the Future",
    year = "2014",
    publisher = "Cambridge University Press",
    address = "New York",
    doi = "10.1017/CBO9781107477711",
    howpublished = "Cambridge University Press, 2014",
    note = {CORE ARGUMENT: Dale argues that the widespread view — that Hegel, especially in the Phenomenology of Spirit, announced "the end of history" understood as the final termination of humanity's long pursuit of its historical ends — is a misinterpretation; through close analysis of Hegel's philosophy of history, Dale redirects attention away from this popular misreading toward other, more defensible and philosophically valuable elements of Hegel's account of historical development and futurity. RELEVANCE: Directly and systematically addresses Key Question 3 by arguing, at book length, that "the end of history" as popularly attributed to Hegel is a misinterpretation — providing the primary philological corrective against which Kojève's and Fukuyama's readings can be measured and distinguished from Hegel's actual claims. POSITION: The most sustained monograph-length critique of the "end of history" attribution to Hegel identified in this search; explicitly framed as the first book in English to thoroughly contest the "entrenched view" that Hegel announced a literal end of history.},
    keywords = "end-of-history, misinterpretation, phenomenology-of-spirit, High",
    abstract = "In Phenomenology of Spirit (1806) Hegel is often held to have announced the end of history, where 'history' is to be understood as the long pursuit of ends towards which humanity had always been striving. In this, the first book in English to thoroughly critique this entrenched view, Eric Michael Dale argues that it is a misinterpretation. Dale offers a reading of his own, showing how it sits within the larger schema of Hegel's thought and makes room for an understanding of the 'end of history' as Hegel intended. Through an elegant analysis of Hegel's philosophy of history, Dale guides the reader away from the common misinterpretation of the 'end of history' to other valuable elements of Hegel's arguments which are often overlooked and deserve to endure. His book will be of great interest to scholars and advanced students of Hegel, the philosophy of history, and the history of political thought.",
    abstract_source = "openalex"
}

@article{bertholdbond1988hegels,
    author = "Berthold-Bond, Daniel",
    title = "Hegel's Eschatological Vision: Does History Have a Future?",
    journal = "History and Theory",
    year = "1988",
    volume = "27",
    number = "1",
    pages = "14",
    doi = "10.2307/2504959",
    note = {CORE ARGUMENT: Berthold-Bond argues that Hegel's eschatological vision admits of two readings — either a "completely final End," after which no further progress in history or knowledge is possible, or an "epochal" conception, in which the "completion" Hegel speaks of is the fulfillment of a historical epoch rather than of history as such — and defends the epochal, non-absolutist reading by drawing on Hegel's unorthodox historicization of the Christian eschatological End and on the implication that a literal completion of history would require Spirit to cease being Spirit and God to cease being God. RELEVANCE: Provides philological support, independent of Dale, for Key Question 3's claim that Hegel's own "end of history" is qualified and structural rather than a literal cessation, and links this directly to Key Question 2 by grounding the argument in Hegel's transformation of Christian eschatology. POSITION: An early (pre-Dale) statement of the "epochal, non-absolutist" reading of Hegel's end-of-history language, explicitly framed as adjudicating between two textually supportable but incompatible interpretations of Hegel's own claims.},
    keywords = "end-of-history, christianity, eschatology, epochal-reading, Medium",
    abstract = "A central motif of Hegel's philosophy is his effort to trace out a teleological development of human thought and culture, from its initially embryonic, undeveloped stages to ever more evolved and mature forms. And he conceives of this process of development as the Bildung of rationality in history: history is the process of mind [Geist] itself, the [progressive] revelation of itself from its first .. . enshrouded consciousness ... in order that the absolute command of mind, 'know thyself,' may be fulfilled1 (HPh, III, 7). In this article I will address the question of what this fulfillment means for Hegel. I will argue that there is a strongly entrenched ambiguity and ambivalence in Hegel's philosophy between two opposed ways of describing the End, or completion of history: what I will refer to as the and the readings.2 And I will suggest that contrary to the usual way of reading Hegel, we should adopt the non-absolutist, epochal version of Hegel's eschatology if we are to preserve the spirit of his metaphysics. I wish to make it clear from the start that my argument is not that this epochal reading is clearly what Hegel himself intended, so that the great majority of commentators who insist on the absolutist alternative simply misread Hegel. Indeed, the import of my argument will be to suggest that neither the absolutist nor the epochal readings can be interpreted away: I am convinced that a faithful reading of Hegel must result in a confirmation of his deep-seated ambivalence in this matter. I will argue, on the other hand, that we should choose for Hegel, where he was unwilling to, the reading which emphasizes the nonabsolutist pole of the ambivalence as against the absolutist pole.",
    abstract_source = "openalex"
}

@incollection{marx1844contribution,
  author = {Marx, Karl},
  title = {Contribution to the Critique of Hegel's Philosophy of Right: Introduction},
  booktitle = {Karl Marx: Selected Writings},
  editor = {McLellan, David},
  publisher = {Oxford University Press},
  address = {Oxford},
  year = {2000},
  note = {
  CORE ARGUMENT: Marx's 1843/44 "Introduction" announces the programmatic reversal of Hegel's philosophy of history: rather than treating religion, the state, and philosophy as successive self-externalizations of Spirit that culminate in rational self-knowledge, Marx argues that "man makes religion" and that the critique of heaven must become the critique of earth -- of the real socio-economic conditions that generate alienated consciousness. Philosophy's task shifts from comprehending the rationality already actual in history to becoming a "material force" of revolutionary transformation carried by the proletariat.

  RELEVANCE: This is the founding text of the "inversion" narrative central to this domain: it shows Marx converting Hegel's retrospective theodicy of Spirit into a prospective, materially-grounded theory of emancipation, and it is the text against which nearly all later Marx-Hegel scholarship (Kojève and others) measures how much Hegelian structure survives the inversion.

  POSITION: Foundational primary source for Left-Hegelian/Marxist inversion of Hegel's philosophy of history.
  },
  keywords = {Marx, Hegel, inversion, historical-materialism, High, INCOMPLETE, no-abstract}
}

@book{popper1957poverty,
  author = {Popper, Karl R.},
  title = {The Poverty of Historicism},
  publisher = {Routledge},
  address = {London},
  year = {1957},
  note = {
  CORE ARGUMENT: Popper defines "historicism" as the doctrine that the social sciences can discover unconditional, law-like trends governing the overall course of history and thereby predict its future stages; he argues this doctrine rests on a mistaken analogy with the natural sciences (which discover laws, not trends) and, when combined with holism about social wholes, tends toward large-scale "utopian social engineering" that is both epistemically indefensible and politically dangerous.

  RELEVANCE: This is the founding text of the "historicism" charge that this domain must assess: Popper's argument, though aimed chiefly at Marx, explicitly identifies Hegel as the philosophical source of the trend-thinking he attacks, making this the primary target of the Beiser/Suchting/Wilkins/Hammersley rebuttal literature collected here.

  POSITION: Foundational anti-historicist critique; the "Popper's historicism charge" pole of the debate.
  },
  keywords = {Popper, historicism, critique, methodology, High, INCOMPLETE, no-abstract}
}

@book{popper1966opensociety2,
  author = {Popper, Karl R.},
  title = {The Open Society and Its Enemies, Volume 2: The High Tide of Prophecy: Hegel, Marx, and the Aftermath},
  publisher = {Routledge},
  address = {London},
  year = {1945},
  note = {
  CORE ARGUMENT: Popper argues that Hegel's dialectical philosophy of history -- with its claims that "the real is rational" and that world history is the progressive self-actualization of Reason/Spirit through a succession of national spirits -- functions as an apologetic device that sanctifies whatever historically triumphs (including the Prussian state) and supplies the intellectual template later exploited by twentieth-century totalitarianisms. He reads Marx as inheriting Hegel's "historicist" and "holist" method while replacing Spirit with economic laws.

  RELEVANCE: Together with The Poverty of Historicism, this is the direct target of the domain's central Popper-defense literature; its portrayal of Hegel as an authoritarian apologist for the status quo is precisely what Beiser and Wilkins contest as a distorting caricature.

  POSITION: Foundational anti-Hegelian polemic; identifies Hegel as originator of totalitarian "historicism."
  },
  keywords = {Popper, Hegel, Marx, historicism, totalitarianism, High, INCOMPLETE, no-abstract}
}

@incollection{kant1784idea,
  author = {Kant, Immanuel},
  title = {Idea for a Universal History with a Cosmopolitan Aim},
  booktitle = {Kant's Idea for a Universal History with a Cosmopolitan Aim: A Critical Guide},
  editor = {Rorty, Amélie Oksenberg and Schmidt, James},
  publisher = {Cambridge University Press},
  year = {2009},
  pages = {9--23},
  doi = {10.1017/cbo9780511581434.002},
  note = {
  CORE ARGUMENT: Kant proposes that although individual human actions appear contingent and often irrational, the species as a whole can be read, from a philosophical (not empirical-historical) standpoint, as progressing toward a fully just civil constitution and a cosmopolitan federation of states, driven by the mechanism of "unsociable sociability" -- humans' simultaneous drive to associate and to assert individual will, which nature uses to force the development of human capacities.

  RELEVANCE: Kant's essay is the essential comparandum for Hegel's philosophy of history: both posit a providential/teleological reading of history moving toward freedom, but Kant explicitly frames this as a regulative idea of reason for orienting inquiry and hope rather than a metaphysical claim about Spirit's actual self-realization, a distinction central to differentiating Kantian from Hegelian teleology.

  POSITION: Foundational primary text for Enlightenment providential-teleological philosophy of history, read as both precursor to and methodological contrast with Hegel.
  },
  keywords = {Kant, universal-history, teleology, cosmopolitanism, comparative, High},
  abstract = {This essay appears to have been occasioned by a passing remark made by Kant's colleague and follower Johann Schultz in a 1784 article in the Gotha Learned Papers. In order to make good on Schultz's remark, Kant wrote this article, which appeared in the Berlinische Monatsschrift late in the same year. This is the first, and despite its brevity the most fully worked out, statement of his philosophy of history. The "idea" referred to in the title is a theoretical idea, that is, an a priori conception of a theoretical program to maximize the comprehensibility of human history. It anticipates much of the theory of the use of natural teleology in the theoretical understanding of nature that Kant was to develop over five years later in the Critique of the Power of Judgment. But this theoretical idea also stands in a close and complex relationship to Kant's moral and political philosophy, and to his conception of practical faith in divine providence. Especially prominent in it is the first statement of Kant's famous conception of a federation of states united to secure perpetual peace between nations. The Idea for a Universal History also contained several propositions that were soon to be disputed by J. G. Herder in his Ideas for the Philosophy of the History of Humanity, leading to Kant's reply in his reviews of that work (1785) and in the Conjectural Beginning of Human History (1786).},
  abstract_source = {openalex}
}

@incollection{foucault2001nietzsche,
  author = {Foucault, Michel},
  title = {Nietzsche, Genealogy, History},
  booktitle = {Nietzsche},
  editor = {Richardson, John and Leiter, Brian},
  publisher = {Oxford University Press},
  address = {New York},
  year = {2001},
  note = {
  CORE ARGUMENT: Foucault, developing Nietzsche's distinction between Ursprung (origin) and Herkunft/Entstehung (descent/emergence), argues that genealogy exposes the discontinuous, accidental, and power-laden emergence of practices and values where traditional history posits smooth, purposive development; genealogy deliberately refuses any suprahistorical vantage point or teleological unity that would let history "rejoin" its own essence.

  RELEVANCE: This essay is the primary methodological statement of the Foucauldian counter-model this domain must set against Hegel's teleological philosophy of history: it is explicitly constructed (see Carr and Manley below) as an anti-metaphysical, anti-teleological alternative to philosophies of history descending from Hegel and the Enlightenment.

  POSITION: Foundational statement of genealogy as an anti-teleological historical method, opposed to Hegelian and Enlightenment philosophies of history.
  },
  keywords = {Foucault, genealogy, anti-teleology, Nietzsche, comparative, High, INCOMPLETE, no-abstract}
}

@book{moggach2006newhegelians,
  editor = {Moggach, Douglas},
  title = {The New Hegelians: Politics and Philosophy in the Hegelian School},
  publisher = {Cambridge University Press},
  year = {2006},
  doi = {10.1017/cbo9780511498664},
  note = {
  CORE ARGUMENT: This edited collection examines the political and social thought of the Young/Left Hegelian school -- Eduard Gans, Ludwig Feuerbach, Max Stirner, Bruno and Edgar Bauer, the young Engels, and Marx -- situating them against Hegel's own philosophy, the Enlightenment, Kant, and the French Revolution, and tracing how each figure radicalized or repudiated specific elements of Hegel's system (including his philosophy of history) toward divergent political ends.

  RELEVANCE: This volume covers the Right/Left-Hegelian reception explicitly named in this domain's brief (Strauss, Feuerbach, Bauer) as the immediate intellectual milieu out of which Marx's inversion of Hegel's philosophy of history emerged, showing that Marx's break with Hegel was one path among several taken by his Hegelian contemporaries.

  POSITION: Comprehensive scholarly account of the Young Hegelian school as the seedbed of Marx's Hegel-critique.
  },
  keywords = {Young-Hegelians, Feuerbach, Bauer, Strauss, reception, Medium},
  abstract = {The period leading up to the Revolutions of 1848 was a seminal moment in the history of political thought, demarcating the ideological currents and defining the problems of freedom and social cohesion which are among the key issues of modern politics. This 2006 anthology offers research on Hegel's followers in the 1830s and 1840s. With essays by philosophers, political scientists, and historians from Europe and North America, it pays special attention to questions of state power, the economy, poverty, and labour, as well as to ideas on freedom. The book examines the political and social thought of Eduard Gans, Ludwig Feuerbach, Max Stirner, Bruno and Edgar Bauer, the young Engels, and Marx. It places them in the context of Hegel's philosophy, the Enlightenment, Kant, the French Revolution, industrialization, and urban poverty. It also views Marx and Engels in relation to their contemporaries and interlocutors in the Hegelian school.},
  abstract_source = {openalex}
}

@incollection{beiser1993historicism,
  author = {Beiser, Frederick C.},
  title = {Hegel's Historicism},
  booktitle = {The Cambridge Companion to Hegel},
  editor = {Beiser, Frederick C.},
  publisher = {Cambridge University Press},
  year = {1993},
  pages = {270--300},
  doi = {10.1017/ccol0521382742.010},
  note = {
  CORE ARGUMENT: Beiser reconstructs Hegel's genuine historicism -- the thesis that human reason, values, and institutions are shaped by and comprehensible only within their historical context -- and distinguishes it sharply from the deterministic, predictive "historicism" Popper attacks; on Beiser's reading, Hegel's claim that "the real is rational" is a retrospective, reconciliatory claim about the intelligibility of what has already occurred, not a prospective law permitting historical prediction or a license for quietist apologetics.

  RELEVANCE: This chapter is the domain's central scholarly rebuttal to Popper's historicism charge, directly addressing this domain's key question of how accurate Popper's reading of Hegel is, and it supplies the conceptual distinctions (retrospective vs. predictive, contextualism vs. determinism) that structure most later defenses of Hegel against the charge.

  POSITION: Principal scholarly defense distinguishing Hegel's actual historicism from Popper's caricature of it.
  },
  keywords = {Beiser, Hegel, historicism, Popper-defense, High},
  abstract = {History cannot be consigned to a corner in Hegel's system, relegated to a few paragraphs near the end of the Encyclopedia or confined to his Lectures on the Philosophy of History. For, as many scholars have long since recognized, history is central to Hegel's conception of philosophy. One of the most striking and characteristic features of Hegel's thought is that it historicizes philosophy, explaining its purpose, principles, and problems in historical terms. Rather than seeing philosophy as a timeless a priori reflection upon eternal forms, Hegel regards it as the self-consciousness of a specific culture, the articulation, defense, and criticism of its essential values and beliefs. This historical conception of philosophy is epitomized clearly by Hegel himself in the famous lines from the preface to his Philosophy of Right: "Philosophy is its own age comprehended in thought."},
  abstract_source = {openalex}
}

@article{suchting1972marxpopper,
  author = {Suchting, W. A.},
  title = {Marx, Popper, and `Historicism'},
  journal = {Inquiry},
  year = {1972},
  volume = {15},
  number = {1-4},
  pages = {235--266},
  doi = {10.1080/00201747208601662},
  note = {
  CORE ARGUMENT: Suchting argues that Popper's category of "historicism" -- the pursuit of unconditional historical prediction via laws of development -- conflates two logically distinct types of putative historical law, and that once these are properly distinguished, it becomes far less clear that Marx's (or Hegel's) theory of history actually commits the errors Popper attributes to it; Popper's central arguments against historicism are shown not to tell decisively against the most plausible reconstruction of Marxian developmental claims.

  RELEVANCE: One of the earliest and most careful analytic rebuttals to Popper's historicism charge as applied to Marx (and by extension the Hegelian inheritance Marx is said to share), directly answering this domain's question about the accuracy of Popper's charge.

  POSITION: Early analytic-philosophical rebuttal distinguishing types of "historicist" law and defending Marx (and indirectly Hegel) against Popper.
  },
  keywords = {Suchting, Popper, Marx, historicism, critique, High},
  abstract = {According to Sir Karl Popper, there is a harmful approach to the social sciences called 'historicism'. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.},
  abstract_source = {openalex}
}

@book{wilkins1978hashistory,
  author = {Wilkins, Burleigh Taylor},
  title = {Has History Any Meaning? A Critique of Popper's Philosophy of History},
  publisher = {Cornell University Press},
  address = {Ithaca, NY},
  year = {1978},
  note = {
  CORE ARGUMENT: Wilkins offers a book-length examination of Popper's philosophy of history, arguing that Popper's dichotomy between legitimate piecemeal social engineering and illegitimate historicist utopianism is overdrawn, that Popper's own methodological individualism and situational analysis smuggle in assumptions about historical meaning and direction that his official anti-historicism disavows, and that Popper's treatment of Hegel and Marx does not do justice to the more defensible senses in which history can be said to have direction or meaning.

  RELEVANCE: The most sustained single-author critique of Popper's historicism thesis available in this domain, directly engaging this domain's key question about whether Popper's charge holds up, and complementing Beiser's more narrowly Hegel-focused defense with a broader methodological critique of Popper's own framework.

  POSITION: Book-length critical rebuttal of Popper's anti-historicism as applied to the philosophy of history generally.
  },
  keywords = {Wilkins, Popper, historicism, critique, philosophy-of-history, High, INCOMPLETE, no-abstract}
}

@article{hammersley2024challenging,
  author = {Hammersley, Martyn},
  title = {Challenging Historicist Utopianism: Karl Popper's Criticism of Karl Mannheim},
  journal = {History of European Ideas},
  year = {2024},
  volume = {51},
  number = {4},
  pages = {847--865},
  doi = {10.1080/01916599.2024.2437376},
  note = {
  CORE ARGUMENT: Hammersley examines Popper's critique of historicism and utopian social engineering by focusing on a comparatively neglected target, sociologist Karl Mannheim, alongside Popper's better-known treatments of Plato, Hegel, and Marx; the article assesses the accuracy of Popper's reading of Mannheim and draws out what this reveals about the underlying similarities and differences between Popper's and Mannheim's approaches to social science and the "open society."

  RELEVANCE: Although centered on Mannheim, this recent article situates Popper's Hegel/Marx critique within his broader anti-historicist project and clarifies the structure of the historicism charge itself, sharpening the domain's account of exactly what Popper's charge amounts to and how it has fared under sustained scholarly scrutiny.

  POSITION: Recent contextualizing study of Popper's historicism critique, useful for precisely specifying the charge before it is applied to Hegel.
  },
  keywords = {Popper, historicism, Mannheim, critique, Medium},
  abstract = {In his critique of historicism and utopian social engineering, Karl Popper treats various writers -- notably, Plato, Hegel, and Marx -- as expounding these mistaken ideas, and as illustrating the threat they pose to 'the open society'. Among contemporaries, one of those he singles out for criticism is the sociologist Karl Mannheim. While he spends relatively little time discussing Mannheim's work compared to that of Plato and Marx, I argue that Ideology and Utopia and Man and Society in an Age of Reconstruction may have had particular significance for Popper. I examine his evaluation of Mannheim's work, assessing its accuracy, and what it reveals about the similarities and fundamental differences in the orientations of these two writers, both of whom had a significant impact upon social science in the twentieth century.},
  abstract_source = {s2}
}

@incollection{eidlin2007calltodestiny,
  author = {Eidlin, Fred},
  title = {Call to Destiny or Call to Action: Marx, Popper, and History},
  booktitle = {The Power of Argumentation},
  year = {2007},
  pages = {31--54},
  publisher = {Brill},
  doi = {10.1163/9789401205030_004},
  note = {
  CORE ARGUMENT: Eidlin examines the dispute between Marx's (and by extension Hegel's) conception of history as an intelligible, direction-bearing process and Popper's insistence that history is open and that appeals to historical "destiny" invite passivity or tyranny, arguing that the opposition between a "call to destiny" and a "call to action" oversimplifies both Marx's actual practice, which combines structural analysis with revolutionary agency, and Popper's own reliance on background assumptions about rational progress.

  RELEVANCE: Directly engages this domain's key question about what survives of Hegelian teleology in Marxism by showing that the destiny/action dichotomy Popper relies on does not map cleanly onto Marx's texts, offering another angle of rebuttal to the historicism charge.

  POSITION: Rebuttal arguing that Popper's destiny/action dichotomy misrepresents the Hegelian-Marxist conception of historical agency.
  },
  keywords = {Eidlin, Popper, Marx, historicism, agency, Medium},
  abstract = {Popper is in substantial agreement with both Marx's ideals and theoretical achievements. Nevertheless, he accuses Marx of having misled scores of intelligent people into believing that historical prophesy is the scientific way of approaching social problems. While Marx's writings do not on balance put forward a mechanical and simplistic view of history according to which all societies were predestined to go through a single, inexorable sequence of stages, several features of these writings encourage such an interpretation. Problems in Popper's critique of Marxism are identified: (1) his attribution of causality to Marx's ideas may itself have a historicist flavor; (2) he does not convincingly demonstrate the responsibility of Marxism for the downfall of democracy and rise of totalitarianism; (3) doctrines which Popper identifies as pernicious can be and often have been tamed and put to good use in practice; (4) it is unclear that Marx was in fact a moral positivist as Popper claims; (5) historicism, by Popper's own testimony, pervades even the writings of liberal political thinkers. The final section identifies those of Popper's criticisms of Marx that hit the mark: their deceptive way of selling revolution as the only way to bring about real change in society, excluding any concern for social technology; and those features that make them resistant to correction by experience and criticism.},
  abstract_source = {openalex}
}

@incollection{finlayson2017hegelfrankfurt,
  author = {Finlayson, James Gordon},
  title = {Hegel and the Frankfurt School},
  booktitle = {The Oxford Handbook of Hegel},
  editor = {Moyar, Dean},
  publisher = {Oxford University Press},
  year = {2017},
  doi = {10.1093/oxfordhb/9780199355228.013.34},
  note = {
  CORE ARGUMENT: Finlayson surveys the relation of Horkheimer, Adorno, and Marcuse to Hegel, concluding that the young Horkheimer is a Hegelian-Marxist who treats Hegel's idealist metaphysics as superseded by sociology, psychology, and materialist historiography; that Adorno remains the most committed Hegelian, developing his negative dialectics as an immanent critique continuous with Hegel's own method while rejecting Hegel's philosophy of objective spirit as apologetic for the Prussian state; and that Marcuse offers the most scholarly and charitable reading, emphasizing the critical rather than the reconciliatory moment in Hegel's conception of reason.

  RELEVANCE: This chapter directly answers this domain's key question about what is distinctive in the Frankfurt School's critical-theoretical retrieval of Hegelian history, differentiating three distinct stances (qualified supersession, immanent critique, charitable retrieval) within what is often treated as a single "Frankfurt School" position.

  POSITION: Comprehensive scholarly mapping of the Frankfurt School's differentiated relations to Hegel, distinguishing Horkheimer, Adorno, and Marcuse.
  },
  keywords = {Finlayson, Hegel, Frankfurt-School, Adorno, Horkheimer, Marcuse, High},
  abstract = {Hegel's philosophy exerted a magnetic attraction on the various thinkers that comprise the Frankfurt school. This chapter aims to gauge and specify the relation that three members of the 'inner circle' of the Frankfurt school (Horkheimer, Adorno, and Marcuse) have to Hegel. It concludes that the young Horkheimer is a Hegelian-Marxist who endorses a qualified Hegelianism, while claiming that Hegel's idealist metaphysics had become obsolete and superseded by a combination of sociology, psychology, and materialist historiography. Adorno remains a more committed Hegelian (and a Marxist-Hegelian) who sees his own dialectical approach to philosophy as emerging from and consistent with an immanent criticism of Hegel. Both, however, tend to reject Hegel's philosophy of objective spirit as conservative apology for the Prussian state. Marcuse, by contrast, is a Hegelian-Marxist who has a more scholarly, nuanced, and charitable approach to Hegel, placing more emphasis on the critical moment in Hegel's conception of reason.},
  abstract_source = {s2}
}

@incollection{oconnor2008adornohistory,
  author = {O'Connor, Brian},
  title = {Adorno: Philosophy of History},
  booktitle = {Theodor Adorno: Key Concepts},
  editor = {Cook, Deborah},
  publisher = {Acumen},
  year = {2008},
  doi = {10.1017/upo9781844654048},
  note = {
  CORE ARGUMENT: O'Connor examines Adorno's engagements with Hegelian, Marxian, Nietzschean, and hermeneutical theories of history, focusing on Adorno's critique of the idea of universal history and of the notion of progress, his dialectical reading of "natural history" (the entwinement of nature and history each with the other's supposedly opposite features), and his skeptical assessment of the role of totality in historical explanation.

  RELEVANCE: This chapter shows how Adorno turns Hegelian dialectical resources against Hegel's own optimistic philosophy of history, using dialectic to expose the catastrophic and non-progressive character of actual historical development -- the clearest instance in this domain of a "progress and its discontents" critical retrieval of Hegel.

  POSITION: Focused study of Adorno's negative-dialectical critique of universal history and progress as inherited from, and turned against, Hegel.
  },
  keywords = {Adorno, Hegel, progress, negative-dialectics, natural-history, High},
  abstract = {[Publisher/volume-level description, not chapter-specific.] The issues Theodor Adorno explored in his work are as pressing now as they were then and his ideas continue to have an impact on disciplines as diverse as philosophy, sociology, psychology, cultural studies, musicology and literary theory. An uncompromising critic, even as Adorno contests many of the premises of the philosophical tradition, he also reinvigorates that tradition in his concerted attempt to stem or to reverse potentially catastrophic tendencies in the West. This book serves as a guide through the intricate labyrinth of Adorno's work. Expert contributors make Adorno accessible to a new generation of readers without simplifying his thought, providing readers with the key concepts needed to decipher Adorno's often daunting books and essays.},
  abstract_source = {openalex}
}

@book{giladi2021hegelfrankfurt,
  editor = {Giladi, Paul},
  title = {Hegel and the Frankfurt School: Traditions in Dialogue},
  publisher = {Routledge},
  address = {Abingdon, Oxon},
  year = {2021},
  note = {
  CORE ARGUMENT: This edited collection surveys the complicated dialogue between Hegel and the Frankfurt School tradition of critical theory as reflected in Adorno, Horkheimer, Lukács, Marcuse, Habermas, and Honneth, organized around Adorno's Negative Dialectics as the most historically contentious reception of Hegel, shared themes of ethical life and intersubjectivity linking Hegel to Habermas and Honneth, and the tradition's central social projects of emancipation and rationality.

  RELEVANCE: Provides the most comprehensive multi-author treatment available of the Frankfurt School's relation to Hegel across its first and second generations, complementing Finlayson's single-author survey with a wider range of critical perspectives and later figures (Habermas, Honneth) who extend the tradition's engagement with Hegelian history into contemporary recognition theory.

  POSITION: Broadest available edited survey of Hegel's reception across the full span of Frankfurt School critical theory.
  },
  keywords = {Hegel, Frankfurt-School, Habermas, Honneth, reception, Medium, INCOMPLETE, no-abstract}
}

@article{carr2016husserlfoucault,
  author = {Carr, David},
  title = {Husserl and Foucault on the Historical Apriori: Teleological and Anti-Teleological Views of History},
  journal = {Continental Philosophy Review},
  year = {2016},
  volume = {49},
  number = {1},
  pages = {127--137},
  doi = {10.1007/s11007-015-9362-0},
  note = {
  CORE ARGUMENT: Carr contrasts Husserl's teleological conception of the "historical a priori" -- on which history has an intelligible, goal-directed structure descending from Hegel and Enlightenment rationalism -- with Foucault's explicit and sustained attack on this view; Carr argues that Foucault's position is best understood as actively anti-teleological rather than merely non-teleological, since Foucault characteristically proceeds by dismantling the specific assumptions of teleological opponents rather than simply ignoring the question of historical direction.

  RELEVANCE: This article most precisely frames the comparison this domain's key questions call for between Hegelian/post-Hegelian teleological philosophies of history and Foucault's counter-model, and explicitly names Hegel as the common ancestor of the teleological tradition Foucault is reacting against.

  POSITION: Careful philosophical account of Foucauldian genealogy as actively (not merely passively) anti-teleological, contrasted with the Hegelian-descended teleological tradition.
  },
  keywords = {Foucault, Husserl, teleology, anti-teleology, comparative, High, INCOMPLETE, no-abstract}
}

@article{manley2025disunity,
  author = {Manley, Robin},
  title = {The Disunity in Genealogy: Foucault's Anti-Nietzschean Reading of History},
  journal = {Theory, Culture \& Society},
  year = {2025},
  volume = {42},
  number = {5},
  pages = {75--92},
  doi = {10.1177/02632764251319026},
  note = {
  CORE ARGUMENT: Manley argues that Foucault's landmark essay "Nietzsche, Genealogy, History," though framed as a faithful exposition of Nietzsche, is actually incompatible with Nietzsche's more dialectical treatment of history and the ahistorical in the second Untimely Meditation; where Foucault presents an anti-metaphysical Nietzsche wholly suspicious of teleological origins, Nietzsche's own essay insists that ahistorical, quasi-teleological figures are a necessary antidote to corrosive historicism, suggesting Nietzsche is less a precursor to than an alternative to Foucauldian genealogy.

  RELEVANCE: This article complicates the domain's account of Foucault as a clean anti-teleological counter-model by showing that Foucault's own founding methodological statement rests on a one-sided reading of its Nietzschean source, which matters for assessing how sharply genealogy actually breaks with the teleological tradition descending from Hegel.

  POSITION: Recent critical reassessment complicating the standard picture of Foucauldian genealogy as straightforwardly anti-teleological.
  },
  keywords = {Foucault, Nietzsche, genealogy, teleology, Medium},
  abstract = {Contemporary critical scholarship takes Foucault's genealogical work as a paradigm, and it is widely recognized that Foucault himself took Nietzsche as a methodological exemplar. Notably, Foucault's landmark methodological text -- 'Nietzsche, Genealogy, History' -- is framed as a faithful exposition of Nietzsche. Contrary to Foucault's framing, however, this article argues that his account of genealogy is incompatible with and anathema to Nietzsche's philosophy of history. Through a close reading of Foucault's essay alongside Nietzsche's second Unfashionable Observation, it seeks to demonstrate that Foucault's account of genealogy is premised on an inadequately one-sided reading of Nietzsche's more dialectical account of history and the ahistorical. Whereas Foucault presents an anti-metaphysical Nietzsche suspicious of teleological origins and ahistorical forms, Nietzsche's essay in fact insists on the necessity of such figures as an antidote to historicism. Reading Nietzsche against Foucault, this article investigates the conceptual foundations of the contemporary genealogical method, suggesting that Nietzsche may present an alternative -- rather than precursor -- to the Foucauldian paradigm.},
  abstract_source = {s2}
}

@article{bristow2025herder,
  author = {Bristow, William},
  title = {Herder, Philosophy and Universal History},
  journal = {The European Legacy},
  year = {2025},
  volume = {30},
  number = {6},
  pages = {712--727},
  doi = {10.1080/10848770.2025.2525597},
  note = {
  CORE ARGUMENT: Bristow argues that a tension in Herder's thought between the "incomparability thesis" (that peoples must be understood in their own uniqueness, without comparative ranking) and the "history thesis" (that peoples must be understood as parts of a single universal human history) is reconciled by Herder's own innovative method of universal history, which Bristow interprets as an empirical, critical, open-ended precursor to Hegel's project and method in the Phenomenology of Spirit.

  RELEVANCE: This is the domain's most direct scholarly treatment of the Herder-Hegel relationship, substantiating the claim that Hegel's universal-historical method has an important non-Kantian eighteenth-century precursor and clarifying exactly what Herder anticipates (and where he diverges from) Hegel's own approach.

  POSITION: Recent scholarly argument for reading Herder's universal history as a genuine methodological precursor to Hegel's Phenomenology, not merely a source of raw material or opposing pluralism.
  },
  keywords = {Herder, universal-history, Hegel, comparative, High},
  abstract = {In this article I propose that the tension between two of Herder's most important contributions to Western thought and culture, the incomparability thesis and the history thesis, is reconciled by Herder's own innovative project and method of universal history. Whereas the incomparability thesis demands that peoples are known in their uniqueness without comparison to other peoples, the history thesis implies knowing peoples in relation to each other as distinct parts of a universal history of humanity. I interpret Herder's method and project of universal history as a precursor of Hegel's project and method of his Phenomenology of Spirit. The comparison between Herder's and Hegel's methods and projects shows that Herder's universal history is a philosophical inquiry -- empirical, critical, skeptical, and open-ended -- into the meaning and telos of human existence. I propose in concluding that Herder's innovative practice of philosophy as universal history is a third significant contribution to European thought.},
  abstract_source = {s2}
}

@article{james2019practicalnecessity,
  author = {James, David},
  title = {Practical Necessity and the Fulfilment of the Plan of Nature in Kant's Idea for a Universal History},
  journal = {Journal of the Philosophy of History},
  year = {2019},
  volume = {13},
  number = {1},
  pages = {42--65},
  doi = {10.1163/18722636-12341361},
  note = {
  CORE ARGUMENT: James examines the role of "practical necessity" -- arising from social and interstate antagonism -- in Kant's argument that history is directed toward a cosmopolitan, lawful condition, and argues that Kant fails to identify a mechanism explaining how a fundamental moral transformation in human motivation could occur once the required legal and political conditions are established, raising doubts about the coherence of Kant's "plan of nature" as Kant himself formulates it.

  RELEVANCE: This close reading sharpens the domain's comparative treatment of Kantian and Hegelian teleology by identifying an internal tension in Kant's regulative-teleological account that Hegel's more metaphysically committed conception of Spirit's self-realization arguably avoids (or reproduces in a different form), useful for precise comparison rather than mere juxtaposition.

  POSITION: Close critical analysis of an internal difficulty in Kant's providential-teleological philosophy of history, relevant to assessing its contrast with Hegel's.
  },
  keywords = {Kant, universal-history, teleology, comparative, Medium},
  abstract = {I explore the role of practical necessity in Kant's essay Idea for a Universal History with a Cosmopolitan Aim. This form of necessity arises on the basis of social and interstate antagonism and Kant appeals to it with the aim of avoiding the introduction of a standpoint that is external to the agents whose attitudes and actions are being described. In connection with the role that Kant accords to practical necessity in the establishment of the legal and political conditions required to fulfil the 'plan of nature' in the course of history, I argue that in this essay he fails to identify a mechanism that would explain a fundamental moral change in that which motivates human beings once these conditions have been established. This in turn invites questions concerning the kind of universal history that Kant proposes. In particular, I argue that the choice of historical material that it demands could, in certain circumstances, be regarded as counterpurposive in relation to the aim of nature of which Kant speaks in the same essay.},
  abstract_source = {s2}
}

