@misc{horkheimeradorno2002dialectic,
    author = "Horkheimer, Max and Adorno, Theodor W.",
    title = "Dialectic of Enlightenment: Philosophical Fragments",
    year = "2020",
    doi = "10.1515/9780804788090",
    note = {CORE ARGUMENT: The primary text of this domain. Horkheimer and Adorno argue that Western reason, from prehistoric mimetic ritual through the historical Enlightenment to twentieth-century mass culture, is entwined with the myth it claims to have superseded: "myth is already enlightenment, and enlightenment reverts to mythology." The Odyssey excursus reads Homer's epic as the "basic text" of the prehistory of subjectivity, in which self-preservation through sacrifice and renunciation constitutes both the domination of external nature and the domination (mutilation) of inner nature. The culture industry and antisemitism chapters extend this genealogy into industrial capitalism and fascism as instances of enlightenment's "self-destruction." RELEVANCE: This is the target text of the entire domain; all other entries in this file are interpretive or critical engagements with its historical-philosophical argument. POSITION: Founding text of the entwinement thesis; genealogical philosophy of history combining Marxian, Nietzschean, Weberian, and psychoanalytic elements.},
    keywords = "primary-text, entwinement-thesis, instrumental-reason, Odyssey-excursus, High, METADATA\_CLEANED: publisher, year:2002->2020, type:@book->@misc",
    abstract = "Dialectic of Enlightenment is, quite justifiably, one of the most celebrated and often cited works of modern social philosophy. It has been identified as the keystone of the 'Frankfurt School', of which Theodor Adorno and Max Horkheimer were the leading members, and does not cease to impress in its wide-ranging ambition and panache. Adorno and Horkheimer addressees themselves to a question which went to the very heart of the modern age, namely 'why mankind, instead of entering into a truly human condition, is sinking into a new kind of barbarism'. Modernity, far from redeeming the promises and hopes of the Enlightenment, had resulted in a stultification of mankind and an administered society, characterised by simulation and candy-floss entertainment. To seek an answer to the question of how such a condition could arise, Adorno and Horkheier subjected the whole history of Western catagories of reason and nature, from Homer to Nietzsche, to a searching philosophical and psychological critique. Drawing on psychoanalytical insights, their own work on the 'culture industry', deep knowledge of the key Enlightenment and anti-Enlightenment thinkers, as well as fascinating considerations on the relationship between reason and myth - the rational and the irrational - the authors exposed the domination and violence towards both nature and humanity that underpin the Enlightenment project.",
    abstract_source = "s2"
}

@misc{habermas1987philosophical,
    author = "Habermas, Jürgen",
    title = "The Philosophical Discourse of Modernity: Twelve Lectures",
    year = "1987",
    note = {CORE ARGUMENT: Habermas's lecture "The Entwinement of Myth and Enlightenment" argues that Dialectic of Enlightenment levels a totalizing critique of reason that performatively contradicts itself: the book "denounces the Enlightenment's becoming totalitarian with its own tools," yet, having conflated instrumental rationality with rationality as such and rationality with power, it is left without normative grounds for its own critique and can only "practice determinate negation on an ad hoc basis." Habermas's own theory of communicative rationality, oriented toward mutual understanding, is offered as the corrective. RELEVANCE: Inaugurates the central reception debate over whether the book's historical narrative is self-undermining (a "performative contradiction") or whether, as later defenders argue, its aporetic structure is deliberate. Nearly every subsequent paper in this file (Allen, Honneth, Hulatt, Evans, Freyenhagen) responds directly or indirectly to this charge. POSITION: The canonical external critique of Dialectic of Enlightenment as normatively self-defeating totalized critique. sep\_context: SEP "Theodor W. Adorno" (section 3, Dialectic of Enlightenment) quotes Habermas directly: "it denounces the Enlightenment's becoming totalitarian with its own tools. Adorno was quite aware of this performative contradiction [...] inherent in totalized critique" (1987, 119); practicing "a critique that attacks the presuppositions of its own validity," the book's arguments have no "ultimate groundings" or "normative foundations" and must "therefore eschew theory and practice determinate negation on an ad hoc basis" (1987, 128-129).},
    keywords = "performative-contradiction, normative-deficit, reception-debate, High, INCOMPLETE, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{allen2014reason,
    author = "Allen, Amy",
    title = "Reason, power and history",
    journal = "Thesis Eleven",
    year = "2014",
    volume = "120",
    pages = "10--25",
    doi = "10.1177/0725513613519588",
    note = {CORE ARGUMENT: Allen re-reads Dialectic of Enlightenment against the Habermasian charge of performative contradiction, arguing that the book's "aporia" and deliberate ambivalence about enlightenment are not a failure of theoretical grounding but a considered stance: the text encourages readers to remain "as mindful of the dangers of enlightenment as we are of our commitment to it." She situates this within her broader project (The End of Progress) of decolonizing critical theory's normative foundations. RELEVANCE: Directly addresses whether the book's historical narrative is fatalistic/totalizing or retains critical purchase, arguing for the latter by reinterpreting the function of aporia in the text's philosophy of history. POSITION: Defends the entwinement thesis's aporetic structure against the performative-contradiction critique; aligned with attempts to preserve emancipatory resources within a seemingly totalizing narrative. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "More recently, Allen resists the claim of performative contradiction, emphasizing that the 'aporia' and ambivalence at the heart of the book encourages us to remain 'as mindful of the dangers of enlightenment as we are of our commitment to it' (2014, 22)."},
    keywords = "entwinement-thesis, aporia, normative-deficit-debate, High, METADATA\_CLEANED: number",
    abstract = "This paper re-examines the relationship between power, reason and history in Horkheimer and Adorno’s Dialectic of Enlightenment. Contesting Habermas’ highly influential reading of the text, I argue that Dialectic of Enlightenment, far from being a dead-end for critical theory, opens up important lines of thought in the philosophy of history that contemporary critical theorists would do well to recover. My focus is on the relationship that Horkheimer and Adorno trace between enlightenment rationality and the domination of inner and outer nature.",
    abstract_source = "openalex"
}

@article{comay2000adornos,
    author = "Comay, Rebecca",
    title = "Adorno's Siren Song",
    journal = "New German Critique",
    year = "2000",
    doi = "10.2307/488544",
    note = {CORE ARGUMENT: Comay offers a close reading of the Sirens episode in the Odyssey excursus, arguing that Odysseus's cunning self-binding exemplifies the book's thesis that reason can only assert itself as domination of an alien nature inseparable from self-domination that becomes self-mutilation. The subject who frees himself from bondage to the Other (the Sirens' song) unleashes an "endless ritual of sado-masochistic bondage games" turned against himself; reason becomes unreason at its own limit. RELEVANCE: A sustained close reading of exactly the passage the domain specifies (the Odyssey excursus) as the site where the genealogy of the self functions as historical explanation of the domination of inner and outer nature. POSITION: Interpretive/exegetical contribution focused on the psychoanalytic and rhetorical texture of the excursus rather than on the Habermasian normative debate.},
    keywords = "Odyssey-excursus, genealogy-of-subject, domination-of-nature, High, METADATA\_CLEANED: number, pages",
    abstract = "Excursus on an Excursus In a lengthy excursus or appendix to the first chapter of the Dialectic of Enlightenment - a detour in a book which constitutes itself essentially as an extended patchwork of such appendages - Adorno reads Homer's Odyssey as an allegory of the dialectic of enlightenment. Odysseus himself would be the quintessential figure of homo oeconomicus, his voyage an extended business trip, his passions the usual affairs men fall into when they have a devoted wife at home. So domesticated is Odysseus's wanderlust, so conventional his calculations, that Adorno indeed reads the ancient epic as a modem novel, the bourgeois genre par excellence.1 In his reading of the Sirens episode Adorno reckons sharply just what the costs of Odysseus's enlightenment might be. If reason can only assert itself as the domination of an alien nature, this is in turn inseparable from a self-domination which becomes self-mutilation at its extreme. Reason becomes unreason when pushed to its conclusion: the attempt to free oneself from external bondage to the Other unleashes an endless ritual of sado-masochistic bondage games in which the subject has himself tied up tight. In the face of the Sirens' singing - a voice of nature, a voice of pleasure, a voice of the past, and, yes, a voice of women - both the danger and the solution would be extreme. The Sirens are not the",
    abstract_source = "openalex"
}

@misc{honneth2000possibility,
    author = "Honneth, Axel",
    title = "The Possibility of a Disclosing Critique of Society: The Dialectic of Enlightenment in Light of Current Debates in Social Criticism",
    year = "2000",
    note = {CORE ARGUMENT: Honneth argues that Dialectic of Enlightenment should be understood not as an argumentative or foundationalist critique but as a "disclosing critique" that deploys rhetorical means — narration, myth, chiasmus, exaggeration — "in order to evoke a new way of seeing the social world." This reframes the book's mode of historical argument as world-disclosing rather than propositionally grounded, sidestepping the demand for normative foundations that drives the Habermasian objection. RELEVANCE: Offers an influential alternative account of what kind of "philosophy of history" the book is — not a causal-explanatory or normatively grounded narrative but a disclosive one — directly bearing on the domain's first key question about the scope and status of the historical narrative. POSITION: Positions itself between Habermas's critique and full endorsement of the book's totalizing rhetoric, proposing a third way of reading its historical claims as disclosive rather than argumentative. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "Honneth interprets the text as a disclosive critique that uses rhetorical means (narration, myth, chiasmus, exaggeration, etc.) 'in order to evoke a new way of seeing the social world' (2000, 124), an approach extended by Freyenhagen's (2024) reading of the text as a fictional performance, rather than merely critical description, of the defining aporias of modernity's self-understanding."},
    keywords = "disclosing-critique, historical-narrative-status, reception-debate, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{noppen2012reflective,
    author = "Noppen, Pierre-François",
    title = "Reflective Rationality and the Claim of Dialectic of Enlightenment",
    year = "2012",
    note = {CORE ARGUMENT: Noppen interprets Dialectic of Enlightenment as preparing, but not yet elaborating, a "positive concept of enlightenment" that would liberate reason from its entanglement in blind domination. On this reading the book is best understood as a propaedeutic and diagnostic work — establishing the pathology of instrumental/identity-thinking reason — rather than as offering a completed normative theory, which qualifies both the totalizing reading and the demand (per Habermas) that it supply full normative grounding. RELEVANCE: Bears directly on the domain's question of the scope and status of the book's historical narrative: is it a completed philosophy of history or an incomplete, preparatory diagnostic gesture toward one? POSITION: Intermediate position between totalizing-fatalist readings and fully reconstructive (Honneth/Allen-style) defenses; treats the book as unfinished rather than either self-refuting or covertly complete. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "Noppen (2012) interprets the text as preparation for, but not yet elaboration of, a positive concept of enlightenment, and Zuidervaart (2007, chap.4) urges distinctions in the scope of domination and exploitation invoked in the text."},
    keywords = "reflective-rationality, historical-narrative-status, positive-concept-of-enlightenment, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract That something is profoundly wrong with the way in which enlightenment has unfolded has widely been taken to be the main thrust of D ialectic of E nlightenment . In this paper, I propose to defend that to understand the book and shed light on some of its most puzzling features, one should rather take H orkheimer and A dorno's critical claim at face value: through their criticism they contend to have prepared a positive concept of enlightenment. How this can be so is the question I want to answer. I defend that what we need is an account that works out the conceptual grounds on which their critique can operate. The focus of my attempt will consist in understanding (1) what they mean when they assert that rationality is intrinsically social and (2) how they conceive of rationality as being reflective at its core.",
    abstract_source = "openalex"
}

@article{rabinbach2000why,
    author = "Rabinbach, Anson",
    title = "Why Were the Jews Sacrificed?: The Place of Anti-Semitism in Dialectic of Enlightenment",
    journal = "New German Critique",
    year = "2000",
    note = {CORE ARGUMENT: Rabinbach examines how the "Elements of Anti-Semitism" excursus fits within the book's larger historical-anthropological argument, arguing that Horkheimer and Adorno treat antisemitism not as contingent political pathology but as an outgrowth of the same historical dialectic of self-preservation, false projection, and domination of nature traced throughout the book — the persecuted Jew comes to symbolize what has escaped total self-reification ("happiness without power, reward without work"). RELEVANCE: Addresses how far the book's historical explanation extends — from prehistoric myth to twentieth-century genocide — and thus bears on the domain's question of whether the narrative is transhistorical/universal or tied to specific historical conjunctures (Nazism). POSITION: Historicizes the antisemitism chapter within the book's genealogical method rather than treating it as a separable empirical excursus. sep\_context: SEP "Theodor W. Adorno" (section 4, Social Psychology) cites this work directly: "the image of the Jew suggests what has partly escaped self-reification: 'happiness without power, reward without work, a homeland without frontiers, religion without myth' (ibid., 164-5; Jay 1980; Rabinbach 2000)."},
    keywords = "antisemitism, historical-scope, genealogy, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "The penultimate section of Dialectic of Enlightenment, of Anti-Semitism was composed in the summer of 1943, four years after work on the book had begun, and after all the other sections were completed. As was the case with the first chapter, the Elements were a collaborative enterprise. Leo Liwenthal contributed to the first three theses, and it is likely that the remaining three, and certainly the fifth and most original thesis on idiosyncrasy and mimesis, were jointly dictated by Horkheimer and Adorno in July 1943.1 The seventh thesis, added in 1947, was solely the work of Horkheimer. Not initially intended for the volume published in 1944, the Elements are usually described as theoretical elaborations destined for the Institute for Social Research's anti-Semitism project begun in 1939 and announced in the 1941 issue of the Institute's journal.2 In mid-1943 the anti-Semitism project took on renewed importance when the institute was entrusted by the Jewish Labor Committee to conduct a massive study of American labor's attitudes towards Jews. The following year, the American Jewish Committee selected Horkheimer as its Director of Scientific Research and launched an ambitious program culminating in the five part Studies in Prejudice series published in 1949 and",
    abstract_source = "openalex"
}

@misc{hulatt2016reason,
    author = "Hulatt, Owen",
    title = "Reason, Mimesis, and Self-Preservation in Adorno",
    year = "2016",
    note = {CORE ARGUMENT: Hulatt challenges readings of Dialectic of Enlightenment's genealogy as a simple, internally driven development from mimesis to instrumental rationality. He argues instead for a tripartite conflict among mimesis, rationality, and self-preservation as an independent controlling/ordering principle — a conflict that is only partially relaxed in bourgeois autonomous art's later incorporation of mimetic comportment. RELEVANCE: Directly revises how the domain's central genealogical narrative (myth to instrumental reason via self-preservation) should be reconstructed, complicating any simple linear or two-term account of the entwinement thesis. POSITION: A structural/interpretive intervention into how the book's genealogy of reason should be modeled, arguing for three interacting terms rather than two. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "Hulatt (2016a) interprets the book's genealogy not as an internally driven development from mimesis to instrumental rationality but rather as a more complex, tripartite conflict between mimesis, rationality, but also self-preservation as a controlling and ordering principle, which ultimately is relaxed in bourgeois autonomous art's incorporation of mimesis."},
    keywords = "mimesis, self-preservation, genealogy-of-reason, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In this paper I argue that Adorno’s narrative of mimesis’s development is best understood as not produced by a simple opposition between mimesis and reason, but rather a tri-partite conflict between mimesis, self-preservation, and reason. I develop this account with special reference to Roger Caillois, whose identification of mimesis with an organic drive toward passivity orthogonal to self-preservation had great influence on Adorno’s own conception of mimesis. I show that Adorno sees mimesis as, at the outset, a raw impulse toward inaction and dissolution, which shares much in common with Freud’s death drive (a connection Adorno himself notes). Drawing on this, I argue that Adorno’s narrative of the development of mimetic behavior (in relation to magic, reason, and the artwork) is not driven solely by tendencies intrinsic to mimesis. Rather, it is the intensifying conflict between mimesis and the controlling and ordering principle of self-preservation that drives the formation of increasingly spiritualized forms of abstraction. This gives us cause to revise our understanding of Adorno’s account of magical praxis and rationality, and the relationship between them. Finally, this allows me to recast Adorno’s claim that the artwork becomes a “refuge” for mimesis. I argue that this should not be understood, as it often is, in terms of a flat antagonism between mimesis and reason. Rather, the artwork becomes a refuge for mimesis as a consequence of self-preservation’s socio-epistemic intolerance of mimetic forms of behavior in virtually all realms of society save for a privileged few exceptions, art being the most notable of these.",
    abstract_source = "openalex"
}

@article{stone2014adorno,
    author = "Stone, Alison",
    title = "Adorno, Hegel, and Dialectic",
    journal = "British Journal for the History of Philosophy",
    year = "2014",
    volume = "22",
    pages = "1118--1141",
    doi = "10.1080/09608788.2014.952264",
    note = {CORE ARGUMENT: Stone argues that Adorno's allegiance to Hegel's dialectic is visible precisely in the dialectical process, traced in Dialectic of Enlightenment, whereby enlightenment reverts to myth and human domination over nature reverts into domination by nature. Adorno nonetheless breaks with Hegel by criticizing dialectic itself as the ultimate form of "identity thinking," and, against Habermas, Stone contends Adorno can consistently criticize enlightenment's practice of critique because he reshapes rather than abandons Hegelian dialectical reconciliation (co-existing differences rather than unification). RELEVANCE: Clarifies the formal, dialectical logic underlying the entwinement thesis and directly rebuts the Habermasian consistency objection, bearing on the domain's second key question about how the entwinement of myth and enlightenment should be understood. POSITION: Locates Dialectic of Enlightenment's historical dialectic within (and against) the Hegelian tradition, defending its internal consistency against Habermas.},
    keywords = "Hegelian-dialectic, identity-thinking, entwinement-thesis, Medium, METADATA\_CLEANED: number",
    abstract = "This article explores critical theory's relations to German idealism by clarifying how Adorno's thought relates to Hegel's. Adorno's apparently mixed responses to Hegel centre on the dialectic and actually form a coherent whole. In his Logic, Hegel outlines the dialectical process by which categories – fundamental forms of thought and reality – necessarily follow one another in three stages: abstraction, dialectic proper, and the speculative (famously simplified as ‘thesis, antithesis, synthesis’). Adorno's allegiance to Hegel's dialectic emerges when he traces the dialectical process whereby enlightenment reverts to myth and human domination over nature reverts into our domination by nature. However, Adorno criticizes Hegel's dialectic as the ultimate form of ‘identity thinking’, subsuming unique, material objects under universal concepts by using dialectical reason to expand those concepts to cover objects utterly. These two responses cohere because Adorno shares Hegel's view that dialectical contradictions require reconciliation, but differs from Hegel on the nature of reconciliation. For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences. Finally, against Habermas who holds that Adorno cannot consistently criticize the enlightenment practice of critique, I show that Adorno can do so consistently because of how he reshapes Hegelian dialectic.",
    abstract_source = "openalex"
}

@article{nelson2011revisiting,
    author = "Nelson, Eric S.",
    title = "Revisiting the Dialectic of Environment: Nature as Ideology and Ethics in Adorno and the Frankfurt School",
    journal = "Telos",
    year = "2011",
    doi = "10.3817/0611155105",
    note = {CORE ARGUMENT: Nelson reconsiders the domination-of-nature thesis across Adorno's and the Frankfurt School's work, arguing that "nature" functions doubly as ideology critique (unmasking naturalizing legitimations of domination) and as an ethical category (registering what is lost or repressed in the domination of outer and inner nature), and that these two functions are not always well distinguished in Dialectic of Enlightenment and its reception. RELEVANCE: Engages directly with the domain's third key question — how the account of domination of outer and inner nature functions as historical explanation — by disambiguating distinct senses of "nature" operative in the book's genealogy. POSITION: Critical-reconstructive reading that presses for greater conceptual precision in the domination-of-nature thesis rather than either endorsing or rejecting it wholesale.},
    keywords = "domination-of-nature, ideology-critique, ethics-of-nature, Medium, METADATA\_CLEANED: volume, number, pages",
    abstract = "International audience",
    abstract_source = "openalex"
}

@article{bermingham2018seductress,
    author = "Bermingham, Katherine C.",
    title = "Seductress, Storyteller, and Subject",
    journal = "New German Critique",
    year = "2018",
    doi = "10.1215/0094033x-4269886",
    note = "CORE ARGUMENT: Bermingham argues that Helen of Argos and Troy, though conspicuously absent from Horkheimer and Adorno's Odyssey excursus and from prior feminist commentary on it, is central to the excursus's thesis about the emergence of bourgeois subjectivity: as much as Odysseus, Helen exhibits the incipient features of an individuated and alienated protobourgeois subject, revealing that Horkheimer and Adorno undertheorize women's experience of subjectivity, which explains her exclusion from their analysis. RELEVANCE: Extends the domain's account of the Odyssey excursus as genealogy of the self by identifying a structural gap (gendered subjectivity) in Horkheimer and Adorno's historical narrative of subject-formation. POSITION: Feminist immanent critique of the Odyssey excursus that supplements rather than rejects the entwinement thesis's account of subject formation.",
    keywords = "Odyssey-excursus, gender, genealogy-of-subject, Medium, METADATA\_CLEANED: volume, number, pages",
    abstract = "Max Horkheimer and Theodor Adorno’s Dialectic of Enlightenment laid indispensable groundwork for critiquing instrumental rationality and the power dynamics embedded in discursive logic. Especially relevant for feminist theorists is the pair’s excursus on Homer’s Odyssey, which reads the hero’s epic journey as an allegory for the emergence of subjectivity. Horkheimer and Adorno interpret Homer’s female characters as sensual forces of nature that Odysseus must resist in his quest for homecoming. Yet, conspicuously absent from Horkheimer and Adorno’s analysis—and previous feminist commentaries on their analysis—is Homer’s paragon of feminine sensuality: Helen of Argos and Troy. This article rereads the treacherous beauty through Horkheimer and Adorno’s critical perspective, arguing that despite Helen’s exclusion from the text of Dialectic of Enlightenment, she is central to its thesis. As much as the poem’s eponymous hero, Helen exhibits the incipient features of an individuated (and alienated) protobourgeois subject. Ultimately, this article contends that Horkheimer and Adorno undertheorize women’s experience of subjectivity, which seems to explain why they exclude Helen from their analysis.",
    abstract_source = "openalex"
}

@misc{kent2024semblance,
    author = "Kent, James",
    title = "A semblance of freedom: Horkheimer and Adorno's conception of myth",
    year = "2024",
    volume = "52",
    pages = "3--22",
    doi = "10.1177/01914537241284718",
    note = "CORE ARGUMENT: Kent argues that the pessimistic reading of Dialectic of Enlightenment — on which reason remains ensconced within the domination of myth — misses that myth also functions as an incomplete but largely untapped mediator of human experience via language, and thus as a promising source of rational self-knowledge. Drawing on Hulatt's account of the mimesis/self-preservation tension, Kent contends myth's linguistic mediation between a community of speakers and their violent, ambiguous pasts offers momentary reflections of relinquished possibilities of life, presenting a renewed chance of enlightenment. RELEVANCE: Directly addresses the domain's fourth key question — whether the book's account is fatalistic/totalizing — by locating emancipatory potential within the very concept of myth that the entwinement thesis treats as already enlightenment. POSITION: Anti-fatalist reconstruction of the myth/enlightenment relation, building on Hulatt's tripartite model to recover critical resources from myth itself.",
    keywords = "myth, emancipatory-potential, fatalism-debate, High, METADATA\_CLEANED: journal, number, type:@article->@misc",
    abstract = "In this paper I argue that the pessimistic reading of Horkheimer and Adorno’s Dialectic of Enlightenment, which suggests reason is ensconced within the domination of myth, misses a key component of the authors' argument. Specifically, it misses the possibility that the liberation from the heteronomy of myth might occur via a critique of myth. Using Owen Hulatt’s reinterpretation of Adorno’s account of the tension between mimesis and self-preservation as a point of orientation, I show that while myth for Horkheimer and Adorno is synonymous with a heteronomous form of life, they simultaneously recognize it as an incomplete but largely untapped mediator of the history of human experience (via language), and thus a promising source of rational self-knowledge. Specifically, myth can illuminate fragments of both the contingent factors that led to human sociality becoming entwined with domination, while also offering momentary reflections of the kinds of life that were relinquished in the drive for instrumentalised survival. I propose that for Horkheimer and Adorno it is myth’s linguistic mediation between a community of speakers and their (often violent and ambiguous) pasts that is unique. It is thus myth’s capacity to offer a meditation on those other possibilities of human existence that presents a renewed chance of enlightenment.",
    abstract_source = "s2"
}

@article{allen2024odysseus,
    author = "Allen, William S.",
    title = "Odysseus and Adorno: A Note on Cunning and Dialectics",
    journal = "New German Critique",
    year = "2024",
    doi = "10.1215/0094033x-11309158",
    note = {CORE ARGUMENT: W. S. Allen argues that readings of Odysseus in the excursus as merely a prototype of bourgeois instrumental reason fail to grasp the full breadth of the dialectic of myth and enlightenment, overlooking the role of Odysseus's cunning (metis). Cunning, Allen contends, is itself a form of mimetic intelligence bearing its own internal dialectic, with implications for how Adorno's later work on non-identity should be understood. RELEVANCE: Refines the domain's account of the Odyssey excursus as genealogy of the self by distinguishing cunning/mimetic intelligence from bare instrumental calculation within Odysseus's characterization. POSITION: Revisionist reading of the excursus against the standard "instrumental-reason prototype" interpretation of Odysseus.},
    keywords = "Odyssey-excursus, cunning, mimesis, Medium, METADATA\_CLEANED: volume, number, pages",
    abstract = "The reading of the Odysseus excursus in Dialektik der Aufklärung has been hampered by the insistence that the character of Odysseus is merely a prototype of bourgeois instrumental reason. However, this characterization fails to grasp the full breadth of the dialectic of myth and enlightenment, and overlooks the significant role played by Odysseus’s cunning in the development of reason. In addressing these problems, it becomes apparent that cunning is a form of mimetic intelligence and bears its own form of dialectic, which has implications for the understanding of Adorno’s later works.",
    abstract_source = "s2"
}

@misc{freyenhagen2024why,
    author = "Freyenhagen, Fabian",
    title = "Why Professor Habermas Would Fail a Class on Dialectic of Enlightenment",
    year = "2024",
    note = {CORE ARGUMENT: Using a polemical thought-experiment (would Habermas's own essay on the book pass as coursework in a class on it?), Freyenhagen critically dissects Habermas's "Entwinement of Myth and Enlightenment" and its pivotal role in repositioning Critical Theory in the 1980s. He sketches an alternative reading of Dialectic of Enlightenment as a self-therapeutic exercise in destabilizing a complacent self-conception of modernity as moral progress, rather than as the theoretical dead end Habermas presents it to be. RELEVANCE: A direct, sustained rejoinder to the Habermasian performative-contradiction critique that anchors the domain's fourth key question about fatalism and remaining critical purchase, proposing that the book performs rather than argues its critique. POSITION: Anti-Habermasian reconstruction; treats the book's aporetic, non-argumentative form as a deliberate philosophical strategy rather than a defect, aligned with Honneth's disclosive-critique reading but framed as direct rebuttal.},
    keywords = "Habermas-critique, self-therapeutic-reading, reception-debate, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Would Habermas’s “The Entwinement of Myth and Enlightenment” pass muster as coursework in a class on Dialectic of Enlightenment? Using this polemical thought experiment setup as an estrangement device, I critically discuss Habermas’s essay that was pivotal in his repositioning of Critical Theory in the 1980s. I argue that it is philosophically and biographically unreflective; and that he is engaging in underhanded politicking. I sketch an alternative reading of Dialectic of Enlightenment: instead of viewing it as the dead end that Habermas presents it to be, we can see as a self-therapeutical exercise in destabilizing a complacent self-conception whereby modernity is the pinnacle of moral progress—an exercise which might have a certain exemplarity for others in the ongoing quest of making use of our own understanding. The contribution is rounded off with a postscript by a second assessor of Habermas’s essay, discussing both the proposed assessment and the polemical thought experiment.",
    abstract_source = "s2"
}

@misc{setiya2023human,
    author = "Setiya, Kieran",
    title = "Human nature, history, and the limits of critique",
    year = "2023",
    volume = "32",
    abstract = {This essay defends a form of ethical naturalism in which ethical knowledge is explained by human nature. Human nature, here, is not the essence of the species but its natural history as socially and historically determined. The argument does not lead to social relativism, but it does place limits on the scope of ethical critique. As society becomes "total", critique can only be immanent; to this extent, Adorno and the Frankfurt School are right.},
    note = {CORE ARGUMENT: Setiya defends an ethical naturalism on which human nature is not a fixed species-essence but a socially and historically determined "natural history." This does not entail social relativism but does limit the scope of ethical critique: once society becomes "total," critique can only proceed immanently — a limitation Setiya credits Adorno and the Frankfurt School with correctly identifying. RELEVANCE: Engages the domain's question of the scope and status of the historical narrative from outside Critical Theory, testing whether Adorno's totality thesis and immanent-critique methodology hold up as a general philosophical claim about the limits of critique under conditions of social totalization. POSITION: Sympathetic but independent (analytic ethical-naturalist) endorsement of the Frankfurt School's immanent-critique constraint, rather than an internal exegesis of Dialectic of Enlightenment.},
    keywords = "immanent-critique, totality, ethical-naturalism, natural-history, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{wankhammer2024nature,
    author = "Wankhammer, Johannes",
    title = {The Nature of Critique: Revisiting Adorno's "Natural History" amid the Postcritique Debates},
    journal = "New German Critique",
    year = "2024",
    abstract = {This article revisits Adorno's concept of "natural history" to propose an alternative to the exhausted paradigm of denaturalizing critique. As Jonathan Crary's work on the ruination of sleep illustrates, the reflex to denounce natural limits as ideological constructs falls short when it comes to confronting social pathologies wrought by late capitalism's demand for infinite flexibility. Since its Enlightenment origins, however, critical thought has tended to attack natural limits as illegitimate barriers to human self-determination, even before this strategy became, with Nietzsche, the sole rationale behind denaturalizing critique. By contrast, Adorno's concept of natural history offers a profound (if long-overlooked) self-critique of critique's one-sided reliance on denaturalization: it suggests how it is possible to harness natural limits as levers for emancipatory transformation rather than blindly calling for the transformation of given limits. Pace Adorno, such natural-historical critique may clarify emerging forms of political praxis, especially those fighting for environmental justice.},
    note = {CORE ARGUMENT: Wankhammer recovers Adorno's early concept of "natural history" (Naturgeschichte, from the 1932 lecture "The Idea of Natural History," foundational to the historical-anthropological method later deployed in Dialectic of Enlightenment) as an alternative to critique's habitual denaturalization strategy. Natural history proposes that nature and history are not opposed but mutually constitutive categories: nature appears as historically sedimented, and history appears as a kind of second nature — a methodological move that underwrites the book's genealogy of reason. RELEVANCE: Bears directly on the domain's first key question — the scope and status of the book's historical narrative — by tracing its methodological roots to the natural-history concept, clarifying in what sense the narrative is neither purely universal-transhistorical nor purely contingent-empirical but dialectically both. POSITION: Methodological/genealogical reconstruction of Adorno's philosophy of history via the natural-history concept, applied to contemporary "postcritique" debates.},
    keywords = "natural-history, historical-narrative-status, method, High, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{oconnor2008adorno,
    author = "O'Connor, Brian",
    editor = "Cook, Deborah",
    title = "Adorno: Philosophy of History",
    year = "2008",
    address = "Durham, UK",
    abstract = "The concept of history was developed in a great array of directions during the period of Modern German Philosophy. Ranging from macrostructural analyses of the evolution of civilizations to descriptions of the temporal social experience of the individual it was essentially a critical concept, one which would seek to expose the allegedly naive idea of the fixed properties of culture and of the individuals who might live within them. Adorno belongs to this tradition of critical historical philosophy. His philosophy of history is strongly marked by various Hegelian, Marxian, Nietzschean and hermeneutical ideas. A preoccupation with the idea of history is evident from the very beginnings of Adorno's career. From his Habilitationsschrift (1931) right up to Aesthetic Theory (incomplete at the time of his death in 1969) the issue is never far from central. To deal comprehensively with the range of influences and the multiplicity of applications of the concept of history in Adorno's work would be co-extensive with a critical analysis of his oeuvre. What this chapter will restrict itself to is Adorno's engagements with what might be specifically regarded as 'theories of history.' The topics to be examined are Adorno's critique of (1) the idea of universal history and (2) of progress, (3) his dialectical reading of the idea of natural history, and (4) his assessment of role of the totality in the production of history.",
    note = {CORE ARGUMENT: O'Connor surveys Adorno's engagement with theories of history proper, organized around four topics: the critique of universal history, the critique of progress, the dialectical reading of natural history, and the role of totality in the production of history. He situates Dialectic of Enlightenment's genealogy within this broader, Hegelian-Marxian-Nietzschean-hermeneutical constellation running from Adorno's 1931 Habilitationsschrift through to Aesthetic Theory. RELEVANCE: Addresses the domain's first key question — in what sense the book is a "philosophy of history" and what the scope of its narrative is (universal, transhistorical, or ad hoc) — as its explicit and sole topic, distinguishing Adorno's critique of universal history from his critique of progress and from his use of natural history and totality. POSITION: Synoptic overview essay establishing the conceptual vocabulary (universal history, progress, natural history, totality) subsequently used by more specialized studies in this domain (e.g., Wankhammer, Setiya).},
    keywords = "philosophy-of-history, universal-history, progress, totality, High, METADATA\_CLEANED: booktitle, publisher, type:@incollection->@misc"
}

@misc{evans2020dialectic,
    author = "Evans, Justin",
    title = "The Dialectic of Enlightenment as parody of anti-enlightenment thought",
    year = "2020",
    note = "CORE ARGUMENT: Evans proposes reading Dialectic of Enlightenment as, in part, a parody of anti-enlightenment thought (of the kind found in Spengler, Klages, and related cultural-pessimist traditions) rather than as itself an instance of straightforward cultural pessimism. On this reading, the book's rhetorical excess and totalizing pronouncements are deliberately styled to mimic and thereby undercut anti-enlightenment rhetoric from within. RELEVANCE: Bears on the domain's fourth key question — whether the book's account is fatalistic/totalizing — by proposing a genre-based explanation (parody) for its bleak rhetorical register that would defuse charges of straightforward cultural pessimism. POSITION: A distinctive, genre/rhetoric-focused alternative to both the Habermasian totalizing-critique reading and the disclosive-critique (Honneth) reading.",
    keywords = "parody, cultural-pessimism, rhetoric, fatalism-debate, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The Dialectic of Enlightenment is a book of paradoxes. The most commonly noted is summed up in the book’s preface: “enlightenmentrevertstomythology”(Horkheimer\&Adorno,2002,p.xviii/6). 1 Progressbecomesregression,civilization ends in barbarism. A focus on this paradox suggests that the book is a critique of enlightenment thinking, which will be always and forever dominating. A second paradox often receives less attention: enlightenment itself is not enlightened. 2 Myargumentisthatthisparadoxiscentraltothetext,andthatitshould,infact,bestatedmorestrongly: only enlightenment is not yet enlightened. This conclusion is warranted by two arguments. In the first, the Dialectic of Enlightenment shows that enlightenment is mythical—not enlightened—in the sense that it is taken as a given that human beings must simply accept, rather than subjecting it to critique. In the second, the book shows that any non or anti-enlightenment thought is already enlightened, in the sense that they are entangled with enlightenment practices, social forms, or concepts. This second argument is made through parodies of anti-enlightenment ideas that were common through the first half of the 20th century. Seen in this light, The Dialectic of Enlightenment is at least as much a parodic critique of anti-enlightenment thought as it is a criticism of enlightenment as we know it. I begin by summing up the intellectual atmosphere in which Horkheimer and Adorno wrote Dialectic of Enlighten-ment ,notingsomeattemptstofindother-than-enlightenmentfoundationsforcritique.Next,Idiscussimportantinter-pretations of the book’s attitude towards enlightenment, before describing the authors’ systematically ambiguous use of the term as both totalitarian and emancipatory. I then",
    abstract_source = "s2"
}

@article{foster2001dialectic,
    author = "Foster, Roger",
    title = "Dialectic of Enlightenment as Genealogy Critique",
    journal = "Telos",
    year = "2001",
    note = {CORE ARGUMENT: Foster reads Dialectic of Enlightenment as a genealogical critique in a broadly Nietzschean-Foucauldian sense: rather than offering a linear causal history or a normatively grounded argument, the book traces the contingent, power-laden emergence of instrumental rationality and the modern subject, exposing the historical costs (domination of nature, renunciation, sacrifice) concealed within reason's self-understanding as progress. RELEVANCE: Directly addresses the domain's first key question by classifying the book's mode of historical argument as genealogy critique — distinct from causal historiography and from Hegelian teleological history — and thus offers a methodological account of the "scope and status" of the historical narrative. POSITION: Situates Dialectic of Enlightenment within the genealogical tradition of historical critique (Nietzsche, later Foucault) rather than within either Hegelian dialectical history or empirical social history.},
    keywords = "genealogy, method, historical-narrative-status, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages"
}

@article{adorno1984idea,
    author = "Adorno, T. W.",
    title = "The Idea of Natural History",
    journal = "Telos",
    year = "1984",
    note = {CORE ARGUMENT: Adorno's 1932 Frankfurt lecture argues that the received antithesis between nature (as static, ahistorical, and mythically recurring) and history (as the domain of meaningful human change) must be dialectically dissolved into the single category of "natural history." Nature is shown to be historical (produced, sedimented, transient) and history is shown to recur with nature-like compulsion (myth, second nature). The lecture polemicizes explicitly against Heidegger's fundamental ontology, which Adorno reads as reintroducing an ahistorical "meaning" under cover of historicity, and against historicism's naive faith in meaningful progression. RELEVANCE: This is the primary text that anchors the entire domain and the conceptual seed of the later enlightenment-reverts-to-myth thesis in Dialectic of Enlightenment. Its programmatic dissolution of nature/history is the theoretical precondition for treating "myth" and "enlightenment" as dialectically entangled rather than successive stages. POSITION: Foundational primary source; the concept from which all other entries in this domain take their bearings.},
    keywords = "natural history, Naturgeschichte, primary-source, Heidegger, historicism, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "Abstract Allow me to preface my remarks today by saying that I am not going to give a lecture in the usual sense of communicating results or presenting a systematic statement. Rather, what I have to say will remain on the level of an essay; it is no more than an attempt to take up and further develop the problems of the so-called Frankfurt discussion. I recognize that many uncomplimentary things have been said about this discussion, but I am equally aware that it approaches the problem correctly and that it would be wrong always to begin again at the beginning.",
    abstract_source = "openalex"
}

@misc{pensky2004naturalhistory,
    author = "Pensky, Max",
    title = "Natural History: The Life and Afterlife of a Concept in Adorno",
    year = "2004",
    note = {CORE ARGUMENT: Pensky distinguishes three distinct but interlocking strands united under Adorno's concept of natural history: (a) a reflection on the normative and methodological bases of philosophical anthropology and critical social science; (b) a conception of critical memory oriented toward preserving the memory of historical suffering; and (c) the "mindfulness of nature in the subject" thesis asserted in Dialectic of Enlightenment. He argues these strands are united by the category of transience and the goal of a critical theory sensitive to what is transient in history, and closes by exploring implications for Habermas's discourse theory. RELEVANCE: Provides the most systematic reconstruction of how many senses of "natural history" operate across Adorno's career, directly answering the research question of whether the concept is a stable doctrine or shifting motif — Pensky argues for an underlying unity (transience) beneath surface diversity. POSITION: Unificatory reading — natural history as a coherent, multiply-articulated concept rather than a loose family of usages.},
    keywords = "natural history, Naturgeschichte, transience, memory, Habermas, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Theodor Adorno's concept of ‘natural history’ [Naturgeschichte] was central for a number of Adorno's theoretical projects, but remains elusive. In this essay, analyse different dimensions of the concept of natural history, distinguishing amongst (a) a reflection on the normative and methodological bases of philosophical anthropology and critical social science; (b) a conception of critical memory oriented toward the preservation of the memory of historical suffering; and (c) the notion of ‘mindfulness of nature in the subject’ provocatively asserted in Max Horkheimer and Adorno's Dialectic of Enlightenment. These strands are united by the notion of transience and goal of developing a critical theory sensitive to the transient in history. The essay concludes by suggesting some implications of an expanded concept of natural history for issues in the discourse theory of Jürgen Habermas.",
    abstract_source = "s2"
}

@article{pensky2021naturalhistory,
    author = "Pensky, Max",
    title = "Natural History and Aesthetic Truth in {Aesthetic Theory}",
    journal = "New German Critique",
    year = "2021",
    note = {CORE ARGUMENT: Pensky argues that Adorno's 1932 lecture on natural history supplies the interpretive resources needed to clarify the otherwise obscure claim in Aesthetic Theory that artworks possess a "truth content" accessible only through philosophical interpretation. Reading the lecture's core category of transience back into Aesthetic Theory, he shows how art's truth content functions as ideology critique, disclosing conditions of social domination beyond the purely aesthetic sphere. RELEVANCE: Demonstrates the persistence of the 1932 lecture's categories (transience, allegorical reading of the "petrified") into Adorno's mature aesthetics, directly relevant to the question of the concept's role in his later philosophy. POSITION: Continuity thesis — the early lecture as an interpretive key to the late aesthetics, against readings that treat "natural history" as confined to Adorno's early or historico-philosophical writings.},
    keywords = "natural history, aesthetic theory, transience, truth content, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "abstract\_source = {s2}, Theodor W. Adorno’s claim in Aesthetic Theory that artworks have a truth content, and that this truth content in turn depends on philosophical interpretation, is among the work’s most challenging and obscure claims. This article argues that “The Idea of Natural History,” Adorno’s lecture dating to 1932, offers important resources for interpreting the claim of art’s truth content. Reading the lecture’s core idea of transience, the article proposes that the form of philosophical interpretation Adorno develops there illuminates one way to clarify what Adorno means, in Aesthetic Theory, by the interpretation of art’s truth content. While far from definitive, this conclusion does support interpretations of art’s truth content that foreground art’s function as a critique of ideology, that is, of having a field of application that moves beyond the sphere of the aesthetic and toward the disclosure of conditions of social domination."
}

@misc{whyman2016understanding,
    author = "Whyman, Tom",
    title = "Understanding {Adorno} on '{Natural-History}'",
    year = "2016",
    note = {CORE ARGUMENT: Whyman contends that existing scholarship provides little clarity on what Adorno's natural-history concept actually is or does, and argues that it is best understood not as a substantive metaphysical or historiographical thesis but as a "therapeutic" concept: its function is to dissolve certain philosophical anxieties (about the status of nature, history, and their relation) that would otherwise obstruct a critical-theoretical understanding of reality. RELEVANCE: Offers a distinct methodological reading against which Pensky's unificatory account can be productively contrasted, directly addressing the research question of what work "dissolving the antithesis" actually does and how it differs from both naturalism and historicism. POSITION: Therapeutic/methodological reading, in contrast to Pensky's substantive/doctrinal reading of the same concept.},
    keywords = "natural history, Naturgeschichte, methodology, Wittgenstein, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "‘Natural-History’ is one of the key concepts in the thought of the Frankfurt School critical theorist Theodor W. Adorno, appearing from his very earliest work through to his very last. Unfortunately, the existing literature provides little illumination as to what Adorno’s concept of natural-history is, or what it is supposed to do. This paper thus seeks to supply the required understanding. Ultimately, I argue that ‘natural-history’ is best understood as a sort of ‘therapeutic’ concept, intended to dissolve certain philosophical anxieties which might otherwise present obstacles to our being able to obtain a critical-theoretical understanding of reality.",
    abstract_source = "openalex"
}

@misc{gandesha2004writing,
    author = "Gandesha, Samir",
    title = "Writing and Judging: {Adorno}, {Arendt} and the Chiasmus of Natural History",
    year = "2004",
    volume = "30",
    abstract = "This essay engages in a comparative analysis of Theodor W. Adorno and Hannah Arendt. It does so by situating both thinkers in terms of their respective Auseinandersetzungen with the fundamental ontology of Martin Heidegger. While Heidegger seeks to engage in a Destruktion of the opposition between time and being, Adorno and Arendt seek to understand this relation critically in terms of the concept of 'natural history'. For both, a reading of Kant's Third Critique becomes the indispensable means by which it is possible to locate a path pointing beyond the chiasmic structure of natural history.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Gandesha argues that both Adorno and Arendt develop their critical relation to Heidegger's fundamental ontology through the shared category of "natural history," and that for both a reading of Kant's Third Critique (reflective judgment) becomes indispensable for locating a path beyond the "chiasmic" (crossed, entangled) structure of nature and history that Heidegger's Destruktion leaves unresolved. RELEVANCE: Extends the natural-history problematic comparatively to Arendt, clarifying precisely how Adorno's anti-Heideggerian polemic in the 1932 lecture functions and what alternative (aesthetic/reflective judgment) it proposes. POSITION: Comparative reading situating natural history as a shared post-Heideggerian category across two otherwise divergent critical theorists.},
    keywords = "natural history, Heidegger, Arendt, judgment, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{stone2006disenchantment,
    author = "Stone, Alison",
    title = "Adorno and the Disenchantment of Nature",
    year = "2006",
    volume = "32",
    abstract = "In this article I re-examine Adorno's and Horkheimer's account of the disenchantment of nature in Dialectic of Enlightenment. I argue that they identify disenchantment as a historical process whereby we have come to find natural things meaningless and completely intelligible. However, Adorno and Horkheimer believe that modernity not only rests on disenchantment but also tends to re-enchant nature, because it encourages us to think that its institutions derive from, and are anticipated and prefigured by, nature. I argue that Adorno's Negative Dialectics and Aesthetic Theory show how constellations and artworks generate an alternative form of reenchantment which is critical of modernity and its domination of nature. This form of re-enchantment finds natural beings to be mysteriously meaningful because they embody histories of immeasurable suffering. This experience engenders guilt and antipathy to human domination over nature.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Stone argues that Adorno and Horkheimer's disenchantment thesis in Dialectic of Enlightenment identifies a historical process by which natural things become meaningless and fully intelligible, but that modernity simultaneously re-enchants nature by treating social institutions as naturally derived. She shows how Negative Dialectics and Aesthetic Theory articulate a critical counter-re-enchantment, where natural beings appear mysteriously meaningful because they embody histories of suffering — directly reprising the natural-history category (nature as sedimented history) in an ecological register. RELEVANCE: Connects the disenchantment/re-enchantment dialectic of Dialectic of Enlightenment directly to the natural-history category and to Adorno's later works, illuminating how the domain examined here underwrites the Dialectic of Enlightenment domain without collapsing into it. POSITION: Reads natural history as underwriting a critical, suffering-attentive account of nature opposed to both naive disenchantment and ideological re-enchantment.",
    keywords = "natural history, disenchantment, Dialectic of Enlightenment, nature, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{friedlander2024walter,
    author = "Friedlander, Eli",
    title = "Walter Benjamin and the Idea of Natural History",
    year = "2024",
    abstract = "In this incisive new work, Eli Friedlander demonstrates that Walter Benjamin's entire corpus, from early to late, comprises a rigorous and sustained philosophical questioning of how human beings belong to nature. Across seemingly heterogeneous writings, Friedlander argues, Benjamin consistently explores what the natural in the human comes to, that is, how nature is transformed, actualized, redeemed, and overcome in human existence. The book progresses gradually from Benjamin's philosophically fundamental writings on language and nature to his Goethean empiricism, from the presentation of ideas to the primal history of the Paris arcades. Friedlander's careful analysis brings out how the idea of natural history inflects Benjamin's conception of the work of art and its critique, his diagnosis of the mythical violence of the legal order, his account of the body and of action, of material culture and technology, as well as his unique vision of historical materialism. Featuring revelatory new readings of Benjamin's major works that differ, sometimes dramatically, from prevailing interpretations, this book reveals the internal coherence and philosophical force of Benjamin's thought.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Friedlander argues that natural history is not merely a concept Adorno borrowed and adapted from Benjamin but an organizing philosophical problem running through Benjamin's entire corpus in its own right — from the early writings on language and nature, through Goethean "empiricism" and the theory of ideas, to the Arcades Project's primal history (Urgeschichte). He traces how this idea shapes Benjamin's philosophy of art, his critique of mythical violence in law, his account of embodiment and technology, and his historical materialism. RELEVANCE: Directly addresses the research question of Benjamin's own contribution to natural history (beyond his role as source for Adorno), providing the most sustained recent treatment of Benjamin's independent natural-historical philosophy and a needed counterweight to Adorno-centered accounts. POSITION: Benjamin-centered reading; natural history as Benjamin's own sustained philosophical project rather than a motif Adorno extracted from Trauerspiel and the theory of allegory alone.},
    keywords = "natural history, Benjamin, allegory, Urgeschichte, arcades, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{breitenstein2021zerschlagen,
    author = "Breitenstein, Peggy H.",
    title = {Zerschlagen des Scheins der Naturw{\"u}chsigkeit: Naturgeschichte zwischen {Marx} und {Adorno}},
    year = "2021",
    abstract = {Natural history is a key concept in Adorno's philosophy of history. In the second model of Negative Dialectics, he develops this concept following Marx's critique of political economy, which, as a critique of ideology, criticises the appearance of natural necessity of social practices and relations. Starting from an irritation concerning a note by Adorno in which he reproaches Marx for "language mannerisms" and conceptual inability, this article argues that Adorno's critique is based on a one-sided reading, preventing him from adequately considering the critical-emancipatory potential of the concept of natural history. This potential is not independent of linguistic and aesthetic mediation. Rather, Marx uses metaphors, caricatures, etc. in his depiction of social practices as natural history, enabling him to convey more than theoretical knowledge. His critical theory is emancipatory precisely in that it compels agents to self-criticism, which is a necessary condition for sustainably shattering the appearance of natural necessity.},
    abstract_source = "crossref",
    note = {CORE ARGUMENT: Breitenstein examines natural history as developed in the second model of Negative Dialectics, where Adorno follows Marx's critique of political economy in criticizing the appearance of natural necessity (Naturwüchsigkeit) attaching to social relations. Against Adorno's own dismissive remarks about Marx's "language mannerisms," she argues Adorno's reading is one-sided and underestimates how Marx's metaphorical and aesthetic mediation of "social practices as natural history" is itself critically emancipatory, compelling agents toward self-criticism. RELEVANCE: Locates natural history precisely within Negative Dialectics' argumentative structure and its debt to (and departure from) Marx, sharpening the question of how the concept evolves from the 1932 lecture into Adorno's mature dialectics. POSITION: Corrective reading of Adorno's own reception of Marx via the natural-history concept, emphasizing underappreciated continuities.},
    keywords = "natural history, Naturgeschichte, Marx, Negative Dialectics, ideology critique, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{cook2011adorno,
    author = "Cook, Deborah",
    title = "Adorno on Nature",
    year = "2011",
    abstract = "Decades before the environmental movement emerged in the 1960s, Adorno condemned our destructive and self-destructive relationship to the natural world, warning of the catastrophe that may result if we continue to treat nature as an object that exists exclusively for our own benefit. Adorno on Nature presents the first detailed examination of the pivotal role of the idea of natural history in Adorno's work. A comparison of Adorno's concerns with those of key ecological theorists -- social ecologist Murray Bookchin, ecofeminist Carolyn Merchant, and deep ecologist Arne Naess -- reveals how Adorno speaks directly to many of today's most pressing environmental issues. Ending with a discussion of the philosophical conundrum of unity in diversity, Adorno on Nature also explores how social solidarity can be promoted as a necessary means of confronting environmental problems.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Cook offers a detailed, book-length examination of the pivotal role natural history plays across Adorno's work on nature, comparing his concerns to social ecology (Bookchin), ecofeminism (Merchant), and deep ecology (Naess), and concluding with a discussion of unity-in-diversity and the conditions for social solidarity in confronting environmental catastrophe. RELEVANCE: The most sustained monograph-length treatment connecting natural history to Adorno's broader philosophy of nature, useful for synthesizing the concept's ecological afterlife and its systematic role beyond the 1932 lecture and Negative Dialectics. POSITION: Natural history as Adorno's central category for a critical (proto-ecological) philosophy of nature, read comparatively against later environmental philosophy.",
    keywords = "natural history, ecology, philosophy of nature, Medium, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{buckmorss1977origin,
    author = "Buck-Morss, Susan",
    title = "The Origin of Negative Dialectics: Theodor W. Adorno, Walter Benjamin, and the Frankfurt Institute",
    year = "1977",
    note = {CORE ARGUMENT: Buck-Morss reconstructs the intellectual formation of Adorno's negative dialectics through his early engagement with Benjamin's method (allegory, the dialectical image, and the critique of idealist system-building) and the Frankfurt Institute's interdisciplinary program. Per the SEP entry on Adorno, Buck-Morss's account documents how Adorno's pre-exile writings of the 1930s were "strongly influenced by Siegfried Kracauer, Georg Lukács, and above all Walter Benjamin," and traces how Kierkegaard's "objectless inwardness" is shown by Adorno, via Benjaminian method, to conceal a timeless "second nature" beneath its apparently ahistorical dialectic of subjectivity (SEP: Adorno, sec. 2, citing Buck-Morss 1977, 111-121). RELEVANCE: Provides the biographical-intellectual context establishing how the Lukács/Benjamin genealogy of natural history entered Adorno's thought during exactly the period (late 1920s-early 1930s) of the 1932 natural-history lecture and the Kierkegaard book, making it a key secondary source for the domain's genealogical questions. POSITION: Foundational intellectual history of the Adorno-Benjamin relationship and its bearing on negative dialectics, still a reference point (frequently cited in the SEP entry on Adorno) for the Lukács/Benjamin inheritance behind natural history.},
    sep_context = {SEP Adorno entry, sec. 2 "Early Writings," cites Buck-Morss (1977) three times: to establish that Adorno's pre-exile 1930s writings were "strongly influenced by Siegfried Kracauer, Georg Lukács, and above all Walter Benjamin"; and, drawing on Buck-Morss 1977, 111-121, to explain how in the Kierkegaard book the external social world appears only as mirrored "second nature" to Kierkegaard's "objectless inwardness," a reading Adorno's Benjaminian method is said to reveal.},
    keywords = "natural history, Benjamin, negative dialectics, intellectual history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{helmling2003constellation,
    author = "Helmling, Steven",
    title = "Constellation and Critique: {Adorno}'s Constellation, {Benjamin}'s Dialectical Image",
    year = "2003",
    note = {CORE ARGUMENT: Helmling examines Adorno's practice of "constellation" in relation to and tension with Benjamin's "dialectical image," both understood as natural-historical modes of critical presentation. Adorno repeatedly characterizes Benjamin's totality of thought as "natural history," drawn to "the petrified, frozen or obsolete elements of civilization"; Helmling traces Adorno's ambivalence about the resulting effect of stasis (the "Medusa-gaze" that petrifies its object) across Adorno's career and into the "dialectics at a standstill" that structures Dialectic of Enlightenment's account of progress reverting to regress. RELEVANCE: Directly illuminates the connection between natural history's categories of petrification/transience and Adorno's central expository method (constellation), showing how a natural-historical sensibility shapes not just Adorno's content but his form of critique. POSITION: Reads natural history as constitutively bound up with the formal/methodological question of how critical theory represents its objects (constellation vs. dialectical image), rather than as a purely substantive thesis.},
    keywords = "natural history, constellation, dialectical image, Benjamin, petrification, High, METADATA\_CLEANED: journal, volume, number, doi, type:@article->@misc",
    abstract = "Constellation and Critique: Adorno’s Constellation, Benjamin’s Dialectical Image Steven Helmling (bio) Abstract This essay considers Adorno’s theory and practice of “constellation,” most centrally in relations both of influence and of tension with Walter Benjamin’s practice of the “dialectical image.” In later years, Adorno frequently ascribed to Benjamin’s practice a “Medusa-gaze” that effectively petrified, or (telling ambivalence) exposed the always-already-petrified reification, of its ideological object; in this way, Benjamin’s work aimed to evoke the baffled or arrested progress of modernity that he famously evoked in the phrase “dialectics at a standstill.” This was a thematic Adorno prolonged, but from very early on, Adorno had misgivings about the effect of stasis that Benjamin’s dialectical image as much reinforced as critiqued. The essay looks closely at various of Adorno’s formulations about Benjamin as well as about such related matters as “immanent critique,” Gestalt psychology, and Hölderlin’s practice of “parataxis,” to elicit the tensions in Adorno’s thinking, over the course of his career, about the critical or dialectical mimesis necessarily obtaining between critique and its object (the representation of the object, the representation of the overcoming of the object). A particular focus here is narrative, a standard property of the type(s) of critique that Adorno meant to refuse; Adorno’s “debate” with Lukàcs here appears as embodying the transition from “realism” to “modernism” that was the debate’s ostensible theme. The essay closes with reflections on failed progress, or progress reverting to regress. Benjamin’s “dialectics at a standstill” could be the apt formula, but also the fate from which Adorno and Horkheimer so desperately hope to redeem Enlightenment. —sh Fredric Jameson years ago characterized Adorno’s chief critical device or method as the “historical trope” (Marxism and Form 3–59), so it shouldn’t strike anyone as a novel claim that Adorno’s “constellation” displays affinities with other now-familiar devices of modernist art and literature—Eisensteinian montage, cubist collage, the Joycean “epiphany,” the Poundian “ideogram.” The young Adorno presumably first encountered the word’s relevant usages when he read Benjamin’s Trauerspiel in the late 1920s; however that may be, the word recurs in his work throughout his career, from “The Actuality of Philosophy” (1931) to the late pieces collected in Critical Models. Its connotations are diverse and often conflicting, and one could make an interesting study of such tellingly divergent uses, as well as an interesting speculation of the rarity of Adorno’s own second-level reflections on the word.1 The present study, however, attempts nothing so comprehensive.2 I want in this paper to unpack some of the implications of constellation as a critical practice and elicit their tension or contradiction (a word not necessarily a vitiation in Adorno’s usage, and in many contexts a term of high praise) with the overall program, derived from Hegel, that Adorno regularly calls “immanent critique.” To that end, I will consider constellation in relation to Walter Benjamin’s “dialectical image,” with which it has obvious but also qualified affinities, to the Gestalt psychology of Wolfgang Köhler, from which Adorno would have been anxious to distinguish it, and to the epic device of “parataxis” as Adorno commends Hölderlin’s use of it. I will end by bringing the issues that emerge to bear on the 1944 Dialectic of Enlightenment, co-authored with Max Horkheimer, and the curiously agitated stasis “motivating” its thematic of Western Civilization’s “progress” and “regress.” Adorno and Benjamin It is in his “Portrait of Walter Benjamin” that Adorno speaks most suggestively and, for his own practice, most revealingly, about the theory, the practice, and the effect, of Benjamin’s dialectical image: The [Benjaminian] essay as form consists in the ability to regard historical moments, manifestations of the objective spirit, “culture,” as though they were natural. Benjamin could do this as no one else. The totality of this thought is characterized by what may be called “natural history.” He was drawn to the petrified, frozen or obsolete elements of civilization, to everything in it devoid of domestic vitality [...]. The French word for still-life, nature morte, could be written above the...",
    abstract_source = "openalex"
}

@misc{crawford2018index,
    author = "Crawford, Ryan",
    title = "Index of the Contemporary: {Adorno}, Art, Natural History",
    year = "2018",
    abstract = {That contemporary art is fundamentally irreducible to modernist art and aesthetics has become a commonplace of contemporary art theory and criticism. In marking this distinction, reference is often made to the obsolescence of once-dominant aesthetic categories and the need for breaking with aesthetic theories traditionally allied with artistic modernism. For many in the field of philosophical aesthetics, this means going beyond the work of Theodor W. Adorno and creating a conceptual discourse more appropriate to the current state of contemporary art. The present paper reconstructs the stakes of this legitimation crisis and sets Adorno's writings on art and aesthetics in relation to some of the most significant debates in recent art criticism. In the process, it demonstrates that many of the most pressing problems in contemporary art are integral to Adorno's aesthetic theory and that it is precisely at those points where his thought is today regarded as most problematic that it is often most instructive. Through a sustained examination of art's essential relation to what Adorno calls "natural-history," the problems of contemporary art and aesthetics are then situated within the wider context of art's relationship to a history of domination.},
    abstract_source = "core",
    note = {CORE ARGUMENT: Crawford reconstructs the "legitimation crisis" by which contemporary art theory claims to have moved beyond Adorno's aesthetic categories, arguing instead that many of contemporary art's most pressing problems are already integral to Adorno's aesthetic theory precisely through its sustained examination of art's relation to natural history and, through that relation, to a broader history of domination. RELEVANCE: Extends the natural-history category into contemporary art criticism, testing the concept's continued applicability and providing material for assessing whether natural history is best read as a historically bounded 1930s category or a still-productive critical tool. POSITION: Defends the continued relevance of Adorno's natural-history-based aesthetics against claims of its obsolescence for contemporary art.},
    keywords = "natural history, aesthetic theory, contemporary art, domination, Medium, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{daniels2020adorno,
    author = "Daniels, Jordan",
    title = "{Adorno}, {Benjamin}, and Natural Beauty on ``This Sad Earth''",
    year = "2020",
    note = "CORE ARGUMENT: Daniels argues that Adorno contests the Kantian demotion of natural beauty beneath artistic beauty and, by unpacking Adorno's endorsement of Benjamin's casting of both nature and history in terms of transience, shows that Adorno's natural beauty is expressive of social-historical content: an experience of nature that discloses ethical claims to act differently toward it, especially salient amid climate crisis. RELEVANCE: Directly links the natural-history category's core term (transience, shared by Adorno and Benjamin) to Adorno's aesthetics of natural beauty, showing the concept's persistence into Aesthetic Theory and its contemporary ecological uptake. POSITION: Ecologically inflected aesthetic reading, treating transience as the shared Adorno-Benjamin category linking natural history to natural beauty.",
    keywords = "natural history, natural beauty, transience, ecology, aesthetics, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "abstract:While Theodor Adorno is known for his philosophical reconstruction of aesthetic modernism, he also analyzes—and is critical of—the demotion of natural beauty in the hierarchy of aesthetic concerns following Kant. Recent scholars have acknowledged that natural beauty is important in Adornian aesthetics, but many do so in a manner that repeats the subordination of natural beauty and the aesthetic experience of nature to that of art. Against this tendency, in this article I demonstrate that not only does Adorno contest the inferiority of the aesthetic experience of nature but his unconventional description and theoretical articulation of natural beauty is especially pertinent for our time of climate crisis. By unpacking his endorsement of Walter Benjamin’s casting both nature and history in terms of transience, I argue that Adorno proposes an experience of natural beauty that is expressive of social historical content, offers a vision of a different relationship with nature, and discloses ethical claims on us to act in this world.",
    abstract_source = "s2"
}

@article{mccann2024ernst,
    author = "McCann, Andrew",
    title = {Ernst J{\"u}nger, Theodor {Adorno}, and the Idea of Natural History},
    journal = "New German Critique",
    year = "2024",
    note = {CORE ARGUMENT: McCann reads Adorno's rearticulation of natural history through the undecidable relationship between symbol and allegory, and shows this same structural condition operative in Ernst Jünger's writing from his 1920s protofascist journalism through his postwar work, where anthropocentric visions of world history rest on perishable symbolic identifications. He argues Jünger's late radicalization of natural history toward a "planetary history" superseding world history anticipates themes central to the environmental humanities. RELEVANCE: Provides an unexpected but philologically grounded comparative case (Jünger) for how the symbol/allegory distinction central to natural history (inherited from Benjamin's Trauerspiel study) operates outside the strictly Frankfurt School context, sharpening the domain's account of the allegory/symbol contrast. POSITION: Comparative intellectual history situating Adorno's natural history against a politically opposed but structurally convergent contemporary (Jünger), emphasizing the allegory/symbol axis over the Lukácsian second-nature axis.},
    keywords = "natural history, allegory, symbol, Junger, environmental humanities, Medium, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "This essay sets out an approach to Theodor Adorno’s rearticulation of the idea of natural history that foregrounds the undecidable relationship between symbol and allegory. This relationship is the structural condition of Ernst Jünger’s writing, from his protofascist journalism of the 1920s through to his postwar work, in which anthropocentric visions of world history are based on perishable symbolic identifications. As this becomes an increasingly prominent part of his thinking, he radicalizes the concept of natural history and, in the idea of planetary history superseding world history, anticipates some of the most topical contemporary work in the environmental humanities.",
    abstract_source = "s2"
}

@misc{escuelacruz2014hacia,
    author = "Escuela Cruz, Chaxiraxi",
    title = "Hacia una filosof{\'i}a materialista: la idea de {Naturgeschichte} en la obra de {Theodor W. Adorno}",
    year = "2014",
    abstract = {Este articulo estudia la evolucion del concepto de "historia natural" (Naturgeschichte) en la formacion de la filosofia materialista de Adorno. Su lectura polemiza con la concepcion de la historia dominante en las tendencias filosoficas de su epoca, como la ontologia heideggeriana, y frente a ellas propone una "reorientacion ontologica de la filosofia de la historia". Para ello, Adorno recurrira a la idea de "segunda naturaleza" que aparece en la Teoria de la novela de Lukacs y a la de "alegoria" de Benjamin como antecedentes filosoficos de la problematica.},
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Escuela Cruz traces the evolution of Naturgeschichte in the formation of Adorno's materialist philosophy, arguing that Adorno's 1932 lecture polemicizes against the dominant historical conceptions of his era (above all Heideggerian ontology) and proposes instead an "ontological reorientation of the philosophy of history," for which Adorno draws explicitly on Lukács's "second nature" from Theory of the Novel and on Benjamin's concept of "allegory" as the two philosophical antecedents of the problem. RELEVANCE: Offers the most direct and explicit reconstruction, among the papers found, of exactly how the two named genealogical sources (Lukács's second nature, Benjamin's allegory) function as "philosophical antecedents" for Adorno's natural history — precisely the genealogical question this domain foregrounds. POSITION: Genealogical reading emphasizing Lukács and Benjamin as jointly necessary antecedents for Adorno's "ontological reorientation" of the philosophy of history.},
    keywords = "natural history, Naturgeschichte, Lukacs, second nature, Benjamin, allegory, Heidegger, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{stahl2013lukacs,
    author = "Stahl, Titus",
    title = {Georg [Gy{\"o}rgy] Luk{\'a}cs},
    year = "2013",
    howpublished = "Stanford Encyclopedia of Philosophy, \url{https://plato.stanford.edu/entries/lukacs/}",
    note = {CORE ARGUMENT: The SEP entry surveys Lukács's philosophical development from Soul and Form and Theory of the Novel (1916) through History and Class Consciousness (1923) and his later aesthetics and ontology. Theory of the Novel's account of "second nature" — the alienated, convention-bound social world confronting the modern subject as meaningless and rigidly law-governed, as opaque and unownable as physical nature — is identified as the entry's discussion of how Lukács's critique of reification, later developed via commodity fetishism in History and Class Consciousness, first crystallizes. RELEVANCE: Provides the authoritative overview of the precise Lukácsian source-concept (second nature, Theory of the Novel) that Adorno radicalizes into natural history, and situates Lukács's reification theory (building on Weber's rationalization thesis) as backdrop for Adorno's and the Frankfurt Institute's debates in the 1930s and 1940s. POSITION: Reference overview, not a research contribution; used here to ground the Lukácsian half of the domain's genealogical inquiry in an authoritative secondary summary.},
    keywords = "Lukacs, second nature, reification, encyclopedia-entry, Medium, INCOMPLETE, no-abstract"
}

@article{frelek2025hope,
    author = "Frelek, Andrzej",
    title = "Hope in a Warming World: Rereading Adorno on Progress",
    journal = "New German Critique",
    year = "2025",
    volume = "52",
    note = {CORE ARGUMENT: Rereads Adorno's 1962 essay "Progress" against the horizon of the climate crisis, retracing his analysis of the relation between history and catastrophe (itself indebted to Benjamin), situating the concept of progress within the historical genealogy of philosophies of progress and their theological inheritance, and focusing on Adorno's critical reworking of progress in relation to the dialectic of freedom and unfreedom. RELEVANCE: Provides a close, argument-level reconstruction of the "Progress" essay's central moves and extends its non-affirmative, non-nihilistic treatment of progress to a contemporary "new catastrophe" (climate breakdown), directly addressing how Adorno holds progress and catastrophe together without collapsing one into the other. POSITION: A recuperative, "negative hope" reading that treats Adorno's dialectical concept of progress as still actionable rather than merely diagnostic.},
    keywords = "progress, catastrophe, climate-crisis, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "This article argues for the value inherent in rereading Theodor Adorno’s 1962 essay “Progress,” placing his thoughts in the context of the climate crisis and arguing for the necessity of retaining a form of negative hope in critical theory. First, the article retraces his analysis of the relation between history and catastrophe, itself indebted to the writings of Walter Benjamin. Second, the article shows how Adorno relates the aforementioned idea to the historical genealogy of philosophies of progress and their theological inheritance. Third, the article focuses on his critical reworking of the concept of progress and its relation to the dialectic of freedom and unfreedom. Finally, the article attempts to place Adorno’s ideas in the context of the dangers posed by the climate crisis, showing that his thought remains extremely relevant to the present historical situation.",
    abstract_source = "s2"
}

@article{burdman2020auschwitz,
    author = "Burdman, Javier",
    title = "'After Auschwitz': Writing History After Injustice in Adorno and Lyotard",
    journal = "Contemporary Political Theory",
    year = "2020",
    doi = "10.1057/s41296-020-00456-8",
    note = {CORE ARGUMENT: Compares how Adorno and Lyotard each reconceive the writing of history in the wake of Auschwitz and historical injustice, examining what it means to narrate or theorize history once a founding, unrepresentable wrong has occurred. RELEVANCE: Bears directly on the status of universal/continuous history "after Auschwitz," juxtaposing Adorno's negative-dialectical response with Lyotard's differend-based alternative, and clarifying what is distinctive in Adorno's continued (negative) retention of a universal-historical framework rather than its outright abandonment. POSITION: A comparative reading situating Adorno within a broader post-Holocaust reckoning with the writing of history, alongside Lyotard's postmodern critique of grand narratives.},
    keywords = "Auschwitz, universal-history, Lyotard, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages"
}

@article{stone2014adornohegel,
    author = "Stone, Alison",
    title = "Adorno, Hegel, and Dialectic",
    journal = "British Journal for the History of Philosophy",
    year = "2014",
    volume = "22",
    pages = "1118--1141",
    doi = "10.1080/09608788.2014.952264",
    note = {CORE ARGUMENT: Argues that Adorno's apparently mixed responses to Hegel form a coherent whole: Adorno follows Hegel's dialectical logic in tracing how enlightenment reverts to myth and domination over nature reverts into domination by nature, while criticizing Hegel's dialectic as the culmination of "identity thinking." For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences rather than being subsumed into a unified whole. RELEVANCE: Directly clarifies how Adorno reworks Hegelian totality and world-spirit-style reconciliation into something that resists a unified, subject-constituted whole, bearing on whether a "negative totality without a subject" is coherent within Adorno's own dialectical logic. POSITION: A systematic reconstruction of Adorno's relation to Hegel that defends Adorno's consistency against Habermas's charge of a performative contradiction in totalized critique.},
    keywords = "Hegel, dialectic, totality, High, METADATA\_CLEANED: number",
    abstract = "This article explores critical theory's relations to German idealism by clarifying how Adorno's thought relates to Hegel's. Adorno's apparently mixed responses to Hegel centre on the dialectic and actually form a coherent whole. In his Logic, Hegel outlines the dialectical process by which categories – fundamental forms of thought and reality – necessarily follow one another in three stages: abstraction, dialectic proper, and the speculative (famously simplified as ‘thesis, antithesis, synthesis’). Adorno's allegiance to Hegel's dialectic emerges when he traces the dialectical process whereby enlightenment reverts to myth and human domination over nature reverts into our domination by nature. However, Adorno criticizes Hegel's dialectic as the ultimate form of ‘identity thinking’, subsuming unique, material objects under universal concepts by using dialectical reason to expand those concepts to cover objects utterly. These two responses cohere because Adorno shares Hegel's view that dialectical contradictions require reconciliation, but differs from Hegel on the nature of reconciliation. For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences. Finally, against Habermas who holds that Adorno cannot consistently criticize the enlightenment practice of critique, I show that Adorno can do so consistently because of how he reshapes Hegelian dialectic.",
    abstract_source = "openalex"
}

@misc{baumann2011concreteuniversal,
    author = "Baumann, Charlotte",
    title = "Adorno, Hegel and the Concrete Universal",
    year = "2011",
    note = {CORE ARGUMENT: Argues that Adorno adopts Hegel's distinction between an abstract and a concrete universal, agreeing that the abstract universal is the form of false knowledge and society while the concrete universal names a positive aim, but rejects Hegel's own account of the concrete universal and formulates a different conception of it; the article then questions whether Adorno's alternative overcomes the problems he identifies in Hegel or remains bound to them. RELEVANCE: Addresses the universal/particular structure underlying Adorno's paradoxical retention of "universal history" — if Adorno rejects Hegel's affirmative concrete universal, this bears directly on what kind of "universal," if any, a negative universal history could still be. POSITION: A critical-immanent reading that leaves open whether Adorno's dialectics escapes the aporias it identifies in Hegel's treatment of the universal/particular relation.},
    keywords = "universal-particular, Hegel, dialectic, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The core argument of this article is that Adorno adopts the distinction between an abstract and a concrete universal from Hegel and criticizes Hegel, on that basis, as abstract. The first two parts of the article outline that both thinkers take the abstract universal to be the form of a false type of knowledge and society, and the concrete universal to be a positive aim. However, as the third part argues, Adorno rejects how the concrete universal is understood in Hegel’s philosophy and formulates a different conception of it. The fourth part questions if Adorno manages to overcome the problems he identifies in Hegel or whether they are inherent to the programme of dialectics both endorse.",
    abstract_source = "openalex"
}

@misc{oconnor2011reconception,
    author = "O'Connor, Brian",
    title = "Adorno's Reconception of the Dialectic",
    year = "2011",
    note = {CORE ARGUMENT: Reconstructs Adorno's reconception of dialectic against the background of Hegel's dialectic, covering Adorno's disagreement with Hegel and offering an overall assessment of the "Hegelianism" of Adorno's critical theory. RELEVANCE: Provides a systematic overview of how Adorno retools the Hegelian dialectical machinery — including the "negative dialectic" that operates without a guaranteeing subject or absolute spirit — central to assessing whether Adorno can sustain a negative totality without a historical subject. POSITION: An expository, broadly sympathetic account that reads Adorno's dialectic as an internal transformation of Hegel's method rather than its wholesale rejection.},
    keywords = "dialectic, Hegel, world-spirit, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "This chapter contains sections titled: Hegel and Negative Dialectic Adorno's Disagreement with Hegel The Hegelianism of Adorno's Critical Theory: An Assessment",
    abstract_source = "openalex"
}

@misc{hohendahl2013progressrevisited,
    author = "Hohendahl, Peter Uwe",
    title = "Progress Revisited: Adorno's Dialogue with Augustine, Kant, and Benjamin",
    year = "2013",
    note = {CORE ARGUMENT: Reconstructs Adorno's essay "Progress" as staging an implicit dialogue with Augustine, Kant, and Benjamin, situating Adorno's refusal of both linear-teleological and cyclical models of history within this longer theological and philosophical genealogy of thinking about historical progress. RELEVANCE: Directly addresses how Adorno reconstrues "progress" by tracing its conceptual ancestry (Augustinian providence, Kantian moral progress, Benjaminian messianic interruption), clarifying what is retained and what is negated in Adorno's non-affirmative concept of progress. POSITION: An intellectual-historical reading of the "Progress" essay that locates Adorno's position at the intersection of theological and Enlightenment philosophies of history.},
    keywords = "progress, Kant, Benjamin, theology-of-history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{cidam2020twotrack,
    author = "Çıdam, Volkan",
    title = "Adorno's Two-Track Conceptualization of Progress: The New Categorical Imperative and Politics of Remembrance",
    year = "2020",
    volume = "28",
    note = {CORE ARGUMENT: Identifies a "two-track" structure in Adorno's conceptualization of progress, linking it both to the "new categorical imperative" (Adorno's post-Auschwitz ethical injunction) and to a politics of remembrance, so that "progress" for Adorno operates simultaneously as ethical demand and as historical-memorial practice rather than as a single continuous historical claim. RELEVANCE: Speaks directly to how Adorno reconstrues progress so that it is neither simply affirmed nor denied, by showing that Adorno's progress-talk is functionally heterogeneous rather than a unified thesis about historical development. POSITION: A reconstructive reading that resists treating Adorno's remarks on progress as a single unified doctrine.},
    keywords = "progress, categorical-imperative, memory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{weisbrod2020lowith,
    author = "Weisbrod, Victor",
    title = "A Missed Connection: Löwith and Adorno on Progress",
    journal = "Thesis Eleven",
    year = "2020",
    abstract = "Despite appearing side by side as keynote speakers at a congress in 1962 devoted to the question of progress, Löwith's and Adorno's accounts of progress have never been linked. This paper is an attempt to establish this missed connection, to reveal important connections, striking similarities, and a fundamental difference between these two eminent thinkers' work on progress. For one, Löwith diagnoses the three main problems that Adorno attempts to solve with his dialectical account of progress. Moreover, each is sympathetic towards crucial aspects of the other's account: Löwith towards Adorno's claim that progress is dialectical, Adorno towards Löwith's claim that progress necessarily has a redemptive aspect. A fundamental disagreement nevertheless divides them: whether the problem of suffering in history is part of our ontological condition, or something we must struggle against and overcome through political action. By establishing this missed connection, I hope to show how progress might still have an important role to play in our present-day historical and political consciousness.",
    abstract_source = "s2",
    note = "CORE ARGUMENT: Establishes a previously unexamined connection between Karl Löwith's and Adorno's accounts of progress (both keynote speakers at a 1962 congress on progress), showing that Löwith diagnosed the three main problems Adorno's dialectical account of progress attempts to solve, that each thinker is sympathetic to an aspect of the other's view, while dividing over whether the problem of suffering in history is an ontological condition or a political one to be overcome. RELEVANCE: Situates Adorno's dialectical, non-affirmative concept of progress against Löwith's more skeptical, theologically-inflected philosophy of history (secularized eschatology), clarifying exactly what is distinctive — and what is shared — in Adorno's refusal of straightforward historical progress. POSITION: A comparative intellectual history reading Adorno's progress essay as partly convergent with, and partly opposed to, Löwith's critique of the secularized theology of progress.",
    keywords = "progress, Lowith, secularization, High, METADATA\_CLEANED: volume, number, pages, doi"
}

@article{bell2017liferuins,
    author = "Bell, Aaron",
    title = "Life in Ruins: Ecological Disaster and Adorno's Idea of Natural History",
    journal = "Telos",
    year = "2017",
    abstract = "—only human beings can recognize catastrophes, provided they survive them; Nature recognizes no catastrophes.—Max Frisch, Man in the Holocene1",
    abstract_source = "openalex",
