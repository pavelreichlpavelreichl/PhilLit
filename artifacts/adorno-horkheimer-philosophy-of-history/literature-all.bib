    keywords = "natural-history, ecology, catastrophe, Medium, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{sherman2016negativedialectics,
    author = "Sherman, David",
    title = "Adorno's Negative Dialectics",
    year = "2016",
    abstract = "Abstract The concept of negative dialectics constitutes the philosophical core of Adorno's wide‐ranging thought. It reflects his attempt both to consider the status of dialectics in the face of a history that has failed to actualize its prognostications and to rework dialectics to make it adequate to his own time. Among the themes considered are Adorno's critique of conceptuality in the German idealist tradition, his critique of enlightenment reason and its relationship to capitalist society, his qualified rejection of universal history, his concern with revitalizing experience, and his concept of the constellation, which he offers as an alternative to existing epistemological paradigms.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Surveys negative dialectics as the philosophical core of Adorno's thought, covering his critique of German-idealist conceptuality, his critique of enlightenment reason's relation to capitalist society, his "qualified rejection of universal history," his concern with revitalizing experience, and his concept of the constellation as an alternative epistemological paradigm. RELEVANCE: Explicitly names Adorno's "qualified rejection of universal history" as a central theme of negative dialectics, useful for situating this domain's core interpretive question within the wider architecture of Negative Dialectics as a whole. POSITION: A synthetic survey rather than an original argument, useful chiefly for orienting readers to the overall structure of Adorno's negative dialectics.},
    keywords = "negative-dialectics, universal-history, overview, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{whyman2016naturalhistory,
    author = "Whyman, Tom",
    title = "Understanding Adorno on 'Natural-History'",
    year = "2016",
    abstract = "'Natural-History' is one of the key concepts in the thought of the Frankfurt School critical theorist Theodor W. Adorno, appearing from his very earliest work through to his very last. Unfortunately, the existing literature provides little illumination as to what Adorno's concept of natural-history is, or what it is supposed to do. This paper thus seeks to supply the required understanding. Ultimately, I argue that 'natural-history' is best understood as a sort of 'therapeutic' concept, intended to dissolve certain philosophical anxieties which might otherwise present obstacles to our being able to obtain a critical-theoretical understanding of reality.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Argues that Adorno's concept of "natural-history" — present from his earliest to his latest work — is best understood as a "therapeutic" concept intended to dissolve philosophical anxieties (e.g., about the relation of nature and history, necessity and contingency) that would otherwise obstruct a critical-theoretical understanding of reality, rather than as a substantive metaphysical or historical thesis. RELEVANCE: Bears directly on this domain's meta-level question — whether Adorno offers a substantive philosophy of history or something closer to a diagnostic/therapeutic device — by proposing that "natural-history," and by extension Adorno's historical categories generally, function therapeutically rather than doctrinally. POSITION: A distinctive, deflationary reading of Adorno's natural-history concept that resists both purely metaphysical and purely sociological interpretations.},
    keywords = "natural-history, therapeutic-reading, metaphilosophy, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{johnson2019anthropocene,
    author = "Johnson, Harriet",
    title = "The Anthropocene as a Negative Universal History",
    year = "2019",
    volume = "3",
    howpublished = "\url{https://www.semanticscholar.org/paper/e878b6bb7afa8c8f53f65650daaf316c54b1dc9f}",
    note = {CORE ARGUMENT: Argues that the Anthropocene compels a rethinking of the tradition of universal history inherited from Enlightenment thinkers, who sought a continuous history of humankind tending toward upward development. Drawing on Adorno, the paper develops a "negative universal history" that "undercuts the totalizing ambitions of the tradition from which it springs," modeling ways of attending to planetary-scale forces precisely in their uneven, local manifestations. Published in Adorno Studies, vol. 3, issue 1. RELEVANCE: Directly reconstructs and extends Adorno's paradoxical retention of "universal history" after its Enlightenment optimism has been discredited, showing how a negative universal history can still track large-scale, even planetary, processes without positing a unified historical subject or telos. POSITION: An extension of Adorno's negative universal history into contemporary Anthropocene discourse, treating Adorno's category as an interpretive resource rather than merely a symptom of totalizing thought.},
    keywords = "universal-history, Anthropocene, totality, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages"
}

@misc{lunajimenez2020naturalezaehistoria,
    author = "Luna Jiménez, Andrés",
    title = "Apuntes sobre naturaleza e historia en la obra de Theodor W. Adorno: lo natural como problema para las filosofías de la historia",
    year = "2020",
    abstract = {This article makes a general review of the philosophical work of Theodor W. Adorno on the opposition between the concepts of history and nature over three stages of his production. Specifically, it will examine the way in which the theoretical project of a dialectical overcoming of this antithesis, sketched by Adorno in his early essay "The idea of natural history" (1932), is later reformulated in Dialectic of Enlightenment (1944-1947) and Negative Dialectics (1966). As a conclusion, it suggests that his statements regarding this opposition entail a considerable relevance for the current issue of the relationship between human societies and the natural world, and therefore, as a subject of reflection for a contemporary philosophy of history.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Traces the opposition between the concepts of history and nature across three stages of Adorno's work — from the early essay "The Idea of Natural History" (1932), through its reformulation in Dialectic of Enlightenment (1944–1947), to Negative Dialectics (1966) — arguing that Adorno's dialectical treatment of this antithesis remains relevant to contemporary debates on the human/nature relationship and thus to a contemporary philosophy of history. RELEVANCE: Provides a developmental overview of how the nature/history dialectic underlying Adorno's "natural history" concept evolves across his corpus, directly relevant to reconstructing the "World Spirit and Natural History" model of Negative Dialectics. POSITION: A developmental-exegetical reading tracing continuity in Adorno's nature-history dialectic from 1932 to 1966.},
    keywords = "natural-history, nature, negative-dialectics, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{allen2016endofprogress,
    author = "Allen, Amy",
    title = "The End of Progress: Decolonizing the Normative Foundations of Critical Theory",
    year = "2016",
    note = {CORE ARGUMENT: Argues that while post- and decolonial theorists have debunked the idea of historical progress as a Eurocentric, imperialist, and neocolonialist fallacy, prominent contemporary Frankfurt School thinkers (Habermas, Honneth, Forst) have persistently defended ideas of progress, development, and modernity as central to their normative claims. Allen argues for "fracturing" critical theory from within by dispensing with its progressive reading of history while retaining the notion of progress as a political imperative — a stance she credits to Adorno. RELEVANCE: A foundational contemporary intervention on this domain's meta-question — whether critical theory's philosophy of history can or should retain any notion of progress — explicitly crediting Adorno's non-teleological retention of progress "as a political imperative" as the resource for a decolonized critical theory. POSITION: A decolonial-genealogical critique of critical theory's normative foundations that positions Adorno, against Habermas, Honneth, and Forst, as the resource for salvaging progress without teleology.},
    keywords = "progress, decolonial-critique, critical-theory, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {Amy Allen identifies two main goals for her book. The first is to critique Habermas and two of his main successors -- Axel Honneth and Rainer Forst -- as "wedded to problematically Eurocentric and/or foundationalist strategies for grounding normativity," including implicitly "colonialist" notions of intellectual and social progress. The second is to "decolonize Frankfurt School critical theory" by offering alternative bases for normativity that take on board the concerns of "decolonial theory," critical race theory, and queer theory that have been sidelined by mainstream critical theorists (p. xii). Her argumentative strategy is to set up a trilemma (see pp. 13-15): abstract\_source = {ndpr}, a. the "long-standing" problem of relativism, of which postcolonial theory is accused;b. justifying rational autonomy or social freedom as outcomes of "a progressive process of social evolution or sociocultural learning," which turns out to depend on a problematic conception of progress already accomplished; andc. rationalist foundationalism (e.g. of neo-Kantian varieties) which ties political philosophy to ideal theory and makes social criticism into a form of "applied ethics." Allen's thesis is that in trying to avoid horns (a) and (c), Habermas and Honneth each fall into two variants of horn (b): they try to avoid the "twin evils of foundationalism and relativism" by reconstructing the norms emerging from the implicit trajectory of social history (pp. 13-14). While Allen agrees with grounding critical theory in the actual social world, she argues that their versions depend on a (morally and factually) suspect idea of progress. Forst, by contrast, holds that "progress" is a normative concept depending on universal standards rather than supporting them. But he thereby falls into horn (c) in Allen's view, while she hopes to avoid all three horns by returning to a more contextualist view inspired by Adorno and Foucault. Although I do not think she is entirely fair to them, I will not evaluate Allen's interpretations of Habermas and Honneth in detail. Instead, given space limits, I will concentrate on her critique of their reliance on "backward-looking" or accomplished progress, e.g. as Honneth thinks is evinced by growing acceptance of gay marriage, and on Allen's alternative proposal. Overall, I will argue that Critical Theory can reject excessively ideological and exaggerated charges of "colonialism," though I will express cautious sympathy with some of Allen's doubts about dependence on any strongly structured or stage-wise conception of human history. Allen's main argument is that, despite rejecting rationalist ideas of necessary or teleologically determined historical progress (in Kant, Hegel, and Marx), much recent work in Critical Theory depends on an idea of historical progress "that has led up to 'us,'" or to our institutions, practices, and conception of reason. This idea of progress as an accomplished "fact" is more dangerous in her view than forward-looking or prospective progress "as a normative goal that we are striving to achieve," e.g. a "good" or "more just" society (p. 12). Her hope is to show that critical theory need not depend on backward-looking progress (pp. 32-33). However, if we can define a moral ideal without appeal to accomplished progress, we could then measure past progress with respect to that ideal. So Allen's real concern seems not to be with backward-looking progressper se, but rather with appeal to such progress tojustifymoral norms or ethical ideals. In any case, the Allen explains two kinds of objections to past or accomplished progress. One is epistemological: "On what basis do we claim to know what counts as progress?" (p. 19). The second objection concerns the "entwinement of the idea of historical progress with the legacies of racism, colonialism, and imperialist and their contemporary neocolonial or informally imperialist forms" (p. 16). This refers to the familiar worry that seeing western cultures as more socially (as well as technologically) "advanced" provided a key ideological justification for "the colonial and imperial projects" (p. 17). There are some historical problems with this argument; for example, slavery existed in Moorish parts of Spain and in North Africa before the conquistadors set out. Still, there is no doubt that cultural superiority was later invoked as a justification for empire as late as the establishment of colonial mandates under the League of Nations in the early 20th century. But the fundamental problem with this critique of accomplished progress as inherently colonialist is that a historical thesis A may be used to justify a policy B that it does not entail. 19th century conservatives sometimes pressed Darwinian biology into service to justify extreme forms of meritocratic competition on the view that "weaker" individuals should die off. That social Darwinists perverted Darwin's findings in this way, or that Nazi doctors used them as specious rationalizations for eugenic programs, should hardly lead us to reject evolutionary biology because it is "deeply entwined" with the legacy of racial or class "supremacism." Allen is aware of this worry: she notes that, even if backward-looking progress has used for corrupt ideological purposes in the past, it might not be "merely ideological" (p. 25). To illustrate this possibility, she briefly considers Thomas McCarthy's recent classic,Race, Empire, and the Idea of Human Development. She concedes that McCarthy goes beyond Habermas's admission that judgments of progress are situated and fallible, further emphasizes the need to remember the wrongs done "in the name of human development," and understands the norms embedded in our tradition(s) in a "more modest and contextualist way than . . . Habermas tends to" (pp. 27). Yet McCarthy agrees with Habermas that modern law, markets, and discourse have become unavoidable for practically everyone, and that we cannot avoid regarding the linguistic / historicist turn -- together with the reflexivity of "modern forms of discourse" -- as progressive, relative to which unreflective ways of life count as less advanced.}
}

@misc{allenw2025kantadornoforms,
    author = "Allen, William S.",
    title = "Kant, Adorno, and the Forms of History",
    year = "2025",
    abstract = "Kant, Adorno, and the Forms of History sets the works of Theodor Adorno, Immanuel Kant and Peter Weiss in dialogue, revealing how an interrogation of the aesthetics of 'the whole' and the conception of history in Western thought reveals new ways of thinking about history and historically. To conceive of history as such it is necessary to conceive it as a whole, but doing so carries implications about its development and direction. Furthermore, such an idea makes it difficult to consider its parts without subsuming them to the whole, thereby making individuals merely instrumental to achieving the aims of history. William S. Allen brings the thought of Kant, Adorno and Weiss to bear on these tensions, tracing how Adorno's reconsideration of history through his readings of Kant's Critique of Judgement are distinct from formulations offered by other thinkers (Marx, Hegel, Lyotard). Allen establishes that Kant's Critique of Judgement is not only a sustained analysis of the development of forms, whether aesthetic or organic, but also a tacit interrogation of the form of the whole and the possibilities of thinking it. Kant, Adorno, and the Forms of History argues that Adorno has taken up this interrogation more than any other thinker and through his aesthetics has introduced an alternative thought, which has been modified and extended in the work of Peter Weiss in his last novel, The Aesthetics of Resistance. Within this thought lies the possibility of thinking history without the whole, without unity or purpose, which is a possibility that may offer new insights in the face of imminent environmental, economic and political collapse.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: Sets Kant, Adorno, and Peter Weiss in dialogue to interrogate the aesthetics of "the whole" in conceptions of history: to conceive of history as such requires conceiving it as a whole, but this makes it difficult to consider its parts without subsuming individuals to that whole, rendering them merely instrumental to history's ends. The book argues that Adorno's reworking of Kant's Critique of Judgment — more than any other thinker's treatment — opens the possibility of thinking history without "the whole," without unity or purpose. RELEVANCE: Bears directly on this domain's central puzzle of whether a negative totality ("the whole is the false") can be sustained without a constituting historical subject, arguing that Adorno's Kant-inflected aesthetics offers precisely a way of thinking history without positing such a totalizing whole. POSITION: An aesthetics-driven reading that locates in Adorno, via Kant's Critique of Judgment, an alternative to both Hegelian and Marxist totalizing philosophies of history.},
    keywords = "totality, Kant, whole-is-false, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{feenberg2014praxis,
    author = "Feenberg, Andrew",
    title = "The Philosophy of Praxis: Marx, Lukács, and the Frankfurt School",
    year = "2014",
    address = "Brooklyn",
    note = {CORE ARGUMENT: Feenberg reconstructs a single "philosophy of praxis" tradition running from Marx through Lukács's theory of reification to the Frankfurt School, arguing that the early Frankfurt School's engagement with nature, rationality, and the "realization of philosophy" is best understood as an internal transformation of Lukács's problematic of subject-object identity rather than a rupture with it, tracking how the controversy over subject-object identity is resolved differently by each thinker in the lineage. RELEVANCE: Provides the fullest single-volume account of the Marx-Lukács-Frankfurt School lineage relevant to this domain's central genealogical question, explicitly tracing the "last philosophy of praxis" (i.e., what remains once Lukács's identical subject-object is abandoned). POSITION: Continuity reading — critical theory as an internal development, not abandonment, of the philosophy of praxis inaugurated by Marx and radicalized by Lukács.},
    keywords = "lukacs, philosophy-of-praxis, reification, western-marxism, High, METADATA\\\_CLEANED: publisher, type:@book->@misc",
    abstract = {This is a thoroughly revised version of Andrew Feenberg's first book,Lukács, Marx and the Sources of Critical Theory(1981).[1]In the Preface to the new version Feenberg writes that he often has looked back to the original version, based on his doctoral dissertation supervised by Herbert Marcuse, "with a mixture of pride and dismay" (viii). On the one hand, Feenberg is proud of the fact that the original volume has helped people understand the complicated arguments of Lukács'History and Class Consciousness. On the other hand, he has long recognized that there were problems with the original version, and in this new one he aims to solve these problems. As someone who has profited from the original volume in the way that justly gives Feenberg pride, I am happy to report that the new version is a very worthy successor and will be indispensable for a new generation of students and scholars as they try to make sense of the intellectual background of Frankfurt School critical theory. The book can be divided into three parts. Feenberg devotes three chapters each to Marx's early writings and to Lukács'History and Class Consciousness(including some discussion of his recently published defense of this controversial book), and two chapters on how members of the Frankfurt School, in particular Adorno and Marcuse, have taken up and transformed their legacies. There also is a substantial conclusion and an Appendix, which condenses two chapters from the earlier version. Feenberg has thoroughly revised the book throughout. For example, there is a new discussion of the influence of the neo-Kantians on Lukács (e.g., 73-78), a more extended discussion of the Kantian and Hegelian background, and a new focus on the critique of science and technology, which became an important theme in Feenberg's work following the publication of his first book. Finally, the two chapters on the Frankfurt School are all new. I won't be able to do justice to all of this material, so will focus on what I consider to be the book's major strengths. Students of Frankfurt School critical theory often are confronted with an approach to philosophy that is very alien to the mainstream but can be rendered intelligible, if its Marxist and Lukácsian background is brought to the fore. For example, consider the cryptic opening sentence of Adorno'sNegative Dialectics: "Philosophy, which once seemed obsolete, lives on, because the moment of its realization was missed."[2]It is with understanding sentences like these that Feenberg's book really helps. Both the obsolescence of philosophy and its possible realization are problems that arise in Marx's early writings and in Lukács'History and Class Consciousness, in the context of a philosophy of praxis that aims to overcome the antinomies identified by modern philosophy through collective social action and to realize the level of rationality that has been attained through theoretical reflection in social practices and institutions. For Marx and for Lukács (who didn't know Marx's early writings when he wroteHistory and Class Consciousnessin 1923 but developed very similar arguments), the German idealist tradition had reached an impasse in Hegel, who thought that the antinomies of modern philosophy had to be resolved by speculative thought. In contrast, Marx and Lukács believed that these antinomies ultimately could not be resolved either critically, as Kant thought, or speculatively, as Hegel thought, but only metacritically. Such a metacritique of philosophy would amount to a "sociological desublimationof the concepts of philosophy" (12). It would demonstrate that seemingly philosophical problems are rooted in social reality, and that only social change will resolve the antinomies. Feenberg's discussion of Lukács' metacritique of philosophy in Chapter Five is particularly insightful. As he explains, For Lukács, traditional philosophy is in essence philosophy of culture that does not know itself as such. Philosophy reflects on cultural structures -- forms of objectivity -- that it misinterprets as eternal principles disconnected from the accidents of history and social life. (91) Lukács' discussion applies this insight to a practical and a theoretical antinomy. Considered from a practical perspective, the antinomial conflict between freedom and determinism characterizes the social experience of modern subjects in their everyday lives. Forty years later Adorno would make the same point in his lectures on Kant and inNegative Dialectics.[3]Subjects face a practical antinomy, because their inner sense of agency and freedom is incompatible with the social determinism that they experience as a natural law in modern capitalist society. According to Lukács, Kant's moral philosophy reflects this antinomy, but its proposed resolution, the distinction between the phenomenal and noumenal realms, reifies moral freedom and cannot explain how the free subject can act in a world that is governed by the seemingly natural laws of economics. Considered from a theoretical perspective, the antinomial conflict is generated by two incompatible philosophical commitments that concern the nature of our knowledge of reality. On the one hand, the subject stands in a contemplative, passive relationship to the world when it seeks to control it. The world is governed by natural laws that exist independently of the empirical subject, and the subject must comprehend these laws in order to dominate nature. Thus, "the reified is the rational" (97). On the other hand, the subject stands in an active relationship to its world. As a transcendental subject it creates the world by imposing the form of reason onto it, and the intelligibility of the world to the subject is explained by this imposition. Lukács traces the philosophical attempts to reconcile these commitments from Kant to Hegel, but, ultimately, he argues that such a reconciliation requires a change of perspective that overcomes the dualism of humanity and nature, history and ontology. Both the early Marx and Lukács attempt such a reconciliation, and Feenberg devotes Chapters Three and Six to these attempts. These are important parts of the book, because Feenberg grapples with problems in Marx's and Lukács' thought that long have perplexed commentators. The question is whether either operates with a concept of subject-object identity, which denies the ontological independence of nature. Thus Marx seems to argue that humans produce nature through their labour, and that, therefore, "under the appropriate social conditions it will be possible to recognize the essence of nature as human activity" (44). As Feenberg points out, this argument is implausible, because nature is not just raw material for human labour, and labour is not the only way in which humans engage with nature. In any case, Marx abandoned this whole line of thought in his writings immediately following theManuscripts. Lukács often has been criticized for a similar approach to nature, and Feenberg offers a detailed analysis ofHistory and Class Consciousnessthat aims to show the mistakes in these criticisms. In particular, he disposes of the "absurd" thesis that nature "is a purely social category, and the natural world therefore has no independence of humanity and human understanding" (129), by showing that Lukács actually talks about our knowledge of nature, rather than about nature itself. Moreover, Feenberg tries to show that Lukács is not committed to the implausible view that there is a specifically capitalist science that is reified and would be replaced by a communist science after the revolution. As I understand Feenberg's argument, science and technology always progress through a dialectic of reification and de-reification. To be sure, under capitalism the reifying aspects of science and technology, which undermine our lived experience of nature, are foregrounded due to capitalism's "formal bias" (145; cf. 166) in favour of an abstract and disembodied approach to nature that focuses on its domination and exploitation. But it is a mistake to believe that a "communist science" would not be reifying. The reification of nature in science differs from the reification of society. This is an original way of solving a problem that has been discussed in the literature on Lukács and the Frankfurt School.[4]However, it also raises new questions, to which Feenberg could have devoted more space. For example, one may ask how exactly reification comes about and what its relationship is to market exchange in capitalist societies, given that reification and de-reification now seem to be necessary moments of social practice. I think that the concept of formal bias could potentially be extremely fruitful in answering these questions, but it remains underdeveloped in this book. In Chapters Seven and Eight Feenberg turns to the Frankfurt School, which inherits the legacy of the philosophy of praxis from Marx and Lukács but differs from them on two very important points. First, Adorno and Marcuse place central importance on the domination of nature as a source of social pathologies that affect modern subjects. Second, they formulate their critical theories of society at a time when the "unity of theory and practice" has broken down, that is, when it has become clear that the proletariat in Western Europe is not on the verge of staging a revolution to overthrow capitalism. Of course, Adorno's and Marcuse's theories are very different. Feenberg characterizes this difference in terms of the concepts that they inherit from Marx and Lukács. Whereas Adorno takes the theory of commodity fetishism as his starting point, Marcuse's emphasizes the experience of alienation (158, 175). Feenberg's discussion of Adorno suggests that he considers him an outlier in the philosophy of praxis. His negativistic philosophy eschews the appeal to concepts such as emancipation, progress or revolution. Instead, Adorno uses the concept of reification in order to explain why no such appeal is possible. His criticism of identity thinking demonstrates the reification of reason in capitalist society, but it abstains from formulating a positive alternative. As Feenberg puts it, negative dialectics "does not resolve the antinomies but rather identifies them as such and suspends all premature resolutions. It is the logic of immanent critique and not a constructive alternative" (155).}
}

@misc{aratobreines1979younglukacs,
    author = "Arato, Andrew and Breines, Paul",
    title = "The Young Lukács and the Origins of Western Marxism",
    year = "1979",
    address = "London",
    note = {CORE ARGUMENT: Arato and Breines reconstruct the trajectory of Lukács's early thought from Neo-Kantian and Romantic anti-capitalism through History and Class Consciousness, arguing that Lukács's Hegelian-Marxist synthesis — the proletariat as the "identical subject-object of history" achieving revolutionary self-consciousness — establishes the foundational problematic that subsequent Western Marxism, including the Frankfurt School, both inherits and is forced to renegotiate once that revolutionary subject fails to materialize historically. RELEVANCE: Supplies the canonical account of how Hegelian dialectics entered twentieth-century Marxism through Lukács, directly framing why Horkheimer and Adorno could not simply adopt Lukács's proletariat-as-subject thesis and had to develop an alternative, non-teleological relation to history. POSITION: Foundational intellectual history of Western Marxism's Hegelian-Marxist origin point in the young Lukács.},
    keywords = "lukacs, western-marxism, proletariat, hegel, High, INCOMPLETE, no-abstract, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@misc{lowy1979lukacsromanticism,
    author = "Löwy, Michael",
    title = "Georg Lukács—From Romanticism to Bolshevism",
    year = "1979",
    address = "London",
    note = {CORE ARGUMENT: Löwy traces Lukács's intellectual formation from a "Romantic anti-capitalist" critique of reified modern life, through his encounter with Hegelian dialectics, to his Bolshevik-inflected reformulation of Marxism in History and Class Consciousness, situating the reification analysis and the proletariat's revolutionary vocation within this Romantic-to-Marxist trajectory. RELEVANCE: Offers biographical-intellectual context for how the "identical subject-object" thesis emerged from a fusion of Romantic cultural critique and Hegelian Marxism — the same cultural-critical impulse (critique of reified modernity) that the Frankfurt School continues but detaches from Lukács's revolutionary optimism about the proletariat. POSITION: Genetic/biographical account of Lukács's Hegelian Marxism as arising from Romantic anti-capitalism, cited directly in SEP's account of Lukács's path to History and Class Consciousness. sep\\\_context: SEP "Georg [György] Lukács" (Life and Career) cites Löwy 1979 on the party's condemnation of Lukács's Bolshevik revisions to the History and Class Consciousness essays as expressions of ultra-leftism.},
    keywords = "lukacs, romanticism, western-marxism, Medium, INCOMPLETE, no-abstract, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@misc{marcuse1941reason,
    author = "Marcuse, Herbert",
    title = "Reason and Revolution: Hegel and the Rise of Social Theory",
    year = "1941",
    address = "Oxford",
    note = {CORE ARGUMENT: Marcuse argues against the (then-common) view of Hegel as an authoritarian precursor of fascism, presenting Hegel's dialectic instead as an essentially critical and negative "power of negative thinking" — a mode of reason that denounces the given as merely apparent and points beyond it toward "new modes of existence" — which Marx's social theory inherits and radicalizes rather than simply rejects. RELEVANCE: Establishes the founding Frankfurt-School interpretive template — Hegel's dialectic as critical negativity, transmitted to Marx, and available for critical theory's own use — against which Adorno's more skeptical treatment of Hegel's positivity and reconciliation (in Negative Dialectics) is a documented departure. POSITION: Founding Frankfurt-School reading of Hegel as proto-critical-theorist; the baseline "positive" appropriation of Hegelian dialectic that later negative-dialectical readings (Adorno) revise.},
    keywords = "hegel, dialectic, negativity, critical-theory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{postone1993time,
    author = "Postone, Moishe",
    title = "Time, Labor, and Social Domination: A Reinterpretation of Marx's Critical Theory",
    year = "1993",
    note = {CORE ARGUMENT: Postone reinterprets Marx's mature critique of political economy as a theory of the historically specific, abstract, and quasi-automatic domination exercised by the value-form and abstract labor-time over social life under capitalism, arguing that traditional Marxism mistakenly identifies capitalism's contradiction with the standpoint of labor/the proletariat rather than seeing "labor" itself as a historically specific category to be overcome. RELEVANCE: Directly bears on the domain's key question of what happens to "class struggle as motor of history" and the proletariat as revolutionary subject once critical theory abandons productivist, labor-standpoint readings of Marx — Postone's reconstruction supplies the theoretical resources for understanding capital's abstract, subjectless domination in terms compatible with Adorno's and Horkheimer's skepticism about a guaranteed revolutionary subject. POSITION: Revisionist "value-form"/abstract-domination reading of Marx's critical theory of capitalism, opposed to traditional/orthodox and labor-standpoint Marxism.},
    keywords = "marx, historical-materialism, value-theory, proletariat, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Moishe Postone undertakes a fundamental reinterpretation of Karl Marx's mature critical theory. He calls into question many of the presuppositions of traditional Marxist analyses and offers new interpretations of Marx's central arguments. He does so by developing concepts aimed at grasping the essential character and historical development of modern society, and also at overcoming the familiar dichotomies of structure and action, meaning and material life. These concepts lead him to an original analysis of the nature and problems of capitalism and provide the basis for a critique of 'actually existing socialism'. According to this new interpretation, Marx identifies the core of the capitalist system with an impersonal form of social domination generated by labor and the industrial production process are characterized as expressions of domination generated by labor itself and not simply with market mechanisms and private property. Proletarian labor and the industrial production process are characterized as expressions of domination rather than as means of human emancipation. This reinterpretation entails the form of economic growth and the structure of social labor in modern society to the alienation and domination at the heart of capitalism. This reformulation, Postone argues, provides the foundation for a critical social theory that is more adequate to late twentieth-century capitalism.",
    abstract_source = "openalex"
}

@misc{rose2009hegelcontra,
    author = "Rose, Gillian",
    title = "Hegel Contra Sociology",
    year = "2009",
    address = "London",
    note = {CORE ARGUMENT: Rose argues that Weberian and neo-Kantian sociology (including strands of Western Marxism and critical theory influenced by it) systematically misreads Hegel by assimilating his dialectic to a dualism of fact and value or subject and object, thereby losing Hegel's own "speculative" insight that social forms (like the commodity-form) can be understood only via a logic that thinks identity and non-identity together — a logic she takes seriously engaged critical theory to have both drawn on and, in places, betrayed. RELEVANCE: Provides a rigorous philosophical case, independent of institutional Frankfurt School history, for what is at stake in whether critical theory's negative dialectic is a genuine radicalization of Hegelian speculative logic or a neo-Kantian retreat from it — bearing directly on the domain's question of how Hegel's dialectic is transformed (determinate negation without reconciliation). POSITION: Defends a "speculative" reading of Hegel against both orthodox sociology and (implicitly) versions of critical theory that dualize fact/value; a touchstone reference in Lukács scholarship for assessing Marxist appropriations of Hegel.},
    keywords = "hegel, dialectic, totality, neo-kantianism, High, INCOMPLETE, no-abstract, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@misc{schmidt1971concept,
    author = "Schmidt, Alfred",
    title = "The Concept of Nature in Marx",
    year = "1971",
    address = "London",
    note = {CORE ARGUMENT: Schmidt, a student of Horkheimer and Adorno, argues that Marx's historical materialism rests on a dialectical concept of nature — nature as always already worked-on and historically mediated through human labor, yet never simply reducible to a social construct — that avoids both mechanistic (Engelsian/Soviet Diamat) naturalism and idealist dissolutions of nature into consciousness. RELEVANCE: Central to the domain's question of what Adorno and Horkheimer retain of Marxian materialism: Schmidt's reconstruction of the labor-mediated, historical concept of nature underlies the Frankfurt School's own non-reductive materialism and its critique of the domination of nature, while also exposing the productivist assumptions in orthodox readings of the "metabolism" between humanity and nature. RELEVANCE: Written from within the Frankfurt School itself, this remains the primary scholarly bridge between Marx's texts on nature/labor and the critical theorists' broader diagnosis of instrumental reason's domination of nature. POSITION: Frankfurt-School internal reconstruction of Marx's materialism as a dialectical (non-mechanistic, non-idealist) theory of nature and labor.},
    keywords = "marx, nature, historical-materialism, labor, High, INCOMPLETE, no-abstract, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@misc{jay1973dialectical,
    author = "Jay, Martin",
    title = "The Dialectical Imagination: A History of the Frankfurt School and the Institute of Social Research, 1923-1950",
    year = "1973",
    address = "Boston",
    note = {CORE ARGUMENT: Jay's institutional-intellectual history reconstructs how the Institute for Social Research, under Horkheimer's direction, developed a program of "interdisciplinary materialism" combining philosophy with empirical social research — deliberately distinct from both Soviet orthodox Marxism-Leninism's economism and Second International determinism — while remaining indebted to Lukács's and Korsch's Hegelian-Marxist revisions of historical materialism in the 1920s. RELEVANCE: The standard reference for the domain's key question of how the early Frankfurt program of "interdisciplinary materialism" relates to orthodox and Western Marxist philosophies of history, documenting the Institute's self-conscious departure from economistic base/superstructure models. POSITION: Institutional-historical account situating the Frankfurt School's materialism between orthodox Marxism-Leninism and Western Marxism (Lukács, Korsch).},
    keywords = "frankfurt-school, interdisciplinary-materialism, institutional-history, western-marxism, High, METADATA\\\_CLEANED: publisher, type:@book->@misc",
    abstract = "Originally published: Boston : Little, Brown, 1973.Electronic access restricted; authentication may be required",
    abstract_source = "core"
}

@misc{jay1984marxism,
    author = "Jay, Martin",
    title = "Marxism and Totality: The Adventures of a Concept from Lukács to Habermas",
    year = "1984",
    address = "Cambridge",
    note = {CORE ARGUMENT: Jay traces the concept of "totality" as it migrates through twentieth-century Western Marxism — from Lukács's Hegelian identification of totality with the standpoint of the (potential) proletarian subject-object of history, through Korsch, the early Frankfurt School, and Sartre, to Habermas's eventual abandonment of strong totality claims in favor of a differentiated, communicative rationality. RELEVANCE: Directly addresses the domain's question of whether critical theory's break with Marxist teleology entails abandoning the philosophy of history or reconstituting it negatively, by showing how each generation renegotiates (without simply discarding) the totalizing ambition inherited from Hegel via Lukács — including Adorno's paradoxical formula that "the whole is the untrue." POSITION: Genealogical history of the totality concept as the thread connecting Hegelian Marxism, Lukács, the Frankfurt School, and Habermas; treats Adorno's negative totality as one moment in this "adventure" rather than a simple rejection of the concept.},
    keywords = "totality, lukacs, western-marxism, habermas, High, INCOMPLETE, no-abstract, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@misc{wiggershaus1994frankfurt,
    author = "Wiggershaus, Rolf",
    title = "The Frankfurt School: Its History, Theories, and Political Significance",
    year = "1994",
    address = "Cambridge, MA",
    note = "CORE ARGUMENT: Wiggershaus provides the most comprehensive institutional and intellectual history of the Institute for Social Research, documenting in detail its founding remit as a Marxist research institute, its evolving relation to orthodox Marxism-Leninism under Grünberg and then Horkheimer, and the gradual attenuation of programmatic commitment to revolutionary proletarian politics across the 1930s and 1940s. RELEVANCE: Supplies detailed archival grounding for tracing exactly when and how the early Institute's Marxist self-understanding (including expectations about the proletariat as revolutionary agent) gave way to the more skeptical historical diagnosis found in Dialectic of Enlightenment. POSITION: Comprehensive institutional history, generally regarded as the standard reference history of the Frankfurt School alongside Jay (1973).",
    keywords = "frankfurt-school, institutional-history, marxism, Medium, INCOMPLETE, no-abstract, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@article{finlayson2014hegel,
    author = "Finlayson, James Gordon",
    title = "Hegel, Adorno and the Origins of Immanent Criticism",
    journal = "British Journal for the History of Philosophy",
    year = "2014",
    volume = "22",
    note = {CORE ARGUMENT: Finlayson interrogates what he calls the "Continuity Thesis" — the widespread assumption that Hegel invented immanent criticism, Marx developed it, and Frankfurt School thinkers (especially Adorno) merely refined the same method — arguing that Adorno's practice of immanent criticism, while genuinely indebted to Hegel's dialectical method, diverges from it in ways that the Continuity Thesis obscures. RELEVANCE: Provides the sharpest statement of the historiographical claim this domain must adjudicate: whether Adorno's (and by extension Horkheimer's) critical method is a straightforward inheritance of the Hegel-to-Marx line of immanent critique or involves a substantive methodological break, bearing directly on how "determinate negation without reconciliation" should be understood. POSITION: Critically qualifies the standard "Continuity Thesis" narrative of Hegel-Marx-Frankfurt School immanent criticism as an oversimplification.},
    keywords = "hegel, adorno, immanent-critique, marx, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "‘Immanent criticism' has been discussed by philosophers of quite different persuasions, working in separate areas and in different traditions of philosophy. Almost all of them agree on roughly the same story about its origins: It is that Hegel invented immanent criticism, that Marx later developed it, and that the various members of the Frankfurt School, particularly Adorno, refined it in various ways, and that they are all paradigmatic practitioners of immanent criticism. I call this the Continuity Thesis. There are four different claims that interest me. (i) Hegel is the originator of immanent criticism. (ii) Hegel's dialectical method is that of immanent criticism. (iii) Adorno practises immanent criticism and endorses the term as a description of his practice. (iv) Adorno's dialectical method is fundamentally Hegelian. In this article, I offer an account of immanent criticism, on the basis of which, I evaluate these four claims and argue that the Continuity Thesis should be rejected.",
    abstract_source = "s2"
}

@misc{finlayson2017hegel,
    author = "Finlayson, James Gordon",
    editor = "Moyar, Dean",
    title = "Hegel and the Frankfurt School",
    year = "2017",
    note = "CORE ARGUMENT: Finlayson surveys the reception of Hegel across the Frankfurt School generations, tracking how Marcuse's, Adorno's, and Habermas's respective uses of Hegelian dialectics (immanent critique, determinate negation, the critique of abstract identity) diverge as the School's relation to Marxist politics and to Hegel's systematic ambitions changes. RELEVANCE: Offers a synthetic overview of the whole Hegel-to-Frankfurt-School reception history that this domain needs to track across generations, complementing the more narrowly focused Stone (2014) and Finlayson (2014) treatments of Adorno specifically. POSITION: Synoptic reference account of Hegel's reception across Frankfurt School generations, from Marcuse's positive appropriation to Adorno's more conflicted engagement.",
    keywords = "hegel, frankfurt-school, dialectic, reception-history, Medium, METADATA\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc",
    abstract = "Hegel’s philosophy exerted a magnetic attraction on the various thinkers that comprise the Frankfurt school. This chapter aims to gauge and specify the relation that three members of the ‘inner circle’ of the Frankfurt school (Horkheimer, Adorno, and Marcuse) have to Hegel. It concludes that the young Horkheimer is a Hegelian-Marxist who endorses a qualified Hegelianism, while claiming that Hegel’s idealist metaphysics had become obsolete and superseded by a combination of sociology, psychology, and materialist historiography. Adorno remains a more committed Hegelian (and a Marxist-Hegelian) who sees his own dialectical approach to philosophy as emerging from and consistent with an immanent criticism of Hegel. Both, however, tend to reject Hegel’s philosophy of objective spirit as conservative apology for the Prussian state. Marcuse, by contrast, is a Hegelian-Marxist who has a more scholarly, nuanced, and charitable approach to Hegel, placing more emphasis on the critical moment in Hegel’s conception of reason.",
    abstract_source = "s2"
}

@article{gindner2023totality,
    author = "Gindner, Jette",
    title = "Totality Reconsidered: Lukács's History and Class Consciousness a Century On",
    journal = "New German Critique",
    year = "2023",
    note = {CORE ARGUMENT: Gindner argues that the concept doing the essential theoretical work in Lukács's History and Class Consciousness is not "class" or "reification" but "totality," and that totality should be understood in a strictly negative sense — as a feature of capitalist coercion to be overcome — which can be "actualized" for the present without requiring an identifiable proletarian subject to carry it out, given the difficulty of locating that subject in a deindustrializing world. RELEVANCE: Offers a contemporary scholarly test case for the domain's central question about the fate of totality and the revolutionary subject: it shows a viable strategy (also implicit in Adorno) for retaining totality as a negative-diagnostic category while abandoning Lukács's positive identification of totality with proletarian class consciousness. POSITION: Revisionist Lukács scholarship that detaches negative totality from any determinate revolutionary subject, converging with (without directly discussing) Adorno's dictum that "the whole is the untrue."},
    keywords = "lukacs, totality, proletariat, western-marxism, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "Georg Lukács’s essay collection History and Class Consciousness (1923) remains a foundational text of Western Marxism and a vital influence on contemporary German studies, not least by way of the Frankfurt School. Yet Lukács’s positing of the proletariat as the historical agent of revolutionary change raises difficult questions for radical Left theory and praxis in our rapidly deindustrializing world. Who or what is that working class that would redeem Lukács’s vision today? This article argues that the main concept for actualizing History and Class Consciousness is totality rather than class or reification. However, we should understand totality in a strictly negative sense, as a feature of capitalist coercion to be overcome in a free society.",
    abstract_source = "s2"
}

@misc{bueno2024end,
    author = "Bueno, Arthur",
    title = "The end (and persistence) of subjectivity: Lukács with Adorno, Adorno with Lukács",
    year = "2024",
    doi = "10.1080/1600910x.2024.2381469",
    note = {CORE ARGUMENT: Bueno argues that Lukács's conception of the proletariat as the "identical subject-object of history" and Adorno's diagnosis of "the end of psychology" in the authoritarian, administered masses arrive, by opposite paths, at a shared elimination of the subject-object distinction that threatens to close off emancipatory politics — but contends that both arguments can be reconstructed, via the non-identical/material limits of reification, to preserve emancipatory subjectivity rather than negate it. RELEVANCE: Directly comparative Lukács-Adorno treatment of exactly the domain's central figure — the fate of the revolutionary subject — showing both convergence (shared diagnosis of reification's totalizing tendency) and divergence (Lukács's positive dialectical resolution via class consciousness versus Adorno's more skeptical stance) between the two thinkers. POSITION: Reconstructive reading that finds emancipatory resources common to both Lukács's and Adorno's theories of reification, against readings that treat their outcomes as simply and equally aporetic.},
    keywords = "lukacs, adorno, reification, subjectivity, proletariat, High, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc",
    abstract = "ABSTRACT This paper revisits Lukács’s and Adorno’s analyses of reification to articulate a diagnosis that accounts both for its tendencies towards authoritarianism and its emancipatory potentials. Despite their divergences, Lukács’s conception of the proletariat as ‘identical subject-object of history’ and Adorno’s diagnosis of ‘the end of psychology’ in the authoritarian masses seem to converge on a similar outcome. Through opposite paths, they both culminate in the elimination of the subject-object distinction, leading the critique of reification to a political impasse. However, this alternative is rooted in partial interpretations of Lukács’s and Adorno’s arguments. As I contend, one can reconstruct Lukács’s analysis in a way that portrays emancipatory subjectivity not as hostile to otherness but as driven by the material limits of reification, or what Adorno termed the non-identical. Correspondingly, in light of Lukács, Adorno’s diagnosis can be read in a way that the end of psychology, far from negating the possibility of emancipation, serves as its driving force.",
    abstract_source = "s2"
}

@misc{lichtenstein2022adorno,
    author = "Lichtenstein, Eli B.",
    title = "Adorno, Marx, and abstract domination",
    year = "2022",
    volume = "49",
    note = "CORE ARGUMENT: Against Axel Honneth's charge that Adorno's social theory reduces domination to a model of direct, personal domination, Lichtenstein reconstructs Adorno's account of domination as structural and de-individualized (abstract domination), then argues that Marx's theory of value — locating the constitution of value in the social totality rather than in production or exchange alone — supplies the explanatory account of the source of this abstraction that remains undeveloped in Adorno's own texts. RELEVANCE: Demonstrates concretely how Adorno's social theory can be read as continuous with, and explanatorily dependent on, Marx's mature categories (value, abstraction), bearing on the domain's question of what Adorno retains of Marxian political economy beneath his explicit distance from orthodox base/superstructure Marxism. POSITION: Defends Adorno's theory of domination against the charge of theoretical underdevelopment by supplementing it with Marxian value theory, situating Adorno as more continuous with Marx's mature critique of political economy than critics like Honneth allow.",
    keywords = "adorno, marx, value-theory, domination, High, METADATA\\\_CLEANED: journal, type:@article->@misc, METADATA\_CLEANED: number, pages, doi",
    abstract = "This article reconstructs and defends Theodor Adorno’s social theory by motivating the central role of abstract domination within it. Whereas critics such as Axel Honneth have charged Adorno with adhering to a reductive model of personal domination, I argue that the latter rather understands domination as a structural and de-individualized feature of capitalist society. If Adorno’s social theory is to be explanatory, however, it must account for the source of the abstractions that dominate modern individuals and, in particular, that of value. While such an account remains undeveloped in Adorno, Marx provides resources for its development, in positing the constitution of value neither in production nor exchange alone, but in the social totality. This article argues that Marx’s account is compatible with Adorno’s, and that it may be used to render Adorno’s theory of domination more credible on explanatory grounds.",
    abstract_source = "s2"
}

@misc{marasco2015highway,
    author = "Marasco, Robyn",
    title = "The Highway of Despair: Critical Theory After Hegel",
    year = "2015",
    note = {CORE ARGUMENT: Marasco tracks the concept of Hegelian "despair" — the negative, self-undermining movement of consciousness in the Phenomenology's introduction — as it is transmitted to and transformed by critical theory (Marcuse, Adorno, and beyond), arguing that critical theory's most vital resources lie in inhabiting this despair (negativity without guaranteed reconciliation) rather than resolving it, and that later critical theory's turn toward normative reconstruction (e.g., Habermasian communicative reason) forecloses this negativity prematurely. RELEVANCE: Speaks directly to the domain's question about the Frankfurt School's "retreat from the positive Absolute": Marasco offers a sustained philosophical account of what it means for critical theory to hold onto Hegelian negativity (the "highway of despair") without the promise of Absolute reconciliation that structures Hegel's own system. POSITION: Defends a critical theory "after Hegel" organized around unresolved negativity, implicitly siding with Adorno's negative dialectics against subsequent normative-reconstructive critical theory. sep\\\_context: SEP "Critical Theory (Frankfurt School)" (section 7, "A Continuing and Contested Tradition") cites Marasco (2015, ch. 3) alongside Allen (2016, 2021) among critical theorists who "continue to defend Adorno's approach to critical theory" against Habermasian criticisms.},
    keywords = "hegel, negativity, adorno, critical-theory, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {Critical theory is committed to emancipation from domination and oppression. Despair might seem unhelpful, if not entirely antithetical, to practical and theoretical projects aimed at radically transforming society. Without hope, why participate in movements for social change? Shouldn't theorists who support such movements want to avoid despair? In this book, however, Robyn Marasco provocatively argues that critical theorists should get over the urge to provide a way out of despair. Indeed, contemporary critique can learn quite a bit, she claims, from thinkers who have theorized "at the heights of despair" (85). Such "negative passions" can "enrich the political imagination and enliven political praxis" (6). Each of the five main chapters provides an innovative and engaging reading of one of the main figures who help make this case: Hegel, Kierkegaard, Adorno, Bataille, and Fanon. Anyone interested in any of them will profit immensely from reading Marasco's illuminating work. The close readings that move each chapter along also contribute to a larger argument about the direction contemporary critical theory should take. Critical theorists of all types will have to grapple with Marasco's challenge to travel on, rather than seek an exit from, the highway of despair. Political theorists too will have to consider her attempt to revalue the "politics of despair" (14). Marasco situates the book within the lineage of Frankfurt School critical theory while also aiming to expand its repertoire by engaging figures like Kierkegaard, Bataille, and Fanon. Adorno is the central figure and the one through which "the book maintains its deepest connection with the radical intellectual tradition born in Frankfurt" (18). Also tying the book to this tradition is a central foil, dealt with most extensively in the "Concluding Postscript": Habermas's attempt to rescue critical theory from the despair associated with "first generation" Frankfurt School theorists, the height of which is found in Horkheimer and Adorno'sDialectic of Enlightenment. Not only is this rescue mission unnecessary, Marasco worries that "the felt need to find rescue from despair . . . is precisely what cements its hold on critical political consciousness" (31). Hegel sets the course in Chapter 1, not as he typically might for critical theorists, as precursor to Marx or as theorist of recognition, but rather by introducing the "highway of despair." He used this phrase in thePhenomenology of Spiritto describe the course charted by "natural consciousness." Here Marasco aims to "catch a glimpse of a hidden undercurrent in thePhenomenology" (50) by viewing despair as the text's "animating force" since consciousness is "always coming undone" and thus "in principle always in despair" (52). There is a "buried idea of freedom" here too that "is found in the play of the passions" (56). Marasco admits this is an "undeveloped idea" (56) in Hegel since he explicitly thought philosophy can provide a way out of such despair. But in light of skepticism about reason providing a way out, she returns to Hegel to try to recover the "distinct pathos in dialectical thinking" (2) as a resource for critique rather than something to be evaded. In Chapter 2, Marasco turns to Kierkegaard, no stranger to despair. In an insightful reading that I cannot do justice to here, Marasco focuses mainly on his systematic analysis of despair inThe Sickness Unto Death. Both Hegel and Kierkegaard treat despair, she argues, as a dialectical passion. Kierkegaard's fractured dialectic, like Hegel's, draws its energy from the passions that it also prohibits. He comes after Hegel in recentering the passionate side of philosophical activity. In thinking and writing at the limits of philosophy, he aims to do justice to our passions. (76) Although there is much to be gained from his thinking on despair, Kierkegaard also inherits from Hegel the conviction that there must be a way out of despair, through faith not reason. The idea that neither faith nor reason is up to the task sets up the transition from Part I ("Dialectics and Despair") to Part II ("Dialectical Remains"), in which Marasco engages Adorno, Bataille, and Fanon as "studies in what critical theory can do when freed from the demand that it furnish a way out of despair" (21). From each we learn "something about how to take refreshment from the dialectical quality of despair" (78).},
    abstract_source = "ndpr"
}

@misc{stahl2018lukacs,
    author = "Stahl, Titus",
    title = "Lukács and the Frankfurt School",
    year = "2018",
    note = {CORE ARGUMENT: Stahl surveys the ambivalent relationship between Lukács's work and the Frankfurt School, showing that while Lukács's theory of reification was a decisive inspiration for the first generation's attempt to grasp the oppressive features of capitalist modernity, both his political conclusions (culminating in submission to Soviet orthodoxy) and unresolved tensions in his theoretical framework led subsequent critical theorists to distance themselves from central elements of his position. RELEVANCE: Offers a concise, focused account precisely of the domain's core transmission question — what Frankfurt School critical theory took from and rejected in Lukács — useful as connective tissue between the more specialized Gindner, Kavoulakos, and Bueno treatments. POSITION: Balanced reception history emphasizing both the formative influence and the eventual critical distancing between Lukács and the Frankfurt School. sep\\\_context: SEP "Georg [György] Lukács" (Life and Career) cites Stahl (2018) for the claim that "the major critical theorists of the time were all deeply impressed by the reification essay in particular," following Lukács's participation in the 1923 "Marxist Work Week" that helped found the Institute for Social Research.},
    keywords = "lukacs, frankfurt-school, reification, reception-history, Medium, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "The work of the Hungarian Marxist Georg Lukacs is a constant source of controversy in the history of the Frankfurt School. All leading thinkers of that theoretical tradition have struggled with Lukacs’s theory. On the one hand, it was an inspiration for their attempts to come to terms with the oppressive features of capitalist modernity. On the other hand, both its political conclusions and Lukacs’s actual philosophical submission to Soviet orthodoxy seemed to show that his theoretical framework was deeply flawed in one aspect or another.",
    abstract_source = "s2"
}

@misc{kavoulakos2017lukacs,
    author = "Kavoulakos, Konstantinos",
    title = "Lukács' Theory of Reification and the Tradition of Critical Theory",
    year = "2017",
    note = {CORE ARGUMENT: Kavoulakos traces how Lukács's theory of reification — capitalist commodity exchange becoming the central organizing principle of all social institutions and academic disciplines, producing "thing-like" social relations — was received, transformed, and in key respects displaced across the successive generations of critical theory, from the early Frankfurt School's interdisciplinary materialism through to Honneth's recognition-theoretic reformulation. RELEVANCE: Traces the specific conceptual afterlife of reification (as distinct from totality or the proletariat-subject) through critical theory, giving this domain a category-by-category account of what precisely survives Lukács's original Hegelian-Marxist formulation. POSITION: Reception-historical account of reification as critical theory's central inherited category from Lukács, read as undergoing successive critical reformulation rather than simple continuity or rejection.},
    keywords = "lukacs, reification, critical-theory, western-marxism, Medium, METADATA\\_CLEANED: doi, METADATA\_CLEANED: booktitle, pages, publisher, type:@incollection->@misc",
    abstract = "This chapter begins with a brief reconstruction of Lukács’ theory of reification, then goes on to consider the theory’s critical reception by Theodor W. Adorno, Jürgen Habermas and Axel Honneth. The author focuses on the critical reservations of these main representatives of the three generations of critical theory on Lukács’ theory, while also briefly referring to their attempts to preserve its true core. The chapter culminates in a broad assessment of the Frankfurt School’s critique of the theory and an attempt to determine the lead that a contemporary update should take.",
    abstract_source = "openalex"
}

@misc{horkheimer1982traditional,
    author = "Horkheimer, Max",
    title = "Traditional and Critical Theory",
    year = "1982",
    address = "New York",
    note = {CORE ARGUMENT: Horkheimer contrasts "traditional theory," modeled on the natural sciences and Cartesian method, with "critical theory," a Marxian mode of theorizing that has society itself for its object and openly situates itself within a historical and social setting for emancipatory effect. The essay summarizes the 1930s materialist program while transitioning toward the 1940s critique of reason: the critique of science shifts from an external complaint (lack of interdisciplinary integration) to an internal one (scientific formalism and the subsumption of facts under static universal concepts), and the critical theorist is described as standing in tension with, rather than simply expressing, the consciousness of the oppressed. RELEVANCE: This is the programmatic anchor text for the whole domain: it is the single essay most often cited as marking the pivot between Horkheimer's early materialist theory of history and the more pessimistic philosophy of history that dominates the 1940s. Its account of "critical theory" as a form of historically embedded, emancipation-oriented theorizing is the baseline against which the wartime and late-period changes are measured. POSITION: Foundational programmatic statement of critical theory; transitional text between 1930s interdisciplinary materialism and the 1940s critique of instrumental reason.},
    keywords = "primary-text, critical-theory, traditional-theory, historical-subject, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, publisher, type:@incollection->@misc"
}

@misc{horkheimer1993between,
    author = "Horkheimer, Max",
    title = "Between Philosophy and Social Science: Selected Early Writings",
    year = "1993",
    note = {CORE ARGUMENT: This anthology collects Horkheimer's key 1930s essays -- including the 1931 inaugural address "The Present Situation of Social Philosophy and the Tasks of an Institute for Social Research," "Materialism and Morality" (1933), "The Rationalism Debate in Contemporary Philosophy" (1934), "On the Problem of Truth" (1935), and "Egoism and Freedom Movements" (1936) -- which together lay out the empiricist-realist materialist program: truth is historically and socially mediated but answers to an objective reality irreducible to thought, and philosophy's task is to coordinate empirical social-scientific research toward the reduction of unnecessary human suffering. RELEVANCE: Provides the primary-source basis for the domain's second key question -- how the early materialist-empirical program conceives historical change and happiness -- prior to the shifts registered in "Traditional and Critical Theory" and the wartime writings. POSITION: Primary-source collection defining 1930s interdisciplinary materialism, the baseline against which "Traditional and Critical Theory" and the later critique of instrumental reason are read as departures.},
    keywords = "primary-text, materialism, interdisciplinary-research, happiness, historical-change, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {These essays reveal another side of Horkheimer, focusing on his remarkable contributions to critical theory in the 1930s. Max Horkheimer is well known as the director of the Frankfurt Institute for Social Research and as a sometime collaborator with Theodor Adorno, especially on their classic Dialectic of Enlightenment. These essays reveal another side of Horkheimer, focusing on his remarkable contributions to critical theory in the 1930s. Included are Horkheimer's inaugural address as director of the Institute, in which he outlines the interdisciplinary research program that would dominate the initial phase of the Frankfurt School, his first full monograph, and a number of other pieces published in the 1930s. The essays, most of which have not appeared in English before, are surprisingly relevant to current post-philosophy debates, notably "On the Problem of Truth," with its focus on pragmatism, and "The Rationalism Debate in Current Philosophy," a sustained critique of the post-Cartesian philosophy of consciousness. Horkheimer's 1933 critique of Kantian ethics, "Materialism and Morality," is of particular interest given the current reaction to the neo-Kantian aspect of Habermas's work. There are also essays relevant to the current foundations debate within Continental philosophy, and the rationality/relativism question is sustained throughout the volume.},
    abstract_source = "openalex"
}

@misc{horkheimer1947eclipse,
    author = "Horkheimer, Max",
    title = "Eclipse of Reason",
    year = "1947",
    address = "New York",
    note = {CORE ARGUMENT: Horkheimer traces the historical transformation of "objective reason" (reason as capable of grasping ends and values) into "subjective reason" (reason reduced to the calculation of means to given, unexamined ends), arguing that this formalization of reason, extended across the whole of Western history, culminates in a self-undermining rationality that abets rather than resists domination and, at the limit, a "new barbarism." Horkheimer explicitly disavows offering a positive program of action, holding that correcting the pathologies of thought must precede any genuinely emancipatory practice. RELEVANCE: The companion wartime text to Dialectic of Enlightenment and the clearest single-authored statement of Horkheimer's philosophy of history in the 1940s; essential for assessing how far the pessimism and diagnosis of "self-destructive reason" found here is Horkheimer's own independent contribution versus a product of the Adorno collaboration. POSITION: Primary wartime statement of the critique of instrumental/subjective reason as a historical-philosophical diagnosis of modernity's "eclipse" of objective reason.},
    keywords = "primary-text, instrumental-reason, subjective-reason, objective-reason, pessimism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{horkheimer1978dawn,
    author = "Horkheimer, Max",
    title = "Dawn and Decline: Notes 1926--1931 \\& 1950--1969",
    year = "1978",
    address = "New York",
    note = {CORE ARGUMENT: This volume collects Horkheimer's aphoristic notebooks from two widely separated periods: the pre-directorship Dämmerung aphorisms of 1926--1931, already marked by a materialist skepticism about philosophical systems and a focus on concrete social suffering, and the postwar Notizen of 1950--1969, in which the aphoristic form carries an increasingly pessimistic diagnosis of the "administered world" alongside recurring reflections on compassion, nonconformism, and the limits of what critical theory can positively affirm. RELEVANCE: Provides primary-source material spanning nearly the whole of Horkheimer's career in a single genre, making it the best textual basis for tracking continuity or rupture across the early materialist and late pessimistic/theological periods addressed by this domain's third key question. POSITION: Primary aphoristic source spanning early materialism and late pessimism; the genre itself (fragmentary, non-systematic) is often read as expressing Horkheimer's mature skepticism about systematic philosophy of history.},
    keywords = "primary-text, aphorism, pessimism, late-work, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{abromeit2011maxhorkheimer,
    author = "Abromeit, John",
    title = "Max Horkheimer and the Foundations of the Frankfurt School",
    year = "2011",
    note = {CORE ARGUMENT: Abromeit offers the first comprehensive intellectual biography of Horkheimer's early and middle career (1895--1941), reconstructing the model of early Critical Theory that guided the Institute for Social Research in the 1930s. He shows that the critical theory developed by Horkheimer (with Erich Fromm) in the late 1920s and early 1930s differs in crucial ways from Dialectic of Enlightenment, since Horkheimer and Adorno did not begin working together seriously until the late 1930s. RELEVANCE: The most detailed historical reconstruction of the pre-1941 materialist program available; essential for establishing what is distinctively Horkheimer's own (rather than a retrospective projection of the Adorno collaboration) in the 1930s conception of historical change and happiness. POSITION: Historical-biographical reconstruction emphasizing the independence and internal coherence of Horkheimer's early materialism prior to, and distinct from, the wartime collaboration with Adorno. sep\_context: SEP "Max Horkheimer" cites this work as the authoritative account of "the development of Horkheimer's thought" through 1941 (Biography section).},
    keywords = "materialism, intellectual-biography, 1930s, institute-for-social-research, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "This book is the first comprehensive intellectual biography of Max Horkheimer during the early and middle phases of his life (1895–1941). Drawing on unexamined new sources, John Abromeit describes the critical details of Horkheimer's intellectual development. This study recovers and reconstructs the model of early Critical Theory that guided the work of the Institute for Social Research in the 1930s. Horkheimer is remembered primarily as the co-author of Dialectic of Enlightenment, which he wrote with Theodor W. Adorno in the early 1940s. But few people realize that Horkheimer and Adorno did not begin working together seriously until the late 1930s or that the model of Critical Theory developed by Horkheimer and Erich Fromm in the late 1920s and early 1930s differs in crucial ways from Dialectic of Enlightenment. Abromeit highlights the ways in which Horkheimer's early Critical Theory remains relevant to contemporary theoretical discussions in a wide variety of fields.",
    abstract_source = "openalex",
    sep_context = {SEP "Max Horkheimer" (Biography section) states: "for a thorough history of the development of Horkheimer's thought up to this point, see Abromeit 2011," cited in connection with the period up to Horkheimer's relocation to Los Angeles in 1941.}
}

@misc{stirk1992maxhorkheimer,
    author = "Stirk, Peter M. R.",
    title = "Max Horkheimer: A New Interpretation",
    year = "1992",
    address = "Hertfordshire",
    note = {CORE ARGUMENT: Stirk offers a monograph-length reinterpretation of Horkheimer's development across his career, including sustained discussion of the late work's political positions -- notably Horkheimer's opposition to the radical student movements of the 1960s and his (qualified) support for American intervention in Vietnam as a bulwark against what he saw as a totalitarian threat. RELEVANCE: One of the earliest sustained monographs treating Horkheimer's philosophy as a coherent developmental trajectory rather than a mere prelude to or appendage of the Adorno collaboration; supplies textual and political-biographical detail for assessing the continuity/rupture question in the late period. POSITION: Developmental interpretation of Horkheimer's career situating the late political conservatism within, rather than as a betrayal of, his mature critical theory. sep\_context: SEP "Max Horkheimer" cites Stirk's discussion of Horkheimer's Cold War-era politics directly in its account of the late work's "backhanded conservatism."},
    keywords = "intellectual-biography, late-work, politics, development, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc",
    sep_context = {SEP "Max Horkheimer" (Late Work section) states, regarding Horkheimer's opposition to the student movements and qualified support for the Vietnam War, "on these points see Stirk 1992, 178-181," in the context of assessing charges that the late Horkheimer fell into "a backhanded form of conservatism."}
}

@misc{berendzen2008postmetaphysical,
    author = "Berendzen, J. C.",
    title = "Postmetaphysical Thinking or Refusal of Thought? Max Horkheimer's Materialism as Philosophical Stance",
    year = "2008",
    note = {CORE ARGUMENT: Berendzen argues that Horkheimer's 1930s materialism should be read as a considered "philosophical stance" -- a postmetaphysical orientation toward inquiry rather than either a substantive metaphysical thesis or a simple refusal to theorize -- that coordinates empirical research with critical, historically situated normative commitment without collapsing into positivism. RELEVANCE: Directly addresses the domain's second key question by giving materialism philosophical content beyond programmatic assertion, and supplies the interpretive category ("postmetaphysical stance") that later commentators (e.g., Shea) build on to track its fate in the 1940s critique of instrumental reason. POSITION: Reconstructive defense of 1930s Horkheimerian materialism as a coherent, still-relevant postmetaphysical philosophical position.},
    keywords = "materialism, postmetaphysical, 1930s, epistemology, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Frankfurt School critical theory has long opposed metaphysical philosophy because it ignores suffering and injustice. In the face of such criticism, proponents of metaphysics (for example Dieter Henrich) have accused critical theory of not fully investigating the questions is raises for itself, and falling into partial metaphysical positions, despite itself. If one focuses on Max Horkheimer’s early essays, such an accusation seems quite fitting. There he vociferously attacks metaphysics, but he also develops a theory that pushes toward metaphysical questions. His work can thus seem laden with unpacked metaphysical baggage, and fraught with contradiction. The aim of this paper is to show that Horkheimer’s critique of metaphysics makes sense and is not contradicted by a surreptitious metaphysics. To show this, Horkheimer’s views will be compared with Bas van Fraassen’s in The Empirical Stance. Ultimately, the paper should show that Horkheimer’s early philosophy can be reconstructed in such a way that it employs a ‘materialist stance’.",
    abstract_source = "openalex"
}

@article{shea2021postmetaphysical,
    author = "Shea, George W.",
    title = "Postmetaphysical Conundrums: The Problematic Return to Metaphysics in Horkheimer's Critique of Instrumental Reason",
    journal = "New German Critique",
    year = "2021",
    note = {CORE ARGUMENT: Building on Berendzen's account of Horkheimer's materialism as a postmetaphysical critical social theory, Shea argues that Horkheimer's wartime and postwar critique of instrumental reason paradoxically reintroduces metaphysical commitments (concerning "objective reason" and a normative conception of nature) that the 1930s materialist program had explicitly foresworn, generating unresolved tensions in Horkheimer's mature philosophy of history. RELEVANCE: Directly tracks the domain's third key question -- continuity or rupture between the early materialist program and the later critique of reason -- by identifying a specific philosophical cost (a "problematic return to metaphysics") of Horkheimer's move from materialism to the critique of instrumental reason. POSITION: Critical continuity reading that finds the wartime/postwar Horkheimer in tension with, rather than a simple extension of, his own earlier postmetaphysical materialism.},
    keywords = "instrumental-reason, metaphysics, objective-reason, continuity-rupture, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "Largely overshadowed by the renown of his colleagues Theodor W. Adorno, Walter Benjamin, and Herbert Marcuse, Max Horkheimer's contributions to the Frankfurt School are often downplayed as those of the mere director of the Institute for Social Research and the lesser coauthor of Dialectic of Enlightenment. Despite occupying this position of marginality within the corpus of Critical Theory, Horkheimer's work stands as a significant and sustained attempt to develop an interdisciplinary and materialist research program as a methodological alternative to metaphysical philosophy. As J. C. Berendzen notes, one of Horkheimer's most significant contributions to philosophy is his development of materialism as a viable postmetaphysical critical social theory.",
    abstract_source = "semantic\_scholar"
}

@misc{oneilluebel2004horkheimer,
    author = "O'Neill, John and Uebel, Thomas",
    title = "Horkheimer and Neurath: Restarting a Disrupted Debate",
    year = "2004",
    note = {CORE ARGUMENT: Using Otto Neurath's unpublished reply to Horkheimer's 1937 essay "The Latest Attack on Metaphysics," O'Neill and Uebel argue that Horkheimer's caricature of logical positivism as reifying social reality and prohibiting radical critique was largely unfounded, and reconstruct the debate the two might have had had Neurath's reply been published, concerning whether critique of science's relation to social praxis must come "from above" (Horkheimer's supra-scientific critical theory) or "from within" empirically-minded history and sociology of science (Neurath). RELEVANCE: Bears on the domain's account of the early materialist program's relation to empiricism and positivism, showing that the antagonism Horkheimer built into "Traditional and Critical Theory" and "The Latest Attack on Metaphysics" was in part a product of a one-sided, unanswered exchange rather than a settled philosophical verdict. POSITION: Historical-philosophical reconstruction that is critical of Horkheimer's polemic against logical positivism, aligning with Neurath's empiricist critique of "supra-scientific" critical theory.},
    keywords = "logical-positivism, neurath, materialism, methodology, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{handelman2019trouble,
    author = "Handelman, Matthew",
    title = "The Trouble with Logical Positivism: Max Horkheimer, Theodor W. Adorno, and the Origins of Critical Theory",
    booktitle = "The Mathematical Imagination",
    year = "2019",
    doi = "10.5422/fordham/9780823283835.003.0002",
    note = {CORE ARGUMENT: Handelman examines how Horkheimer, Adorno, and Walter Benjamin's prewar confrontation with the Vienna Circle's logical positivism (Neurath, Carnap) hardened into a historical narrative equating mathematics and mathematized reason with the "downfall of Enlightenment," such that the reduction of philosophy to mathematical-logical operations came to figure, for early critical theory, as politically impotent and complicit with industrial and authoritarian power. RELEVANCE: Complements O'Neill and Uebel by tracing the origin of Horkheimer's (and Adorno's) opposition to formalized/mathematized reason back to the 1930s Vienna Circle confrontation, showing how a specific polemical episode became canonized as a general thesis about instrumental reason carried into the postwar texts. POSITION: Intellectual-historical account of how the critique of mathematics/formalism, later central to the critique of instrumental reason, originates in the 1930s dispute with logical positivism.},
    keywords = "logical-positivism, mathematics, formalism, origins-of-critical-theory, Medium, METADATA\_CLEANED: pages, publisher, type:@incollection->@misc",
    abstract = "How did critical theory, at least as it was first envisioned by Max Horkheimer and Theodor W. Adorno, come to be so opposed to mathematics? Chapter 1 examines the transformation of Horkheimer, Adorno, and Walter Benjamin's prewar confrontation with Logical Positivism into a history of thinking that equated mathematics with the downfall of Enlightenment. According to the first generation of critical theorists, the reduction of philosophy to the operations and symbols of mathematics, as proposed by Logical Positivists such as Otto Neurath and Rudolph Carnap, rendered modern philosophy politically impotent and acquiesced to the powers of industry and authoritarian government. This initial phase of critical theory defined itself against the Logical Positivists' equation of thought and mathematics, subsuming mathematics in their interpretation of reason's return to myth and barbarism. Horkheimer and Adorno's postwar texts and the work of second-generation critical theorists perpetuated this image of mathematics, canonizing it as an archetype of instrumental reason, reification, and social domination.",
    abstract_source = "semantic\_scholar"
}

@misc{freyenhagen2023linguistic,
    author = "Freyenhagen, Fabian",
    title = "The Linguistic Turn in the Early Frankfurt School: Horkheimer and Adorno",
    year = "2023",
    note = {CORE ARGUMENT: Freyenhagen argues that Horkheimer's Eclipse of Reason (with Adorno) contains a "linguistic turn" avant la lettre, sharing a picture of language with the later Wittgenstein according to which the inseparability of human life-form and language makes language an inextinguishable reservoir of what Horkheimer calls "objective reason." This picture, Freyenhagen contends, renders Horkheimer's theory more defensible and provides a resource for answering Habermas's charge that Horkheimer and Adorno leave no coherent standard from which to criticize instrumental reason. RELEVANCE: Offers a close, philosophically precise reading of Eclipse of Reason's central argument (the eclipse of objective by subjective/instrumental reason), directly relevant to the domain's account of Horkheimer's wartime philosophy of history and to the standard Habermasian objection that this period's critique of reason is self-undermining. POSITION: Defends Horkheimer's (and Adorno's) wartime critique of instrumental reason against the Habermasian charge of normative self-undermining, via a Wittgenstein-inflected reading of "objective reason" as embedded in ordinary language.},
    keywords = "eclipse-of-reason, objective-reason, wittgenstein, habermas-critique, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Was there a linguistic turn in Frankfurt School Critical Theory before Habermas's communications-theoretic one? Might later Wittgenstein and the early Frankfurt School have adopted similar pictures of language? I propose that both questions should be answered affirmatively, focusing on Horkheimer's Eclipse of Reason. I argue that, thanks to the picture of language that Horkheimer and Adorno share with (later) Wittgenstein, we can reconstruct their theory in a way that renders it more defensible. Insofar as the human life form and language are inseparable, language can be an inextinguishable reservoir of what Horkheimer called "objective reason." Recognizing this allows us to answer Habermas's critique of Horkheimer and Adorno. Moreover, paying attention to this inseparableness can enable us to engage in disclosing social critique (for example, regarding current debates about sustainability).},
    abstract_source = "semantic\_scholar"
}

@article{gunderson2012horkheimers,
    author = "Gunderson, Ryan",
    title = "Horkheimer's Pessimism and Compassion",
    journal = "Telos",
    year = "2012",
    note = {CORE ARGUMENT: Gunderson argues against the common dismissal of Horkheimer as merely a "tardy pessimist" trailing Walter Benjamin or a footnote to Adorno's genius, contending instead that Horkheimer's characteristic pessimism about historical progress is inseparable from, and in fact grounded in, an abiding compassion for suffering that runs continuously from his earliest to his latest writings. RELEVANCE: Directly addresses the domain's third key question, arguing for continuity (via the constant of compassion) between the early materialist concern with suffering and happiness and the late pessimistic and theologically inflected writings, rather than a rupture. POSITION: Continuity thesis reading Horkheimer's late pessimism as the mature expression of an early and constant ethical commitment (compassion for suffering) rather than a decline or capitulation.},
    keywords = "pessimism, compassion, continuity, late-work, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = {What would happiness be that was not measured by the immeasurable grief at what is? For the world is deeply ailing. Theodor Adorno, "Regressions," Minima Moralia1},
    abstract_source = "openalex"
}

@misc{michaelis2022critical,
    author = "Michaelis, Loralea",
    title = "Critical theory under the sign of Schopenhauer: A reconsideration of Horkheimer's interpretative debt",
    year = "2022",
    volume = "30",
    note = {CORE ARGUMENT: Michaelis reconsiders the standard account of Horkheimer's late turn to Schopenhauer (as teacher of pessimism and suffering "for modern times"), examining more precisely what Horkheimer selectively appropriated from and departed from in Schopenhauer's metaphysics of the will and compassion, in order to reassess how much of Horkheimer's late position is genuinely Schopenhauerian versus repurposed for critical theory's own ends. RELEVANCE: Complicates and refines Gunderson's and the SEP's straightforward "Schopenhauer as teacher of pessimism" narrative, providing the domain with a more precise account of exactly what philosophical work Schopenhauer does in Horkheimer's late philosophy of history. POSITION: Revisionist reading of Horkheimer's Schopenhauer reception, qualifying rather than rejecting the standard continuity narrative linking early materialism's concern with suffering to late Schopenhauerian pessimism.},
    keywords = "schopenhauer, pessimism, late-work, compassion, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{siebert2005critical,
    author = "Siebert, Rudolf J.",
    title = "The Critical Theory of Society: The Longing for the Totally Other",
    year = "2005",
    note = {CORE ARGUMENT: Siebert reconstructs Horkheimer's critical theory of religion around the category of "the longing for the totally/wholly Other" -- the desire, uncoupled from institutional religious dogma, that the injustice characterizing history not be the final word -- and traces its function across Horkheimer's work as a negative-theological resource for critical resistance to a totally administered world. RELEVANCE: The most sustained treatment of the specific category ("longing for the wholly other") named in this domain's search brief, giving the domain its fullest account of how Horkheimer's late theological turn functions philosophically rather than merely biographically. POSITION: Sympathetic reconstruction of Horkheimer's negative theology of history as a coherent (if non-dogmatic) resource for critical theory, aligned with the Siebert/Ott line of "critical theory of religion" scholarship.},
    keywords = "wholly-other, negative-theology, religion, late-work, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This essay is concerned with the religious and theological dimension of Max Horkheimer's, Theodor W. Adorno's, and Walter Benjamin's and other theorists' critical theory of society. It aims at a new critical theory of religion, which would go beyond the religious and theological concerns of the critical theory of society. The essay concentrates on the way, in which the critical theorists of the first and second generation dealt with the modern dichotomy between the religious and the secular, the sacred and the profane, revelation and enlightenment, religious faith and autonomous reason, church and state. The critical theorists have left behind the idealistic attempt to reconcile the modern dichotomy of the religious and the secular: e.g., that of Leibnitz, Hegel, Goethe, or Beethoven. The essay focuses on the critical theorists' materialistic attempt — not to reconcile faith and knowledge, that is not possible at this point in history — but at least to prevent the modern contradiction between monotheism and enlightenment to be closed prematurely either fundamentalistically or scientistically and positivistically. Adorno and Benjamin have initiated an inverse theology, which presupposes a. that religion has indeed contributed to the humanization of mankind, and b.that the secularization process cannot be stopped. The inverse theology allows semantic and semiotic materials and potentials to migrate from the depth of the mythos into the secular discourse among the expert cultures — sociology, psychology, anthropology, philosophy — and through it into communicative and political action, in order thus to prevent the further rebarbarization of the Western civilization. The inverse theology is a test in so far as that semantic or semiotic material, which cannot be translated into the profane discourse of expert cultures, cannot be rescued and will be lost. One central semantic element, which Adorno and Horkheimer intended to rescue, was the longing for the totally Other than the slaughterbench, holocaust — altar and Golgatha of history. In this longing for the entirely Other is concretely superseded, i.e., criticized, but also preserved and elevated and fulfilled, what once in the world — religions and — philosophies had been called: Eternity, Beauty, Heaven, God, Infinite, Transcendence, Being, Idea, Absolute, Unconditional. The critical theorists transform once certain religious dogmas into longings. The longing for the totally Other has been the fundamental motive and motivation of the critical theorists, which gave them manifestly or latently energy for almost a whole century, and which allowed them to survive two world wars, and fascism, and emigration, and to make it possible for them on one hand not to regress into mythology, and on the other hand not to fall victim to positivism as the metaphysics of what is the case.",
    abstract_source = "openalex"
}

@misc{nagldocekal2020nach,
    author = "Nagl-Docekal, Herta",
    title = "Nach einer erneuten Lektüre: Max Horkheimer, Die Sehnsucht nach dem ganz Anderen",
    year = "2020",
    note = {CORE ARGUMENT: Revisiting Horkheimer's 1970 Der Spiegel interview "Die Sehnsucht nach dem ganz Anderen" ("What we call meaning is bound to vanish"), Nagl-Docekal examines Horkheimer's thesis that human beings share a "longing that the injustice which characterizes the world must not be the final word," asking whether this "desire for the totally other" is Kantian in inspiration (grounded in a "need of practical reason" for religion) and how it relates to Horkheimer's critique of a "total administration of the world" that threatens to reduce thinking to industrial process. She also situates Habermas's postmetaphysical reading of Horkheimer's "negative theology" within this discussion. RELEVANCE: The most directly focused treatment of the exact phrase and interview text ("Sehnsucht nach dem ganz Anderen") that anchors the domain's account of Horkheimer's theological turn, and explicitly connects it back to Kantian practical reason -- illuminating a philosophical genealogy for the "wholly other" beyond its usual location in negative theology alone. POSITION: Interprets Horkheimer's late "longing for the wholly other" as continuous with a Kantian conception of religion grounded in the needs of practical (rather than theoretical) reason, read through Habermas's postmetaphysical reception of Horkheimer's "negative theology."},
    keywords = "wholly-other, negative-theology, kant, late-work, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {"What we call meaning is bound to vanish": Under this heading, an interview with Max Horkheimer was published in Der Spiegel (Jan 5, 1970). Revisiting this interview, the article focuses on Horkheimer's thesis that human beings share the "longing that the injustice which characterizes the world must not be the final word". It examines the extent to which Horkheimer's notion of the "desire for the totally other" may be inspired by Kant's claim that religion is grounded in the "need of practical reason". A further topic of discussion is Horkheimer's critical assessment concerning current tendencies toward a "total administration of the world" that may ultimately "reduce thinking to the level of industrial processes". Relating this critique to Kant's reflections on the "unbelief of reason (Vernunftunglaube)", which is based on "the maxim of reason's independence of its own need", the article raises the question of Horkheimer's significance today: What relevance does Horkheimer's method of casting doubt on any "politics that is not based on theology, metaphysics and, of course, morality" have for today's discourse on such matters? In this context a brief glance is cast at Jürgen Habermas's post-metaphysical reading of Horkheimer's "negative theology".},
    abstract_source = "semantic\_scholar"
}

@misc{walentowicz2006max,
    author = "Walentowicz, Halina",
    title = "Max Horkheimer and His Philosophy",
    year = "2006",
    note = {CORE ARGUMENT: Contrary to the "interpretative stereotype" in the secondary literature, Walentowicz argues that Horkheimer's critical theory retains an underlying identity across three distinguishable stages -- prewar (formation of critical theory's evidentiary basis), wartime (the historiosophical conception of enlightenment's self-destruction), and postwar (prediction of the "administered world") -- unified by two constants: sustained criticism of the very founding assumptions of critical theory in light of changing socio-historical circumstances, and an unrelenting desire to change things for the better. RELEVANCE: Provides the domain with an explicit, named three-stage periodization matching the structure of the search brief (interwar programmatic essays / wartime convergence with Adorno / postwar pessimistic-theological turn) and a direct argument for continuity across all three, making it a natural organizing counterpoint to Crawford's rupture-emphasizing account. POSITION: Continuity thesis: Horkheimer's critical theory preserves a single underlying identity (critical self-scrutiny plus the desire for a better world) across all three developmental stages, against readings that treat the stages as discontinuous.},
    keywords = "periodization, continuity-rupture, development, three-stages, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{crawford2025critical,
    author = "Crawford, Ryan",
    title = "Critical Theory Consolidated: Foreword Regression in the Late Work of Max Horkheimer and Its American Reception",
    year = "2025",
    note = {CORE ARGUMENT: Crawford argues that critical theory's ascendance to the status of a global intellectual paradigm rests on a half-century search for the Frankfurt School's foundations in philosophy and religion -- initiated by Horkheimer's own turn to religion and political conservatism in the late 1960s and early 1970s -- rather than in the previously recognized source of contemporary social problems and the tradition of Marxism. He returns Horkheimer's late work to its context in Cold War-era debates about American militarism, political emancipation, women's rights, and the "Third World," showing how controversies surrounding Horkheimer's religious rewriting of critical theory continue to shape influential American accounts of Frankfurt School history. RELEVANCE: Directly engages the domain's third key question by historicizing, rather than simply narrating, the "theological turn": Crawford treats the received story of a continuous development toward late religiosity as itself a retrospective, politically inflected construction of Horkheimer's American reception, complicating both the continuity readings (Walentowicz, Gunderson) and any straightforward rupture reading. POSITION: Critical-historicist account that treats the canonization of the "religious-metaphysical" late Horkheimer as a contingent, Cold War-inflected reception history rather than a straightforward immanent development of his thought.},
    keywords = "late-work, religion, reception-history, cold-war, continuity-rupture, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The ascendance of critical theory to the status of a global intellectual paradigm is the result of a half-century-long search for the Frankfurt School’s foundations in philosophy and religion rather than its previously recognized source in contemporary social problems and the tradition of Marxism. Initiated by Max Horkheimer’s turn to religion and political conservatism in the late 1960s and early 1970s and then defended by West German contemporaries, the resulting canonization of critical theory has been more recently consolidated by leading American representatives of Frankfurt School intellectual history. To reconstruct this process, this essay returns Horkheimer’s late work to its context in Cold War–era debates about American militarism, political emancipation, women’s rights, the “Third World,” and related social struggles before showing how the controversies surrounding his religious rewriting of critical theory continue to inform influential accounts of Frankfurt School history.",
    abstract_source = "openalex"
}

@misc{lowy2005firealarm,
    author = "Löwy, Michael",
    title = "Fire Alarm: Reading Walter Benjamin's 'On the Concept of History'",
    year = "2005",
    address = "London and New York",
    note = {CORE ARGUMENT: A line-by-line commentary on Benjamin's theses "On the Concept of History," reading them as a "fire alarm" sounded against both fascism and the complacent, evolutionist Marxism of the Second International and Social Democracy. Löwy stresses the theses' fusion of Jewish messianism and revolutionary materialism, arguing that Benjamin's "weak messianic power" names a collective, this-worldly capacity for interruption rather than a transcendent redeemer, and that the "tradition of the oppressed" is meant to displace the historicist narrative of inevitable progress. RELEVANCE: Provides the fullest close reading of the primary text at the center of this domain and is the natural reference point for any synthesis discussion of Jetztzeit, the angel of history, and weak messianic power; its emphasis on the anti-progressivist and anti-conformist political stakes of the theses supplies the sharpest contrast case against Horkheimer and Adorno's own more skeptical philosophy of history. POSITION: Represents the materialist-messianic reading that treats theology and historical materialism in Benjamin as mutually constitutive rather than opposed.},
    keywords = "Benjamin, theses-on-history, weak-messianic-power, historical-materialism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{wolin1994aesthetic,
    author = "Wolin, Richard",
    title = "Walter Benjamin: An Aesthetic of Redemption",
    year = "1994",
    address = "Berkeley and Los Angeles",
    note = {CORE ARGUMENT: A synthetic intellectual study tracing the development of Benjamin's thought from the early theological-linguistic writings through the Trauerspiel book to the late theses, arguing that a redemptive, quasi-theological impulse persists across Benjamin's ostensibly more "materialist" later phases and that this impulse is what most sharply distinguishes his position from orthodox historical materialism. RELEVANCE: Establishes the case, contested by more strictly materialist readings (Tiedemann, Khatib), that Benjamin's philosophy of history cannot be fully secularized without losing its critical force; this framing is central to assessing how far Adorno and Horkheimer's own philosophy of history retains or expels this redemptive-theological residue. POSITION: Represents the "theological continuity" reading of Benjamin against interpretations that see a decisive break toward historical materialism in his later work.},
    keywords = "Benjamin, redemption, theology, aesthetic-theory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{buckmorss1977origins,
    author = "Buck-Morss, Susan",
    title = "The Origin of Negative Dialectics: Theodor W. Adorno, Walter Benjamin, and the Frankfurt Institute",
    year = "1977",
    address = "Hassocks",
    note = "CORE ARGUMENT: Reconstructs the intellectual formation of Adorno's negative dialectics through his sustained engagement with Benjamin, arguing that Adorno's mature philosophical method — including his approach to history, constellation, and the non-identical — cannot be understood apart from his decade-long dialogue, collaboration, and disagreement with Benjamin within and around the Institute for Social Research. RELEVANCE: Directly documents the institutional and intellectual mechanics of the relationship this domain investigates, including the material conditions (Institute funding, editorial control) that shaped how Benjamin's ideas were transmitted into and transformed by Adorno's own philosophy of history. POSITION: A foundational account of Adorno's dependence on and departure from Benjamin, treating negative dialectics itself as partly a working-through of Benjaminian materials.",
    keywords = "Adorno, Benjamin, negative-dialectics, Frankfurt-Institute, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{buckmorss1989dialectics,
    author = "Buck-Morss, Susan",
    title = "The Dialectics of Seeing: Walter Benjamin and the Arcades Project",
    year = "1989",
    address = "Cambridge, MA and London",
    note = {CORE ARGUMENT: A reconstruction of the unfinished Arcades Project as Benjamin's attempt to realize a "dialectics of seeing": a materialist historiography built from the montage of concrete historical images (the arcades, the flâneur, fashion, the commodity) rather than narrative argument, in which nineteenth-century Paris becomes legible as the "prehistory" of the present. RELEVANCE: Provides the fullest secondary account of the constellational/montage method named in this domain's brief, and documents Adorno's criticisms of the 1935 Exposé (the "Hornberg letter") that crystallized the dispute over whether dialectical images require explicit conceptual and economic mediation. POSITION: Sympathetic reconstruction of Benjamin's own historiographic method, read partly against Adorno's demand for more systematic mediation.},
    keywords = "Benjamin, arcades-project, dialectical-image, montage, historiography, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{pensky2001melancholy,
    author = "Pensky, Max",
    title = "Melancholy Dialectics: Walter Benjamin and the Play of Mourning",
    year = "2001",
    address = "Amherst",
    note = {CORE ARGUMENT: Argues that Benjamin's mature theory of "redemptive criticism" is best understood as a sustained working-through of melancholia, in which the allegorical, ruin-obsessed sensibility first theorized in the Trauerspiel book becomes, in the Arcades Project and the late theses, the affective and formal basis for a materialist historiography that redeems the discarded and forgotten rather than narrating triumphant progress. RELEVANCE: Connects this domain's concern with redemption of the past to Benjamin's earlier melancholic/allegorical thought, offering a bridge to the separate Natural History domain and clarifying why Adorno, in his own writing on history, retained an affinity for images of ruin and petrification while resisting Benjamin's more affirmative claims about redemption. POSITION: A psychoanalytically and rhetorically inflected reading that treats melancholia, rather than theology per se, as the generative core of Benjamin's philosophy of history.},
    keywords = "Benjamin, melancholy, redemption, allegory, mourning, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{comay1999perverse,
    author = "Comay, Rebecca",
    title = "Perverse History: Fetishism and Dialectic in Walter Benjamin",
    year = "1999",
    note = {CORE ARGUMENT: Examines the relationship between Benjamin's account of commodity fetishism and his dialectical historiography, arguing that Benjamin's method deliberately courts a "perverse" relation to history — one that reproduces, rather than simply diagnoses, the fetishistic freezing of time it seeks to interrupt — and asks what this means for the dialectical status of the dialectical image. RELEVANCE: Sharpens this domain's central methodological question about whether Benjamin's montage-historiography is genuinely dialectical or merely juxtapositional, a question that is precisely what motivated Adorno's objections to the Arcades exposé. POSITION: A close, deconstructively-inflected reading that complicates any simple opposition between Benjamin's "immediate" dialectical images and Adorno's demand for mediated dialectic.},
    keywords = "Benjamin, fetishism, dialectical-image, historiography, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{tiedemann1983historical,
    author = "Tiedemann, R.",
    editor = "Smith, Gary",
    title = {Historical Materialism or Political Messianism? An Interpretation of the Theses "On the Concept of History"},
    year = "1989",
    address = "Chicago and London",
    note = {CORE ARGUMENT: Poses directly the question that structures decades of Benjamin reception: whether "On the Concept of History" should be read as a work of historical materialism using messianic language as rhetorical scaffolding, or as a fundamentally theological-political text using Marxist vocabulary as camouflage. Tiedemann, writing from within the circle of Benjamin's literary executors, argues for the priority of the materialist reading while acknowledging the irreducibility of the theses' theological imagery. RELEVANCE: This essay is the canonical statement of the interpretive dilemma this domain is built around, and its "historical materialism or political messianism" framing is explicitly cited (per the SEP entry on Benjamin, section 9) as the polemical legacy of the competing Scholem/Brecht/Adorno influences on Benjamin's reception. POSITION: Argues for the primacy of the materialist reading, positioning itself against Scholem's more strongly theological interpretation and implicitly against Wolin's later "aesthetic of redemption" thesis.},
    keywords = "Benjamin, historical-materialism, messianism, theses-on-history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc"
}

@misc{beardsworth2005benjamin,
    author = "Beardsworth, Sara",
    title = "Benjamin, Horkheimer, and Adorno: Modes of Historical Reflection and the Problem of Authoritative Statements",
    year = "2005",
    abstract = "The paper considers what united and divided Benjamin and Horkheimer-Adorno in terms of their respective confrontations with the question of what it is to articulate the past historically. It presents their shared self-consciousness of the difficult task of responding critically to a problem conceived of as the entanglement of the concept of history with domination. For the problem imbues conceptualization itself and therefore threatens the value of the authoritative statements made in their own critical reflection on it. I show that these thinkers necessarily respond to the problem in confrontation with specific historical contexts: fascism, Soviet communism, German social democracy, and liberal democracy. The challenge they face is how to metabolize thinking in the midst of tendencies that disable it. I compare Benjamin's solution, the dialectical image, with Horkheimer and Adorno's solution, the recovery of critical reflection through the fragmentary writing of Dialectic of Enlightenment.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Directly compares Benjamin's dialectical image with Horkheimer and Adorno's fragmentary method in Dialectic of Enlightenment as two distinct solutions to a shared problem: how to make authoritative critical statements about history once the concept of history itself is understood to be entangled with domination. Both responses are read as historically situated confrontations with fascism, Stalinism, and the failures of social democracy and liberalism. RELEVANCE: This is the most direct treatment found of this domain's fourth key question — whether the Adorno-Horkheimer philosophy of history is a transformation of Benjaminian messianism — arguing that Dialectic of Enlightenment's fragmentary form is itself a structural analogue to, and departure from, Benjamin's dialectical image. POSITION: A comparative reading that treats Benjamin and Horkheimer/Adorno as parallel rather than simply derivative responses to the crisis of historical narration.",
    keywords = "Benjamin, Horkheimer, Adorno, dialectical-image, Dialectic-of-Enlightenment, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{bohn2019historiography,
    author = "Bohn, Charlotte Odilia",
    title = "Historiography and Remembrance: On Walter Benjamin's Concept of Eingedenken",
    year = "2019",
    abstract = {Engaging with Walter Benjamin's concept of Eingedenken (remembrance), this article explores the pivotal role that remembrance plays in his attempt to develop a radically new vision of history, temporality, and human agency. Building on his essay "On Some Motifs in Baudelaire" and on his last written text, "Theses on the Philosophy of History", it will trace how memory and historiography are brought together in a curious fusion of materialist and messianic thinking. Emerging from a critique of modernity and its ideology of progress that is cast as crisis—the practice of remembrance promises a 'way out'. Many of Benjamin's secular Marxist critics such as Max Horkheimer and Rolf Tiedemann, however, denied the political significance of Eingedenken—dismissing it as theological or banishing it to the realm of aesthetics. Rejecting this critique, I suggest that the radical ethical aspects of Eingedenken can be grasped only once the theological dimension is embraced in its own right and that it is in precisely this blend of materialist and messianic thought that revolutionary hope may be found.},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Argues that Benjamin's concept of Eingedenken (remembrance) fuses materialist and messianic thinking into a distinctive practice for interrupting the ideology of progress, and directly rebuts Horkheimer's and Tiedemann's dismissal of Eingedenken as merely theological or aesthetic rather than politically significant. RELEVANCE: Provides explicit documentation of Horkheimer's own critical distance from Benjamin's theological categories, giving this domain a concrete textual basis for assessing how the Frankfurt School's "secularized" philosophy of history related to and resisted Benjaminian messianism. POSITION: A revisionist defense of the theological dimension of Eingedenken against the secularizing critiques associated with Horkheimer and Tiedemann.},
    keywords = "Benjamin, Eingedenken, remembrance, Horkheimer, theology, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{recoder2019adornos,
    author = "Recoder, Luis A.",
    title = "Adorno's Arcades Orthodoxy",
    year = "2019",
    volume = "3",
    note = {CORE ARGUMENT: Reexamines Adorno's editorial and critical interventions into Benjamin's Arcades Project, arguing that Adorno's insistence on rigorous dialectical mediation functioned as a kind of methodological "orthodoxy" that Benjamin's own practice of montage historiography persistently exceeded or resisted. RELEVANCE: Bears directly on this domain's question of the substantive disagreements between Adorno and Benjamin over dialectical images and mediation, treating Adorno's posthumous editorial authority over Benjamin's texts as itself part of the methodological dispute. POSITION: Critical of Adorno's mediation requirement as a normalizing "orthodoxy" imposed on Benjamin's more heterodox historiographic practice.},
    keywords = "Adorno, Benjamin, arcades-project, dialectical-image, mediation, Medium, METADATA\_CLEANED: journal, number, pages, type:@article->@misc",
    abstract = "Theodor W. Adorno’s letter correspondence with Walter Benjamin throughout the decade of the 1930’s entertains the central question concerning the possibility of philosophy in their intellectual milieu. The fate of this possibility for Adorno hinges on Benjamin’s work-in-progress Das Passagen-Werk—a fate that is catastrophically blocked by an uncritical tendency convicted repeatedly by the former as “undialectical.” And yet Adorno obstinately persists in clinging to the canon of a philosophically overdetermined demand he endearingly calls “my Arcades orthodoxy.” The threatening destruction of the aura of this orthodoxy reaches a crisis in Adorno’s ruthless metacritique of Benjamin’s alleged undialectical treatment of aesthetic autonomy in a draft of the Kunstwerk essay, marking a critical wound in the correspondence which the following exposition tracks in the enigmatic changeover in the philosophical exigency of the said orthodoxy from prima philosophia to ultima philosophia. The lingering wound is registered in Adorno’s late philosophical work",
    abstract_source = "core"
}

@misc{feldman2011notdialectical,
    author = "Feldman, Karen S.",
    title = "Not Dialectical Enough: On Benjamin, Adorno, and Autonomous Critique",
    year = "2011",
    abstract = "With respect to Benjamin's treatments of the work of art and his historiographical method, Adorno accuses Benjamin of not being dialectical enough and of inadequate theorizing. This article argues that Adorno's blanket prescription for more dialectics covers over a chiastic relationship between his particular concern in each case. On one hand, Adorno worries that Benjamin gives over the artwork to ideological narratives. On the other hand, Adorno is concerned that Benjamin's historical materialism refuses historical narrative, which is precisely where Benjamin locates ideology. Indeed the disruptive potential that Adorno grants the artwork with respect to social and political ideology thus corresponds to the disruptive potential that Benjamin ascribes to his historical materialism with respect to historicist ideology. In this context the article considers the nature of autonomy for Benjamin and Adorno and its relationship to subversion, disruption, and redemption.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Shows that Adorno's recurring charge that Benjamin is "not dialectical enough" is internally chiastic: Adorno faults Benjamin's aesthetics for surrendering the artwork to ideology while faulting his historiography for refusing historical narrative altogether — precisely where Benjamin locates ideology's operation. Feldman argues both objections trade on divergent, only partly compatible conceptions of autonomy, subversion, and redemption. RELEVANCE: Offers the most precise articulation available in this domain's literature of the exact structure of Adorno's methodological complaint against Benjamin's historiography, making it essential for characterizing the substantive stakes of the mediation dispute. POSITION: A close analytic dissection of Adorno's critique that resists simply taking either Adorno's or Benjamin's side, instead showing the disagreement's internal structure.},
    keywords = "Adorno, Benjamin, dialectic, autonomy, critique, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{khatib2017wherethepast,
    author = "Khatib, Sami",
    title = "Where the Past Was, There History Shall Be",
    year = "2017",
    abstract = {As the proverb has it, 'tradition is not to preserve the ashes but to pass on the flame'. Taking this image as a starting point, this paper is interested in non-conservative concepts of tradition and (dis)continuity. If the concept of tradition is normally associated with continuity, the concept of tradition poses the question of transmittability. Is there a continuous medium in which narrations, customs, rites or other material practices can be handed down from the past to the present? If the transmittability of tradition is not a given, a commodified object, but subject to historical change, the question of tradition and inheritance is inextricably linked to social and political struggles. The concept of tradition, however, has mostly been theorized by conservative thinkers. In this vein, traditional historical materialism viewed tradition as a counter-progressive retarding force. Walter Benjamin (1940), however, proposed a different concept of historical time and tradition. History is not based on a progressive flow of "homogeneous, empty time" but on disruptive constellations of the present and the past. The past is never fully gone; it can never be fully historicized. The medium in which the present is connected to all lost causes and struggles of those who literally and metaphorically lost their histories is called the "tradition of the oppressed." Paradoxically, this medium is a discontinuum -- its texture is woven out of struggles, empty-spots and disconnected elements which cannot be represented in one transmittable image or inscribed into one multifaceted yet coherent world-history. If the "tradition of all dead generations weighs like a nightmare on the brains of the living" (Marx), then the tradition of the oppressed will also haunt all attempts to repress it completely and erase its experience in the linear continuum of "victor's history." But how are we to pass on an oppressed tradition? How can the tradition of the oppressed be recalled, actualized and "worked through"?},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Reconstructs Benjamin's "tradition of the oppressed" as a non-conservative, discontinuous concept of tradition that breaks with both traditional historical materialism's view of tradition as a retarding force and with the "homogeneous, empty time" of historicism, arguing that the tradition of the oppressed cannot be represented as one coherent world-history but only as a discontinuum of struggles and empty spots. RELEVANCE: Clarifies exactly how radical Benjamin's break with orthodox historical materialism's philosophy of history is, directly bearing on this domain's first key question, and gives conceptual precision to the "constellational" alternative to progressive historiography. POSITION: A contemporary materialist re-reading that treats Benjamin's philosophy of history as a heterodox extension, rather than rejection, of historical materialism.},
    keywords = "Benjamin, tradition-of-the-oppressed, historical-materialism, homogeneous-empty-time, Medium, METADATA\_CLEANED: journal, doi, type:@article->@misc"
}

@article{brittain2010politicaltheology,
    author = "Brittain, Christopher Craig",
    title = "Political Theology at a Standstill: Adorno and Agamben on the Messianic",
    journal = "Thesis Eleven",
    year = "2010",
    abstract = "This essay explores the use of the concept of the messianic by Giorgio Agamben and Theodor Adorno. Throughout his work, Agamben consistently presents his reading of the messianic as an alternative to what he considers to be the 'pessimistic' negative dialectics of Adorno, which he argues 'is an absolutely non-messianic form of thought'. For Agamben, the messianic brings dialectics to a 'standstill'. This essay analyzes this deployment of the 'messianic' in his thought, and contrasts it with the perspective of Adorno. Agamben's interpretation of Walter Benjamin is challenged with reference to a debate between Adorno and Benjamin over theology, dialectics, and politics.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Contests Agamben's claim that Adorno's negative dialectics is "absolutely non-messianic," arguing instead that Adorno's relation to the messianic is one of cautious, dialectically mediated retention rather than outright rejection, and uses the original Adorno-Benjamin debate over theology, dialectics, and politics to correct Agamben's reading of Benjamin. RELEVANCE: Bears directly on this domain's second key question about how Adorno's cautious retention of messianic figures (as in the closing aphorism of Minima Moralia) relates to Benjamin's "weak messianic power," using Agamben's later appropriation as a foil to sharpen the contrast between Adorno's and Benjamin's positions. POSITION: Defends Adorno against Agamben's characterization, arguing for a dialectically mediated rather than eliminated messianism in Adorno's thought.},
    keywords = "Adorno, Agamben, Benjamin, messianic, political-theology, Medium, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{moir2016walterbenjamin,
    author = "Moir, Cat",
    title = "Walter Benjamin and the Remains of a Philosophy of History",
    year = "2016",
    abstract = "Uwe Steiner's Walter Benjamin: An Introduction to His Work and Thought is a comprehensive and compelling account of Walter Benjamin's life and work, which will satisfy both newcomers to Benjamin and those with an existing interest. In this review, I argue that Steiner's account goes beyond similar encounters with Benjamin in two main ways: first, by focusing specifically on Benjamin's personal and intellectual relationship with 'modernity' and, second, by presenting Benjamin's enduring appeal as a result of the creative interpretation of his work according to changing times and tastes. Yet Steiner's historicising account of Benjamin also somewhat neutralises his critical potential as a historical-materialist thinker. Drawing on the work of Benjamin's erstwhile friend and contemporary Ernst Bloch, as well as on Peter Osborne's concept of modernity as a specific consciousness of time, I argue that the act of interpretation itself requires a weakly teleological concept of history, such as we find with Bloch and, between the lines perhaps, also with Steiner's Benjamin.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: A review essay on Uwe Steiner's intellectual biography of Benjamin that argues historicizing accounts of Benjamin risk neutralizing his critical potential as a historical-materialist thinker; drawing on Ernst Bloch and Peter Osborne, Moir contends that any interpretation of Benjamin's afterlife requires a "weakly teleological" concept of history akin to the one Benjamin himself critiqued. RELEVANCE: Offers a self-reflexive assessment of what remains usable in Benjamin's philosophy of history once separated from strict theological or strict materialist orthodoxy, useful for synthesis discussion of how "radical" Benjamin's break with historical materialism's philosophy of history really is. POSITION: A skeptical, Bloch-inflected position questioning whether any account of Benjamin's historical significance can escape the teleological structures his own theses sought to dismantle.},
    keywords = "Benjamin, historiography, Bloch, teleology, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{pensky2010contributions,
    author = "Pensky, Max",
    title = "Contributions toward a Theory of Storms: Historical Knowing and Historical Progress in Kant and Benjamin",
    year = "2010",
    note = {CORE ARGUMENT: Sets Benjamin's ninth thesis on the angel of history and its "storm blowing from Paradise" against Kant's own account of historical knowing and progress, using the juxtaposition to clarify what precisely Benjamin's critique of progress rejects and retains from the Kantian tradition of philosophy of history that also shapes Frankfurt School thought. RELEVANCE: Connects this domain's central image (the angel of history) to the Kantian philosophy-of-history tradition that also informs Horkheimer and Adorno's own critical inheritance, helping to situate Benjamin's break with progress within, rather than simply outside, the broader German philosophical debate over historical knowing. POSITION: A comparative history-of-philosophy treatment that reads Benjamin's anti-progressivism as an internal transformation of, rather than simple rupture with, the Kantian problematic of historical knowledge.},
    keywords = "Benjamin, Kant, progress, angel-of-history, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "There is a picture by Klee called Angelus Novus . It shows an angel who seems about to move away from something he stares at. His eyes are wide, his mouth is open, his wings are spread. This is how the angel of history must look. His face is turned toward the past. Where a chain of events appears before us, he sees one single catastrophe, which keeps piling wreckage upon wreckage and hurls it at his feet. The angel would like to stay, awaken the dead, and make whole what has been smashed. But a storm is blowing from Paradise and has got caught in his wings; it is so strong that the angel can no longer close them. This storm drives him irresistibly into the future, to which his back is turned, while the pile of debris before him grows toward the sky. What we call progress is this storm. 1",
    abstract_source = "openalex"
}

@misc{cook2000criticalstratagems,
    author = "Cook, Deborah",
    title = "Critical Stratagems in Adorno and Habermas: Theories of Ideology and the Ideology of Theory",
    year = "2000",
    note = {CORE ARGUMENT: Cook reconstructs Habermas's claim that Adorno and Horkheimer's confidence in modern culture was shaken so badly by Nazism and Stalinism that their scepticism came to embrace reason itself, forcing ideology critique to become "independent even in relation to its own foundations" and thereby suspect of "not producing truths." Cook contests this reading, arguing that Adorno's theory of ideology retains a coherent, if unorthodox, standard of truth that does not require the discourse-theoretic foundations Habermas demands. RELEVANCE: The earliest of a connected trio of Historical Materialism exchanges (with Finlayson 2003 and Vaki 2005) directly litigating whether Adorno's immanent ideology-critique is self-undermining without Habermasian normative foundations — the technical core of the "philosophy of consciousness" charge. POSITION: Defends Adorno's theory of ideology against the Habermasian charge that it lacks a coherent truth-standard once it turns against reason itself.},
    keywords = "philosophy-of-consciousness, ideology-critique, immanent-critique, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract In one of his many metaphorical turns of phrase – a leitmotif in The Philosophical Discourse of Modernity — Jürgen Habermas speaks of the path not taken by modern philosophers, a path that might have led them towards his own intersubjective notion of communicative reason. Habermas is especially critical of his predecessors, Theodor W. Adorno and Max Horkheimer, because, he believes, they repudiated the rational potential in the culture of modernity. Whenever Adorno and Horkheimer heard the word ‘culture’, they apparently reached for their revolvers. By the 1940s, their confidence in modern culture had allegedly succumbed to bitter disillusionment. Indeed, on Habermas's view, the confidence of these early critical theorists had been shaken so badly by the emergence of Nazism and Stalinism that their scepticism finally embraced reason itself, ‘whose standards ideology critique had found already given in bourgeois ideals’. Consequently, Adorno and Horkheimer were forced to call into question their own immanent critique of modernity: ideology critique itself came ‘under suspicion of not producing (any more) truths’. These philosophers supposedly had little choice but to render their now suspect critique ‘independent even in relation to its own foundations’.",
    abstract_source = "openalex"
}

@misc{finlayson2003theory,
    author = "Finlayson, James Gordon",
    title = "The Theory of Ideology and the Ideology of Theory: Habermas Contra Adorno",
    year = "2003",
    note = "CORE ARGUMENT: An evaluation and qualified defense of Habermas's critique of Adorno's conceptions of ideology and ideology-criticism, arguing that Habermas's diagnosis of a self-undermining totalization of critique retains force against Adorno's theory of ideology even once exaggerations in Habermas's presentation are corrected. RELEVANCE: Provides the pro-Habermas pole of the domain's central internal dispute, directly answering Cook's (2000) and anticipating Vaki's (2005) responses in the same journal, and thus indispensable for representing the debate's full dialectical structure rather than only its Adorno-defending side. POSITION: A qualified defense of Habermas's critique of Adorno's ideology-theory against critics such as Cook.",
    keywords = "philosophy-of-consciousness, ideology-critique, performative-contradiction, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "An evaluation and qualified defense of Habermas's critique of Adorno's conceptions of ideology and ideology criticism.",
    abstract_source = "s2"
}

@misc{vaki2005adornocontra,
    author = "Vaki, Fotini",
    title = "Adorno contra Habermas: The Claims of Critical Theory as Immanent Critique",
    year = "2005",
    note = "CORE ARGUMENT: Vaki closes the Historical Materialism exchange initiated by Cook (2000) and Finlayson (2003) by reasserting, against Habermas, that Adorno's practice of immanent critique constitutes a self-sufficient and defensible model of critical theory that does not require translation into a discourse-theoretic, communicative-rationality framework to secure its normative standing. RELEVANCE: Completes the three-paper Historical Materialism cycle on whether Adorno's ideology-critique/immanent-critique model can stand without Habermasian foundations, giving the domain's key internal dispute its fullest published articulation on the Adorno-defending side. POSITION: A sustained defense of Adorno's immanent-critique model of critical theory against the totalizing/performative-contradiction charge.",
    keywords = "immanent-critique, philosophy-of-consciousness, performative-contradiction, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@article{honneth1979communication,
    author = "Honneth, Axel",
    title = "Communication and Reconciliation: Habermas' Critique of Adorno",
    journal = "Telos",
    year = "1979",
    note = "CORE ARGUMENT: Written shortly after Habermas's critique first crystallized, this early Honneth essay reconstructs the stakes of Habermas's objection to Adorno's model of reconciliation, framing the dispute as one between a communication-theoretic account of intersubjective understanding (Habermas) and Adorno's aesthetically mediated conception of reconciliation with non-identical, mimetic nature. RELEVANCE: The earliest scholarly statement of what would become the domain's central internal dispute, predating and setting terms for the entire Cook–Finlayson–Vaki exchange and for Honneth's own later, more ambivalent positioning between Adorno and Habermas. POSITION: An early, formative statement of the Habermasian critique of Adorno's aesthetic model of reconciliation, written from within the second generation before Honneth's own later partial reconciliation with Adornian themes.",
    keywords = "philosophy-of-consciousness, reconciliation, communicative-rationality, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "Abstract At the time of Adorno's death, Habermas pointed out a methodological bareness in Adorno's work. According to him, Adorno's theoretical veil no longer clothed the methodological skeleton. If one separates content from imagery, Habermas' comment signals a theoretical turn in critical theory from Adorno to Habermas. This is clear in their totally divergent forms of presentation, and especially regarding controversial relations to the tradition. This turn, which is equivalent to a change of paradigm within critical theory, has not hitherto been fully analyzed. It remains unclear which theoretical paths critical theory took as it moved from its early analysis of fascism to Habermas' social theory.",
    abstract_source = "openalex"
}

@misc{merawi2018limits,
    author = "Merawi, Fasil",
    title = "Limits of Critical Theory, Critique and Emancipation in Habermas' Critique of Horkheimer and Adorno",
    year = "2018",
    note = {CORE ARGUMENT: Merawi argues that while Habermas successfully identifies Horkheimer and Adorno's equation of the rational with the instrumental in Dialectic of Enlightenment and offers an emancipatory communicative-rationality model in response, Habermas's own corrective ends up paying insufficient attention to aesthetic truth as a distinct, non-discursive register of critique that Adorno had preserved. RELEVANCE: A synoptic assessment of the costs of Habermas's "solution" to the philosophy-of-consciousness problem, directly engaging the domain's second key question about what later Frankfurt theorists sacrifice in rescuing critical theory from totalized critique. POSITION: A qualified critique of Habermas's own critique, arguing that the communicative turn under-values the aesthetic dimension of Adornian critique that it displaces.},
    keywords = "communicative-rationality, aesthetic-truth, normative-deficit, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Habermas' critical theory is partly an attempt to identify the limitations of critique and emancipation as espoused in the first generation critical theory of Max Horkheimer and Theodor Adorno. In their attempt to develop an interdisciplinary, reflexive, emancipatory and dialectical reason that is critical towards accepted realities, Horkheimer and Adorno in their monumental work The Dialectic of Enlightenment pictured a world trapped in instrumental rationality. Taking and revolutionizing traditional critical theory, Habermas argues that reason entails both emancipator as well as instrumental possibilities. Through an exposition of Habermas' critique of Horkheimer and Adorno in his discourse of modernity, this article argues that although Habermas successfully identifies the equation of the rational with the instrumental and offers an emancipator model in return; still he ends up not paying sufficient attention to aesthetic truth.",
    abstract_source = "s2"
}

@misc{bernstein2017unresolved,
    author = "Bernstein, Richard J.",
    title = "The Unresolved Problems of Late Critical Theory",
    year = "2017",
    note = {CORE ARGUMENT: Reviewing Martin Jay's account of reason's "eclipse" in Western philosophy, Bernstein argues that the first generation of Frankfurt theorists never succeeded in articulating the substantive (Hegelian, Vernunft-like) conception of reason they hankered after and grew increasingly pessimistic as reason appeared to self-destruct; Habermas's communicative-rationality alternative avoids the misleading promises of Hegelian Vernunft but leaves a series of deep, still-unresolved problems about what, if anything, is distinctive about critical theory today. RELEVANCE: Offers a balanced, non-partisan stock-taking of the entire Adorno/Horkheimer-to-Habermas trajectory that neither simply endorses the performative-contradiction charge nor simply defends Adorno, making it a useful synthesis-stage anchor for framing the domain's unresolved status. POSITION: A meta-level assessment concluding that neither the first generation's substantive reason nor Habermas's communicative-rationality alternative has fully resolved the problem of grounding critical theory's normative claims.},
    keywords = "eclipse-of-reason, communicative-rationality, normative-deficit, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT Martin Jay's sweeping account of reason in Western philosophy provides the context for understanding the crisis that the Frankfurt School thinkers faced when they spoke of the “eclipse of reason.” In the background of the thinking of the first generation of Frankfurt thinkers such as Max Horkheimer, Theodor Adorno, and Herbert Marcuse is a hankering for a more substantive conception of reason that bears affinities with what Hegel called Vernunft (reason), which he contrasted with Verstand (understanding). According to Jay, the first generation of Frankfurt thinkers never quite succeeded in elaborating this substantive concept of reason and grew increasingly pessimistic in the face of the self‐destruction of reason. Habermas sought to elaborate a communicative theory of rationality that did not fall into the misleading promises of Hegelian Vernunft but could nevertheless provide a normative basis for the critique of instrumental, strategic, and systems rationality—a normative basis for critical theory. Jay presents an extremely lucid account of Jürgen Habermas's theory of communicative rationality. He concludes by reviewing some of the outstanding problems and questions that have been raised about the adequacy and success of Habermas's project. I seek to do justice to the strengths and weaknesses of Jay's narrative, and I focus on a number of deep, unresolved issues that confront the future of critical theory in its attempt to develop an adequate conception of rationality. I also raise concerns about what precisely is distinctive about critical theory today.",
    abstract_source = "openalex"
}

@misc{albert1985treatise,
    author = "Albert, Hans",
    title = "Treatise on Critical Reason",
    year = "1985",
    note = {CORE ARGUMENT: Writing from critical rationalism (a position adjacent to, though distinct from, analytic philosophy) in the immediate aftermath of the Positivismusstreit, Albert develops critical rationalism as an explicit alternative to Frankfurt School critical theory, hermeneutics (Gadamer), and logical empiricism alike, arguing that Frankfurt School dialectics fails to escape foundationalism without falling into an unacceptable relativism/skepticism about its own normative basis. RELEVANCE: Represents the domain's external, non-Habermasian "normative deficit" charge from outside the Frankfurt tradition altogether, addressing the key question about what "other quarters" (here, German critical rationalism, the closest continental analogue to an analytic-style objection) charge regarding the critique of reason's foundations. POSITION: A rival German post-positivist tradition's rejection of Frankfurt School dialectics as failing to resolve the foundationalism/relativism dilemma it accuses others of falling into.},
    keywords = "critical-rationalism, positivismusstreit, normative-deficit, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{bottomore2002frankfurt,
    author = "Bottomore, Tom",
    title = "The Frankfurt School and its Critics",
    year = "2002",
    note = "CORE ARGUMENT: Bottomore surveys the principal lines of criticism levelled against the Frankfurt School as a whole, discussing the tradition's neglect of history and political economy, its ambivalent relation to the New Left and 1960s radical movements, and its contested standing relative to positivism and structuralism, situating Critical Theory within, and against, the broader landscape of twentieth-century sociological thought. RELEVANCE: Functions as a general reference map of the reception landscape this domain must navigate, cataloguing charges (neglect of political economy, ambivalent radicalism, disputed relation to positivism) that recur across the more specialized papers in this file. POSITION: A synoptic, critical-survey account of the Frankfurt School's reception across sociology and philosophy, written from a broadly sympathetic-but-independent sociological standpoint.",
    keywords = "reception-survey, frankfurt-school-critics, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{wellmer2007adorno,
    author = "Wellmer, Albrecht",
    title = "Adorno and the Problems of a Critical Construction of the Historical Present",
    year = "2007",
    volume = "8",
    note = {CORE ARGUMENT: Wellmer argues that Adorno's method of "rescuing" (rettende) critical constructions of the historical present — reading truth, freedom, justice, and democracy as ideas transcending whatever is empirically given while remaining immanently operative within society — can still be drawn on to renew the original project of critical theory, provided it is decoupled from Adorno's totalizing pessimism about the "administered world." RELEVANCE: Represents the domain's clearest statement of a "rescue" (rather than replacement or abandonment) strategy toward Adorno's negative philosophy of history, directly addressing the second key question about whether and at what cost later Frankfurt theorists preserve Adorno's historical-critical method. POSITION: A second-generation attempt to retain Adorno's method of critically constructing the historical present while jettisoning its most totalizing, pessimistic commitments — a middle path between full Habermasian replacement and unmodified Adornian orthodoxy.},
    keywords = "rescue-strategy, historical-present, critical-construction, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This paper argues that Adorno's metaphysics can be rescued from the constellation of his messianic materialism. The recovery of metaphysics in this context also means that it is rescued as the basis of possible critique. Rescue here entails that the ideas of truth, freedom, justice and democracy should be seen as transcending whatever is empirically given, while remaining immanently operative within society. These ideas can still be drawn on for a critique of the present, thus renewing the original project of critical theory.",
    abstract_source = "openalex"
}

@misc{honneth2009pathologies,
    author = "Honneth, Axel",
    title = "Pathologies of Reason: On the Legacy of Critical Theory",
    year = "2009",
    note = {CORE ARGUMENT: This essay collection includes two chapters central to this domain: "Saving the Sacred with a Philosophy of History," which asks what, if anything, a critical theory can still coherently mean by "philosophy of history" once teleological and totalizing versions are ruled out, and "Dissonances of Communicative Reason: Albrecht Wellmer and Critical Theory," which assesses Wellmer's attempt to secularize Adornian "dissonance" — the irreducible remainder that resists full communicative-rational reconciliation — within a broadly Habermasian framework. Across the collection Honneth argues that critical theory's unifying thread is diagnosing how reason is simultaneously distorted and furthered under capitalist modernity. RELEVANCE: Directly stages both the "rescue" question (what survives of a philosophy of history in critical theory after Habermas) and a critical assessment of Wellmer's own rescue strategy (catalogued separately as Wellmer 2007 in this file), making this collection the domain's key primary source for the generational-transmission debate. POSITION: A third-generation attempt to selectively preserve elements of a critical philosophy of history and to adjudicate between Wellmer's and Habermas's competing ways of accommodating (or dissolving) Adornian "dissonance."},
    keywords = "philosophy-of-history, dissonance, rescue-strategy, communicative-reason, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {In this remarkably subtle volume of essays, Axel Honneth reflects on the tradition of which he is a distinguished contemporary representative, moving between historically guided reflection on systematic issues concerning the form and viability of the project of critical theory and insightful studies of aspects of the work of thinkers who inform this project (Kant and Freud) or directly contribute to it (Adorno, Benjamin, Franz Neumann, Alexander Mitscherlich, Albrecht Wellmer). Given the dialectical character of Honneth's engagement with the tradition of Critical Theory, one should not distinguish sharply between these two activities, and although the essays gathered in this volume can be read as free-standing pieces, they are more valuably engaged as a self-conscious reflection by Honneth on the conditions of his own activity as a Critical Theorist, that is, on the demands of the tradition within which he works and the contemporary requirements of maintaining this tradition. These essays, thus, reflect the working through of the relationship of inheritance and originality within which Honneth's intellectual activity is situated. I will approach this collection initially in terms of the significance of the forms of self-reflection exhibited here for Honneth's own philosophical project (focusing on chapters 2-3 and the appendix) before turning to two more specific aspects, namely, Honneth's concern with psychoanalysis and its relationship to democratic politics (chapters 7-9) and his sympathetic reconstructions of the contemporary import of aspects of Adorno's work (chapters 5-6 with a side glance at chapter 10). In doing so, I will leave aside the opening essay of this volume, 'The Irreducibility of Progress: Kant's account of the relationship between morality and history', which discerns an 'unofficial' argument in Kant which, in contrast to Kant's official arguments concerning our entitlement to a (providential) reconstruction of history as purpose-driven based on the needs of theoretical or practical reason, presents human history as marked by a conflict-ridden learning process which, though often violently interrupted, can never be fully halted. (Honneth is clear that this route pursued by Habermas probably represents the only way in which Kant's philosophy of history can be made relevant for contemporary philosophy, but it is also apparent that Honneth takes this Kantian thesis as a supplement, rather than an alternative, to the basic Hegelian form of Critical Theory's philosophical engagement with history.) I will also leave aside the most historically contextualised essay, 'Saving the Sacred with a Philosophy of History: On Benjamin's "Critique of Violence"', which is perhaps the one chapter that does not appear to play a positive role in relation to Honneth's tack of philosophically reflecting on the history of Critical Theory as a way of locating the requirements placed on his own philosophical activity. The type of philosophical 'working through' exhibited by this collection is itself a feature of Critical Theory's dual inheritance of Hegel and Freud to which Honneth is acutely sensitive. In both cases, we are presented with models of a distinctive form of self-reflective activity in which the activity of recollecting how we have become what we are, motivated by an experience of obscurity or unintelligibility, takes the form of a perspicuous re-articulation of what we are that, when successfully incorporated into one's subjectivity, constitutes the overcoming of the source of obscurity. This distinctive kind of self-reflection is, on Honneth's account, basic to Critical Theory: In contrast to the approaches that have achieved dominance today, Critical Theory must couple the critique of social injustice with an explanation of the processes that obscure that injustice. For only when one can convince the addressees by means of such an explanatory analysis that they can be deceived about the real character of their social conditions can the wrongfulness of those conditions be publicly demonstrated with some prospect of their being accepted. Because a relationship of cause and effect is assumed to obtain between social injustice and the absence of any negative reaction to it, normative criticism in Critical Theory has to be complemented by an element of historical explanation. A historical process of the deformation of reason must causally explain the failure of a rational universal, a failure that constitutes the social pathology of the present. The explanation must at the same time make intelligible the de-thematization of social injustice in public discussion. (p. 30) While this pattern of self-reflection is philosophically initiated by Hegel, its post-Idealist development as Critical Theory is structured through, on the one hand, the appropriation of Marx and Weber (the latter often read through the lens provided by the early Lukacs) and, on the other hand, through Freud, in the tradition that runs from Horkheimer to Habermas and Honneth himself. Yet it should be noted that Honneth's engagement in this process of 'working through' with respect to the tradition of Critical Theory marks a significant difference between the place of such reflection in his work and that of his immediate predecessor in Frankfurt, Habermas, in that Honneth is both a more subtle and sensitive interlocutor of the intellectual inheritance bequeathed to him and through this engagement accomplishes an articulation of the demands placed on the development of this tradition. There is a clear sense here that more is at stake for Honneth's rather more Hegelian understanding of the requirements of his own project in the recuperation of the tradition of Critical Theory than is the case for the more Kantian stance of Habermas. This Hegelian stress emerges again in Chapter 2, 'A Social Pathology of Reason: On the intellectual legacy of Critical Theory', which provides the systematic heart of this volume, when Honneth discusses the conflictual character of the actualisation of reason as a learning process and acknowledges that Habermas 'is the first [of the Frankfurt School theorists] to achieve a systematic breakdown of the various learning processes, an analysis he grounds on the variety of ways in which human beings relate to the world through their linguistic practice.' (p. 32). However, as Honneth immediately notes: the gain in differentiation comes at the cost of no longer being able to consider historical growth in rationality together with those social conflicts which, following Weber's sociology of domination, were more clearly before the eyes of early Critical Theory. In Habermas' work, we find a gulf between the dimension that, for instance, Bourdieu investigated in the cultural formation of monopolies, and rational learning processes -- a gulf whose presence is fundamentally inconsistent with the original concerns of the critical tradition. (p. 32)},
    abstract_source = "ndpr"
}

@misc{deranty2022recognition,
    author = "Deranty, Jean-Philippe",
    title = "Recognition in a Historical Key: Axel Honneth on the History of Recognition and Social Freedom",
    year = "2022",
    note = "CORE ARGUMENT: Examining Honneth's turn to intellectual history in Recognition: A Chapter in the History of European Ideas, Deranty raises critical doubts about three aspects of Honneth's historical narrative — the cultural contexts said to have shaped particular conceptions of recognition, the alleged tying of specific conceptions of recognition to national cultures, and the method of linking meanings of recognition to national traditions — while arguing that, despite these shortcomings, the turn to intellectual history raises productive questions for recognition theory and critical theory more broadly. RELEVANCE: Turns the domain's critical lens back onto Honneth himself, showing that the recognition-theoretic reframing of critical theory's philosophy of history is itself contested on methodological-historiographical grounds, not merely defended wholesale as a successor to Adorno/Habermas. POSITION: An internal, sympathetic-but-critical assessment of Honneth's own historicized recognition theory, questioning the soundness of its intellectual-historical method rather than its normative ambitions as such.",
    keywords = "recognition-theory, honneth, historiography, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Axel Honneth’s philosophical reflections always had significant historical dimensions, but it is only recently, in Recognition. A Chapter in the History of European Ideas, that he has attended to the history of recognition as a concept. This essay examines the cogency and the implications of this turn to intellectual history in the theory of recognition. The first section summarises the main historical claims put forward by Honneth. Section two raises critical doubts regarding three aspects of his narrative: the cultural contexts that are said to have influenced particular conceptions of recognition; the conceptions of recognition that are supposed to be tied to national cultures; and the method of linking particular meanings of recognition to national cultures. The third section broadens the scope and attempts to show why this turn to intellectual history, despite some shortcomings, raises tantalising questions for recognition theory, and beyond it, for critical theory.",
    abstract_source = "s2"
}

@misc{leeb2018liberating,
    author = "Leeb, Claudia and Nichols, Robert and Winter, Yves and Allen, Amy",
    title = "Liberating Critical Theory: Eurocentrism, Normativity, and Capitalism: Symposium on Amy Allen's The End of Progress: Decolonizing the Normative Foundations of Critical Theory, Columbia University Press, 2016",
    year = "2018",
    note = "CORE ARGUMENT: A three-part symposium (with Allen's reply) engaging Amy Allen's argument that Habermas, Honneth, and Forst remain committed to Eurocentric and colonialist notions of progress and historical development despite critical theory's emancipatory self-understanding; Leeb, Nichols, and Winter press Allen on, respectively, capitalism's relative absence from her account, the specificity of settler-colonial versus other colonial histories, and the normative resources her contextualist alternative can and cannot supply. RELEVANCE: Provides sustained, multi-voiced critical engagement with the book (catalogued separately in domains 1 and 3) that is the central catalyst of contemporary Eurocentrism debates in critical theory, letting this domain represent the argument's reception rather than duplicating coverage of the book itself. POSITION: A internally differentiated set of sympathetic-but-pressing critiques of Allen's decolonizing project, each pushing the argument toward political economy, settler-colonial specificity, or firmer normative grounding respectively.",
    keywords = "eurocentrism, decolonial-critique, amy-allen, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In her latest book, The End of Progress, Amy Allen embarks on an ambitious and much needed project: to decolonize contemporary Frankfurt School critical theory.As with all of her books, this is an exceptionally well-written and well-argued book.Allen strives to avoid making assertions without backing them up via close and careful textual reading of the thinkers she engages with.In what follows I will state why this book makes a central contribution to contemporary critical theory (in the wider sense), after which I pose a few questions.These questions are not meant to prove that there are any serious problems with her argumentation.Rather, they are meant in the spirit of dialogue",
    abstract_source = "openalex"
}

@misc{baum2015decolonizing,
    author = "Baum, Bruce",
    title = "Decolonizing Critical Theory",
    year = "2015",
    volume = "22",
    note = {CORE ARGUMENT: Baum argues that Frankfurt School critical theory needs to be decolonized by more directly confronting the constitutive role of colonialism and racial domination in the very formation of modern capitalist societies that critical theory takes as its object, rather than treating colonialism as a peripheral or merely additive concern. RELEVANCE: One of the earliest sustained calls (predating Amy Allen's book by a year) for decolonizing critical theory as such, giving the domain a genealogical marker for when and how the Eurocentrism charge crystallized into an explicit disciplinary project; cited in SEP's "Critical Theory" entry (section 4.1) among the "few recent exceptions" to critical theory's limited engagement with postcolonial and decolonial theory (see sep\_context field). POSITION: An early, foundational statement of the decolonizing-critical-theory project, prior to and anticipating the more extended debate provoked by Allen's End of Progress.},
    keywords = "eurocentrism, decolonial-critique, colonialism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    sep_context = {SEP "Critical Theory" (section 4.1, "Colonialism and Post-colonialism") cites this paper alongside Mendieta 2007, Butler et al. 2011, Ingram 2019, and Kerner 2018 as part of the still-limited body of work in which critical theorists in the Frankfurt tradition have engaged with postcolonial and decolonial theory, noting that "the main target of postcolonial critique is the idea of a universal history in which the central engine of progress is located in modern Europe while non-Europeans are viewed as always lagging behind."}
}

@misc{bhambra2021decolonizing,
    author = "Bhambra, Gurminder K.",
    title = "Decolonizing Critical Theory?",
    year = "2021",
    note = {CORE ARGUMENT: Bhambra argues that "decolonizing" a tradition that has never explicitly acknowledged colonial histories requires more than conceptual revision: it requires recognizing the "colonial modern" — the constitutive role of colonization and slavery in modernity itself — which implicates critical theory's categories of critique and their associated normative claims, not merely its substantive neglect of colonial topics. She concludes that acknowledging colonial histories demands material reparations alongside a transformed understanding she terms "epistemological justice." RELEVANCE: Pushes the domain's Eurocentrism debate further than Allen, Baum, or the Leeb/Nichols/Winter symposium by insisting that critique's own categories (not just its historical narrative of progress) are implicated, and by linking the philosophical critique to concrete demands for reparations — directly engaging the domain's question about the costs of retaining or amending a philosophy of history built on European experience. POSITION: A more radical decolonizing position than Allen's, arguing that critical theory's very categories of critique require transformation, not merely supplementation with postcolonial content, and that epistemic acknowledgment must be accompanied by material reparations.},
    keywords = "eurocentrism, decolonial-critique, colonial-modernity, reparations, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    sep_context = {SEP "Critical Theory" (section 4.1) states that, calling for an even more thorough revision of historical narratives, conceptual frameworks, and normative criteria than Amy Allen, "Gurminder Bhambra (2021) argues that the prevalent understanding of modernity as an endogenous European achievement obscures the fact that colonization and slavery were integral to and constitutive of the Enlightenment project of modernity in both its epistemic and institutional dimensions, a task for which historical and theoretical resources beyond Adorno and Foucault would be required."},
    abstract = {Theorists working within the Frankfurt School tradition of critical theory have not been immune to calls to "decolonize" that have been circulating in and beyond the academic world. This article asks what it means to seek to decolonize a tradition of thought that has never explicitly acknowledged colonial histories. What is needed, instead, this article suggests, is consideration of the very implications of the "colonial modern"—that is, an acknowledgement of the colonial constitution of modernity—for Frankfurt School critical theory's idea of historical progress. The issue is more extensive than simply acknowledging the substantive neglect of colonialism within the tradition; rather, this article suggests that its categories of critique and their associated normative claims are also necessarily implicated by this neglect and require transformation. Acknowledgment of colonial histories requires material reparations for the substantive inequalities bequeathed as legacies of the past, but these reparations also require a transformation of understandings and a recognition of "epistemological justice."},
    abstract_source = "s2"
}

@misc{olson2019decolonizing,
    author = "Olson, Kevin",
    title = "Decolonizing Critical Theory",
    year = "2019",
    note = {CORE ARGUMENT: Olson agrees with Amy Allen's critique of Frankfurt School tendencies toward Eurocentrism, progress-thinking, and historical teleology, but argues that critical theory needs more thorough reconfiguration than Allen's own alternative provides: recent Frankfurt School work displaces critique by working at an overly abstract, paradigmatic meta-level rather than engaging concrete problems, and by relying on democratic procedure for normativity without registering tensions in actual political cultures. He proposes drawing more directly on postcolonial thought's interpretive, non-dogmatic critical strategies. RELEVANCE: Offers a "yes, but not enough" response to Allen's decolonizing project distinct from the Political Theory symposium's angle, specifically diagnosing a methodological retreat into abstraction as the deeper problem behind critical theory's Eurocentrism — relevant to the domain's question about the costs of normative-foundational strategies. POSITION: A sympathetic critic of Allen who argues her decolonizing strategy remains too proceduralist and abstract, calling instead for concrete, interpretive, postcolonially-informed critical practice.},
    keywords = "eurocentrism, decolonial-critique, amy-allen, immanent-critique, Medium, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "This chapter rethinks the future of critical theory by engaging Amy Allen's recent work. Allen does the Frankfurt School a great service by drawing a sharp-edged picture of some significant problems. I aim to think along with her in a spirit of shared sympathies that follow sometimes divergent paths. I agree with Allen's critique of Frankfurt tendencies toward Eurocentrism, progress thinking, and historical teleology. However, I also argue that critical theory must be more thoroughly reconfigured to adequately address the struggles and wishes of our age. Specifically, recent work of the Frankfurt School displaces critique in two important ways. The first is a tendency to work at a paradigmatic, meta-level of analysis rather than focusing on concrete problems. The second is a tendency to rely on democratic procedure for normativity without taking account of the tensions and contradictions in actual political cultures. In place of these uncritical tendencies, we need more interpretive and freely experimental critical strategies. One example is an interpretive approach that problematizes political cultures, revealing the tensions ignored by proceduralism. Another example lies in the rich archives of postcolonial thought that have had such a large impact on contemporary political and social life. Postcolonial critique is a non-dogmatic and flexible form of interpretation that has great potential to address problems of racism, international inequality, and the false universalism of many of our ideals.",
    abstract_source = "s2"
}

@misc{mcarthur2021critical,
    author = "McArthur, Jan",
    title = "Critical theory in a decolonial age",
    year = "2021",
    note = {CORE ARGUMENT: McArthur asks whether Frankfurt School critical theory can retain continuing relevance given its foundations in white, Western traditions bearing colonialism's hallmarks, arguing that even in its early radical figurations critical theory shares Western philosophy's myopic and Eurocentric traits. She proposes a "decolonial conversation" and "third space" methodology as the only basis for genuine engagement between critical theory and Indigenous philosophies, while cautioning against Western scholars simply appropriating Indigenous thought. RELEVANCE: Extends the Eurocentrism critique into a distinct disciplinary register (philosophy of education) and tests it against Indigenous rather than only postcolonial/decolonial theoretical frameworks, broadening the domain's coverage of "other quarters" raising the charge beyond the primarily continental-political-theory literature (Allen, Baum, Bhambra). POSITION: A cautious, methodologically self-reflexive decolonial critic who affirms critical theory's continued relevance only conditional on its explicit acknowledgment of its own Eurocentric shortcomings.},
    keywords = "eurocentrism, decolonial-critique, indigenous-philosophy, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This article considers the critical theory of the Frankfurt School in the context of decolonisation and asks whether it can have continuing relevance given its foundations in white, western traditions which bear the hallmarks of colonialism. Despite critical theory, particularly in its early radical figurations, situating itself as an alternative to traditional western philosophy it undoubtedly shares some of the myopic and Eurocentric traits of this tradition. Mindful of not wishing to perpetuate colonial impulses to appropriate Indigenous philosophies, this article harnesses the twin ideas of a decolonial conversation and interacting in a third space, both of which foreground historical power imbalances and injustices. Only on that basis can a genuine engagement occur between western and Indigenous thought. My aim, as a western scholar, is to explore the relevance of critical theory in this decolonial age. By highlighting intersections, while acknowledging crucial differences, between critical theory and Indigenous philosophies I seek to show that critical theory can play a crucial role in how western scholars respond to and embrace the necessary and compelling movement of decolonialisation, but only first by acknowledging their own shortcomings, particularly in relation to race, racism and colonialism.",
    abstract_source = "s2"
}

@misc{torres2025criticaltheory,
    author = "Torres, Esteban",
    title = "Critical Theory in Transition: From Eurocentrism to Postcolonial World Society",
    year = "2025",
    note = "CORE ARGUMENT: Torres examines the institutional shift in direction of the Frankfurt School's Institute for Social Research following Stephan Lessenich's 2021 appointment as director, arguing that Lessenich's substantive critique of Eurocentrism embedded in the Frankfurt tradition represents the ascent to institutional prominence, in the Global North academy, of a critique of Eurocentrism whose emergence and expansion Torres traces through three earlier phases in Western social science. RELEVANCE: Documents that the Eurocentrism critique addressed by the domain's other entries is no longer merely an external or academic-symposium-level challenge but has become institutionally consequential at the Frankfurt Institute itself, evidencing how far and how recently the reception debate has moved. POSITION: A historically and institutionally grounded account of how the Eurocentrism critique moved from marginal to institutionally central within the Frankfurt School's own home institute.",
    keywords = "eurocentrism, institutional-history, frankfurt-institute, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT This article examines the shift in direction of the Frankfurt School following Stephan Lessenich's appointment as director of the Institute for Social Research (IfS) in 2021. A key innovation introduced by the current research program at the IfS is a substantive critique of the Eurocentrism embedded in the Frankfurt tradition. The heterodox impulse championed by Lessenich can be situated within the broader evolution of the critique of Eurocentrism in Western social sciences. This evolution comprises three phases: emergence (i), expansion (ii), and ascent to prominence in academia in the Global North (iii). Then, the article explores the underlying causes of the significant resistance to moving away from a Eurocentric framework. This study proposes that Lessenich's intellectual leadership is guiding the Frankfurt School toward a paradigm shift, which is taking shape through the development of a new vision of society that incorporates the intellectual traditions and historical realities of the Global South.",
    abstract_source = "s2"
}

@misc{biskamp2025provincializing,
    author = "Biskamp, Floris",
    title = "Provincializing Frankfurt: A Postcolonial Rereading of Habermasian Theory",
    year = "2025",
    volume = "33",
    note = {CORE ARGUMENT: Biskamp extends the postcolonial critique specifically to Habermasian critical theory (rather than to Adorno/Horkheimer or to critical theory generally), applying Dipesh Chakrabarty's "provincializing" strategy to show how Habermas's own account of communicative rationality and post-metaphysical reason carries unexamined Eurocentric assumptions about historical development that need to be relativized rather than treated as universally available correctives to the earlier generation's totalizing critique. RELEVANCE: Closes the domain's loop between the internal Habermasian critique of Adorno (which claims to supply a non-Eurocentric normative foundation via communicative rationality) and the postcolonial charge that this claimed universality is itself a Eurocentric artifact — directly bearing on whether Habermas's "solution" to the performative-contradiction problem escapes or merely relocates the universal-history residue. POSITION: A postcolonial critique aimed specifically at Habermas's communicative-rationality alternative, arguing it inherits rather than resolves critical theory's Eurocentric universal-history assumptions.},
    keywords = "eurocentrism, habermas, postcolonial-critique, communicative-rationality, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{allen2025fromnormative,
    author = "Allen, Amy and McNay, Lois and Bufkin, Sarah and Dyson, Emily",
    title = "From normative foundations to emancipatory futures: a conversation about Critical Theory today",
    year = "2025",
    note = "CORE ARGUMENT: In this roundtable, Allen, McNay, Bufkin, and Dyson debate the limitations of contemporary Frankfurt School theorizing for diagnosing social suffering and gesturing toward emancipatory practices, arguing that the turn toward metanormative-foundational questions (of the kind Habermas's and Honneth's programs exemplify) has come at the cost of concrete, sociologically grounded analysis of power and oppression; they explicitly address the marginalization of gender hierarchies, the theorist's own positionality relative to existing struggles, the Marxist legacy, and Eurocentrism/racism within critical theory. RELEVANCE: A self-consciously contemporary (2025) stock-taking that ties together the domain's Habermasian-normative-deficit and Eurocentrism clusters, asking directly whether the normative-foundations project inaugurated by Habermas's response to Adorno has been worth its costs — a fitting closing synthesis point for the domain. POSITION: A collectively skeptical, multi-perspectival reassessment of whether critical theory's post-Habermasian turn to normative foundations has strengthened or weakened its diagnostic and emancipatory power.",
    keywords = "normative-foundations, emancipation, eurocentrism, contemporary-reassessment, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT In this roundtable discussion, Amy Allen, Lois McNay, Sarah Bufkin, and Emily Dyson debate the limitations of contemporary Frankfurt School theorizing when it comes to diagnosing social suffering and gesturing towards emancipatory practices that might shift the relations of force in today's social formations. In particular, they consider what has been lost in the turn to questions of metanormative foundations in place of a concrete, sociologically grounded analysis of power and oppression. In this wide-ranging conversation, Allen, McNay, Bufkin, and Dyson also engage with a range of questions confronting Critical Theorists today, including the marginalization of gender hierarchies and patriarchal domination as problems, the positionality of the theorist with respect to existing struggles, the Marxist legacy of the Frankfurt School, the problems of Eurocentrism and racism within Critical Theory, and the role of the aesthetic in social critique.",
    abstract_source = "s2"
}

