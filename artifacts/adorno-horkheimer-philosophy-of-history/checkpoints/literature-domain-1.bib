@misc{horkheimeradorno2002dialectic,
    author = "Horkheimer, Max and Adorno, Theodor W.",
    title = "Dialectic of Enlightenment: Philosophical Fragments",
    year = "2020",
    doi = "10.1515/9780804788090",
    note = {CORE ARGUMENT: The primary text of this domain. Horkheimer and Adorno argue that Western reason, from prehistoric mimetic ritual through the historical Enlightenment to twentieth-century mass culture, is entwined with the myth it claims to have superseded: "myth is already enlightenment, and enlightenment reverts to mythology." The Odyssey excursus reads Homer's epic as the "basic text" of the prehistory of subjectivity, in which self-preservation through sacrifice and renunciation constitutes both the domination of external nature and the domination (mutilation) of inner nature. The culture industry and antisemitism chapters extend this genealogy into industrial capitalism and fascism as instances of enlightenment's "self-destruction." RELEVANCE: This is the target text of the entire domain; all other entries in this file are interpretive or critical engagements with its historical-philosophical argument. POSITION: Founding text of the entwinement thesis; genealogical philosophy of history combining Marxian, Nietzschean, Weberian, and psychoanalytic elements.},
    keywords = "primary-text, entwinement-thesis, instrumental-reason, Odyssey-excursus, High, METADATA\_CLEANED: publisher, year:2002->2020, type:@book->@misc",
    abstract = "Dialectic of Enlightenment is, quite justifiably, one of the most celebrated and often cited works of modern social philosophy. It has been identified as the keystone of the 'Frankfurt School', of which Theodor Adorno and Max Horkheimer were the leading members, and does not cease to impress in its wide-ranging ambition and panache. Adorno and Horkheimer addressees themselves to a question which went to the very heart of the modern age, namely 'why mankind, instead of entering into a truly human condition, is sinking into a new kind of barbarism'. Modernity, far from redeeming the promises and hopes of the Enlightenment, had resulted in a stultification of mankind and an administered society, characterised by simulation and candy-floss entertainment. To seek an answer to the question of how such a condition could arise, Adorno and Horkheier subjected the whole history of Western catagories of reason and nature, from Homer to Nietzsche, to a searching philosophical and psychological critique. Drawing on psychoanalytical insights, their own work on the 'culture industry', deep knowledge of the key Enlightenment and anti-Enlightenment thinkers, as well as fascinating considerations on the relationship between reason and myth - the rational and the irrational - the authors exposed the domination and violence towards both nature and humanity that underpin the Enlightenment project.",
    abstract_source = "s2"
}

@misc{habermas1987philosophical,
    author = "Habermas, Jürgen",
    title = "The Philosophical Discourse of Modernity: Twelve Lectures",
    year = "1987",
    note = {CORE ARGUMENT: Habermas's lecture "The Entwinement of Myth and Enlightenment" argues that Dialectic of Enlightenment levels a totalizing critique of reason that performatively contradicts itself: the book "denounces the Enlightenment's becoming totalitarian with its own tools," yet, having conflated instrumental rationality with rationality as such and rationality with power, it is left without normative grounds for its own critique and can only "practice determinate negation on an ad hoc basis." Habermas's own theory of communicative rationality, oriented toward mutual understanding, is offered as the corrective. RELEVANCE: Inaugurates the central reception debate over whether the book's historical narrative is self-undermining (a "performative contradiction") or whether, as later defenders argue, its aporetic structure is deliberate. Nearly every subsequent paper in this file (Allen, Honneth, Hulatt, Evans, Freyenhagen) responds directly or indirectly to this charge. POSITION: The canonical external critique of Dialectic of Enlightenment as normatively self-defeating totalized critique. sep\_context: SEP "Theodor W. Adorno" (section 3, Dialectic of Enlightenment) quotes Habermas directly: "it denounces the Enlightenment's becoming totalitarian with its own tools. Adorno was quite aware of this performative contradiction [...] inherent in totalized critique" (1987, 119); practicing "a critique that attacks the presuppositions of its own validity," the book's arguments have no "ultimate groundings" or "normative foundations" and must "therefore eschew theory and practice determinate negation on an ad hoc basis" (1987, 128-129).},
    keywords = "performative-contradiction, normative-deficit, reception-debate, High, INCOMPLETE, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{allen2014reason,
    author = "Allen, Amy",
    title = "Reason, power and history",
    journal = "Thesis Eleven",
    year = "2014",
    volume = "120",
    pages = "10--25",
    doi = "10.1177/0725513613519588",
    note = {CORE ARGUMENT: Allen re-reads Dialectic of Enlightenment against the Habermasian charge of performative contradiction, arguing that the book's "aporia" and deliberate ambivalence about enlightenment are not a failure of theoretical grounding but a considered stance: the text encourages readers to remain "as mindful of the dangers of enlightenment as we are of our commitment to it." She situates this within her broader project (The End of Progress) of decolonizing critical theory's normative foundations. RELEVANCE: Directly addresses whether the book's historical narrative is fatalistic/totalizing or retains critical purchase, arguing for the latter by reinterpreting the function of aporia in the text's philosophy of history. POSITION: Defends the entwinement thesis's aporetic structure against the performative-contradiction critique; aligned with attempts to preserve emancipatory resources within a seemingly totalizing narrative. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "More recently, Allen resists the claim of performative contradiction, emphasizing that the 'aporia' and ambivalence at the heart of the book encourages us to remain 'as mindful of the dangers of enlightenment as we are of our commitment to it' (2014, 22)."},
    keywords = "entwinement-thesis, aporia, normative-deficit-debate, High, METADATA\_CLEANED: number",
    abstract = "This paper re-examines the relationship between power, reason and history in Horkheimer and Adorno’s Dialectic of Enlightenment. Contesting Habermas’ highly influential reading of the text, I argue that Dialectic of Enlightenment, far from being a dead-end for critical theory, opens up important lines of thought in the philosophy of history that contemporary critical theorists would do well to recover. My focus is on the relationship that Horkheimer and Adorno trace between enlightenment rationality and the domination of inner and outer nature.",
    abstract_source = "openalex"
}

@article{comay2000adornos,
    author = "Comay, Rebecca",
    title = "Adorno's Siren Song",
    journal = "New German Critique",
    year = "2000",
    doi = "10.2307/488544",
    note = {CORE ARGUMENT: Comay offers a close reading of the Sirens episode in the Odyssey excursus, arguing that Odysseus's cunning self-binding exemplifies the book's thesis that reason can only assert itself as domination of an alien nature inseparable from self-domination that becomes self-mutilation. The subject who frees himself from bondage to the Other (the Sirens' song) unleashes an "endless ritual of sado-masochistic bondage games" turned against himself; reason becomes unreason at its own limit. RELEVANCE: A sustained close reading of exactly the passage the domain specifies (the Odyssey excursus) as the site where the genealogy of the self functions as historical explanation of the domination of inner and outer nature. POSITION: Interpretive/exegetical contribution focused on the psychoanalytic and rhetorical texture of the excursus rather than on the Habermasian normative debate.},
    keywords = "Odyssey-excursus, genealogy-of-subject, domination-of-nature, High, METADATA\_CLEANED: number, pages",
    abstract = "Excursus on an Excursus In a lengthy excursus or appendix to the first chapter of the Dialectic of Enlightenment - a detour in a book which constitutes itself essentially as an extended patchwork of such appendages - Adorno reads Homer's Odyssey as an allegory of the dialectic of enlightenment. Odysseus himself would be the quintessential figure of homo oeconomicus, his voyage an extended business trip, his passions the usual affairs men fall into when they have a devoted wife at home. So domesticated is Odysseus's wanderlust, so conventional his calculations, that Adorno indeed reads the ancient epic as a modem novel, the bourgeois genre par excellence.1 In his reading of the Sirens episode Adorno reckons sharply just what the costs of Odysseus's enlightenment might be. If reason can only assert itself as the domination of an alien nature, this is in turn inseparable from a self-domination which becomes self-mutilation at its extreme. Reason becomes unreason when pushed to its conclusion: the attempt to free oneself from external bondage to the Other unleashes an endless ritual of sado-masochistic bondage games in which the subject has himself tied up tight. In the face of the Sirens' singing - a voice of nature, a voice of pleasure, a voice of the past, and, yes, a voice of women - both the danger and the solution would be extreme. The Sirens are not the",
    abstract_source = "openalex"
}

@misc{honneth2000possibility,
    author = "Honneth, Axel",
    title = "The Possibility of a Disclosing Critique of Society: The Dialectic of Enlightenment in Light of Current Debates in Social Criticism",
    year = "2000",
    note = {CORE ARGUMENT: Honneth argues that Dialectic of Enlightenment should be understood not as an argumentative or foundationalist critique but as a "disclosing critique" that deploys rhetorical means — narration, myth, chiasmus, exaggeration — "in order to evoke a new way of seeing the social world." This reframes the book's mode of historical argument as world-disclosing rather than propositionally grounded, sidestepping the demand for normative foundations that drives the Habermasian objection. RELEVANCE: Offers an influential alternative account of what kind of "philosophy of history" the book is — not a causal-explanatory or normatively grounded narrative but a disclosive one — directly bearing on the domain's first key question about the scope and status of the historical narrative. POSITION: Positions itself between Habermas's critique and full endorsement of the book's totalizing rhetoric, proposing a third way of reading its historical claims as disclosive rather than argumentative. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "Honneth interprets the text as a disclosive critique that uses rhetorical means (narration, myth, chiasmus, exaggeration, etc.) 'in order to evoke a new way of seeing the social world' (2000, 124), an approach extended by Freyenhagen's (2024) reading of the text as a fictional performance, rather than merely critical description, of the defining aporias of modernity's self-understanding."},
    keywords = "disclosing-critique, historical-narrative-status, reception-debate, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{noppen2012reflective,
    author = "Noppen, Pierre-François",
    title = "Reflective Rationality and the Claim of Dialectic of Enlightenment",
    year = "2012",
    note = {CORE ARGUMENT: Noppen interprets Dialectic of Enlightenment as preparing, but not yet elaborating, a "positive concept of enlightenment" that would liberate reason from its entanglement in blind domination. On this reading the book is best understood as a propaedeutic and diagnostic work — establishing the pathology of instrumental/identity-thinking reason — rather than as offering a completed normative theory, which qualifies both the totalizing reading and the demand (per Habermas) that it supply full normative grounding. RELEVANCE: Bears directly on the domain's question of the scope and status of the book's historical narrative: is it a completed philosophy of history or an incomplete, preparatory diagnostic gesture toward one? POSITION: Intermediate position between totalizing-fatalist readings and fully reconstructive (Honneth/Allen-style) defenses; treats the book as unfinished rather than either self-refuting or covertly complete. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "Noppen (2012) interprets the text as preparation for, but not yet elaboration of, a positive concept of enlightenment, and Zuidervaart (2007, chap.4) urges distinctions in the scope of domination and exploitation invoked in the text."},
    keywords = "reflective-rationality, historical-narrative-status, positive-concept-of-enlightenment, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract That something is profoundly wrong with the way in which enlightenment has unfolded has widely been taken to be the main thrust of D ialectic of E nlightenment . In this paper, I propose to defend that to understand the book and shed light on some of its most puzzling features, one should rather take H orkheimer and A dorno's critical claim at face value: through their criticism they contend to have prepared a positive concept of enlightenment. How this can be so is the question I want to answer. I defend that what we need is an account that works out the conceptual grounds on which their critique can operate. The focus of my attempt will consist in understanding (1) what they mean when they assert that rationality is intrinsically social and (2) how they conceive of rationality as being reflective at its core.",
    abstract_source = "openalex"
}

@article{rabinbach2000why,
    author = "Rabinbach, Anson",
    title = "Why Were the Jews Sacrificed?: The Place of Anti-Semitism in Dialectic of Enlightenment",
    journal = "New German Critique",
    year = "2000",
    note = {CORE ARGUMENT: Rabinbach examines how the "Elements of Anti-Semitism" excursus fits within the book's larger historical-anthropological argument, arguing that Horkheimer and Adorno treat antisemitism not as contingent political pathology but as an outgrowth of the same historical dialectic of self-preservation, false projection, and domination of nature traced throughout the book — the persecuted Jew comes to symbolize what has escaped total self-reification ("happiness without power, reward without work"). RELEVANCE: Addresses how far the book's historical explanation extends — from prehistoric myth to twentieth-century genocide — and thus bears on the domain's question of whether the narrative is transhistorical/universal or tied to specific historical conjunctures (Nazism). POSITION: Historicizes the antisemitism chapter within the book's genealogical method rather than treating it as a separable empirical excursus. sep\_context: SEP "Theodor W. Adorno" (section 4, Social Psychology) cites this work directly: "the image of the Jew suggests what has partly escaped self-reification: 'happiness without power, reward without work, a homeland without frontiers, religion without myth' (ibid., 164-5; Jay 1980; Rabinbach 2000)."},
    keywords = "antisemitism, historical-scope, genealogy, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "The penultimate section of Dialectic of Enlightenment, of Anti-Semitism was composed in the summer of 1943, four years after work on the book had begun, and after all the other sections were completed. As was the case with the first chapter, the Elements were a collaborative enterprise. Leo Liwenthal contributed to the first three theses, and it is likely that the remaining three, and certainly the fifth and most original thesis on idiosyncrasy and mimesis, were jointly dictated by Horkheimer and Adorno in July 1943.1 The seventh thesis, added in 1947, was solely the work of Horkheimer. Not initially intended for the volume published in 1944, the Elements are usually described as theoretical elaborations destined for the Institute for Social Research's anti-Semitism project begun in 1939 and announced in the 1941 issue of the Institute's journal.2 In mid-1943 the anti-Semitism project took on renewed importance when the institute was entrusted by the Jewish Labor Committee to conduct a massive study of American labor's attitudes towards Jews. The following year, the American Jewish Committee selected Horkheimer as its Director of Scientific Research and launched an ambitious program culminating in the five part Studies in Prejudice series published in 1949 and",
    abstract_source = "openalex"
}

@misc{hulatt2016reason,
    author = "Hulatt, Owen",
    title = "Reason, Mimesis, and Self-Preservation in Adorno",
    year = "2016",
    note = {CORE ARGUMENT: Hulatt challenges readings of Dialectic of Enlightenment's genealogy as a simple, internally driven development from mimesis to instrumental rationality. He argues instead for a tripartite conflict among mimesis, rationality, and self-preservation as an independent controlling/ordering principle — a conflict that is only partially relaxed in bourgeois autonomous art's later incorporation of mimetic comportment. RELEVANCE: Directly revises how the domain's central genealogical narrative (myth to instrumental reason via self-preservation) should be reconstructed, complicating any simple linear or two-term account of the entwinement thesis. POSITION: A structural/interpretive intervention into how the book's genealogy of reason should be modeled, arguing for three interacting terms rather than two. sep\_context: SEP "Theodor W. Adorno" (section 3) states: "Hulatt (2016a) interprets the book's genealogy not as an internally driven development from mimesis to instrumental rationality but rather as a more complex, tripartite conflict between mimesis, rationality, but also self-preservation as a controlling and ordering principle, which ultimately is relaxed in bourgeois autonomous art's incorporation of mimesis."},
    keywords = "mimesis, self-preservation, genealogy-of-reason, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In this paper I argue that Adorno’s narrative of mimesis’s development is best understood as not produced by a simple opposition between mimesis and reason, but rather a tri-partite conflict between mimesis, self-preservation, and reason. I develop this account with special reference to Roger Caillois, whose identification of mimesis with an organic drive toward passivity orthogonal to self-preservation had great influence on Adorno’s own conception of mimesis. I show that Adorno sees mimesis as, at the outset, a raw impulse toward inaction and dissolution, which shares much in common with Freud’s death drive (a connection Adorno himself notes). Drawing on this, I argue that Adorno’s narrative of the development of mimetic behavior (in relation to magic, reason, and the artwork) is not driven solely by tendencies intrinsic to mimesis. Rather, it is the intensifying conflict between mimesis and the controlling and ordering principle of self-preservation that drives the formation of increasingly spiritualized forms of abstraction. This gives us cause to revise our understanding of Adorno’s account of magical praxis and rationality, and the relationship between them. Finally, this allows me to recast Adorno’s claim that the artwork becomes a “refuge” for mimesis. I argue that this should not be understood, as it often is, in terms of a flat antagonism between mimesis and reason. Rather, the artwork becomes a refuge for mimesis as a consequence of self-preservation’s socio-epistemic intolerance of mimetic forms of behavior in virtually all realms of society save for a privileged few exceptions, art being the most notable of these.",
    abstract_source = "openalex"
}

@article{stone2014adorno,
    author = "Stone, Alison",
    title = "Adorno, Hegel, and Dialectic",
    journal = "British Journal for the History of Philosophy",
    year = "2014",
    volume = "22",
    pages = "1118--1141",
    doi = "10.1080/09608788.2014.952264",
    note = {CORE ARGUMENT: Stone argues that Adorno's allegiance to Hegel's dialectic is visible precisely in the dialectical process, traced in Dialectic of Enlightenment, whereby enlightenment reverts to myth and human domination over nature reverts into domination by nature. Adorno nonetheless breaks with Hegel by criticizing dialectic itself as the ultimate form of "identity thinking," and, against Habermas, Stone contends Adorno can consistently criticize enlightenment's practice of critique because he reshapes rather than abandons Hegelian dialectical reconciliation (co-existing differences rather than unification). RELEVANCE: Clarifies the formal, dialectical logic underlying the entwinement thesis and directly rebuts the Habermasian consistency objection, bearing on the domain's second key question about how the entwinement of myth and enlightenment should be understood. POSITION: Locates Dialectic of Enlightenment's historical dialectic within (and against) the Hegelian tradition, defending its internal consistency against Habermas.},
    keywords = "Hegelian-dialectic, identity-thinking, entwinement-thesis, Medium, METADATA\_CLEANED: number",
    abstract = "This article explores critical theory's relations to German idealism by clarifying how Adorno's thought relates to Hegel's. Adorno's apparently mixed responses to Hegel centre on the dialectic and actually form a coherent whole. In his Logic, Hegel outlines the dialectical process by which categories – fundamental forms of thought and reality – necessarily follow one another in three stages: abstraction, dialectic proper, and the speculative (famously simplified as ‘thesis, antithesis, synthesis’). Adorno's allegiance to Hegel's dialectic emerges when he traces the dialectical process whereby enlightenment reverts to myth and human domination over nature reverts into our domination by nature. However, Adorno criticizes Hegel's dialectic as the ultimate form of ‘identity thinking’, subsuming unique, material objects under universal concepts by using dialectical reason to expand those concepts to cover objects utterly. These two responses cohere because Adorno shares Hegel's view that dialectical contradictions require reconciliation, but differs from Hegel on the nature of reconciliation. For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences. Finally, against Habermas who holds that Adorno cannot consistently criticize the enlightenment practice of critique, I show that Adorno can do so consistently because of how he reshapes Hegelian dialectic.",
    abstract_source = "openalex"
}

@article{nelson2011revisiting,
    author = "Nelson, Eric S.",
    title = "Revisiting the Dialectic of Environment: Nature as Ideology and Ethics in Adorno and the Frankfurt School",
    journal = "Telos",
    year = "2011",
    doi = "10.3817/0611155105",
    note = {CORE ARGUMENT: Nelson reconsiders the domination-of-nature thesis across Adorno's and the Frankfurt School's work, arguing that "nature" functions doubly as ideology critique (unmasking naturalizing legitimations of domination) and as an ethical category (registering what is lost or repressed in the domination of outer and inner nature), and that these two functions are not always well distinguished in Dialectic of Enlightenment and its reception. RELEVANCE: Engages directly with the domain's third key question — how the account of domination of outer and inner nature functions as historical explanation — by disambiguating distinct senses of "nature" operative in the book's genealogy. POSITION: Critical-reconstructive reading that presses for greater conceptual precision in the domination-of-nature thesis rather than either endorsing or rejecting it wholesale.},
    keywords = "domination-of-nature, ideology-critique, ethics-of-nature, Medium, METADATA\_CLEANED: volume, number, pages",
    abstract = "International audience",
    abstract_source = "openalex"
}

@article{bermingham2018seductress,
    author = "Bermingham, Katherine C.",
    title = "Seductress, Storyteller, and Subject",
    journal = "New German Critique",
    year = "2018",
    doi = "10.1215/0094033x-4269886",
    note = "CORE ARGUMENT: Bermingham argues that Helen of Argos and Troy, though conspicuously absent from Horkheimer and Adorno's Odyssey excursus and from prior feminist commentary on it, is central to the excursus's thesis about the emergence of bourgeois subjectivity: as much as Odysseus, Helen exhibits the incipient features of an individuated and alienated protobourgeois subject, revealing that Horkheimer and Adorno undertheorize women's experience of subjectivity, which explains her exclusion from their analysis. RELEVANCE: Extends the domain's account of the Odyssey excursus as genealogy of the self by identifying a structural gap (gendered subjectivity) in Horkheimer and Adorno's historical narrative of subject-formation. POSITION: Feminist immanent critique of the Odyssey excursus that supplements rather than rejects the entwinement thesis's account of subject formation.",
    keywords = "Odyssey-excursus, gender, genealogy-of-subject, Medium, METADATA\_CLEANED: volume, number, pages",
    abstract = "Max Horkheimer and Theodor Adorno’s Dialectic of Enlightenment laid indispensable groundwork for critiquing instrumental rationality and the power dynamics embedded in discursive logic. Especially relevant for feminist theorists is the pair’s excursus on Homer’s Odyssey, which reads the hero’s epic journey as an allegory for the emergence of subjectivity. Horkheimer and Adorno interpret Homer’s female characters as sensual forces of nature that Odysseus must resist in his quest for homecoming. Yet, conspicuously absent from Horkheimer and Adorno’s analysis—and previous feminist commentaries on their analysis—is Homer’s paragon of feminine sensuality: Helen of Argos and Troy. This article rereads the treacherous beauty through Horkheimer and Adorno’s critical perspective, arguing that despite Helen’s exclusion from the text of Dialectic of Enlightenment, she is central to its thesis. As much as the poem’s eponymous hero, Helen exhibits the incipient features of an individuated (and alienated) protobourgeois subject. Ultimately, this article contends that Horkheimer and Adorno undertheorize women’s experience of subjectivity, which seems to explain why they exclude Helen from their analysis.",
    abstract_source = "openalex"
}

@misc{kent2024semblance,
    author = "Kent, James",
    title = "A semblance of freedom: Horkheimer and Adorno's conception of myth",
    year = "2024",
    volume = "52",
    pages = "3--22",
    doi = "10.1177/01914537241284718",
    note = "CORE ARGUMENT: Kent argues that the pessimistic reading of Dialectic of Enlightenment — on which reason remains ensconced within the domination of myth — misses that myth also functions as an incomplete but largely untapped mediator of human experience via language, and thus as a promising source of rational self-knowledge. Drawing on Hulatt's account of the mimesis/self-preservation tension, Kent contends myth's linguistic mediation between a community of speakers and their violent, ambiguous pasts offers momentary reflections of relinquished possibilities of life, presenting a renewed chance of enlightenment. RELEVANCE: Directly addresses the domain's fourth key question — whether the book's account is fatalistic/totalizing — by locating emancipatory potential within the very concept of myth that the entwinement thesis treats as already enlightenment. POSITION: Anti-fatalist reconstruction of the myth/enlightenment relation, building on Hulatt's tripartite model to recover critical resources from myth itself.",
    keywords = "myth, emancipatory-potential, fatalism-debate, High, METADATA\_CLEANED: journal, number, type:@article->@misc",
    abstract = "In this paper I argue that the pessimistic reading of Horkheimer and Adorno’s Dialectic of Enlightenment, which suggests reason is ensconced within the domination of myth, misses a key component of the authors' argument. Specifically, it misses the possibility that the liberation from the heteronomy of myth might occur via a critique of myth. Using Owen Hulatt’s reinterpretation of Adorno’s account of the tension between mimesis and self-preservation as a point of orientation, I show that while myth for Horkheimer and Adorno is synonymous with a heteronomous form of life, they simultaneously recognize it as an incomplete but largely untapped mediator of the history of human experience (via language), and thus a promising source of rational self-knowledge. Specifically, myth can illuminate fragments of both the contingent factors that led to human sociality becoming entwined with domination, while also offering momentary reflections of the kinds of life that were relinquished in the drive for instrumentalised survival. I propose that for Horkheimer and Adorno it is myth’s linguistic mediation between a community of speakers and their (often violent and ambiguous) pasts that is unique. It is thus myth’s capacity to offer a meditation on those other possibilities of human existence that presents a renewed chance of enlightenment.",
    abstract_source = "s2"
}

@article{allen2024odysseus,
    author = "Allen, William S.",
    title = "Odysseus and Adorno: A Note on Cunning and Dialectics",
    journal = "New German Critique",
    year = "2024",
    doi = "10.1215/0094033x-11309158",
    note = {CORE ARGUMENT: W. S. Allen argues that readings of Odysseus in the excursus as merely a prototype of bourgeois instrumental reason fail to grasp the full breadth of the dialectic of myth and enlightenment, overlooking the role of Odysseus's cunning (metis). Cunning, Allen contends, is itself a form of mimetic intelligence bearing its own internal dialectic, with implications for how Adorno's later work on non-identity should be understood. RELEVANCE: Refines the domain's account of the Odyssey excursus as genealogy of the self by distinguishing cunning/mimetic intelligence from bare instrumental calculation within Odysseus's characterization. POSITION: Revisionist reading of the excursus against the standard "instrumental-reason prototype" interpretation of Odysseus.},
    keywords = "Odyssey-excursus, cunning, mimesis, Medium, METADATA\_CLEANED: volume, number, pages",
    abstract = "The reading of the Odysseus excursus in Dialektik der Aufklärung has been hampered by the insistence that the character of Odysseus is merely a prototype of bourgeois instrumental reason. However, this characterization fails to grasp the full breadth of the dialectic of myth and enlightenment, and overlooks the significant role played by Odysseus’s cunning in the development of reason. In addressing these problems, it becomes apparent that cunning is a form of mimetic intelligence and bears its own form of dialectic, which has implications for the understanding of Adorno’s later works.",
    abstract_source = "s2"
}

@misc{freyenhagen2024why,
    author = "Freyenhagen, Fabian",
    title = "Why Professor Habermas Would Fail a Class on Dialectic of Enlightenment",
    year = "2024",
    note = {CORE ARGUMENT: Using a polemical thought-experiment (would Habermas's own essay on the book pass as coursework in a class on it?), Freyenhagen critically dissects Habermas's "Entwinement of Myth and Enlightenment" and its pivotal role in repositioning Critical Theory in the 1980s. He sketches an alternative reading of Dialectic of Enlightenment as a self-therapeutic exercise in destabilizing a complacent self-conception of modernity as moral progress, rather than as the theoretical dead end Habermas presents it to be. RELEVANCE: A direct, sustained rejoinder to the Habermasian performative-contradiction critique that anchors the domain's fourth key question about fatalism and remaining critical purchase, proposing that the book performs rather than argues its critique. POSITION: Anti-Habermasian reconstruction; treats the book's aporetic, non-argumentative form as a deliberate philosophical strategy rather than a defect, aligned with Honneth's disclosive-critique reading but framed as direct rebuttal.},
    keywords = "Habermas-critique, self-therapeutic-reading, reception-debate, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Would Habermas’s “The Entwinement of Myth and Enlightenment” pass muster as coursework in a class on Dialectic of Enlightenment? Using this polemical thought experiment setup as an estrangement device, I critically discuss Habermas’s essay that was pivotal in his repositioning of Critical Theory in the 1980s. I argue that it is philosophically and biographically unreflective; and that he is engaging in underhanded politicking. I sketch an alternative reading of Dialectic of Enlightenment: instead of viewing it as the dead end that Habermas presents it to be, we can see as a self-therapeutical exercise in destabilizing a complacent self-conception whereby modernity is the pinnacle of moral progress—an exercise which might have a certain exemplarity for others in the ongoing quest of making use of our own understanding. The contribution is rounded off with a postscript by a second assessor of Habermas’s essay, discussing both the proposed assessment and the polemical thought experiment.",
    abstract_source = "s2"
}

@misc{setiya2023human,
    author = "Setiya, Kieran",
    title = "Human nature, history, and the limits of critique",
    year = "2023",
    volume = "32",
    abstract = {This essay defends a form of ethical naturalism in which ethical knowledge is explained by human nature. Human nature, here, is not the essence of the species but its natural history as socially and historically determined. The argument does not lead to social relativism, but it does place limits on the scope of ethical critique. As society becomes "total", critique can only be immanent; to this extent, Adorno and the Frankfurt School are right.},
    note = {CORE ARGUMENT: Setiya defends an ethical naturalism on which human nature is not a fixed species-essence but a socially and historically determined "natural history." This does not entail social relativism but does limit the scope of ethical critique: once society becomes "total," critique can only proceed immanently — a limitation Setiya credits Adorno and the Frankfurt School with correctly identifying. RELEVANCE: Engages the domain's question of the scope and status of the historical narrative from outside Critical Theory, testing whether Adorno's totality thesis and immanent-critique methodology hold up as a general philosophical claim about the limits of critique under conditions of social totalization. POSITION: Sympathetic but independent (analytic ethical-naturalist) endorsement of the Frankfurt School's immanent-critique constraint, rather than an internal exegesis of Dialectic of Enlightenment.},
    keywords = "immanent-critique, totality, ethical-naturalism, natural-history, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{wankhammer2024nature,
    author = "Wankhammer, Johannes",
    title = {The Nature of Critique: Revisiting Adorno's "Natural History" amid the Postcritique Debates},
    journal = "New German Critique",
    year = "2024",
    abstract = {This article revisits Adorno's concept of "natural history" to propose an alternative to the exhausted paradigm of denaturalizing critique. As Jonathan Crary's work on the ruination of sleep illustrates, the reflex to denounce natural limits as ideological constructs falls short when it comes to confronting social pathologies wrought by late capitalism's demand for infinite flexibility. Since its Enlightenment origins, however, critical thought has tended to attack natural limits as illegitimate barriers to human self-determination, even before this strategy became, with Nietzsche, the sole rationale behind denaturalizing critique. By contrast, Adorno's concept of natural history offers a profound (if long-overlooked) self-critique of critique's one-sided reliance on denaturalization: it suggests how it is possible to harness natural limits as levers for emancipatory transformation rather than blindly calling for the transformation of given limits. Pace Adorno, such natural-historical critique may clarify emerging forms of political praxis, especially those fighting for environmental justice.},
    note = {CORE ARGUMENT: Wankhammer recovers Adorno's early concept of "natural history" (Naturgeschichte, from the 1932 lecture "The Idea of Natural History," foundational to the historical-anthropological method later deployed in Dialectic of Enlightenment) as an alternative to critique's habitual denaturalization strategy. Natural history proposes that nature and history are not opposed but mutually constitutive categories: nature appears as historically sedimented, and history appears as a kind of second nature — a methodological move that underwrites the book's genealogy of reason. RELEVANCE: Bears directly on the domain's first key question — the scope and status of the book's historical narrative — by tracing its methodological roots to the natural-history concept, clarifying in what sense the narrative is neither purely universal-transhistorical nor purely contingent-empirical but dialectically both. POSITION: Methodological/genealogical reconstruction of Adorno's philosophy of history via the natural-history concept, applied to contemporary "postcritique" debates.},
    keywords = "natural-history, historical-narrative-status, method, High, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{oconnor2008adorno,
    author = "O'Connor, Brian",
    editor = "Cook, Deborah",
    title = "Adorno: Philosophy of History",
    year = "2008",
    address = "Durham, UK",
    abstract = "The concept of history was developed in a great array of directions during the period of Modern German Philosophy. Ranging from macrostructural analyses of the evolution of civilizations to descriptions of the temporal social experience of the individual it was essentially a critical concept, one which would seek to expose the allegedly naive idea of the fixed properties of culture and of the individuals who might live within them. Adorno belongs to this tradition of critical historical philosophy. His philosophy of history is strongly marked by various Hegelian, Marxian, Nietzschean and hermeneutical ideas. A preoccupation with the idea of history is evident from the very beginnings of Adorno's career. From his Habilitationsschrift (1931) right up to Aesthetic Theory (incomplete at the time of his death in 1969) the issue is never far from central. To deal comprehensively with the range of influences and the multiplicity of applications of the concept of history in Adorno's work would be co-extensive with a critical analysis of his oeuvre. What this chapter will restrict itself to is Adorno's engagements with what might be specifically regarded as 'theories of history.' The topics to be examined are Adorno's critique of (1) the idea of universal history and (2) of progress, (3) his dialectical reading of the idea of natural history, and (4) his assessment of role of the totality in the production of history.",
    note = {CORE ARGUMENT: O'Connor surveys Adorno's engagement with theories of history proper, organized around four topics: the critique of universal history, the critique of progress, the dialectical reading of natural history, and the role of totality in the production of history. He situates Dialectic of Enlightenment's genealogy within this broader, Hegelian-Marxian-Nietzschean-hermeneutical constellation running from Adorno's 1931 Habilitationsschrift through to Aesthetic Theory. RELEVANCE: Addresses the domain's first key question — in what sense the book is a "philosophy of history" and what the scope of its narrative is (universal, transhistorical, or ad hoc) — as its explicit and sole topic, distinguishing Adorno's critique of universal history from his critique of progress and from his use of natural history and totality. POSITION: Synoptic overview essay establishing the conceptual vocabulary (universal history, progress, natural history, totality) subsequently used by more specialized studies in this domain (e.g., Wankhammer, Setiya).},
    keywords = "philosophy-of-history, universal-history, progress, totality, High, METADATA\_CLEANED: booktitle, publisher, type:@incollection->@misc"
}

@misc{evans2020dialectic,
    author = "Evans, Justin",
    title = "The Dialectic of Enlightenment as parody of anti-enlightenment thought",
    year = "2020",
    note = "CORE ARGUMENT: Evans proposes reading Dialectic of Enlightenment as, in part, a parody of anti-enlightenment thought (of the kind found in Spengler, Klages, and related cultural-pessimist traditions) rather than as itself an instance of straightforward cultural pessimism. On this reading, the book's rhetorical excess and totalizing pronouncements are deliberately styled to mimic and thereby undercut anti-enlightenment rhetoric from within. RELEVANCE: Bears on the domain's fourth key question — whether the book's account is fatalistic/totalizing — by proposing a genre-based explanation (parody) for its bleak rhetorical register that would defuse charges of straightforward cultural pessimism. POSITION: A distinctive, genre/rhetoric-focused alternative to both the Habermasian totalizing-critique reading and the disclosive-critique (Honneth) reading.",
    keywords = "parody, cultural-pessimism, rhetoric, fatalism-debate, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The Dialectic of Enlightenment is a book of paradoxes. The most commonly noted is summed up in the book’s preface: “enlightenmentrevertstomythology”(Horkheimer\&Adorno,2002,p.xviii/6). 1 Progressbecomesregression,civilization ends in barbarism. A focus on this paradox suggests that the book is a critique of enlightenment thinking, which will be always and forever dominating. A second paradox often receives less attention: enlightenment itself is not enlightened. 2 Myargumentisthatthisparadoxiscentraltothetext,andthatitshould,infact,bestatedmorestrongly: only enlightenment is not yet enlightened. This conclusion is warranted by two arguments. In the first, the Dialectic of Enlightenment shows that enlightenment is mythical—not enlightened—in the sense that it is taken as a given that human beings must simply accept, rather than subjecting it to critique. In the second, the book shows that any non or anti-enlightenment thought is already enlightened, in the sense that they are entangled with enlightenment practices, social forms, or concepts. This second argument is made through parodies of anti-enlightenment ideas that were common through the first half of the 20th century. Seen in this light, The Dialectic of Enlightenment is at least as much a parodic critique of anti-enlightenment thought as it is a criticism of enlightenment as we know it. I begin by summing up the intellectual atmosphere in which Horkheimer and Adorno wrote Dialectic of Enlighten-ment ,notingsomeattemptstofindother-than-enlightenmentfoundationsforcritique.Next,Idiscussimportantinter-pretations of the book’s attitude towards enlightenment, before describing the authors’ systematically ambiguous use of the term as both totalitarian and emancipatory. I then",
    abstract_source = "s2"
}

@article{foster2001dialectic,
    author = "Foster, Roger",
    title = "Dialectic of Enlightenment as Genealogy Critique",
    journal = "Telos",
    year = "2001",
    note = {CORE ARGUMENT: Foster reads Dialectic of Enlightenment as a genealogical critique in a broadly Nietzschean-Foucauldian sense: rather than offering a linear causal history or a normatively grounded argument, the book traces the contingent, power-laden emergence of instrumental rationality and the modern subject, exposing the historical costs (domination of nature, renunciation, sacrifice) concealed within reason's self-understanding as progress. RELEVANCE: Directly addresses the domain's first key question by classifying the book's mode of historical argument as genealogy critique — distinct from causal historiography and from Hegelian teleological history — and thus offers a methodological account of the "scope and status" of the historical narrative. POSITION: Situates Dialectic of Enlightenment within the genealogical tradition of historical critique (Nietzsche, later Foucault) rather than within either Hegelian dialectical history or empirical social history.},
    keywords = "genealogy, method, historical-narrative-status, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages"
}
