@misc{lowy2005firealarm,
    author = "Löwy, Michael",
    title = "Fire Alarm: Reading Walter Benjamin's 'On the Concept of History'",
    year = "2005",
    address = "London and New York",
    note = {CORE ARGUMENT: A line-by-line commentary on Benjamin's theses "On the Concept of History," reading them as a "fire alarm" sounded against both fascism and the complacent, evolutionist Marxism of the Second International and Social Democracy. Löwy stresses the theses' fusion of Jewish messianism and revolutionary materialism, arguing that Benjamin's "weak messianic power" names a collective, this-worldly capacity for interruption rather than a transcendent redeemer, and that the "tradition of the oppressed" is meant to displace the historicist narrative of inevitable progress. RELEVANCE: Provides the fullest close reading of the primary text at the center of this domain and is the natural reference point for any synthesis discussion of Jetztzeit, the angel of history, and weak messianic power; its emphasis on the anti-progressivist and anti-conformist political stakes of the theses supplies the sharpest contrast case against Horkheimer and Adorno's own more skeptical philosophy of history. POSITION: Represents the materialist-messianic reading that treats theology and historical materialism in Benjamin as mutually constitutive rather than opposed.},
    keywords = "Benjamin, theses-on-history, weak-messianic-power, historical-materialism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{wolin1994aesthetic,
    author = "Wolin, Richard",
    title = "Walter Benjamin: An Aesthetic of Redemption",
    year = "1994",
    address = "Berkeley and Los Angeles",
    note = {CORE ARGUMENT: A synthetic intellectual study tracing the development of Benjamin's thought from the early theological-linguistic writings through the Trauerspiel book to the late theses, arguing that a redemptive, quasi-theological impulse persists across Benjamin's ostensibly more "materialist" later phases and that this impulse is what most sharply distinguishes his position from orthodox historical materialism. RELEVANCE: Establishes the case, contested by more strictly materialist readings (Tiedemann, Khatib), that Benjamin's philosophy of history cannot be fully secularized without losing its critical force; this framing is central to assessing how far Adorno and Horkheimer's own philosophy of history retains or expels this redemptive-theological residue. POSITION: Represents the "theological continuity" reading of Benjamin against interpretations that see a decisive break toward historical materialism in his later work.},
    keywords = "Benjamin, redemption, theology, aesthetic-theory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{buckmorss1977origins,
    author = "Buck-Morss, Susan",
    title = "The Origin of Negative Dialectics: Theodor W. Adorno, Walter Benjamin, and the Frankfurt Institute",
    year = "1977",
    address = "Hassocks",
    note = "CORE ARGUMENT: Reconstructs the intellectual formation of Adorno's negative dialectics through his sustained engagement with Benjamin, arguing that Adorno's mature philosophical method — including his approach to history, constellation, and the non-identical — cannot be understood apart from his decade-long dialogue, collaboration, and disagreement with Benjamin within and around the Institute for Social Research. RELEVANCE: Directly documents the institutional and intellectual mechanics of the relationship this domain investigates, including the material conditions (Institute funding, editorial control) that shaped how Benjamin's ideas were transmitted into and transformed by Adorno's own philosophy of history. POSITION: A foundational account of Adorno's dependence on and departure from Benjamin, treating negative dialectics itself as partly a working-through of Benjaminian materials.",
    keywords = "Adorno, Benjamin, negative-dialectics, Frankfurt-Institute, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{buckmorss1989dialectics,
    author = "Buck-Morss, Susan",
    title = "The Dialectics of Seeing: Walter Benjamin and the Arcades Project",
    year = "1989",
    address = "Cambridge, MA and London",
    note = {CORE ARGUMENT: A reconstruction of the unfinished Arcades Project as Benjamin's attempt to realize a "dialectics of seeing": a materialist historiography built from the montage of concrete historical images (the arcades, the flâneur, fashion, the commodity) rather than narrative argument, in which nineteenth-century Paris becomes legible as the "prehistory" of the present. RELEVANCE: Provides the fullest secondary account of the constellational/montage method named in this domain's brief, and documents Adorno's criticisms of the 1935 Exposé (the "Hornberg letter") that crystallized the dispute over whether dialectical images require explicit conceptual and economic mediation. POSITION: Sympathetic reconstruction of Benjamin's own historiographic method, read partly against Adorno's demand for more systematic mediation.},
    keywords = "Benjamin, arcades-project, dialectical-image, montage, historiography, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{pensky2001melancholy,
    author = "Pensky, Max",
    title = "Melancholy Dialectics: Walter Benjamin and the Play of Mourning",
    year = "2001",
    address = "Amherst",
    note = {CORE ARGUMENT: Argues that Benjamin's mature theory of "redemptive criticism" is best understood as a sustained working-through of melancholia, in which the allegorical, ruin-obsessed sensibility first theorized in the Trauerspiel book becomes, in the Arcades Project and the late theses, the affective and formal basis for a materialist historiography that redeems the discarded and forgotten rather than narrating triumphant progress. RELEVANCE: Connects this domain's concern with redemption of the past to Benjamin's earlier melancholic/allegorical thought, offering a bridge to the separate Natural History domain and clarifying why Adorno, in his own writing on history, retained an affinity for images of ruin and petrification while resisting Benjamin's more affirmative claims about redemption. POSITION: A psychoanalytically and rhetorically inflected reading that treats melancholia, rather than theology per se, as the generative core of Benjamin's philosophy of history.},
    keywords = "Benjamin, melancholy, redemption, allegory, mourning, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{comay1999perverse,
    author = "Comay, Rebecca",
    title = "Perverse History: Fetishism and Dialectic in Walter Benjamin",
    year = "1999",
    note = {CORE ARGUMENT: Examines the relationship between Benjamin's account of commodity fetishism and his dialectical historiography, arguing that Benjamin's method deliberately courts a "perverse" relation to history — one that reproduces, rather than simply diagnoses, the fetishistic freezing of time it seeks to interrupt — and asks what this means for the dialectical status of the dialectical image. RELEVANCE: Sharpens this domain's central methodological question about whether Benjamin's montage-historiography is genuinely dialectical or merely juxtapositional, a question that is precisely what motivated Adorno's objections to the Arcades exposé. POSITION: A close, deconstructively-inflected reading that complicates any simple opposition between Benjamin's "immediate" dialectical images and Adorno's demand for mediated dialectic.},
    keywords = "Benjamin, fetishism, dialectical-image, historiography, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{tiedemann1983historical,
    author = "Tiedemann, R.",
    editor = "Smith, Gary",
    title = {Historical Materialism or Political Messianism? An Interpretation of the Theses "On the Concept of History"},
    year = "1989",
    address = "Chicago and London",
    note = {CORE ARGUMENT: Poses directly the question that structures decades of Benjamin reception: whether "On the Concept of History" should be read as a work of historical materialism using messianic language as rhetorical scaffolding, or as a fundamentally theological-political text using Marxist vocabulary as camouflage. Tiedemann, writing from within the circle of Benjamin's literary executors, argues for the priority of the materialist reading while acknowledging the irreducibility of the theses' theological imagery. RELEVANCE: This essay is the canonical statement of the interpretive dilemma this domain is built around, and its "historical materialism or political messianism" framing is explicitly cited (per the SEP entry on Benjamin, section 9) as the polemical legacy of the competing Scholem/Brecht/Adorno influences on Benjamin's reception. POSITION: Argues for the primacy of the materialist reading, positioning itself against Scholem's more strongly theological interpretation and implicitly against Wolin's later "aesthetic of redemption" thesis.},
    keywords = "Benjamin, historical-materialism, messianism, theses-on-history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc"
}

@misc{beardsworth2005benjamin,
    author = "Beardsworth, Sara",
    title = "Benjamin, Horkheimer, and Adorno: Modes of Historical Reflection and the Problem of Authoritative Statements",
    year = "2005",
    abstract = "The paper considers what united and divided Benjamin and Horkheimer-Adorno in terms of their respective confrontations with the question of what it is to articulate the past historically. It presents their shared self-consciousness of the difficult task of responding critically to a problem conceived of as the entanglement of the concept of history with domination. For the problem imbues conceptualization itself and therefore threatens the value of the authoritative statements made in their own critical reflection on it. I show that these thinkers necessarily respond to the problem in confrontation with specific historical contexts: fascism, Soviet communism, German social democracy, and liberal democracy. The challenge they face is how to metabolize thinking in the midst of tendencies that disable it. I compare Benjamin's solution, the dialectical image, with Horkheimer and Adorno's solution, the recovery of critical reflection through the fragmentary writing of Dialectic of Enlightenment.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Directly compares Benjamin's dialectical image with Horkheimer and Adorno's fragmentary method in Dialectic of Enlightenment as two distinct solutions to a shared problem: how to make authoritative critical statements about history once the concept of history itself is understood to be entangled with domination. Both responses are read as historically situated confrontations with fascism, Stalinism, and the failures of social democracy and liberalism. RELEVANCE: This is the most direct treatment found of this domain's fourth key question — whether the Adorno-Horkheimer philosophy of history is a transformation of Benjaminian messianism — arguing that Dialectic of Enlightenment's fragmentary form is itself a structural analogue to, and departure from, Benjamin's dialectical image. POSITION: A comparative reading that treats Benjamin and Horkheimer/Adorno as parallel rather than simply derivative responses to the crisis of historical narration.",
    keywords = "Benjamin, Horkheimer, Adorno, dialectical-image, Dialectic-of-Enlightenment, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{bohn2019historiography,
    author = "Bohn, Charlotte Odilia",
    title = "Historiography and Remembrance: On Walter Benjamin's Concept of Eingedenken",
    year = "2019",
    abstract = {Engaging with Walter Benjamin's concept of Eingedenken (remembrance), this article explores the pivotal role that remembrance plays in his attempt to develop a radically new vision of history, temporality, and human agency. Building on his essay "On Some Motifs in Baudelaire" and on his last written text, "Theses on the Philosophy of History", it will trace how memory and historiography are brought together in a curious fusion of materialist and messianic thinking. Emerging from a critique of modernity and its ideology of progress that is cast as crisis—the practice of remembrance promises a 'way out'. Many of Benjamin's secular Marxist critics such as Max Horkheimer and Rolf Tiedemann, however, denied the political significance of Eingedenken—dismissing it as theological or banishing it to the realm of aesthetics. Rejecting this critique, I suggest that the radical ethical aspects of Eingedenken can be grasped only once the theological dimension is embraced in its own right and that it is in precisely this blend of materialist and messianic thought that revolutionary hope may be found.},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Argues that Benjamin's concept of Eingedenken (remembrance) fuses materialist and messianic thinking into a distinctive practice for interrupting the ideology of progress, and directly rebuts Horkheimer's and Tiedemann's dismissal of Eingedenken as merely theological or aesthetic rather than politically significant. RELEVANCE: Provides explicit documentation of Horkheimer's own critical distance from Benjamin's theological categories, giving this domain a concrete textual basis for assessing how the Frankfurt School's "secularized" philosophy of history related to and resisted Benjaminian messianism. POSITION: A revisionist defense of the theological dimension of Eingedenken against the secularizing critiques associated with Horkheimer and Tiedemann.},
    keywords = "Benjamin, Eingedenken, remembrance, Horkheimer, theology, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{recoder2019adornos,
    author = "Recoder, Luis A.",
    title = "Adorno's Arcades Orthodoxy",
    year = "2019",
    volume = "3",
    note = {CORE ARGUMENT: Reexamines Adorno's editorial and critical interventions into Benjamin's Arcades Project, arguing that Adorno's insistence on rigorous dialectical mediation functioned as a kind of methodological "orthodoxy" that Benjamin's own practice of montage historiography persistently exceeded or resisted. RELEVANCE: Bears directly on this domain's question of the substantive disagreements between Adorno and Benjamin over dialectical images and mediation, treating Adorno's posthumous editorial authority over Benjamin's texts as itself part of the methodological dispute. POSITION: Critical of Adorno's mediation requirement as a normalizing "orthodoxy" imposed on Benjamin's more heterodox historiographic practice.},
    keywords = "Adorno, Benjamin, arcades-project, dialectical-image, mediation, Medium, METADATA\_CLEANED: journal, number, pages, type:@article->@misc",
    abstract = "Theodor W. Adorno’s letter correspondence with Walter Benjamin throughout the decade of the 1930’s entertains the central question concerning the possibility of philosophy in their intellectual milieu. The fate of this possibility for Adorno hinges on Benjamin’s work-in-progress Das Passagen-Werk—a fate that is catastrophically blocked by an uncritical tendency convicted repeatedly by the former as “undialectical.” And yet Adorno obstinately persists in clinging to the canon of a philosophically overdetermined demand he endearingly calls “my Arcades orthodoxy.” The threatening destruction of the aura of this orthodoxy reaches a crisis in Adorno’s ruthless metacritique of Benjamin’s alleged undialectical treatment of aesthetic autonomy in a draft of the Kunstwerk essay, marking a critical wound in the correspondence which the following exposition tracks in the enigmatic changeover in the philosophical exigency of the said orthodoxy from prima philosophia to ultima philosophia. The lingering wound is registered in Adorno’s late philosophical work",
    abstract_source = "core"
}

@misc{feldman2011notdialectical,
    author = "Feldman, Karen S.",
    title = "Not Dialectical Enough: On Benjamin, Adorno, and Autonomous Critique",
    year = "2011",
    abstract = "With respect to Benjamin's treatments of the work of art and his historiographical method, Adorno accuses Benjamin of not being dialectical enough and of inadequate theorizing. This article argues that Adorno's blanket prescription for more dialectics covers over a chiastic relationship between his particular concern in each case. On one hand, Adorno worries that Benjamin gives over the artwork to ideological narratives. On the other hand, Adorno is concerned that Benjamin's historical materialism refuses historical narrative, which is precisely where Benjamin locates ideology. Indeed the disruptive potential that Adorno grants the artwork with respect to social and political ideology thus corresponds to the disruptive potential that Benjamin ascribes to his historical materialism with respect to historicist ideology. In this context the article considers the nature of autonomy for Benjamin and Adorno and its relationship to subversion, disruption, and redemption.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Shows that Adorno's recurring charge that Benjamin is "not dialectical enough" is internally chiastic: Adorno faults Benjamin's aesthetics for surrendering the artwork to ideology while faulting his historiography for refusing historical narrative altogether — precisely where Benjamin locates ideology's operation. Feldman argues both objections trade on divergent, only partly compatible conceptions of autonomy, subversion, and redemption. RELEVANCE: Offers the most precise articulation available in this domain's literature of the exact structure of Adorno's methodological complaint against Benjamin's historiography, making it essential for characterizing the substantive stakes of the mediation dispute. POSITION: A close analytic dissection of Adorno's critique that resists simply taking either Adorno's or Benjamin's side, instead showing the disagreement's internal structure.},
    keywords = "Adorno, Benjamin, dialectic, autonomy, critique, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{khatib2017wherethepast,
    author = "Khatib, Sami",
    title = "Where the Past Was, There History Shall Be",
    year = "2017",
    abstract = {As the proverb has it, 'tradition is not to preserve the ashes but to pass on the flame'. Taking this image as a starting point, this paper is interested in non-conservative concepts of tradition and (dis)continuity. If the concept of tradition is normally associated with continuity, the concept of tradition poses the question of transmittability. Is there a continuous medium in which narrations, customs, rites or other material practices can be handed down from the past to the present? If the transmittability of tradition is not a given, a commodified object, but subject to historical change, the question of tradition and inheritance is inextricably linked to social and political struggles. The concept of tradition, however, has mostly been theorized by conservative thinkers. In this vein, traditional historical materialism viewed tradition as a counter-progressive retarding force. Walter Benjamin (1940), however, proposed a different concept of historical time and tradition. History is not based on a progressive flow of "homogeneous, empty time" but on disruptive constellations of the present and the past. The past is never fully gone; it can never be fully historicized. The medium in which the present is connected to all lost causes and struggles of those who literally and metaphorically lost their histories is called the "tradition of the oppressed." Paradoxically, this medium is a discontinuum -- its texture is woven out of struggles, empty-spots and disconnected elements which cannot be represented in one transmittable image or inscribed into one multifaceted yet coherent world-history. If the "tradition of all dead generations weighs like a nightmare on the brains of the living" (Marx), then the tradition of the oppressed will also haunt all attempts to repress it completely and erase its experience in the linear continuum of "victor's history." But how are we to pass on an oppressed tradition? How can the tradition of the oppressed be recalled, actualized and "worked through"?},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Reconstructs Benjamin's "tradition of the oppressed" as a non-conservative, discontinuous concept of tradition that breaks with both traditional historical materialism's view of tradition as a retarding force and with the "homogeneous, empty time" of historicism, arguing that the tradition of the oppressed cannot be represented as one coherent world-history but only as a discontinuum of struggles and empty spots. RELEVANCE: Clarifies exactly how radical Benjamin's break with orthodox historical materialism's philosophy of history is, directly bearing on this domain's first key question, and gives conceptual precision to the "constellational" alternative to progressive historiography. POSITION: A contemporary materialist re-reading that treats Benjamin's philosophy of history as a heterodox extension, rather than rejection, of historical materialism.},
    keywords = "Benjamin, tradition-of-the-oppressed, historical-materialism, homogeneous-empty-time, Medium, METADATA\_CLEANED: journal, doi, type:@article->@misc"
}

@article{brittain2010politicaltheology,
    author = "Brittain, Christopher Craig",
    title = "Political Theology at a Standstill: Adorno and Agamben on the Messianic",
    journal = "Thesis Eleven",
    year = "2010",
    abstract = "This essay explores the use of the concept of the messianic by Giorgio Agamben and Theodor Adorno. Throughout his work, Agamben consistently presents his reading of the messianic as an alternative to what he considers to be the 'pessimistic' negative dialectics of Adorno, which he argues 'is an absolutely non-messianic form of thought'. For Agamben, the messianic brings dialectics to a 'standstill'. This essay analyzes this deployment of the 'messianic' in his thought, and contrasts it with the perspective of Adorno. Agamben's interpretation of Walter Benjamin is challenged with reference to a debate between Adorno and Benjamin over theology, dialectics, and politics.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Contests Agamben's claim that Adorno's negative dialectics is "absolutely non-messianic," arguing instead that Adorno's relation to the messianic is one of cautious, dialectically mediated retention rather than outright rejection, and uses the original Adorno-Benjamin debate over theology, dialectics, and politics to correct Agamben's reading of Benjamin. RELEVANCE: Bears directly on this domain's second key question about how Adorno's cautious retention of messianic figures (as in the closing aphorism of Minima Moralia) relates to Benjamin's "weak messianic power," using Agamben's later appropriation as a foil to sharpen the contrast between Adorno's and Benjamin's positions. POSITION: Defends Adorno against Agamben's characterization, arguing for a dialectically mediated rather than eliminated messianism in Adorno's thought.},
    keywords = "Adorno, Agamben, Benjamin, messianic, political-theology, Medium, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{moir2016walterbenjamin,
    author = "Moir, Cat",
    title = "Walter Benjamin and the Remains of a Philosophy of History",
    year = "2016",
    abstract = "Uwe Steiner's Walter Benjamin: An Introduction to His Work and Thought is a comprehensive and compelling account of Walter Benjamin's life and work, which will satisfy both newcomers to Benjamin and those with an existing interest. In this review, I argue that Steiner's account goes beyond similar encounters with Benjamin in two main ways: first, by focusing specifically on Benjamin's personal and intellectual relationship with 'modernity' and, second, by presenting Benjamin's enduring appeal as a result of the creative interpretation of his work according to changing times and tastes. Yet Steiner's historicising account of Benjamin also somewhat neutralises his critical potential as a historical-materialist thinker. Drawing on the work of Benjamin's erstwhile friend and contemporary Ernst Bloch, as well as on Peter Osborne's concept of modernity as a specific consciousness of time, I argue that the act of interpretation itself requires a weakly teleological concept of history, such as we find with Bloch and, between the lines perhaps, also with Steiner's Benjamin.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: A review essay on Uwe Steiner's intellectual biography of Benjamin that argues historicizing accounts of Benjamin risk neutralizing his critical potential as a historical-materialist thinker; drawing on Ernst Bloch and Peter Osborne, Moir contends that any interpretation of Benjamin's afterlife requires a "weakly teleological" concept of history akin to the one Benjamin himself critiqued. RELEVANCE: Offers a self-reflexive assessment of what remains usable in Benjamin's philosophy of history once separated from strict theological or strict materialist orthodoxy, useful for synthesis discussion of how "radical" Benjamin's break with historical materialism's philosophy of history really is. POSITION: A skeptical, Bloch-inflected position questioning whether any account of Benjamin's historical significance can escape the teleological structures his own theses sought to dismantle.},
    keywords = "Benjamin, historiography, Bloch, teleology, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{pensky2010contributions,
    author = "Pensky, Max",
    title = "Contributions toward a Theory of Storms: Historical Knowing and Historical Progress in Kant and Benjamin",
    year = "2010",
    note = {CORE ARGUMENT: Sets Benjamin's ninth thesis on the angel of history and its "storm blowing from Paradise" against Kant's own account of historical knowing and progress, using the juxtaposition to clarify what precisely Benjamin's critique of progress rejects and retains from the Kantian tradition of philosophy of history that also shapes Frankfurt School thought. RELEVANCE: Connects this domain's central image (the angel of history) to the Kantian philosophy-of-history tradition that also informs Horkheimer and Adorno's own critical inheritance, helping to situate Benjamin's break with progress within, rather than simply outside, the broader German philosophical debate over historical knowing. POSITION: A comparative history-of-philosophy treatment that reads Benjamin's anti-progressivism as an internal transformation of, rather than simple rupture with, the Kantian problematic of historical knowledge.},
    keywords = "Benjamin, Kant, progress, angel-of-history, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "There is a picture by Klee called Angelus Novus . It shows an angel who seems about to move away from something he stares at. His eyes are wide, his mouth is open, his wings are spread. This is how the angel of history must look. His face is turned toward the past. Where a chain of events appears before us, he sees one single catastrophe, which keeps piling wreckage upon wreckage and hurls it at his feet. The angel would like to stay, awaken the dead, and make whole what has been smashed. But a storm is blowing from Paradise and has got caught in his wings; it is so strong that the angel can no longer close them. This storm drives him irresistibly into the future, to which his back is turned, while the pile of debris before him grows toward the sky. What we call progress is this storm. 1",
    abstract_source = "openalex"
}
