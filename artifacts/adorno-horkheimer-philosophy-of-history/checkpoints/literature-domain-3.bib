@article{frelek2025hope,
    author = "Frelek, Andrzej",
    title = "Hope in a Warming World: Rereading Adorno on Progress",
    journal = "New German Critique",
    year = "2025",
    volume = "52",
    note = {CORE ARGUMENT: Rereads Adorno's 1962 essay "Progress" against the horizon of the climate crisis, retracing his analysis of the relation between history and catastrophe (itself indebted to Benjamin), situating the concept of progress within the historical genealogy of philosophies of progress and their theological inheritance, and focusing on Adorno's critical reworking of progress in relation to the dialectic of freedom and unfreedom. RELEVANCE: Provides a close, argument-level reconstruction of the "Progress" essay's central moves and extends its non-affirmative, non-nihilistic treatment of progress to a contemporary "new catastrophe" (climate breakdown), directly addressing how Adorno holds progress and catastrophe together without collapsing one into the other. POSITION: A recuperative, "negative hope" reading that treats Adorno's dialectical concept of progress as still actionable rather than merely diagnostic.},
    keywords = "progress, catastrophe, climate-crisis, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "This article argues for the value inherent in rereading Theodor Adorno’s 1962 essay “Progress,” placing his thoughts in the context of the climate crisis and arguing for the necessity of retaining a form of negative hope in critical theory. First, the article retraces his analysis of the relation between history and catastrophe, itself indebted to the writings of Walter Benjamin. Second, the article shows how Adorno relates the aforementioned idea to the historical genealogy of philosophies of progress and their theological inheritance. Third, the article focuses on his critical reworking of the concept of progress and its relation to the dialectic of freedom and unfreedom. Finally, the article attempts to place Adorno’s ideas in the context of the dangers posed by the climate crisis, showing that his thought remains extremely relevant to the present historical situation.",
    abstract_source = "s2"
}

@article{burdman2020auschwitz,
    author = "Burdman, Javier",
    title = "'After Auschwitz': Writing History After Injustice in Adorno and Lyotard",
    journal = "Contemporary Political Theory",
    year = "2020",
    doi = "10.1057/s41296-020-00456-8",
    note = {CORE ARGUMENT: Compares how Adorno and Lyotard each reconceive the writing of history in the wake of Auschwitz and historical injustice, examining what it means to narrate or theorize history once a founding, unrepresentable wrong has occurred. RELEVANCE: Bears directly on the status of universal/continuous history "after Auschwitz," juxtaposing Adorno's negative-dialectical response with Lyotard's differend-based alternative, and clarifying what is distinctive in Adorno's continued (negative) retention of a universal-historical framework rather than its outright abandonment. POSITION: A comparative reading situating Adorno within a broader post-Holocaust reckoning with the writing of history, alongside Lyotard's postmodern critique of grand narratives.},
    keywords = "Auschwitz, universal-history, Lyotard, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages"
}

@article{stone2014adornohegel,
    author = "Stone, Alison",
    title = "Adorno, Hegel, and Dialectic",
    journal = "British Journal for the History of Philosophy",
    year = "2014",
    volume = "22",
    pages = "1118--1141",
    doi = "10.1080/09608788.2014.952264",
    note = {CORE ARGUMENT: Argues that Adorno's apparently mixed responses to Hegel form a coherent whole: Adorno follows Hegel's dialectical logic in tracing how enlightenment reverts to myth and domination over nature reverts into domination by nature, while criticizing Hegel's dialectic as the culmination of "identity thinking." For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences rather than being subsumed into a unified whole. RELEVANCE: Directly clarifies how Adorno reworks Hegelian totality and world-spirit-style reconciliation into something that resists a unified, subject-constituted whole, bearing on whether a "negative totality without a subject" is coherent within Adorno's own dialectical logic. POSITION: A systematic reconstruction of Adorno's relation to Hegel that defends Adorno's consistency against Habermas's charge of a performative contradiction in totalized critique.},
    keywords = "Hegel, dialectic, totality, High, METADATA\_CLEANED: number",
    abstract = "This article explores critical theory's relations to German idealism by clarifying how Adorno's thought relates to Hegel's. Adorno's apparently mixed responses to Hegel centre on the dialectic and actually form a coherent whole. In his Logic, Hegel outlines the dialectical process by which categories – fundamental forms of thought and reality – necessarily follow one another in three stages: abstraction, dialectic proper, and the speculative (famously simplified as ‘thesis, antithesis, synthesis’). Adorno's allegiance to Hegel's dialectic emerges when he traces the dialectical process whereby enlightenment reverts to myth and human domination over nature reverts into our domination by nature. However, Adorno criticizes Hegel's dialectic as the ultimate form of ‘identity thinking’, subsuming unique, material objects under universal concepts by using dialectical reason to expand those concepts to cover objects utterly. These two responses cohere because Adorno shares Hegel's view that dialectical contradictions require reconciliation, but differs from Hegel on the nature of reconciliation. For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences. Finally, against Habermas who holds that Adorno cannot consistently criticize the enlightenment practice of critique, I show that Adorno can do so consistently because of how he reshapes Hegelian dialectic.",
    abstract_source = "openalex"
}

@misc{baumann2011concreteuniversal,
    author = "Baumann, Charlotte",
    title = "Adorno, Hegel and the Concrete Universal",
    year = "2011",
    note = {CORE ARGUMENT: Argues that Adorno adopts Hegel's distinction between an abstract and a concrete universal, agreeing that the abstract universal is the form of false knowledge and society while the concrete universal names a positive aim, but rejects Hegel's own account of the concrete universal and formulates a different conception of it; the article then questions whether Adorno's alternative overcomes the problems he identifies in Hegel or remains bound to them. RELEVANCE: Addresses the universal/particular structure underlying Adorno's paradoxical retention of "universal history" — if Adorno rejects Hegel's affirmative concrete universal, this bears directly on what kind of "universal," if any, a negative universal history could still be. POSITION: A critical-immanent reading that leaves open whether Adorno's dialectics escapes the aporias it identifies in Hegel's treatment of the universal/particular relation.},
    keywords = "universal-particular, Hegel, dialectic, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The core argument of this article is that Adorno adopts the distinction between an abstract and a concrete universal from Hegel and criticizes Hegel, on that basis, as abstract. The first two parts of the article outline that both thinkers take the abstract universal to be the form of a false type of knowledge and society, and the concrete universal to be a positive aim. However, as the third part argues, Adorno rejects how the concrete universal is understood in Hegel’s philosophy and formulates a different conception of it. The fourth part questions if Adorno manages to overcome the problems he identifies in Hegel or whether they are inherent to the programme of dialectics both endorse.",
    abstract_source = "openalex"
}

@misc{oconnor2011reconception,
    author = "O'Connor, Brian",
    title = "Adorno's Reconception of the Dialectic",
    year = "2011",
    note = {CORE ARGUMENT: Reconstructs Adorno's reconception of dialectic against the background of Hegel's dialectic, covering Adorno's disagreement with Hegel and offering an overall assessment of the "Hegelianism" of Adorno's critical theory. RELEVANCE: Provides a systematic overview of how Adorno retools the Hegelian dialectical machinery — including the "negative dialectic" that operates without a guaranteeing subject or absolute spirit — central to assessing whether Adorno can sustain a negative totality without a historical subject. POSITION: An expository, broadly sympathetic account that reads Adorno's dialectic as an internal transformation of Hegel's method rather than its wholesale rejection.},
    keywords = "dialectic, Hegel, world-spirit, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "This chapter contains sections titled: Hegel and Negative Dialectic Adorno's Disagreement with Hegel The Hegelianism of Adorno's Critical Theory: An Assessment",
    abstract_source = "openalex"
}

@misc{hohendahl2013progressrevisited,
    author = "Hohendahl, Peter Uwe",
    title = "Progress Revisited: Adorno's Dialogue with Augustine, Kant, and Benjamin",
    year = "2013",
    note = {CORE ARGUMENT: Reconstructs Adorno's essay "Progress" as staging an implicit dialogue with Augustine, Kant, and Benjamin, situating Adorno's refusal of both linear-teleological and cyclical models of history within this longer theological and philosophical genealogy of thinking about historical progress. RELEVANCE: Directly addresses how Adorno reconstrues "progress" by tracing its conceptual ancestry (Augustinian providence, Kantian moral progress, Benjaminian messianic interruption), clarifying what is retained and what is negated in Adorno's non-affirmative concept of progress. POSITION: An intellectual-historical reading of the "Progress" essay that locates Adorno's position at the intersection of theological and Enlightenment philosophies of history.},
    keywords = "progress, Kant, Benjamin, theology-of-history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{cidam2020twotrack,
    author = "Çıdam, Volkan",
    title = "Adorno's Two-Track Conceptualization of Progress: The New Categorical Imperative and Politics of Remembrance",
    year = "2020",
    volume = "28",
    note = {CORE ARGUMENT: Identifies a "two-track" structure in Adorno's conceptualization of progress, linking it both to the "new categorical imperative" (Adorno's post-Auschwitz ethical injunction) and to a politics of remembrance, so that "progress" for Adorno operates simultaneously as ethical demand and as historical-memorial practice rather than as a single continuous historical claim. RELEVANCE: Speaks directly to how Adorno reconstrues progress so that it is neither simply affirmed nor denied, by showing that Adorno's progress-talk is functionally heterogeneous rather than a unified thesis about historical development. POSITION: A reconstructive reading that resists treating Adorno's remarks on progress as a single unified doctrine.},
    keywords = "progress, categorical-imperative, memory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{weisbrod2020lowith,
    author = "Weisbrod, Victor",
    title = "A Missed Connection: Löwith and Adorno on Progress",
    journal = "Thesis Eleven",
    year = "2020",
    abstract = "Despite appearing side by side as keynote speakers at a congress in 1962 devoted to the question of progress, Löwith's and Adorno's accounts of progress have never been linked. This paper is an attempt to establish this missed connection, to reveal important connections, striking similarities, and a fundamental difference between these two eminent thinkers' work on progress. For one, Löwith diagnoses the three main problems that Adorno attempts to solve with his dialectical account of progress. Moreover, each is sympathetic towards crucial aspects of the other's account: Löwith towards Adorno's claim that progress is dialectical, Adorno towards Löwith's claim that progress necessarily has a redemptive aspect. A fundamental disagreement nevertheless divides them: whether the problem of suffering in history is part of our ontological condition, or something we must struggle against and overcome through political action. By establishing this missed connection, I hope to show how progress might still have an important role to play in our present-day historical and political consciousness.",
    abstract_source = "s2",
    note = "CORE ARGUMENT: Establishes a previously unexamined connection between Karl Löwith's and Adorno's accounts of progress (both keynote speakers at a 1962 congress on progress), showing that Löwith diagnosed the three main problems Adorno's dialectical account of progress attempts to solve, that each thinker is sympathetic to an aspect of the other's view, while dividing over whether the problem of suffering in history is an ontological condition or a political one to be overcome. RELEVANCE: Situates Adorno's dialectical, non-affirmative concept of progress against Löwith's more skeptical, theologically-inflected philosophy of history (secularized eschatology), clarifying exactly what is distinctive — and what is shared — in Adorno's refusal of straightforward historical progress. POSITION: A comparative intellectual history reading Adorno's progress essay as partly convergent with, and partly opposed to, Löwith's critique of the secularized theology of progress.",
    keywords = "progress, Lowith, secularization, High, METADATA\_CLEANED: volume, number, pages, doi"
}

@article{bell2017liferuins,
    author = "Bell, Aaron",
    title = "Life in Ruins: Ecological Disaster and Adorno's Idea of Natural History",
    journal = "Telos",
    year = "2017",
    abstract = "—only human beings can recognize catastrophes, provided they survive them; Nature recognizes no catastrophes.—Max Frisch, Man in the Holocene1",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Opens from Max Frisch's observation that only human beings recognize catastrophes — nature recognizes none — to use Adorno's concept of "natural history" (the dialectical collapse of the categories of nature and history into one another) as a lens for thinking ecological catastrophe. RELEVANCE: Extends Adorno's "idea of natural history," which underlies his treatment of progress and catastrophe in Negative Dialectics, to contemporary ecological ruin, illustrating the concept's continued applicability beyond Auschwitz to a further "new catastrophe." POSITION: An applied, extending reading of Adorno's natural-history concept within eco-critical Frankfurt School scholarship.},
    keywords = "natural-history, ecology, catastrophe, Medium, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{sherman2016negativedialectics,
    author = "Sherman, David",
    title = "Adorno's Negative Dialectics",
    year = "2016",
    abstract = "Abstract The concept of negative dialectics constitutes the philosophical core of Adorno's wide‐ranging thought. It reflects his attempt both to consider the status of dialectics in the face of a history that has failed to actualize its prognostications and to rework dialectics to make it adequate to his own time. Among the themes considered are Adorno's critique of conceptuality in the German idealist tradition, his critique of enlightenment reason and its relationship to capitalist society, his qualified rejection of universal history, his concern with revitalizing experience, and his concept of the constellation, which he offers as an alternative to existing epistemological paradigms.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Surveys negative dialectics as the philosophical core of Adorno's thought, covering his critique of German-idealist conceptuality, his critique of enlightenment reason's relation to capitalist society, his "qualified rejection of universal history," his concern with revitalizing experience, and his concept of the constellation as an alternative epistemological paradigm. RELEVANCE: Explicitly names Adorno's "qualified rejection of universal history" as a central theme of negative dialectics, useful for situating this domain's core interpretive question within the wider architecture of Negative Dialectics as a whole. POSITION: A synthetic survey rather than an original argument, useful chiefly for orienting readers to the overall structure of Adorno's negative dialectics.},
    keywords = "negative-dialectics, universal-history, overview, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{whyman2016naturalhistory,
    author = "Whyman, Tom",
    title = "Understanding Adorno on 'Natural-History'",
    year = "2016",
    abstract = "'Natural-History' is one of the key concepts in the thought of the Frankfurt School critical theorist Theodor W. Adorno, appearing from his very earliest work through to his very last. Unfortunately, the existing literature provides little illumination as to what Adorno's concept of natural-history is, or what it is supposed to do. This paper thus seeks to supply the required understanding. Ultimately, I argue that 'natural-history' is best understood as a sort of 'therapeutic' concept, intended to dissolve certain philosophical anxieties which might otherwise present obstacles to our being able to obtain a critical-theoretical understanding of reality.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Argues that Adorno's concept of "natural-history" — present from his earliest to his latest work — is best understood as a "therapeutic" concept intended to dissolve philosophical anxieties (e.g., about the relation of nature and history, necessity and contingency) that would otherwise obstruct a critical-theoretical understanding of reality, rather than as a substantive metaphysical or historical thesis. RELEVANCE: Bears directly on this domain's meta-level question — whether Adorno offers a substantive philosophy of history or something closer to a diagnostic/therapeutic device — by proposing that "natural-history," and by extension Adorno's historical categories generally, function therapeutically rather than doctrinally. POSITION: A distinctive, deflationary reading of Adorno's natural-history concept that resists both purely metaphysical and purely sociological interpretations.},
    keywords = "natural-history, therapeutic-reading, metaphilosophy, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{johnson2019anthropocene,
    author = "Johnson, Harriet",
    title = "The Anthropocene as a Negative Universal History",
    year = "2019",
    volume = "3",
    howpublished = "\url{https://www.semanticscholar.org/paper/e878b6bb7afa8c8f53f65650daaf316c54b1dc9f}",
    note = {CORE ARGUMENT: Argues that the Anthropocene compels a rethinking of the tradition of universal history inherited from Enlightenment thinkers, who sought a continuous history of humankind tending toward upward development. Drawing on Adorno, the paper develops a "negative universal history" that "undercuts the totalizing ambitions of the tradition from which it springs," modeling ways of attending to planetary-scale forces precisely in their uneven, local manifestations. Published in Adorno Studies, vol. 3, issue 1. RELEVANCE: Directly reconstructs and extends Adorno's paradoxical retention of "universal history" after its Enlightenment optimism has been discredited, showing how a negative universal history can still track large-scale, even planetary, processes without positing a unified historical subject or telos. POSITION: An extension of Adorno's negative universal history into contemporary Anthropocene discourse, treating Adorno's category as an interpretive resource rather than merely a symptom of totalizing thought.},
    keywords = "universal-history, Anthropocene, totality, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages"
}

@misc{lunajimenez2020naturalezaehistoria,
    author = "Luna Jiménez, Andrés",
    title = "Apuntes sobre naturaleza e historia en la obra de Theodor W. Adorno: lo natural como problema para las filosofías de la historia",
    year = "2020",
    abstract = {This article makes a general review of the philosophical work of Theodor W. Adorno on the opposition between the concepts of history and nature over three stages of his production. Specifically, it will examine the way in which the theoretical project of a dialectical overcoming of this antithesis, sketched by Adorno in his early essay "The idea of natural history" (1932), is later reformulated in Dialectic of Enlightenment (1944-1947) and Negative Dialectics (1966). As a conclusion, it suggests that his statements regarding this opposition entail a considerable relevance for the current issue of the relationship between human societies and the natural world, and therefore, as a subject of reflection for a contemporary philosophy of history.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Traces the opposition between the concepts of history and nature across three stages of Adorno's work — from the early essay "The Idea of Natural History" (1932), through its reformulation in Dialectic of Enlightenment (1944–1947), to Negative Dialectics (1966) — arguing that Adorno's dialectical treatment of this antithesis remains relevant to contemporary debates on the human/nature relationship and thus to a contemporary philosophy of history. RELEVANCE: Provides a developmental overview of how the nature/history dialectic underlying Adorno's "natural history" concept evolves across his corpus, directly relevant to reconstructing the "World Spirit and Natural History" model of Negative Dialectics. POSITION: A developmental-exegetical reading tracing continuity in Adorno's nature-history dialectic from 1932 to 1966.},
    keywords = "natural-history, nature, negative-dialectics, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{allen2016endofprogress,
    author = "Allen, Amy",
    title = "The End of Progress: Decolonizing the Normative Foundations of Critical Theory",
    year = "2016",
    note = {CORE ARGUMENT: Argues that while post- and decolonial theorists have debunked the idea of historical progress as a Eurocentric, imperialist, and neocolonialist fallacy, prominent contemporary Frankfurt School thinkers (Habermas, Honneth, Forst) have persistently defended ideas of progress, development, and modernity as central to their normative claims. Allen argues for "fracturing" critical theory from within by dispensing with its progressive reading of history while retaining the notion of progress as a political imperative — a stance she credits to Adorno. RELEVANCE: A foundational contemporary intervention on this domain's meta-question — whether critical theory's philosophy of history can or should retain any notion of progress — explicitly crediting Adorno's non-teleological retention of progress "as a political imperative" as the resource for a decolonized critical theory. POSITION: A decolonial-genealogical critique of critical theory's normative foundations that positions Adorno, against Habermas, Honneth, and Forst, as the resource for salvaging progress without teleology.},
    keywords = "progress, decolonial-critique, critical-theory, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {Amy Allen identifies two main goals for her book. The first is to critique Habermas and two of his main successors -- Axel Honneth and Rainer Forst -- as "wedded to problematically Eurocentric and/or foundationalist strategies for grounding normativity," including implicitly "colonialist" notions of intellectual and social progress. The second is to "decolonize Frankfurt School critical theory" by offering alternative bases for normativity that take on board the concerns of "decolonial theory," critical race theory, and queer theory that have been sidelined by mainstream critical theorists (p. xii). Her argumentative strategy is to set up a trilemma (see pp. 13-15): abstract\_source = {ndpr}, a. the "long-standing" problem of relativism, of which postcolonial theory is accused;b. justifying rational autonomy or social freedom as outcomes of "a progressive process of social evolution or sociocultural learning," which turns out to depend on a problematic conception of progress already accomplished; andc. rationalist foundationalism (e.g. of neo-Kantian varieties) which ties political philosophy to ideal theory and makes social criticism into a form of "applied ethics." Allen's thesis is that in trying to avoid horns (a) and (c), Habermas and Honneth each fall into two variants of horn (b): they try to avoid the "twin evils of foundationalism and relativism" by reconstructing the norms emerging from the implicit trajectory of social history (pp. 13-14). While Allen agrees with grounding critical theory in the actual social world, she argues that their versions depend on a (morally and factually) suspect idea of progress. Forst, by contrast, holds that "progress" is a normative concept depending on universal standards rather than supporting them. But he thereby falls into horn (c) in Allen's view, while she hopes to avoid all three horns by returning to a more contextualist view inspired by Adorno and Foucault. Although I do not think she is entirely fair to them, I will not evaluate Allen's interpretations of Habermas and Honneth in detail. Instead, given space limits, I will concentrate on her critique of their reliance on "backward-looking" or accomplished progress, e.g. as Honneth thinks is evinced by growing acceptance of gay marriage, and on Allen's alternative proposal. Overall, I will argue that Critical Theory can reject excessively ideological and exaggerated charges of "colonialism," though I will express cautious sympathy with some of Allen's doubts about dependence on any strongly structured or stage-wise conception of human history. Allen's main argument is that, despite rejecting rationalist ideas of necessary or teleologically determined historical progress (in Kant, Hegel, and Marx), much recent work in Critical Theory depends on an idea of historical progress "that has led up to 'us,'" or to our institutions, practices, and conception of reason. This idea of progress as an accomplished "fact" is more dangerous in her view than forward-looking or prospective progress "as a normative goal that we are striving to achieve," e.g. a "good" or "more just" society (p. 12). Her hope is to show that critical theory need not depend on backward-looking progress (pp. 32-33). However, if we can define a moral ideal without appeal to accomplished progress, we could then measure past progress with respect to that ideal. So Allen's real concern seems not to be with backward-looking progressper se, but rather with appeal to such progress tojustifymoral norms or ethical ideals. In any case, the Allen explains two kinds of objections to past or accomplished progress. One is epistemological: "On what basis do we claim to know what counts as progress?" (p. 19). The second objection concerns the "entwinement of the idea of historical progress with the legacies of racism, colonialism, and imperialist and their contemporary neocolonial or informally imperialist forms" (p. 16). This refers to the familiar worry that seeing western cultures as more socially (as well as technologically) "advanced" provided a key ideological justification for "the colonial and imperial projects" (p. 17). There are some historical problems with this argument; for example, slavery existed in Moorish parts of Spain and in North Africa before the conquistadors set out. Still, there is no doubt that cultural superiority was later invoked as a justification for empire as late as the establishment of colonial mandates under the League of Nations in the early 20th century. But the fundamental problem with this critique of accomplished progress as inherently colonialist is that a historical thesis A may be used to justify a policy B that it does not entail. 19th century conservatives sometimes pressed Darwinian biology into service to justify extreme forms of meritocratic competition on the view that "weaker" individuals should die off. That social Darwinists perverted Darwin's findings in this way, or that Nazi doctors used them as specious rationalizations for eugenic programs, should hardly lead us to reject evolutionary biology because it is "deeply entwined" with the legacy of racial or class "supremacism." Allen is aware of this worry: she notes that, even if backward-looking progress has used for corrupt ideological purposes in the past, it might not be "merely ideological" (p. 25). To illustrate this possibility, she briefly considers Thomas McCarthy's recent classic,Race, Empire, and the Idea of Human Development. She concedes that McCarthy goes beyond Habermas's admission that judgments of progress are situated and fallible, further emphasizes the need to remember the wrongs done "in the name of human development," and understands the norms embedded in our tradition(s) in a "more modest and contextualist way than . . . Habermas tends to" (pp. 27). Yet McCarthy agrees with Habermas that modern law, markets, and discourse have become unavoidable for practically everyone, and that we cannot avoid regarding the linguistic / historicist turn -- together with the reflexivity of "modern forms of discourse" -- as progressive, relative to which unreflective ways of life count as less advanced.}
}

@misc{allenw2025kantadornoforms,
    author = "Allen, William S.",
    title = "Kant, Adorno, and the Forms of History",
    year = "2025",
    abstract = "Kant, Adorno, and the Forms of History sets the works of Theodor Adorno, Immanuel Kant and Peter Weiss in dialogue, revealing how an interrogation of the aesthetics of 'the whole' and the conception of history in Western thought reveals new ways of thinking about history and historically. To conceive of history as such it is necessary to conceive it as a whole, but doing so carries implications about its development and direction. Furthermore, such an idea makes it difficult to consider its parts without subsuming them to the whole, thereby making individuals merely instrumental to achieving the aims of history. William S. Allen brings the thought of Kant, Adorno and Weiss to bear on these tensions, tracing how Adorno's reconsideration of history through his readings of Kant's Critique of Judgement are distinct from formulations offered by other thinkers (Marx, Hegel, Lyotard). Allen establishes that Kant's Critique of Judgement is not only a sustained analysis of the development of forms, whether aesthetic or organic, but also a tacit interrogation of the form of the whole and the possibilities of thinking it. Kant, Adorno, and the Forms of History argues that Adorno has taken up this interrogation more than any other thinker and through his aesthetics has introduced an alternative thought, which has been modified and extended in the work of Peter Weiss in his last novel, The Aesthetics of Resistance. Within this thought lies the possibility of thinking history without the whole, without unity or purpose, which is a possibility that may offer new insights in the face of imminent environmental, economic and political collapse.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: Sets Kant, Adorno, and Peter Weiss in dialogue to interrogate the aesthetics of "the whole" in conceptions of history: to conceive of history as such requires conceiving it as a whole, but this makes it difficult to consider its parts without subsuming individuals to that whole, rendering them merely instrumental to history's ends. The book argues that Adorno's reworking of Kant's Critique of Judgment — more than any other thinker's treatment — opens the possibility of thinking history without "the whole," without unity or purpose. RELEVANCE: Bears directly on this domain's central puzzle of whether a negative totality ("the whole is the false") can be sustained without a constituting historical subject, arguing that Adorno's Kant-inflected aesthetics offers precisely a way of thinking history without positing such a totalizing whole. POSITION: An aesthetics-driven reading that locates in Adorno, via Kant's Critique of Judgment, an alternative to both Hegelian and Marxist totalizing philosophies of history.},
    keywords = "totality, Kant, whole-is-false, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}
