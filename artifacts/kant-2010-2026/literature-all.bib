@book{guyer2010companion,
    editor = "Guyer, Paul",
    title = "The Cambridge Companion to Kant's Critique of Pure Reason",
    publisher = "Cambridge University Press",
    year = "2010",
    doi = "10.1017/ccol9780521883863",
    note = "SUMMARY: Collective commentary on the Critique of Pure Reason in seventeen chapters by an international team, arranged under the background, the arguments and the impact of the work; the opening chapters place the Critique against continental rationalism and British empiricism (publisher description; NDPR). SUBFIELD AND DEBATE: Theoretical philosophy (Critique of Pure Reason); commentary and reference volume, a Cambridge Companion devoted to a single text. No single debate; individual chapters on the Paralogisms, Antinomies, Ideal of Pure Reason and Refutation of Idealism are cited separately in SEP bibliographies. SIGNIFICANCE INDICATORS: S2 citations: 69 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 17. NDPR review: yes (ndpr.nd.edu/reviews/the-cambridge-companion-to-kant-s-critique-of-pure-reason/). SEP: the volume or its chapters appear in the kant, kant-mind, kant-metaphysics and kant-transcendental-idealism bibliographies. Series: Cambridge Companions. YEAR NOTE: CrossRef print date 2010-06; online 2010-07.",
    keywords = "kant, tp-cpr, reference, type-edited-volume, High",
    abstract = "Immanuel Kant's Critique of Pure Reason, first published in 1781, is one of the landmarks of Western philosophy, a radical departure from everything that went before and an inescapable influence on all philosophy since its publication. This Companion is the first collective commentary on this work in English. The seventeen chapters have been written by an international team of scholars, including some of the best-known figures in the field as well as emerging younger talents. The first two chapters situate Kant's project against the background of continental rationalism and British empiricism, the dominant schools of early modern philosophy. Eleven chapters then expound and assess all the main arguments of the Critique. Finally, four chapters recount the enormous influence of the Critique on subsequent philosophical movements, including German Idealism and Neo-Kantianism, twentieth-century continental philosophy, and twentieth-century Anglo-American analytic philosophy. The book concludes with an extensive bibliography.",
    abstract_source = "openalex"
}

@article{proops2010paralogism,
    author = "Proops, Ian",
    title = "Kant's First Paralogism",
    journal = "The Philosophical Review",
    year = "2010",
    volume = "119",
    number = "4",
    pages = "449--495",
    doi = "10.1215/00318108-2010-011",
    note = "SUMMARY: Examines how, in the First Paralogism, transcendental illusion leads rational psychologists to the doctrine that the soul is a substance. Argues that Kant identifies the source of the fallacy as a confusion about the nature of conceivability and thereby makes a contribution of lasting philosophical value (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: Transcendental Dialectic, rational psychology and Kant's account of the self. Interpretive study of a single argument; no named debate. SIGNIFICANCE INDICATORS: S2 citations: 41 (retrieved 2026-09-30); CrossRef: 16. Venue: The Philosophical Review. SEP: listed in the kant-mind and kant-metaphysics bibliographies.",
    keywords = "kant, tp-cpr, tp-mind, type-article, Medium",
    abstract = "In the chapter of the Critique of Pure Reason entitled “The Paralogisms of Pure Reason” Kant seeks to explain how rationalist philosophers, including thinkers of the caliber of Descartes and Leibniz, could have arrived at what he considers to be certain erroneous, “dogmatic” conclusions about the nature of the self or soul. His diagnosis has two main components: first, the positing of “Transcendental Illusion”—a pervasive intellectual illusion, modeled on perceptual illusion, which predisposes us to accept as sound certain invalid arguments for substantive theses about the nature of the soul; second, the identification of the relevant fallacies. This essay examines Kant's account in the First Paralogism of how these two elements combine to produce the doctrine that the soul is a substance. It is argued that Kant has a novel, ingenious—and even somewhat plausible—account of how the rational psychologist might arrive at such a view. It is further argued that the source of the fallacy in the first paralogism is a confusion about the very nature of conceivability and that, in identifying this confusion, Kant makes a philosophical contribution of lasting value.",
    abstract_source = "openalex"
}

@article{allais2010transcendental,
    author = "Allais, Lucy",
    title = "Kant's Argument for Transcendental Idealism in the Transcendental Aesthetic",
    journal = "Proceedings of the Aristotelian Society (Hardback)",
    year = "2010",
    volume = "110",
    pages = "47--75",
    doi = "10.1111/j.1467-9264.2010.00279.x",
    note = "SUMMARY: Reads the Transcendental Aesthetic's argument for transcendental idealism as turning on how synthetic a priori propositions can have objects, not on the source of their justification. Takes intuition to be a representation that involves the presence to consciousness of the object represented, and concludes that a priori intuition cannot present a mind-independent feature of reality (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: arguments for transcendental idealism and the theory of intuition. Argues against a common reading on which the argument is about the justification of a priori claims about mind-independent reality. SIGNIFICANCE INDICATORS: S2 citations: 27 (retrieved 2026-09-30); CrossRef: 17. Venue: Proceedings of the Aristotelian Society (symposium paper; the S2 title carries the section number IV). SEP/IEP: no 2010 entry found in the retrieved bibliographies (the SEP kant-transcendental bibliography lists a different Allais item, a 2011 chapter). YEAR NOTE: CrossRef gives online-first 2010-04-23; volume 110, part 1 (2010).",
    keywords = "kant, tp-cpr, debate-other-transcendental-idealism, type-article, Medium",
    abstract = "This paper gives an interpretation of Kant's argument for transcendental idealism in the Transcendental Aesthetic. I argue against a common way of reading this argument, which sees Kant as arguing that substantive a priori claims about mind-independent reality would be unintelligible because we cannot explain the source of their justification. I argue that Kant's concern with how synthetic a priori propositions are possible is not a concern with the source of their justification, but with how they can have objects. I argue that Kant's notion of intuition needs to be understood as a kind of representation which involves the presence to consciousness of the object it represents, and that this means that a priori intuition cannot present us with a mind-independent feature of reality.",
    abstract_source = "openalex"
}

@article{sturm2010consciousness,
    author = "Sturm, Thomas and Wunderlich, Falk",
    title = "Kant and the scientific study of consciousness",
    journal = "History of the Human Sciences",
    year = "2010",
    volume = "23",
    number = "3",
    pages = "48--71",
    doi = "10.1177/0952695110363355",
    note = "SUMMARY: Argues that Kant's views on consciousness, the mind-body problem and the status of psychology as a science differ sharply from the way these topics are combined in present debates about a science of consciousness: Kant did not use 'consciousness' for phenomenal qualia, his mind-body problem concerns substances rather than mental properties, and he required quantification, not mechanistic explanation, of a scientific psychology (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: mind, empirical psychology and the history of psychology. Historical corrective to anachronistic uses of Kant in contemporary consciousness science. SIGNIFICANCE INDICATORS: S2 citations: 23 (retrieved 2026-09-30); CrossRef: 18. Venue: History of the Human Sciences. SEP/IEP: not found in the retrieved bibliographies.",
    keywords = "kant, tp-mind, anthro-hist-edu, debate-other-consciousness-science, type-article, Medium",
    abstract = "We argue that Kant's views about consciousness, the mind-body problem and the status of psychology as a science all differ drastically from the way in which these topics are conjoined in present debates about the prominent idea of a science of consciousness. Kant never used the concept of consciousness in the now dominant sense of phenomenal qualia; his discussions of the mind-body problem center not on the reducibility of mental properties but of substances; and his views about the possibility of psychology as a science did not employ the requirement of a mechanistic explanation, but of a quantification of phenomena. This shows strikingly how deeply philosophical problems and conceptions can change even if they look similar on the surface.",
    abstract_source = "openalex"
}

@book{byrd2010doctrine,
    author = "Byrd, B. Sharon and Hruschka, Joachim",
    title = "Kant's Doctrine of Right: A Commentary",
    publisher = "Cambridge University Press",
    year = "2010",
    doi = "10.1017/cbo9780511712050",
    note = "SUMMARY: Commentary on the Doctrine of Right that analyses Kant's system of individual rights from the innate right to external freedom to property, contract and family claims, and explains his terminology, method and ideas in light of his intellectual environment, including Achenwall's natural-law text (publisher abstract; NDPR). SUBFIELD AND DEBATE: Political and legal philosophy: Kant's Doctrine of Right (Metaphysics of Morals, Part I). The SEP entry on Kant's social and political philosophy discusses the authors' reading of Kant as favouring representative democracy and a world republic (state of states) as the way to enforce global right, to which later authors respond. SIGNIFICANCE INDICATORS: S2 citations: 139 (retrieved 2026-09-30); CrossRef: 143. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-doctrine-of-right-a-commentary/). SEP: listed in the kant-moral and kant-social-political bibliographies and cited in text in kant-social-political. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2010; online 2009 (CrossRef issued date 2009). S2 and SEP give 2010.",
    sep_context = {SEP kant-social-political: "While Byrd and Hruschka 2010 see Kant as advocating representative democracy, Caranti 2023 argues that Kant's limitations on democratic rule reflect a rejection of self-interest channeled through democratic institutions."},
    keywords = "kant, pp-right-politics, type-monograph, High",
    abstract = "Published in 1797, the Doctrine of Right is Kant's most significant contribution to legal and political philosophy. As the first part of the Metaphysics of Morals, it deals with the legal rights which persons have or can acquire, and aims at providing the grounding for lasting international peace through the idea of the juridical state (Rechtsstaat). This commentary analyzes Kant's system of individual rights, starting from the original innate right to external freedom, and ending with the right to own property and to have contractual and family claims. Clear and to the point, it guides readers through the most difficult passages of the Doctrine, explaining Kant's terminology, method and ideas in the light of his intellectual environment. One of the very few commentaries on the Doctrine of Right available in English, this book will be essential for anyone with a strong interest in Kant's moral and political philosophy.",
    abstract_source = "openalex"
}

