    keywords = "kant, anthro-hist-edu, debate-race, debate-colonialism, type-edited-volume, Medium, INCOMPLETE, no-abstract"
}

@article{ginsborg2011normativity,
    author = "Ginsborg, Hannah",
    title = "Primitive Normativity and Skepticism about Rules",
    journal = "Journal of Philosophy",
    year = "2011",
    volume = "108",
    number = "5",
    pages = "227--254",
    doi = "10.5840/jphil2011108518",
    note = "SUMMARY: Invokes Kant's account of aesthetic judgment as the basis for a response to the skepticism about rules and meaning that Kripke attributes to Wittgenstein (SEP kant-aesthetics; the abstract text returned by OpenAlex is only the article's opening on Kripke's argument). SUBFIELD AND DEBATE: Aesthetics and reception in analytic philosophy: Kant's theory of aesthetic judgment applied to rule-following and normativity. Kant is the source of the proposed response rather than the sole subject of the paper. SIGNIFICANCE INDICATORS: S2 citations: 127 (retrieved 2026-09-30); CrossRef: 84. Venue: Journal of Philosophy. SEP: listed in the kant-aesthetics bibliography and cited in the section on the broader significance of Kant's aesthetics.",
    sep_context = {SEP kant-aesthetics: "Ginsborg 2011 invokes Kant's aesthetic theory as a basis for a response to the skepticism about rules and meaning which Saul Kripke attributes to Wittgenstein (Kripke 1982)."},
    keywords = "kant, aes-teleo, recep-analytic, debate-other-normativity, type-article, Medium",
    abstract = {I n his Wittgenstein on Rules and Private Language, Saul Kripke develops a skeptical argument against the possibility of meaning. 1 Suppose that all your previous uses of the word "plus" and of the "1" sign have involved numbers less than 57.You are now asked "what is 68 plus 57?" and you answer "125."But a skeptic proposes the hypothesis that by the word "plus," or the "1" sign, you previously meant not addition, but quaddition, where x quus y is the sum of x and y if x and y are less than 57, and otherwise 5.If you are to use the word "plus" as you used it in the past, the skeptic says, then, on the hypothesis that you meant quaddition, you ought to answer "5."Against your insistence that you know what you meant by "plus," the skeptic challenges you to cite some fact in virtue of which you meant addition.All your previous answers, he points out, were consistent with the hypothesis that you meant quaddition, so how can you justify your claim that you meant addition instead?The upshot of the skeptical},
    abstract_source = "openalex"
}

@book{louden2011human,
    author = "Louden, Robert B.",
    title = "Kant's Human Being: Essays on His Theory of Human Nature",
    publisher = "Oxford University Press",
    year = "2011",
    doi = "10.1093/acprof:osobl/9780199768714.001.0001",
    note = "SUMMARY: Essays on Kant's empirical work on human nature and its connection to his ethical theory, analysing Kant's answer to the question 'What is the human being?', with parts on virtue and human nature, on Kant's popular lecture courses in anthropology, geography and education, and on national character (publisher abstract; NDPR). SUBFIELD AND DEBATE: Anthropology and practical philosophy: the role of empirical knowledge of human nature in Kant's ethics. The NDPR review notes the closing treatment of Kant's stereotyped remarks on national character in the Observations, and comments that Kant's treatment of race was especially unfortunate. SIGNIFICANCE INDICATORS: S2 citations: 96 (retrieved 2026-09-30); CrossRef: 76. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-human-being-essays-on-his-theory-of-human-nature/). SEP: listed in the kant-mind bibliography. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2011-08.",
    keywords = "kant, anthro-hist-edu, pp-ethics, debate-race, type-monograph, High",
    abstract = "Abstract This book continues and deepens avenues of research first initiated in the author’s highly acclaimed book, Kant’s Impure Ethics. Drawing on a wide variety of both published and unpublished works spanning all periods of Kant’s extensive writing career, the author focuses on Kant’s under-appreciated empirical work on human nature, with particular attention to the connections between this body of work and his much-discussed ethical theory. Kant repeatedly claimed that the question, “What is the human being” is philosophy’s most fundamental question, one that encompasses all others. The author analyzes and evaluates Kant’s own answer to his question, showing how it differs from other accounts of human nature. The book is divided into three parts. Part One explores the nature and role of virtue in Kant’s ethical theory, showing how the conception of human nature behind Kant’s virtue theory results in a virtue ethics that is decidedly different from more familiar Aristotelian virtue ethics programs. Part Two uncovers the dominant moral message in Kant’s anthropological investigations, drawing new connections between Kant’s work on human nature and his ethics. Part Three explores specific aspects of Kant’s theory of human nature developed outside of his anthropology lectures, in his works on religion, geography, education, and aesthetics, and shows how these writings substantially amplify his account of human beings.",
    abstract_source = "openalex"
}

@book{dicenso2011religion,
    author = "DiCenso, James",
    title = "Kant, Religion, and Politics",
    publisher = "Cambridge University Press",
    year = "2011",
    doi = "10.1017/cbo9780511920851",
    note = "SUMMARY: Systematic examination of the place of religion in Kant's major writings, arguing that his theory of religion emerges from his epistemology, ethics and political theory and serves projects of restructuring institutions and moving political attitudes towards greater autonomy (publisher abstract; NDPR). SUBFIELD AND DEBATE: Religion: Religion within the Boundaries of Mere Reason read together with Kant's political and epistemological writings; against the view that Kant reduces religion to moral lessons. SIGNIFICANCE INDICATORS: S2 citations: 11 (retrieved 2026-09-30); CrossRef: 18. NDPR review: yes (ndpr.nd.edu/reviews/kant-religion-and-politics/). SEP: listed in the kant-religion bibliography. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2011-08.",
    keywords = "kant, religion, pp-right-politics, type-monograph, Medium",
    abstract = "This book offers a systematic examination of the place of religion within Kant's major writings. Kant is often thought to be highly reductionistic with regard to religion - as though religion simply provides the unsophisticated with colourful representations of moral lessons that reason alone could grasp. James DiCenso's rich and innovative discussion shows how Kant's theory of religion in fact emerges directly from his epistemology, ethics and political theory, and how it serves his larger political and ethical projects of restructuring institutions and modifying political attitudes towards greater autonomy. It also illustrates the continuing relevance of Kant's ideas for addressing issues of religion and politics that remain pressing in the contemporary world, such as just laws, transparency in the public sphere and other ethical and political concerns. The book will be valuable for a wide range of readers who are interested in Kant's thought.",
    abstract_source = "openalex"
}

@book{rockmore2011phenomenology,
    author = "Rockmore, Tom",
    title = "Kant and Phenomenology",
    publisher = "University of Chicago Press",
    year = "2011",
    url = "https://doi.org/10.7208/chicago/9780226723419.001.0001",
    note = "SUMMARY: Argues that phenomenology originates in Kant, whose second-edition constructivist theory of knowledge challenged representational epistemology, and that the true meaning of phenomenology is a form of constructivism traced through Plato, Kant and Hegel rather than through Husserl (publisher abstract; NDPR). SUBFIELD AND DEBATE: Reception: Kant and phenomenology. The NDPR review by Sebastian Luft is critical, objecting that the constructivist reading of Kant does not engage rival interpretations such as Allison's dual-aspect theory and that the treatment of classical phenomenology is limited. SIGNIFICANCE INDICATORS: S2 citations: 40 on the title-matched record (retrieved 2026-09-30); CrossRef: 6. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-phenomenology/). SEP/IEP: not found in the retrieved bibliographies. Publisher: University of Chicago Press. YEAR NOTE: CrossRef print date 2010, but S2 and the NDPR review header (University of Chicago Press, 2011) give 2011; dated 2011 here.",
    keywords = "kant, recep-phenom, debate-other-constructivist-reading, type-monograph, Low",
    abstract = "Phenomenology, together with Marxism, pragmatism, and analytic philosophy, dominated philosophy in the twentieth century - and Edmund Husserl is usually thought to have been the first to develop the concept. His views influenced a variety of important later thinkers, such as Heidegger and Merleau-Ponty, who eventually turned phenomenology away from questions of knowledge. But in this significant new work, Tom Rockmore argues for a return to phenomenology's origins in epistemology and does so by locating its roots in the work of Immanuel Kant. and traces the formulation of Kant's phenomenological approach back to the second edition of the Critique of Pure Reason. In response to various criticisms of the first edition, Kant more forcefully put forth a 'constructivist theory of knowledge. This shift in Kant's thinking challenged the representational approach to epistemology, and it is this turn, Rockmore contends, that makes Kant the first great phenomenologist. He then follows this phenomenological line through the work of Kant's idealist successors, Fichte and Hegel. Steeped in the sources and literature it examines, Kant and Phenomenology persuasively reshapes our conception of both of its main subjects.",
    abstract_source = "openalex"
}

@article{chignell2012spinoza,
    author = "Chignell, A.",
    title = "Kant, Real Possibility, and the Threat of Spinoza",
    journal = "Mind",
    year = "2012",
    volume = "121",
    number = "483",
    pages = "635--675",
    doi = "10.1093/mind/fzs079",
    note = "SUMMARY: Reconstructs Kant's pre-critical proof of a 'most real being' and the theory of modality behind his departure from Leibniz, argues that the being it yields resembles Spinoza's extended natura naturans more than a personal creator-God, and holds that although transcendental idealism lets Kant avoid this conclusion in the critical period, one version of the Spinozistic threat remains (abstract). SUBFIELD AND DEBATE: Theoretical philosophy and pre-critical work: Kant's modal metaphysics, rational theology and the relation of Kant to Spinoza. SIGNIFICANCE INDICATORS: S2 citations: 58 (retrieved 2026-09-30); CrossRef: 23. Venue: Mind. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2012-07 (volume 121, issue 483); online 2012-12.",
    keywords = "kant, tp-cpr, precritical, debate-other-modality, type-article, Medium",
    abstract = "In the first part of the paper I reconstruct Kant’s proof of the existence of a ‘most real being’ while also highlighting the theory of modality that motivates Kant’s departure from Leibniz’s version of the proof. I go on to argue that it is precisely this departure that makes the being that falls out of the pre-critical proof look more like Spinoza’s extended natura naturans than an independent, personal creator-God. In the critical period, Kant seems to think that transcendental idealism allows him to avoid this conclusion, but in the last section of the paper I argue that there is still one important version of the Spinozistic threat that remains.",
    abstract_source = "openalex"
}

@article{griffith2012categories,
    author = "Griffith, Aaron M.",
    title = "Perception and the Categories: A Conceptualist Reading of Kant's Critique of Pure Reason",
    journal = "European Journal of Philosophy",
    year = "2012",
    volume = "20",
    number = "2",
    pages = "193--222",
    doi = "10.1111/j.1468-0378.2010.00404.x",
    note = "SUMMARY: Argues against the nonconceptualist readings of Kant given by Hanna and Allais and, from the A and B Transcendental Deductions, for a conceptualist reading: because Kant's notion of empirical intuition makes essential reference to the categories, no empirical intuition can be given in sensibility independently of the understanding and its categories (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: the conceptualism against nonconceptualism debate on Kant's theory of perception and the Transcendental Deduction; responds directly to Hanna and Allais. SIGNIFICANCE INDICATORS: S2 citations: 62 (retrieved 2026-09-30); CrossRef: 32. Venue: European Journal of Philosophy. SEP: listed in the kant-judgment bibliography (as 2010). YEAR NOTE: CrossRef print date 2012-06 (volume 20, issue 2); the DOI carries 2010 and the SEP kant-judgment bibliography dates it 2010.",
    keywords = "kant, tp-cpr, tp-mind, debate-conceptualism, type-article, Medium",
    abstract = "Abstract: Philosophers interested in Kant's relevance to contemporary debates over the nature of mental content—notably Robert Hanna and Lucy Allais—have argued that Kant ought to be credited with being the original proponent of the existence of ‘nonconceptual content’. However, I think the ‘nonconceptualist’ interpretations that Hanna and Allais give do not show that Kant allowed for nonconceptual content as they construe it. I argue, on the basis of an analysis of certain sections of the A and B editions of the Transcendental Deduction, for a ‘conceptualist’ reading of Kant's Critique of Pure Reason. My contention is that since Kant's notion of empirical intuition makes essential reference to the categories, it must be true for him that no empirical intuition can be given in sensibility independently of the understanding and its categories.",
    abstract_source = "openalex"
}

@article{friedman2012geometry,
    author = "Friedman, Michael",
    title = "Kant on geometry and spatial intuition",
    journal = "Synthese",
    year = "2012",
    volume = "186",
    number = "1",
    pages = "231--255",
    doi = "10.1007/s11229-012-0066-2",
    note = "SUMMARY: Uses recent work on Kant and diagrammatic reasoning to reconsider central aspects of Kant's philosophy of geometry and its relation to spatial intuition, in particular the relations between geometrical concepts and their schemata and between pure and empirical intuition (abstract snippet from PhilPapers via Brave search; no abstract returned by S2, OpenAlex or CORE). SUBFIELD AND DEBATE: Philosophy of mathematics and science: Kant's philosophy of geometry, construction and spatial intuition. The SEP entry on Kant's philosophy of mathematics records that Friedman argues against diagrammatic interpretations of Kantian intuition. SIGNIFICANCE INDICATORS: S2 citations: 89 on the title-matched record (retrieved 2026-09-30; a duplicate stub record shows 0); CrossRef: 46. Venue: Synthese. SEP: cited in text in kant-mathematics and listed in kant-transcendental. YEAR NOTE: CrossRef print date 2012-05; online 2012-03.",
    sep_context = {SEP kant-mathematics: "Additionally, Friedman has argued against diagrammatic interpretations of Kantian intuition (Friedman 2012) and has marshalled evidence from the B-Deduction to support his understanding of the connections among geometrical construction, the space of perception, and physical space."},
    keywords = "kant, tp-science-math, debate-other-diagrammatic-intuition, type-article, Medium, INCOMPLETE, no-abstract"
}

@book{ameriks2012elliptical,
    author = "Ameriks, Karl",
    title = "Kant's Elliptical Path",
    publisher = "Oxford University Press",
    year = "2012",
    doi = "10.1093/acprof:oso/9780199693689.001.0001",
    note = "SUMMARY: Essays tracing the stages and key concepts of Kant's Critical philosophy from the early 1760s to the 1790s as a defence of the conception of humanity's fundamental end that Kant reached after reading Rousseau, with essays on each Critique, a new defence of Ameriks's 'moderate' interpretation of transcendental idealism, and chapters on will and the fact of reason, theodicy, religion, and post-Kantian developments (publisher abstract). SUBFIELD AND DEBATE: Theoretical and practical philosophy: development of the critical system, transcendental idealism (moderate interpretation), the fact of reason and religion. SIGNIFICANCE INDICATORS: S2 citations: 42 (retrieved 2026-09-30); CrossRef: 36. Publisher: Oxford University Press. NDPR: no review found in the NDPR sitemap. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2012-10.",
    keywords = "kant, tp-cpr, pp-ethics, religion, debate-other-transcendental-idealism, type-monograph, Medium",
    abstract = "*Kant's Elliptical Path* explores the main stages and key concepts in the development of Kant's Critical philosophy, from the early 1760s to the 1790s. Karl Ameriks provides a detailed and concise account of the main ways in which the later Critical works provide a plausible defence of the conception of humanity's fundamental end that Kant turned to after reading Rousseau in the 1760s. Separate essays are devoted to each of the three Critiques, as well as to earlier notes and lectures and several of Kant's later writings on history and religion. A final section devotes three chapters to post-Kantian developments in German Romanticism, accounts of tragedy up through Nietzsche, and contemporary philosophy. The theme of an elliptical path is shown to be relevant to these writers as well as to many aspects of Kant's own life and work. The topics of the book include fundamental issues in epistemology and metaphysics, with a new defense of the Amerik's 'moderate' interpretation of transcendental idealism. Other essays evaluate Kant's concept of will and reliance on a 'fact of reason' in his practical philosophy, as well as his critique of traditional theodicies, and the historical character of his defense of religion and the concepts of creation and hope within 'the boundaries of mere reason'. *Kant's Elliptical Path* will be of value to historians of modern philosophy and Kant scholars, while its treatment of several literary figures and issues in aesthetics, politics, history, and theology make it relevant to readers outside of philosophy.",
    abstract_source = "openalex"
}

@book{allison2012essays,
    author = "Allison, Henry E.",
    title = "Essays on Kant",
    publisher = "Oxford University Press",
    year = "2012",
    doi = "10.1093/acprof:oso/9780199647033.001.0001",
    note = "SUMMARY: Collection of seventeen previously published essays on Kant plus a new addendum, covering epistemology, metaphysics, moral theory, teleology, political philosophy, philosophy of history and religion, and centred on transcendental idealism, freedom of the will and the purposiveness of nature, with a comparative dimension relating Kant to predecessors, successors and present-day philosophers (publisher abstract). SUBFIELD AND DEBATE: Theoretical and practical philosophy: Allison's interpretation of transcendental idealism (two-aspect reading), freedom and the third Critique's purposiveness of nature. Collection dated by its 2012 publication; the essays were published earlier. SIGNIFICANCE INDICATORS: S2 citations: 38 (retrieved 2026-09-30); CrossRef: 43. NDPR review: yes (ndpr.nd.edu/reviews/essays-on-kant/). Publisher: Oxford University Press. SEP: not confirmed in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2012-06, online 2012-09; collection of previously published essays.",
    keywords = "kant, tp-cpr, pp-ethics, aes-teleo, debate-two-aspect, type-monograph, Medium",
    abstract = "Abstract This volume contains a collection of seventeen essays which have been previously published on Kant and an addendum to one of these essays that is here published for the first time. Although these essays cover virtually the full spectrum of the author's work on Kant, ranging from his epistemology, metaphysics, and moral theory to his views on teleology, political philosophy, the philosophy of history, and the philosophy of religion, most of them revolve around three basic themes: the nature of transcendental idealism, freedom of the will, and the purposiveness of nature. The first two of these have been the foci of the author's work on Kant since its inception and the essays dealing with them in this volume are intended as clarifications, elaborations, and further developments of what the author has said on these topics elsewhere. Among their major new elements is the introduction of a significant comparative dimension, which is intended both to place Kant's views in their historical context and to explore their contemporary relevance. To this end, Kant's views are contrasted with those of his major predecessors and immediate successors, as well as present‐day philosophers. The concept of the purposiveness of nature is the major contribution of the third Critique (Critique of the Power of Judgment) to Kant's “critical” philosophy and one the main concerns of the essays dealing with it is to demonstrate its central place in Kant's thought.",
    abstract_source = "openalex"
}

@book{parsons2012husserl,
    author = "Parsons, Charles",
    title = "From Kant to Husserl: Selected Essays",
    publisher = "Harvard University Press",
    year = "2012",
    doi = "10.4159/harvard.9780674065420",
    note = "SUMMARY: First of two volumes collecting Parsons's interpretive work: essays on Kant's philosophy of arithmetic, the relation of his arithmetical concepts to the categories, early reactions by Schultz and Bolzano, the first Critique and the Metaphysical Foundations of Natural Science, and a commentary on the Transcendental Aesthetic, followed by essays on Frege, Brentano and Husserl (publisher abstract; NDPR). SUBFIELD AND DEBATE: Philosophy of mathematics and science, and reception in early analytic philosophy and phenomenology: Kant's philosophy of arithmetic and the meaning of transcendental idealism, read through later logic and phenomenology. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 11; no S2 book-level record with a citation count located (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/from-kant-to-husserl-selected-essays/). SEP: listed in the kant-mathematics bibliography. Publisher: Harvard University Press. YEAR NOTE: CrossRef print and online date 2012-04; collection of previously published essays with new postscripts (per NDPR).",
    keywords = "kant, tp-science-math, recep-phenom, recep-analytic, type-monograph, Medium",
    abstract = "In From Kant to Husserl, Charles Parsons examines a wide range of historical opinion on philosophical questions, from mathematics to phenomenology. Amplifying his early ideas on Kant’s philosophy of arithmetic, Parsons uses Kant’s lectures on metaphysics to explore how his arithmetical concepts relate to the categories. He then turns to early reactions by two immediate successors of Kant, Johann Schultz and Bernard Bolzano, to shed light on disputed questions regarding interpretation of Kant’s philosophy of mathematics. Interested, as well, in what Kant meant by “pure natural science,” Parsons considers the relationship between the first Critique and the Metaphysical Foundations of Natural Science. His commentary on Kant’s Transcendental Aesthetic departs from mathematics to engage the vexed question of what it tells about the meaning of Kant’s transcendental idealism. Proceeding on to phenomenology, Parsons examines Frege’s evolving idea of extensions, his attitude toward set theory, and his correspondence, particularly exchanges with Russell and Husserl. An essay on Brentano brings out, in the case of judgment, an alternative to the now standard Fregean view of negation, and, on truth, alternatives to the traditional correspondence view that are still discussed today. Ending with the question of why Husserl did not take the “linguistic turn,” a final essay included here marks the only article-length discussion of Husserl Parsons has ever written, despite a long-standing engagement with this philosopher.",
    abstract_source = "openalex"
}

@book{hill2012virtue,
    author = "Hill, Jr., Thomas E.",
    title = "Virtue, Rules, and Justice: Kantian Aspirations",
    publisher = "Oxford University Press",
    year = "2012",
    doi = "10.1093/acprof:oso/9780199692002.001.0001",
    note = "SUMMARY: Essays interpreting and extending Kant's moral theory, introducing the major themes of Kantian ethics and applying them to questions about revolution, prison reform and forcible humanitarian intervention (publisher abstract); the NDPR review notes that all but one of the fifteen chapters were previously published. SUBFIELD AND DEBATE: Practical philosophy: Kantian ethics and its application in normative ethics and political theory; the volume develops Kantian positions as well as interpreting Kant. SIGNIFICANCE INDICATORS: S2 citations: 91 (retrieved 2026-09-30); CrossRef: 53. NDPR review: yes (ndpr.nd.edu/reviews/virtue-rules-and-justice-kantian-aspirations/). SEP: listed in the kant-moral bibliography and cited in a further-reading list. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2012-05; collection of essays mostly published earlier, some reprinted from 2008 (per SEP kant-moral).",
    keywords = "kant, pp-ethics, pp-mm-virtue, type-monograph, Medium",
    abstract = "The author interprets \\& extends Kant's moral theory in a series of essays that highlight its relevance to contemporary ethics. He introduces the major themes of Kantian ethics \\& explores its practical application to questions about revolution, prison reform, \\& forcible interventions in other countries for humanitarian purposes.",
    abstract_source = "openalex"
}

@book{sensen2012autonomy,
    editor = "Sensen, Oliver",
    title = "Kant on Moral Autonomy",
    publisher = "Cambridge University Press",
    year = "2012",
    url = "https://doi.org/10.1017/cbo9780511792489",
    note = "SUMMARY: Essays on Kant's conception of autonomy, its history, its influence on contemporary conceptions and its moral significance, with an introduction by the editor and a postscript by Onora O'Neill; the NDPR review counts fourteen essays offered in honour of O'Neill (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: autonomy and its relation to contemporary notions of autonomy. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 15 (book-level); S2 holds chapter-level records only (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/kant-on-moral-autonomy/). Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2012-12-13; online 2013-02.",
    keywords = "kant, pp-ethics, debate-other-autonomy, type-edited-volume, Medium",
    abstract = "The concept of autonomy is one of Kant's central legacies for contemporary moral thought. We often invoke autonomy as both a moral ideal and a human right, especially a right to determine oneself independently of foreign determinants; indeed, to violate a person's autonomy is considered to be a serious moral offence. Yet while contemporary philosophy claims Kant as the originator of its notion of autonomy, Kant's own conception of the term seems to differ in important respects from our present-day interpretation. Kant on Moral Autonomy brings together a distinguished group of scholars who explore the following questions: what is Kant's conception of autonomy? What is its history and its influence on contemporary conceptions? And what is its moral significance? Their essays will be of interest both to scholars and students working on Kantian moral philosophy and to anyone interested in the subject of autonomy.",
    abstract_source = "openalex"
}

@book{ellis2012political,
    editor = "Ellis, Elisabeth",
    title = "Kant's Political Theory: Interpretations and Applications",
    publisher = "Penn State University Press",
    year = "2012",
    doi = "10.5325/j.ctt7v26b",
    note = "SUMMARY: Nine essays that aim to introduce Kant's political thought to a new generation of readers and to show the fruitfulness of a broadly Kantian approach: five (O'Neill, Ripstein, Pogge, Hodgson, Taylor) read the Doctrine of Right and political essays, and four (Ferguson, Hunter, LaVaque-Manty, Laursen) draw on Kant's other writings or historical context (NDPR). SUBFIELD AND DEBATE: Political and legal philosophy: Kant's Doctrine of Right, political essays and their contemporary applications. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 0; S2 record shows 1 (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/kant-s-political-theory-interpretations-and-applications/). SEP: listed in the kant-social-political bibliography. Publisher: Penn State University Press. YEAR NOTE: CrossRef print year 2012.",
    keywords = "kant, pp-right-politics, type-edited-volume, Low, INCOMPLETE, no-abstract"
}

@article{teufel2012judgement,
    author = "Teufel, Thomas",
    title = "What Does Kant Mean by 'Power of Judgement' in his Critique of the Power of Judgement?",
    journal = "Kantian Review",
    year = "2012",
    volume = "17",
    number = "2",
    pages = "297--326",
    doi = "10.1017/s1369415412000076",
    note = "SUMMARY: Argues that the 'power of judgement' in the title of the third Critique refers only to the reflecting power of judgement, because Kant attempts a Critical justification of that power alone and a transcendentally grounded determining power is systematically impossible, and that Kant's discussion in sections 76-77 addresses the problem of synthesizing unsynthesized intuitions, so that the systematic ambitions of the third Critique are appropriate (abstract). SUBFIELD AND DEBATE: Aesthetics and teleology: the unity and systematic role of the Critique of the Power of Judgment, the reflecting power of judgement and its relation to the first Critique. SIGNIFICANCE INDICATORS: S2 citations: 139 (retrieved 2026-09-30; the S2 and CrossRef counts differ widely); CrossRef: 7. Venue: Kantian Review. SEP: not found in the retrieved kant-aesthetics bibliography. YEAR NOTE: CrossRef gives online date 2012-06-08 (volume 17, issue 2, 2012) and no print date.",
    keywords = "kant, aes-teleo, tp-cpr, type-article, Low",
    abstract = "Abstract The notion of ‘power of judgement’ in the title of Kant'sCritique of the Power of Judgementis commonly taken to refer to a cognitive power inclusive of both determining judgement and reflecting judgement. I argue, first, that this seemingly innocuous view is in conflict both with the textual fact that Kant attempts a Critical justification of the reflecting power of judgement – only – and with the systematic impossibility of a transcendentally grounded determining power of judgement. The conventional response to these difficulties is to point out that, Kant's systematic ambitions in the thirdCritiquenotwithstanding, reflection, qua concept-forming synthesis, is too closely tied to determination to be a cognitive power in its own right. I argue, second, that this response is question-begging, since the notion of reflection it employs is not only not one central to the thirdCritiquebut one antecedently tied to the understanding. I argue, third, that Kant's discussion, in the pivotal § § 76–7, of our cognitive relation to sensible particularity addresses an epistemic problem present (but not raised) in theCritique of Pure Reason. This is the problem of the synthesizability, qua absolute unity, of unsynthesized intuitions. Solving this problem requires Critical justification of a principle of reflection. It follows that Kant's systematic ambitions in the thirdCritiqueare appropriate. Given the problem Kant seeks to address, he must offer what he takes himself to be offering: aCritique of the(Reflecting)Power of Judgement.",
    abstract_source = "openalex"
}

@book{kant2012natural,
    author = "Kant, Immanuel",
    editor = "Watkins, Eric",
    title = "Natural Science",
    publisher = "Cambridge University Press",
    year = "2012",
    series = "The Cambridge Edition of the Works of Immanuel Kant",
    doi = "10.1017/cbo9781139014380",
    note = "SUMMARY: New English translations of Kant's early natural-science writings, including his first publication, Thoughts on the True Estimation of Living Forces, the Universal Natural History and Theory of the Heavens (1755) and the whole of Physical Geography, with editorial introductions, explanatory notes and a glossary; NDPR notes that some texts appear in English for the first time (publisher abstract; NDPR). SUBFIELD AND DEBATE: Edition and translation: Kant's pre-critical natural philosophy, physical geography and cosmology (Cambridge Edition volume, editor Eric Watkins). SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 44 (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/natural-science/). SEP: listed as a Cambridge Edition volume in the kant and kant-development bibliographies. Publisher: Cambridge University Press. YEAR NOTE: Translation of texts of 1746 to 1802; CrossRef print date 2012-10, online 2012-11.",
    keywords = "kant, edition-trans, precritical, tp-science-math, type-translation-edition, High",
    abstract = "Though Kant is best known for his strictly philosophical works in the 1780s, many of his early publications in particular were devoted to what we would call 'natural science'. Kant's Universal Natural History and Theory of the Heavens (1755) made a significant advance in cosmology, and he was also instrumental in establishing the newly emerging discipline of physical geography, lecturing on it for almost his entire career. In this volume Eric Watkins brings together new English translations of Kant's first publication, Thoughts on the True Estimation of Living Forces (1746–1749), the entirety of Physical Geography (1802), a series of shorter essays, along with many of Kant's most important publications in natural science. The volume is rich in material for the student and the scholar, with extensive linguistic and explanatory notes, editorial introductions and a glossary of key terms.",
    abstract_source = "openalex"
}

@book{kant2012anthropology,
    author = "Kant, Immanuel",
    editor = "Louden, Robert B. and Wood, Allen W.",
    title = "Lectures on Anthropology",
    publisher = "Cambridge University Press",
    year = "2012",
    doi = "10.1017/cbo9781139028639",
    note = "SUMMARY: First translation of selections from student transcriptions of Kant's anthropology lectures of 1772-1789, made before the published Anthropology from a Pragmatic Point of View (1798), presenting Anthropology Friedländer (1772) and Anthropology Mrongovius (1786) in full together with selections from the other transcriptions and parts of the Menschenkunde, and showing Kant's empirical theory of human nature (publisher abstract; NDPR). SUBFIELD AND DEBATE: Edition and translation; anthropology and human nature: source texts for Kant's empirical theory of human nature, its bearing on moral psychology and history,. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 108 (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/lectures-on-anthropology/). SEP: not found in the retrieved bibliographies. Publisher: Cambridge University Press. YEAR NOTE: Translation of student transcriptions of lectures of 1772-1789; CrossRef print date 2012-12-20, online 2013-04.",
    keywords = "kant, edition-trans, anthro-hist-edu, type-translation-edition, High",
    abstract = "Kant was one of the inventors of anthropology, and his lectures on anthropology were the most popular and among the most frequently given of his lecture courses. This volume contains the first translation of selections from student transcriptions of the lectures between 1772 and 1789, prior to the published version, Anthropology from a Pragmatic Point of View (1798), which Kant edited himself at the end of his teaching career. The two most extensive texts, Anthropology Friedländer (1772) and Anthropology Mrongovius (1786), are presented here in their entirety, along with selections from all the other lecture transcriptions published in the Academy edition, together with sizeable portions of the Menschenkunde (1781–2), first published in 1831. These lectures show that Kant had a coherent and well-developed empirical theory of human nature bearing on many other aspects of his philosophy, including cognition, moral psychology, politics and philosophy of history.",
    abstract_source = "openalex"
}

@book{forster2012twentyfive,
    author = "Förster, Eckart",
    title = "The Twenty-Five Years of Philosophy: A Systematic Reconstruction",
    publisher = "Harvard University Press",
    year = "2012",
    doi = "10.4159/harvard.9780674064980",
    note = "SUMMARY: Follows the Kantian idea that philosophy can be scientific and complete from the Critique of Pure Reason (1781) to Hegel (1806), and argues that Kant's three Critiques yield a distinction between intellectual intuition and intuitive understanding, which explains two post-Kantian lines of development (Fichte's Wissenschaftslehre, and Goethe's transformation of intuitive understanding in light of Spinoza) that are joined in Hegel (publisher abstract; NDPR). SUBFIELD AND DEBATE: Reception: Kant, Fichte, Schelling, Goethe and Hegel; the development of German idealism from the critical philosophy. SIGNIFICANCE INDICATORS: S2 citations: 66 (retrieved 2026-09-30); CrossRef: 117. NDPR review: yes (ndpr.nd.edu/reviews/the-twenty-five-years-of-philosophy-a-systematic-reconstruction/). SEP: listed in the kant-transcendental-idealism bibliography (translated by B. Bowman). Publisher: Harvard University Press. YEAR NOTE: CrossRef print and online date 2012-04.",
    keywords = "kant, recep-idealism, tp-cpr, type-monograph, High",
    abstract = "Kant declared that philosophy began in 1781 with his Critique of Pure Reason. In 1806 Hegel announced that philosophy had now been completed. Eckart Förster examines the reasons behind these claims and assesses the steps that led in such a short time from Kant’s “beginning” to Hegel’s “end.” He concludes that, in an unexpected yet significant sense, both Kant and Hegel were indeed right. The Twenty-Five Years of Philosophy follows the unfolding of a key idea during this exceptionally productive period: the Kantian idea that philosophy can be scientific and, consequently, can be completed. Förster’s study combines historical research with philosophical insight and leads him to propose a new thesis. The development of Kant’s transcendental philosophy in his three Critiques, Förster claims, resulted in a fundamental distinction between “intellectual intuition” and “intuitive understanding.” Overlooked until now, this distinction yields two takes on how to pursue philosophy as science after Kant. One line of thought culminates in Fichte’s theory of freedom (Wissenschaftslehre), while the other—and here Förster brings Goethe’s significance to the fore—results in Goethe's transformation of the Kantian idea of an intuitive understanding in light of Spinoza's third kind of knowledge. Both strands are brought together in Hegel and propel his split from Schelling. Förster’s work makes an original contribution to our understanding of the classical era of German philosophy—an expanding interest within the Anglophone philosophical community.",
    abstract_source = "openalex"
}

@book{sedgwick2012hegel,
    author = "Sedgwick, Sally",
    title = "Hegel's Critique of Kant: From Dichotomy to Identity",
    publisher = "Oxford University Press",
    year = "2012",
    doi = "10.1093/acprof:oso/9780199698363.001.0001",
    note = "SUMMARY: Presents Hegel's critique of Kant's theoretical philosophy, arguing that Hegel offers a critique of and alternative to the conception of cognition Kant defended in the critical period, and exploring Hegel's claim to derive from Kantian doctrines the clues to a superior form of idealism (publisher abstract; NDPR). SUBFIELD AND DEBATE: Reception: Hegel's critique of Kant's theory of cognition (the dichotomies of the critical philosophy) and the transition to Hegelian idealism. SIGNIFICANCE INDICATORS: S2 citations: 39 on the title-matched record (retrieved 2026-09-30); CrossRef: 42. NDPR review: yes (ndpr.nd.edu/reviews/hegel-s-critique-of-kant-from-dichotomy-to-identity/). SEP: not found in the retrieved bibliographies. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2012-03.",
    keywords = "kant, recep-idealism, tp-cpr, type-monograph, Medium",
    abstract = "Sally Sedgwick presents an account of Hegel's critique of Kant's theoretical philosophy. She argues that Hegel offers a critique of and alternative to the conception of cognition that Kant defended in his 'critical' period, and explores Hegel's claim to derive from Kantian doctrines clues to a superior form of idealism.",
    abstract_source = "openalex"
}

@article{gray2012race,
    author = "Gray, Sally Hatch",
    title = "Kant's Race Theory, Forster's Counter, and the Metaphysics of Color",
    journal = "The Eighteenth Century",
    year = "2012",
    volume = "53",
    number = "4",
    pages = "393--412",
    doi = "10.1353/ecy.2012.0032",
    note = "SUMMARY: Argues that Kant's race theory is an integral part of his idea of nature in the Critique of the Power of Judgment, examining the 1785-86 debate between Kant and Georg Forster over race and showing that Kant developed his teleological conception of nature partly to give his race theory a unifying basis that could withstand Forster's empiricism; concludes that the nature of the third Critique supports a universal cosmopolitanism but veils a particular European perspective that allows a damaging global authority on difference (abstract). SUBFIELD AND DEBATE: Race and anthropology: Kant's race theory in relation to the third Critique and Forster's critique. One of few 2010-2012 items in the Kant-and-race discussion located in the searches. SIGNIFICANCE INDICATORS: S2 citations: 19 (retrieved 2026-09-30); CrossRef: 15. Venue: The Eighteenth Century. No review or encyclopedia evidence found. Included mainly to represent the Kant-and-race discussion in the year.",
    keywords = "kant, anthro-hist-edu, aes-teleo, debate-race, type-article, Low",
    abstract = {This article argues for an understanding of Kant's race theory as an integral part of his idea of nature and of humans in nature as presented in his Critique of the Power of Judgment (Kritik der Urteilskraft, 1790). It places an examination of Kant and Forster's debate over race, which was ignited in 1785 upon the publication of Kant's second essay on race, "Definition of a Concept of a Human Race" ("Bestimmung des Begriffs einer Menschenrace"), in the context of an illumination of the connections between aesthetics and anthropology in Kant's Observations on the Feeling of the Beautiful and Sublime (Beobachtungen über das Gefühl des Schönen und Erhabenen, 1764) and Forster's Voyage round the World (Reise um die Welt 1777). Forster responded to Kant's new "race" classifications, which were based essentially on skin color, with "Still More about the Human Races" ("Noch etwas über Menschenraßen," 1786). This article shows that Kant then developed his scientific theory and his idea of a teleological nature as presented in his Critique of the Power of Judgment, at least in part, in order to provide a unifying theoretical basis for his race theory so that it could withstand the scrutiny of an empirical scientific method based on deductive logic, such as that advanced by Forster. While Forster's strict empiricism, perspectivism, and rejection of "race" as a scientific classification reflect an underlying, distinctly modern, concept of the natural world, Kant's nature, as presented in his third Critique, reveals a metaphysically-based structure supporting a universal cosmopolitanism, but veils a particular European perspective that allows a damaging global authority on difference.},
    abstract_source = "openalex"
}

@book{friedman2013construction,
    author = {Friedman, Michael},
    title = {Kant's Construction of Nature: A Reading of the Metaphysical Foundations of Natural Science},
    publisher = {Cambridge University Press},
    year = {2013},
    url = {https://doi.org/10.1017/cbo9781139014083},
    note = {SUMMARY: Develops a new and complete reading of Kant's Metaphysical Foundations of Natural Science (1786), reconstructing its main argument in detail and explaining its relationship to Newton's Principia and to eighteenth-century scientific thinkers such as Euler and Lambert; by situating the text against Kant's pre-critical writings and the changes made to the second edition of the Critique of Pure Reason, it argues for a new perspective on the meaning and development of the critical philosophy as a whole (publisher abstract). SUBFIELD AND DEBATE: Philosophy of science and the critical system: Kant's natural philosophy and its relation to Newtonian physics and to the first Critique. No single named debate; a book-length reading of the Metaphysical Foundations. SIGNIFICANCE INDICATORS: S2 citations: 75 on the title-matched record (retrieved 2026-09-30; a second S2 record carrying the CUP DOI shows 19); CrossRef is-referenced-by-count: 108. SEP: listed in the kant, kant-leibniz, kant-reason and kant-science bibliographies. Journal review: Journal of the History of Philosophy (Sutherland, 2016; CrossRef). NDPR: no review found. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2013-01-17, online 2013-02.},
    keywords = {kant, tp-science-math, tp-cpr, type-monograph, High},
    abstract = {Kant's Metaphysical Foundations of Natural Science is one of the most difficult but also most important of Kant's works. Published in 1786 between the first (1781) and second (1787) editions of the Critique of Pure Reason, the Metaphysical Foundations occupies a central place in the development of Kant's philosophy, but has so far attracted relatively little attention compared with other works of Kant's critical period. Michael Friedman's book develops a new and complete reading of this work and reconstructs Kant's main argument clearly and in great detail, explaining its relationship to both Newton's Principia and eighteenth-century scientific thinkers such as Euler and Lambert. By situating Kant's text relative to his pre-critical writings on metaphysics and natural philosophy and, in particular, to the changes Kant made in the second edition of the Critique, Friedman articulates a radically new perspective on the meaning and development of the critical philosophy as a whole.},
    abstract_source = {openalex},
}

@article{tolley2013nonconceptuality,
    author = {Tolley, Clinton},
    title = {The Non-Conceptuality of the Content of Intuitions: A New Approach},
    journal = {Kantian Review},
    year = {2013},
    volume = {18},
    number = {1},
    pages = {107--136},
    doi = {10.1017/s1369415412000313},
    note = {SUMMARY: Argues that Kant takes intuitions to have content in the sense of Frege's Sinn (a mode of presentation of an object or property) and that this content is distinct in kind from the content of concepts. The paper holds that the conceptualism debate had stalled for lack of agreement on what 'content' means, and shows how this non-conceptualist account answers the most serious objections to earlier non-conceptualist readings (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: Kant's theory of intuition and mental content; conceptualism versus nonconceptualism. SIGNIFICANCE INDICATORS: S2 citations: 75 (retrieved 2026-09-30); CrossRef: 40. Venue: Kantian Review. SEP: listed in the kant-judgment and kant-spacetime bibliographies. YEAR NOTE: CrossRef print date 2013-03, online 2013-02.},
    keywords = {kant, tp-mind, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {Abstract There has been considerable recent debate about whether Kant's account of intuitions implies that their content is conceptual. This debate, however, has failed to make significant progress because of the absence of discussion, let alone consensus, as to the meaning of ‘content’ in this context. Here I try to move things forward by focusing on the kind of content associated with Frege's notion of ‘sense (Sinn)’, understood as a mode of presentation of some object or property. I argue, first, that Kant takes intuitions to have a content in this sense, and, secondly, that Kant clearly takes the content of intuitions, so understood, to be distinct in kind from that possessed by concepts. I then show how my account can respond to the most serious objections to previous non-conceptualist interpretations.},
    abstract_source = {openalex},
}

@article{marshall2013quaobjects,
    author = {Marshall, Colin},
    title = {Kant's Appearances and Things in Themselves as Qua-Objects},
    journal = {The Philosophical Quarterly},
    year = {2013},
    volume = {63},
    number = {252},
    pages = {520--545},
    doi = {10.1111/1467-9213.12060},
    note = {SUMMARY: Proposes understanding Kant's appearance/thing-in-itself distinction through an Aristotelian notion of a 'qua-object' (following Kit Fine), which gives a sense in which appearances and things in themselves can be the same things while differing in many of their features. The proposal is offered to the one-world interpretation of Kant's idealism, which faces problems arising from the different features Kant assigns to the two (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: transcendental idealism; one-world (two-aspect) readings against two-world readings of the appearance/thing-in-itself distinction. SIGNIFICANCE INDICATORS: S2 citations: 16 (retrieved 2026-09-30); CrossRef: 13. Venue: The Philosophical Quarterly. SEP: listed in the kant-transcendental-idealism bibliography. YEAR NOTE: CrossRef print date 2013-07, online 2013-06.},
    keywords = {kant, tp-cpr, debate-two-aspect, type-article, Medium},
    abstract = {The one‐world interpretation of Kant's idealism holds that appearances and things in themselves are, in some sense, the same things. Yet this reading faces a number of problems, all arising from the different features Kant seems to assign to appearances and things in themselves. I propose a new way of understanding the appearance/thing in itself distinction via an Aristotelian notion that I call, following Kit Fine, a ‘qua‐object.’ Understanding appearances and things in themselves as qua‐objects provides a clear sense in which they can be the same things while differing in many of their features.},
    abstract_source = {openalex},
}

@article{watkins2013newtonianism,
    author = {Watkins, Eric},
    title = {The Early Kant's (Anti-) Newtonianism},
    journal = {Studies in History and Philosophy of Science Part A},
    year = {2013},
    volume = {44},
    number = {3},
    pages = {429--437},
    doi = {10.1016/j.shpsa.2012.10.015},
    note = {SUMMARY: Argues that the pre-critical Kant, besides using 'Newtonian principles' in the Universal Natural History, developed a major criticism of Newton based on subtle metaphysical issues about God, with implications for how the formation and constitution of the heavenly bodies should be scientifically explained. The abstract adds that Kant remained interested in these issues later, in the Critical period (abstract from CORE). SUBFIELD AND DEBATE: Pre-critical work and philosophy of science: Kant's early relation to Newtonian physics and natural theology. Part of the special issue of Studies in History and Philosophy of Science 44(3) introduced by Massimi as 'Philosophy of natural science from Newton to Kant' (per CrossRef titles of the issue). SIGNIFICANCE INDICATORS: S2 citations: 37 (retrieved 2026-09-30); CrossRef: 35. Venue: Studies in History and Philosophy of Science Part A. SEP: listed in the kant-science bibliography. The same issue carries papers by Stan, Schliesser, Smith, Massimi and De Bianchi, DiSalle and Domski (CrossRef). YEAR NOTE: CrossRef print date 2013-09 (issue 44(3)).},
    keywords = {kant, precritical, tp-science-math, type-article, Medium},
    abstract = {It is well known that during his pre-Critical period, Kant was a major proponent of Newtonian physics, for the project of the Universal Natural History explicitly uses "Newtonian principles" to explain the formation of the various bodies that constitute our solar system as well as those that lie beyond. What has not been widely noted, however, is that the early Kant also developed a major criticism of Newton, one that is based on subtle metaphysical issues pertaining to God, which are most at home in philosophical theology. Interestingly, this criticism is neither an inchoate precursor of his later criticisms of Newton's account of absolute space, nor isolated to the abstract realm of metaphysics, but has a wide range of implications for the way in which a scientific account of the formation and constitution of the heavenly bodies ought to be developed, that is, for the kind of argument Newton offered in the Principia. That Kant remained interested in this set of issues later in his Critical period suggests that, alongside the revolutionary changes that comprise transcendental idealism, there are deep continuities not only in his Newtonian commitments, but in his anti-Newtonian tendencies as well. © 2012 Elsevier Ltd},
    abstract_source = {core}
}

@book{grenberg2013common,
    author = {Grenberg, Jeanine},
    title = {Kant's Defense of Common Moral Experience: A Phenomenological Account},
    publisher = {Cambridge University Press},
    year = {2013},
    doi = {10.1017/cbo9781139520126},
    note = {SUMMARY: Argues that everything important in Kant's moral philosophy emerges from reflection on the common human experience of the conflict between happiness and morality. Through readings of the Groundwork and the Critique of Practical Reason she finds a phenomenological notion of experience in Kant's account of the Fact of Reason and gives feeling an epistemic role in grounding a priori morality, against readings that assign feeling only a motivational role and against Fichtean readings (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: Groundwork III and the Critique of Practical Reason; the Fact of Reason and the role of moral feeling. NDPR also reports a new interpretation of the failure of the Groundwork III argument for moral obligation. SIGNIFICANCE INDICATORS: S2 citations: 44 (retrieved 2026-09-30); CrossRef: 46. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-defense-of-common-moral-experience-a-phenomenological-account/). Other reviews: Journal of the History of Philosophy (Denis, 2015), Dialogue (Way, 2015), Kantian Review (Sticker, 2014). SEP: not found in the retrieved bibliographies. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2013-07-18, online 2013-07.},
    keywords = {kant, pp-ethics, type-monograph, Medium},
    abstract = {In this book, Jeanine Grenberg argues that everything important about Kant's moral philosophy emerges from careful reflection upon the common human moral experience of the conflict between happiness and morality. Through careful readings of both the Groundwork and the Critique of Practical Reason, Grenberg shows that Kant, typically thought to be an overly technical moral philosopher, in fact is a vigorous defender of the common person's first-personal encounter with moral demands. Grenberg uncovers a notion of phenomenological experience in Kant's account of the Fact of Reason, develops a new a reading of the Fact, and grants a moral epistemic role for feeling in grounding Kant's a priori morality. The book thus challenges readings which attribute only a motivational role to feeling; and Fichtean readings which violate Kant's commitments to the limits of reason. This study will be valuable to students and scholars engaged in Kant studies.},
    abstract_source = {openalex},
}

@article{wuerth2013sense,
    author = {Wuerth, Julian},
    title = {Sense and Sensibility in Kant's Practical Agent: Against the Intellectualism of Korsgaard and Sidgwick},
    journal = {European Journal of Philosophy},
    year = {2013},
    volume = {21},
    number = {1},
    pages = {1--36},
    url = {https://doi.org/10.1111/j.1468-0378.2010.00432.x},
    note = {SUMMARY: Presents Kant's account of practical agency as embodied agency, drawing on his empirical-psychological and metaphysical descriptions, and argues against the intellectualized interpretations of Kant's practical agent offered by Korsgaard and Sidgwick. On this reading the agent chooses from a reflective distance but not from the complete affective distance of reason alone, and its sensibility (sense, feeling, desire) belongs to the agent that chooses (abstract). SUBFIELD AND DEBATE: Practical philosophy: moral psychology and the theory of action; critique of intellectualist readings (Korsgaard, Sidgwick). Carry-forward from Domain 1 (EJP 21(1)). SIGNIFICANCE INDICATORS: S2 citations: 19 (retrieved 2026-09-30); CrossRef: 24. Venue: European Journal of Philosophy. SEP: listed in the kant-mind bibliography. YEAR NOTE: CrossRef print date 2013-03 (volume 21, issue 1); online-first 2010-09-26, which is why S2 lists 2010.},
    keywords = {kant, pp-ethics, tp-mind, debate-other-intellectualism, type-article, Medium},
    abstract = {Abstract: Drawing on a wide range of Kant's recorded thought beyond his Groundwork for the Metaphysics of Morals, this essay presents an overview of Kant's account of practical agency as embodied practical agency and argues against the intellectualized interpretations of Kant's account of practical agency presented by Christine Korsgaard and Henry Sidgwick. In both Kant's empirical‐psychological and metaphysical descriptions of practical agency, he presents a recognizably human practical agent that is broader and deeper than the faculty of reason alone. This agent chooses action from a reflective distance, but not from the complete affective distance of reason. We choose neither as reason alone, nor even as the sum of all of our ‘higher’ faculties, of cognition (including reason), feeling, and desire, in Kant's view. Instead, we choose as an agent that also has ‘lower’, ‘sensible’ faculties, of cognition (including sense), feeling, and desire, which together comprise our ‘sensibility’. These mental states of sensibility are not merely confused versions of our higher cognitions, feelings, or desires, and so different from them in degree only, but are instead distinct from our higher states in kind also; and these distinct sensible states are not dependent on our higher states and so on a commitment to the value of humanity, for example. For this reason, a choice in favour of sensible states and in opposition to the moral law need in no way undermine its own foundations and thus be incoherent, as Korsgaard and Sidgwick argue, but instead only immoral. Because Kant does not reduce the problem of immoral choice to one of insufficient reflection and ensuing confusion, he does not view moral progress in cognitive terms alone, whether in the form of a clearer understanding of the moral law, improved judgment in applying it, or deeper insight into our own nature as practical agents. Kant instead recognizes the crucial importance of cultivating our feelings and desires over the course of a lifetime both as a way to make ourselves worthy of the humanity within us directly and also as a way to facilitate future moral choices.},
    abstract_source = {openalex},
}

@book{trampota2013tugendlehre,
    editor = {Trampota, Andreas and Sensen, Oliver and Timmermann, Jens},
    title = {Kant's ‘Tugendlehre’: A Comprehensive Commentary},
    publisher = {De Gruyter},
    year = {2013},
    doi = {10.1515/9783110229875},
    note = {SUMMARY: Running commentary on the Doctrine of Virtue (Tugendlehre) of the Metaphysics of Morals by 18 scholars from Germany, Italy, Britain and the United States, discussing topics such as suicide, truthfulness, moral perfection, beneficence, gratitude, sympathy, respect and friendship as well as Kant's moral psychology (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy: Metaphysics of Morals, Doctrine of Virtue; the abstract presents the volume as a response to recent interest in Kant's later ethical work. SIGNIFICANCE INDICATORS: S2 citations: 72 (retrieved 2026-09-30); CrossRef: 9. SEP: a 'Kant's Tugendlehre: A Commentary' entry is listed in the kant-moral bibliography. Review: Kant-Studien (Wittwer, 2016; CrossRef). NDPR: no review found. Publisher: De Gruyter. YEAR NOTE: CrossRef print and online date 2013-01-18 (S2 also 2013); the SEP kant-moral bibliography dates its entry 2011.},
    keywords = {kant, pp-mm-virtue, type-edited-volume, Medium},
    abstract = {Building on the results of the Groundwork and the Critique of Practical Reason , Kant finally published his system of moral philosophy in two volumes in 1797. By then, he had been planning to write a Metaphysics of Morals for three decades; but only the title remained unchanged while the basic principles of his theoretical and practical philosophy changed dramatically. While for many years academic moral philosophy focused mainly on Kant’s earlier ethical treatises, there has recently been much interest in this later and perhaps more mature work on moral philosophy, particularly the ethical part of the Metaphysics of Morals, the “Metaphysical Principles of the Doctrine of Virtue” or “Tugendlehre”. The present volume responds to these demands. Following a series of research workshops, 18 scholars from Germany, Italy, Britain and the United States provide a seamless commentary on the “Doctrine of Virtue”, discussing topics such as suicide, truthfulness, moral perfection, beneficence, gratitude, sympathy, respect and friendship as well as Kant’s moral psychology, philosophy of action and theory of moral education. This book will be an invaluable resource for moral philosophers and Kant scholars alike.},
    abstract_source = {openalex},
}

@book{hay2013feminism,
    author = {Hay, Carol},
    title = {Kantianism, Liberalism, and Feminism: Resisting Oppression},
    publisher = {Palgrave Macmillan UK},
    year = {2013},
    doi = {10.1057/9781137003904},
    note = {SUMMARY: Argues that the moral and political frameworks of Kantianism and liberalism are indispensable for addressing the concerns of contemporary feminism. NDPR reports that the first chapters lay out a Kantian feminist theory of oppression as group-specific, systemic harm and that the later chapters apply it to issues of sexual oppression (publisher abstract, truncated; NDPR). SUBFIELD AND DEBATE: Kant and gender: Kantian feminist theory of oppression. The book is a constructive Kantian account rather than an exegesis; NDPR raises questions of Kant interpretation and suggests the Doctrine of Right be made more central to it (included under the plan's gender coverage, with that Kant-centrality caveat). SIGNIFICANCE INDICATORS: S2 citations: 38 (retrieved 2026-09-30); CrossRef: 50. NDPR review: yes (ndpr.nd.edu/reviews/kantianism-liberalism-and-feminism-resisting-oppression/). Other reviews: Kantian Review (Huseyinzadegan, 2015), Hypatia Reviews Online (Silvermint, 2014), Journal of Moral Philosophy (Williamson, 2016). SEP: listed in the kant-social-political bibliography. Publisher: Palgrave Macmillan. YEAR NOTE: CrossRef gives 2013 (print).},
    keywords = {kant, pp-right-politics, debate-gender, type-monograph, Low},
    abstract = {In this book Hay argues that the moral and political frameworks of Kantianism and liberalism are indispensable for addressing the concerns of contemporary feminism. After defending the use of these fr},
    abstract_source = {openalex},
}

@book{mensch2013organicism,
    author = {Mensch, Jennifer},
    title = {Kant's Organicism: Epigenesis and the Development of Critical Philosophy},
    publisher = {University of Chicago Press},
    year = {2013},
    doi = {10.7208/chicago/9780226022031.001.0001},
    note = {SUMMARY: Argues that the concept of epigenesis, a theory of biological formation, was not merely a metaphor for Kant but guided his critical philosophy, especially the relationship between reason and the categories of the understanding. Combining a study of Kant's theory of cognition with intellectual history and biography, it places the epigenesis of reason within eighteenth-century theories of generation, genealogy and classification (University of Chicago Press description returned by web search). SUBFIELD AND DEBATE: Kant and the life sciences: epigenesis, natural history and the development of the critical philosophy (Critique of Pure Reason). SIGNIFICANCE INDICATORS: S2 citations: 15 on the DOI-matched record (retrieved 2026-09-30); CrossRef: 73. Reviews: Kantian Review (Zammito, 2014), Isis (Steigerwald, 2014), German Studies Review (2015), Graduate Faculty Philosophy Journal (Berk, 2013), Goethe Yearbook (Effinger, 2016); S2 also lists a review in Critical Philosophy of Race. NDPR: no review found. SEP: not found in the retrieved bibliographies. Publisher: University of Chicago Press. YEAR NOTE: CrossRef gives 2013 (print).},
    keywords = {kant, aes-teleo, tp-cpr, type-monograph, Medium, INCOMPLETE, no-abstract, summary-source-publisher-web}
}

@article{matherne2013aesthetic,
    author = {Matherne, Samantha},
    title = {The Inclusive Interpretation of Kant's Aesthetic Ideas},
    journal = {The British Journal of Aesthetics},
    year = {2013},
    volume = {53},
    number = {1},
    pages = {21--39},
    url = {https://doi.org/10.1093/aesthj/ays058},
    note = {SUMMARY: Offers an 'inclusive interpretation' of the aesthetic ideas of the Critique of the Power of Judgment, on which they can present not only moral and purely rational concepts (as restrictive readings hold) but also empirical concepts and emotions related to ordinary experience. The article argues that this neglected class matters for Kant's views of artistic production, of the experience of art and of the value of art for ordinary experience (abstract). SUBFIELD AND DEBATE: Aesthetics: Kant's theory of artistic expression; responds to restrictive interpretations of aesthetic ideas. Carry-forward from Domain 1 (BJA 53(1)). SIGNIFICANCE INDICATORS: S2 citations: 52 (retrieved 2026-09-30); CrossRef: 35. Venue: British Journal of Aesthetics. SEP: listed in the kant-aesthetics bibliography. YEAR NOTE: CrossRef print date 2013-01-01 (volume 53, issue 1); online-first 2012-11-25.},
    keywords = {kant, aes-teleo, type-article, Medium},
    abstract = {In the Critique of the Power of Judgment, Kant offers a theory of artistic expression in which he claims that a work of art is a medium through which an artist expresses an ‘aesthetic idea’. While Kant’s theory of aesthetic ideas often receives rather restrictive interpretations, according to which aesthetic ideas can either present only moral concepts, or only moral concepts and purely rational concepts, in this article I offer an ‘inclusive interpretation’ of aesthetic ideas, according to which they can present not only moral and purely rational concepts but also empirical concepts and emotions related to our ordinary experience. Although this latter class of experience-oriented aesthetic ideas has been neglected, I argue that recognizing the role it plays in Kant’s account is crucial for understanding his views not only of artistic production and our experience of art but also of the value he takes art to have for our ordinary experience of the world, others, and our own selves. What is more, insofar as the inclusive interpretation brings to light Kant’s acknowledgement of the close connection between experience and art, it reveals that his overall view of art is more plausible than is often thought, and recommends it as worthy of further consideration.},
    abstract_source = {openalex},
}

@book{insole2013creation,
    author = {Insole, Christopher J.},
    title = {Kant and the Creation of Freedom: A Theological Problem},
    publisher = {Oxford University Press},
    year = {2013},
    doi = {10.1093/acprof:oso/9780199677603.001.0001},
    note = {SUMMARY: Argues that Kant struggled with how to conceive God's creative action in relation to human freedom and concluded that freedom can be protected only if God withdraws in certain ways from the created world. His rejection of the medieval and early modern account of divine concursus is said to shape transcendental idealism and his theory of freedom and to explain otherwise incomprehensible claims of the critical philosophy (publisher abstract). SUBFIELD AND DEBATE: Religion and metaphysics: Kant's philosophical theology (creation, divine action) and its role in transcendental idealism and freedom. SIGNIFICANCE INDICATORS: S2 citations: 31 (retrieved 2026-09-30); CrossRef: 32. SEP: listed in the kant-religion bibliography. Reviews: Journal of the History of Philosophy (2014), Journal of Theological Studies (Lee, 2014), Theology (Pasternack, 2015), Studies in Christian Ethics (Adams, 2015); the author's reply to Terry Godlove appeared in International Journal for Philosophy of Religion (2014). NDPR: no review found. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2013-05-30, online 2013-09.},
    keywords = {kant, religion, tp-cpr, type-monograph, Medium},
    abstract = {Abstract Kant actively struggles with the problem of how to conceive of God’s creative action in relation to human freedom. Kant comes to the view that human freedom can only be protected if God withdraws in certain ways from the created world. The two pillars of Kant’s mature philosophy—transcendental idealism and freedom—are in part shaped and motivated by Kant’s need to provide a solution to his theological problem. The medieval and early modern theological tradition conceives of divine action as unlike the action of any created being. When the creature acts, God directly causes this action, but without reducing the creature’s freedom. Kant explicitly discusses and rejects this account of divine and human concursus. This rejection has significant and surprising ramifications for Kant’s wider philosophy, explaining otherwise incomprehensible claims in his critical philosophy. The book presents a definitive study in the history of ideas, engaging with a wide range of Kant’s texts from 1749 until the early 1800s. Kant’s thought is placed in relation to numerous historical and traditional positions, which are themselves illuminated by a close engagement with recent debates in analytical philosophy and systematic theology. Kant is unrelentingly honest when grappling with the difficulty of relating divine and human freedom. This study, of Kant’s theological struggle and legacy, goes to the heart of the problem in the modern reception of what the Christian tradition has affirmed about human freedom. As such, the book throws light on one of the defining fault-lines in modern theology and philosophy.},
    abstract_source = {openalex},
}

@book{mikkelsen2013race,
    editor = {Mikkelsen, Jon},
    title = {Kant and the Concept of Race: Late Eighteenth-Century Writings},
    publisher = {State University of New York Press},
    year = {2013},
    doi = {10.1353/book26503},
    note = {SUMMARY: Translation of Kant's essays on race, including the first essay in its two versions of 1775 and 1777, presented in chronological order with previously untranslated texts by four German contemporaries of Kant (NDPR). SUBFIELD AND DEBATE: Anthropology and race: source texts for Kant's race theory and for the philosophy-of-biology context in which it arose; Kant and race. SIGNIFICANCE INDICATORS: S2 citations: 43 (retrieved 2026-09-30); CrossRef: 53. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-the-concept-of-race-late-eighteenth-century-writings/). SEP: not found in the retrieved bibliographies. Publisher: State University of New York Press. YEAR NOTE: Translation and edition of Kant's race writings, beginning with the first race essay (1775; second version 1777, per NDPR); CrossRef gives 2013.},
    keywords = {kant, anthro-hist-edu, debate-race, edition-trans, type-translation-edition, Medium},
    abstract = {This is a very important contribution for those who cannot read German and who wish to gain a purchase on the role of Kant in the highly contested domain of race theory and the less politicized but also contested domain of philosophy of biology. Not only does it provide key texts from Kant on the question of race, but it also supplements these with texts, previously not available in English, from four important German contemporaries of Kant. Jon Mikkelsen presents these texts in chronological order: Kant's first essay on race, in its two distinct versions of 1775 and 1777 (an unprecedented and very welcome contribution for those who are interested in close historical reading of Kant's development on these questions); E. A. W. Zimmermann's criticisms of Kant in the context of his own biogeographical study of the human population,Geographical History of Human Beings and the Universally Dispersed Quadrupeds(1778); Kant's "Determination of the Concept of a Human Race" (1785); Georg Forster's critical commentary on that essay, "Something More about the Human Races" (1786); Kant's rejoinder, "On the Use of Teleological Principles in Philosophy" (1788), of fundamental importance for the development of his thirdCritique; Christoph Meiners' "Of the Varieties and Deviate Forms of Negroes" (1790), an exemplary text from perhaps the most racist theorist of late eighteenth-century Germany; and, finally, an excerpt from Christoph Girtanner'sConcerning the Kantian Principle in Natural History(1796), the most thorough endeavor to apply Kant's approach to the emergent field of life science, associated with the work of Johann Friedrich Blumenbach in Göttingen. Mikkelsen's volume is supplemented with an extensive Chronology of developments in race theory, the slave trade, and the life sciences from 1619 to 1859.
    abstract_source = {ndpr},

The critical issue concerning this volume is its relation to the increasingly standard English translations of Kant's texts, theCambridge Edition of the Works of Immanuel Kant, in this case, the volumeAnthropology, History, and Education, edited by Günter Zöller and Robert Louden (Cambridge University Press, 2007). Both editions contain careful translations of Kant's texts on race. Each set of translations has its strengths and weaknesses. For general readability, perhaps the Cambridge Edition is superior, but Mikkelsen tends to retain more of the eighteenth-century flavor of Kant's language, as attested by the works from contemporaries. Each translation indulges in some terminological anachronism. The Cambridge Edition chooses to usephylumfor the GermanStamm. That sounds too much like a present taxonomical category for Kant's deliberately ordinary (eighteenth-century) language. But Mikkelsen translates asplateswhat the Cambridge Edition more sensibly renders asplateaus. Plates, once again, evokes too contemporary a geological framework. But the case for Mikkelsen's volume does not lie in translation quality but in conceptual orientation.

Both volumes reflect the very late attentiveness of Anglophone scholarship to Kant's texts on race and their relation to his overall corpus and concerns. More, this belatedness looms especially problematic in light of the explosive implications of these texts and others, now appearing in the Cambridge Edition, from Kant's lectures on physical geography and anthropology for the question of Kant'sracism. While the Cambridge Edition's general introduction acknowledges this context in about five pages and with one footnote reference to a proliferating secondary literature, a brevity perhaps justified by the much wider collection of texts comprising that volume, there is a much more extensive discussion of this heated present-day theoretical debate in the volume by Mikkelsen. His "Translator's Introduction" is a very careful essay in the historiography of recent work on Kant and race, recognizing the triggering intervention of Emmanuel Eze and then Tsenay Serequeberhan in the early 1990s, both reflecting a sharp post-colonialist critique of Eurocentrism. Mikkelsen then recounts the ensuing inquiry into these questions by Kant specialists, notably Mark Larrimore, Robert Bernasconi, Robert Louden, and Pauline Kleingeld, but with an exhaustive bibliography attached. His appraisals are thoughtful and persuasive, and they indicate that the question has not been definitively resolved. This will be decisive for the wider reception of his volume in communities of scholarship interested in contemporary issues of race, colonialism and cosmopolitanism and how Kant's work can be received in these domains.

There is a second theoretical context into which Mikkelsen situates his selected texts, namely the history of the life sciences in the eighteenth century. Kant's relation to this history is a matter that has only recently come under serious reconsideration, after a century of work that has privileged his concern with Newtonian physics. Mikkelsen gives a good account of the state of this emergent historiography, especially in relation to Kant, and he recognizes that that research is still in its very early stages. Since this is the field of my own research interest, I am very pleased to see Mikkelsen's attentiveness to this question and his suggestions for further inquiry. But it will also be here that I will raise some specialist's quibbles.

It is altogether salutary that Mikkelsen included texts from Kant's contemporaries and situated the whole volume in the context of the emergent discourse in life sciences of the eighteenth century. Nevertheless, by virtue of his selection, organization, and explicit interpretative interventions, Mikkelsen has not altogether inadvertently given his volume a spin that suggests that the whole discourse arosein response to Kant. This Kant-centered conception, while certainly understandable in a volume entitledKant and the Concept of Race, makes Kant appear to be the driving force in this field, whereas, in my view, he needs to be situated in a much wider course of developments that his specific interventions, to be sure, inflected but did not fundamentally direct. Thus, Mikkelsen might well have emphasized in his introduction, and even in his selection of texts, the more decisive figures in this emergent science. Buffon is of course central, and while Mikkelsen notes this, he does not raise in sufficient detail exactly what Kant took up from Buffon, why and when. The details of that reception, however, seem crucial to an appraisal of Kant's whole relation to the emergent life sciences. Similarly, path-breaking work by Caspar Friedrich Wolff and Johann Friedrich BlumenbachbeforeKant proved decisive for the German exploration of epigenesis, which Mikkelsen rightly singles out as crucial for Kant's views on the life sciences. Their textual inclusion, rather than brief mention in his introduction, might have relativized Kant's place in the discourse of the life sciences of his day. Of course, there are limits to what the volume could provide. That Mikkelsen includes an excerpt from the now forgotten, but at the time eminent, biogeographer Zimmermann is one of the most welcome features of his collection, though I do not believe Mikkelsen fully appreciates the importance of Zimmermann or the influence of his criticisms of Kant.

Even more important, in my view, is the question of Kant's rival, Johann Gottfried Herder, whose reception of Wolff and Blumenbach in hisIdeas for a Philosophical History of Mankind(1784) drew a two-part review from Kant, perhaps the most hostile and disparaging commentary he published on another scholar. Mikkelsen excluded these from his collection, but they in fact deserve a very prominent place in it if we are to understand how Kant came to his ultimate positions. Many of the texts from 1785 onward reflect Kant's explicit critique of Herder and the reactions to it in the wider community of German life science, but the absence of his reviews (to say nothing of texts from Herder himself) obscures this connection. To be sure, again, the volume could not include everything, but my suggestion is that this is not a dispensable element in the story Mikkelsen proposed to reconstruct. He explicitly addresses his omission of Herder and tries, in his introductions to the later texts and in his annotations, to take cognizance of the Herder connection. However, I find these disappointingly superficial regarding Herder. Moreover, there are specific textual passages in Kant's reviews of Herder that are essential for a grasp of the later texts by Kant and the others, and which Mikkelsen could easily have appended or cited more extensively in his annotations. In a word, I find this the most salient historical weakness in Mikkelsen's work.

By contrast, the inclusion of the text from Meiners and the discussion of this figure in the apparatus of the volume represent a very important contribution to Anglophone understanding of the language of race in late eighteenth-century Germany. This is, I suggest, the most cutting-edge element in Mikkelsen's volume, bespeaking his principal concern with race theory. The relation between Meiners and Kant on questions of race has become a matter of increasing scholarly interest, and the possibility of mutual influence has now been put forward as demanding serious consideration. Having a particularly odious exemplar of Meiners' racism in English will make this issue more conspicuous still. This is important, especially in a current context where Meiners is receiving more favorable attention as a cultural anthropologist, but without an adequate recognition of his oppressively racist baggage. For Kant specialists and even more for a general philosophical readership interested in questions of race and cosmopolitanism, Mikkelsen's volume is a very welcome contribution.},
}

@book{frierson2013human,
    author = {Frierson, Patrick R.},
    title = {What Is the Human Being?},
    publisher = {Routledge},
    year = {2013},
    doi = {10.4324/9780203070314},
    note = {SUMMARY: Introduction to Kant's philosophy of human nature that explains three ways Kant addresses the question 'what is the human being?' (the transcendental, the empirical and the pragmatic) and then considers later theorists of human nature, among them Hegel, Marx, Darwin, Nietzsche, Freud, Sartre, Heidegger, Foucault and E. O. Wilson, who challenge or enrich his views (publisher abstract; NDPR). SUBFIELD AND DEBATE: Anthropology and philosophy of mind: Kant's theory of human nature and its twentieth-century legacy; NDPR stresses the systematic reconstruction of the empirical elements of Kant's account. The NDPR and Mind review titles give the book as 'Kant's Questions: What Is the Human Being?'. SIGNIFICANCE INDICATORS: S2: no title-matched record found; CrossRef: 28. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-questions-what-is-the-human-being/). Other review: Mind (Grenberg, 2014; CrossRef). SEP: not found in the retrieved bibliographies. Publisher: Routledge. YEAR NOTE: CrossRef gives an online date of 2013-02-11 and no print date.},
    keywords = {kant, anthro-hist-edu, tp-mind, type-monograph, Medium},
    abstract = {Philosophers, anthropologists and biologists have long puzzled over the question of human nature. It is also a question that Kant thought about deeply and returned to in many of his writings. In this lucid and wide-ranging introduction to Kant’s philosophy of human nature - which is essential for understanding his thought as a whole - Patrick R. Frierson assesses Kant’s theories and examines his critics. He begins by explaining how Kant articulates three ways of addressing the question ‘what is the human being?’: the transcendental, the empirical, and the pragmatic. He then considers some of the great theorists of human nature who wrestle with Kant’s views, such as Hegel, Marx, Darwin, Nietzsche, and Freud; contemporary thinkers such as E.O.Wilson and Daniel Dennett, who have sought biological explanations of human nature; Thomas Kuhn, Michel Foucault, and Clifford Geertz, who emphasize the diversity of human beings in different times and places; and existentialist philosophers such as Sartre and Heidegger. He argues that whilst these approaches challenge and enrich Kant’s views in significant ways, all suffer from serious weaknesses that Kant’s anthropology can address. Taking a core insight of Kant’s - that human beings are fundamentally free but finite - he argues that it is the existentialists, particularly Sartre, who are the most direct heirs of his transcendental anthropology. The final part of the book is an extremely helpful overview of the work of contemporary philosophers, particularly Christine Korsgaard and Jürgen Habermas. Patrick R. Frierson explains how these philosophers engage with questions of naturalism, historicism, and existentialism while developing Kantian conceptions of the human being. Including chapter summaries and annotated further reading, What is the Human Being? is an outstanding introduction to some fundamental aspects of Kant’s thought and a judicious assessment of leading theories of human nature. It is essential reading for all students of Kant and the philosophy of human nature, as well as those in related disciplines such as anthropology, politics and sociology.},
    abstract_source = {openalex},
}

@article{golob2013heidegger,
    author = {Golob, Sacha},
    title = {Heidegger on Kant, Time and the ‘Form’ of Intentionality},
    journal = {British Journal for the History of Philosophy},
    year = {2013},
    volume = {21},
    number = {2},
    pages = {345--367},
    doi = {10.1080/09608788.2012.692662},
    note = {SUMMARY: Analyses Heidegger's 1927/8 lecture course on the Critique of Pure Reason and his 1929 Kant and the Problem of Metaphysics, arguing that Heidegger's reading of Kant turns on two questions: how Heidegger's Kant understands the transcendental (answered through Cassam's model of a self-directed transcendental argument) and what role the horizon plays (answered through Kant's view that pure general logic abstracts from semantic content and Hume's attack on metaphysics) (abstract). SUBFIELD AND DEBATE: Reception (phenomenology): Heidegger's interpretation of Kant's Critique of Pure Reason. SIGNIFICANCE INDICATORS: S2 citations: 15 (retrieved 2026-09-30); CrossRef: 12. Venue: British Journal for the History of Philosophy. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2013-03 (volume 21, issue 2).},
    keywords = {kant, recep-phenom, tp-cpr, type-article, Low},
    abstract = {Between 1927 and 1936, Martin Heidegger devoted almost one thousand pages of close textual commentary to the philosophy of Immanuel Kant. This article aims to shed new light on the relationship between Kant and Heidegger by providing a fresh analysis of two central texts: Heidegger's 1927/8 lecture course Phenomenological Interpretation of Kant's Critique of Pure Reason and his 1929 monograph Kant and the Problem of Metaphysics. I argue that to make sense of Heidegger's reading of Kant, one must resolve two questions. First, how does Heidegger's Kant understand the concept of the transcendental? Second, what role does the concept of a horizon play in Heidegger's reconstruction of the Critique? I answer the first question by drawing on Cassam's model of a self-directed transcendental argument (‘The role of the transcendental within Heidegger's Kant’), and the second by examining the relationship between Kant's doctrine that ‘pure, general logic’ abstracts from all semantic content and Hume's attack on metaphysics (‘The role of the horizon within Heidegger's Kant’). I close by sketching the implications of my results for Heidegger's own thought (‘From Heidegger's Kant to Sein und Zeit’). Ultimately, I conclude that Heidegger's commentary on the Critical system is defined, above all, by a single issue: the nature of the ‘form’ of intentionality.},
    abstract_source = {openalex},
}

@book{bacin2013kongress,
    editor = {Bacin, Stefano and Ferrarin, Alfredo and La Rocca, Claudio and Ruffing, Margit},
    title = {Kant und die Philosophie in weltbürgerlicher Absicht: Akten des XI. Kant-Kongresses 2010},
    publisher = {De Gruyter},
    year = {2013},
    doi = {10.1515/9783110246490},
    note = {SUMMARY: Five-volume proceedings of the Eleventh International Kant Congress (Pisa, 2010), containing 25 plenary talks and 341 papers in 14 sections from Kant's concept of philosophy to Kant's heritage; it was the first congress to include a session on Kant and Schopenhauer (publisher abstract). SUBFIELD AND DEBATE: Reference work covering all subfields of Kant scholarship (proceedings in German and English); the Kant-Kongress series of the Kant-Gesellschaft. Carry-forward from Domain 1 (Pisa 2010 proceedings dated 2013 in SEP bibliographies). SIGNIFICANCE INDICATORS: S2 citations: 14 (retrieved 2026-09-30); CrossRef: 6. SEP: chapters cited in the kant-mathematics (Jauernig), kant-science (Leduc) and kant-transcendental-idealism bibliographies. NDPR: not applicable, no review found. Publisher: De Gruyter. YEAR NOTE: The congress took place in 2010; CrossRef print and online date 2013-10-15.},
    keywords = {kant, reference, type-edited-volume, Low},
    abstract = {Held every five years under the auspices of the Kant-Gesellschaft, the International Kant Congress is the world’s largest philosophy conference devoted to the work and legacy of a single thinker. The five-volume set Kant and Philosophy in a Cosmopolitan Sense contains the proceedings of the Eleventh International Kant Congress, which took place in Pisa in 2010. The proceedings consist of 25 plenary talks and 341 papers selected by a team of international referees from over 700 submissions. The contributions span 14 sections: Kant’s Concept of Philosophy; Theory of Cognition and Logic; Ontology and Metaphysics; Ethics; Law and Justice; Religion and Theology; Aesthetics; Anthropology and Psychology; Politics and History; Science, Mathematics, and the Philosophy of Nature; Kant and the Leibnizian Tradition; Kant and the Philosophical Tradition; Kant and Schopenhauer; and Kant’s Heritage. Thanks to cooperation from the Schopenhauer Gesellschaft, the 2010 conference was the first in the history of the International Kant Congress to include a session on Kant and Schopenhauer.},
    abstract_source = {openalex},
}

@book{frierson2014empirical,
    author = {Frierson, Patrick R.},
    title = {Kant's Empirical Psychology},
    publisher = {Cambridge University Press},
    year = {2014},
    doi = {10.1017/cbo9781139507035},
    note = {SUMMARY: Uses close analysis of texts, including unpublished lectures and notes, to show how Kant explains human action, choice and thought in empirical terms. The book argues that understanding Kant's empirical psychology sheds light on major concepts of his philosophy, including the moral law, moral responsibility, weakness of will and cognitive error, and applies Kant's accounts of mental illness to contemporary philosophical issues (publisher abstract). SUBFIELD AND DEBATE: Philosophy of mind and anthropology: the place of empirical psychology in Kant's system. SIGNIFICANCE INDICATORS: S2 citations: 70 (retrieved 2026-09-30); CrossRef: 63. SEP: listed in the kant-hume-morality bibliography. Reviews: Kantian Review (Grenberg, 2016), Con-Textos Kantianos (Rumore, 2015). NDPR: no review found for this title (the author's 2013 book is reviewed there). Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2014-07-17, online 2014-08.},
    keywords = {kant, tp-mind, anthro-hist-edu, type-monograph, Medium},
    abstract = {Throughout his life, Kant was concerned with questions about empirical psychology. He aimed to develop an empirical account of human beings, and his lectures and writings on the topic are recognizable today as properly 'psychological' treatments of human thought and behavior. In this book Patrick R. Frierson uses close analysis of relevant texts, including unpublished lectures and notes, to study Kant's account. He shows in detail how Kant explains human action, choice, and thought in empirical terms, and how a better understanding of Kant's psychology can shed light on major concepts in his philosophy, including the moral law, moral responsibility, weakness of will, and cognitive error. Frierson also applies Kant's accounts of mental illness to contemporary philosophical issues. His book will interest students and scholars of Kant, the history of psychology, philosophy of psychology, and philosophy of action.},
    abstract_source = {openalex},
}

@book{dyck2014rational,
    author = {Dyck, Corey W.},
    title = {Kant and Rational Psychology},
    publisher = {Oxford University Press},
    year = {2014},
    doi = {10.1093/acprof:oso/9780199688296.001.0001},
    note = {SUMMARY: Examines Kant's critique of rational psychology in the Critique of Pure Reason within its eighteenth-century German context. It argues that Christian Wolff's rational psychology, which stressed empirical foundations, rather than Descartes or Leibniz, was Kant's primary target in the Paralogisms, and that Kant's criticism exposes how rational psychologists treat the soul as given in inner experience (OUP page description retrieved this session; the OpenAlex abstract text is garbled). SUBFIELD AND DEBATE: Theoretical philosophy: the Paralogisms and Kant's critique of rational psychology, read against the Wolffian school. SIGNIFICANCE INDICATORS: S2 citations: 92 (retrieved 2026-09-30); CrossRef: 68. SEP: listed in the kant-metaphysics and kant-mind bibliographies and cited in the text of kant-metaphysics (section on the soul and rational psychology). Reviews: Journal of the History of Philosophy (Naragon, 2015), Kant-Studien (Pollok, 2017), Kantian Review (Wunderlich, 2017), German Studies Review (Switzer, 2017). NDPR: no review found. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2014-03-20; the OUP page gives 20 May 2014.},
