    keywords = "kant, pp-right-politics, debate-other-global-justice, type-article, Medium, INCOMPLETE, no-abstract"
}

@book{baxley2010virtue,
    author = "Baxley, Anne Margaret",
    title = "Kant's Theory of Virtue: The Value of Autocracy",
    publisher = "Cambridge University Press",
    year = "2010",
    doi = "10.1017/cbo9780511779466",
    note = "SUMMARY: Argues that Kantian virtue is best understood as autocracy, a form of moral self-government in which reason rules sensibility, and that the moral psychology of the later ethical works, including the duty to cultivate certain emotional states, yields a distinctively modern, egalitarian conception of virtue that differs from Aristotelian virtue ethics (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: Metaphysics of Morals (Doctrine of Virtue), moral psychology and emotion. Joins the debate on Kantian ethics and virtue ethics and on the place of feeling in Kant's moral theory. SIGNIFICANCE INDICATORS: S2 citations: 15 on the title-matched record (retrieved 2026-09-30; a separate front-matter record shows 5); CrossRef: 74. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-theory-of-virtue-the-value-of-autocracy/). SEP: listed in the kant-moral and kant-hume-morality bibliographies; cited in a further-reading list in kant-moral. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print and online date both 2010.",
    keywords = "kant, pp-mm-virtue, pp-ethics, debate-other-virtue-ethics, type-monograph, Medium",
    abstract = "Anne Margaret Baxley offers a systematic interpretation of Kant's theory of virtue, whose most distinctive features have not been properly understood. She explores the rich moral psychology in Kant's later and less widely read works on ethics, and argues that the key to understanding his account of virtue is the concept of autocracy, a form of moral self-government in which reason rules over sensibility. Although certain aspects of Kant's theory bear comparison to more familiar Aristotelian claims about virtue, Baxley contends that its most important aspects combine to produce something different - a distinctively modern, egalitarian conception of virtue which is an important and overlooked alternative to the more traditional Greek views which have dominated contemporary virtue ethics.",
    abstract_source = "openalex"
}

@book{reath2010practical,
    editor = "Reath, Andrews and Timmermann, Jens",
    title = "Kant's Critique of Practical Reason: A Critical Guide",
    publisher = "Cambridge University Press",
    year = "2010",
    doi = "10.1017/cbo9780511770869",
    note = "SUMMARY: Essays on the principal arguments of the second Critique and their relation to the critical philosophy as a whole, covering the genesis of the work, the authority of the moral law as a 'fact of reason', the metaphysics of free agency, respect as the moral motive, and the primacy of practical reason and the postulates (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: Critique of Practical Reason, the fact of reason and the deductions of morality and freedom. Critical Guide volume; chapters on the fact of reason and on the primacy of practical reason are cited individually in SEP bibliographies. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 13 (book-level); S2 holds only chapter and index records, e.g. 26 for the index record (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/kant-s-critique-of-practical-reason-a-critical-guide/). SEP: chapters listed in the kant-reason and kant-moral bibliographies. Series: Cambridge Critical Guides. YEAR NOTE: CrossRef print date 2010; online 2009 (issued 2009).",
    keywords = "kant, pp-ethics, type-edited-volume, Medium",
    abstract = "The Critique of Practical Reason is the second of Kant's three Critiques, and his second work in moral theory after the Groundwork of the Metaphysics of Morals. Its systematic account of the authority of moral principles grounded in human autonomy unfolds Kant's considered views on morality and provides the keystone to his philosophical system. The essays in this volume shed light on the principal arguments of the second Critique and explore their relation to Kant's critical philosophy as a whole. They examine the genesis of the Critique, Kant's approach to the authority of the moral law given as a 'fact of reason', the metaphysics of free agency, the account of respect for morality as the moral motive, and questions raised by the 'primacy of practical reason' and the idea of the 'postulates'. Engaging and critical, this volume will be invaluable to advanced students and scholars of Kant and to moral theorists alike.",
    abstract_source = "openalex"
}

@book{denis2010metaphysics,
    editor = "Denis, Lara",
    title = "Kant's Metaphysics of Morals: A Critical Guide",
    publisher = "Cambridge University Press",
    year = "2010",
    doi = "10.1017/cbo9780511763250",
    note = "SUMMARY: Newly commissioned essays on the Metaphysics of Morals (Doctrine of Right and Doctrine of Virtue), treating its relation to Kant's earlier works and themes such as the relation between right and virtue, property, punishment and moral feeling (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: Metaphysics of Morals, right and virtue. NDPR notes a chapter that questions Allen Wood's claim that Kant derives duties mainly from the Formula of Humanity rather than the Formula of Universal Law. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 6 (book-level); S2 holds a title-matched record with 16 citations (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/kant-s-metaphysics-of-morals-a-critical-guide/). SEP: listed in the kant-hume-morality and kant-social-political bibliographies. Series: Cambridge Critical Guides. YEAR NOTE: CrossRef print date 2010; online 2011.",
    keywords = "kant, pp-mm-virtue, pp-right-politics, type-edited-volume, Medium",
    abstract = "Immanuel Kant's Metaphysics of Morals (1797), containing the Doctrine of Right and Doctrine of Virtue, is his final major work of practical philosophy. Its focus is not rational beings in general but human beings in particular, and it presupposes and deepens Kant's earlier accounts of morality, freedom and moral psychology. In this volume of newly-commissioned essays, a distinguished team of contributors explores the Metaphysics of Morals in relation to Kant's earlier works, as well as examining themes which emerge from the text itself. Topics include the relation between right and virtue, property, punishment, and moral feeling. Their diversity of questions, perspectives and approaches will provide new insights into the work for scholars in Kant's moral and political theory.",
    abstract_source = "openalex"
}

@article{pallikkathayil2010deriving,
    author = "Pallikkathayil, Japa",
    title = "Deriving Morality from Politics: Rethinking the Formula of Humanity",
    journal = "Ethics",
    year = "2010",
    volume = "121",
    number = "1",
    pages = "116--147",
    doi = "10.1086/656041",
    note = "SUMMARY: Argues against Korsgaard's and O'Neill's interpretation of what it is to treat someone merely as a means under the Formula of Humanity, and develops an alternative on which the content of many moral duties depends on the results of political philosophy and of actual political decision making (abstract). SUBFIELD AND DEBATE: Practical philosophy: the Formula of Humanity and the relation between Kant's ethics and political philosophy. Responds to the Korsgaard and O'Neill readings of 'merely as a means'. SIGNIFICANCE INDICATORS: S2 citations: 83 (retrieved 2026-09-30); CrossRef: 55. Venue: Ethics. SEP: not found in the retrieved kant-moral bibliography.",
    keywords = "kant, pp-ethics, pp-right-politics, debate-other-formula-of-humanity, type-article, Medium",
    abstract = "Kant's Formula of Humanity famously forbids treating others merely as a means. It is unclear, however, what exactly treating someone merely as a means comes to. This essay argues against an interpretation of this idea advanced by Christine Korsgaard and Onora O'Neill. The essay then develops a new interpretation that suggests an important connection between the Formula of Humanity and Kant's political philosophy: the content of many of our moral duties depends on the results of political philosophy and, indeed, on the results of actual political decision making.",
    abstract_source = "openalex"
}

@book{crowther2010kantian,
    author = "Crowther, Paul",
    title = "The Kantian Aesthetic: From Knowledge to the Avant-Garde",
    publisher = "Oxford University Press",
    year = "2010",
    doi = "10.1093/acprof:oso/9780199579976.001.0001",
    note = "SUMMARY: Explains the kind of perceptual knowledge involved in aesthetic judgments by linking Kant's aesthetics to a critically upgraded account of his theory of knowledge, and shows that such judgments must involve categories and fundamental schemata (publisher abstract). SUBFIELD AND DEBATE: Aesthetics: Critique of the Power of Judgment, the relation of aesthetic judgment to cognition and the first Critique. SIGNIFICANCE INDICATORS: S2 citations: 24 (retrieved 2026-09-30); CrossRef: 24. NDPR review: yes (ndpr.nd.edu/reviews/the-kantian-aesthetic-from-knowledge-to-the-avant-garde/); S2 also indexes a 2011 item by McMahon with the book's title and a British Journal of Aesthetics DOI prefix (apparently a review). Publisher: Oxford University Press. SEP: not found in the retrieved kant-aesthetics bibliography. YEAR NOTE: CrossRef print date 2010-03.",
    keywords = "kant, aes-teleo, type-monograph, Medium",
    abstract = "This study explains the kind of perceptual knowledge involved in aesthetic judgments. It does so by linking Kant's aesthetics to a critically upgraded account of his theory of knowledge. By describing examples of aesthetic judgment, it is shown that these judgments must involve categories and fundamental schemata.",
    abstract_source = "openalex"
}

@article{heis2010cassirer,
    author = "Heis, Jeremy",
    title = "“Critical philosophy begins at the very point where logistic leaves off”: Cassirer's Response to Frege and Russell",
    journal = "Perspectives on Science",
    url = "https://doi.org/10.1162/posc_a_00015",
    year = "2010",
    volume = "18",
    number = "4",
    pages = "383--408",
    note = "SUMMARY: Traces the reception of Frege's and Russell's new logic and logicism among the Marburg Neo-Kantians: Natorp and Cassirer reject their conception of logic on the basis of a Marburg philosophy of logic taken from Cohen, while Cassirer sees the new logic as vindicating some Neo-Kantian theses about space, time and mathematical proof and as supporting a conception of mathematics as the study of relational structures (abstract). SUBFIELD AND DEBATE: Reception: Marburg neo-Kantianism and early analytic philosophy of logic and mathematics. SIGNIFICANCE INDICATORS: S2 citations: 28 (retrieved 2026-09-30); CrossRef: 21. Venue: Perspectives on Science. SEP/IEP: not found in the retrieved bibliographies (the IEP neo-kant bibliography was searched).",
    keywords = "kant, recep-neokantian, recep-analytic, tp-science-math, type-article, Low",
    abstract = "This paper concerns the reception of the new logic and logicism of Frege and Russell among the German Neo-Kantian philosophers of the Marburg school. Paul Natorp and Ernst Cassirer both object to Frege's and Russell's conception of the ground, nature, and demarcation of logic. This objection depends on the distinctive Marburg school philosophy of logic, first articulated by Hermann Cohen: that “formal” logic (in Kant's sense) depends on a logical investigation of the principles that make mathematical natural science possible. Nevertheless, Cassirer thought that the new logic had profound philosophical implications. First, the new logic provides a technical vindication of some Neo-Kantian theses concerning space and time and mathematical proofs. Second, Cassirer thinks that the new logic allows for a conception of mathematics as the study of relational structures. This conception, in concert with a Kantian notion of objectivity and objecthood, makes possible a justification of modern mathematics.",
    abstract_source = "openalex"
}

@article{papadaki2010marriage,
    author = "Papadaki, Lina",
    title = "Kantian Marriage and Beyond: Why It Is Worth Thinking about Kant on Marriage",
    journal = "Hypatia",
    year = "2010",
    volume = "25",
    number = "2",
    pages = "276--294",
    doi = "10.1111/j.1527-2001.2009.01078.x",
    note = "SUMMARY: Argues that Kant's account of monogamous marriage as the only relationship in which sexual use is compatible with humanity survives the charges of being flawed, paradoxical and at odds with feminism, and, drawing on Kant's conception of friendship, suggests that Kant may have overlooked another context in which sex is morally permissible (abstract). SUBFIELD AND DEBATE: Practical philosophy and gender: Kant on sex, marriage and friendship in the Metaphysics of Morals; responds to feminist and other critics of Kantian marriage. SIGNIFICANCE INDICATORS: S2 citations: 18 (retrieved 2026-09-30); CrossRef: 14. Venue: Hypatia. SEP/IEP: not found in the retrieved bibliographies.",
    keywords = "kant, pp-mm-virtue, debate-gender, type-article, Low",
    abstract = "Kant has famously argued that monogamous marriage is the only relationship where sexual use can take place “without degrading humanity and breaking the moral laws.” Kantian marriage, however, has been the target of fierce criticisms by contemporary thinkers: it has been regarded as flawed and paradoxical, as being deeply at odds with feminism, and, at best, as plainly uninteresting. In this paper, I argue that Kantian marriage can indeed survive these criticisms. Finally, the paper advances the discussion beyond marriage. Drawing on Kant's conception of friendship, I suggest that he might have overlooked the possibility of sex being morally permissible in yet another context.",
    abstract_source = "openalex"
}

@book{kitcher2011thinker,
    author = "Kitcher, Patricia",
    title = "Kant's Thinker",
    publisher = "Oxford University Press",
    year = "2011",
    doi = "10.1093/acprof:oso/9780199754823.001.0001",
    note = "SUMMARY: Examines the Critique of Pure Reason's account of cognition and its relation to self-consciousness, arguing that Kant's theory of the interplay between self-consciousness and consciousness of objects handles the self-ascription of beliefs and the tracking of objects over time better than more recent theories, and can suggest new avenues for cognitive science (publisher abstract; NDPR). SUBFIELD AND DEBATE: Theoretical philosophy: cognition, self-consciousness and apperception in the Critique of Pure Reason. NDPR places the book in the Strawsonian tradition of extracting philosophical insight from the Critique, while noting disagreements with Strawson on interpretive and philosophical points. SIGNIFICANCE INDICATORS: S2 citations: 80 (retrieved 2026-09-30); CrossRef: 70. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-thinker-3/); S2 also indexes a review in British Journal for the History of Philosophy (Marshall, 2011). SEP: listed in the kant, kant-mind and kant-transcendental bibliographies. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2011-01.",
    keywords = "kant, tp-cpr, tp-mind, type-monograph, High",
    abstract = "'Kant's Thinker' examines the 'Critique of Pure Reason' and gives an account of the relation between cognition and self-consciousness.",
    abstract_source = "openalex"
}

@article{hanna2011nonconceptual,
    author = "Hanna, Robert",
    title = "Beyond the Myth of the Myth: A Kantian Theory of Non-Conceptual Content",
    journal = "International Journal of Philosophical Studies",
    year = "2011",
    volume = "19",
    number = "3",
    pages = "323--398",
    doi = "10.1080/09672559.2011.595187",
    note = "SUMMARY: Argues that a broadly Kantian strategy for explaining the existence, semantic structure and psychological function of essentially non-conceptual content also yields a bottom-up theory of the foundations of rationality in minded animals, on which non-conceptual content is the substructure from which Sellars's 'logical space of reasons' grows (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: nonconceptual content in Kant's theory of intuition and cognition. Nonconceptualism against conceptualism; the same International Journal of Philosophical Studies issue contains a conceptualist reply by Bowman and a paper by Grune on the B Deduction (per CrossRef listings retrieved). SIGNIFICANCE INDICATORS: S2 citations: 53 (retrieved 2026-09-30); CrossRef: 31. Venue: International Journal of Philosophical Studies (issue 19(3) also carries the Bowman and Grune papers). SEP: the kant-transcendental bibliography lists the title (attributed there to Grune); the kant-judgment bibliography lists other papers from the same issue.",
    keywords = "kant, tp-cpr, tp-mind, debate-conceptualism, type-article, Medium",
    abstract = "In this essay I argue that a broadly Kantian strategy for demonstrating and explaining the existence, semantic structure, and psychological function of essentially non-conceptual content can also provide an intelligible and defensible bottom-up theory of the foundations of rationality in minded animals. Otherwise put, if I am correct, then essentially non-conceptual content constitutes the semantic and psychological substructure, or matrix, out of which the categorically normative a priori superstructure of epistemic rationality and practical rationality – Sellars’s “logical space of reasons” – grows.",
    abstract_source = "openalex"
}

@article{mclear2011animal,
    author = "McLear, Colin",
    title = "Kant on Animal Consciousness",
    journal = "Philosopher's Imprint",
    year = "2011",
    volume = "11",
    note = "SUMMARY: Argues that Kant's claims about animal representation and consciousness do not rule out objective perceptual consciousness in animals, and that a nonconceptualist reading of Kant can endorse this while denying that animals can take cognitive attitudes towards, and self-ascribe, their own representational states (abstract from CORE). SUBFIELD AND DEBATE: Theoretical philosophy: perception and animal minds. Nonconceptualism against the conceptualist reading of Kant, which raises the problem of perceptual awareness in non-rational animals. SIGNIFICANCE INDICATORS: S2 citations: 80 (retrieved 2026-09-30); no DOI in CrossRef or S2. Venue: Philosophers' Imprint (S2 record gives volume 11). SEP: listed in the kant-judgment and kant-mind bibliographies. YEAR NOTE: Bibliographic fields (journal, volume, year) taken from the S2 record; S2 gives no issue, pages or DOI.",
    keywords = "kant, tp-mind, tp-cpr, debate-conceptualism, debate-animals, type-article, Medium",
    abstract = "Kant is often considered to have argued that perceptual awareness of objects in one's environment depends on the subject's possession of conceptual capacities. This conceptualist interpretation raises an immediate problem concerning the nature of perceptual awareness in non-rational, non-concept using animals. In this paper I argue that Kant’s claims concerning animal representation and consciousness do not foreclose the possibility of attributing to animals the capacity for objective perceptual consciousness, and that a non-conceptualist interpretation of Kant’s position concerning perceptual awareness can actively endorse this attribution. Kant can consistently allow that animals have a point of view on the objective world which possesses a distinctive phenomenal character while denying what seems most important to him – viz. that animals have the capacity to take cognitive attitudes towards, and thus self-ascribe, their own representational states",
    abstract_source = "core"
}

@book{schulting2011idealism,
    editor = "Schulting, Dennis and Verburgt, Jacco",
    title = "Kant's Idealism: New Interpretations of a Controversial Doctrine",
    publisher = "Springer Netherlands",
    year = "2011",
    doi = "10.1007/978-90-481-9719-4",
    note = "SUMMARY: Essays on Kant's doctrine of idealism, including contributions by Ameriks and Baum, on the relation between Kant's logic and idealism, on the thing in itself, and on the chapter on the Transcendental Ideal; the publisher describes it as the first English-language book devoted exclusively to the subject (publisher description retrieved by web search). SUBFIELD AND DEBATE: Theoretical philosophy: interpretation of transcendental idealism and the thing in itself (two-aspect and other readings). Contains Allais's 'Transcendental idealism and the transcendental deduction', cited in the SEP kant-transcendental bibliography. SIGNIFICANCE INDICATORS: S2 citations: 32 on the volume record (retrieved 2026-09-30); CrossRef: 34. Publisher: Springer (series The New Synthese Historical Library, per web search results). NDPR: no review found in the NDPR sitemap. SEP: chapters listed in the kant-transcendental bibliography. YEAR NOTE: CrossRef print date 2011; the CrossRef chapter records for the volume carry 2010.",
    keywords = "kant, tp-cpr, debate-two-aspect, type-edited-volume, Medium, INCOMPLETE, no-abstract"
}

@article{massimi2011dynamical,
    author = "Massimi, Michela",
    title = "Kant’s dynamical theory of matter in 1755, and its debt to speculative Newtonian experimentalism",
    journal = "Studies in History and Philosophy of Science Part A",
    year = "2011",
    volume = "42",
    number = "4",
    pages = "525--543",
    doi = "10.1016/j.shpsa.2011.09.008",
    note = "SUMMARY: Explores the scientific sources of Kant's early dynamical theory of matter in the Universal Natural History and On Fire (1755), and argues that speculative Newtonian experimentalism (from Newton's Opticks through Boerhaave's Elementa chemiae and Hales's Vegetable Staticks) rather than the Principia was central, qualifying the picture of 1755 as Kant's conversion to Newton (abstract, via CORE). SUBFIELD AND DEBATE: Philosophy of science and pre-critical work: Kant's early natural philosophy and its sources. SIGNIFICANCE INDICATORS: S2 citations: 30 (retrieved 2026-09-30); CrossRef: 25. Venue: Studies in History and Philosophy of Science Part A. SEP: not found in the retrieved bibliographies.",
    keywords = "kant, tp-science-math, precritical, type-article, Medium",
    abstract = "This paper explores the scientific sources behind Kant's early dynamical theory of matter in 1755, with a focus on two main Kant's writings: Universal Natural History and Theory of the Heavens and On Fire. The year 1755 has often been portrayed by Kantian scholars as a turning point in the intellectual career of the young Kant, with his much debated conversion to Newton. Via a careful analysis of some salient themes in the two aforementioned works, and a reconstruction of the scientific sources behind them, this paper shows Kant's debt to an often overlooked scientific tradition, i.e. speculative Newtonian experimentalism. The paper argues that more than the Principia, it was the speculative experimentalism that goes from Newton's Opticks to Herman Boerhaave's Elementa chemiae via Stephen Hales' Vegetable Staticks that played a central role in the elaboration of Kant's early dynamical theory of matter in 1755.",
    abstract_source = "core"
}

@book{allison2011groundwork,
    author = "Allison, Henry E.",
    title = "Kant's Groundwork for the Metaphysics of Morals: A Commentary",
    publisher = "Oxford University Press",
    year = "2011",
    doi = "10.1093/acprof:oso/9780199691531.001.0001",
    note = "SUMMARY: Comprehensive commentary on the Groundwork (1785) that pays special attention to the work's structure and to its historical and intellectual context, covering the whole text including the third chapter's deduction (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: the Groundwork, the formulas of the categorical imperative and the deduction of morality from freedom. SEP kant-moral cites the book on the claim that the formulas are equivalent in generating the same duties. SIGNIFICANCE INDICATORS: S2 citations: 180 (retrieved 2026-09-30); CrossRef: 122. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-groundwork-for-the-metaphysics-of-morals-a-commentary/; the NDPR sitemap lists further reviews of Allison's Groundwork commentary). SEP: listed in the kant-moral and kant-hume-morality bibliographies and cited in text in kant-moral. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2011-10.",
    sep_context = {SEP kant-moral: "The most straightforward interpretation of the claim that the formulas are equivalent is as the claim that following or applying each formula would generate all and only the same duties (Allison 2011)."},
    keywords = "kant, pp-ethics, type-monograph, High",
    abstract = "Henry E. Allison presents a comprehensive commentary on Kant's 'Groundwork for the Metaphysics of Morals' (1785). Allison pays special attention to the structure of the work and its historical and intellectual context.",
    abstract_source = "openalex"
}

@book{sensen2011dignity,
    author = "Sensen, Oliver",
    title = "Kant on Human Dignity",
    publisher = "De Gruyter",
    year = "2011",
    doi = "10.1515/9783110267167",
    note = "SUMMARY: Studies all passages in which Kant uses the term 'dignity' and the main arguments in the Kant literature for a value of human beings, and argues that respect for human beings does not follow from human dignity, since that would violate autonomy, but is an unconditional imperative of reason, yielding a unified account of Kant's moral philosophy (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy: dignity, value and respect in Kant's ethics; contests readings that ground moral imperatives in a prior value of humanity. SEP kant-moral cites it among commentators linking the Formula of Humanity to the Formula of Universal Law. SIGNIFICANCE INDICATORS: S2 citations: 102 (retrieved 2026-09-30); CrossRef: 106. NDPR: no review found in the NDPR sitemap. SEP: listed in the kant-moral bibliography and cited in text. Publisher: De Gruyter. YEAR NOTE: CrossRef print and online date 2011-10.",
    sep_context = {SEP kant-moral: "That I should always treat humanity as an end in itself entails that I should act only on maxims that are consistent with themselves as universal laws of nature (O'Neill 1975, 1990; Engstrom 2009; Sensen 2011)."},
    keywords = "kant, pp-ethics, debate-other-dignity, type-monograph, High",
    abstract = "Immanuel Kant is often considered to be the source of the contemporary idea of human dignity, but his conception of human dignity and its relation to human value and to the requirement to respect others have not been widely understood. Kant on Human Dignity offers the first in-depth study in English of this subject. Based on a comprehensive analysis of all the passages in which Kant uses the term ‘dignity’, as well as an analysis of the most prominent arguments for a value of human beings in the Kant literature, the book carefully examines different ways of construing the relationship between dignity, value and respect for others. It takes seriously Kant’s Copernican Revolution in moral philosophy: Kant argues that moral imperatives cannot be based on any values without yielding heteronomy. Instead it is imperatives of reason that determine what is valuable. The requirement to respect all human beings is one such imperative. Respect for human beings does not follow from human dignity—for this would violate autonomy—but is an unconditional command of reason. Following this train of thought yields a unified account of Kant’s moral philosophy.",
    abstract_source = "openalex"
}

@book{kant2011groundwork,
    author = "Kant, Immanuel",
    editor = "Gregor, Mary and Timmermann, Jens",
    title = "Groundwork of the Metaphysics of Morals: A German-English Edition",
    publisher = "Cambridge University Press",
    year = "2011",
    doi = "10.1017/cbo9780511973741",
    note = "SUMMARY: First facing-page German-English edition of the Groundwork, presenting an edited German text alongside a carefully revised version of Mary Gregor's translation, with editorial notes and a bilingual index (publisher abstract; NDPR). SUBFIELD AND DEBATE: Edition and translation of Kant's central work of moral theory (Groundwork, 1785; the 1786 second edition is the base text per NDPR). SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 246; S2 citations: 86 on the title-matched record (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/groundwork-of-the-metaphysics-of-morals-a-german-english-edition/). SEP: listed in the kant-reason bibliography. Publisher: Cambridge University Press. YEAR NOTE: Edition and translation of Kant (1785); CrossRef print date 2011-02, online 2012-06.",
    keywords = "kant, edition-trans, pp-ethics, type-translation-edition, High",
    abstract = "Published in 1785, the Groundwork of the Metaphysics of Morals is one of the most powerful texts in the history of ethical thought. In this book, Immanuel Kant formulates and justifies a supreme principle of morality that issues universal and unconditional moral commands. These commands receive their normative force from the fact that rational agents autonomously impose the moral law upon themselves. As such, they are laws of freedom. This volume contains the first facing-page German-English edition of Kant's Groundwork. It presents an authentic edition of the German text and a carefully revised version of Mary Gregor's acclaimed English translation, as well as editorial notes and a full bilingual index. It will be the edition of choice for any student or scholar who is not content with reading this central contribution to modern moral philosophy through the veil of English translation.",
    abstract_source = "openalex"
}

@book{stern2011obligation,
    author = "Stern, Robert",
    title = "Understanding Moral Obligation: Kant, Hegel, Kierkegaard",
    publisher = "Cambridge University Press",
    year = "2011",
    doi = "10.1017/cbo9780511997747",
    note = "SUMMARY: Challenges the 'argument from autonomy' by which Kant is said to have turned to constructivism, arguing that Kant did not hold it and that the real threat to autonomy comes from the obligatoriness of morality, and traces how Kant (obligation located in ourselves), Hegel (in others) and Kierkegaard (in God) respond (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy and reception: constructivism against realism in Kantian ethics, and the Kant-Hegel-Kierkegaard line on moral obligation. NDPR reports that Stern argues Kant was a value realist and that value realism does not itself threaten autonomy. SIGNIFICANCE INDICATORS: S2 citations: 13 on the title-matched record (retrieved 2026-09-30); CrossRef: 29. NDPR review: yes (ndpr.nd.edu/reviews/understanding-moral-obligation-kant-hegel-kierkegaard/). SEP: not found in the retrieved kant-moral bibliography. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2011-12-15 (online 2012-01); the NDPR review header lists Cambridge University Press, 2012.",
    keywords = "kant, pp-ethics, recep-idealism, debate-constructivism, type-monograph, Medium",
    abstract = "In many histories of modern ethics, Kant is supposed to have ushered in an anti-realist or constructivist turn by holding that unless we ourselves 'author' or lay down moral norms and values for ourselves, our autonomy as agents will be threatened. In this book, Robert Stern challenges the cogency of this 'argument from autonomy', and claims that Kant never subscribed to it. Rather, it is not value realism but the apparent obligatoriness of morality that really poses a challenge to our autonomy: how can this be accounted for without taking away our freedom? The debate the book focuses on therefore concerns whether this obligatoriness should be located in ourselves (Kant), in others (Hegel) or in God (Kierkegaard). Stern traces the historical dialectic that drove the development of these respective theories, and clearly and sympathetically considers their merits and disadvantages; he concludes by arguing that the choice between them remains open.",
    abstract_source = "openalex"
}

@book{kleingeld2011cosmopolitanism,
    author = "Kleingeld, Pauline",
    title = "Kant and Cosmopolitanism: The Philosophical Ideal of World Citizenship",
    publisher = "Cambridge University Press",
    year = "2011",
    doi = "10.1017/cbo9781139015486",
    note = "SUMMARY: Presents an account of Kant's cosmopolitanism (moral, political, legal, economic, cultural and psychological aspects), contrasting it with the views of his German contemporaries and arguing that it changed radically in the mid-1790s into a philosophically stronger theory, with discussion of patriotism, states, an international federation, cultural pluralism, race and global economic justice (publisher abstract; NDPR). SUBFIELD AND DEBATE: Political philosophy and philosophy of history: cosmopolitan right, the development of Kant's position, and Kant on race and non-European peoples. SEP kant-social-political cites the book for Kant's cosmopolitanism and in a passage on Kant's views on race (the retrieved context sentence is truncated). SIGNIFICANCE INDICATORS: S2 citations: 139 (retrieved 2026-09-30); CrossRef: 90. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-cosmopolitanism/). Award: the North American Kant Society prize-winners page lists it (as Cambridge, 2013) as the 2014 Book Prize winner. SEP: listed in kant-mind (as 2011) and kant-social-political (as 2012) and cited in text. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2011-11 (online 2011-11); the NDPR review header gives 2011; SEP kant-social-political gives 2012 and the NAKS page gives 2013.",
    sep_context = {SEP kant-social-political: "For work that elaborates on various aspects of Kant's cosmopolitanism beyond these narrow limits, see Kleingeld 2012, Corradetti 2020, and Huber 2022."},
    keywords = "kant, pp-right-politics, anthro-hist-edu, debate-race, type-monograph, High",
    abstract = "This is the first comprehensive account of Kant's cosmopolitanism, highlighting its moral, political, legal, economic, cultural and psychological aspects. Contrasting Kant's views with those of his German contemporaries and relating them to current debates, Pauline Kleingeld sheds new light on texts that have been hitherto neglected or underestimated. In clear and carefully argued discussions, she shows that Kant's philosophical cosmopolitanism underwent a radical transformation in the mid 1790s and that the resulting theory is philosophically stronger than is usually thought. Using the work of figures such as Fichte, Cloots, Forster, Hegewisch, Wieland and Novalis, Kleingeld analyses Kant's arguments regarding the relationship between cosmopolitanism and patriotism, the importance of states, the ideal of an international federation, cultural pluralism, race, global economic justice and the psychological feasibility of the cosmopolitan ideal. In doing so, she reveals a broad spectrum of positions in cosmopolitan theory that are relevant to current discussions of cosmopolitanism.",
    abstract_source = "openalex"
}

@book{eldenmendieta2011geography,
    editor = "Elden, Stuart and Mendieta, Eduardo",
    title = "Reading Kant's Geography",
    publisher = "SUNY Press",
    year = "2011",
