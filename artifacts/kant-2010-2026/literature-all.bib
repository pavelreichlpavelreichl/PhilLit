@book{clewis2015lectures,
    editor = {Clewis, Robert R.},
    title = {Reading Kant's Lectures},
    publisher = {De Gruyter},
    year = {2015},
    doi = {10.1515/9783110345339},
    note = {SUMMARY: Collection of more than twenty original essays on Kant's teaching in relation to his published works, covering the student-note records of his lectures in metaphysics, logic, moral philosophy, anthropology, pedagogy, philosophical encyclopedia, natural rights, natural theology, mathematics, physics and physical geography (publisher abstract; NDPR). SUBFIELD AND DEBATE: Kant's lectures as a source: what the student-note records add to the published works; the abstract ties the volume to the Academy edition's continuing publication of the lectures and to English translations of several lecture courses. SIGNIFICANCE INDICATORS: S2 citations: 33 (retrieved 2026-09-30); CrossRef: 15. NDPR review: yes (ndpr.nd.edu/reviews/reading-kants-lectures/). Other review: Kant-Studien (Lorini, 2018). SEP: a chapter by Moretto is cited in the kant-mathematics bibliography. Publisher: De Gruyter. YEAR NOTE: CrossRef print date 2015-09-11, online 2015-09-02.},
    keywords = {kant, anthro-hist-edu, reference, type-edited-volume, Low},
    abstract = {This important collection of more than twenty original essays by prominent Kant scholars covers the multiple aspects of Kant’s teaching in relation to his published works. With the Academy edition’s continuing publication of Kant’s lectures, the role of his lecturing activity has been drawing more and more deserved attention. Several of Kant’s lectures on metaphysics, logic, ethics, anthropology, theology, and pedagogy have been translated into English, and important studies have appeared in many languages. But why study the lectures? When they are read in light of Kant’s published writings, the lectures offer a new perspective of Kant’s philosophical development, clarify points in the published texts, consider topics there unexamined, and depict the intellectual background in richer detail. And the lectures are often more accessible to readers than the published works. This book discusses all areas of Kant's lecturing activity. Some essays even analyze in detail the content of Kant's courses and the role of textbooks written by key authors such as Baumgarten, helping us understand Kant’s thought in its intellectual and historical contexts. Contributors: Huaping Lu-Adler; Henny Blomme ; Robert Clewis; Alix Cohen; Corey Dyck; Faustino Fabbianelli; Norbert Fischer; Courtney Fugate; Paul Guyer; Robert Louden; Antonio Moretto; Steve Naragon; Christian Onof; Stephen Palmquist; Riccardo Pozzo; Frederick Rauscher; Dennis Schulting; Oliver Sensen; Susan Shell; Werner Stark; John Zammito; Günter Zöller},
    abstract_source = {openalex},
}

@book{stang2016modal,
    author = {Stang, Nicholas F.},
    title = {Kant's Modal Metaphysics},
    publisher = {Oxford University Press},
    year = {2016},
    doi = {10.1093/acprof:oso/9780198712626.001.0001},
    note = {SUMMARY: Studies Kant's theory of possibility from the pre-Critical work of the 1750s and 1760s to the Critical system of the 1780s and early 1790s. It argues that the continuity and change between the two periods turn on Kant's transforming the ontological question about what all possible beings have in common into a transcendental question about how we represent possible objects a priori (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: Kant's modal metaphysics, tracing the pre-Critical to the Critical theory of possibility. Bears on the debate over the metaphysical significance of transcendental idealism and on the development of Kant's thought. SIGNIFICANCE INDICATORS: S2 citations: 186 (DOI-matched record, retrieved 2026-09-30); CrossRef is-referenced-by-count: 108. Publisher: Oxford University Press. NDPR review: Andrew Chignell (2017). SEP: listed in the kant-religion bibliography and cited in its section 1 (see sep_context).},
    sep_context = {SEP entry kant-religion (Kant's Philosophy of Religion), section 1 Overview, cites Stang 2016 for the reading of Kant's modal metaphysics as an attempted articulation of a metaphysical alternative to Leibnizian logicism, the view that anything not logically contradictory is possible.},
    keywords = {kant, tp-cpr, precritical, debate-other-modality, type-monograph, High},
    abstract = {Abstract This book is a study of Kant's theory of possibility, starting from the so-called 'pre-Critical' period of the 1750s and 1760s, through the Critical system of philosophy Kant published in the 1780s and the early 1790s. It discusses Kant's confrontation with the ontological theory of all possible beings shared by many of his rationalist predecessors, his own positive theory of possibility in the 1760s, and his distinctively Critical theory of possibility in the 1780s. It argues that the key to understanding both the change and the continuity between Kant's pre-Critical and his Critical theory of possibility is that he comes to believe that the ontological question about possibility (what do all possible beings have in common?) must be transformed into a question in 'transcendental philosophy': how do we represent possible objects a priori? It explores Kant's theory of possibility before he reoriented his theory around that question, why he believed that reorientation was necessary, what this transcendental question means, and his own answer to it. Possibility becomes one of the three "categories of modality" in the Critique, along with actuality/existence and necessity. Consequently, this book also investigates Kant's views about what distinguishes actuality from mere possibility, his theory of the closely related notion of existence, and his theory of necessity, including, crucially, his theory of necessary existence.},
    abstract_source = {openalex},
}

@article{mclear2016perceptual,
    author = {McLear, Colin},
    title = {Kant on Perceptual Content},
    journal = {Mind},
    year = {2016},
    volume = {125},
    number = {497},
    pages = {95--144},
    doi = {10.1093/mind/fzv191},
    note = {SUMMARY: Argues that although Kant is widely read as endorsing the Content View (perceptual states have intentional content and represent ways the world might be), this reading faces significant problems. It proposes instead that Kant holds a form of acquaintance theory of perception (journal abstract). SUBFIELD AND DEBATE: Theoretical philosophy and philosophy of mind: Kant's theory of perception and intuition. Opposes the Content View of perception in favour of an acquaintance reading, which bears on the perceptual-content, nonconceptualism and naive-realist debates. SIGNIFICANCE INDICATORS: S2 citations: 58 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 20. Venue: Mind 125(497). Not located in the SEP bibliographies retrieved. YEAR NOTE: CrossRef print date 2016-01 (issue 497), online 2016-02-12.},
    keywords = {kant, tp-mind, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {Call the idea that states of perceptual awareness have intentional content, and in virtue of that aim at or represent ways the world might be, the ‘Content View.’ I argue that though Kant is widely interpreted as endorsing the Content View there are significant problems for any such interpretation. I further argue that given the problems associated with attributing the Content View to Kant, interpreters should instead consider him as endorsing a form of acquaintance theory. Though perceptual acquaintance is controversial in itself and in attribution to Kant, it promises to make sense of central claims within his critical philosophy.},
    abstract_source = {openalex},
}

@book{schulting2016nonconceptualism,
    editor = {Schulting, Dennis},
    title = {Kantian Nonconceptualism},
    publisher = {Palgrave Macmillan UK},
    year = {2016},
    doi = {10.1057/978-1-137-53517-7},
    note = {SUMMARY: Collects essays by Kant scholars on whether, and in what sense, Kant allows nonconceptual content in intuition and perception, discussing the arguments around conceptualism and nonconceptualism (publisher abstract, truncated in the retrieved record). SUBFIELD AND DEBATE: Theoretical philosophy: the conceptualism versus nonconceptualism debate about Kantian intuition, including Allais's survey of the recent debate, Heidemann on aesthetic nonconceptualism and Onof and Tolley on space and cognition (chapters cited in SEP). SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 13 (book level; S2 holds chapter records only, for example Allais's survey at 13, retrieved 2026-09-30). Publisher: Palgrave Macmillan. NDPR review: James O'Shea (2019). SEP: chapters cited in the kant-conceptualism, kant-aesthetics, kant-judgment and kant-mathematics bibliographies.},
    keywords = {kant, tp-cpr, tp-mind, debate-conceptualism, type-edited-volume, Medium},
    abstract = {This book offers an array of important perspectives on Kant and nonconceptualism from some of the leading scholars in current Kant studies. As well as discussing the various arguments surrounding Kant},
    abstract_source = {openalex},
}

@article{conant2016kantian,
    author = {Conant, James},
    title = {Why Kant Is Not a Kantian},
    journal = {Philosophical Topics},
    year = {2016},
    volume = {44},
    number = {1},
    pages = {75--125},
    doi = {10.5840/philtopics20164417},
    note = {SUMMARY: Argues that Kant rejects the shared assumption of empiricist and rationalist epistemology that sensibility and understanding are each self-standingly intelligible capacities (the 'Layer-Cake Conception of Human Mindedness'). On Conant's reading of the B Deduction, the two capacities must be made sense of in the light of each other (journal abstract). SUBFIELD AND DEBATE: Theoretical philosophy: the Transcendental Deduction and the relation of sensibility and understanding. A central statement of the conceptualist reading in the conceptualism debate. SIGNIFICANCE INDICATORS: S2 citations: 49 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 46. Venue: Philosophical Topics 44(1). SEP: listed in the kant-conceptualism bibliography. YEAR NOTE: CrossRef gives 2016 (online and issued); CrossRef lists University of Arkansas Press as a second author, which is a data artefact and is omitted.},
    keywords = {kant, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {A central debate in early modern philosophy, between empiricism and rationalism, turned on the question which of two cognitive faculties—sensibility or understanding—should be accorded logical priority in an account of the epistemic credentials of knowledge. As against both the empiricist and the rationalist, Kant wants to argue that the terms of their debate rest on a shared common assumption: namely that the capacities here in question—qua cognitive capacities—are self-standingly intelligible. The paper terms this assumption the Layer-Cake Conception of Human Mindedness and focuses on Kant’s argument against the empiricist version of the assumption, in particular, as that argument is developed in the B version of the Transcendental Deduction in the Critique of Pure Reason . The paper seeks to show how a proper understanding of the structure of the B Deduction reveals its aim to be one of making sense of each of these two capacities (sensibility and understanding) in the light of the other. For the front of the argument that is directed against the empiricist, this means coming to see how a reading of the text that is informed by the layer-cake conception (and which therefore takes the Transcendental Aesthetic to furnish us with the full story about the nature of our faculty for sensory apprehension) is mistaken. For the front of the argument which is directed against the rationalist, this requires coming to see how a mere inversion of the central claim of such a reading would be equally wrong. It would require seeing how a discursive faculty of understanding able to traffic in nothing more than empty concepts would no more amount to a genuinely cognitive power than would a faculty of intuition able to traffic in nothing more than blind intuitions. That is, it requires seeing how each of these faculties depends on its relation to the other to be the sort of faculty that it is in a finite rational being.},
    abstract_source = {openalex},
}

@article{mcnulty2016chemistry,
    author = {McNulty, Michael Bennett},
    title = {Chemistry in Kant's Opus Postumum},
    journal = {HOPOS: The Journal of the International Society for the History of Philosophy of Science},
    year = {2016},
    volume = {6},
    number = {1},
    pages = {64--95},
    doi = {10.1086/685561},
    note = {SUMMARY: Asks whether Kant, who in the Opus postumum adopts a broadly Lavoisierian chemistry, still regards chemistry as an improper though rational science. It answers yes, arguing against Tuschling that mathematical construction keeps a central role in the foundations of proper natural science and that the aether and the enumeration of the elements do not make chemistry a proper science (journal abstract). SUBFIELD AND DEBATE: Opus postumum and philosophy of science: Kant's late views on chemistry and the conditions of proper science; answers Burkhard Tuschling. SIGNIFICANCE INDICATORS: S2 citations: 5 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 0. Venue: HOPOS. SEP: listed in the kant-science bibliography.},
    keywords = {kant, opus-postumum, tp-science-math, type-article, Medium},
    abstract = {In his Metaphysische Anfangsgründe der Naturwissenschaft, Kant claims that chemistry is an improper although rational science. The chemistry to which Kant confers this status is the phlogistic chemistry of, for instance, Georg Stahl. In his Opus Postumum (OP), however, Kant espouses a broadly Lavoiserian conception of chemistry. In particular, Kant endorses Lavoisier’s elements, oxygen theory of combustion, and role for the caloric. As Lavoisier’s lasting contribution to chemistry, according to some histories of the science, was his emphasis on quantitative methods, Kant’s assimilation of the chemical revolution raises the question: Did Kant continue to think of chemistry as an improper, although rational, science in OP? In this article, I answer this question affirmatively. I explain that a proper science requires a priori laws for the mathematical construction of its objects: the mere use of quantitative measurements is insufficient for the satisfaction of this requirement. Further, I argue, contra Burkhard Tuschling, that in OP Kant retains a central role for mathematical construction in the foundations of proper natural science. Finally, I contend that the prominent a priori components of chemistry discussed in OP—the aether and the enumeration of the elements—do not make chemistry into a proper science.},
    abstract_source = {openalex},
}

@article{nassar2016analogical,
    author = {Nassar, Dalia},
    title = {Analogical reflection as a source for the science of life: Kant and the possibility of the biological sciences},
    journal = {Studies in History and Philosophy of Science Part A},
    year = {2016},
    volume = {58},
    pages = {57--66},
    doi = {10.1016/j.shpsa.2016.03.008},
    note = {SUMMARY: Brings together historians of science and historians of philosophy on Kant and the life sciences by arguing that Kant's notion of reflective judgment contributed to the ontological concern with life as a distinctive object of study. Although Kant says biology cannot be a science, his more fundamental claim is that the study of living beings requires an essentially analogical mode of thought (abstract via CORE). SUBFIELD AND DEBATE: Aesthetics and teleology, Kant and the life sciences: reflective judgment, organisms and the methodology of biology. SIGNIFICANCE INDICATORS: S2 citations: 19 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 11. Venue: Studies in History and Philosophy of Science Part A 58. Not located in the SEP bibliographies retrieved.},
    keywords = {kant, aes-teleo, tp-science-math, type-article, Low},
    abstract = {In contrast to the previously widespread view that Kant's work was largely in dialogue with the physical sciences, recent scholarship has highlighted Kant's interest in and contributions to the life sciences. Scholars are now investigating the extent to which Kant appealed to and incorporated insights from the life sciences and considering the ways he may have contributed to a new conception of living beings. The scholarship remains, however, divided in its interest: historians of science are concerned with the content of Kant's claims, and the ways in which they may or may not have contributed to the emerging science of life, while historians of philosophy focus on the systematic justifications for Kant's claims, e.g., the methodological and theoretical underpinnings of Kant's statement that living beings are mechanically inexplicable. My aim in this paper is to bring together these two strands of scholarship into dialogue by showing how Kant's methodological concerns (specifically, his notion of reflective judgment) contributed to the ontological concern with life as a distinctive object of study. I argue that although Kant's explicit statement was that biology could not be a science, his implicit and more fundamental claim was that the study of living beings necessitates a distinctive mode of thought, a mode that is essentially analogical. I consider the implications of this view, and argue that it is by developing a new methodology for grasping organized beings that Kant makes his most important contribution to the new science of life},
    abstract_source = {core}
}

@book{guyer2016virtues,
    author = {Guyer, Paul},
    title = {Virtues of Freedom: Selected Essays on Kant},
    publisher = {Oxford University Press},
    year = {2016},
    doi = {10.1093/acprof:oso/9780198755647.001.0001},
    note = {SUMMARY: Collects essays on Kant's attempt to ground morality in the unconditional value of the human freedom to set one's own ends, which becomes autonomy when regulated by the equal value of everyone's freedom. The essays also treat Kant's proofs of freedom, the cultivation of moral feelings such as respect, love and self-esteem, and models of human community (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy: humanity, autonomy and freedom in the Groundwork and Metaphysics of Morals; a collection of previously published essays. SIGNIFICANCE INDICATORS: S2 citations: 29 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 21. Publisher: Oxford University Press. NDPR review: Anne Margaret Baxley (2018). SEP: listed in the kant-moral and kant-hume-morality bibliographies. YEAR NOTE: Collection of essays first published between the 1980s and 2010s (dated by the collection, CrossRef print date 2016-12-08).},
    keywords = {kant, pp-ethics, pp-mm-virtue, type-monograph, Medium},
    abstract = {Abstract The essays collected in this volume explore Kant’s attempt to develop a morality grounded on the intrinsic and unconditional value of the human freedom to set our own ends. When regulated by the principle that the freedom of all is equally valuable, the freedom to set our own ends—what Kant calls “humanity”—becomes what he calls autonomy. The chapters explore Kant’s strategies for establishing the premise that freedom is the inner worth of the world or the essential end of humankind, as he says, and for deriving the specific duties that fundamental principle of morality generates in the empirical circumstances of human existence. The volume further investigates Kant’s attempts to prove that we are always free to live up to this moral ideal, that is, that we have free will no matter what, as well as his more successful explorations of the ways in which our natural tendencies to be moral—dispositions to the feeling of respect and more specific feelings such as love and self-esteem—can and must be cultivated and educated. It finally examines the various models of human community that Kant develops from his premise that our associations must be based on the value of freedom for all. The contrasts but also similarities of Kant’s moral philosophy to that of David Hume but many of his other predecessors and contemporaries are explored as well.},
    abstract_source = {openalex},
}

@book{hoewing2016highest,
    editor = {Höwing, Thomas},
    title = {The Highest Good in Kant's Philosophy},
    publisher = {De Gruyter},
    year = {2016},
    doi = {10.1515/9783110369007},
    note = {SUMMARY: Collects new essays re-evaluating Kant's doctrine of the highest good as a combination of virtue and happiness. The essays address its role in the moral argument for faith, the antinomy of pure practical reason, the primacy of practical reason, and Kant's views of the final end of nature and historical progress (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy and religion: the highest good and moral faith; essays by Kleingeld on the good and the duty to promote the highest good and by others on Kant, Mendelssohn and immortality (chapters cited in SEP). SIGNIFICANCE INDICATORS: S2 citations: 30 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 12. Publisher: De Gruyter. SEP: chapters cited in the kant-reason and kant-religion bibliographies. NDPR review: none located. YEAR NOTE: CrossRef print date 2016-04-25, online 2016-04-22.},
    keywords = {kant, pp-ethics, religion, type-edited-volume, Medium},
    abstract = {The idea of a final end of human conduct – the highest good – plays an important role in Kant’s philosophy. Unlike his predecessors Kant defines the highest good as a combination of two heterogeneous elements, namely virtue and happiness. This conception lies at the centre of some of the most influential Kantian doctrines such as his famous “moral argument” for the rationality of faith, his conception of the unity of reason and his views concerning the final end of nature as well as the historical progress of mankind. To be sure, the different treatments of the highest good in Kant’s work have led to a great deal of discussion among his readers. Besides Kant’s arguments for moral faith, recent debate has focused on the place of the highest good within Kant’s moral theory, on the antinomy of pure practical reason, and on the idea of the primacy of practical reason. This collection of new essays attempts to re-evaluate Kant’s doctrine of the highest good and to determine its relevance for contemporary philosophy.},
    abstract_source = {openalex},
}

@book{rauscher2016lectures,
    author = {Kant, Immanuel},
    editor = {Rauscher, Frederick},
    title = {Lectures and Drafts on Political Philosophy},
    publisher = {Cambridge University Press},
    year = {2016},
    doi = {10.1017/9781139046237},
    note = {SUMMARY: First English translation of the reflections Kant wrote while developing his political philosophy, including preparatory drafts for Theory and Practice, Toward Perpetual Peace, the Doctrine of Right and the Conflict of the Faculties, and the only surviving student transcription of his course on Natural Right. The texts trace the development of his thought from his first exposure to Rousseau in the 1760s to the 1790s (publisher abstract). SUBFIELD AND DEBATE: Edition and translation in the Cambridge Edition of the Works of Immanuel Kant; political and legal philosophy (sovereignty, property, peace, the French Revolution). SEP lists it as translated by Frederick Rauscher and Kenneth Westphal. SIGNIFICANCE INDICATORS: S2 citations: 43 (title-matched record, retrieved 2026-09-30); CrossRef is-referenced-by-count: 54. Publisher and series: Cambridge University Press, Cambridge Edition of the Works of Immanuel Kant. SEP: listed in the kant-social-political bibliography. NDPR review: none located. YEAR NOTE: Translation of Kant's lecture notes and drafts (1760s to 1790s); CrossRef print date 2016-08-18.},
    keywords = {kant, edition-trans, pp-right-politics, type-translation-edition, Medium},
    abstract = {This book is the first translation into English of the Reflections which Kant wrote whilst formulating his ideas in political philosophy: the preparatory drafts for Theory and Practice, Toward Perpetual Peace, the Doctrine of Right, and Conflict of the Faculties; and the only surviving student transcription of his course on Natural Right. Through these texts one can trace the development of his political thought, from his first exposure to Rousseau in the mid 1760s through to his last musings in the late 1790s after his final system of Right was published. The material covers such topics as the central role of freedom, the social contract, the nature of sovereignty, the means for achieving international peace, property rights in relation to the very possibility of human agency, the general prohibition of rebellion, and Kant's philosophical defense of the French Revolution.},
    abstract_source = {openalex},
}

@book{westphal2016natlaw,
    author = {Westphal, Kenneth R.},
    title = {How Hume and Kant Reconstruct Natural Law: Justifying Strict Objectivity without Debating Moral Realism},
    publisher = {Oxford University Press},
    year = {2016},
    doi = {10.1093/acprof:oso/9780198747055.001.0001},
    note = {SUMMARY: Argues that Hume and Kant share a constructivist method for identifying basic moral principles and justifying their strict objectivity without invoking moral realism or anti-realism. Basic principles of justice are artificial but not arbitrary, because they answer problems of social coordination with reasons that can be addressed to all parties (publisher abstract). SUBFIELD AND DEBATE: Political and moral philosophy: constructivism in Hume and Kant and the natural-law tradition. Joins the constructivism versus realism debate by claiming a common constructivist method for both authors. SIGNIFICANCE INDICATORS: S2 citations: 17 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 12. Publisher: Oxford University Press. NDPR review: Richard McCarty (2016). SEP: listed in the kant-social-political bibliography.},
    keywords = {kant, pp-right-politics, pp-ethics, debate-constructivism, type-monograph, Medium},
    abstract = {Abstract The differences between Hume's and Kant's moral philosophies are prominent in the literature. Focussing on them, however, occludes a decisive, shared achievement: a distinctive constructivist method to identify basic moral principles and to justify their strict objectivity, without invoking moral realism nor moral anti- or irrealism. Their constructivism is based on Hume's key insight that 'though the laws of justice are artificial, they are not arbitrary'. Arbitrariness in basic moral principles is avoided by starting with fundamental problems of social coordination, which concern outward behaviour and physiological needs; basic principles of justice are artificial because solving those problems does not require appeal to moral realism (nor to moral anti-realism). Instead, moral cognitivism is preserved by identifying sufficient justifying reasons, which can be addressed to all parties, for the minimum sufficient legitimate principles and institutions required to provide and protect basic forms of social coordination (including verbal behaviour). Hume first develops this kind of constructivism for basic property rights and for government. Kant greatly refines Hume's construction of justice within his 'metaphysical principles of justice', whilst preserving the core model of Hume's innovative constructivism. Hume's and Kant's constructivism avoids the conventionalist and relativist tendencies latent, if not explicit, in contemporary forms of moral constructivism.},
    abstract_source = {openalex},
}

@article{allais2016racism,
    author = {Allais, Lucy},
    title = {Kant's Racism},
    journal = {Philosophical Papers},
    year = {2016},
    volume = {45},
    number = {1-2},
    pages = {1--36},
    doi = {10.1080/05568641.2016.1199170},
    note = {SUMMARY: Responds to Charles Mills's proposal that Kant can be made consistent on race by a threshold notion of moral personhood on which some races do not qualify under the categorical imperative. Allais argues that Kant cannot be made consistent and that his racism should instead be used to learn about the nature of racism, since his moral philosophy and moral psychology supply materials for understanding it (journal abstract). SUBFIELD AND DEBATE: Anthropology and race: Kant's racism and its relation to his universalist ethics. Central to the Kant-and-race debate over whether racism is systematically linked to the moral theory; answers Mills. SIGNIFICANCE INDICATORS: S2 citations: 58 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 48. Venue: Philosophical Papers 45(1-2). Not located in the SEP bibliographies retrieved (the critical-phil-race bibliography was retrieved). YEAR NOTE: CrossRef print date 2016-05-03 (online 2016-06-23).},
    keywords = {kant, anthro-hist-edu, pp-ethics, debate-race, type-article, High},
    abstract = {After a long period of comparative neglect, in the last few decades growing numbers of philosophers have been paying attention to the startling contrast presented between Kant’s universal moral theory, with its inspiring enlightenment ideas of human autonomy, equality and dignity and Kant’s racism. Against Charles Mills, who argues that the way to make Kant consistent is by attributing to him a threshold notion of moral personhood, according to which some races do not qualify for consideration under the categorical imperative, I argue that Kant cannot be made consistent on race, and that rather than trying to make him so, we should use the example of Kant’s racism to tell us something about the nature of racism. I argue that Kant’s own moral philosophy and moral psychology in fact give some materials for thinking about his racism, and about racism.},
    abstract_source = {openalex},
}

@book{fugate2016eberhard,
    author = {Eberhard, Johann August},
    editor = {Fugate, Courtney D. and Hymers, John},
    title = {Preparation for Natural Theology: With Kant's Notes and the Danzig Rational Theology Transcript},
    publisher = {Bloomsbury Academic},
    year = {2016},
    doi = {10.5040/9781474213868},
    note = {SUMMARY: First English translation of Eberhard's 1781 textbook Preparation for Natural Theology, which Kant used as the basis for his lectures on the philosophical doctrine of religion, together with Kant's notes and the Danzig rational theology transcript. The complete text makes it possible to separate Eberhard's words from Kant's own ideas in the lectures (publisher abstract). SUBFIELD AND DEBATE: Translation and religion: Kant's rational theology lectures and the sources of his practical and religious doctrines. SIGNIFICANCE INDICATORS: S2 citations: 5 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 0. Publisher: Bloomsbury Academic. NDPR review: Stephen Palmquist (2016). SEP: listed in the kant-religion bibliography. YEAR NOTE: Translation of Eberhard (1781) with Kant's notes; CrossRef gives 2016 (issued and online; no print date).},
    keywords = {kant, edition-trans, religion, type-translation-edition, Medium},
    abstract = {Designed as a textbook for use in courses on natural theology and used by Immanuel Kant as the basis for his Lectures on The Philosophical Doctrine of Religion, Johan August Eberhard’s Preparation for Natural Theology (1781) is now available in English for the first time. With a strong focus on the various intellectual debates and historically significant texts in late renaissance and early modern theology, Preparation for Natural Theology influenced the way Kant thought about practical cognition as well as moral and religious concepts. Access to Eberhard’s complete text makes it possible to distinguish where in the lectures Kant is making changes to what Eberhard has written and where he is articulating his own ideas. Identifying new unexplored lines of research, this translation provides a deeper understanding of Kant's explicitly religious doctrines and his central moral writings, such as the Groundwork of the Metaphysics of Morals and the Critique of},
    abstract_source = {openalex},
}

@article{dyck2016spontaneity,
    author = {Dyck, Corey W.},
    title = {Spontaneity before the Critical Turn: The Spontaneity of the Mind in Crusius, the Pre-Critical Kant, and Tetens},
    journal = {Journal of the History of Philosophy},
    year = {2016},
    volume = {54},
    number = {4},
    pages = {625--648},
    doi = {10.1353/hph.2016.0073},
    note = {SUMMARY: Argues that, contrary to the view that the spontaneity of the understanding is a central innovation of the Critique of Pure Reason, eighteenth-century German thinkers had already developed a robust conception of mental spontaneity. It examines the accounts of Crusius, the pre-Critical Kant and Tetens as an interconnected, overlooked context for Kant's later doctrine (journal abstract). SUBFIELD AND DEBATE: Pre-critical work and philosophy of mind: the historical background of Kant's doctrine of the spontaneity of the understanding. SIGNIFICANCE INDICATORS: S2 citations: 38 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 15. Venue: Journal of the History of Philosophy 54(4). Not located in the SEP bibliographies retrieved.},
    keywords = {kant, precritical, tp-mind, type-article, Medium},
    abstract = {The introduction of a spontaneity proper to the understanding in the Kritik der reinen Vernunft is often thought to be one of the central innovations of Kant’s Critical philosophy. Yet a number of thinkers within the eighteenth-century German tradition in the time before the KrV had already developed a robust conception of the spontaneity of the mind. In this paper, I consider three influential accounts of the spontaneity of the mind—those of Crusius, the pre-Critical Kant, and Tetens—which, while distinct, nonetheless relate to and explicitly draw upon one another in important ways, forming the interconnected and, thus far, largely overlooked pre-Critical context for Kant’s discussion of the spontaneity of the understanding.},
    abstract_source = {openalex},
}

@article{matherne2016merleau,
    author = {Matherne, Samantha},
    title = {Kantian Themes in Merleau-Ponty's Theory of Perception},
    journal = {Archiv für Geschichte der Philosophie},
    year = {2016},
    volume = {98},
    number = {2},
    pages = {193--230},
    doi = {10.1515/agph-2016-0009},
    note = {SUMMARY: Challenges the standard picture of Kant as an intellectualist and Merleau-Ponty as his non-conceptualist challenger, arguing through Kant's schematism, the neo-Kantian Lachièze-Rey and Merleau-Ponty's body schema that Merleau-Ponty's theory of perception develops Kant's (journal abstract). SUBFIELD AND DEBATE: Reception (phenomenology): Kant and Merleau-Ponty on perception and schematism; bears on the conceptualism and nonconceptualism debate. SIGNIFICANCE INDICATORS: S2 citations: 27 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 20. Venue: Archiv für Geschichte der Philosophie 98(2). Not located in the SEP bibliographies retrieved. YEAR NOTE: CrossRef print date 2016-06-28 (issue 98(2)); published online the same date.},
    keywords = {kant, recep-phenom, tp-mind, debate-conceptualism, type-article, Medium},
    abstract = {Abstract: It has become typical to read Kant and Merleau-Ponty as offering competing approaches to perceptual experience. Kant is interpreted as an ‘intellectualist’ who regards perception as conceptual ‘all the way out’, while Merleau-Ponty is seen as Kant’s challenger, who argues that perception involves non-conceptual, embodied ‘coping’. In this paper, however, I argue that a closer examination of their views of perception, especially with respect to the notion of ‘schematism’, reveals a great deal of historical and philosophical continuity between them. By analyzing Kant’s theory of schematism, the interpretation of it by the Neo-Kantian Pierre Lachièze-Rey, and Merleau-Ponty’s theory of the body schema, we find that aspects of Merleau-Ponty’s theory of perception are better understood as a development of Kant’s theory of perception.},
    abstract_source = {openalex},
}

@book{longuenesse2017,
    author = {Longuenesse, Béatrice},
    title = {I, Me, Mine: Back to Kant, and Back Again},
    publisher = {Oxford University Press},
    year = {2017},
    doi = {10.1093/acprof:oso/9780199665761.001.0001},
    note = {SUMMARY: Analyses Kant's distinction between consciousness of oneself as subject and as object and its relevance to contemporary discussions of self-consciousness and the first person, in dialogue with recent philosophy of language and mind and with Sartre. It argues that Kant identified a specific kind of self-consciousness, awareness of one's activity of bringing rational unity to one's mental states, and offers a critical analysis of his critique of rational psychology in the Paralogisms (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and philosophy of mind: apperception, the 'I think' and the Paralogisms, read against analytic discussions of the first person. SIGNIFICANCE INDICATORS: S2 citations: 91 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 74. Publisher: Oxford University Press. NDPR review: Patricia Kitcher (2017). SEP: listed in the kant-mind and kant-transcendental bibliographies.},
    keywords = {kant, tp-mind, tp-cpr, type-monograph, High},
    abstract = {Abstract Immanuel Kant distinguished between consciousness of oneself as a subject, and consciousness of oneself as an object. This book analyzes Kant's distinction and its relevance to contemporary discussions. Part I analyzes discussions of self-consciousness and the first person in recent philosophy of language and mind, in connection to Kant's view on the one hand; and to Jean-Paul Sartre's view on the other. Kant's unique contribution is to have identified, as a specific type of self-consciousness, one's consciousness of being engaged in bringing rational unity into the contents of one's mental states. Part II discusses Kant's analysis of the role of 'I' in 'I think,' and the criticism of the rationalist metaphysical concept of a soul Kant derives from his analysis of 'I think.' Kant's groundbreaking contribution, it is argued, is to have contrasted the first-person standpoint a thinker has on her activity of thinking; and the third-person standpoint on which alone theoretical knowledge of the entity that thinks can be grounded. A critical analysis is offered of Kant's psychological and moral concepts of person. Part III argues that Freud's concepts of 'ego' and 'super-ego' offer resources for a naturalization of Kant's view of the structure of mental life grounding the uses of 'I' in 'I think' and in the moral 'I ought to.' The final chapter discusses the plausibility of relating views based on such different methods as those of analytic philosophy of language and mind, of Kant's transcendental philosophy, and of Freudian metapsychology.},
    abstract_source = {openalex},
}

@book{pollok2017,
    author = {Pollok, Konstantin},
    title = {Kant's Theory of Normativity: Exploring the Space of Reason},
    publisher = {Cambridge University Press},
    year = {2017},
    doi = {10.1017/9781316412503},
    note = {SUMMARY: Offers a book-length analysis of Kant's theory of normativity across theoretical and practical philosophy and aesthetics. It reads the critical turn as a normative turn: Kant departs from the perfectionism of early modern rationalism and arrives at synthetic a priori principles that fix the validity of our judgments, and relates reason's self-legislation to the natural-right tradition (publisher abstract). SUBFIELD AND DEBATE: Theoretical and practical philosophy: normativity, judgment and self-legislation; a systematic reading of the critical philosophy as a theory of norms. SIGNIFICANCE INDICATORS: S2 citations: 100 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 63. Publisher: Cambridge University Press. NDPR review: Yoon Choi (2017). SEP: listed in the kant-reason and kant-aesthetics bibliographies.},
    keywords = {kant, tp-cpr, pp-ethics, debate-other-normativity, type-monograph, High},
    abstract = {Konstantin Pollok offers the first book-length analysis of Kant's theory of normativity that covers foundational issues in theoretical and practical philosophy as well as aesthetics. Interpreting Kant's 'critical turn' as a normative turn, he argues that Kant's theory of normativity is both original and radical: it departs from the perfectionist ideal of early modern rationalism, and arrives at an unprecedented framework of synthetic a priori principles that determine the validity of our judgments. Pollok examines the hylomorphism in Kant's theory of normativity and relates Kant's idea of our reason's self-legislation to the 'natural right' tradition, revealing Kant's debt to his predecessors as well as his relevance to contemporary debates on normativity. This book will appeal to academic researchers and advanced students of Kant, early modern philosophy and intellectual history.},
    abstract_source = {openalex},
}

@article{watkinswillaschek2017,
    author = {Watkins, Eric and Willaschek, Marcus},
    title = {Kant's Account of Cognition},
    journal = {Journal of the History of Philosophy},
    year = {2017},
    volume = {55},
    number = {1},
    pages = {83--112},
    doi = {10.1353/hph.2017.0003},
    note = {SUMMARY: Sets out the structure of Kant's account of theoretical cognition (Erkenntnis) in the first Critique. It argues that cognition is a mental state that determines a given object by attributing general features to it, that givenness involves an immediate relation to an existing object, and that cognition is therefore distinct from knowledge (Wissen) (journal abstract). SUBFIELD AND DEBATE: Theoretical philosophy: cognition, givenness and the roles of sensibility and understanding; a framework reading that feeds the naive-realist and nonconceptualist debates about intuition. SIGNIFICANCE INDICATORS: S2 citations: 119 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 50. Venue: Journal of the History of Philosophy 55(1), which also carried responses by Grüne and Chignell (S2, SEP) and a reply by the authors (SEP). SEP: listed in the kant-religion and kant-conceptualism bibliographies.},
    keywords = {kant, tp-cpr, debate-conceptualism, type-article, High},
    abstract = {In this paper, we offer an overview of the basic structure of Kant's account of cognition, of the conditions on the notion of cognition most central to the first Critique, and how they are satisfied in the case of human beings. Our primary aim in this regard is to provide a comprehensive (albeit not exhaustive) framework for understanding Kant's account of (theoretical) cognition. In the course of doing so, we argue for various interpretative claims, which, taken together, amount to a novel understanding of Kant's account of cognition. First, we argue that cognition is a mental state that determines a given object by attributing general features to it. Second, we explain what it means for Kant for an object to be given: givenness in the relevant sense involves an immediate relation to an existing object. These first two claims imply that cognition (Erkenntnis) is distinct from knowledge (Wissen), both in Kant's sense and in our modern sense. Third, we note some fundamental ambiguities about what sensibility and understanding are, and point out that purely causal interpretations of these faculties are problematic. Fourth, we distinguish between an intuition and an intuitive representation (analogous to the distinction between a concept and a discursive representation) in such a way that an intuition is one specific kind of intuitive representation. Fifth, we describe two different accounts of concepts ('logical' and 'psychological') and explain how they complement each other (despite their distinctness). Sixth, we diagnose several confusions regarding whether Kant is or is not a non-conceptualist about intuitions (though without attempting a definitive resolution to that debate). Finally, we show how our analysis of cognition clarifies what the most promising lines of argument are for Kant's claim that we cannot have cognition of the objects of traditional metaphysics (while still allowing for limited kinds of knowledge of things in themselves).},
    abstract_source = {openalex},
}

@book{gomesstephenson2017,
    editor = {Gomes, Anil and Stephenson, Andrew},
    title = {Kant and the Philosophy of Mind: Perception, Reason, and the Self},
    publisher = {Oxford University Press},
    year = {2017},
    doi = {10.1093/oso/9780198724957.001.0001},
    note = {SUMMARY: Fourteen newly written essays on the philosophy of mind in Kant's writings: mental processing in intuition, the object-dependence of intuitions, imagination and inner sense, and the nature of the self and self-consciousness. The volume also draws out the relevance of these topics to contemporary philosophy of mind (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and philosophy of mind: perception, object-dependent intuition, the self and self-consciousness; includes Chignell's Refutation of Idealism chapter and Horstmann on imagination and inner intuition (chapters cited in SEP). SIGNIFICANCE INDICATORS: S2 citations: 12 (title-matched record, retrieved 2026-09-30); CrossRef is-referenced-by-count: 8. Publisher: Oxford University Press. SEP: listed in the kant-conceptualism bibliography. NDPR review: none located; a British Journal for the History of Philosophy review by Matthew Altman appears in S2 (2018).},
    keywords = {kant, tp-mind, debate-conceptualism, type-edited-volume, Medium},
    abstract = {The essays in this volume explore those aspects of Kant’s writings which concern issues in the philosophy of mind. These issues are central to any understanding of Kant’s Critical philosophy and they bear upon contemporary discussions in the philosophy of mind. Fourteen specially written essays address such questions as: What role does mental processing play in Kant’s account of intuition? In what sense, and in what ways, are intuitions object-dependent? How should we understand the nature of the imagination and inner sense? What is the nature of the self, and in what ways are we aware of ourselves in self-consciousness? These essays showcase the depth of Kant’s writings in the philosophy of mind, and the centrality of those writings to his wider philosophical project. Moreover, they show the continued relevance of Kant’s writings to contemporary debates about the nature of mind and self.},
    abstract_source = {openalex},
}

@book{massimibreitenbach2017,
    editor = {Massimi, Michela and Breitenbach, Angela},
    title = {Kant and the Laws of Nature},
    publisher = {Cambridge University Press},
    year = {2017},
    doi = {10.1017/9781316389645},
    note = {SUMMARY: A volume of new essays exploring Kant's views on the laws of nature in the physical and life sciences, presented as the first systematic investigation of its kind. Topics include the separation of the physical and life sciences in Kant's treatment, the relation between universal and empirical laws, and the role of reason and understanding in imposing lawful unity on nature (publisher abstract). SUBFIELD AND DEBATE: Philosophy of science: laws of nature, nomic necessity and lawful unity across physics and biology; includes Massimi on grounds, modality and nomic necessity and Messina on necessitation accounts of laws. SIGNIFICANCE INDICATORS: S2 citations: 32 (DOI-matched record, retrieved 2026-09-30); CrossRef is-referenced-by-count: 15. Publisher: Cambridge University Press. NDPR review: Jessica Leech (2018). SEP: listed in the kant-science, kant-leibniz and kant-aesthetics bibliographies.},
    keywords = {kant, tp-science-math, aes-teleo, type-edited-volume, Medium},
    abstract = {Laws of nature play a central role in Kant's theoretical philosophy and are crucial to understanding his philosophy of science in particular. In this volume of new essays, the first systematic investigation of its kind, a distinguished team of scholars explores Kant's views on the laws of nature in the physical and life sciences. Their essays focus particularly on the laws of physics and biology, and consider topics including the separation in Kant's treatment of the physical and life sciences, the relation between universal and empirical laws of nature, and the role of reason and the understanding in imposing order and lawful unity upon nature. The volume will be of great interest to advanced students and scholars of Kant's philosophy of science, and to historians and philosophers of science more generally.},
    abstract_source = {openalex},
}

@book{oshea2017,
    editor = {O'Shea, James R.},
    title = {Kant's Critique of Pure Reason: A Critical Guide},
    publisher = {Cambridge University Press},
    year = {2017},
    doi = {10.1017/9781139871389},
    note = {SUMMARY: A Cambridge Critical Guide in which an international team of Kant scholars clarifies the terms and arguments of the first Critique and engages with its debates, including the interpretation of transcendental idealism, conceptualism and nonconceptual content in perception, and the soundness of transcendental arguments (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy: volume-length survey of the first Critique covering the two-aspect and conceptualism debates; includes O'Shea on the Transcendental Aesthetic and the mathematical principles, and Watkins on sensibility and understanding. SIGNIFICANCE INDICATORS: S2: no book-level record found (chapter records only, retrieved 2026-09-30); CrossRef is-referenced-by-count: 6. Series: Cambridge Critical Guides, Cambridge University Press. NDPR review: James Messina (2017). SEP: listed in the kant-conceptualism bibliography. YEAR NOTE: CrossRef print date 2017-06-09, online 2017-06-29.},
    keywords = {kant, tp-cpr, debate-two-aspect, debate-conceptualism, type-edited-volume, Medium},
    abstract = {Kant's monumental book the Critique of Pure Reason was arguably the most conceptually revolutionary work in the history of philosophy and its impact continues to be felt throughout philosophical debates today. However, it is a notoriously difficult work whose basic meaning and lasting philosophical significance are both subject to ongoing controversy. In this Critical Guide, an international team of leading Kant scholars addresses the challenges, clarifying Kant's basic terms and arguments and engaging with the debates that surround this central text. Providing compact explanations along with cutting-edge interpretations of nearly all of the main themes and arguments in Kant's Critique, this volume provides well-balanced arguments on such controversial topics as the interpretation of Kant's transcendental idealism, conceptualism and non-conceptual content in perception, and the soundness of his transcendental arguments. This volume will engage readers of Kant at all levels.},
    abstract_source = {openalex},
}

@article{sutherland2017number,
    author = {Sutherland, Daniel},
    title = {Kant's Conception of Number},
    journal = {The Philosophical Review},
    year = {2017},
    volume = {126},
    number = {2},
    pages = {147--190},
    doi = {10.1215/00318108-3771988},
    note = {SUMMARY: Investigates Kant's conception of natural number, setting aside the role of intuition in arithmetic. It argues that the conception contains both cardinal and ordinal elements: the cardinal elements give the basis of a conception of number in general and the ordinal elements specify the size of particular collections, which prepares a reevaluation of the role of intuition (journal abstract). SUBFIELD AND DEBATE: Philosophy of mathematics: Kant on arithmetic and number; part of the revival of work on Kant's mathematics. SIGNIFICANCE INDICATORS: S2 citations: 4 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 6. Venue: The Philosophical Review 126(2). SEP: listed in the kant-mathematics bibliography.},
    keywords = {kant, tp-science-math, type-article, Medium},
    abstract = {Despite the importance of Kant's claims about mathematical cognition for his philosophy as a whole and for subsequent philosophy of mathematics, there is still no consensus on his philosophy of arithmetic, and in particular the role he assigns intuition in it. This inquiry sets aside the role of intuition for the nonce to investigate Kant's conception of natural number. Although Kant himself doesn't distinguish between a cardinal and an ordinal conception of number, some of the properties Kant attributes to number can be characterized as cardinal or ordinal. This essay argues that Kant's conception of number includes both cardinal and ordinal elements; it suggests that the cardinal elements provide the basis of a conception of number in general, while the ordinal elements contribute to specifying the exact size of particular collections. In considering these elements, roles for intuition begin to emerge, setting the stage for a reevaluation of the role of intuition in Kant's arithmetic.},
    abstract_source = {openalex},
}

@article{huneman2017organism,
    author = {Huneman, Philippe},
    title = {Kant's Concept of Organism Revisited: A Framework for a Possible Synthesis between Developmentalism and Adaptationism?},
    journal = {The Monist},
    year = {2017},
    volume = {100},
    number = {3},
    pages = {373--390},
    doi = {10.1093/monist/onx016},
    note = {SUMMARY: Argues that Kant's concept of organism, usually seen as a precursor of developmentalism, is incomplete on that view: his regulative notion of purposiveness relies on a design criterion and an epigenesis criterion for natural purposes. Because the design criterion is met within the Modern Synthesis and the epigenesis criterion within Evo-Devo, Kant's notion could frame a synthesis of adaptationism and developmentalism (journal abstract). SUBFIELD AND DEBATE: Teleology and biology: Kant's concept of organism and its relation to contemporary evolutionary and developmental biology. SIGNIFICANCE INDICATORS: S2 citations: 15 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 22. Venue: The Monist 100(3). Not located in the SEP bibliographies retrieved. YEAR NOTE: CrossRef print date 2017-07 (issue 100(3)), online 2017-06-16.},
    keywords = {kant, aes-teleo, tp-science-math, type-article, Low},
    abstract = {Contemporary biology is affected by a controversy between the adaptationist viewpoint, central to the neo-Darwinian Modern Synthesis (MS), and the developmentalist viewpoint, central in Evo-Devo. The possibility of a synthesis between those viewpoints, as granting unity between the laws of form and the laws of function in biology, is therefore currently hotly debated. Kant’s concept of organism is often seen as the philosophical precursor of developmentalism. Yet this view is incomplete, and Kant’s unique regulative notion of purposiveness relies on two criteria in order to capture organisms as natural purposes: a design criterion and an epigenesis criterion. While the former is fulfilled within MS, the latter is satisfied by organisms from the developmentalist viewpoint. Under some conditions, Kant’s notion of organism can thus allow for a synthesis of developmentalism and adaptationism.},
    abstract_source = {openalex},
}

@article{kleingeld2017,
    author = {Kleingeld, Pauline},
    title = {Contradiction and Kant's Formula of Universal Law},
    journal = {Kant-Studien},
    year = {2017},
    volume = {108},
    number = {1},
    doi = {10.1515/kant-2017-0006},
    note = {SUMMARY: Argues that the standard reading of the Formula of Universal Law as requiring universalizability, marked by the distinction between contradictions in conception and in the will, overlooks the simultaneity condition in the formula. It proposes instead that the principle requires being able to will two things simultaneously without self-contradiction, that a maxim be one's own and that it be a universal law (journal abstract). SUBFIELD AND DEBATE: Practical philosophy: the Formula of Universal Law and the contradiction tests; challenges the standard universalizability interpretation. SIGNIFICANCE INDICATORS: S2 citations: 51 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 32. Venue: Kant-Studien 108(1). SEP: listed in the kant-moral bibliography.},
    keywords = {kant, pp-ethics, type-article, Medium},
    abstract = {Abstract Kant’s most prominent formulation of the Categorical Imperative, known as the Formula of Universal Law (FUL), is generally thought to demand that one act only on maxims that one can will as universal laws without this generating a contradiction. Kant’s view is standardly summarized as requiring the ‘universalizability’ of one’s maxims and described in terms of the distinction between ‘contradictions in conception’ and ‘contradictions in the will’. Focusing on the underappreciated significance of the simultaneity condition included in the FUL, I argue, by contrast, that the principle is better read as requiring that one be able to will two things simultaneously without self-contradiction, namely, that a maxim be one’s own and that it be a universal law. This amounts to a new interpretation of the FUL with significant interpretive and philosophical advantages.},
    abstract_source = {s2},
}

@book{denis2017mm,
    author = {Kant, Immanuel},
    editor = {Denis, Lara},
    title = {Kant: The Metaphysics of Morals},
    publisher = {Cambridge University Press},
    year = {2017},
    doi = {10.1017/9781316091388},
    note = {SUMMARY: Revised edition of Mary Gregor's translation of the complete Metaphysics of Morals (Doctrine of Right and Doctrine of Virtue), with new footnotes that address controversial points in the translation, a new introduction by Lara Denis setting the work in context and presenting interpretive debates, and guidance on further reading (publisher abstract). SUBFIELD AND DEBATE: Edition and translation in the Cambridge Texts in the History of Philosophy; Metaphysics of Morals (right, virtue, duties to self and others). SIGNIFICANCE INDICATORS: S2: the DOI-matched record (158 citations) is conflated with the 1996 Cambridge Edition and is not used; CrossRef is-referenced-by-count: 23. Series: Cambridge Texts in the History of Philosophy, Cambridge University Press. NDPR review: none located. YEAR NOTE: Revised edition of the 1996 Cambridge Edition translation by Mary Gregor, of Kant (1797); CrossRef print date 2017-10-04, online 2018-05-28.},
    keywords = {kant, edition-trans, pp-mm-virtue, pp-right-politics, type-translation-edition, Medium},
    abstract = {The Metaphysics of Morals is Kant's final major work in moral philosophy. In it, he presents the basic concepts and principles of right and virtue and the system of duties of human beings as such. The work comprises two parts: the Doctrine of Right concerns outer freedom and the rights of human beings against one another; the Doctrine of Virtue concerns inner freedom and the ethical duties of human beings to themselves and others. Mary Gregor's translation, lightly revised for this edition, is the only complete translation of the entire text, and includes extensive annotation on Kant's difficult and sometimes unfamiliar vocabulary. This edition includes numerous new footnotes, some of which address controversial aspects of Gregor's translation or offer alternatives. Lara Denis's introduction sets the work in context, explains its structure and themes, and introduces important interpretive debates. The volume also provides thorough guidance on further reading including online resources.},
    abstract_source = {openalex},
}

@book{flikschuh2017,
    author = {Flikschuh, Katrin},
    title = {What Is Orientation in Global Thinking? A Kantian Inquiry},
    publisher = {Cambridge University Press},
    year = {2017},
    doi = {10.1017/9780511777264},
    note = {SUMMARY: Takes Kant's question 'What is orientation in thinking?' to argue that global normative theory fails to acknowledge its own conceptual inadequacies, tending to apply domestic political experience to the global context. It proposes a form of global reasoning sensitive to the variability of contexts and to local reasons for action, drawing on the open-ended character of Kant's systematic but non-dogmatic thinking (publisher abstract). SUBFIELD AND DEBATE: Political philosophy: Kant's method and global justice; connects Kant's 1786 essay on orientation to debates on cosmopolitanism and to Flikschuh's earlier work on Kant and colonialism. SIGNIFICANCE INDICATORS: S2 citations: 37 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 32. Publisher: Cambridge University Press. NDPR review: none located. YEAR NOTE: CrossRef print date 2017-10-05, online 2017-10-19.},
    keywords = {kant, pp-right-politics, debate-colonialism, type-monograph, Medium},
    abstract = {Starting from Kant's striking question 'What is orientation in thinking?', this book argues that the main challenge facing global normative theorising lies in its failure to acknowledge its conceptual inadequacies. We do not know how to reason globally; instead, we tend to apply our domestic political experiences to the global context. Katrin Flikschuh argues that we must develop a form of global reasoning that is sensitive to the variability of contexts: rather than trying to identify a uniquely shareable set of substantive principles, we need to appreciate and understand local reasons for action. Her original and incisive study shows how such reasoning can benefit from the open-ended nature of Kant's systematic but non-dogmatic philosophical thinking, and from reorientation from a domestic to a non-domestic frame of thought. It will appeal to all those interested in global moral issues, as well as to Kant scholars.},
    abstract_source = {openalex},
}

@article{valdez2017,
    author = {Valdez, Inés},
    title = {It's Not about Race: Good Wars, Bad Wars, and the Origins of Kant's Anti-Colonialism},
    journal = {American Political Science Review},
    year = {2017},
    volume = {111},
    number = {4},
    pages = {819--834},
    doi = {10.1017/S0003055417000223},
    note = {SUMMARY: Offers a new interpretation of Kant's cosmopolitanism and anti-colonialism in Toward Perpetual Peace. On the historical evidence, Kant's concern is the damage European expansion and colonial rivalry do to the prospects for peace in Europe, which leads him to adjust his concept of antagonism, and the article concludes that his anti-colonialism co-exists with hierarchical views of race (journal abstract). SUBFIELD AND DEBATE: Political philosophy, colonialism and race: the origins of Kant's anti-colonial turn in Perpetual Peace; part of the debate on Kant's cosmopolitanism, colonialism and racial hierarchy. SIGNIFICANCE INDICATORS: S2 citations: 22 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 38. Venue: American Political Science Review 111(4). Not located in the SEP bibliographies retrieved. YEAR NOTE: CrossRef print date 2017-11 (issue 111(4)), online 2017-07-10.},
    keywords = {kant, pp-right-politics, debate-colonialism, debate-race, type-article, Medium},
    abstract = {This article offers a new interpretation of Kant's cosmopolitanism and his anti-colonialism in Toward Perpetual Peace . Kant's changing position has been the subject of extensive debates that have, however, not recognized the central place of colonialism in the political, economic, and military debates in Europe in Kant's writings. Based on historical evidence not previously considered alongside Perpetual Peace , I suggest that Kant's leading concern at the time of writing is the negative effect of European expansionism and intra-European rivalry over colonial possessions on the possibility of peace in Europe. Because of the lack of affinity between colonial conflict and his philosophy of history, Kant must adjust his concept of antagonism to distinguish between war between particular dyads, in particular spaces, and with particular non-state actors. I examine the implications of this argument for Kant's system of Right and conclude that his anti-colonialism co-exists with hierarchical views of race.},
    abstract_source = {openalex},
}

@article{varden2017women,
    author = {Varden, Helga},
    title = {Kant and Women},
    journal = {Pacific Philosophical Quarterly},
    year = {2017},
    volume = {98},
    number = {4},
    pages = {653--694},
    url = {https://doi.org/10.1111/papq.12103},
    note = {SUMMARY: Argues that Kant's conception of women is complex and, on a sympathetic reading, not anti-feminist. Kant expects the traditional male-female distinction to persist but does not propose the traditional gender ideal as the moral ideal and rejects using philosophical anthropology to frame morality, so his moral works hold that all citizens, including women, have the right and should be encouraged to strive toward an active condition (journal abstract). SUBFIELD AND DEBATE: Anthropology and gender: Kant on women, marriage and citizenship; one side of the debate on Kant and gender, defending a largely non-sexist reading. SIGNIFICANCE INDICATORS: S2 citations: 37 (retrieved 2026-09-30; the S2 record carries the venue 'Sex, Love, and Gender'); CrossRef is-referenced-by-count: 25. Venue: Pacific Philosophical Quarterly 98(4). Not located in the SEP bibliographies retrieved. YEAR NOTE: Online-first 2015-10-24; CrossRef print date is volume 98, issue 4 (2017-12), so it is dated 2017.},
    keywords = {kant, anthro-hist-edu, pp-mm-virtue, debate-gender, type-article, Medium},
    abstract = {Abstract Kant's conception of women is complex. Although he struggles to bring his considered view of women into focus, a sympathetic reading shows it not to be anti‐feminist and to contain important arguments regarding human nature. Kant believes the traditional male‐female distinction is unlikely to disappear, but he never proposes the traditional gender idealasthe moral ideal; he rejects the idea that such considerations of philosophical anthropology can set the framework for morality. This is also why his moral works clarifies that all citizens, including women have the right, and should be encouraged to strive towards an active condition.},
    abstract_source = {openalex}
}

