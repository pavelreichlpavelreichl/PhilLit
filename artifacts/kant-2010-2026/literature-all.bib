@book{denis2014ethics,
    editor = {Denis, Lara and Sensen, Oliver},
    title = {Kant's Lectures on Ethics: A Critical Guide},
    publisher = {Cambridge University Press},
    year = {2014},
    url = {https://doi.org/10.1017/cbo9781139567527},
    note = {SUMMARY: Fifteen newly commissioned essays on four sets of student notes of Kant's lectures on ethics (Herder, Collins, Mrongovius and Vigilantius), covering their relation to the Baumgarten textbooks and topics such as obligation, virtue, love, the highest good, freedom, the categorical imperative, moral motivation and religion. The publisher abstract presents it as the first book devoted to these lectures (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: development of Kant's moral thought as seen in the Lectures on Ethics (companion to the Cambridge Edition volume). SIGNIFICANCE INDICATORS: S2 citations: 58 on the S2 record (dated 2015; book-level counts can include chapter stubs; retrieved 2026-09-30); CrossRef: 7. NDPR review: yes (ndpr.nd.edu/reviews/kants-lectures-on-ethics-a-critical-guide/). Other reviews: Kant-Studien (Gerlach, 2017), Dialogue (Dunn, 2018). Series: Cambridge Critical Guides. SEP: not found in the retrieved bibliographies. Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2014-12-31, online 2015-05-05; S2 and most citations give 2015.},
    keywords = {kant, pp-ethics, anthro-hist-edu, type-edited-volume, Medium},
    abstract = {This is the first book devoted to an examination of Kant's lectures on ethics, which provide a unique and revealing perspective on the development of his views. In fifteen newly commissioned essays, leading Kant scholars discuss four sets of student notes reflecting different periods of Kant's career: those taken by Herder (1762–4), Collins (mid-1770s), Mrongovius (1784–5) and Vigilantius (1793–4). The essays cover a diverse range of topics, from the relation between Kant's lectures and the Baumgarten textbooks, to obligation, virtue, love, the highest good, freedom, the categorical imperative, moral motivation and religion. Together they will provide the reader with a deeper and fuller understanding of the evolution of Kant's moral thought. The volume will be of interest to a range of readers in Kant studies, ethics, political philosophy, religious studies and the history of ideas.},
    abstract_source = {openalex},
}

@book{maliks2014politics,
    author = {Maliks, Reidar},
    title = {Kant's Politics in Context},
    publisher = {Oxford University Press},
    year = {2014},
    doi = {10.1093/acprof:oso/9780199645152.001.0001},
    note = {SUMMARY: Reads Kant's political philosophy in the light of public controversies between conservative and radical observers of the French Revolution. It argues that his theory of equal freedom explains both his condemnation of paternalistic government and of radical democracy and his defence of republican constitutionalism, and that Kant developed his philosophy in public discourse with figures such as Fichte, Erhard, Bergk, Rehberg and Gentz (publisher abstract). SUBFIELD AND DEBATE: Political philosophy: Doctrine of Right, republicanism and revolution in the context of 1790s German debates. SIGNIFICANCE INDICATORS: S2 citations: 90 (retrieved 2026-09-30); CrossRef: 61. SEP: listed in the kant-social-political bibliography (dated 2015). Reviews: Kantian Review (Platz, 2015), Ethics (Peterson, 2016), International Philosophical Quarterly (Moland, 2016). NDPR: no review found. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2014-09-11; the SEP bibliography lists 2015.},
    keywords = {kant, pp-right-politics, type-monograph, Medium},
    abstract = {This book analyses Kant’s political philosophy in the light of public controversies between conservative and radical observers of the French Revolution. The author argues that Kant’s theory of equal freedom explains his condemnation of both paternalistic government and radical democracy, and his defense of republican constitutionalism. That Kant idealized the public sphere is well known, but that he intentionally developed his own philosophy in public discourse has not been fully appreciated. Paying attention to these debates in German philosophy during the 1790s, and participants such as Fichte, Erhard, Bergk, Rehberg, and Gentz, can help us to understand Kant’s political philosophy. The first comprehensive account of Kant’s politics in context, this book provides a fresh perspective on both modern political philosophy at a foundational moment and on Kant’s central political concepts, including freedom, rights, citizenship, revolution, and war.},
    abstract_source = {openalex},
}

@book{flikschuh2014colonialism,
    editor = {Flikschuh, Katrin and Ypi, Lea},
    title = {Kant and Colonialism: Historical and Critical Perspectives},
    publisher = {Oxford University Press},
    year = {2014},
    doi = {10.1093/acprof:oso/9780199669622.001.0001},
    note = {SUMMARY: Examines Kant's position on colonialism within his wider cosmopolitan commitments and traces his maturing opposition to European conquest and colonization. The volume offers no single overall position; contributions treat the role of race and trade in his teleological thinking, permissible and impermissible colonial settlement, land rights of non-state peoples, the relation of war to colonial conquest and prospects for Kantian restorative international law (publisher abstract; NDPR). SUBFIELD AND DEBATE: Kant and colonialism: NDPR notes that the introduction and the chapters by Kleingeld and Ypi show Kant's position shifted, earlier remarks on colonial practices and slavery being neutral or tolerant before his later critical remarks. SIGNIFICANCE INDICATORS: S2 citations: 90 (retrieved 2026-09-30); CrossRef: 73. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-colonialism-historical-and-critical-perspectives/). Other reviews: Journal of the History of Philosophy (Williams, 2016), Perspectives on Politics (Maliks, 2016), Netherlands Journal of Legal Philosophy (Tinnevelt, 2016). SEP: listed in the kant-social-political bibliography and cited in its text. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2014-11-20.},
    sep_context = {SEP kant-social-political: "The complexity of Kant’s relation to colonialism is explored in the essays in Flikschuh and Ypi 2014."},
    keywords = {kant, pp-right-politics, debate-colonialism, debate-race, type-edited-volume, High},
    abstract = {Abstract This book examines Kant’s controversial position on colonialism in the context of his wider cosmopolitan commitments. The book explores Kant’s maturing opposition to European conquest and colonization, and the implication of that opposition to his moral and political thinking more generally. The book offers no single overall position on the subject matter but draws instead on the distinctive disciplinary expertise of individual contributors. In consequence, a picture emerges of the considerable complexity of the issue, including Kant’s many-faceted response to it, from the role of race and trade relations in his early and late teleological thinking, his acknowledgement of permissible as against impermissible colonial settlements, his late position on land rights of non-state peoples, and his view of the relation between war and colonial conquest, to prospects for Kantian principles of restorative international law. The opening chapters situate Kant’s unstable general conception of colonialism in historical context; the closing chapter explores the abiding relevance of Kant’s growing anti-colonial stance to current cosmopolitan thinking.},
    abstract_source = {openalex},
}

