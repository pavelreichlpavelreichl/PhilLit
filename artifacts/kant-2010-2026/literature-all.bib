    keywords = {kant, tp-cpr, tp-mind, type-monograph, High, INCOMPLETE, no-abstract, summary-source-publisher-page},
}

@article{gomes2014naive,
    author = {Gomes, Anil},
    title = {Kant on Perception: Naïve Realism, Non-Conceptualism, and the B-Deduction},
    journal = {The Philosophical Quarterly},
    year = {2014},
    volume = {64},
    number = {254},
    pages = {1--19},
    url = {https://doi.org/10.1093/pq/pqt019},
    note = {SUMMARY: Argues that non-conceptualism cannot provide an account of the Transcendental Deduction and so should be rejected, while holding that this has no bearing on whether Kant endorsed a relational account of perceptual experience (abstract). SUBFIELD AND DEBATE: Theory of perception: conceptualism versus nonconceptualism, and relational (naive-realist) readings of Kant's account of perceptual experience; the B-Deduction. SIGNIFICANCE INDICATORS: S2 citations: 72 (retrieved 2026-09-30); CrossRef: 34. Venue: The Philosophical Quarterly. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2014-01-01 (volume 64, issue 254), online 2013-11-05.},
    keywords = {kant, tp-mind, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {According to non-conceptualist interpretations, Kant held that the application of concepts is not necessary for perceptual experience. Some have motivated non-conceptualism by noting the affinities between Kant's account of perception and contemporary relational theories of perception. In this paper, I argue (i) that non-conceptualism cannot provide an account of the Transcendental Deduction and thus ought to be rejected; and (ii) that this has no bearing on the issue of whether Kant endorsed a relational account of perceptual experience.},
    abstract_source = {openalex},
}

@article{stang2014nonidentity,
    author = {Stang, Nicholas F.},
    title = {The Non-Identity of Appearances and Things in Themselves},
    journal = {Noûs},
    year = {2014},
    volume = {48},
    number = {1},
    pages = {106--136},
    url = {https://doi.org/10.1111/nous.12056},
    note = {SUMMARY: Targets the 'Metaphysical One Object' reading of transcendental idealism, on which an appearance is numerically identical to the thing in itself that appears as it, and raises indiscernibility arguments: because an appearance has different spatiotemporal and modal properties than a thing in itself, no appearance can be identical to one. The paper notes the parallel with arguments against monism about material objects and the matter constituting them (abstract). SUBFIELD AND DEBATE: Transcendental idealism: one-object (two-aspect) versus two-object readings of the appearance/thing-in-itself distinction. SIGNIFICANCE INDICATORS: S2 citations: 26 (retrieved 2026-09-30); CrossRef: 15. Venue: Noûs. SEP: listed in the kant-transcendental-idealism bibliography. YEAR NOTE: CrossRef print date 2014-03 (volume 48, issue 1), online 2013-12-10.},
    keywords = {kant, tp-cpr, debate-two-aspect, type-article, Medium},
    abstract = {Abstract According to the ‘One Object’ reading of Kant's transcendental idealism, the distinction between the appearance and the thing in itself is not a distinction between two objects, but between two ways of considering one and the same object. On the ‘Metaphysical’ version of the One Object reading, it is a distinction between two kinds of properties possessed by one and the same object. Consequently, the Metaphysical One Object view holds that a given appearance, an empirical object, is numerically identical to the thing in itself that appears as that object. I raise various indiscernibility arguments against that view; because an appearance has different spatiotemporal and modal properties than a thing in itself, no appearance can be identical to a thing in itself. I point out that these arguments are similar to arguments against Monism, the view that material objects are numerically identical to the matter of which they are made. I outline some strategies Monists have developed to respond to these indiscernibility arguments and then develop parallel responses on behalf of the Metaphysical One Object view. However, I then raise another indiscernibility argument, to which, I argue, the Metaphysical One Object view cannot respond, even using the resources I have developed thus far. I develop a modified version of the Metaphysical One Object view that can respond to this new indiscernibility argument, but, I argue, this modified version of the One Object view is only a terminological variant of the Two Object view. When the Metaphysical One Object view is fully thought through it becomes the Two Object view. I conclude that Kantian appearances are not numerically identical to the things in themselves that appear to us.},
    abstract_source = {openalex},
}

@book{wuerth2014mind,
    author = {Wuerth, Julian},
    title = {Kant on Mind, Action, and Ethics},
    publisher = {Oxford University Press},
    year = {2014},
    doi = {10.1093/acprof:oso/9780199587629.001.0001},
    note = {SUMMARY: Offers a new interpretation of major themes in Kant's philosophy: the ontology of the mind, transcendental idealism, the account of the mind's powers and the theory of action, and from these develops a moral realist account of Kant's ethics (publisher abstract). NDPR adds that the book offers a new account of the soul as substance that rejects extant accounts by Kitcher, Ameriks and Allison, and rejects constructivism in favour of moral realism. SUBFIELD AND DEBATE: Practical philosophy and philosophy of mind: Kant's theory of action; moral realism against constructivist readings of Kant's ethics. SIGNIFICANCE INDICATORS: Award: North American Kant Society Book Prize 2015 (NAKS prize-winners page, retrieved 2026-09-30). S2 citations: 87 (retrieved 2026-09-30); CrossRef: 43. NDPR review: yes (ndpr.nd.edu/reviews/kant-on-mind-action-and-ethics/). Other reviews: Journal of the History of Philosophy (Sorensen, 2016), The Philosophical Review (Brook, 2016), Kantian Review (2015), British Journal for the History of Philosophy (Saunders, 2016). SEP: listed in the kant-hume-morality, kant-mind and kant-moral bibliographies. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2014-08-28.},
    keywords = {kant, pp-ethics, tp-mind, debate-constructivism, type-monograph, High},
    abstract = {Julian Wuerth offers a radically new interpretation of major themes in Kant's philosophy. He explores Kant's ontology of the mind, his transcendental idealism, his account of the mind's powers, and his theory of action, and goes on to develop an original, moral realist account of Kant's ethics.},
    abstract_source = {openalex},
}

