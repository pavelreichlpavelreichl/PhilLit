    note = {SUMMARY: Short commentary on the Groundwork aiming at an accurate reading. NDPR describes it as a slightly revised translation of the authors' German commentary published in 2001, in which Wood's views on the Categorical Imperative shape the treatment of Groundwork II and Schönecker's account of the structure of the deduction shapes Groundwork III (NDPR). SUBFIELD AND DEBATE: Practical philosophy: Groundwork commentary (the formulas of the categorical imperative and the deduction in Groundwork III). SIGNIFICANCE INDICATORS: S2 citations: 9 on the title-matched record (retrieved 2026-09-30); CrossRef: 12. NDPR review: yes (ndpr.nd.edu/reviews/immanuel-kant-s-groundwork-for-the-metaphysics-of-morals-a-commentary/). SEP: listed in the kant-moral bibliography. Publisher: Harvard University Press. YEAR NOTE: Translation of the German commentary (NDPR: published in German in 2001), dated by the translation; CrossRef print date 2015-01-31.},
    keywords = {kant, pp-ethics, type-monograph, Medium},
    abstract = {A defining work of moral philosophy, Groundwork for the Metaphysics of Morals has been highly influential and famously difficult. Dieter Schönecker and Allen Wood make clear the ways this work forms the basis of our modern moral outlook and how moral law relates to freedom and free will within Kant’s overall philosophy.},
    abstract_source = {openalex},
}

@book{oneill2015authorities,
    author = {O'Neill, Onora},
    title = {Constructing Authorities: Reason, Politics and Interpretation in Kant's Philosophy},
    publisher = {Cambridge University Press},
    year = {2015},
    doi = {10.1017/cbo9781316337141},
    note = {SUMMARY: Collects essays developed over many years on Kant's philosophy, arguing against the claim that Kant's critique of reason collapses into an argument from authority: Kant held that we must construct, not assume, the authority of reason, by ensuring that what we offer as reasons can be followed by others. She presents this constructivist view of reasoning as the clue to Kant's claims about knowledge, ethics and politics, including autonomy, the social contract, cosmopolitan justice and scriptural interpretation (publisher abstract). SUBFIELD AND DEBATE: Kant's critique of reason, practical and political philosophy: a constructivist reading of the authority of reason. SIGNIFICANCE INDICATORS: S2 citations: 29 (retrieved 2026-09-30); CrossRef: 40. SEP: listed in the kant-reason bibliography. Reviews: Kant-Studien (Rosales, 2018), Journal of Moral Philosophy (Frierson, 2019). NDPR: no review found. Publisher: Cambridge University Press. YEAR NOTE: Collection dated by the collection year; the SEP bibliography dates chapters 1 and 2 as originally published in 1992 and 2004. CrossRef print date 2015-11-30, online 2015-12-18.},
    keywords = {kant, pp-ethics, pp-right-politics, debate-constructivism, type-monograph, Medium},
    abstract = {This collection of essays brings together the central lines of thought in Onora O'Neill's work on Kant's philosophy, developed over many years. Challenging the claim that Kant's attempt to provide a critique of reason fails because it collapses into a dogmatic argument from authority, O'Neill shows why Kant held that we must construct, rather than assume, the authority of reason, and how this can be done by ensuring that anything we offer as reasons can be followed by others, including others with whom we disagree. She argues that this constructivist view of reasoning is the clue to Kant's claims about knowledge, ethics and politics, as well as to his distinctive accounts of autonomy, the social contract, cosmopolitan justice and scriptural interpretation. Her essays are a distinctive and illuminating commentary on Kant's fundamental philosophical strategy and its implications, and will be a vital resource for scholars of Kant, ethics and philosophy of law.},
    abstract_source = {openalex},
}

@book{reath2015practical,
    author = {Kant, Immanuel},
    editor = {Reath, Andrews and Gregor, Mary},
    title = {Critique of Practical Reason},
    publisher = {Cambridge University Press},
    year = {2015},
    url = {https://doi.org/10.1017/cbo9781316136478},
    note = {SUMMARY: Revised edition of the Cambridge Texts translation of the second Critique, containing Mary Gregor's translation, with Andrews Reath's introduction placing the main themes of the Critique in the context of Kant's moral theory and critical system; the introduction has been revised and the guide to secondary reading completely updated (publisher abstract). SUBFIELD AND DEBATE: Edition and translation: Critique of Practical Reason (1788), Cambridge Texts in the History of Philosophy (series name as given in the Dialogue review title returned by S2). SIGNIFICANCE INDICATORS: S2 citations: 16 (retrieved 2026-09-30); CrossRef: 5. Review: Dialogue (Feuerhahn, 2015; title as returned by S2). SEP: only the 2010 Critical Guide is found in the retrieved bibliographies, not this edition. NDPR: the slug critique-of-practical-reason reviews a different edition (Pluhar's translation) and is not used. Publisher: Cambridge University Press. YEAR NOTE: Edition and translation of Kant (1788); revised edition of an earlier Cambridge Texts edition (per the publisher abstract); CrossRef print date 2015-01-26, online 2015-02-05.},
    keywords = {kant, edition-trans, pp-ethics, type-translation-edition, Medium},
    abstract = {The Critique of Practical Reason is the second of Kant's three Critiques, one of his three major treatises on moral theory, and a seminal text in the history of moral philosophy. Originally published three years after his Groundwork of the Metaphysics of Morals, the Critique provides further elaboration of the basic themes of Kant's moral theory, gives the most complete statement of his highly original theory of freedom of the will, and develops his practical metaphysics. This revised edition of Kant's Critique of Practical Reason – which contains Mary Gregor's acclaimed translation – is now the authoritative translation of this work. A substantial and lucid introduction by Andrews Reath places the mains themes of the Critique in the context of Kant's moral theory and his critical system. For this edition, the introduction has been revised and the guide to the secondary reading completely updated.},
    abstract_source = {openalex},
}

@book{friedlander2015expressions,
    author = {Friedlander, Eli},
    title = {Expressions of Judgment: An Essay on Kant's Aesthetics},
    publisher = {Harvard University Press},
    year = {2015},
    doi = {10.4159/harvard.9780674735699},
    note = {SUMMARY: Reappraisal of the Critique of Judgment that emphasizes the internal connection of judgment and meaning and shows how the pleasure in judging is related to our capacity to draw meaning from our encounter with beauty (publisher abstract). The NDPR review describes the essay as speculative in vein and is critical of its lack of reconstruction of Kant's lines of argument (NDPR). SUBFIELD AND DEBATE: Aesthetics: judgment and meaning in the Critique of Judgment; interpretive essay rather than a commentary. SIGNIFICANCE INDICATORS: S2 citations: 5 (retrieved 2026-09-30); CrossRef: 5. NDPR review: yes (ndpr.nd.edu/reviews/expressions-of-judgment-an-essay-on-kant-s-aesthetics/). Other reviews: Critical Inquiry (Lehman, 2015), Journal of Aesthetics and Art Criticism (Packer, 2015). SEP: listed in the kant-aesthetics bibliography. Publisher: Harvard University Press. YEAR NOTE: CrossRef print and online date 2015-12-31.},
    keywords = {kant, aes-teleo, type-monograph, Medium},
    abstract = {Kant’s The Critique of Judgment laid the groundwork of modern aesthetics when it appeared in 1790. Eli Friedlander’s reappraisal emphasizes the internal connection of judgment and meaning, showing how the pleasure in judging is intimately related to our capacity to draw meaning from our encounter with beauty.},
    abstract_source = {openalex},
}

