  year = {2026},
  doi = {10.1017/9781009647175},
  note = {SUMMARY: Collects ten essays published since Kant and the Claims of Knowledge (1987) on Kant's critical metaphysics and epistemology. They address the meaning of transcendental idealism while criticising Kant's fundamental argument for it, the value of the transcendental method, Kant's teleological approach to philosophy, his relation to Locke and Leibniz, and the difference between his method and Peter Strawson's (publisher abstract).

