}

@article{teufel2012judgement,
    author = "Teufel, Thomas",
    title = "What Does Kant Mean by 'Power of Judgement' in his Critique of the Power of Judgement?",
    journal = "Kantian Review",
    year = "2012",
    volume = "17",
    number = "2",
    pages = "297--326",
    doi = "10.1017/s1369415412000076",
    note = "SUMMARY: Argues that the 'power of judgement' in the title of the third Critique refers only to the reflecting power of judgement, because Kant attempts a Critical justification of that power alone and a transcendentally grounded determining power is systematically impossible, and that Kant's discussion in sections 76-77 addresses the problem of synthesizing unsynthesized intuitions, so that the systematic ambitions of the third Critique are appropriate (abstract). SUBFIELD AND DEBATE: Aesthetics and teleology: the unity and systematic role of the Critique of the Power of Judgment, the reflecting power of judgement and its relation to the first Critique. SIGNIFICANCE INDICATORS: S2 citations: 139 (retrieved 2026-09-30; the S2 and CrossRef counts differ widely); CrossRef: 7. Venue: Kantian Review. SEP: not found in the retrieved kant-aesthetics bibliography. YEAR NOTE: CrossRef gives online date 2012-06-08 (volume 17, issue 2, 2012) and no print date.",
    keywords = "kant, aes-teleo, tp-cpr, type-article, Low",
    abstract = "Abstract The notion of ‘power of judgement’ in the title of Kant'sCritique of the Power of Judgementis commonly taken to refer to a cognitive power inclusive of both determining judgement and reflecting judgement. I argue, first, that this seemingly innocuous view is in conflict both with the textual fact that Kant attempts a Critical justification of the reflecting power of judgement – only – and with the systematic impossibility of a transcendentally grounded determining power of judgement. The conventional response to these difficulties is to point out that, Kant's systematic ambitions in the thirdCritiquenotwithstanding, reflection, qua concept-forming synthesis, is too closely tied to determination to be a cognitive power in its own right. I argue, second, that this response is question-begging, since the notion of reflection it employs is not only not one central to the thirdCritiquebut one antecedently tied to the understanding. I argue, third, that Kant's discussion, in the pivotal § § 76–7, of our cognitive relation to sensible particularity addresses an epistemic problem present (but not raised) in theCritique of Pure Reason. This is the problem of the synthesizability, qua absolute unity, of unsynthesized intuitions. Solving this problem requires Critical justification of a principle of reflection. It follows that Kant's systematic ambitions in the thirdCritiqueare appropriate. Given the problem Kant seeks to address, he must offer what he takes himself to be offering: aCritique of the(Reflecting)Power of Judgement.",
    abstract_source = "openalex"
}

@book{kant2012natural,
    author = "Kant, Immanuel",
    editor = "Watkins, Eric",
    title = "Natural Science",
    publisher = "Cambridge University Press",
    year = "2012",
    series = "The Cambridge Edition of the Works of Immanuel Kant",
    doi = "10.1017/cbo9781139014380",
    note = "SUMMARY: New English translations of Kant's early natural-science writings, including his first publication, Thoughts on the True Estimation of Living Forces, the Universal Natural History and Theory of the Heavens (1755) and the whole of Physical Geography, with editorial introductions, explanatory notes and a glossary; NDPR notes that some texts appear in English for the first time (publisher abstract; NDPR). SUBFIELD AND DEBATE: Edition and translation: Kant's pre-critical natural philosophy, physical geography and cosmology (Cambridge Edition volume, editor Eric Watkins). SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 44 (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/natural-science/). SEP: listed as a Cambridge Edition volume in the kant and kant-development bibliographies. Publisher: Cambridge University Press. YEAR NOTE: Translation of texts of 1746 to 1802; CrossRef print date 2012-10, online 2012-11.",
    keywords = "kant, edition-trans, precritical, tp-science-math, type-translation-edition, High",
    abstract = "Though Kant is best known for his strictly philosophical works in the 1780s, many of his early publications in particular were devoted to what we would call 'natural science'. Kant's Universal Natural History and Theory of the Heavens (1755) made a significant advance in cosmology, and he was also instrumental in establishing the newly emerging discipline of physical geography, lecturing on it for almost his entire career. In this volume Eric Watkins brings together new English translations of Kant's first publication, Thoughts on the True Estimation of Living Forces (1746–1749), the entirety of Physical Geography (1802), a series of shorter essays, along with many of Kant's most important publications in natural science. The volume is rich in material for the student and the scholar, with extensive linguistic and explanatory notes, editorial introductions and a glossary of key terms.",
    abstract_source = "openalex"
}

@book{kant2012anthropology,
    author = "Kant, Immanuel",
    editor = "Louden, Robert B. and Wood, Allen W.",
    title = "Lectures on Anthropology",
    publisher = "Cambridge University Press",
    year = "2012",
    doi = "10.1017/cbo9781139028639",
    note = "SUMMARY: First translation of selections from student transcriptions of Kant's anthropology lectures of 1772-1789, made before the published Anthropology from a Pragmatic Point of View (1798), presenting Anthropology Friedländer (1772) and Anthropology Mrongovius (1786) in full together with selections from the other transcriptions and parts of the Menschenkunde, and showing Kant's empirical theory of human nature (publisher abstract; NDPR). SUBFIELD AND DEBATE: Edition and translation; anthropology and human nature: source texts for Kant's empirical theory of human nature, its bearing on moral psychology and history,. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 108 (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/lectures-on-anthropology/). SEP: not found in the retrieved bibliographies. Publisher: Cambridge University Press. YEAR NOTE: Translation of student transcriptions of lectures of 1772-1789; CrossRef print date 2012-12-20, online 2013-04.",
    keywords = "kant, edition-trans, anthro-hist-edu, type-translation-edition, High",
    abstract = "Kant was one of the inventors of anthropology, and his lectures on anthropology were the most popular and among the most frequently given of his lecture courses. This volume contains the first translation of selections from student transcriptions of the lectures between 1772 and 1789, prior to the published version, Anthropology from a Pragmatic Point of View (1798), which Kant edited himself at the end of his teaching career. The two most extensive texts, Anthropology Friedländer (1772) and Anthropology Mrongovius (1786), are presented here in their entirety, along with selections from all the other lecture transcriptions published in the Academy edition, together with sizeable portions of the Menschenkunde (1781–2), first published in 1831. These lectures show that Kant had a coherent and well-developed empirical theory of human nature bearing on many other aspects of his philosophy, including cognition, moral psychology, politics and philosophy of history.",
    abstract_source = "openalex"
}

@book{forster2012twentyfive,
    author = "Förster, Eckart",
    title = "The Twenty-Five Years of Philosophy: A Systematic Reconstruction",
    publisher = "Harvard University Press",
    year = "2012",
    doi = "10.4159/harvard.9780674064980",
    note = "SUMMARY: Follows the Kantian idea that philosophy can be scientific and complete from the Critique of Pure Reason (1781) to Hegel (1806), and argues that Kant's three Critiques yield a distinction between intellectual intuition and intuitive understanding, which explains two post-Kantian lines of development (Fichte's Wissenschaftslehre, and Goethe's transformation of intuitive understanding in light of Spinoza) that are joined in Hegel (publisher abstract; NDPR). SUBFIELD AND DEBATE: Reception: Kant, Fichte, Schelling, Goethe and Hegel; the development of German idealism from the critical philosophy. SIGNIFICANCE INDICATORS: S2 citations: 66 (retrieved 2026-09-30); CrossRef: 117. NDPR review: yes (ndpr.nd.edu/reviews/the-twenty-five-years-of-philosophy-a-systematic-reconstruction/). SEP: listed in the kant-transcendental-idealism bibliography (translated by B. Bowman). Publisher: Harvard University Press. YEAR NOTE: CrossRef print and online date 2012-04.",
    keywords = "kant, recep-idealism, tp-cpr, type-monograph, High",
    abstract = "Kant declared that philosophy began in 1781 with his Critique of Pure Reason. In 1806 Hegel announced that philosophy had now been completed. Eckart Förster examines the reasons behind these claims and assesses the steps that led in such a short time from Kant’s “beginning” to Hegel’s “end.” He concludes that, in an unexpected yet significant sense, both Kant and Hegel were indeed right. The Twenty-Five Years of Philosophy follows the unfolding of a key idea during this exceptionally productive period: the Kantian idea that philosophy can be scientific and, consequently, can be completed. Förster’s study combines historical research with philosophical insight and leads him to propose a new thesis. The development of Kant’s transcendental philosophy in his three Critiques, Förster claims, resulted in a fundamental distinction between “intellectual intuition” and “intuitive understanding.” Overlooked until now, this distinction yields two takes on how to pursue philosophy as science after Kant. One line of thought culminates in Fichte’s theory of freedom (Wissenschaftslehre), while the other—and here Förster brings Goethe’s significance to the fore—results in Goethe's transformation of the Kantian idea of an intuitive understanding in light of Spinoza's third kind of knowledge. Both strands are brought together in Hegel and propel his split from Schelling. Förster’s work makes an original contribution to our understanding of the classical era of German philosophy—an expanding interest within the Anglophone philosophical community.",
    abstract_source = "openalex"
}

@book{sedgwick2012hegel,
    author = "Sedgwick, Sally",
    title = "Hegel's Critique of Kant: From Dichotomy to Identity",
    publisher = "Oxford University Press",
    year = "2012",
    doi = "10.1093/acprof:oso/9780199698363.001.0001",
    note = "SUMMARY: Presents Hegel's critique of Kant's theoretical philosophy, arguing that Hegel offers a critique of and alternative to the conception of cognition Kant defended in the critical period, and exploring Hegel's claim to derive from Kantian doctrines the clues to a superior form of idealism (publisher abstract; NDPR). SUBFIELD AND DEBATE: Reception: Hegel's critique of Kant's theory of cognition (the dichotomies of the critical philosophy) and the transition to Hegelian idealism. SIGNIFICANCE INDICATORS: S2 citations: 39 on the title-matched record (retrieved 2026-09-30); CrossRef: 42. NDPR review: yes (ndpr.nd.edu/reviews/hegel-s-critique-of-kant-from-dichotomy-to-identity/). SEP: not found in the retrieved bibliographies. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2012-03.",
    keywords = "kant, recep-idealism, tp-cpr, type-monograph, Medium",
    abstract = "Sally Sedgwick presents an account of Hegel's critique of Kant's theoretical philosophy. She argues that Hegel offers a critique of and alternative to the conception of cognition that Kant defended in his 'critical' period, and explores Hegel's claim to derive from Kantian doctrines clues to a superior form of idealism.",
    abstract_source = "openalex"
}

@article{gray2012race,
    author = "Gray, Sally Hatch",
    title = "Kant's Race Theory, Forster's Counter, and the Metaphysics of Color",
    journal = "The Eighteenth Century",
    year = "2012",
    volume = "53",
    number = "4",
    pages = "393--412",
    doi = "10.1353/ecy.2012.0032",
    note = "SUMMARY: Argues that Kant's race theory is an integral part of his idea of nature in the Critique of the Power of Judgment, examining the 1785-86 debate between Kant and Georg Forster over race and showing that Kant developed his teleological conception of nature partly to give his race theory a unifying basis that could withstand Forster's empiricism; concludes that the nature of the third Critique supports a universal cosmopolitanism but veils a particular European perspective that allows a damaging global authority on difference (abstract). SUBFIELD AND DEBATE: Race and anthropology: Kant's race theory in relation to the third Critique and Forster's critique. One of few 2010-2012 items in the Kant-and-race discussion located in the searches. SIGNIFICANCE INDICATORS: S2 citations: 19 (retrieved 2026-09-30); CrossRef: 15. Venue: The Eighteenth Century. No review or encyclopedia evidence found. Included mainly to represent the Kant-and-race discussion in the year.",
    keywords = "kant, anthro-hist-edu, aes-teleo, debate-race, type-article, Low",
    abstract = {This article argues for an understanding of Kant's race theory as an integral part of his idea of nature and of humans in nature as presented in his Critique of the Power of Judgment (Kritik der Urteilskraft, 1790). It places an examination of Kant and Forster's debate over race, which was ignited in 1785 upon the publication of Kant's second essay on race, "Definition of a Concept of a Human Race" ("Bestimmung des Begriffs einer Menschenrace"), in the context of an illumination of the connections between aesthetics and anthropology in Kant's Observations on the Feeling of the Beautiful and Sublime (Beobachtungen über das Gefühl des Schönen und Erhabenen, 1764) and Forster's Voyage round the World (Reise um die Welt 1777). Forster responded to Kant's new "race" classifications, which were based essentially on skin color, with "Still More about the Human Races" ("Noch etwas über Menschenraßen," 1786). This article shows that Kant then developed his scientific theory and his idea of a teleological nature as presented in his Critique of the Power of Judgment, at least in part, in order to provide a unifying theoretical basis for his race theory so that it could withstand the scrutiny of an empirical scientific method based on deductive logic, such as that advanced by Forster. While Forster's strict empiricism, perspectivism, and rejection of "race" as a scientific classification reflect an underlying, distinctly modern, concept of the natural world, Kant's nature, as presented in his third Critique, reveals a metaphysically-based structure supporting a universal cosmopolitanism, but veils a particular European perspective that allows a damaging global authority on difference.},
    abstract_source = "openalex"
}
