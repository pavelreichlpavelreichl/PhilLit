    abstract_source = "openalex"
}

@book{sensen2012autonomy,
    editor = "Sensen, Oliver",
    title = "Kant on Moral Autonomy",
    publisher = "Cambridge University Press",
    year = "2012",
    url = "https://doi.org/10.1017/cbo9780511792489",
    note = "SUMMARY: Essays on Kant's conception of autonomy, its history, its influence on contemporary conceptions and its moral significance, with an introduction by the editor and a postscript by Onora O'Neill; the NDPR review counts fourteen essays offered in honour of O'Neill (publisher abstract; NDPR). SUBFIELD AND DEBATE: Practical philosophy: autonomy and its relation to contemporary notions of autonomy. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count: 15 (book-level); S2 holds chapter-level records only (retrieved 2026-09-30). NDPR review: yes (ndpr.nd.edu/reviews/kant-on-moral-autonomy/). Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2012-12-13; online 2013-02.",
    keywords = "kant, pp-ethics, debate-other-autonomy, type-edited-volume, Medium",
    abstract = "The concept of autonomy is one of Kant's central legacies for contemporary moral thought. We often invoke autonomy as both a moral ideal and a human right, especially a right to determine oneself independently of foreign determinants; indeed, to violate a person's autonomy is considered to be a serious moral offence. Yet while contemporary philosophy claims Kant as the originator of its notion of autonomy, Kant's own conception of the term seems to differ in important respects from our present-day interpretation. Kant on Moral Autonomy brings together a distinguished group of scholars who explore the following questions: what is Kant's conception of autonomy? What is its history and its influence on contemporary conceptions? And what is its moral significance? Their essays will be of interest both to scholars and students working on Kantian moral philosophy and to anyone interested in the subject of autonomy.",
    abstract_source = "openalex"
}

