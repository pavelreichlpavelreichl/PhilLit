@book{mensch2013organicism,
    author = {Mensch, Jennifer},
    title = {Kant's Organicism: Epigenesis and the Development of Critical Philosophy},
    publisher = {University of Chicago Press},
    year = {2013},
    doi = {10.7208/chicago/9780226022031.001.0001},
    note = {SUMMARY: Argues that the concept of epigenesis, a theory of biological formation, was not merely a metaphor for Kant but guided his critical philosophy, especially the relationship between reason and the categories of the understanding. Combining a study of Kant's theory of cognition with intellectual history and biography, it places the epigenesis of reason within eighteenth-century theories of generation, genealogy and classification (University of Chicago Press description returned by web search). SUBFIELD AND DEBATE: Kant and the life sciences: epigenesis, natural history and the development of the critical philosophy (Critique of Pure Reason). SIGNIFICANCE INDICATORS: S2 citations: 15 on the DOI-matched record (retrieved 2026-09-30); CrossRef: 73. Reviews: Kantian Review (Zammito, 2014), Isis (Steigerwald, 2014), German Studies Review (2015), Graduate Faculty Philosophy Journal (Berk, 2013), Goethe Yearbook (Effinger, 2016); S2 also lists a review in Critical Philosophy of Race. NDPR: no review found. SEP: not found in the retrieved bibliographies. Publisher: University of Chicago Press. YEAR NOTE: CrossRef gives 2013 (print).},
    keywords = {kant, aes-teleo, tp-cpr, type-monograph, Medium, INCOMPLETE, no-abstract, summary-source-publisher-web}
}

@article{matherne2013aesthetic,
    author = {Matherne, Samantha},
    title = {The Inclusive Interpretation of Kant's Aesthetic Ideas},
    journal = {The British Journal of Aesthetics},
    year = {2013},
    volume = {53},
    number = {1},
    pages = {21--39},
    url = {https://doi.org/10.1093/aesthj/ays058},
    note = {SUMMARY: Offers an 'inclusive interpretation' of the aesthetic ideas of the Critique of the Power of Judgment, on which they can present not only moral and purely rational concepts (as restrictive readings hold) but also empirical concepts and emotions related to ordinary experience. The article argues that this neglected class matters for Kant's views of artistic production, of the experience of art and of the value of art for ordinary experience (abstract). SUBFIELD AND DEBATE: Aesthetics: Kant's theory of artistic expression; responds to restrictive interpretations of aesthetic ideas. Carry-forward from Domain 1 (BJA 53(1)). SIGNIFICANCE INDICATORS: S2 citations: 52 (retrieved 2026-09-30); CrossRef: 35. Venue: British Journal of Aesthetics. SEP: listed in the kant-aesthetics bibliography. YEAR NOTE: CrossRef print date 2013-01-01 (volume 53, issue 1); online-first 2012-11-25.},
    keywords = {kant, aes-teleo, type-article, Medium},
    abstract = {In the Critique of the Power of Judgment, Kant offers a theory of artistic expression in which he claims that a work of art is a medium through which an artist expresses an ‘aesthetic idea’. While Kant’s theory of aesthetic ideas often receives rather restrictive interpretations, according to which aesthetic ideas can either present only moral concepts, or only moral concepts and purely rational concepts, in this article I offer an ‘inclusive interpretation’ of aesthetic ideas, according to which they can present not only moral and purely rational concepts but also empirical concepts and emotions related to our ordinary experience. Although this latter class of experience-oriented aesthetic ideas has been neglected, I argue that recognizing the role it plays in Kant’s account is crucial for understanding his views not only of artistic production and our experience of art but also of the value he takes art to have for our ordinary experience of the world, others, and our own selves. What is more, insofar as the inclusive interpretation brings to light Kant’s acknowledgement of the close connection between experience and art, it reveals that his overall view of art is more plausible than is often thought, and recommends it as worthy of further consideration.},
    abstract_source = {openalex},
}

@book{insole2013creation,
    author = {Insole, Christopher J.},
    title = {Kant and the Creation of Freedom: A Theological Problem},
    publisher = {Oxford University Press},
    year = {2013},
    doi = {10.1093/acprof:oso/9780199677603.001.0001},
    note = {SUMMARY: Argues that Kant struggled with how to conceive God's creative action in relation to human freedom and concluded that freedom can be protected only if God withdraws in certain ways from the created world. His rejection of the medieval and early modern account of divine concursus is said to shape transcendental idealism and his theory of freedom and to explain otherwise incomprehensible claims of the critical philosophy (publisher abstract). SUBFIELD AND DEBATE: Religion and metaphysics: Kant's philosophical theology (creation, divine action) and its role in transcendental idealism and freedom. SIGNIFICANCE INDICATORS: S2 citations: 31 (retrieved 2026-09-30); CrossRef: 32. SEP: listed in the kant-religion bibliography. Reviews: Journal of the History of Philosophy (2014), Journal of Theological Studies (Lee, 2014), Theology (Pasternack, 2015), Studies in Christian Ethics (Adams, 2015); the author's reply to Terry Godlove appeared in International Journal for Philosophy of Religion (2014). NDPR: no review found. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2013-05-30, online 2013-09.},
    keywords = {kant, religion, tp-cpr, type-monograph, Medium},
    abstract = {Abstract Kant actively struggles with the problem of how to conceive of God’s creative action in relation to human freedom. Kant comes to the view that human freedom can only be protected if God withdraws in certain ways from the created world. The two pillars of Kant’s mature philosophy—transcendental idealism and freedom—are in part shaped and motivated by Kant’s need to provide a solution to his theological problem. The medieval and early modern theological tradition conceives of divine action as unlike the action of any created being. When the creature acts, God directly causes this action, but without reducing the creature’s freedom. Kant explicitly discusses and rejects this account of divine and human concursus. This rejection has significant and surprising ramifications for Kant’s wider philosophy, explaining otherwise incomprehensible claims in his critical philosophy. The book presents a definitive study in the history of ideas, engaging with a wide range of Kant’s texts from 1749 until the early 1800s. Kant’s thought is placed in relation to numerous historical and traditional positions, which are themselves illuminated by a close engagement with recent debates in analytical philosophy and systematic theology. Kant is unrelentingly honest when grappling with the difficulty of relating divine and human freedom. This study, of Kant’s theological struggle and legacy, goes to the heart of the problem in the modern reception of what the Christian tradition has affirmed about human freedom. As such, the book throws light on one of the defining fault-lines in modern theology and philosophy.},
    abstract_source = {openalex},
}

@book{mikkelsen2013race,
    editor = {Mikkelsen, Jon},
    title = {Kant and the Concept of Race: Late Eighteenth-Century Writings},
    publisher = {State University of New York Press},
    year = {2013},
    doi = {10.1353/book26503},
    note = {SUMMARY: Translation of Kant's essays on race, including the first essay in its two versions of 1775 and 1777, presented in chronological order with previously untranslated texts by four German contemporaries of Kant (NDPR). SUBFIELD AND DEBATE: Anthropology and race: source texts for Kant's race theory and for the philosophy-of-biology context in which it arose; Kant and race. SIGNIFICANCE INDICATORS: S2 citations: 43 (retrieved 2026-09-30); CrossRef: 53. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-the-concept-of-race-late-eighteenth-century-writings/). SEP: not found in the retrieved bibliographies. Publisher: State University of New York Press. YEAR NOTE: Translation and edition of Kant's race writings, beginning with the first race essay (1775; second version 1777, per NDPR); CrossRef gives 2013.},
    keywords = {kant, anthro-hist-edu, debate-race, edition-trans, type-translation-edition, Medium},
    abstract = {This is a very important contribution for those who cannot read German and who wish to gain a purchase on the role of Kant in the highly contested domain of race theory and the less politicized but also contested domain of philosophy of biology. Not only does it provide key texts from Kant on the question of race, but it also supplements these with texts, previously not available in English, from four important German contemporaries of Kant. Jon Mikkelsen presents these texts in chronological order: Kant's first essay on race, in its two distinct versions of 1775 and 1777 (an unprecedented and very welcome contribution for those who are interested in close historical reading of Kant's development on these questions); E. A. W. Zimmermann's criticisms of Kant in the context of his own biogeographical study of the human population,Geographical History of Human Beings and the Universally Dispersed Quadrupeds(1778); Kant's "Determination of the Concept of a Human Race" (1785); Georg Forster's critical commentary on that essay, "Something More about the Human Races" (1786); Kant's rejoinder, "On the Use of Teleological Principles in Philosophy" (1788), of fundamental importance for the development of his thirdCritique; Christoph Meiners' "Of the Varieties and Deviate Forms of Negroes" (1790), an exemplary text from perhaps the most racist theorist of late eighteenth-century Germany; and, finally, an excerpt from Christoph Girtanner'sConcerning the Kantian Principle in Natural History(1796), the most thorough endeavor to apply Kant's approach to the emergent field of life science, associated with the work of Johann Friedrich Blumenbach in Göttingen. Mikkelsen's volume is supplemented with an extensive Chronology of developments in race theory, the slave trade, and the life sciences from 1619 to 1859.
    abstract_source = {ndpr},

The critical issue concerning this volume is its relation to the increasingly standard English translations of Kant's texts, theCambridge Edition of the Works of Immanuel Kant, in this case, the volumeAnthropology, History, and Education, edited by Günter Zöller and Robert Louden (Cambridge University Press, 2007). Both editions contain careful translations of Kant's texts on race. Each set of translations has its strengths and weaknesses. For general readability, perhaps the Cambridge Edition is superior, but Mikkelsen tends to retain more of the eighteenth-century flavor of Kant's language, as attested by the works from contemporaries. Each translation indulges in some terminological anachronism. The Cambridge Edition chooses to usephylumfor the GermanStamm. That sounds too much like a present taxonomical category for Kant's deliberately ordinary (eighteenth-century) language. But Mikkelsen translates asplateswhat the Cambridge Edition more sensibly renders asplateaus. Plates, once again, evokes too contemporary a geological framework. But the case for Mikkelsen's volume does not lie in translation quality but in conceptual orientation.

Both volumes reflect the very late attentiveness of Anglophone scholarship to Kant's texts on race and their relation to his overall corpus and concerns. More, this belatedness looms especially problematic in light of the explosive implications of these texts and others, now appearing in the Cambridge Edition, from Kant's lectures on physical geography and anthropology for the question of Kant'sracism. While the Cambridge Edition's general introduction acknowledges this context in about five pages and with one footnote reference to a proliferating secondary literature, a brevity perhaps justified by the much wider collection of texts comprising that volume, there is a much more extensive discussion of this heated present-day theoretical debate in the volume by Mikkelsen. His "Translator's Introduction" is a very careful essay in the historiography of recent work on Kant and race, recognizing the triggering intervention of Emmanuel Eze and then Tsenay Serequeberhan in the early 1990s, both reflecting a sharp post-colonialist critique of Eurocentrism. Mikkelsen then recounts the ensuing inquiry into these questions by Kant specialists, notably Mark Larrimore, Robert Bernasconi, Robert Louden, and Pauline Kleingeld, but with an exhaustive bibliography attached. His appraisals are thoughtful and persuasive, and they indicate that the question has not been definitively resolved. This will be decisive for the wider reception of his volume in communities of scholarship interested in contemporary issues of race, colonialism and cosmopolitanism and how Kant's work can be received in these domains.

There is a second theoretical context into which Mikkelsen situates his selected texts, namely the history of the life sciences in the eighteenth century. Kant's relation to this history is a matter that has only recently come under serious reconsideration, after a century of work that has privileged his concern with Newtonian physics. Mikkelsen gives a good account of the state of this emergent historiography, especially in relation to Kant, and he recognizes that that research is still in its very early stages. Since this is the field of my own research interest, I am very pleased to see Mikkelsen's attentiveness to this question and his suggestions for further inquiry. But it will also be here that I will raise some specialist's quibbles.

It is altogether salutary that Mikkelsen included texts from Kant's contemporaries and situated the whole volume in the context of the emergent discourse in life sciences of the eighteenth century. Nevertheless, by virtue of his selection, organization, and explicit interpretative interventions, Mikkelsen has not altogether inadvertently given his volume a spin that suggests that the whole discourse arosein response to Kant. This Kant-centered conception, while certainly understandable in a volume entitledKant and the Concept of Race, makes Kant appear to be the driving force in this field, whereas, in my view, he needs to be situated in a much wider course of developments that his specific interventions, to be sure, inflected but did not fundamentally direct. Thus, Mikkelsen might well have emphasized in his introduction, and even in his selection of texts, the more decisive figures in this emergent science. Buffon is of course central, and while Mikkelsen notes this, he does not raise in sufficient detail exactly what Kant took up from Buffon, why and when. The details of that reception, however, seem crucial to an appraisal of Kant's whole relation to the emergent life sciences. Similarly, path-breaking work by Caspar Friedrich Wolff and Johann Friedrich BlumenbachbeforeKant proved decisive for the German exploration of epigenesis, which Mikkelsen rightly singles out as crucial for Kant's views on the life sciences. Their textual inclusion, rather than brief mention in his introduction, might have relativized Kant's place in the discourse of the life sciences of his day. Of course, there are limits to what the volume could provide. That Mikkelsen includes an excerpt from the now forgotten, but at the time eminent, biogeographer Zimmermann is one of the most welcome features of his collection, though I do not believe Mikkelsen fully appreciates the importance of Zimmermann or the influence of his criticisms of Kant.

Even more important, in my view, is the question of Kant's rival, Johann Gottfried Herder, whose reception of Wolff and Blumenbach in hisIdeas for a Philosophical History of Mankind(1784) drew a two-part review from Kant, perhaps the most hostile and disparaging commentary he published on another scholar. Mikkelsen excluded these from his collection, but they in fact deserve a very prominent place in it if we are to understand how Kant came to his ultimate positions. Many of the texts from 1785 onward reflect Kant's explicit critique of Herder and the reactions to it in the wider community of German life science, but the absence of his reviews (to say nothing of texts from Herder himself) obscures this connection. To be sure, again, the volume could not include everything, but my suggestion is that this is not a dispensable element in the story Mikkelsen proposed to reconstruct. He explicitly addresses his omission of Herder and tries, in his introductions to the later texts and in his annotations, to take cognizance of the Herder connection. However, I find these disappointingly superficial regarding Herder. Moreover, there are specific textual passages in Kant's reviews of Herder that are essential for a grasp of the later texts by Kant and the others, and which Mikkelsen could easily have appended or cited more extensively in his annotations. In a word, I find this the most salient historical weakness in Mikkelsen's work.

By contrast, the inclusion of the text from Meiners and the discussion of this figure in the apparatus of the volume represent a very important contribution to Anglophone understanding of the language of race in late eighteenth-century Germany. This is, I suggest, the most cutting-edge element in Mikkelsen's volume, bespeaking his principal concern with race theory. The relation between Meiners and Kant on questions of race has become a matter of increasing scholarly interest, and the possibility of mutual influence has now been put forward as demanding serious consideration. Having a particularly odious exemplar of Meiners' racism in English will make this issue more conspicuous still. This is important, especially in a current context where Meiners is receiving more favorable attention as a cultural anthropologist, but without an adequate recognition of his oppressively racist baggage. For Kant specialists and even more for a general philosophical readership interested in questions of race and cosmopolitanism, Mikkelsen's volume is a very welcome contribution.},
}

@book{frierson2013human,
    author = {Frierson, Patrick R.},
    title = {What Is the Human Being?},
    publisher = {Routledge},
    year = {2013},
    doi = {10.4324/9780203070314},
    note = {SUMMARY: Introduction to Kant's philosophy of human nature that explains three ways Kant addresses the question 'what is the human being?' (the transcendental, the empirical and the pragmatic) and then considers later theorists of human nature, among them Hegel, Marx, Darwin, Nietzsche, Freud, Sartre, Heidegger, Foucault and E. O. Wilson, who challenge or enrich his views (publisher abstract; NDPR). SUBFIELD AND DEBATE: Anthropology and philosophy of mind: Kant's theory of human nature and its twentieth-century legacy; NDPR stresses the systematic reconstruction of the empirical elements of Kant's account. The NDPR and Mind review titles give the book as 'Kant's Questions: What Is the Human Being?'. SIGNIFICANCE INDICATORS: S2: no title-matched record found; CrossRef: 28. NDPR review: yes (ndpr.nd.edu/reviews/kant-s-questions-what-is-the-human-being/). Other review: Mind (Grenberg, 2014; CrossRef). SEP: not found in the retrieved bibliographies. Publisher: Routledge. YEAR NOTE: CrossRef gives an online date of 2013-02-11 and no print date.},
    keywords = {kant, anthro-hist-edu, tp-mind, type-monograph, Medium},
    abstract = {Philosophers, anthropologists and biologists have long puzzled over the question of human nature. It is also a question that Kant thought about deeply and returned to in many of his writings. In this lucid and wide-ranging introduction to Kant’s philosophy of human nature - which is essential for understanding his thought as a whole - Patrick R. Frierson assesses Kant’s theories and examines his critics. He begins by explaining how Kant articulates three ways of addressing the question ‘what is the human being?’: the transcendental, the empirical, and the pragmatic. He then considers some of the great theorists of human nature who wrestle with Kant’s views, such as Hegel, Marx, Darwin, Nietzsche, and Freud; contemporary thinkers such as E.O.Wilson and Daniel Dennett, who have sought biological explanations of human nature; Thomas Kuhn, Michel Foucault, and Clifford Geertz, who emphasize the diversity of human beings in different times and places; and existentialist philosophers such as Sartre and Heidegger. He argues that whilst these approaches challenge and enrich Kant’s views in significant ways, all suffer from serious weaknesses that Kant’s anthropology can address. Taking a core insight of Kant’s - that human beings are fundamentally free but finite - he argues that it is the existentialists, particularly Sartre, who are the most direct heirs of his transcendental anthropology. The final part of the book is an extremely helpful overview of the work of contemporary philosophers, particularly Christine Korsgaard and Jürgen Habermas. Patrick R. Frierson explains how these philosophers engage with questions of naturalism, historicism, and existentialism while developing Kantian conceptions of the human being. Including chapter summaries and annotated further reading, What is the Human Being? is an outstanding introduction to some fundamental aspects of Kant’s thought and a judicious assessment of leading theories of human nature. It is essential reading for all students of Kant and the philosophy of human nature, as well as those in related disciplines such as anthropology, politics and sociology.},
    abstract_source = {openalex},
}

@article{golob2013heidegger,
    author = {Golob, Sacha},
    title = {Heidegger on Kant, Time and the ‘Form’ of Intentionality},
    journal = {British Journal for the History of Philosophy},
    year = {2013},
    volume = {21},
    number = {2},
    pages = {345--367},
    doi = {10.1080/09608788.2012.692662},
    note = {SUMMARY: Analyses Heidegger's 1927/8 lecture course on the Critique of Pure Reason and his 1929 Kant and the Problem of Metaphysics, arguing that Heidegger's reading of Kant turns on two questions: how Heidegger's Kant understands the transcendental (answered through Cassam's model of a self-directed transcendental argument) and what role the horizon plays (answered through Kant's view that pure general logic abstracts from semantic content and Hume's attack on metaphysics) (abstract). SUBFIELD AND DEBATE: Reception (phenomenology): Heidegger's interpretation of Kant's Critique of Pure Reason. SIGNIFICANCE INDICATORS: S2 citations: 15 (retrieved 2026-09-30); CrossRef: 12. Venue: British Journal for the History of Philosophy. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2013-03 (volume 21, issue 2).},
    keywords = {kant, recep-phenom, tp-cpr, type-article, Low},
    abstract = {Between 1927 and 1936, Martin Heidegger devoted almost one thousand pages of close textual commentary to the philosophy of Immanuel Kant. This article aims to shed new light on the relationship between Kant and Heidegger by providing a fresh analysis of two central texts: Heidegger's 1927/8 lecture course Phenomenological Interpretation of Kant's Critique of Pure Reason and his 1929 monograph Kant and the Problem of Metaphysics. I argue that to make sense of Heidegger's reading of Kant, one must resolve two questions. First, how does Heidegger's Kant understand the concept of the transcendental? Second, what role does the concept of a horizon play in Heidegger's reconstruction of the Critique? I answer the first question by drawing on Cassam's model of a self-directed transcendental argument (‘The role of the transcendental within Heidegger's Kant’), and the second by examining the relationship between Kant's doctrine that ‘pure, general logic’ abstracts from all semantic content and Hume's attack on metaphysics (‘The role of the horizon within Heidegger's Kant’). I close by sketching the implications of my results for Heidegger's own thought (‘From Heidegger's Kant to Sein und Zeit’). Ultimately, I conclude that Heidegger's commentary on the Critical system is defined, above all, by a single issue: the nature of the ‘form’ of intentionality.},
    abstract_source = {openalex},
}

@book{bacin2013kongress,
    editor = {Bacin, Stefano and Ferrarin, Alfredo and La Rocca, Claudio and Ruffing, Margit},
    title = {Kant und die Philosophie in weltbürgerlicher Absicht: Akten des XI. Kant-Kongresses 2010},
    publisher = {De Gruyter},
    year = {2013},
    doi = {10.1515/9783110246490},
    note = {SUMMARY: Five-volume proceedings of the Eleventh International Kant Congress (Pisa, 2010), containing 25 plenary talks and 341 papers in 14 sections from Kant's concept of philosophy to Kant's heritage; it was the first congress to include a session on Kant and Schopenhauer (publisher abstract). SUBFIELD AND DEBATE: Reference work covering all subfields of Kant scholarship (proceedings in German and English); the Kant-Kongress series of the Kant-Gesellschaft. Carry-forward from Domain 1 (Pisa 2010 proceedings dated 2013 in SEP bibliographies). SIGNIFICANCE INDICATORS: S2 citations: 14 (retrieved 2026-09-30); CrossRef: 6. SEP: chapters cited in the kant-mathematics (Jauernig), kant-science (Leduc) and kant-transcendental-idealism bibliographies. NDPR: not applicable, no review found. Publisher: De Gruyter. YEAR NOTE: The congress took place in 2010; CrossRef print and online date 2013-10-15.},
    keywords = {kant, reference, type-edited-volume, Low},
    abstract = {Held every five years under the auspices of the Kant-Gesellschaft, the International Kant Congress is the world’s largest philosophy conference devoted to the work and legacy of a single thinker. The five-volume set Kant and Philosophy in a Cosmopolitan Sense contains the proceedings of the Eleventh International Kant Congress, which took place in Pisa in 2010. The proceedings consist of 25 plenary talks and 341 papers selected by a team of international referees from over 700 submissions. The contributions span 14 sections: Kant’s Concept of Philosophy; Theory of Cognition and Logic; Ontology and Metaphysics; Ethics; Law and Justice; Religion and Theology; Aesthetics; Anthropology and Psychology; Politics and History; Science, Mathematics, and the Philosophy of Nature; Kant and the Leibnizian Tradition; Kant and the Philosophical Tradition; Kant and Schopenhauer; and Kant’s Heritage. Thanks to cooperation from the Schopenhauer Gesellschaft, the 2010 conference was the first in the history of the International Kant Congress to include a session on Kant and Schopenhauer.},
    abstract_source = {openalex},
}

@book{frierson2014empirical,
    author = {Frierson, Patrick R.},
    title = {Kant's Empirical Psychology},
    publisher = {Cambridge University Press},
    year = {2014},
    doi = {10.1017/cbo9781139507035},
    note = {SUMMARY: Uses close analysis of texts, including unpublished lectures and notes, to show how Kant explains human action, choice and thought in empirical terms. The book argues that understanding Kant's empirical psychology sheds light on major concepts of his philosophy, including the moral law, moral responsibility, weakness of will and cognitive error, and applies Kant's accounts of mental illness to contemporary philosophical issues (publisher abstract). SUBFIELD AND DEBATE: Philosophy of mind and anthropology: the place of empirical psychology in Kant's system. SIGNIFICANCE INDICATORS: S2 citations: 70 (retrieved 2026-09-30); CrossRef: 63. SEP: listed in the kant-hume-morality bibliography. Reviews: Kantian Review (Grenberg, 2016), Con-Textos Kantianos (Rumore, 2015). NDPR: no review found for this title (the author's 2013 book is reviewed there). Publisher: Cambridge University Press. YEAR NOTE: CrossRef print date 2014-07-17, online 2014-08.},
    keywords = {kant, tp-mind, anthro-hist-edu, type-monograph, Medium},
    abstract = {Throughout his life, Kant was concerned with questions about empirical psychology. He aimed to develop an empirical account of human beings, and his lectures and writings on the topic are recognizable today as properly 'psychological' treatments of human thought and behavior. In this book Patrick R. Frierson uses close analysis of relevant texts, including unpublished lectures and notes, to study Kant's account. He shows in detail how Kant explains human action, choice, and thought in empirical terms, and how a better understanding of Kant's psychology can shed light on major concepts in his philosophy, including the moral law, moral responsibility, weakness of will, and cognitive error. Frierson also applies Kant's accounts of mental illness to contemporary philosophical issues. His book will interest students and scholars of Kant, the history of psychology, philosophy of psychology, and philosophy of action.},
    abstract_source = {openalex},
}

@book{dyck2014rational,
    author = {Dyck, Corey W.},
    title = {Kant and Rational Psychology},
    publisher = {Oxford University Press},
    year = {2014},
    doi = {10.1093/acprof:oso/9780199688296.001.0001},
    note = {SUMMARY: Examines Kant's critique of rational psychology in the Critique of Pure Reason within its eighteenth-century German context. It argues that Christian Wolff's rational psychology, which stressed empirical foundations, rather than Descartes or Leibniz, was Kant's primary target in the Paralogisms, and that Kant's criticism exposes how rational psychologists treat the soul as given in inner experience (OUP page description retrieved this session; the OpenAlex abstract text is garbled). SUBFIELD AND DEBATE: Theoretical philosophy: the Paralogisms and Kant's critique of rational psychology, read against the Wolffian school. SIGNIFICANCE INDICATORS: S2 citations: 92 (retrieved 2026-09-30); CrossRef: 68. SEP: listed in the kant-metaphysics and kant-mind bibliographies and cited in the text of kant-metaphysics (section on the soul and rational psychology). Reviews: Journal of the History of Philosophy (Naragon, 2015), Kant-Studien (Pollok, 2017), Kantian Review (Wunderlich, 2017), German Studies Review (Switzer, 2017). NDPR: no review found. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2014-03-20; the OUP page gives 20 May 2014.},
    sep_context = {SEP kant-metaphysics: "There are also excellent discussions to be found in Allison (1983, 2004), Bennett (1974), Buroker (2006), Grier (2001, forthcoming), Guyer (1987), Wuerth (2010, 2021) (2010), Bird (2006), Ameriks (2006), Melnick (2006), Dyck (2014), Proops (2010), Willaschek (2018)"},
    keywords = {kant, tp-cpr, tp-mind, type-monograph, High, INCOMPLETE, no-abstract, summary-source-publisher-page},
}

@article{gomes2014naive,
    author = {Gomes, Anil},
    title = {Kant on Perception: Naïve Realism, Non-Conceptualism, and the B-Deduction},
    journal = {The Philosophical Quarterly},
    year = {2014},
    volume = {64},
    number = {254},
    pages = {1--19},
    url = {https://doi.org/10.1093/pq/pqt019},
    note = {SUMMARY: Argues that non-conceptualism cannot provide an account of the Transcendental Deduction and so should be rejected, while holding that this has no bearing on whether Kant endorsed a relational account of perceptual experience (abstract). SUBFIELD AND DEBATE: Theory of perception: conceptualism versus nonconceptualism, and relational (naive-realist) readings of Kant's account of perceptual experience; the B-Deduction. SIGNIFICANCE INDICATORS: S2 citations: 72 (retrieved 2026-09-30); CrossRef: 34. Venue: The Philosophical Quarterly. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2014-01-01 (volume 64, issue 254), online 2013-11-05.},
    keywords = {kant, tp-mind, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {According to non-conceptualist interpretations, Kant held that the application of concepts is not necessary for perceptual experience. Some have motivated non-conceptualism by noting the affinities between Kant's account of perception and contemporary relational theories of perception. In this paper, I argue (i) that non-conceptualism cannot provide an account of the Transcendental Deduction and thus ought to be rejected; and (ii) that this has no bearing on the issue of whether Kant endorsed a relational account of perceptual experience.},
    abstract_source = {openalex},
}

@article{stang2014nonidentity,
    author = {Stang, Nicholas F.},
    title = {The Non-Identity of Appearances and Things in Themselves},
    journal = {Noûs},
    year = {2014},
    volume = {48},
    number = {1},
    pages = {106--136},
    url = {https://doi.org/10.1111/nous.12056},
    note = {SUMMARY: Targets the 'Metaphysical One Object' reading of transcendental idealism, on which an appearance is numerically identical to the thing in itself that appears as it, and raises indiscernibility arguments: because an appearance has different spatiotemporal and modal properties than a thing in itself, no appearance can be identical to one. The paper notes the parallel with arguments against monism about material objects and the matter constituting them (abstract). SUBFIELD AND DEBATE: Transcendental idealism: one-object (two-aspect) versus two-object readings of the appearance/thing-in-itself distinction. SIGNIFICANCE INDICATORS: S2 citations: 26 (retrieved 2026-09-30); CrossRef: 15. Venue: Noûs. SEP: listed in the kant-transcendental-idealism bibliography. YEAR NOTE: CrossRef print date 2014-03 (volume 48, issue 1), online 2013-12-10.},
    keywords = {kant, tp-cpr, debate-two-aspect, type-article, Medium},
    abstract = {Abstract According to the ‘One Object’ reading of Kant's transcendental idealism, the distinction between the appearance and the thing in itself is not a distinction between two objects, but between two ways of considering one and the same object. On the ‘Metaphysical’ version of the One Object reading, it is a distinction between two kinds of properties possessed by one and the same object. Consequently, the Metaphysical One Object view holds that a given appearance, an empirical object, is numerically identical to the thing in itself that appears as that object. I raise various indiscernibility arguments against that view; because an appearance has different spatiotemporal and modal properties than a thing in itself, no appearance can be identical to a thing in itself. I point out that these arguments are similar to arguments against Monism, the view that material objects are numerically identical to the matter of which they are made. I outline some strategies Monists have developed to respond to these indiscernibility arguments and then develop parallel responses on behalf of the Metaphysical One Object view. However, I then raise another indiscernibility argument, to which, I argue, the Metaphysical One Object view cannot respond, even using the resources I have developed thus far. I develop a modified version of the Metaphysical One Object view that can respond to this new indiscernibility argument, but, I argue, this modified version of the One Object view is only a terminological variant of the Two Object view. When the Metaphysical One Object view is fully thought through it becomes the Two Object view. I conclude that Kantian appearances are not numerically identical to the things in themselves that appear to us.},
    abstract_source = {openalex},
}

@book{wuerth2014mind,
    author = {Wuerth, Julian},
    title = {Kant on Mind, Action, and Ethics},
    publisher = {Oxford University Press},
    year = {2014},
    doi = {10.1093/acprof:oso/9780199587629.001.0001},
