    year = {2015},
    doi = {10.1093/acprof:oso/9780198724858.001.0001},
    note = {SUMMARY: Commentary arguing that the Transcendental Deduction addresses a new problem, the role of a priori concepts stemming from the nature of the understanding in grounding objectivity, rather than an older sceptical challenge. It traces four developments in Kant's thought (the distinction between sensibility and understanding, their necessary cooperation, the unity of apperception and the mediating role of imagination) and defends a 'non-contingency thesis' and the inseparability of the argument from transcendental idealism (OUP page description retrieved this session; no abstract from S2 or the resolver). SUBFIELD AND DEBATE: Theoretical philosophy: the Transcendental Deduction of the categories (A and B versions) and its relation to transcendental idealism. SIGNIFICANCE INDICATORS: S2 citations: 106 (retrieved 2026-09-30); CrossRef: 88. SEP: listed in the kant, kant-mind and kant-transcendental bibliographies and cited in the text of kant-transcendental. Critical discussion: Guyer, Kant-Studien (2017), titled 'What does the transcendental deduction prove, and when does it prove it? Henry Allison on ...' (CrossRef). NDPR: no review found. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2015-07-01; the OUP page gives 16 September 2015.},
    sep_context = {SEP kant-transcendental: "So the unity of space and time is to be explained with reference to the effect of the understanding upon sensibility itself (Longuenesse 1998: 211–33; Keller 1998: 88–94; Dickerson 2004: 196–201; Pollok 2008; Vinci 2014: 197–229; Onof and Schulting 2015; Allison 2015: 374–432; Rosefeldt 2022)."},
    keywords = {kant, tp-cpr, type-monograph, High, INCOMPLETE, no-abstract, summary-source-publisher-page}
}

@book{anderson2015poverty,
    author = {Anderson, R. Lanier},
    title = {The Poverty of Conceptual Truth: Kant's Analytic/Synthetic Distinction and the Limits of Metaphysics},
    publisher = {Oxford University Press},
    year = {2015},
    doi = {10.1093/acprof:oso/9780198724575.001.0001},
    note = {SUMMARY: Argues that Kant's analytic/synthetic distinction underwrites an argument against Leibnizian-Wolffian metaphysics: scientifically indispensable parts of our knowledge (mathematics, the foundations of natural science, empirical knowledge, the principles of metaphysics) are essentially synthetic and cannot be restated in the 'containment' idiom of conceptual truth, so traditional metaphysics founders on the expressive poverty of conceptual truth. The book grounds the distinction in traditional logic (concept containment, Porphyrian hierarchies, logical division) and traces Kant's path to it (abstract; NDPR). SUBFIELD AND DEBATE: Theoretical philosophy: analyticity and syntheticity, Kant's critique of Leibnizian-Wolffian metaphysics, philosophy of mathematics and logic; the epilogue draws consequences for conceptualism. SIGNIFICANCE INDICATORS: S2 citations: 10 on the title-matched record (book-level S2 counts are unreliable; retrieved 2026-09-30); CrossRef: 70. NDPR review: yes (ndpr.nd.edu/reviews/the-poverty-of-conceptual-truth-kant-s-analytic-synthetic-distinction-and-the-limits-of-metaphysics/). Other reviews: Archiv fuer Geschichte der Philosophie (Laiho, 2016), Kantian Review (Goldberg, 2016), Journal of the History of Philosophy (Lu-Adler, 2018), Kant-Studien (Pluder, 2019). SEP: listed in the kant-judgment, kant-mathematics, kant-religion and kant-spacetime bibliographies. Publisher: Oxford University Press. YEAR NOTE: CrossRef print date 2015-01-22.},
    keywords = {kant, tp-cpr, tp-science-math, type-monograph, Medium},
    abstract = {Abstract Kant's distinction between analytic and synthetic judgments underwrites a powerful argument against Leibnizian–Wolffian metaphysics. That traditional metaphysics promised to reveal the rational structure of the world by representing all truth as conceptual, flowing from logically perspicuous "containment" relations among concepts. Such a system would be analytic, sensu Kant. But Kant shows that scientifically indispensable parts of our knowledge (including mathematics, the foundations of natural science, empirical knowledge, and the principles of metaphysics itself) are essentially synthetic and could never be restated in analytic form. Thus, the target metaphysics is doomed because knowledge crucial to any adequate theory of the world cannot even be expressed in its restricted idiom. Traditional metaphysics founders on the expressive poverty of conceptual truth. Kant's distinction can be given a clear basis in central ideas of the traditional logic (concept containment, Porphyrian hierarchies, and logical division). This logical conception of analyticity provides boundaries for conceptual truth, thereby resisting suggestions that synthetic truths might be restated as analyticities through improvements in our concepts or knowledge (Part I). While the logical conception of analyticity seems straightforward, Kant's path to discovering it was difficult and tracing it illuminates the critical philosophy (Part II). With a clear distinction in place, it is possible to reconstruct compelling arguments that mathematics must be synthetic, vindicating the anti-Leibnizian argument from expressive power (Part III). Similar considerations then prove important for Kant's famous arguments against traditional metaphysics in the "Transcendental Dialectic" (Part IV). The overall interpretation carries interesting morals for understanding Kant's theory of empirical concepts and the role of "conceptualism" in his philosophy (Epilogue).},
    abstract_source = {openalex},
}

@article{stephenson2015hallucination,
    author = {Stephenson, Andrew},
    title = {Kant on the Object-Dependence of Intuition and Hallucination},
    journal = {The Philosophical Quarterly},
    year = {2015},
    volume = {65},
    number = {260},
    pages = {486--508},
    doi = {10.1093/pq/pqu100},
    note = {SUMMARY: Argues, against a view 'currently popular in the literature', that Kant was not a naive realist about perceptual experience: naive realism entails a strong object-dependence of experience, and the paper undermines the evidence for attributing it to Kant and argues that Kant's account of hallucination is unavailable to someone who holds that veridical perception is object-dependent in that sense. It describes Kant's theory as giving a bottom-up explanation of the phenomenal character of hallucinatory episodes (abstract). SUBFIELD AND DEBATE: Theory of perception: naive-realist (object-dependent) readings of Kant's account of intuition and perception, and Kant on hallucination. SIGNIFICANCE INDICATORS: S2 citations: 75 (retrieved 2026-09-30); CrossRef: 26. Venue: The Philosophical Quarterly. SEP: not found in the retrieved bibliographies. YEAR NOTE: CrossRef print date 2015-07 (volume 65, issue 260), online 2015-02-19.},
    keywords = {kant, tp-mind, tp-cpr, debate-other-naive-realism, type-article, Medium},
    abstract = {Against a view currently popular in the literature, it is argued that Kant was not a naïve realist about perceptual experience. Naive realism entails that perceptual experience is object-dependent in a very strong sense. In the first half of the paper, I explain what this claim amounts to and I undermine the evidence that has been marshalled in support of attributing it to Kant. In the second half of the paper, I explore in some detail Kant's account of hallucination and argue that no such account is available to someone who thinks that veridical perceptual experience is object-dependent in the naïve realist sense. Kant's theory provides for a remarkably sophisticated, bottom-up explanation of the phenomenal character of hallucinatory episodes and is crucial for gaining a proper understanding of his model of the mind and its place in nature.},
    abstract_source = {openalex},
}

@article{onof2015space,
    author = {Onof, Christian and Schulting, Dennis},
    title = {Space as Form of Intuition and as Formal Intuition: On the Note to B160 in Kant's Critique of Pure Reason},
    journal = {The Philosophical Review},
    year = {2015},
    volume = {124},
    number = {1},
    pages = {1--58},
    doi = {10.1215/00318108-2812650},
    note = {SUMMARY: Examines Kant's distinction in the B-Deduction (note to B160) between space as 'form of intuition' and as 'formal intuition', arguing against a recent reading that fuses the two so that space is first generated by the understanding's synthesis of the imagination. On the authors' account a key characteristic of space as a form of intuition is its nonconceptual unity, which is independent of determination by the understanding (abstract). SUBFIELD AND DEBATE: Theoretical philosophy: unity of space in the Transcendental Deduction; nonconceptual unity and the conceptualism debate. SIGNIFICANCE INDICATORS: S2 citations: 84 (retrieved 2026-09-30); CrossRef: 50. Venue: The Philosophical Review. SEP: listed in the kant-transcendental bibliography and cited in its text. YEAR NOTE: CrossRef print and online date 2015-01-01 (volume 124, issue 1).},
    keywords = {kant, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {In his argument for the possibility of knowledge of spatial objects, in the Transcendental Deduction of the B-version of the Critique of Pure Reason, Kant makes a crucial distinction between space as “form of intuition” and space as “formal intuition.” The traditional interpretation regards the distinction between the two notions as reflecting a distinction between indeterminate space and determinations of space by the understanding, respectively. By contrast, a recent influential reading has argued that the two notions can be fused into one and that space as such is first generated by the understanding through an act of synthesis of the imagination. Against this reading, this article argues that a key characteristic of space as a form of intuition is its nonconceptual unity, which defines the properties of space and is as such necessarily independent of determination by the understanding through the transcendental synthesis of the imagination. The conceptual unity that the understanding prescribes to the manifold in intuition, by means of the categories, defines the formal intuition. Furthermore, this article argues that it is the sui generis, nonconceptual unity of space, when takenas a unity for the understanding by means of conceptual determination, that first enables geometric knowledge and knowledge of spatially located particulars.},
    abstract_source = {openalex},
}

@article{mcnulty2015regulative,
    author = {McNulty, Michael Bennett},
    title = {Rehabilitating the Regulative Use of Reason: Kant on Empirical and Chemical Laws},
    journal = {Studies in History and Philosophy of Science Part A},
    year = {2015},
    volume = {54},
    pages = {1--10},
    doi = {10.1016/j.shpsa.2015.06.002},
    note = {SUMMARY: Addresses interpretive disagreement over the nature and source of the necessity of empirical laws of nature in Kant's system and develops an 'ideational' account on which ideas of reason necessitate the laws of some non-physical sciences. Chemical laws, for instance, are grounded on ideas of the elements, and the chemist aims to reduce her phenomena to these elements by experimentation (abstract from the University of Minnesota Experts page returned by web search). SUBFIELD AND DEBATE: Philosophy of science: necessity of empirical laws, the regulative use of reason and Kant on chemistry. SIGNIFICANCE INDICATORS: Award: North American Kant Society Markus Herz Student Essay Prize 2014 for 'Rehabilitating the regulative Use of Reason' (NAKS prize-winners page, retrieved 2026-09-30). S2 citations: 35 (retrieved 2026-09-30); CrossRef: 32. Venue: Studies in History and Philosophy of Science Part A. SEP: listed in the kant-science bibliography. YEAR NOTE: CrossRef print date 2015-12 (volume 54).},
    keywords = {kant, tp-science-math, type-article, Medium, INCOMPLETE, no-abstract, summary-source-web-abstract}
}

@book{schonecker2015groundwork,
    author = {Schönecker, Dieter and Wood, Allen W.},
    title = {Immanuel Kant's ‘Groundwork for the Metaphysics of Morals’: A Commentary},
    publisher = {Harvard University Press},
    year = {2015},
    doi = {10.4159/harvard.9780674736214},
    note = {SUMMARY: Short commentary on the Groundwork aiming at an accurate reading. NDPR describes it as a slightly revised translation of the authors' German commentary published in 2001, in which Wood's views on the Categorical Imperative shape the treatment of Groundwork II and Schönecker's account of the structure of the deduction shapes Groundwork III (NDPR). SUBFIELD AND DEBATE: Practical philosophy: Groundwork commentary (the formulas of the categorical imperative and the deduction in Groundwork III). SIGNIFICANCE INDICATORS: S2 citations: 9 on the title-matched record (retrieved 2026-09-30); CrossRef: 12. NDPR review: yes (ndpr.nd.edu/reviews/immanuel-kant-s-groundwork-for-the-metaphysics-of-morals-a-commentary/). SEP: listed in the kant-moral bibliography. Publisher: Harvard University Press. YEAR NOTE: Translation of the German commentary (NDPR: published in German in 2001), dated by the translation; CrossRef print date 2015-01-31.},
    keywords = {kant, pp-ethics, type-monograph, Medium},
    abstract = {A defining work of moral philosophy, Groundwork for the Metaphysics of Morals has been highly influential and famously difficult. Dieter Schönecker and Allen Wood make clear the ways this work forms the basis of our modern moral outlook and how moral law relates to freedom and free will within Kant’s overall philosophy.},
    abstract_source = {openalex},
}

@book{oneill2015authorities,
    author = {O'Neill, Onora},
    title = {Constructing Authorities: Reason, Politics and Interpretation in Kant's Philosophy},
    publisher = {Cambridge University Press},
    year = {2015},
    doi = {10.1017/cbo9781316337141},
    note = {SUMMARY: Collects essays developed over many years on Kant's philosophy, arguing against the claim that Kant's critique of reason collapses into an argument from authority: Kant held that we must construct, not assume, the authority of reason, by ensuring that what we offer as reasons can be followed by others. She presents this constructivist view of reasoning as the clue to Kant's claims about knowledge, ethics and politics, including autonomy, the social contract, cosmopolitan justice and scriptural interpretation (publisher abstract). SUBFIELD AND DEBATE: Kant's critique of reason, practical and political philosophy: a constructivist reading of the authority of reason. SIGNIFICANCE INDICATORS: S2 citations: 29 (retrieved 2026-09-30); CrossRef: 40. SEP: listed in the kant-reason bibliography. Reviews: Kant-Studien (Rosales, 2018), Journal of Moral Philosophy (Frierson, 2019). NDPR: no review found. Publisher: Cambridge University Press. YEAR NOTE: Collection dated by the collection year; the SEP bibliography dates chapters 1 and 2 as originally published in 1992 and 2004. CrossRef print date 2015-11-30, online 2015-12-18.},
    keywords = {kant, pp-ethics, pp-right-politics, debate-constructivism, type-monograph, Medium},
    abstract = {This collection of essays brings together the central lines of thought in Onora O'Neill's work on Kant's philosophy, developed over many years. Challenging the claim that Kant's attempt to provide a critique of reason fails because it collapses into a dogmatic argument from authority, O'Neill shows why Kant held that we must construct, rather than assume, the authority of reason, and how this can be done by ensuring that anything we offer as reasons can be followed by others, including others with whom we disagree. She argues that this constructivist view of reasoning is the clue to Kant's claims about knowledge, ethics and politics, as well as to his distinctive accounts of autonomy, the social contract, cosmopolitan justice and scriptural interpretation. Her essays are a distinctive and illuminating commentary on Kant's fundamental philosophical strategy and its implications, and will be a vital resource for scholars of Kant, ethics and philosophy of law.},
    abstract_source = {openalex},
}

@book{reath2015practical,
    author = {Kant, Immanuel},
    editor = {Reath, Andrews and Gregor, Mary},
    title = {Critique of Practical Reason},
    publisher = {Cambridge University Press},
    year = {2015},
    url = {https://doi.org/10.1017/cbo9781316136478},
    note = {SUMMARY: Revised edition of the Cambridge Texts translation of the second Critique, containing Mary Gregor's translation, with Andrews Reath's introduction placing the main themes of the Critique in the context of Kant's moral theory and critical system; the introduction has been revised and the guide to secondary reading completely updated (publisher abstract). SUBFIELD AND DEBATE: Edition and translation: Critique of Practical Reason (1788), Cambridge Texts in the History of Philosophy (series name as given in the Dialogue review title returned by S2). SIGNIFICANCE INDICATORS: S2 citations: 16 (retrieved 2026-09-30); CrossRef: 5. Review: Dialogue (Feuerhahn, 2015; title as returned by S2). SEP: only the 2010 Critical Guide is found in the retrieved bibliographies, not this edition. NDPR: the slug critique-of-practical-reason reviews a different edition (Pluhar's translation) and is not used. Publisher: Cambridge University Press. YEAR NOTE: Edition and translation of Kant (1788); revised edition of an earlier Cambridge Texts edition (per the publisher abstract); CrossRef print date 2015-01-26, online 2015-02-05.},
    keywords = {kant, edition-trans, pp-ethics, type-translation-edition, Medium},
    abstract = {The Critique of Practical Reason is the second of Kant's three Critiques, one of his three major treatises on moral theory, and a seminal text in the history of moral philosophy. Originally published three years after his Groundwork of the Metaphysics of Morals, the Critique provides further elaboration of the basic themes of Kant's moral theory, gives the most complete statement of his highly original theory of freedom of the will, and develops his practical metaphysics. This revised edition of Kant's Critique of Practical Reason – which contains Mary Gregor's acclaimed translation – is now the authoritative translation of this work. A substantial and lucid introduction by Andrews Reath places the mains themes of the Critique in the context of Kant's moral theory and his critical system. For this edition, the introduction has been revised and the guide to the secondary reading completely updated.},
    abstract_source = {openalex},
}

@book{friedlander2015expressions,
    author = {Friedlander, Eli},
    title = {Expressions of Judgment: An Essay on Kant's Aesthetics},
    publisher = {Harvard University Press},
    year = {2015},
    doi = {10.4159/harvard.9780674735699},
    note = {SUMMARY: Reappraisal of the Critique of Judgment that emphasizes the internal connection of judgment and meaning and shows how the pleasure in judging is related to our capacity to draw meaning from our encounter with beauty (publisher abstract). The NDPR review describes the essay as speculative in vein and is critical of its lack of reconstruction of Kant's lines of argument (NDPR). SUBFIELD AND DEBATE: Aesthetics: judgment and meaning in the Critique of Judgment; interpretive essay rather than a commentary. SIGNIFICANCE INDICATORS: S2 citations: 5 (retrieved 2026-09-30); CrossRef: 5. NDPR review: yes (ndpr.nd.edu/reviews/expressions-of-judgment-an-essay-on-kant-s-aesthetics/). Other reviews: Critical Inquiry (Lehman, 2015), Journal of Aesthetics and Art Criticism (Packer, 2015). SEP: listed in the kant-aesthetics bibliography. Publisher: Harvard University Press. YEAR NOTE: CrossRef print and online date 2015-12-31.},
    keywords = {kant, aes-teleo, type-monograph, Medium},
    abstract = {Kant’s The Critique of Judgment laid the groundwork of modern aesthetics when it appeared in 1790. Eli Friedlander’s reappraisal emphasizes the internal connection of judgment and meaning, showing how the pleasure in judging is intimately related to our capacity to draw meaning from our encounter with beauty.},
    abstract_source = {openalex},
}

@book{ferrarin2015powers,
    author = {Ferrarin, Alfredo},
    title = {The Powers of Pure Reason: Kant and the Idea of Cosmic Philosophy},
    publisher = {University of Chicago Press},
    year = {2015},
    url = {https://doi.org/10.7208/chicago/9780226243290.001.0001},
    note = {SUMMARY: Presents an account of Kant's critical works under the rubric of 'the idea of cosmic philosophy', aiming to uncover the basic intentions animating his efforts in the final critical decades through close reading, developmental history and analytic reconstruction. NDPR finds in it less a steady progression toward clarity than oscillating efforts to give due weight to competing tendencies within core insights (NDPR; the resolver's abstract text was not usable). SUBFIELD AND DEBATE: The critical system as a whole: the basic intentions of Kant's critical work, read across texts rather than topic by topic. SIGNIFICANCE INDICATORS: S2 citations: 80 on the record carrying the book's DOI (dated 2016; retrieved 2026-09-30); CrossRef: 43. NDPR review: yes (ndpr.nd.edu/reviews/he-powers-of-pure-reason-kant-and-the-idea-of-cosmic-philosophy/, the slug as it appears in the NDPR sitemap). Other reviews and discussion: Kantian Review (Wilford, 2016), Kant-Studien (Pozzo, 2017), Estudos Kantianos (Feloj, 2017, with a reply by Ferrarin). SEP: listed in the kant-reason bibliography. Publisher: University of Chicago Press. YEAR NOTE: CrossRef gives 2015 (print).},
    keywords = {kant, tp-cpr, type-monograph, Medium, INCOMPLETE, no-abstract, summary-source-ndpr},
}

