@article{howard2019transition,
    author = {Howard, Stephen},
    title = {The transition within the transition: the Übergang from the Selbstsetzungslehre to the ether proofs in Kant's Opus postumum},
    journal = {Kant-Studien},
    year = {2019},
    volume = {110},
    number = {4},
    pages = {595--617},
    doi = {10.1515/kant-2019-3002},
    note = {SUMMARY: Argues against readings such as Förster's that treat the ether proofs and the Selbstsetzungslehre as the core of the Opus postumum, holding that the drafts of fascicles X and XI, written between them, are of primary importance. Through a close reading of a page of fascicle XI it shows Kant trying to resolve problems internal to both by presenting a transition from one to the other, and it urges a renewed appreciation of the drafts as aspiring to a science of transition (journal abstract). SUBFIELD AND DEBATE: Late work, Opus postumum: the transition project and the Selbstsetzungslehre, in dialogue with Förster's interpretation. SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 2 (2026-09-30). Venue: Kant-Studien 110(4). Included mainly to cover the Opus postumum cell; the other 2019 Opus postumum items found in S2 and CrossRef searches are lower-cited articles, a review, or Zenodo items.},
    keywords = {kant, opus-postumum, debate-other-transition, type-article, Low, summary-source-abstract},
    abstract = {Abstract Recent literature on Kant’s Opus postumum has typically focused on two parts of the drafts: the ether proofs and the Selbstsetzungslehre. Eckart Förster’s interpretation is representative of this tendency and, moreover, presents the Selbstsetzungslehre as the culmination of Kant’s late project. By contrast, I argue that the drafts of fascicles X/XI, written in between the ether proofs and the Selbstsetzungslehre, are of primary importance for understanding the Opus postumum. Through a close reading of a page from fascicle XI, I show that Kant attempts to resolve problems internal to the Selbstsetzungslehre and the ether proofs by presenting a transition from the former to the latter. I advocate a renewed appreciation of the centrality of fascicles X/XI, insofar as the Opus postumum drafts aspire to a science of transition.},
    abstract_source = {s2},
}

@book{allison2020freedom,
    author = {Allison, Henry E.},
    title = {Kant's Conception of Freedom: A Developmental and Critical Analysis},
    publisher = {Cambridge University Press},
    year = {2020},
    url = {https://doi.org/10.1017/9781316535196},
    note = {SUMMARY: Traces Kant's views on free will from his earliest discussions in the 1750s to his last accounts in the 1790s. It argues that Kant's path to viewing freedom as a transcendental power both radically distinct from and compatible with natural causality was a winding one, and that the concept stayed central because it unites his theoretical and practical philosophy (publisher abstract). The NDPR review describes the book as in effect a detailed survey of Kant's whole philosophy, from the Universal Natural History (1755) to the Religion and Metaphysics of Morals, with the ten chapters divided evenly between pre-critical and post-1781 writings. SUBFIELD AND DEBATE: Practical philosophy and the development of Kant's thought: freedom of the will, the pre-critical writings and the critical turn, compatibilism and transcendental freedom. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 27 and S2 citations 25 (2026-09-30). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kants-conception-of-freedom-a-developmental-and-critical-analysis). Other reviews: European Journal of Philosophy (Kohl, 2020), The Philosophical Review (Vilhauer, 2022), Kant-Studien (Guyer, 2022). SEP: listed in the kant entry bibliography. YEAR NOTE: CrossRef gives online publication 2019-12-19 and print publication 2020-01-16; dated by print year.},
    keywords = {kant, pp-ethics, precritical, debate-other-freedom, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {The title of this hefty book might easily mislead. The book is in effect a detailed survey of Kant's entire philosophy, including even manyReflexionenfrom Kant'sNachlass, as seen from the standpoint of one of its leading scholars of the past half century. It encompasses the development of Kant's philosophy fromUniversal Natural History and Theory of the Heavens(1755) all the way toReligion within the Boundaries of Mere Reason(1793-94) and evenMetaphysics of Morals(1798). The book's ten chapters divide evenly between Kant's writings before theCritique of Pure Reason(1781) and his writings after that. It is sometimes evident that Henry E. Allison is reading the early writings as preparatory to his interpretation of the works for which Kant is much better known. But since Allison himself thinks Kant's mature views about freedom developed relatively late, and that the crucial turn came only between 1785 and 1788, it is hard to resist the conclusion that in the first 230 pages or so Allison is coming to terms with Kant's early writings more as an end in itself rather than a means to understanding Kant's later philosophy.
    abstract_source = {ndpr},

How can one review such a book? Many ostensible book reviews are really discussions of the topic of the book by someone other than the book's author. Such reviews are sometimes interesting and informative, even if they are mainly a display of the reviewer's thoughts. But I have always thought that the first duty of a review is to inform its readers about the contents of the book. Criticisms are valuable, if informed and economically argued, because you can learn something about a book's contents by seeing how they might be challenged. I have for many years agreed with much in Allison's reading of Kant but also disagreed with a fair amount of it. Below I will criticize his views, mainly those in the second half of the book, hoping that even my criticisms will inform more than merely judge.

Chapter 1 deals with writings produced between 1755 and 1759. The first of these isUniversal Natural History, now best known because it proposed the nebular hypothesis of the origin of the solar system, and explained its origin and motions in generally Newtonian terms but, unlike Newton, without any appeal to divine design. Like this work itself, Allison's discussion says nothing explicitly about free will. It focuses on the place of rational beings, and especially human beings on earth, in Kant's highly speculative cosmology. There follows a fairly detailed discussion of Kant's first treatise on metaphysics, the Latin essay whose short title isNova dilucidatio(1755). Allison discusses Kant's treatment of the relation of logic to metaphysics, the first version of his so-called "possibility" proof for God's existence, and then his critical discussion of the views of Wolff and Crusius on freedom of the will. We get Allison's fairly detailed expositions of their positions as well as Kant's reactions to them. In a short dialogue, which was part ofNova dilucidatio, Kant portrays a Wolffian compatibilist named Caius defeating a Crusian incompatibilist named Titus. Chapter 1 ends with Allison's discussion of Kant's essay on optimism (1755) and severalReflexionenon this subject from the late 1750s.

Chapter 2 deals with Kant's metaphysical views in the early 1760s, including hisPrize Essay(published 1764), the essay onNegative Magnitudes(1764) and theOnly Possible Ground of Proof for a Demonstration of God's Existence(1763). ThePrize Essaycontains a methodological attack on the synthetic method in metaphysics practiced by the Wolffians. Kant's introduction of the concept of negative magnitudes and the distinction between logical and real possibility represents a development that came to fruition in theBeweisgrundessay, of which Allison gives us an admirably detailed and critical 17-page discussion. He points out the ways this essay still adheres, in its treatment of the divine will, to Wolffian compatibilism in contrast to Crusius' defense of the liberty of indifference. The chapter ends with a discussion of Baumgarten's views on freedom of the will and Kant's treatment of them in his metaphysics lectures of 1764. Kant here defends the idea that true freedom and virtue consists in a harmony between reason and sensible desire rather than the Stoic disparagement of the sensual.

Chapter 3 turns attention to Kant's moral philosophy in the same period. In thePrize Essay, Kant was drawn to the moral sense theory of Hutcheson. Allison here expounds Hutcheson, and the version of Hutcheson to which Kant was attracted, as a form of metaethical 'non-cognitivism'. This offers us a now familiar reading of philosophers like Hutcheson and Hume, but I can't resist the temptation to interject that it seems to me an anachronistic way to read Scottish moral sense theory which does these philosophers no favors. Allison perceptively notes, however, that Kant was never fully committed to Hutcheson's views. He resisted them from the start on the ground that they provide no satisfactory account of the notion of obligation, which Kant, along with Baumgarten, regarded as the fundamental concept needed in moral philosophy. Allison proceeds to an informative discussion of Kant's lectures on ethics of 1765-66, which includes some detailed exposition of both Hutcheson and Baumgarten as well as Kant's critical reflections on them. The chapter concludes with an account of the moral philosophy contained in his published treatiseObservations on the Beautiful and Sublime(1766). Allison observes here "it is easy to see that his position is an unstable halfway-house" which again can offer no satisfactory account of obligation because feeling "lacks the requisite normative force" (121).

In Chapter 4 Allison addresses Kant's encounter with the works of Rousseau in the late 1760s and the radical change in his moral philosophy it produced. It begins with a discussion of Kant's (unpublished)Remarks on the Beautiful and Sublime.There is a 30-page exposition and discussion of Rousseau's views on freedom inÉmile, and on free will in "Confession of Faith by A Savoyard Vicar" in that work, and of Kant's reactions to them in theRemarks. There is a shorter section onDreams of a Spirit Seer(1766). Allison admits that this work has little to say directly about free will, but he argues that we can discern by implication that Rousseau had an impact on this work too. Given how enigmatic theDreamsis, a reader (or at least this one) remains skeptical about this. But the upshot of this chapter, which is convincing, is Allison's argument that it is during this period that Kant breaks with Wolffian compatibilism. Allison traces to Rousseau the central Kantian ideas that freedom of the will is closely bound up both with self-consciousness and moral virtue as self-mastery.

Chapter 5 is devoted to the 1770s, which Allison, using the common phrase for it, calls the "Silent Decade," in which Kant published very little. It begins with Kant's remark that 1769 gave him "great light." Allison understands this as Kant's coming to reject the Leibnizian and Wolffian view that sense and understanding differ only in degree of clarity, replacing it with the now familiar Kantian idea that they are separate faculties that must co-operate in all thought and cognition. This soon led Kant to the distinction between a sensible and an intelligible world -- or better put, to conceiving of the world as both sensible and intelligible. Allison thus understands this distinction (correctly in my view) as conceptual rather than metaphysical. It does not designate two different realms of objects (one of which is claimed to exist but to be mysteriously beyond our ken) but rather distinguishes between the faculty that intuits and the faculty that thinks. Allison provides a relatively brief discussion of Kant's 1770 Inaugural Dissertation. This is followed by a roughly 40-page discussion ofReflexionenon freedom from the 1770s and a 10-page discussion of the Collins lectures on moral philosophy dating from the late 1770s. It is difficult to summarize this chapter because it consists largely of a series of remarks about a series of short reflections. However, toward the end of the chapter, Allison summarizes the result by saying that "by the end of the 'Silent Decade' Kant had arrived at the view that both the theoretical and the practical use of reason required an appeal to at least the conception of freedom in the transcendental sense" -- that is, freedom as a capacity to cause a state or series of statesvon selbst,and not grounded on a prior natural cause. This, Allison concludes, "was also essentially the view that he held in the first Critique" (233).

Chapter 6 finally brings us to that work, and it begins Allison's discussion of the views on freedom for which Kant is best known. We are given a 15-page exposition of the Third Antinomy, followed by an account of how Allison thinks the problem of freedom relates to transcendental idealism. Then Allison attempts to define the problem of freedom as Kant saw it in the first Critique, followed by a sketch (Schattenriss) of Kant's solution. I agree with much of what Allison says here, in particular with his claims that "by things in themselves Kant understands things considered in abstraction from the temporal relations in which they stand" (254) and that Kant's account "neither claims that there are any putatively intelligible causes nor, if there were, how they are to be conceived." (265). He acknowledges that the term "transcendental cause" "seems to suggest a mysterious noumenal power;" and I think Allison is right to suggest that the term should be taken to refer to a "transcendentalconceptof a cause rather than, as usually assumed, a metaphysically distinct noumenal entity" (280). I am not in full agreement with everything Allison says here, but I do agree with his conclusion that Kant's aim is to establish no more than the logical compatibility of freedom and natural determinism.},
}

@book{kraus2020selfknowledge,
    author = {Kraus, Katharina T.},
    title = {Kant on Self-Knowledge and Self-Formation: The Nature of Inner Experience},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108874304},
    note = {SUMMARY: Develops Kant's account of psychological personhood by analysing empirical self-knowledge, the knowledge one has of oneself as a unique psychological person, through the capacity for inner experience. It defends the thesis that inner experience is empirical cognition of oneself not as a mere object but as a psychological person, and (per the NDPR review) that self-cognition depends on the cooperation of sensibility, understanding and reason, with the regulative idea of the soul filling the gap between self-reference in thought and the deliverances of inner sense (publisher abstract and NDPR review). SUBFIELD AND DEBATE: Theoretical philosophy and mind: inner sense, apperception and self-affection, and the link between self-knowledge and self-formation; follows the same author's 2019 Kantian Review article on parity and disparity between inner and outer experience. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 47 and S2 citations 58 (2026-09-30). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kant-on-self-knowledge-and-self-formation-the-nature-of-inner-experience). Other reviews: European Journal of Philosophy (Kitcher, 2021), The Philosophical Review (Longuenesse, 2022), Journal of the History of Philosophy (Buchenau, 2022), Archiv fuer Geschichte der Philosophie (Liang, 2023), Kant-Studien (Erkan, 2023); Kantian Review symposium (2022).},
    keywords = {kant, tp-mind, debate-other-inner-sense, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {As the pre-eminent Enlightenment philosopher, Immanuel Kant is famous for emphasizing that each and every one of us is called to “make use of one’s own understanding without direction from another” (Enlightenment 8:35).We are all called to make up our own minds, independently from the external constraints imposed on us by others. In the face of this Enlightenment calling, much of Kant’s philosophy, then, reads as a manual for how to employ one’s mental faculties in the proper way – faculties that are supposed to be universally realized by all human beings. Given his focus on a universal conception of the human mind, Kant tells us surprisingly little about what makes us the unique individual persons we are and how we come to know ourselves as such. This book explores Kant’s distinctive account of psychological personhood by unfolding, in accordance with the tenets of his Critical Philosophy, his account of empirical self-knowledge as the knowledge that one has of oneself as a unique psychological person. A central role is played by the capacity to judge one’s own psychological features, that is, the capacity for what Kant calls inner experience. Primarily, inner experience concerns a person’s conscious mental states, such as occurrent sensory perceptions, thoughts, memories, imaginations, feelings, and desires. Moreover, inner experience also concerns general psychological properties such as personality traits and character dispositions, standing attitudes, commitments, and values. Although inner experience has been neglected in the contemporary literature on Kant, I argue that, for Kant, it is a primary means by which persons not only gain knowledge of a range of psychological phenomena that make up their mental lives, but also determine who they are. So in this book I defend two central theses. First, for Kant, inner experience is empirical cognition of oneself, not as amere object, but as a psychological person. On my reading, Kant conceives of inner},
    abstract_source = {s2},
}

@book{deboer2020reform,
    author = {de Boer, Karin},
    title = {Kant's Reform of Metaphysics: The Critique of Pure Reason Reconsidered},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108897983},
    note = {SUMMARY: Interprets the Critique of Pure Reason in view of Kant's efforts to turn Christian Wolff's metaphysics into a science, rather than primarily through epistemological questions. Situates the Critique in eighteenth-century German philosophy, traces the development of Kant's conception of critique, analyses the Transcendental Deduction, the Schematism, the Appendix to the Transcendental Analytic and the Architectonic, and reconstructs the outline of the system of pure reason that the Critique was to prepare (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: metaphysical rather than epistemological reading of the first Critique; Kant and the Wolffian school. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 40 and S2 citations 36 (2026-09-30). Publisher: Cambridge University Press. Review found: Studia Kantiana (Garcia, 2023). NDPR review: not found.},
    keywords = {kant, tp-cpr, debate-other-metaphysics, type-monograph, Medium, summary-source-abstract},
    abstract = {Scholarly debates on the Critique of Pure Reason have largely been shaped by epistemological questions. Challenging this prevailing trend, Kant's Reform of Metaphysics is the first book-length study to interpret Kant's Critique in view of his efforts to turn Christian Wolff's highly influential metaphysics into a science. Karin de Boer situates Kant's pivotal work in the context of eighteenth-century German philosophy, traces the development of Kant's conception of critique, and offers fresh and in-depth analyses of key parts of the Critique of Pure Reason, including the Transcendental Deduction, the Schematism Chapter, the Appendix to the Transcendental Analytic, and the Architectonic. The book not only brings out the coherence of Kant's project, but also reconstructs the outline of the 'system of pure reason' for which the Critique was to pave the way, but that never saw the light.},
    abstract_source = {openalex},
}

@book{moller2020tribunal,
    author = {Møller, Sofie},
    title = {Kant's Tribunal of Reason: Legal Metaphor and Normativity in the Critique of Pure Reason},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108682480},
    note = {SUMMARY: Gives a book-length study of the legal metaphors in the Critique of Pure Reason. It argues that these metaphors are central to Kant's account of reason: reason has a structure mirroring a legal system in a natural-right framework, Kant aims to make cognisers resemble authorised judges by proving the legitimacy of laws and the conditions of valid judgment, and reason's systematicity is legal systematicity (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy: the normativity of reason, the Transcendental Deduction as a legal deduction, and Kant's method and metaphors. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 18 and S2 citations 17 (2026-09-30). Publisher: Cambridge University Press. Reviews found: Kantian Review (Moran, 2021), SATS (Nielsen, 2022), Philosophy in Review (Anderson, 2023). SEP: listed in the kant-reason bibliography. NDPR review: not found.},
    keywords = {kant, tp-cpr, debate-other-normativity, type-monograph, Medium, summary-source-abstract},
    abstract = {Kant's Critique of Pure Reason, his main work of theoretical philosophy, frequently uses metaphors from law. In this first book-length study in English of Kant's legal metaphors and their role in the first Critique, Sofie Møller shows that they are central to Kant's account of reason. Through an analysis of the legal metaphors in their entirety, she demonstrates that Kant conceives of reason as having a structure mirroring that of a legal system in a natural right framework. Her study shows that Kant's aim is to make cognisers become similar to authorized judges within such a system, by proving the legitimacy of the laws and the conditions under which valid judgments can be pronounced. These elements consolidate her conclusion that reason's systematicity is legal systematicity.},
    abstract_source = {openalex},
}

@book{posyrechter2020mathematics,
    editor = {Posy, Carl and Rechter, Ofra},
    title = {Kant's Philosophy of Mathematics: Volume 1, The Critical Philosophy and Its Roots},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781107337596},
    note = {SUMMARY: Collects essays by leading authors surveying contemporary scholarship on Kant's mathematical thinking: geometry, arithmetic, logic and metaphysics, with attention to the development of his philosophy of mathematics, its place in the critical philosophy, its historical background, and the Kantian themes that influenced later mathematics and its philosophy (publisher description, retrieved from the Tel Aviv University research portal). A web search result states that the volume has twelve essays, from the pre-critical origins of Kant's philosophy of mathematics to his thoughts on mathematical method, logic, geometry and arithmetic. SUBFIELD AND DEBATE: Philosophy of mathematics and logic within theoretical philosophy: construction in intuition, geometry and arithmetic, and Kant's pre-critical mathematical context. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 2 (2026-09-30); no volume-level S2 citation count (the DOI-matched S2 record carries an unrelated abstract and 0 citations). Publisher: Cambridge University Press. SEP: essays from the volume appear 16 times in the kant-mathematics bibliography. Reviews found: Kantian Review (web search result), Philosophia Mathematica (2021, CrossRef 10.1093/philmat/nkaa037), and a 2020 review by Martinez (CrossRef 10.7203/rek.5.2.18275). NDPR review: not found. The abstract attached to the DOI in S2 and get_abstract is unreliable for this volume and was not used.},
    keywords = {kant, tp-science-math, type-edited-volume, Medium, summary-source-publisher},
    abstract = {Kant’s 1 philosophy of mathematics plays a crucial role in his critical philosophy, and a clear understanding of his notion of mathematical construction would do much to elucidate his general epistemology. Friedman M. in Shabel L. insists that Kant’s philosophical achievement consists precisely in the depth and acuity of his insight into the state of the mathematical exact sciences as he found them, and, although these sciences have radically changed in ways, this circumstance in no way diminishes Kant’s achievements. Friedman M 2 further indicates that the highly motivation to uncover Kant’s philosophy of mathematics comes from the fact that Kant was deeply immersed in the textbook mathematics of the eighteenth century. Since Kant’s philosophy of mathematics 3 was developed relative to a specific body of mathematical practice quite distinct from that which currently obtains, our reading of Kant must not ignore the dissonance between the ontology and methodology of eighteenthand twentieth-century mathematics. The description of Kant’s philosophy},
    abstract_source = {s2},
}

@book{wood2020religion,
    author = {Wood, Allen},
    title = {Kant and Religion},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108381512},
    note = {SUMMARY: Offers an interpretation of Kant's Religion within the Boundaries of Mere Reason that explores his treatment of the idea of God, his views on evil, and the moral grounds for faith in God. It places religion's meaning within the history of human culture and ties Kant's stance on religion to his theoretical, moral, political and religious positions (publisher abstract). SUBFIELD AND DEBATE: Religion: Kant's philosophy of religion, radical evil and moral faith; engages readings of the Religion as a work of rational theology and moral philosophy. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 47 and S2 citations 43 (2026-09-30). Publisher: Cambridge University Press. Reviews found: Philosophy in Review (Anderson, 2021), Kantian Review (Pasternack, 2021), Kant-Studien (Toennissen, 2022), Faith and Philosophy (Godlove, 2023); Kantian Review roundtable (2022). SEP: listed in the kant-religion bibliography. NDPR review: not found.},
    keywords = {kant, religion, debate-other-religion, type-monograph, High, summary-source-abstract},
    abstract = {This masterful work on Kant's Religion within the Boundaries of Mere Reason explores Kant's treatment of the Idea of God, his views concerning evil, and the moral grounds for faith in God. Kant and Religion works to deepen our understanding of religion's place and meaning within the history of human culture, touching on Kant's philosophical stance regarding theoretical, moral, political, and religious matters. Wood's breadth of knowledge of Kant's corpus, philosophical sharpness, and depth of reflection sheds light not only on Kant, but also on the fate of religion and its relation to philosophy in the modern world.},
    abstract_source = {openalex},
}

@book{varden2020sex,
    author = {Varden, Helga},
    title = {Sex, Love, and Gender: A Kantian Theory},
    publisher = {Oxford University Press},
    year = {2020},
    doi = {10.1093/oso/9780198812838.001.0001},
    note = {SUMMARY: Presents a comprehensive account of sex, love and gender built on Kant. It gives an interpretation on which Kant's scattered remarks in his ethics, legal-political thought, aesthetics, teleology, history, religion and anthropology form one coherent approach, then rehabilitates the theory by correcting Kant's own errors and limitations, and applies it to sexual orientation, abortion, gender identity, marriage, erotica, sexual oppression and trade in sexual services (publisher abstract). SUBFIELD AND DEBATE: Metaphysics of Morals, Doctrine of Right and Doctrine of Virtue, and Kant on gender and sex: a Kantian-inspired constructive theory that disputes readings on which Kant's sexual ethics cannot be reconciled with his account of rights and freedom. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 61 and S2 citations 22 (2026-09-30; S2 book-level counts are incomplete). Publisher: Oxford University Press. Reviews found: Kantian Review (Sabourin, 2021), Mind (Fahmy, 2023); critical dialogue in Estudos Kantianos (2023). SEP: listed in the kant-social-political bibliography. NDPR review: not found.},
    keywords = {kant, pp-mm-virtue, pp-right-politics, debate-gender, type-monograph, High, summary-source-abstract},
    sep_context = {SEP entry kant-social-political (Kant's Social and Political Philosophy), section 5 Property and Contract Right, cites Varden 2020 among attempts to sift Kant's claims about women so as to identify what is philosophically valuable and what illuminates problematic aspects of his position (with Herman 1993, Wilson 1998 and Hay 2013).},
    abstract = {This book provides a comprehensive account of sex, love, and gender—the first of its kind—by engaging a seemingly unlikely ally: Immanuel Kant. To date, no scholar has considered Kant’s potential contributions to such an account; nor is this surprising. Kant explicitly views sexual activity as inherently morally problematic, maintaining as ethically permissible only heterosexual procreative sexual activity within the confines of legal marriage. Kant’s comments on sex, love, and gender are also diffused throughout his practical works—from his works on ethics and legal-political thought, to his works on aesthetics, teleology, history, religion, and anthropology—presenting a textual and philosophical obstacle to reconciling his accounts of human nature and of human rights and freedom into an integrated whole. Sex, Love, and Gender—A Kantian Theory takes on these challenges. It offers an innovative interpretation of Kant’s account of sex, love, and gender, which shows how his disparate references can be seen as parts of one coherent philosophical approach. The book also rehabilitates Kant’s theory by overcoming the philosophical mistakes and limitations of Kant’s own writings. The result is a philosophical understanding of the phenomenology of sex, love, and gender and core related moral (ethical and legal) issues such as sexual orientation, abortion, sexual or gender identity, marriage, erotica, sexual oppression, and trade in sexual services.},
    abstract_source = {s2},
}

@book{allaiscallanan2020animals,
    editor = {Callanan, John J. and Allais, Lucy},
    title = {Kant and Animals},
    publisher = {Oxford University Press},
    year = {2020},
    doi = {10.1093/oso/9780198859918.001.0001},
    note = {SUMMARY: Edited collection on the role of animals in Kant's philosophy across theoretical and practical philosophy. It covers Kant's model of animal minds, whether his philosophy of mind allows animals intentional representations of spatiotemporal objects, animal nature in humans and non-humans, how his scientific theory accommodated animals, and whether Kantian moral theory gives the right account of the moral status of animals, which Kant denied direct obligations to (publisher abstract). SUBFIELD AND DEBATE: Anthropology and philosophy of mind, practical philosophy: Kant and animals, including the nonconceptualism and conceptualism debate as applied to animal representation and the indirect-duties view of animal ethics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 10 and S2 citations 5 (2026-09-30; volume-level counts). Publisher: Oxford University Press. Reviews found: Journal of the History of Philosophy (Steiner, 2021), Philosophiques (Simoneau-Gilbert, 2021), Kant-Studien (Mueller, 2023). SEP: chapters listed in the kant-conceptualism bibliography. NDPR review: not found.},
    keywords = {kant, anthro-hist-edu, pp-ethics, tp-mind, debate-animals, type-edited-volume, High, summary-source-abstract},
    abstract = {Abstract This is an edited collection devoted to the topic of the role of animals within Kant’s philosophy. It addresses key issues within both his theoretical and practical philosophy. It examines the place of Kant’s model of animal minds in the historical and contemporary contexts. It addresses the question of whether Kant’s philosophy of mind allows for animals to be capable of intentional representations of spatiotemporal objects. It explores how Kant treated the issue of animal nature as it manifests in humans and non-humans alike, and questions how Kant’s scientific theory attempted to accommodate animals within his broader Enlightenment worldview. It also addresses traditional worries about the moral status of animals within Kant’s and Kantian moral theory. Kant notoriously denied that we have direct obligations to animals, and the question persists as to whether Kantian moral theory provides the right account of the moral status of non-human animals. Several papers in this collection address the question and whether Kant’s views can be defended or ought to be rejected altogether on this basis alone. The collection considers the relevance of Kantian theory for our understanding of contemporary challenges facing human beings with regard to our relationship to animals.},
    abstract_source = {openalex},
}

@article{cohen2020emotions,
    author = {Cohen, Alix},
    title = {A Kantian Account of Emotions as Feelings},
    journal = {Mind},
    year = {2020},
    volume = {129},
    number = {514},
    pages = {429--460},
    url = {https://doi.org/10.1093/mind/fzz018},
    note = {SUMMARY: Extracts from Kant's writings an account of the emotions, although Kant neither uses the term nor treats them systematically. It reads Kant as defining emotions first and foremost as feelings, which are non-cognitive states with a derived intentionality, and argues that the faculty of feeling makes us aware of how our faculties relate to each other and to the world, so that feelings are affective appraisals of our agency with an orientational function (journal abstract). SUBFIELD AND DEBATE: Mind and moral psychology: Kant on feeling, desire and cognition, and the philosophy of emotion; challenges contemporary views that define emotions through other mental states. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 28 and S2 citations 26 (2026-09-30). Venue: Mind 129(514). Reply: Merritt, Feeling and Orientation in Action: A Reply to Alix Cohen, Kantian Review (2021). YEAR NOTE: CrossRef gives online publication 2019-04-22 and print issue April 2020 (Mind 129(514)); dated by print year.},
    keywords = {kant, tp-mind, pp-ethics, debate-other-emotion, type-article, Medium, summary-source-abstract, INCOMPLETE, no-abstract},
}

@article{kleingeld2020meremeans,
    author = {Kleingeld, Pauline},
    title = {How to Use Someone ‘Merely as a Means’},
    journal = {Kantian Review},
    year = {2020},
    volume = {25},
    number = {3},
    pages = {389--414},
    doi = {10.1017/s1369415420000229},
    note = {SUMMARY: Re-examines Kant's texts to develop a new account of the conditions under which someone is used merely as a means, a prohibition in Kant's moral theory widely thought impossible to specify precisely. It argues that the account has textual support and philosophical advantages over alternative conceptions (journal abstract). SUBFIELD AND DEBATE: Ethics: the Formula of Humanity and the prohibition on using persons merely as means; contributes to the debate over how to specify the prohibition. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 38 and S2 citations 32 (2026-09-30). Venue: Kantian Review 25(3). SEP: listed in the persons-means bibliography.},
    keywords = {kant, pp-ethics, debate-other-humanity-formula, type-article, Medium, summary-source-abstract},
    abstract = {Abstract The prohibition on using others ‘merely as means’ is one of the best-known and most influential elements of Immanuel Kant’s moral theory. But it is widely regarded as impossible to specify with precision the conditions under which this prohibition is violated. On the basis of a re-examination of Kant’s texts, the article develops a novel account of the conditions for using someone ‘merely as a means’. It is argued that this account has not only strong textual support but also significant philosophical advantages over alternative conceptions.},
    abstract_source = {s2},
}

@article{basevich2020race,
    author = {Basevich, Elvira},
    title = {Reckoning With Kant on Race},
    journal = {The Philosophical Forum},
    year = {2020},
    volume = {51},
    number = {3},
    pages = {221--245},
    doi = {10.1111/phil.12263},
    note = {SUMMARY: Develops Kant's theory of reform into a theory of racial justice reform. It reads Kant's philosophy of race as part of his nonideal theory of justice, a racist pragmatic anthropology that assumes some racial groups failed to develop their innate capacity for legislative reason, and argues for an alternative Kantian nonideal theory that extends Kant's model of public reason, including an ideal of interracial civic fellowship (journal abstract). SUBFIELD AND DEBATE: Race and political philosophy: Kant's racism and its place in his system, and whether Kantian public reason can be used for racial justice; in the Kant and race debate it combines a critique of Kant's anthropology with a constructive nonideal theory. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 18 and S2 citations 18 (2026-09-30). Venue: The Philosophical Forum 51(3). SEP: listed in the critical-phil-race bibliography. YEAR NOTE: CrossRef gives online publication 2020-08-06 and print issue September 2020.},
    keywords = {kant, anthro-hist-edu, pp-right-politics, debate-race, type-article, Medium, summary-source-abstract},
    abstract = {This essay develops Kant’s theory of reform to theorize racial justice reform. I assess the function of Kant’s philosophy of race as part of his nonideal theory of justice, which offers a racist pragmatic anthropology that uses the concept of race to determine the practical effectiveness of legislative reason. His philosophy of race defends a teleological account of the natural history of the human species to fulfill the requirements of justice and assumes that certain racial groups have failed to develop their innate capacity for legislative reason. I show that we need an alternative Kantian nonideal theory of justice that demonstrates how legislative reason actualizes practical freedom. Rather than appeal to anthropology, I expand Kant’s model of public reason to advance racial justice reform under the conditions of partial compliance to the requirements of justice in a profoundly nonideal republic such as the U.S. I then showcase the promise—and limits—of the a priori ideals of citizenship and publicity for racial justice reform and introduce the new ideal of interracial civic fellowship to guide the public use of reason in nonideal circumstances.},
    abstract_source = {s2},
}

@book{loriaux2020distributive,
    author = {Loriaux, Sylvie},
    title = {Kant and Global Distributive Justice},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108678834},
    note = {SUMMARY: Argues that although Kant's political thought does not address global poverty and inequality directly, it supplies conceptual and normative resources for global socioeconomic duties. It develops the Kantian duty to enter a rightful condition beyond the state, derives a duty of right to assist states unable to fulfil core state functions, and draws implications for just transnational trade and immigration regulation (publisher abstract; the abstract calls the work an Element). SUBFIELD AND DEBATE: Political, legal and cosmopolitan philosophy: Kant on international and global justice, the duty to enter a rightful condition and cosmopolitan right. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 23 and S2 citations 9 (2026-09-30). Publisher: Cambridge University Press. Review found: Kantian Review (Vaha, 2021). NDPR review: not found.},
    keywords = {kant, pp-right-politics, debate-other-global-justice, type-monograph, Low, summary-source-abstract},
    abstract = {This Element argues that although Kant's political thought does not tackle issues of global poverty and inequality head on, it nonetheless offers important conceptual and normative resources to think of our global socioeconomic duties. It delves into the Kantian duty to enter a rightful condition beyond the state and shows that a proper understanding of this duty not only leads us to acknowledge a duty of right to assist states that are unable to fulfil the core functions of a state, but also provides valuable hints at what just transnational trade relations and a just regulation of immigration should look like.},
    abstract_source = {openalex},
}

@article{halper2020artnature,
    author = {Halper, Aaron},
    title = {Rethinking Kant's distinction between the beauty of art and the beauty of nature},
    journal = {European Journal of Philosophy},
    year = {2020},
    volume = {28},
    number = {4},
    pages = {857--875},
    doi = {10.1111/ejop.12524},
    note = {SUMMARY: Argues that Kant presents two different accounts of beauty, one applying properly to art and one to nature. The judgment of beauty proper to nature can be free and made without concepts, whereas a work of art is judged beautiful when it expresses aesthetic ideas, a distinction used to explain problematic passages in Kant's text, including cases where the conception of artistic beauty is applied to natural objects (journal abstract). SUBFIELD AND DEBATE: Aesthetics: free and adherent beauty, aesthetic ideas and the art-nature distinction in the Critique of the Power of Judgment. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 15 and S2 citations 11 (2026-09-30). Venue: European Journal of Philosophy 28(4). SEP: listed in the kant-aesthetics bibliography. YEAR NOTE: CrossRef gives online publication 2020-02-11 and print issue December 2020.},
    keywords = {kant, aes-teleo, debate-other-beauty, type-article, Low, summary-source-abstract},
    abstract = {Abstract This paper argues that Kant presents two different accounts of beauty, one that applies properly to art and one that applies properly to nature. The judgment of beauty that applies properly to nature can be free and thus judged without concepts. The work of art, however, is judged beautiful when it expresses aesthetic ideas. This distinction then enables me to explain several problematic passages in Kant's text: those that serve to distinguish these two conceptions of beauty from one another as well as those passages in which Kant views them as overlapping. With respect to the latter, I argue that Kant lays especial significance on cases where we apply the conception of artistic beauty to natural objects, as in doing so we view nature as expressing ideas that step beyond nature.},
    abstract_source = {openalex},
}

@article{biagioli2020cassirer,
    author = {Biagioli, Francesca},
    title = {Ernst Cassirer's transcendental account of mathematical reasoning},
    journal = {Studies in History and Philosophy of Science Part A},
    year = {2020},
    volume = {79},
    pages = {30--40},
    doi = {10.1016/j.shpsa.2019.10.001},
    note = {SUMMARY: Examines how Cassirer tried to reconcile the Kantian explanation of the possibility of knowledge with nineteenth and early twentieth-century conceptual changes in science, in his philosophy of mathematics. It argues that Cassirer addressed the applicability of abstract mathematical concepts to empirical reality by a transcendental account of mathematical reasoning on which the formation of mathematical concepts explains the extensibility of mathematical knowledge, placing him within the Marburg neo-Kantian debate of 1902-1910 (journal abstract). SUBFIELD AND DEBATE: Neo-Kantian reception and philosophy of mathematics: Marburg neo-Kantianism and the transformation of Kant's transcendental method in response to modern mathematics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 12 and S2 citations 15 (2026-09-30). Venue: Studies in History and Philosophy of Science Part A 79. YEAR NOTE: CrossRef gives print issue February 2020 and no separate online date.},
    keywords = {kant, recep-neokantian, tp-science-math, type-article, Low, summary-source-abstract},
    abstract = {Cassirer's philosophical agenda revolved around what appears to be a paradoxical goal, that is, to reconcile the Kantian explanation of the possibility of knowledge with the conceptual changes of nineteenth and early twentieth-century science. This paper offers a new discussion of one way in which this paradox manifests itself in Cassirer's philosophy of mathematics. Cassirer articulated a unitary perspective on mathematics as an investigation of structures independently of the nature of individual objects making up those structures. However, this posed the problem of how to account for the applicability of abstract mathematical concepts to empirical reality. My suggestion is that Cassirer was able to address this problem by giving a transcendental account of mathematical reasoning, according to which the very formation of mathematical concepts provides an explanation of the extensibility of mathematical knowledge. In order to spell out what this argument entails, the first part of the paper considers how Cassirer positioned himself within the Marburg neo-Kantian debate over intellectual and sensible conditions of knowledge in 1902-1910. The second part compares what Cassirer says about mathematics in 1910 with some relevant examples of how structural procedures developed in nineteenth-century mathematics.},
    abstract_source = {s2},
}

@book{vanmazijk2020perception,
    author = {van Mazijk, Corijn},
    title = {Perception and Reality in Kant, Husserl, and McDowell},
    publisher = {Routledge},
    year = {2020},
    doi = {10.4324/9781003010227},
    note = {SUMMARY: Critically engages with John McDowell's conceptualist account of how perception gives access to external reality by comparing his views on perception and reality with those of Kant and Husserl. Across six chapters it examines the three thinkers' theories of perception within their broader views of mind and reality and yields a critique of McDowell's conceptualism, combining analytic philosophy, Kantian philosophy and phenomenology (publisher abstract). SUBFIELD AND DEBATE: Reception (phenomenology and analytic philosophy) and philosophy of mind: Kant's theory of perception in the conceptualism and nonconceptualism debate as read through Husserl and McDowell. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 19 and S2 citations 18 (2026-09-30). Publisher: Routledge. Reviews found: Phenomenological Reviews (Cheng; Guilhermino, 2020), Husserl Studies (Doyon, 2021), Continental Philosophy Review (Laasik, 2022). NDPR review: not found. YEAR NOTE: CrossRef gives only an online publication date (2020-02-05).},
    keywords = {kant, recep-phenom, recep-analytic, tp-mind, debate-conceptualism, type-monograph, Medium, summary-source-abstract},
    abstract = {How does perception give us access to external reality? This book critically engages with John McDowell’s conceptualist answer to this question, by offering a new exploration of his views on perception and reality in relation to those of Immanuel Kant and Edmund Husserl. In six chapters, the book examines these thinkers’ respective theories of perception, lucidly describing how they fit within their larger philosophical views on mind and reality. It thereby not only reveals the continuity of a tradition that underlies today’s fragmented scholarly landscape, but also yields a new critique of McDowell’s conceptualist theory. In doing so, the book contributes to the ongoing bridging of traditions, by combining analytic philosophy, Kantian philosophy, and phenomenology. Perception and Reality in Kant, Husserl, and McDowell will appeal to scholars and students working in the history of philosophy, phenomenology, Kantian philosophy, and in particular the philosophy of perception.},
    abstract_source = {openalex},
}

@book{jauernig2021world,
    author = {Jauernig, Anja},
    title = {The World According to Kant: Appearances and Things in Themselves in Critical Idealism},
    publisher = {Oxford University Press},
    year = {2021},
    doi = {10.1093/oso/9780199695386.001.0001},
    note = {SUMMARY: Interprets Kant's critical idealism as an ontological position comprising transcendental idealism, empirical realism and further basic ontological theses. On the proposed reading the world has a transcendental level of mind-independent things in themselves and an empirical level of mind-dependent appearances, which are intentional objects of experience that nonetheless genuinely exist because they are grounded in things in themselves; Kant is thus both a genuine idealist and a genuine realist about empirical objects, minds, space and time (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: the two-world versus two-aspect debate on appearances and things in themselves; the book also distinguishes critical idealism from Berkeleyan idealism and relates Kant's things in themselves to those of his Leibniz-Wolffian predecessors. SIGNIFICANCE INDICATORS: S2 citations 17 (title-matched record, 2026-09-30); CrossRef is-referenced-by-count 36. Publisher: Oxford University Press. NDPR review: not found. Reviews found: Archiv fuer Geschichte der Philosophie (Erkan, 2021), Phenomenological Reviews (Blezy, 2021), The Philosophical Review (Kohl, 2022), The Philosophical Quarterly (Gordon, 2023), Journal of the History of Philosophy (Kitcher, 2023), Kant-Studien (Onof, 2023). SEP: listed in the kant-transcendental bibliography.},
    keywords = {kant, tp-cpr, debate-two-aspect, type-monograph, High, summary-source-abstract},
    sep_context = {SEP entry kant-transcendental (Kant's Transcendental Arguments), section on the second step of the B-Deduction, cites Jauernig 2021 (with Pereboom 1988 and Stang 2018) for the claim that on Kant's type of idealism a mismatch between our representation of space and space itself remains possible.},
    iep_context = {IEP entry kant-transcendental-idealism cites Jauernig 2021 five times: among newer interpretations that treat appearances as intentional objects or mental states, in the section on one- versus two-world interpretations (see especially Jauernig 2021, Stang 2014), on the affection dilemma and things in themselves (Jauernig 2021: 310-312), and on antinomial conflict and the indirect argument for idealism (Jauernig 2021: 348-353).},
    abstract = {Abstract The World According to Kant offers an interpretation of Immanuel Kant’s critical idealism, as developed in the Critique of Pure Reason and associated texts. Critical idealism is understood as an ontological position, which comprises transcendental idealism, empirical realism, and a number of other basic ontological theses. According to Kant, the world, understood as the sum total of everything that has reality, comprises several levels of reality, most importantly, the transcendental level and the empirical level. The transcendental level is a mind-independent level at which things in themselves exist. The empirical level is a fully mind-dependent level at which appearances exist, which are intentional objects of experience. Empirical objects and empirical minds are appearances, and empirical space and time are constituted by the spatial and temporal determinations of appearances. On the proposed interpretation, Kant is thus a genuine idealist about empirical objects, empirical minds, and space and time. But in contrast to other intentional objects, appearances genuinely exist, which is due both to the special character of experience compared to other kinds of representations such as illusions and dreams, and to the grounding of appearances in things themselves. This is why, on the proposed interpretation, Kant is also a genuine realist about empirical objects, empirical minds, and empirical space and time. This book develops the indicated interpretation, spells out Kant’s case for critical idealism thus understood, pinpoints the differences between critical idealism and ‘ordinary’ idealism, such as Berkley’s, and clarifies the relation between Kant’s conception of things in themselves and the conception of things in themselves by other philosophers, in particular, Kant’s Leibniz-Wolffian predecessors.},
    abstract_source = {openalex},
}

@book{proops2021fiery,
    author = {Proops, Ian},
    title = {The Fiery Test of Critique: A Reading of Kant's Dialectic},
    publisher = {Oxford University Press},
    year = {2021},
    doi = {10.1093/oso/9780199656042.001.0001},
    note = {SUMMARY: Offers a study of the Transcendental Dialectic of the first Critique, arguing that Kant conceives critique as a winnowing exercise modelled on the metallurgical assay called cupellation. Critique therefore has a positive side: besides eliminating bad dogmatic metaphysics it uncovers valuable material in traditional speculative metaphysics, namely the indirect proof of transcendental idealism through the resolution of the Antinomies and the defence of theoretically grounded doctrinal beliefs in a wise originator and an afterlife (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: the Dialectic, the Antinomies as an indirect proof of transcendental idealism, and Kant's doctrinal belief; the abstract also lists the sources of the impulse towards metaphysics, the limits of self-knowledge, the resolution of paradox and the role of as-if reasoning in natural science among the topics treated. SIGNIFICANCE INDICATORS: S2 citations 13 (title-matched record, 2026-09-30); CrossRef is-referenced-by-count 26. Publisher: Oxford University Press. NDPR review: not found. Reviews found: The Philosophical Quarterly (Wells, 2022), Kantian Review (Chaplin, 2022), European Journal of Philosophy (Serck-Hanssen, 2022), Journal of the History of Philosophy (Howard, 2023), Mind (Kohl, 2024), Archiv fuer Geschichte der Philosophie (Hoffer, 2024). CrossRef gives print publication 2021-04-22.},
    keywords = {kant, tp-cpr, debate-other-dialectic, type-monograph, High, summary-source-abstract},
    abstract = {The book aims to provide a comprehensive study of the ‘Transcendental Dialectic’ of Kant’s first Critique. It argues that Kant conceives of ‘critique’ as a kind of winnowing exercise, aimed to separate the wheat of good metaphysics from the chaff of bad. However, he uses a less familiar metaphor to make this point, namely, that of ‘the fiery test of critique’. This turns out to be, not a medieval ordeal (a trial by fire), but rather a metallurgical assay: so-called ‘cupellation’—a procedure in which ore samples are tested for their precious-metal content. The upshot is that critique has a positive, investigatory side: it seeks not merely to eliminate the dross of bad ‘dogmatic’ metaphysics but also to uncover any hidden nuggets of value that might be contained in traditional speculative metaphysics. There are both gold and silver to be found. The gold is the indirect proof of Transcendental Idealism afforded by the resolution of the Antinomies, the silver Kant’s defence of theoretically grounded ‘doctrinal beliefs’ in a wise and great originator and in an afterlife. In the course of making these points, the book engages with Kant’s views on a number of central problems in philosophy and meta-philosophy, including: the explanation of the enduring human impulse towards metaphysics, correct philosophical method, the limits of self-knowledge, the possibility of human freedom, the resolution of metaphysical paradox (‘Antinomy’), the justification of faith, the nature of scepticism, and the role of ‘as if’ reasoning in natural science.},
    abstract_source = {s2},
}

@book{ypi2021architectonic,
    author = {Ypi, Lea},
    title = {The Architectonic of Reason: Purposiveness and Systematic Unity in Kant's Critique of Pure Reason},
    publisher = {Oxford University Press},
    year = {2021},
    doi = {10.1093/oso/9780198748526.001.0001},
    note = {SUMMARY: Takes the Architectonic of Pure Reason as the entry point to the unity of reason and to Kant's question of what the human being is. It argues that the first Critique's concept of purposiveness is purposiveness as intelligent design, which differs from the purposiveness as normativity of the later works, anchored in reflective judgment and grounded on transcendental freedom, and draws consequences for the passage from nature to freedom, faith and knowledge, progress in history and religion (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and the systematic structure of the critical philosophy: purposiveness, systematic unity of reason and the development from the first to the third Critique; also bears on Kant's reception in the German philosophical tradition. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 34 (2026-09-30); no title-matched S2 record found. Publisher: Oxford University Press. NDPR review: not found. Reviews found: Australasian Journal of Philosophy (Blecher, 2024), Mind (Heide, 2025). SEP: listed in the kant-reason bibliography. YEAR NOTE: CrossRef gives online 2021-10-21 and print 2021-11-01.},
    keywords = {kant, tp-cpr, aes-teleo, debate-other-purposiveness, type-monograph, Medium, summary-source-abstract},
    abstract = {Abstract The Architectonic of Pure Reason, one of the most important sections of Kant’s first Critique, raises three fundamental questions. What can I know? What should I do? What may I hope? Taken together these questions converge on a fourth one, which is at the centre of philosophy as a whole: what is the human being? This book suggests that the answer to this question is tied to a particular account of the unity of reason—one that stresses its purposive character. By focusing on the sources, evolution, and function of Kant’s concept of purposiveness, the book shows that the idea of purposiveness that Kant endorses in the Critique of Pure Reason is a concept of purposiveness as intelligent design, quite different from the concept of purposiveness as normativity that will become central to his later works. wIn the case of purposiveness as normativity, it is anchored to the concept of reflexive judgment, and grounded on transcendental freedom. Understanding this shift has important implications for some of the most difficult questions that confront the Kantian system: the passage from the system of nature to that of freedom, the relation between faith and knowledge, the philosophical defence of progress in history, and the role of religion. It is also crucial to shed light on the way in which Kant’s critique has shaped the successive German philosophical tradition.},
    abstract_source = {openalex},
}

@book{sutherland2021mathematical,
    author = {Sutherland, Daniel},
    title = {Kant's Mathematical World: Mathematics, Cognition, and Experience},
    publisher = {Cambridge University Press},
    year = {2021},
    doi = {10.1017/9781108555746},
    note = {SUMMARY: Reconstructs Kant's project of explaining both mathematical cognition and cognition of the world through our most basic cognitive capacities. It situates Kant in a mathematical tradition rooted in Euclid's Elements, from before the nineteenth-century arithmetization of mathematics, and argues that he treated mathematics as the science of magnitudes and their measurement, with all objects of experience being extensive magnitudes whose real properties have intensive magnitudes, which ties mathematics directly to the world (publisher abstract). SUBFIELD AND DEBATE: Philosophy of mathematics and theoretical philosophy: Kant's account of mathematical cognition, magnitude and the mathematical character of experience; a historical reading of Kant against the Euclidean tradition. SIGNIFICANCE INDICATORS: S2 citations 13 (title-matched record, 2026-09-30); CrossRef is-referenced-by-count 12. Publisher: Cambridge University Press. NDPR review: not found. SEP: listed in the kant-transcendental and kant-mathematics bibliographies. YEAR NOTE: CrossRef gives online 2021-10-21 and print 2021-10-31.},
    keywords = {kant, tp-science-math, tp-cpr, debate-other-magnitude, type-monograph, Medium, summary-source-abstract},
    abstract = {Kant's Mathematical World aims to transform our understanding of Kant's philosophy of mathematics and his account of the mathematical character of the world. Daniel Sutherland reconstructs Kant's project of explaining both mathematical cognition and our cognition of the world in terms of our most basic cognitive capacities. He situates Kant in a long mathematical tradition with roots in Euclid's Elements, and thereby recovers the very different way of thinking about mathematics which existed prior to its 'arithmetization' in the nineteenth century. He shows that Kant thought of mathematics as a science of magnitudes and their measurement, and all objects of experience as extensive magnitudes whose real properties have intensive magnitudes, thus tying mathematics directly to the world. His book will appeal to anyone interested in Kant's critical philosophy -- either his account of the world of experience, or his philosophy of mathematics, or how the two inform each other.},
    abstract_source = {openalex},
}

@article{hogan2021handedness,
    author = {Hogan, Desmond},
    title = {Handedness, Idealism, and Freedom},
    journal = {The Philosophical Review},
    year = {2021},
    volume = {130},
    number = {3},
    pages = {385--449},
    doi = {10.1215/00318108-8998838},
    note = {SUMMARY: Seeks an adequate understanding of Kant's idealist argument from incongruent counterparts (pairs of objects such as left and right hands that cannot be enclosed in the same spatial limits despite exact similarity), which Kant takes to demand demotion of space and time to forms of sensory intuition. Its central finding is that the argument rests essentially on Kant's theory of freedom, which links the pillars of transcendental idealism and points to a unified reading of Kant's system of idealist arguments (journal abstract). SUBFIELD AND DEBATE: Theoretical philosophy: space, incongruent counterparts and the arguments for transcendental idealism, tied to the theory of freedom. SIGNIFICANCE INDICATORS: S2 citations 9 and CrossRef is-referenced-by-count 8 (2026-09-30). Venue: The Philosophical Review 130(3). SEP: listed in the kant-transcendental bibliography.},
    keywords = {kant, tp-cpr, debate-other-incongruent-counterparts, type-article, Medium, summary-source-abstract},
    abstract = {Incongruent counterparts are pairs of objects which cannot be enclosed in the same spatial limits despite an exact similarity in magnitude, proportion, and relative position of their parts. Kant discerns in such objects, whose most familiar example is left and right hands, a “paradox” demanding “demotion of space and time to mere forms of our sensory intuition.” This paper aims at an adequate understanding of Kant’s enigmatic idealist argument from handed objects, as well as an understanding of its relation to the other key supports of his idealism. The paper’s central finding is that Kant’s idealist argument from incongruent counterparts rests essentially on his theory of freedom. The surprising result sheds new light on deep and overlooked links among the pillars of transcendental idealism, pointing the way to a comprehensive and unified reading of Kant’s system of idealist arguments.},
    abstract_source = {s2},
}

@article{schafer2021capacitiesfirst,
    author = {Schafer, Karl},
    title = {Transcendental Philosophy As Capacities-First Philosophy},
    journal = {Philosophy and Phenomenological Research},
    year = {2021},
    volume = {103},
    number = {3},
    pages = {661--686},
    url = {https://doi.org/10.1111/phpr.12740},
    note = {SUMMARY: Proposes that the critical Kant can be understood as working within a capacities-first philosophical framework, in which our basic rational or cognitive capacities play both an explanatorily and an epistemically fundamental role. It examines the relation between the explanatory and epistemic roles of such capacities in Kant, sketches how this reading illuminates the foundations of his theoretical and practical philosophy, and considers Kant's reasons for finding the approach attractive and its contemporary relevance (journal abstract). SUBFIELD AND DEBATE: Theoretical and practical philosophy, Kant's critical methodology: a methodological reading of transcendental philosophy that connects the epistemology and the practical philosophy of the Critiques; by the author of the 2019 Philosophical Explorations constitutivism paper recorded in this file under 2019. SIGNIFICANCE INDICATORS: S2 citations 14 and CrossRef is-referenced-by-count 12 (2026-09-30). Venue: Philosophy and Phenomenological Research 103(3). Not found in the parsed SEP bibliography candidate list. YEAR NOTE: CrossRef gives online publication 2020-11-17 and print issue November 2021; dated by print year.},
    keywords = {kant, tp-cpr, pp-ethics, debate-other-methodology, type-article, Medium, summary-source-abstract},
    abstract = {Abstract In this essay, I propose a novel way of thinking about Kant’s philosophical methodology during the critical period. According to this interpretation, the critical Kant can generally be understood as operating within a “capacities‐first” philosophical framework – that is, within a framework in which our basic rational or cognitive capacities play both an explanatorily and epistemically fundamental role in philosophy – or, at least, in the sort of philosophy that limited creatures like us are capable of. In discussing this idea, I consider the complicated relationship between the explanatory and epistemic roles that such capacities play in Kant. I also sketch how this way of thinking about Kant’s methodology can illuminate the foundations of both his theoretical and his practical philosophy, before discussing some of Kant’s reasons for finding this approach to philosophy attractive. I close with a brief discussion of the contemporary relevance of this approach.},
    abstract_source = {openalex},
}

@book{schulting2021apperception,
    author = {Schulting, Dennis},
    title = {Apperception and Self-Consciousness in Kant and German Idealism},
    publisher = {Bloomsbury Academic},
    year = {2021},
    doi = {10.5040/9781350151420},
    note = {SUMMARY: Examines reflexivity, self-consciousness, representation and apperception in Kant and German Idealism. It argues that all human experience is irreversibly self-referential, which is the self-reflexivity called transcendental apperception, an insight the publisher text traces to Christian Wolff, and it follows the theme from Kant's historical roots to Reinhold, Fichte and Hegel, examining the cognitive role of self-consciousness and its relation to idealism (publisher abstract, which is cut off in the retrieved text). SUBFIELD AND DEBATE: Theoretical philosophy of mind and reception in German Idealism: transcendental apperception and self-consciousness read across Kant and his immediate successors. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 10 and S2 citations 11 (2026-09-30). Publisher: Bloomsbury Academic. NDPR review: not found. Reviews found: Kantian Review (Frketich, 2021), Revista de Estudios Kantianos (Rodriguez Hernandez, 2021). YEAR NOTE: CrossRef gives only an online publication year (2021).},
    keywords = {kant, tp-mind, recep-idealism, debate-other-apperception, type-monograph, Medium, summary-source-abstract},
    abstract = {In Apperception and Self-Consciousness in Kant and German Idealism, Dennis Schulting examines the themes of reflexivity, self-consciousness, representation and apperception in the philosophy of Immanuel Kant and German Idealism more widely. Central to Schulting's argument is the claim that all of human experience is irreversibly self-referential and that this is part of a self-reflexivity, or what philosophers call transcendental apperception, a Kantian insight that was first apparent in the work of Christian Wolff and came to inform all of German Idealism. In a rigorous text suitable for students of German philosophy and upper-level students on metaphysics, epistemology, moral and political philosophy, and aesthetics courses, the author establishes the historical roots of Kant's thought and traces it through to his immediate successors Karl Leonhard Reinhold, Johann Gottlieb Fichte and Georg Wilhelm Friedrich Hegel. He specifically examines the cognitive role of self-consciousness and its relation to idealism and places it in a},
    abstract_source = {openalex},
}

@book{ware2021justification,
    author = {Ware, Owen},
    title = {Kant's Justification of Ethics},
    publisher = {Oxford University Press},
    year = {2021},
    doi = {10.1093/oso/9780198849933.001.0001},
    note = {SUMMARY: Defends the view that Kant's mature writings on ethics share a unified commitment to the primacy of the moral law, against commentators who detect a rift between the Groundwork and the Critique of Practical Reason. Through close analysis and historical contextualisation it rejects a paradigmatic way of reading Kant's arguments for morality and freedom and places them within his critical methodology, which the publisher text says challenges much of current Kantian argument for moral normativity (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy: the justification of morality and freedom across the Groundwork and the second Critique, and the question whether Kant offers a derivation of the moral law from a more basic conception of action or rationality. SIGNIFICANCE INDICATORS: S2 citations 7 (title-matched record) and CrossRef is-referenced-by-count 14 (2026-09-30). Publisher: Oxford University Press. NDPR review: not found. YEAR NOTE: CrossRef gives online 2021-01-21 and print 2021-02-01.},
    keywords = {kant, pp-ethics, debate-other-justification, type-monograph, Medium, summary-source-abstract},
    abstract = {Kant’s arguments for the reality of human freedom and the normativity of the moral law continue to inspire work in contemporary moral philosophy. Many prominent ethicists invoke Kant, directly or indirectly, in their efforts to derive the authority of moral requirements from a more basic conception of action, agency, or rationality. But many commentators have detected a deep rift between the Groundwork for the Metaphysics of Morals and the Critique of Practical Reason, leaving Kant’s project of justification exposed to conflicting assessments and interpretations. In this major re-reading of Kant, Owen Ware defends the controversial view that Kant’s mature writings on ethics share a unified commitment to the moral law’s primacy. Using both close analysis and historical contextualization, Owen Ware overturns a paradigmatic way of reading Kant’s arguments for morality and freedom, situating them within Kant’s critical methodology at large. The result is a novel understanding of Kant that challenges much of what goes under the banner of Kantian arguments for moral normativity today.},
    abstract_source = {s2},
}

@book{ripstein2021war,
    author = {Ripstein, Arthur},
    title = {Kant and the Law of War},
    publisher = {Oxford University Press},
    year = {2021},
    doi = {10.1093/oso/9780197604205.001.0001},
    note = {SUMMARY: Brings Kant's explicit discussions of war into the contemporary debate on the law and morality of war. Kant holds that a special morality governs the permissible use of force because of war's distinctive immorality: war is barbaric because might makes right, since which side prevails does not depend on who is in the right, and the very thing that makes war wrongful also supplies the standard for evaluating its conduct and the only basis for law governing war (publisher abstract). SUBFIELD AND DEBATE: Political, legal and cosmopolitan philosophy: the Doctrine of Right on war, international right and the conduct of war, placed against just war theory. SIGNIFICANCE INDICATORS: S2 citations 14 (title-matched record) and CrossRef is-referenced-by-count 27 (2026-09-30). Publisher: Oxford University Press. NDPR review: not found. Review found: Kantian Review (Guyer, 2022). SEP: listed in the kant-social-political bibliography. YEAR NOTE: CrossRef gives online 2021-10-21 and print 2021-10-26.},
    keywords = {kant, pp-right-politics, debate-other-war, type-monograph, Medium, summary-source-abstract},
    abstract = {Abstract The past two decades have seen renewed scholarly and popular interest in the law and morality of war. Positions that originated in the late Middle Ages through the seventeenth century have received more sophisticated philosophical elaboration. Although many contemporary writers draw on ideas that figure prominently in Kant’s moral philosophy, his explicit discussions of war have not been brought into their proper place within these discussions and debates. Kant argues that a special morality governs the permissible use of force because of war’s distinctive immorality. He characterizes war as barbaric, because in war, might makes right—which side prevails does not depend on who is in the right. The very thing that makes war wrongful also provides the appropriate standard for evaluating the conduct of war, and the only basis for law governing war.},
    abstract_source = {openalex},
}

@book{makkai2021taste,
    author = {Makkai, Katalin},
    title = {Kant's Critique of Taste: The Feeling of Life},
    publisher = {Cambridge University Press},
    year = {2021},
    url = {https://doi.org/10.1017/9781108596893},
    note = {SUMMARY: Argues for the rediscovery of Kant's aesthetics, whose centrepiece, the investigation of the judgment of taste, presents our relationships with works of art we love as scenes of aesthetic encounter in which one feels oneself animated by an object. Tracing Kant's insight that to judge is to reveal one's sense of what bears judging, and so of what matters, it places the aesthetics within Kant's study, begun in the first Critique, of judgment's role in the life of the mind (publisher abstract). SUBFIELD AND DEBATE: Aesthetics: the judgment of taste, the feeling of life and the role of judgment in the Critique of the Power of Judgment; the book presents itself as a reversal of the disrepute into which Kant's aesthetics has fallen. SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 4 (2026-09-30). Publisher: Cambridge University Press. NDPR review: not found. Reviews found: Kantian Review (Tinguely, 2021), British Journal of Aesthetics (Merritt, 2023). SEP: listed in the kant-aesthetics bibliography. YEAR NOTE: CrossRef gives online 2021-04-07 and print 2021-04-15.},
    keywords = {kant, aes-teleo, debate-other-judgment-of-taste, type-monograph, Medium, summary-source-abstract},
    abstract = {Immanuel Kant's Critique of Judgment is widely recognized as a founding document of modern aesthetics, but its legacy has fallen into disrepute. In this book Katalin Makkai calls for the rediscovery of Kant's aesthetics, showing that its centerpiece, his investigation of the judgment of taste, paints a compelling portrait of our relationships with works of art that we love. At its heart is a scene of aesthetic encounter in which one feels oneself to be 'animated' - brought to life - by an object, finding there to be something in one's experience of it, beyond what there is to know about it, that one wants to explore and articulate. Tracing Kant's insight that to judge is to reveal one's sense of what bears judging, and hence of what matters, Makkai situates Kant's aesthetics within his larger study, begun in the first Critique, of judgment's fundamental role in the life of the mind.},
    abstract_source = {openalex},
}

@article{merritt2021stoic,
    author = {Merritt, Melissa},
    title = {Nature, corruption, and freedom: Stoic ethics in Kant's Religion},
    journal = {European Journal of Philosophy},
    year = {2021},
    volume = {29},
    number = {1},
    pages = {3--24},
    url = {https://doi.org/10.1111/ejop.12553},
    note = {SUMMARY: Argues that Kant's account of radical evil in the 1793 Religion, usually read as a reworking of the Augustinian doctrine of original sin, is better read as an answer to an old Stoic problem. Kant takes as premise a version of the Stoic idea that nature gives us uncorrupted starting points and must then explain the origin of human badness, which requires a conception of freedom not available in his Stoic sources (journal abstract). SUBFIELD AND DEBATE: Religion and moral psychology: radical evil, corruption and freedom in the Religion within the Boundaries of Mere Reason; offers a Stoic rather than Augustinian background for the doctrine. SIGNIFICANCE INDICATORS: S2 citations 4 and CrossRef is-referenced-by-count 5 (2026-09-30). Venue: European Journal of Philosophy 29(1). Included to fill the 2021 religion cell; no 2021 religion monograph with stronger indicators was verified. YEAR NOTE: CrossRef gives online publication 2020-07-06 and print issue March 2021; dated by print year.},
    keywords = {kant, religion, pp-ethics, debate-other-radical-evil, type-article, Low, summary-source-abstract},
    abstract = {Abstract Kant's account of “the radical evil in human nature” in the 1793Religion within the Bounds of Reason Aloneis typically interpreted as a reworking of the Augustinian doctrine of original sin. But Kant does not talk about Augustine explicitly there, and if he is rehabilitating the doctrine of original sin, the result is not obviously Augustinian. Instead, Kant talks about Stoic ethics in a pair of passages on either end of his account of radical evil and leaves other clues that his argument is a reworking of an old Stoic problem. “Radical evil” refers to the idea that our moral condition is—by default and yet by our own deed—bad or corrupt; and that this corruption is the root (radix) of human badness in all its variety, ubiquity, and sheer ordinariness. Kant takes as his premise a version of the Stoic idea that nature gives us “uncorrupted starting points” (Diogenes Laertius 7.89). What sense can be made of the origin of human badness, given such a premise? Kant's account of radical evil is an answer to this old Stoic problem, which requires a conception of freedom that is not available in his Stoic sources.},
    abstract_source = {openalex},
}

@article{sabourin2021enlightenment,
    author = {Sabourin, Charlotte},
    title = {Kant's Enlightenment and Women's Peculiar Immaturity},
    journal = {Kantian Review},
    year = {2021},
    volume = {26},
    number = {2},
    pages = {235--260},
    doi = {10.1017/s1369415420000564},
    note = {SUMMARY: Takes up Kant's claim in What is Enlightenment? that no women are currently enlightened and argues that the exclusion is due to legal restrictions guiding his conception of enlightenment, which is meant to take place in society. His twofold conception of citizenship and the subordination built into restricting the private use of reason clarify those restrictions, so that Kant seems unlikely to have intended women to take an active part in enlightenment (journal abstract). SUBFIELD AND DEBATE: Anthropology, history and gender: Kant on women, citizenship and enlightenment; reads the exclusion as legal and political rather than only anthropological in the Kant and gender debate. SIGNIFICANCE INDICATORS: S2 citations 5 and CrossRef is-referenced-by-count 10 (2026-09-30). Venue: Kantian Review 26(2). YEAR NOTE: CrossRef gives online publication 2021-02-24 and print issue June 2021.},
    keywords = {kant, anthro-hist-edu, pp-right-politics, debate-gender, type-article, Low, summary-source-abstract},
    abstract = {Abstract In ‘What is Enlightenment?’, Kant claims that no women are currently enlightened. Here I argue that this exclusion is due to certain legal restrictions guiding Kant’s conception of enlightenment. As enlightenment is intended to take place in society, it appears that Kant has a specific legal context in mind that affects its enactment. His twofold conception of citizenship and the dimension of subordination he puts forward by restricting the private use of reason will prove useful in clarifying those legal restrictions. It thus seems unlikely that Kant intended women to take an active part in enlightenment.},
    abstract_source = {s2},
}

@book{yab2021racism,
    author = {Yab, Jimmy},
    title = {Kant and the Politics of Racism: Towards Kant's Racialised Form of Cosmopolitan Right},
    publisher = {Springer International Publishing},
    year = {2021},
    doi = {10.1007/978-3-030-69101-1},
