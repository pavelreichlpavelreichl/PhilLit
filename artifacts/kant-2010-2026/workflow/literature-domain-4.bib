    title = {Sex, Love, and Gender: A Kantian Theory},
    publisher = {Oxford University Press},
    year = {2020},
    doi = {10.1093/oso/9780198812838.001.0001},
    note = {SUMMARY: Presents a comprehensive account of sex, love and gender built on Kant. It gives an interpretation on which Kant's scattered remarks in his ethics, legal-political thought, aesthetics, teleology, history, religion and anthropology form one coherent approach, then rehabilitates the theory by correcting Kant's own errors and limitations, and applies it to sexual orientation, abortion, gender identity, marriage, erotica, sexual oppression and trade in sexual services (publisher abstract). SUBFIELD AND DEBATE: Metaphysics of Morals, Doctrine of Right and Doctrine of Virtue, and Kant on gender and sex: a Kantian-inspired constructive theory that disputes readings on which Kant's sexual ethics cannot be reconciled with his account of rights and freedom. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 61 and S2 citations 22 (2026-09-30; S2 book-level counts are incomplete). Publisher: Oxford University Press. Reviews found: Kantian Review (Sabourin, 2021), Mind (Fahmy, 2023); critical dialogue in Estudos Kantianos (2023). SEP: listed in the kant-social-political bibliography. NDPR review: not found.},
    keywords = {kant, pp-mm-virtue, pp-right-politics, debate-gender, type-monograph, High, summary-source-abstract},
}

@book{allaiscallanan2020animals,
    editor = {Callanan, John J. and Allais, Lucy},
    title = {Kant and Animals},
    publisher = {Oxford University Press},
    year = {2020},
    doi = {10.1093/oso/9780198859918.001.0001},
    note = {SUMMARY: Edited collection on the role of animals in Kant's philosophy across theoretical and practical philosophy. It covers Kant's model of animal minds, whether his philosophy of mind allows animals intentional representations of spatiotemporal objects, animal nature in humans and non-humans, how his scientific theory accommodated animals, and whether Kantian moral theory gives the right account of the moral status of animals, which Kant denied direct obligations to (publisher abstract). SUBFIELD AND DEBATE: Anthropology and philosophy of mind, practical philosophy: Kant and animals, including the nonconceptualism and conceptualism debate as applied to animal representation and the indirect-duties view of animal ethics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 10 and S2 citations 5 (2026-09-30; volume-level counts). Publisher: Oxford University Press. Reviews found: Journal of the History of Philosophy (Steiner, 2021), Philosophiques (Simoneau-Gilbert, 2021), Kant-Studien (Mueller, 2023). SEP: chapters listed in the kant-conceptualism bibliography. NDPR review: not found.},
    keywords = {kant, anthro-hist-edu, pp-ethics, tp-mind, debate-animals, type-edited-volume, High, summary-source-abstract},
}

@article{cohen2020emotions,
    author = {Cohen, Alix},
    title = {A Kantian Account of Emotions as Feelings},
    journal = {Mind},
    year = {2020},
    volume = {129},
    number = {514},
    pages = {429--460},
    url = {https://doi.org/10.1093/mind/fzz018},
    note = {SUMMARY: Extracts from Kant's writings an account of the emotions, although Kant neither uses the term nor treats them systematically. It reads Kant as defining emotions first and foremost as feelings, which are non-cognitive states with a derived intentionality, and argues that the faculty of feeling makes us aware of how our faculties relate to each other and to the world, so that feelings are affective appraisals of our agency with an orientational function (journal abstract). SUBFIELD AND DEBATE: Mind and moral psychology: Kant on feeling, desire and cognition, and the philosophy of emotion; challenges contemporary views that define emotions through other mental states. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 28 and S2 citations 26 (2026-09-30). Venue: Mind 129(514). Reply: Merritt, Feeling and Orientation in Action: A Reply to Alix Cohen, Kantian Review (2021). YEAR NOTE: CrossRef gives online publication 2019-04-22 and print issue April 2020 (Mind 129(514)); dated by print year.},
    keywords = {kant, tp-mind, pp-ethics, debate-other-emotion, type-article, Medium, summary-source-abstract},
}

@article{kleingeld2020meremeans,
    author = {Kleingeld, Pauline},
    title = {How to Use Someone ‘Merely as a Means’},
    journal = {Kantian Review},
    year = {2020},
    volume = {25},
    number = {3},
    pages = {389--414},
    doi = {10.1017/s1369415420000229},
    note = {SUMMARY: Re-examines Kant's texts to develop a new account of the conditions under which someone is used merely as a means, a prohibition in Kant's moral theory widely thought impossible to specify precisely. It argues that the account has textual support and philosophical advantages over alternative conceptions (journal abstract). SUBFIELD AND DEBATE: Ethics: the Formula of Humanity and the prohibition on using persons merely as means; contributes to the debate over how to specify the prohibition. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 38 and S2 citations 32 (2026-09-30). Venue: Kantian Review 25(3). SEP: listed in the persons-means bibliography.},
