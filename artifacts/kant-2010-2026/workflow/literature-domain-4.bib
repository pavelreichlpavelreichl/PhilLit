}

@article{basevich2020race,
    author = {Basevich, Elvira},
    title = {Reckoning With Kant on Race},
    journal = {The Philosophical Forum},
    year = {2020},
    volume = {51},
    number = {3},
    pages = {221--245},
    doi = {10.1111/phil.12263},
    note = {SUMMARY: Develops Kant's theory of reform into a theory of racial justice reform. It reads Kant's philosophy of race as part of his nonideal theory of justice, a racist pragmatic anthropology that assumes some racial groups failed to develop their innate capacity for legislative reason, and argues for an alternative Kantian nonideal theory that extends Kant's model of public reason, including an ideal of interracial civic fellowship (journal abstract). SUBFIELD AND DEBATE: Race and political philosophy: Kant's racism and its place in his system, and whether Kantian public reason can be used for racial justice; in the Kant and race debate it combines a critique of Kant's anthropology with a constructive nonideal theory. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 18 and S2 citations 18 (2026-09-30). Venue: The Philosophical Forum 51(3). SEP: listed in the critical-phil-race bibliography. YEAR NOTE: CrossRef gives online publication 2020-08-06 and print issue September 2020.},
    keywords = {kant, anthro-hist-edu, pp-right-politics, debate-race, type-article, Medium, summary-source-abstract},
}

@book{loriaux2020distributive,
    author = {Loriaux, Sylvie},
    title = {Kant and Global Distributive Justice},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108678834},
    note = {SUMMARY: Argues that although Kant's political thought does not address global poverty and inequality directly, it supplies conceptual and normative resources for global socioeconomic duties. It develops the Kantian duty to enter a rightful condition beyond the state, derives a duty of right to assist states unable to fulfil core state functions, and draws implications for just transnational trade and immigration regulation (publisher abstract; the abstract calls the work an Element). SUBFIELD AND DEBATE: Political, legal and cosmopolitan philosophy: Kant on international and global justice, the duty to enter a rightful condition and cosmopolitan right. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 23 and S2 citations 9 (2026-09-30). Publisher: Cambridge University Press. Review found: Kantian Review (Vaha, 2021). NDPR review: not found.},
    keywords = {kant, pp-right-politics, debate-other-global-justice, type-monograph, Low, summary-source-abstract},
}

@article{halper2020artnature,
    author = {Halper, Aaron},
    title = {Rethinking Kant's distinction between the beauty of art and the beauty of nature},
    journal = {European Journal of Philosophy},
    year = {2020},
    volume = {28},
    number = {4},
    pages = {857--875},
    doi = {10.1111/ejop.12524},
    note = {SUMMARY: Argues that Kant presents two different accounts of beauty, one applying properly to art and one to nature. The judgment of beauty proper to nature can be free and made without concepts, whereas a work of art is judged beautiful when it expresses aesthetic ideas, a distinction used to explain problematic passages in Kant's text, including cases where the conception of artistic beauty is applied to natural objects (journal abstract). SUBFIELD AND DEBATE: Aesthetics: free and adherent beauty, aesthetic ideas and the art-nature distinction in the Critique of the Power of Judgment. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 15 and S2 citations 11 (2026-09-30). Venue: European Journal of Philosophy 28(4). SEP: listed in the kant-aesthetics bibliography. YEAR NOTE: CrossRef gives online publication 2020-02-11 and print issue December 2020.},
    keywords = {kant, aes-teleo, debate-other-beauty, type-article, Low, summary-source-abstract},
}

@article{biagioli2020cassirer,
    author = {Biagioli, Francesca},
    title = {Ernst Cassirer's transcendental account of mathematical reasoning},
    journal = {Studies in History and Philosophy of Science Part A},
    year = {2020},
    volume = {79},
    pages = {30--40},
    doi = {10.1016/j.shpsa.2019.10.001},
    note = {SUMMARY: Examines how Cassirer tried to reconcile the Kantian explanation of the possibility of knowledge with nineteenth and early twentieth-century conceptual changes in science, in his philosophy of mathematics. It argues that Cassirer addressed the applicability of abstract mathematical concepts to empirical reality by a transcendental account of mathematical reasoning on which the formation of mathematical concepts explains the extensibility of mathematical knowledge, placing him within the Marburg neo-Kantian debate of 1902-1910 (journal abstract). SUBFIELD AND DEBATE: Neo-Kantian reception and philosophy of mathematics: Marburg neo-Kantianism and the transformation of Kant's transcendental method in response to modern mathematics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 12 and S2 citations 15 (2026-09-30). Venue: Studies in History and Philosophy of Science Part A 79. YEAR NOTE: CrossRef gives print issue February 2020 and no separate online date.},
    keywords = {kant, recep-neokantian, tp-science-math, type-article, Low, summary-source-abstract},
}

@book{vanmazijk2020perception,
    author = {van Mazijk, Corijn},
    title = {Perception and Reality in Kant, Husserl, and McDowell},
    publisher = {Routledge},
    year = {2020},
    doi = {10.4324/9781003010227},
    note = {SUMMARY: Critically engages with John McDowell's conceptualist account of how perception gives access to external reality by comparing his views on perception and reality with those of Kant and Husserl. Across six chapters it examines the three thinkers' theories of perception within their broader views of mind and reality and yields a critique of McDowell's conceptualism, combining analytic philosophy, Kantian philosophy and phenomenology (publisher abstract). SUBFIELD AND DEBATE: Reception (phenomenology and analytic philosophy) and philosophy of mind: Kant's theory of perception in the conceptualism and nonconceptualism debate as read through Husserl and McDowell. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 19 and S2 citations 18 (2026-09-30). Publisher: Routledge. Reviews found: Phenomenological Reviews (Cheng; Guilhermino, 2020), Husserl Studies (Doyon, 2021), Continental Philosophy Review (Laasik, 2022). NDPR review: not found. YEAR NOTE: CrossRef gives only an online publication date (2020-02-05).},
    keywords = {kant, recep-phenom, recep-analytic, tp-mind, debate-conceptualism, type-monograph, Medium, summary-source-abstract},
}
