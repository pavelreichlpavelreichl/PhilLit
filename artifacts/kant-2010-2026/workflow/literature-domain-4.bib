@article{formosasticker2019beneficence,
    author = {Formosa, Paul and Sticker, Martin},
    title = {Kant and the demandingness of the virtue of beneficence},
    journal = {European Journal of Philosophy},
    year = {2019},
    volume = {27},
    number = {3},
    pages = {625--642},
    doi = {10.1111/ejop.12455},
    note = {SUMMARY: Interprets Kant's beneficence as a sweet spot between overdemandingness and undemandingness through four claims: the ground of our duty to benefit others also permits beneficence to ourselves; we may prioritise our own ends; it is more virtuous to do more rather than less in helping others; and indifference to others is vicious (publisher-record abstract retrieved via Macquarie University repository). SUBFIELD AND DEBATE: Practical philosophy, Metaphysics of Morals and the doctrine of virtue: imperfect duties and the overdemandingness objection; related to Sticker's Kant-Studien 2019 article on emergencies and to Sticker's Nous article on overdemandingness and self-scrutiny (print 2021). SIGNIFICANCE INDICATORS: S2 citations 19 and CrossRef is-referenced-by-count 21 (2026-09-30). Venue: European Journal of Philosophy 27(3).},
    keywords = {kant, pp-mm-virtue, pp-ethics, debate-other-demandingness, type-article, Medium, summary-source-web-abstract},
}

