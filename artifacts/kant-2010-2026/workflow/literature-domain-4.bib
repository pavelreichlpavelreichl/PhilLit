@book{moller2020tribunal,
    author = {Møller, Sofie},
    title = {Kant's Tribunal of Reason: Legal Metaphor and Normativity in the Critique of Pure Reason},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108682480},
    note = {SUMMARY: Gives a book-length study of the legal metaphors in the Critique of Pure Reason. It argues that these metaphors are central to Kant's account of reason: reason has a structure mirroring a legal system in a natural-right framework, Kant aims to make cognisers resemble authorised judges by proving the legitimacy of laws and the conditions of valid judgment, and reason's systematicity is legal systematicity (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy: the normativity of reason, the Transcendental Deduction as a legal deduction, and Kant's method and metaphors. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 18 and S2 citations 17 (2026-09-30). Publisher: Cambridge University Press. Reviews found: Kantian Review (Moran, 2021), SATS (Nielsen, 2022), Philosophy in Review (Anderson, 2023). SEP: listed in the kant-reason bibliography. NDPR review: not found.},
    keywords = {kant, tp-cpr, debate-other-normativity, type-monograph, Medium, summary-source-abstract},
