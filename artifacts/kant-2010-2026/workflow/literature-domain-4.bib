    keywords = {kant, anthro-hist-edu, pp-right-politics, debate-race, type-monograph, Low, summary-source-publisher-web, INCOMPLETE, no-abstract},
}

@book{wuerth2021lexicon,
    editor = {Wuerth, Julian},
    title = {The Cambridge Kant Lexicon},
    publisher = {Cambridge University Press},
    year = {2021},
    doi = {10.1017/9781139018159},
    note = {SUMMARY: A lexicon with entries by 130 Kant scholars in two parts. Part I covers Kant's difficult philosophical concepts, the individual trees of his system; Part II gives an overview of the forest, with entries on each of his published works and each of his sets of lectures and personal reflections, arranged chronologically so as to show the development of his thought (publisher abstract). SUBFIELD AND DEBATE: Reference work covering all subfields of Kant scholarship: concept entries and a chronological survey of the writings, lectures and Reflexionen. SIGNIFICANCE INDICATORS: S2 citations 11 (title-matched record) and CrossRef is-referenced-by-count 9 (2026-09-30). Publisher: Cambridge University Press. NDPR review: not found. SEP: cited in the kant-metaphysics and kant-moral bibliographies (as the Cambridge Kant Lexicon and for its Duties to Self entry). The German Kant-Lexikon (De Gruyter) is recorded under 2015 in Domain 2; a separate 2021 De Gruyter DOI record (10.1515/9783110762532) carries the same publisher abstract and appears to be a reissue, so it was not included as a new work. YEAR NOTE: CrossRef gives online 2021-02-23 and print 2021-02-25.},
    keywords = {kant, reference, type-reference-work, Medium, summary-source-abstract},
    abstract = {Immanuel Kant is widely recognized as one of the most important Western philosophers since Aristotle. His thought has had, and continues to have, a profound effect on every branch of philosophy, including ethics, metaphysics, epistemology, aesthetics, political philosophy, and philosophy of religion. This Lexicon contains detailed and original entries by 130 leading Kant scholars, covering Kant's most important concepts as well as each of his writings. Part I covers Kant's notoriously difficult philosophical concepts, providing entries on these individual 'trees' of Kant's philosophical system. Part II, by contrast, provides an overview of the 'forest' of Kant's philosophy, with entries on each of his published works and on each of his sets of lectures and personal reflections. This part is arranged chronologically, revealing not only the broad sweep of Kant's thought but also its development over time. Professors, graduate students, and undergraduates will value this landmark volume.},
    abstract_source = {openalex},
}

@book{himmelmannserckhanssen2021court,
    editor = {Himmelmann, Beatrix and Serck-Hanssen, Camilla},
    title = {The Court of Reason: Proceedings of the 13th International Kant Congress},
    publisher = {De Gruyter},
    year = {2021},
    doi = {10.1515/9783110701357},
    note = {SUMMARY: Presents the contributions to the 13th International Kant Congress, held at the University of Oslo on 6-9 August 2019 with speakers from more than thirty countries and dedicated to the topic of the court of reason, the idea that reason stands before itself as a tribunal. Special emphasis was put on Kant's methodology, his account of conceptual critique and the relevance of his ideas to political philosophy and the philosophy of law, with further sections on a wide range of topics (publisher abstract, retrieved through OpenAlex). SUBFIELD AND DEBATE: Reference and congress proceedings across all subfields: Kant's critical methodology and the tribunal of reason, with section papers on metaphysics, ethics, aesthetics, law and science and round tables on Kant studies in Japan, South Korea and China (the last from the S2 front-matter record). SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 3 (2026-09-30). Publisher: De Gruyter. SEP: cited in the kant-aesthetics bibliography (chapters also cited in kant-hume-causality). Included as the congress volume for its triennial series; the preceding congress volume, Natur und Freiheit, is recorded under 2018 in Domain 3. YEAR NOTE: CrossRef gives online 2021-11-04 and print 2021-10-25.},
    keywords = {kant, reference, type-edited-volume, Medium, summary-source-abstract},
    abstract = {The Proceedings present the contributions to the 13th International Kant Congress which was held at the University of Oslo, August 6-9, 2019. The congress, which hosted speakers from more than thirty countries and five continents, was dedicated to the topic of the court of reason. The idea that reason stands before itself as a tribunal characterizes the whole of Kant's critical project. Without such a court, reason falls into conflict with itself. With such a court in place, however, it may succeed in establishing the possibility and limits of metaphysics, ethics, aesthetics, law and science. The idea of reason being its own judge is not only pivotal to a proper understanding of Kant's philosophy, but can also shed light on the burgeoning fields of meta-philosophy and philosophical methodology. The 2019 Kant Congress put special emphasis on Kant's methodology, his account of conceptual critique, and the relevance of his ideas to current issues in especially political philosophy and the philosophy of law. Additional sections discussed a wide range of topics in Kant's philosophy. The Proceedings will provide anyone who is interested in exploring the variety of present-day work on Kant and Kantian themes with a wealth of fruitful inspiration.},
    abstract_source = {openalex},
}
