}

@article{kleingeldwillaschek2019autonomy,
    author = {Kleingeld, Pauline and Willaschek, Marcus},
    title = {Autonomy Without Paradox: Kant, Self-Legislation and the Moral Law},
    journal = {Philosophers' Imprint},
    year = {2019},
    volume = {19},
    pages = {1--18},
    note = {SUMMARY: Challenges the widespread assumption that Kantian autonomy is the self-legislation of the principle of morality, arguing on textual and philosophical grounds that autonomy concerns only substantive moral laws (such as the law against lying) and that so understood it lacks the paradoxical features usually attributed to it (journal abstract as retrieved via web search of PhilArchive). SUBFIELD AND DEBATE: Practical philosophy, autonomy in the Groundwork and Critique of Practical Reason; bears on constructivist and realist readings of self-legislation. SIGNIFICANCE INDICATORS: S2 citations 33 (2026-09-30); no DOI in CrossRef. Venue: Philosophers' Imprint 19. SEP: listed in the kant-moral bibliography (article 19(6)).},
