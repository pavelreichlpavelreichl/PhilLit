}

@article{insole2019freebelief,
    author = {Insole, Christopher},
    title = {Free Belief: The Medieval Heritage in Kant's Moral Faith},
    journal = {Journal of the History of Philosophy},
    year = {2019},
    volume = {57},
    number = {3},
    pages = {501--528},
    doi = {10.1353/hph.2019.0056},
    note = {SUMMARY: Argues that in describing faith as a free choice Kant aligns with the medieval tradition and with his own mediating sources (Leibniz, Locke), which invoke freedom and the will in belief in God without weakening commitment. Kant departs from that tradition only by holding that divine action would destroy genuine human freedom, which explains his insistence that grace follows rather than precedes moral conversion (journal abstract). SUBFIELD AND DEBATE: Philosophy of religion: moral faith, the will and belief, and grace in Kant's Religion and practical philosophy. SIGNIFICANCE INDICATORS: S2 citations 4 and CrossRef is-referenced-by-count 4 (2026-09-30). Venue: Journal of the History of Philosophy 57(3). The same author's Kant and the Divine (Oxford University Press) appears in 2020 book listings.},
    keywords = {kant, religion, debate-other-moral-faith, type-article, Low, summary-source-abstract},
}

@article{fisher2019organisms,
    author = {Fisher, Naomi},
    title = {Organisms and the form of freedom in Kant's third Critique},
    journal = {European Journal of Philosophy},
    year = {2019},
    volume = {27},
    number = {1},
    pages = {55--74},
    url = {https://doi.org/10.1111/ejop.12384},
    note = {SUMMARY: Offers an interpretation of the argument in the Appendix to the Critique of Teleological Judgment that human freedom is the final end of creation: judgments of freedom within nature are possible as instances of teleological judgment, so that nature as a whole is regarded as given laws from a supersensible ground, namely freedom. On this reading mechanism, teleology and freedom are unified in the supersensible, which also explains how the third Critique bridges the gulf between nature and freedom (journal abstract). SUBFIELD AND DEBATE: Aesthetics and teleology: teleological judgment and organisms, and the unity of nature and freedom in the Critique of the Power of Judgment. SIGNIFICANCE INDICATORS: S2 citations 7 and CrossRef is-referenced-by-count 6 (2026-09-30). Venue: European Journal of Philosophy 27(1). YEAR NOTE: CrossRef gives online publication 2018-07-24 and print issue March 2019; dated by print year.},
    keywords = {kant, aes-teleo, debate-other-teleology, type-article, Low, summary-source-abstract},
}

@misc{kleingeld2019sexismracism,
    author = {Kleingeld, Pauline},
    title = {On Dealing with Kant's Sexism and Racism},
    year = {2019},
    howpublished = {SGIR Review 2(2): 3--22. \url{https://philarchive.org/rec/KLEODW}},
    url = {https://philarchive.org/rec/KLEODW},
    note = {SUMMARY: Asks how current readers should deal with Kant's sexist and (until late in his life) racist views alongside his universalist moral theory. It rejects both setting these views aside and translating his egalitarian principles into inegalitarian ones, argues instead for highlighting the tensions that pervade Kant's theory, warns of risks in the use of inclusive language and female pronouns in discussions of Kant's moral and political philosophy, and states preconditions for using Kant's principles to criticise sexism and racism (abstract retrieved via CORE and a PhilArchive web search). SUBFIELD AND DEBATE: Anthropology, race and gender: how to read and teach Kant given his racism and sexism; a position between setting aside and translating, in the Kant and race and Kant and gender debates. SIGNIFICANCE INDICATORS: S2 citations 34 (2026-09-30); no DOI in CrossRef. Venue: SGIR Review (volume, issue and pages as reported by S2 and a web search; the journal name is not given in S2 or CORE output). Open access on PhilArchive.},
    keywords = {kant, anthro-hist-edu, debate-race, debate-gender, type-article, High, summary-source-abstract},
}

@article{howard2019transition,
    author = {Howard, Stephen},
    title = {The transition within the transition: the Übergang from the Selbstsetzungslehre to the ether proofs in Kant's Opus postumum},
    journal = {Kant-Studien},
    year = {2019},
    volume = {110},
    number = {4},
    pages = {595--617},
    doi = {10.1515/kant-2019-3002},
    note = {SUMMARY: Argues against readings such as Förster's that treat the ether proofs and the Selbstsetzungslehre as the core of the Opus postumum, holding that the drafts of fascicles X and XI, written between them, are of primary importance. Through a close reading of a page of fascicle XI it shows Kant trying to resolve problems internal to both by presenting a transition from one to the other, and it urges a renewed appreciation of the drafts as aspiring to a science of transition (journal abstract). SUBFIELD AND DEBATE: Late work, Opus postumum: the transition project and the Selbstsetzungslehre, in dialogue with Förster's interpretation. SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 2 (2026-09-30). Venue: Kant-Studien 110(4). Included mainly to cover the Opus postumum cell; the other 2019 Opus postumum items found in S2 and CrossRef searches are lower-cited articles, a review, or Zenodo items.},
    keywords = {kant, opus-postumum, debate-other-transition, type-article, Low, summary-source-abstract},
}

@book{allison2020freedom,
    author = {Allison, Henry E.},
    title = {Kant's Conception of Freedom: A Developmental and Critical Analysis},
    publisher = {Cambridge University Press},
    year = {2020},
    url = {https://doi.org/10.1017/9781316535196},
    note = {SUMMARY: Traces Kant's views on free will from his earliest discussions in the 1750s to his last accounts in the 1790s. It argues that Kant's path to viewing freedom as a transcendental power both radically distinct from and compatible with natural causality was a winding one, and that the concept stayed central because it unites his theoretical and practical philosophy (publisher abstract). The NDPR review describes the book as in effect a detailed survey of Kant's whole philosophy, from the Universal Natural History (1755) to the Religion and Metaphysics of Morals, with the ten chapters divided evenly between pre-critical and post-1781 writings. SUBFIELD AND DEBATE: Practical philosophy and the development of Kant's thought: freedom of the will, the pre-critical writings and the critical turn, compatibilism and transcendental freedom. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 27 and S2 citations 25 (2026-09-30). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kants-conception-of-freedom-a-developmental-and-critical-analysis). Other reviews: European Journal of Philosophy (Kohl, 2020), The Philosophical Review (Vilhauer, 2022), Kant-Studien (Guyer, 2022). SEP: listed in the kant entry bibliography. YEAR NOTE: CrossRef gives online publication 2019-12-19 and print publication 2020-01-16; dated by print year.},
    keywords = {kant, pp-ethics, precritical, debate-other-freedom, type-monograph, High, summary-source-abstract, summary-source-ndpr},
}

@book{kraus2020selfknowledge,
    author = {Kraus, Katharina T.},
    title = {Kant on Self-Knowledge and Self-Formation: The Nature of Inner Experience},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108874304},
    note = {SUMMARY: Develops Kant's account of psychological personhood by analysing empirical self-knowledge, the knowledge one has of oneself as a unique psychological person, through the capacity for inner experience. It defends the thesis that inner experience is empirical cognition of oneself not as a mere object but as a psychological person, and (per the NDPR review) that self-cognition depends on the cooperation of sensibility, understanding and reason, with the regulative idea of the soul filling the gap between self-reference in thought and the deliverances of inner sense (publisher abstract and NDPR review). SUBFIELD AND DEBATE: Theoretical philosophy and mind: inner sense, apperception and self-affection, and the link between self-knowledge and self-formation; follows the same author's 2019 Kantian Review article on parity and disparity between inner and outer experience. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 47 and S2 citations 58 (2026-09-30). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kant-on-self-knowledge-and-self-formation-the-nature-of-inner-experience). Other reviews: European Journal of Philosophy (Kitcher, 2021), The Philosophical Review (Longuenesse, 2022), Journal of the History of Philosophy (Buchenau, 2022), Archiv fuer Geschichte der Philosophie (Liang, 2023), Kant-Studien (Erkan, 2023); Kantian Review symposium (2022).},
    keywords = {kant, tp-mind, debate-other-inner-sense, type-monograph, High, summary-source-abstract, summary-source-ndpr},
}

@book{deboer2020reform,
    author = {de Boer, Karin},
    title = {Kant's Reform of Metaphysics: The Critique of Pure Reason Reconsidered},
    publisher = {Cambridge University Press},
    year = {2020},
    doi = {10.1017/9781108897983},
    note = {SUMMARY: Interprets the Critique of Pure Reason in view of Kant's efforts to turn Christian Wolff's metaphysics into a science, rather than primarily through epistemological questions. Situates the Critique in eighteenth-century German philosophy, traces the development of Kant's conception of critique, analyses the Transcendental Deduction, the Schematism, the Appendix to the Transcendental Analytic and the Architectonic, and reconstructs the outline of the system of pure reason that the Critique was to prepare (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: metaphysical rather than epistemological reading of the first Critique; Kant and the Wolffian school. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 40 and S2 citations 36 (2026-09-30). Publisher: Cambridge University Press. Review found: Studia Kantiana (Garcia, 2023). NDPR review: not found.},
