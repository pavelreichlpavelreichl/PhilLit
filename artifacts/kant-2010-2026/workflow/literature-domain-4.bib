@article{schafer2019constitutivism,
    author = {Schafer, Karl},
    title = {Kant: constitutivism as capacities-first philosophy},
    journal = {Philosophical Explorations},
    year = {2019},
    volume = {22},
    number = {2},
    pages = {177--193},
    doi = {10.1080/13869795.2019.1599049},
    note = {SUMMARY: Asks whether and in what sense Kant is a constitutivist about meta-normative questions and answers by placing the question within Kant's general methodology for philosophy. It argues that Kant's constitutivism is one instance of a broader capacities-first approach that treats our basic, self-conscious rational capacities as fundamental (journal abstract). SUBFIELD AND DEBATE: Practical philosophy and metaethics: constitutivist readings of Kantian ethics, alongside constructivist and realist interpretations; companion articles on constitutivism by Korsgaard and by Tenenbaum also appear in Philosophical Explorations in 2019 (S2 records). SIGNIFICANCE INDICATORS: S2 citations 40 and CrossRef is-referenced-by-count 23 (2026-09-30). Venue: Philosophical Explorations 22(2).},
    keywords = {kant, pp-ethics, debate-constructivism, type-article, Medium, summary-source-abstract},
    abstract = {Over the last two decades, Kant’s name has become closely associated with the “constitutivist” program within metaethics.1 But is Kant best read as pursuing a constitutivist approach to meta-normative questions? And if so, in what sense?2 In this essay, I argue that we can best answer these questions by considering them in the context of how Kant understands the proper methodology for philosophy in general. The result of this investigation will be that, while Kant can indeed be read as a sort of constitutivist, his constitutivism is ultimately one instance of a more general approach to philosophy, which treats as fundamental our basic, self-conscious rational capacities. Thus, to truly understand why and how Kant is a constitutivist, we need to consider this question within the context of his more fundamental commitment to “capacities-first philosophy”.},
    abstract_source = {s2},
}

