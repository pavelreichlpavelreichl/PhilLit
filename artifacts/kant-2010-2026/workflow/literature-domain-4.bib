@book{watkins2019laws,
    author = {Watkins, Eric},
    title = {Kant on Laws},
    publisher = {Cambridge University Press},
    year = {2019},
    doi = {10.1017/9781316683026},
    note = {SUMMARY: Offers a book-length study of Kant's concept of law in general. It argues that Kant has one generic concept of law (necessity prescribed to a domain by the act of a spontaneous faculty) that is instantiated differently in laws of nature and in the moral law, and that grounds the necessity of transcendental laws in the legislative authority of the understanding and reason rather than in the natures of objects (NDPR review). SUBFIELD AND DEBATE: Theoretical philosophy and philosophy of science: Kant on laws of nature, necessity and self-legislation; positioned against necessitarian and empiricist accounts of laws and the natural-law tradition. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 45 (2026-09-30); S2 DOI-matched record shows only 6 (book-level undercount, title-matched record). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kant-on-laws). Other reviews: Guyer in Journal of the History of Philosophy (2020), Messina in Mind (2021). SEP: listed in the kant-science bibliography.},
    keywords = {kant, tp-science-math, tp-cpr, debate-other-laws, type-monograph, High, summary-source-ndpr},
}

@book{abaci2019modality,
    author = {Abacı, Uygar},
    title = {Kant's Revolutionary Theory of Modality},
    publisher = {Oxford University Press},
    year = {2019},
    doi = {10.1093/oso/9780198831556.001.0001},
    note = {SUMMARY: Argues that Kant's precritical views on possibility, existence and necessity, which remain within the rationalist paradigm, become in the critical period a revolutionary theory on which modal notions are subjective, relational features of our discursivity rather than fundamental ontological predicates. It further claims that this theory is constitutive of the critical turn itself, which Kant first formulates as a shift from an ontological to an epistemological question about possibility (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: Kant's modal theory and the development from the precritical to the critical philosophy; follows Stang (2016) on Kant's modal metaphysics according to the NDPR review. SIGNIFICANCE INDICATORS: S2 citations 25 (title-matched record, 2026-09-30); CrossRef is-referenced-by-count 21. Publisher: Oxford University Press. NDPR review: yes (ndpr.nd.edu/reviews/kants-revolutionary-theory-of-modality).},
    keywords = {kant, tp-cpr, precritical, debate-other-modality, type-monograph, Medium, summary-source-abstract},
}

@book{fugate2019lectures,
    editor = {Fugate, Courtney D.},
    title = {Kant's Lectures on Metaphysics},
    publisher = {Cambridge University Press},
    year = {2019},
    doi = {10.1017/9781316819142},
    note = {SUMMARY: Ten chapters analyse the transcript lectures on metaphysics that Kant delivered, following their structure (prolegomena, ontology, cosmology, empirical psychology, rational psychology, natural theology). The contributors examine what the transcripts show about Kant's conception of transcendental philosophy and critical theism and discuss how to use these primary sources responsibly (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy, Kant's metaphysics lectures and their relation to his precritical and critical thought; reviews name the volume as a Critical Guide. Contributions include Stang's chapter on ground and the principle of sufficient reason and Lu-Adler's chapter on ontology as transcendental philosophy. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 2 (2026-09-30); volume-level S2 record not found (chapter-level S2 counts: Stang chapter 29). Publisher: Cambridge University Press (Critical Guide). Reviews: Dunn in Kantian Review (2020), Melamedoff in British Journal for the History of Philosophy (2020). NDPR review: not found.},
    keywords = {kant, tp-cpr, precritical, reference, type-edited-volume, Medium, summary-source-abstract},
}

@article{kraus2019inner,
    author = {Kraus, Katharina},
    title = {The Parity and Disparity between Inner and Outer Experience in Kant},
    journal = {Kantian Review},
    year = {2019},
    volume = {24},
    number = {2},
    pages = {171--195},
    doi = {10.1017/s1369415419000013},
    note = {SUMMARY: Advances an interpretation on which Kant's inner experience is empirical cognition of mental states but not of a persistent mental substance, so that the schema of persistence is replaced by the regulative idea of the soul. It presents this as superior to the parity view (inner experience as cognition of a mental object on a par with outer experience) and the disparity view (inner experience is not empirical cognition) (journal abstract). SUBFIELD AND DEBATE: Theoretical philosophy and mind: Kant on self-knowledge and empirical psychology; intervenes between parity and disparity readings of inner sense. SIGNIFICANCE INDICATORS: S2 citations 6 and CrossRef is-referenced-by-count 8 (2026-09-30). Venue: Kantian Review 24(2). SEP: listed in the kant-mind bibliography. The same author's Kant on Self-Knowledge and Self-Formation (Cambridge University Press) is dated 2020.},
    keywords = {kant, tp-mind, debate-other-inner-sense, type-article, Medium, summary-source-abstract},
}

@article{kleingeldwillaschek2019autonomy,
    author = {Kleingeld, Pauline and Willaschek, Marcus},
    title = {Autonomy Without Paradox: Kant, Self-Legislation and the Moral Law},
    journal = {Philosophers' Imprint},
    year = {2019},
    volume = {19},
    pages = {1--18},
    note = {SUMMARY: Challenges the widespread assumption that Kantian autonomy is the self-legislation of the principle of morality, arguing on textual and philosophical grounds that autonomy concerns only substantive moral laws (such as the law against lying) and that so understood it lacks the paradoxical features usually attributed to it (journal abstract as retrieved via web search of PhilArchive). SUBFIELD AND DEBATE: Practical philosophy, autonomy in the Groundwork and Critique of Practical Reason; bears on constructivist and realist readings of self-legislation. SIGNIFICANCE INDICATORS: S2 citations 33 (2026-09-30); no DOI in CrossRef. Venue: Philosophers' Imprint 19. SEP: listed in the kant-moral bibliography (article 19(6)).},
    keywords = {kant, pp-ethics, debate-constructivism, type-article, High, summary-source-web-abstract},
}

@article{schafer2019constitutivism,
    author = {Schafer, Karl},
    title = {Kant: constitutivism as capacities-first philosophy},
    journal = {Philosophical Explorations},
    year = {2019},
    volume = {22},
    number = {2},
    pages = {177--193},
    doi = {10.1080/13869795.2019.1599049},
    note = {SUMMARY: Asks whether and in what sense Kant is a constitutivist about meta-normative questions and answers by placing the question within Kant's general methodology for philosophy. It argues that Kant's constitutivism is one instance of a broader capacities-first approach that treats our basic, self-conscious rational capacities as fundamental (journal abstract). SUBFIELD AND DEBATE: Practical philosophy and metaethics: constitutivist readings of Kantian ethics, alongside constructivist and realist interpretations; companion articles on constitutivism by Korsgaard and by Tenenbaum also appear in Philosophical Explorations in 2019 (S2 records). SIGNIFICANCE INDICATORS: S2 citations 40 and CrossRef is-referenced-by-count 23 (2026-09-30). Venue: Philosophical Explorations 22(2).},
    keywords = {kant, pp-ethics, debate-constructivism, type-article, Medium, summary-source-abstract},
}

@article{formosasticker2019beneficence,
    author = {Formosa, Paul and Sticker, Martin},
    title = {Kant and the demandingness of the virtue of beneficence},
    journal = {European Journal of Philosophy},
    year = {2019},
    volume = {27},
    number = {3},
    pages = {625--642},
    doi = {10.1111/ejop.12455},
    note = {SUMMARY: Interprets Kant's beneficence as a sweet spot between overdemandingness and undemandingness through four claims: the ground of our duty to benefit others also permits beneficence to ourselves; we may prioritise our own ends; it is more virtuous to do more rather than less in helping others; and indifference to others is vicious (publisher-record abstract retrieved via Macquarie University repository). SUBFIELD AND DEBATE: Practical philosophy, Metaphysics of Morals and the doctrine of virtue: imperfect duties and the overdemandingness objection; related to Sticker's Kant-Studien 2019 article on emergencies and to Sticker's Nous article on overdemandingness and self-scrutiny (print 2021). SIGNIFICANCE INDICATORS: S2 citations 19 and CrossRef is-referenced-by-count 21 (2026-09-30). Venue: European Journal of Philosophy 27(3).},
    keywords = {kant, pp-mm-virtue, pp-ethics, debate-other-demandingness, type-article, Medium, summary-source-web-abstract},
}

@book{kant2019groundwork,
    author = {Kant, Immanuel},
    editor = {Wood, Allen W.},
    title = {Groundwork for the Metaphysics of Morals},
    publisher = {Yale University Press},
    year = {2019},
    url = {https://doi.org/10.12987/9780300235722},
    note = {SUMMARY: A new edition of the Groundwork that offers an annotated translation said to be faithful to the German original, together with four essays: Schneewind on the historical relation of Kantian ethics to earlier and later ethical thought, Baron on moral motivation, and Kagan and Wood advancing contrasting interpretations of Kantian ethics and its practical implications (publisher abstract). SUBFIELD AND DEBATE: Edition and translation of the Groundwork with interpretive essays; the Kagan and Wood essays present competing readings of Kant's ethics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 45 (2026-09-30); S2 record conflates the work with the 1785 text (3258 citations) and is not used. Publisher: Yale University Press. NDPR review: none found (the NDPR search returned a review of a different Groundwork volume, excluded). YEAR NOTE: translation of Kant (1785); CrossRef year 2019; the abstract calls it a new edition.},
    keywords = {kant, pp-ethics, edition-trans, type-translation-edition, Medium, summary-source-abstract},
}

@book{ameriks2019subjects,
    author = {Ameriks, Karl},
    title = {Kantian Subjects: Critical Philosophy and Late Modernity},
    publisher = {Oxford University Press},
    year = {2019},
    doi = {10.1093/oso/9780198841852.001.0001},
    note = {SUMMARY: A collection of essays in two parts. The first reads the Critical philosophy's conception of subjectivity (freedom, autonomy, law, necessity, final ends, human vocation, intentionality, idealism), including new readings of the Groundwork in relation to Sartre, Murdoch, O'Neill, Prauss and Brandom. The second treats post-Kantians, especially Hegel, Schelling and Hölderlin, and their role in a historical turn and a conception of late modernity (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy (autonomy, self-determination) and reception in German idealism and Romanticism; continues Ameriks's line of interpreting Kant against sweeping readings of him as destroying metaphysics (NDPR review). SIGNIFICANCE INDICATORS: S2 citations 25 (title-matched record) and CrossRef is-referenced-by-count 18 (2026-09-30). Publisher: Oxford University Press. NDPR review: yes (ndpr.nd.edu/reviews/kantian-subjects-critical-philosophy-and-late-modernity). YEAR NOTE: essay collection; earlier publication dates of the individual essays are not recorded in the sources retrieved.},
    keywords = {kant, pp-ethics, recep-idealism, type-monograph, Medium, summary-source-abstract},
}

@book{huseyinzadegan2019nonideal,
    author = {Huseyinzadegan, Dilek},
    title = {Kant's Nonideal Theory of Politics},
    publisher = {Northwestern University Press},
    year = {2019},
    doi = {10.2307/j.ctvdtphp4},
    note = {SUMMARY: Extends the scholarship that takes Kant's empirical writings seriously to his political theory, arguing that Kant's politics has two guiding threads: an ideal theory of right that deduces political goals a priori, and a nonideal theory concerned with contingent features of history, culture and geography, which proceeds by the hypothetical, regulative and teleological use of reason (abstract text retrieved by the abstract resolver, which reads as review text). SUBFIELD AND DEBATE: Political philosophy: ideal versus nonideal theory in Kant's politics, tied to his philosophy of history and nature. SIGNIFICANCE INDICATORS: S2 citations 25 (title-matched record) and CrossRef is-referenced-by-count 23 (2026-09-30). Publisher: Northwestern University Press. Reviews: Wilford in Review of Metaphysics (2020), Dahbour in Journal of the History of Philosophy (2020), Shell in Kantian Review (2021). NDPR review: none found. SEP: listed in the kant-social-political bibliography.},
    keywords = {kant, pp-right-politics, anthro-hist-edu, debate-other-nonideal-theory, type-monograph, Medium, summary-source-review-text},
}

@book{valdez2019transnational,
    author = {Valdez, Inés},
    title = {Transnational Cosmopolitanism: Kant, Du Bois, and Justice as a Political Craft},
    publisher = {Cambridge University Press},
    year = {2019},
    doi = {10.1017/9781108630047},
    note = {SUMMARY: Reconstructs W. E. B. Du Bois's neglected post-World War I writings and political action as the basis of a normative account of transnational cosmopolitanism. It identifies limits in Kant's cosmopolitanism through a contextual account of Perpetual Peace, argues that these limits persist in neo-Kantian scholarship, and proposes a cosmopolitanism that is more radical, democratic and transnational (publisher abstract). SUBFIELD AND DEBATE: Political and cosmopolitan philosophy; critique of Kant's cosmopolitan right and its neo-Kantian inheritors from the standpoint of Du Bois, relevant to the Kant, empire and colonialism debate. SIGNIFICANCE INDICATORS: S2 citations 51 (title-matched record) and CrossRef is-referenced-by-count 74 (2026-09-30). Publisher: Cambridge University Press. Reviews: Nuti in Perspectives on Politics (2020) with a response by Valdez (CrossRef records). NDPR review: none found. SEP: listed in the kant-social-political bibliography.},
    keywords = {kant, pp-right-politics, recep-other, debate-colonialism, type-monograph, High, summary-source-abstract},
}

@article{insole2019freebelief,
    author = {Insole, Christopher},
    title = {Free Belief: The Medieval Heritage in Kant's Moral Faith},
    journal = {Journal of the History of Philosophy},
    year = {2019},
    volume = {57},
    number = {3},
    pages = {501--528},
    doi = {10.1353/hph.2019.0056},
    note = {SUMMARY: Argues that in describing faith as a free choice Kant aligns with the medieval tradition and with his own mediating sources (Leibniz, Locke), which invoke freedom and the will in belief in God without weakening commitment. Kant departs from that tradition only by holding that divine action would destroy genuine human freedom, which explains his insistence that grace follows rather than precedes moral conversion (journal abstract). SUBFIELD AND DEBATE: Philosophy of religion: moral faith, the will and belief, and grace in Kant's Religion and practical philosophy. SIGNIFICANCE INDICATORS: S2 citations 4 and CrossRef is-referenced-by-count 4 (2026-09-30). Venue: Journal of the History of Philosophy 57(3). The same author's Kant and the Divine (Oxford University Press) appears in 2020 book listings.},
    keywords = {kant, religion, debate-other-moral-faith, type-article, Low, summary-source-abstract},
}

@article{fisher2019organisms,
    author = {Fisher, Naomi},
    title = {Organisms and the form of freedom in Kant's third Critique},
    journal = {European Journal of Philosophy},
    year = {2019},
    volume = {27},
    number = {1},
    pages = {55--74},
    url = {https://doi.org/10.1111/ejop.12384},
    note = {SUMMARY: Offers an interpretation of the argument in the Appendix to the Critique of Teleological Judgment that human freedom is the final end of creation: judgments of freedom within nature are possible as instances of teleological judgment, so that nature as a whole is regarded as given laws from a supersensible ground, namely freedom. On this reading mechanism, teleology and freedom are unified in the supersensible, which also explains how the third Critique bridges the gulf between nature and freedom (journal abstract). SUBFIELD AND DEBATE: Aesthetics and teleology: teleological judgment and organisms, and the unity of nature and freedom in the Critique of the Power of Judgment. SIGNIFICANCE INDICATORS: S2 citations 7 and CrossRef is-referenced-by-count 6 (2026-09-30). Venue: European Journal of Philosophy 27(1). YEAR NOTE: CrossRef gives online publication 2018-07-24 and print issue March 2019; dated by print year.},
    keywords = {kant, aes-teleo, debate-other-teleology, type-article, Low, summary-source-abstract},
}

@misc{kleingeld2019sexismracism,
    author = {Kleingeld, Pauline},
    title = {On Dealing with Kant's Sexism and Racism},
    year = {2019},
    howpublished = {SGIR Review 2(2): 3--22. \url{https://philarchive.org/rec/KLEODW}},
    url = {https://philarchive.org/rec/KLEODW},
    note = {SUMMARY: Asks how current readers should deal with Kant's sexist and (until late in his life) racist views alongside his universalist moral theory. It rejects both setting these views aside and translating his egalitarian principles into inegalitarian ones, argues instead for highlighting the tensions that pervade Kant's theory, warns of risks in the use of inclusive language and female pronouns in discussions of Kant's moral and political philosophy, and states preconditions for using Kant's principles to criticise sexism and racism (abstract retrieved via CORE and a PhilArchive web search). SUBFIELD AND DEBATE: Anthropology, race and gender: how to read and teach Kant given his racism and sexism; a position between setting aside and translating, in the Kant and race and Kant and gender debates. SIGNIFICANCE INDICATORS: S2 citations 34 (2026-09-30); no DOI in CrossRef. Venue: SGIR Review (volume, issue and pages as reported by S2 and a web search; the journal name is not given in S2 or CORE output). Open access on PhilArchive.},
    keywords = {kant, anthro-hist-edu, debate-race, debate-gender, type-article, High, summary-source-abstract},
}

@article{howard2019transition,
    author = {Howard, Stephen},
    title = {The transition within the transition: the Übergang from the Selbstsetzungslehre to the ether proofs in Kant's Opus postumum},
    journal = {Kant-Studien},
    year = {2019},
    volume = {110},
    number = {4},
    pages = {595--617},
    doi = {10.1515/kant-2019-3002},
    note = {SUMMARY: Argues against readings such as Förster's that treat the ether proofs and the Selbstsetzungslehre as the core of the Opus postumum, holding that the drafts of fascicles X and XI, written between them, are of primary importance. Through a close reading of a page of fascicle XI it shows Kant trying to resolve problems internal to both by presenting a transition from one to the other, and it urges a renewed appreciation of the drafts as aspiring to a science of transition (journal abstract). SUBFIELD AND DEBATE: Late work, Opus postumum: the transition project and the Selbstsetzungslehre, in dialogue with Förster's interpretation. SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 2 (2026-09-30). Venue: Kant-Studien 110(4). Included mainly to cover the Opus postumum cell; the other 2019 Opus postumum items found in S2 and CrossRef searches are lower-cited articles, a review, or Zenodo items.},
    keywords = {kant, opus-postumum, debate-other-transition, type-article, Low, summary-source-abstract},
}
