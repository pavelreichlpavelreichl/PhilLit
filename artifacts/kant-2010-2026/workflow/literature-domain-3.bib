@book{stang2016modal,
    author = {Stang, Nicholas F.},
    title = {Kant's Modal Metaphysics},
    publisher = {Oxford University Press},
    year = {2016},
    doi = {10.1093/acprof:oso/9780198712626.001.0001},
    note = {SUMMARY: Studies Kant's theory of possibility from the pre-Critical work of the 1750s and 1760s to the Critical system of the 1780s and early 1790s. It argues that the continuity and change between the two periods turn on Kant's transforming the ontological question about what all possible beings have in common into a transcendental question about how we represent possible objects a priori (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: Kant's modal metaphysics, tracing the pre-Critical to the Critical theory of possibility. Bears on the debate over the metaphysical significance of transcendental idealism and on the development of Kant's thought. SIGNIFICANCE INDICATORS: S2 citations: 186 (DOI-matched record, retrieved 2026-09-30); CrossRef is-referenced-by-count: 108. Publisher: Oxford University Press. NDPR review: Andrew Chignell (2017). SEP: listed in the kant-religion bibliography and cited in its section 1 (see sep_context).},
    sep_context = {SEP entry kant-religion (Kant's Philosophy of Religion), section 1 Overview, cites Stang 2016 for the reading of Kant's modal metaphysics as an attempted articulation of a metaphysical alternative to Leibnizian logicism, the view that anything not logically contradictory is possible.},
    keywords = {kant, tp-cpr, precritical, debate-other-modality, type-monograph, High},
    abstract = {Abstract This book is a study of Kant's theory of possibility, starting from the so-called 'pre-Critical' period of the 1750s and 1760s, through the Critical system of philosophy Kant published in the 1780s and the early 1790s. It discusses Kant's confrontation with the ontological theory of all possible beings shared by many of his rationalist predecessors, his own positive theory of possibility in the 1760s, and his distinctively Critical theory of possibility in the 1780s. It argues that the key to understanding both the change and the continuity between Kant's pre-Critical and his Critical theory of possibility is that he comes to believe that the ontological question about possibility (what do all possible beings have in common?) must be transformed into a question in 'transcendental philosophy': how do we represent possible objects a priori? It explores Kant's theory of possibility before he reoriented his theory around that question, why he believed that reorientation was necessary, what this transcendental question means, and his own answer to it. Possibility becomes one of the three "categories of modality" in the Critique, along with actuality/existence and necessity. Consequently, this book also investigates Kant's views about what distinguishes actuality from mere possibility, his theory of the closely related notion of existence, and his theory of necessity, including, crucially, his theory of necessary existence.},
    abstract_source = {openalex},
}

@article{mclear2016perceptual,
    author = {McLear, Colin},
    title = {Kant on Perceptual Content},
    journal = {Mind},
    year = {2016},
    volume = {125},
    number = {497},
    pages = {95--144},
    doi = {10.1093/mind/fzv191},
    note = {SUMMARY: Argues that although Kant is widely read as endorsing the Content View (perceptual states have intentional content and represent ways the world might be), this reading faces significant problems. It proposes instead that Kant holds a form of acquaintance theory of perception (journal abstract). SUBFIELD AND DEBATE: Theoretical philosophy and philosophy of mind: Kant's theory of perception and intuition. Opposes the Content View of perception in favour of an acquaintance reading, which bears on the perceptual-content, nonconceptualism and naive-realist debates. SIGNIFICANCE INDICATORS: S2 citations: 58 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 20. Venue: Mind 125(497). Not located in the SEP bibliographies retrieved. YEAR NOTE: CrossRef print date 2016-01 (issue 497), online 2016-02-12.},
    keywords = {kant, tp-mind, tp-cpr, debate-conceptualism, type-article, Medium},
    abstract = {Call the idea that states of perceptual awareness have intentional content, and in virtue of that aim at or represent ways the world might be, the ‘Content View.’ I argue that though Kant is widely interpreted as endorsing the Content View there are significant problems for any such interpretation. I further argue that given the problems associated with attributing the Content View to Kant, interpreters should instead consider him as endorsing a form of acquaintance theory. Though perceptual acquaintance is controversial in itself and in attribution to Kant, it promises to make sense of central claims within his critical philosophy.},
    abstract_source = {openalex},
}

