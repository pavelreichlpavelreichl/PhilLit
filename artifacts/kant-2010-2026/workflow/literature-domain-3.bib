    doi = {10.1093/oso/9780198783886.001.0001},
    note = {SUMMARY: Eleven essays on Alexander Baumgarten's Metaphysics and its relation to Kant's philosophy. Early chapters set Baumgarten's work in its historical context, including Pietism and rationalism, and later chapters explore how Kant criticized and built on the Metaphysics (publisher abstract). SUBFIELD AND DEBATE: Pre-critical work and early modern background: Kant's debt to and criticism of Baumgarten, whose textbook he used in lecturing. SIGNIFICANCE INDICATORS: S2 citations: 27 (retrieved 2026-09-30); CrossRef is-referenced-by-count: 10. Publisher: Oxford University Press. NDPR review: Oliver Thorndike (2019). YEAR NOTE: CrossRef print date 2018-07-19.},
    keywords = {kant, precritical, tp-cpr, type-edited-volume, Medium},
    abstract = {This volume collects together eleven essays on Alexander Baumgarten’s Metaphysics and its relation to the philosophy of Immanuel Kant. The early chapters examine Baumgarten’s philosophy in its historical context, including its link with both Pietism and rationalism. The later chapters explore the many ways in which Kant criticized and built upon Baumgarten’s Metaphysics.},
    abstract_source = {s2},
}

@book{kantreligion2018,
    author = {Kant, Immanuel},
    editor = {Wood, Allen and di Giovanni, George},
    title = {Kant: Religion within the Boundaries of Mere Reason: And Other Writings},
    publisher = {Cambridge University Press},
    year = {2018},
    doi = {10.1017/9781316569894},
    note = {SUMMARY: New edition of the Cambridge Texts edition of Religion within the Boundaries of Mere Reason, with slightly revised translations, a revised introduction expanding on key themes, and up-to-date guidance on further reading. The work spells out a religion grounded in moral reason and treats original sin, justification and the proper role of a church (publisher abstract). SUBFIELD AND DEBATE: Edition and translation in the Cambridge Texts in the History of Philosophy; Kant's philosophy of religion (radical evil, moral faith, the ethical community). SIGNIFICANCE INDICATORS: S2 citations: 14 (title-matched record, retrieved 2026-09-30); CrossRef is-referenced-by-count: 43. Series: Cambridge Texts in the History of Philosophy, Cambridge University Press. NDPR review: none located. YEAR NOTE: New edition of the 1998 Cambridge Texts edition, translation of Kant (1793); CrossRef print date 2018-02-22, online 2019-09-14.},
    keywords = {kant, edition-trans, religion, type-translation-edition, Medium},
    abstract = {Religion within the Boundaries of Mere Reason is a key element of the system of philosophy which Kant introduced with his Critique of Pure Reason, and a work of major importance in the history of Western religious thought. It represents a great philosopher's attempt to spell out the form and content of a type of religion that would be grounded in moral reason and would meet the needs of ethical life. It includes sharply critical and boldly constructive discussions on topics not often treated by philosophers, including such traditional theological concepts as original sin and the salvation or 'justification' of a sinner, and the idea of the proper role of a church. This new edition includes slightly revised translations, a revised introduction with expanded discussion of certain key themes in the work, and up-to-date guidance on further reading.},
    abstract_source = {openalex},
}

@book{naturfreiheit2018,
    editor = {Waibel, Violetta L. and Ruffing, Margit and Wagner, David},
