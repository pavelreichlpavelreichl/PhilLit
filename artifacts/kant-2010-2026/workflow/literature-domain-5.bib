@book{lambeth2023heidegger,
    author = {Lambeth, Morganna},
    title = {Heidegger's Interpretation of Kant: The Violence and the Charity},
    publisher = {Cambridge University Press},
    year = {2023},
    doi = {10.1017/9781009239271},
    note = {SUMMARY: Gives a new account of Heidegger's method of interpreting Kant, arguing that it is more promising than usually recognized, which has limited its uptake in anglophone Kant scholarship. On the account, Heidegger finds Kant's greatest insights in moments of tension where Kant struggles to articulate something new, so that the interpreter must disentangle competing strands of argument and decide which is most compelling; the book traces this method through Heidegger's reading of the Critique of Pure Reason, situates it against other post-Kantian readings, and shows how the engagement bears on Heidegger's own views (publisher abstract). SUBFIELD AND DEBATE: Reception (phenomenology): Heidegger's Kant interpretation and the question of interpretive method, set against the charge that Heidegger reads himself into the philosophers he interprets. SIGNIFICANCE INDICATORS: S2 citations 12 and CrossRef is-referenced-by-count 10 (retrieved 2026-10-01). Publisher: Cambridge University Press. No review found by CrossRef search; the NDPR search returned an unrelated review. YEAR NOTE: CrossRef gives online publication 2023-06-01 and print publication 2023-07-31.},
    keywords = {kant, recep-phenom, debate-other-heidegger-kant, type-monograph, Medium, summary-source-abstract}
}

