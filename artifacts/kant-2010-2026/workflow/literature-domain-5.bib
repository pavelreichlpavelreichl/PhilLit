@book{schaferstang2022sensible,
    editor = {Schafer, Karl and Stang, Nicholas F.},
    title = {The Sensible and Intelligible Worlds: New Essays on Kant's Metaphysics and Epistemology},
    publisher = {Oxford University Press},
    year = {2022},
    doi = {10.1093/oso/9780199688265.001.0001},
    note = {SUMMARY: Collects essays by analytically trained Kant scholars on "the metaphysical Kant", that is, on the metaphysical presuppositions of Kant's philosophy and how they square with his critique of dogmatic metaphysics. The chapters draw on Leibnizian and Aristotelian backgrounds and on links to German Idealism, and cover transcendental idealism, Kant's modal metaphysics, the continuum, the epistemology of the a priori and the foundations of his metaethical views (publisher abstract). SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: metaphysical readings of transcendental idealism, set against the earlier tendency in analytic Kant scholarship to read Kant as anti-metaphysical. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 12 (retrieved 2026-10-01); the title-matched S2 record shows 0 citations. Publisher: Oxford University Press. Reviews: Kantian Review (Callanan, 2025), Kant-Studien (Kohl, 2025). SEP: a chapter of the volume is cited in the kant-conceptualism entry bibliography. NDPR review: not found.},
    keywords = {kant, tp-cpr, debate-other-metaphysical-kant, type-edited-volume, Medium, summary-source-abstract},
    abstract = {Abstract For much of its history, analytic Kant scholarship has been dominated by the idea of Kant as a deeply anti-metaphysical philosopher. But in the last quarter century, analytically inclined Kant scholars have increasingly become skeptical of interpreting Kant as a philosopher who wished to truly “leave metaphysics behind.” Although such readings interpret Kant’s metaphysics in radically different ways, they share a common commitment to the idea that Kant’s philosophy cannot be properly understood without careful attention to its metaphysical presuppositions and, in particular, to how those metaphysical presuppositions are compatible with Kant’s critique of more “dogmatic” forms of metaphysical thought. This volume brings together a variety of leading figures in this renaissance in interest in “the metaphysical Kant.” These authors approach Kant’s thought from a wide variety of different perspectives—emphasizing, not just the familiar Leibnizian background to Kant’s metaphysics, but also its broadly Aristotelian underpinnings and its relationship with metaphysical themes in post-Kantian German Idealism. Similarly, although most of the chapters in this volume relate in some way to the familiar question of how to best interpret Kant’s transcendental idealism, they also deal with a wide range of other topics, ranging from Kant’s modal metaphysics to his views on the continuum to his epistemology of the a priori to the foundations of his “metaethical” views. Thus, we hope this volume will contribute to longstanding debates about the metaphysical and epistemological foundations of Kant’s project, while also opening up new topics in Kant scholarship.},
    abstract_source = {openalex},
}

@article{gomes2022categories,
    author = {Gomes, Anil and Moore, A. W. and Stephenson, Andrew},
    title = {On the Necessity of the Categories},
    journal = {The Philosophical Review},
    year = {2022},
    volume = {131},
    number = {2},
    pages = {129--168},
    doi = {10.1215/00318108-9554678},
    note = {SUMMARY: Asks whether Kant leaves open the possibility of discursive cognizers whose pure forms of understanding, the categories, differ from ours, as he leaves open creatures with different pure forms of sensibility. It argues that textual and systematic considerations do not settle the question, and that Kant's wider views on the limits of our knowledge of mind allow him to stay neutral, though the form this neutrality can take is subject to unexpected constraints; the result is an asymmetry between other forms of sensibility and other categories, in which "Kantian humility" takes a distinctive character (abstract). SUBFIELD AND DEBATE: Theoretical philosophy, Transcendental Deduction and the status of the categories: the necessity of the categories for finite discursive cognizers, and Kantian humility. SIGNIFICANCE INDICATORS: S2 citations 11 and CrossRef is-referenced-by-count 7 (retrieved 2026-10-01). Venue: The Philosophical Review 131(2).},
    keywords = {kant, tp-cpr, debate-other-humility, type-article, Medium, summary-source-abstract},
    abstract = {For Kant, the human cognitive faculty has two subfaculties: sensibility and the understanding. Each has pure forms that are necessary to us as humans: space and time for sensibility; the categories for the understanding. But Kant is careful to leave open the possibility of there being creatures like us, with both sensibility and understanding, who nevertheless have different pure forms of sensibility. They would be finite rational beings and discursive cognizers. But they would not be human. And this raises a question about the pure forms of the understanding. Does Kant leave open the possibility of discursive cognizers who have different categories? Even if other discursive cognizers might not sense like us, must they at least think like us? This essay argues that textual and systematic considerations do not determine the answers to these questions, and it examines whether Kant thinks that the issue cannot be decided. Consideration of his wider views on the nature and limits of our knowledge of mind shows that Kant could indeed remain neutral on the issue but that the exact form his neutrality can take is subject to unexpected constraints. The result would be an important difference between what Kant says about discursive cognizers with other forms of sensibility and what he is in a position to say about discursive cognizers with other forms of understanding. Kantian humility here takes on a distinctive character.},
    abstract_source = {s2},
}

@article{pendlebury2022mind,
    author = {Pendlebury, T. A.},
    title = {The Shape of the Kantian Mind},
    journal = {Philosophy and Phenomenological Research},
    year = {2022},
    volume = {104},
    number = {2},
    pages = {364--387},
    url = {https://doi.org/10.1111/phpr.12767},
    note = {SUMMARY: Argues that both conceptualist and nonconceptualist readers of Kant wrongly assume that concepts are involved in intuition only as particular concepts applied in particular exercises of sensibility. On the author's view no concepts are applied in exercises of sensibility, yet the understanding is teleologically internal to sensibility, whose exercises are directed to providing objects to which the categories are applicable; this picture rests on a distinction between capacities and acts and is said to be demanded by Kant's account of a priori knowledge in the Transcendental Deduction (abstract retrieved from the CrossRef record). SUBFIELD AND DEBATE: Theoretical philosophy and mind: the conceptualism versus nonconceptualism debate about the relation of sensibility and understanding, which the paper aims to reframe. SIGNIFICANCE INDICATORS: S2 citations 12 and CrossRef is-referenced-by-count 9 (retrieved 2026-10-01). Venue: Philosophy and Phenomenological Research 104(2). SEP: cited in the kant-conceptualism entry bibliography. YEAR NOTE: CrossRef gives online publication 2021-03-08 and print publication 2022-03 (volume 104, issue 2); dated by print year.},
    keywords = {kant, tp-mind, tp-cpr, debate-conceptualism, type-article, Medium, summary-source-abstract},
    abstract = {Kant's readers have disagreed about whether, according to his account of cognition, concepts, representations of the understanding, are involved in intuitions, representations of sensibility. But proponents of the affirmative 'conceptualist' answer and those of the negative 'non- conceptualist' answer have alike presupposed that such involvement should be construed in a particular way: i.e},
    abstract_source = {s2}
}

@book{mcnulty2022mfnw,
    editor = {McNulty, Michael Bennett},
    title = {Kant's Metaphysical Foundations of Natural Science: A Critical Guide},
    publisher = {Cambridge University Press},
    year = {2022},
    doi = {10.1017/9781108661072},
    note = {SUMMARY: Critical Guide to the 1786 Metaphysical Foundations of Natural Science, which accounts for an acting-at-a-distance gravitational force, demonstrates the infinite divisibility of matter and derives analogues to Newton's laws of motion. Its chapters clarify the accounts of matter, motion, the mathematization of nature, space and natural laws, relate the metaphysics of nature to the critical philosophy, and describe the historical context of the work (publisher abstract). SUBFIELD AND DEBATE: Philosophy of science and the metaphysics of nature: the Metaphysical Foundations and its relation to the Critique of Pure Reason and to Newtonian physics; the volume presents the text as under-studied. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 1 and S2 citations 4 (retrieved 2026-10-01); citation counts are low for a 2022 volume. Publisher: Cambridge University Press, Cambridge Critical Guides. Reviews: Kantian Review (Hyder, 2024), Journal of the History of Philosophy (Engelhard, 2025), HOPOS (Demarest, 2026). SEP: listed in the kant-science entry bibliography. NDPR review: not found.},
    keywords = {kant, tp-science-math, debate-other-natural-science, type-edited-volume, High, summary-source-abstract},
    sep_context = {SEP entry kant-science (Kant's Philosophy of Science), section 5 Phenomenology, cites McNulty 2022: two chapters (by De Bianchi and Massimi) in the volume add to our understanding of Kant on absolute space and true motion in the Phenomenology chapter of the Metaphysical Foundations, a part of the work for which the entry says there is relatively little secondary literature before Friedman's interpretation.},
    abstract = {In his Metaphysical Foundations of Natural Science (1786), Kant accounts for the possibility of an acting-at-a-distance gravitational force, demonstrates the infinite divisibility of matter, and derives analogues to Newtonian laws of motion. The work is his major statement in philosophy of science, and was especially influential in German-speaking countries in the nineteenth century. However, this complex text has not received the scholarly attention it deserves. The chapters of this Critical Guide clarify the accounts of matter, motion, the mathematization of nature, space, and natural laws exhibited in the Metaphysical Foundations; elucidate the relationship between its metaphysics of nature and Kant's critical philosophy; and describe the historical context for Kant's account of natural science. The volume will be an invaluable resource for understanding one of Kant's most difficult works, and will set the agenda for future scholarship on Kant's philosophy of science.},
    abstract_source = {openalex},
}

@book{timmons2022virtue,
    author = {Timmons, Mark},
    title = {Kant's Doctrine of Virtue: A Guide},
    publisher = {Oxford University Press},
    year = {2022},
    url = {https://doi.org/10.1093/oso/9780190939229.001.0001},
    note = {SUMMARY: Reader's guide to the Doctrine of Virtue, Part II of Kant's 1797 Metaphysics of Morals, in five parts. It covers the background and the general introduction to the Metaphysics of Morals, then the Doctrine of Virtue's introduction (ends that are also duties, radical evil and the nature of virtue, the science of ethics), the system of duties to oneself, duties of love, vices and friendship, and finally moral education and practice (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy, Metaphysics of Morals and virtue: a commentary on the normative ethical theory of the Doctrine of Virtue and on how it grounds specific duties. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 11 and S2 citations 1 (retrieved 2026-10-01). Publisher: Oxford University Press. SEP: listed in the kant-moral entry bibliography (dated 2021). No review found by CrossRef search. YEAR NOTE: CrossRef gives online publication 2021-06-17 and print publication 2022-05-26, and the SEP lists 2021; dated by print year per the project rule.},
    keywords = {kant, pp-mm-virtue, debate-other-virtue, type-monograph, Medium, summary-source-abstract},
    abstract = {This book is a reader’s guide to Kant’s final work in moral philosophy, The Doctrine of Virtue, Part II of the 1797 Metaphysics of Morals. The guide has five parts plus a conclusion. Part I, “Background,” includes two chapters: 1. “Life and Work” and 2. “Philosophical Background.” Part II, “General Introduction to The Metaphysics of Morals,” covers the introduction to the entire work and includes three chapters: 3. “On the Idea of and Necessity for a Metaphysics of Morals,” 4. “Mental Faculties, the Moral Law, and Human Motivation,” and 5. “Preliminary Concepts and Division of the Metaphysics of Morals.” Part III, “Introduction to The Doctrine of Virtue,” includes four chapters covering Kant’s dedicated introduction to the Doctrine of Virtue: 6. “The Doctrine of Virtue as a Doctrine of Ends,” 7. “General Ends that Are Also Duties,” 8. “Radical Evil and the Nature of Virtue,” and 9. “The Science of Ethics.” Part IV, “The Doctrine of Elements,” is devoted to Kant’s system of duties of virtue that represents his normative ethical theory. It contains six chapters: 10. “Perfect Duties to Oneself as an Animal Being,” 11. “Perfect Duties to Oneself Merely as a Moral Being,” 12. Imperfect Duties to Oneself,” 13. “Duties of Love to Other Human Beings,” 14. “The Vices of Hatred and Disrespect,” and 15. “Friendship.” Part V, “The Doctrine of Methods of Ethics and Conclusion,” includes chapter 16 “Moral Education and Practice.” The book’s conclusion reflects on the significance of The Doctrine of Virtue for understanding Kant’s ethics.},
    abstract_source = {s2}
}

@book{herman2022commitments,
    author = {Herman, Barbara},
    title = {Kantian Commitments: Essays on Moral Theory and Practice},
    publisher = {Oxford University Press},
    year = {2022},
    doi = {10.1093/oso/9780192844965.001.0001},
    note = {SUMMARY: Ten essays that rethink fundamentals of Kant's ethics. Part One revisits the formulas of the categorical imperative, the idea of making exceptions, and the contrast between Kant's project and other deontologies, especially recent contractualism, reading Kant as giving a theory of moral reasoning with standards of validity and soundness. Part Two takes up Kant's moralized view of history, social pluralism, Kantian moral psychology and normal human development, the argument about duties to animals, and the highest good in a morally good life (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy: the Groundwork formulas, moral judgment and moral psychology, with a programme of rereading core arguments more straightforwardly. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 7 and S2 citations 1 (retrieved 2026-10-01). Publisher: Oxford University Press. Reviews: Kant-Studien (Pozzo, 2025), Journal of Moral Philosophy (Kanwischer, 2026). NDPR review: not found. YEAR NOTE: a collection of essays, dated by the collection year; original publication dates of the essays were not retrieved.},
    keywords = {kant, pp-ethics, debate-other-moral-reasoning, type-monograph, Medium, summary-source-abstract},
    abstract = {The ten essays collected here represent a series of efforts to rethink many of the fundamentals of Kant’s ethics and to draw out some implications for moral theory and practice. The five essays of Part One revisit and revise several core pieces of Kant’s moral framework, offering a new understanding of the formulas of the categorical imperative, revisiting the idea of making exceptions, and deepening the contrast between Kant’s project and other deontologies (especially recent contractualisms). The key is to take seriously the idea that what Kant gives us is a theory of moral reasoning, with standards of validity and soundness that position moral judgment to explicate the connection between our rational natures and our duties. Part Two takes on some less familiar topics: the ideas behind Kant’s moralized view of history; the implications of a Kantian view of morality for social pluralism; the fit of Kant’s conception of moral psychology with theories of normal human development; the implausible argument about our duties to animals; and last, how to understand the place of the idea of the highest good in a morally good life. The overall aim of these essays is to show that we are far from having a settled account of core Kantian commitments and to initiate a program of inquiry to peel away assumptions brought to the texts that introduce questions their arguments were not meant to answer. The more straightforward readings of central arguments remove obstacles to appreciating Kantian theory’s ambition and scale.},
    abstract_source = {s2},
}

@book{pascoe2022labour,
    author = {Pascoe, Jordan},
    title = {Kant's Theory of Labour},
    publisher = {Cambridge University Press},
    year = {2022},
    doi = {10.1017/9781009165754},
    note = {SUMMARY: Examines Kant's account of labour in his political philosophy and develops an intersectional analysis of Kant. It argues that Kant's treatments of slavery, citizenship and sex developed in linked ways, ending in a trichotomy of Right, so that his normative account of independence is built on his theory of labour and continuous with his anthropological accounts of race and gender, giving a systematic justification for the dependency of women and non-whites; it adds that Kant's eventual rejection of slavery may owe more to his changing conception of labour than to his theory of race (publisher abstract). SUBFIELD AND DEBATE: Political and legal philosophy, Doctrine of Right, with anthropology: Kant and race and gender, independence and passive citizenship. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 48; S2 citations 44 in the search record (the title-matched batch record shows 0) (retrieved 2026-10-01). Publisher: Cambridge University Press, Elements in the Philosophy of Immanuel Kant. SEP: listed in the kant-social-political entry bibliography. Further evidence seen in web search results: a Kantian Review book discussion and an author Response to Critics (2024). NDPR review: not found.},
    keywords = {kant, pp-right-politics, anthro-hist-edu, debate-race, debate-gender, type-monograph, High, summary-source-abstract},
    abstract = {This Element examines Kant's innovative account of labour in his political philosophy and develops an intersectional analysis of Kant. By demonstrating that Kant's analysis of slavery, citizenship, and sex developed in inter-linked ways over several decades, culminating in his development of a 'trichotomy' of Right, the author shows that Kant's normative account of independence is configured through his theory of labour, and is continuous with his anthropological accounts of race and gender, providing a systemic justification for the dependency of women and non-whites embedded in his philosophy of right. By examining Kant's arguments about slavery as intertwined with his account of domestic labour, the author argues that his ultimate rejection of slavery may owe more to his changing conceptualization of labour than to his theory of race, and that his final arguments against slavery rehearse strategies for embedding intersectional patterns of domestic dependence in his account of the rightful state.},
    abstract_source = {s2},
}

@article{stone2022provisional,
    author = {Stone, Martin Jay and Hasan, Rafeeq},
    title = {What Is Provisional Right?},
    journal = {The Philosophical Review},
    year = {2022},
    volume = {131},
    number = {1},
    pages = {51--98},
    doi = {10.1215/00318108-9415141},
    note = {SUMMARY: Resolves the apparent contradiction in Kant's claim that property claims are possible but merely provisional in the state of nature and conclusive only in a civil condition. The authors argue that provisional right is not a special kind of right but marks the imperfection of an action, that of acquiring ordinary rights, where public authorization is lacking, and that it works as a methodological device in a sequential exposition of the moral basis of public law; they develop this from Kant's two-step account of having and acquiring (abstract). SUBFIELD AND DEBATE: Political and legal philosophy, Doctrine of Right: private right, property and the transition to public right, answering commentators who find the doctrine puzzling. SIGNIFICANCE INDICATORS: S2 citations 15 and CrossRef is-referenced-by-count 19 (retrieved 2026-10-01). Venue: The Philosophical Review 131(1).},
    keywords = {kant, pp-right-politics, debate-other-property, type-article, Medium, summary-source-abstract},
    abstract = {Kant maintains that while claims to property are morally possible in a state of nature, such claims are merely “provisional”; they become “conclusive” only in a civil condition involving political institutions. Kant’s commentators find this thesis puzzling, since it seems to assert a natural right to property alongside a commitment to property’s conventionality. We resolve this apparent contradiction. Provisional right is not a special kind of right. Instead, it marks the imperfection of an action (that of acquiring ordinary rights) where public authorization is lacking. Provisional right thereby functions as a methodological device in a sequential elucidation of the moral basis of public law. To develop this reading, we first explain Kant’s two-step account of property rights—his division between ‘having’ and ‘acquiring’. Then we explain what is involved in a sequential exposition of right more generally.},
    abstract_source = {s2},
}

@book{geiger2022empirical,
    author = {Geiger, Ido},
    title = {Kant and the Claims of the Empirical World: A Transcendental Reading of the Critique of the Power of Judgment},
    publisher = {Cambridge University Press},
    year = {2022},
    doi = {10.1017/9781108992565},
    note = {SUMMARY: Argues that a principal concern of the third Critique is to complete the account of the transcendental conditions of empirical experience and knowledge, covering both Kant's analysis of natural beauty and his teleological judgments of organisms and of nature generally; on this reading the third Critique forms a unified whole and supplies the final part of the transcendental undertaking (publisher abstract). The NDPR review adds that the thread of the reading is the principle of the logical purposiveness of nature, and describes the book as a bold new account of the unity and structure of the third Critique, with some of its claims controversial. SUBFIELD AND DEBATE: Aesthetics and teleology: the unity of the Critique of the Power of Judgment and its place in the critical system, linked to the transcendental conditions of empirical cognition. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 17 and S2 citations 16 (retrieved 2026-10-01). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-the-claims-of-the-empirical-world-a-transcendental-reading-of-the-critique-of-the-power-of-judgment). Other reviews: Kantian Review (Hamid, 2023), Kant-Studien (Spiliotakaras, 2024), Philosophy (Zinkin, 2025).},
    keywords = {kant, aes-teleo, tp-cpr, debate-other-purposiveness, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {Kant announces that the Critique of the Power of Judgment will bring his entire critical enterprise to an end. But it is by no means agreed upon that it in fact does so and, if it does, how. In this book, Ido Geiger argues that a principal concern of the third Critique is completing the account of the transcendental conditions of empirical experience and knowledge. This includes both Kant's analysis of natural beauty and his discussion of teleological judgments of organisms and of nature generally. Geiger's original reading of  the third Critique shows that it forms a unified whole - and that it does in fact deliver the final part of Kant's transcendental undertaking. His book will be valuable to all who are interested in Kant's theory of the aesthetic and conceptual purposiveness of nature.},
    abstract_source = {s2},
}

@article{luadler2022savagery,
    author = {Lu-Adler, Huaping},
    title = {Kant on Lazy Savagery, Racialized},
    journal = {Journal of the History of Philosophy},
    year = {2022},
    volume = {60},
    number = {2},
    pages = {253--275},
    doi = {10.1353/hph.2022.0017},
    note = {SUMMARY: Argues that Kant develops a concept of savagery, partly characterized by laziness, for a programme of human progress, and racializes it by treating native Americans as literal savages with a hereditary physiological laziness. Because perfection must be reached through industry, a condition Kant denies to the supposed savages, the racialization blocks any prospect of fulfilling their perfections despite their having the same germs as Europeans; the case is said to shed light on the debated relation between Kant's moral universalism and his racism (abstract). SUBFIELD AND DEBATE: Anthropology, philosophy of history and race: Kant and race, and whether moral universalism and racism can be held together; a companion piece by the same author in the same year is on Kant and slavery (Critical Philosophy of Race). SIGNIFICANCE INDICATORS: S2 citations 30 and CrossRef is-referenced-by-count 31 (retrieved 2026-10-01). Venue: Journal of the History of Philosophy 60(2). Other 2022 items on Kant and race found in the same searches have lower counts (for example Lu-Adler on slavery 30 in CrossRef, Marwah 18).},
    keywords = {kant, anthro-hist-edu, debate-race, debate-colonialism, type-article, High, summary-source-abstract},
    abstract = {abstract:Kant develops a concept of savagery, partly characterized by laziness, to envision a program for human progress. He also racializes savagery, treating native Americans, in particular, as literal "savages." He ascribes to this "race" a peculiar physiological laziness, a supposedly hereditary trait of blunted life power. Accordingly, while he grants them the same "germs" for perfections as he does the "civilized" Europeans, he allows them no prospect of fulfilling any such perfection. For the road to perfection must be paved through industry, a condition that Kant denies to the "savages" by racializing their alleged laziness. This case will shed new light on the debated relation between Kant's moral universalism and his racism.},
    abstract_source = {s2},
}

@book{rosen2022shadow,
    author = {Rosen, Michael},
    title = {The Shadow of God: Kant, Hegel, and the Passage from Heaven to History},
    publisher = {Harvard University Press},
    year = {2022},
    doi = {10.4159/9780674276055},
    note = {SUMMARY: Argues that many apparently secular modern ideas were shaped by religion, with the German Idealists as the key thinkers seeking to reconcile faith and reason. For Kant, if God assigns us to heaven or hell for eternity we must know what is required and be able to choose freely, and in pursuing the moral law we work with others in a "Church invisible" toward justice in history; later Idealists, dropping personal immortality, put "historical immortality" through social projects at the centre (publisher description). The NDPR review calls the book a display of erudition and finds in it in effect two books. SUBFIELD AND DEBATE: Religion and reception (Kant to Hegel): the secularization of religious structures of thought, the ethical community and moral progress in history. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 2 (retrieved 2026-10-01). Publisher: Harvard University Press. NDPR review: yes (ndpr.nd.edu/reviews/the-shadow-of-god-kant-hegel-and-the-passage-from-heaven-to-history). Other reviews and discussion found by CrossRef search: Theology (Trigg, 2022), Idealistic Studies (2023), symposia in The Review of Politics (2023) and Critical Review (2023), Journal of the History of Philosophy (Winegar, 2025), Journal of the Philosophy of History (2025). YEAR NOTE: CrossRef gives online publication 2022-05-18 and print publication 2022-12-31.},
    keywords = {kant, religion, recep-idealism, debate-other-secularization, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {A bold and beautifully written exploration of the “afterlife” of God, showing how apparently secular habits of mind in fact retain the structure of religious thought. Once in the West, our lives were bounded by religion. Then we were guided out of the darkness of faith, we are often told, by the cold light of science and reason. To be modern was to reject the religious for the secular and rational. In a bold retelling of philosophical history, Michael Rosen explains the limits of this story, showing that many modern and apparently secular ideas were in fact profoundly shaped by religion. The key thinkers, Rosen argues, were the German Idealists, as they sought to reconcile faith and reason. It was central to Kant’s philosophy that, if God is both just and assigns us to heaven or hell for eternity, we must know what is required of us and be able to choose freely. As we thus pursue the moral law, Kant argued, we are engaged in a collective enterprise as members of a “Church invisible” working together to achieve justice in history. As later Idealists moved away from Kant’s ideas about personal immortality, this idea of “historical immortality” took center stage. Through social projects that outlive us we maintain a kind of presence after death. Conceptions of historical immortality moved not just into the universalistic ideologies of liberalism and revolutionary socialism but into nationalist and racist doctrines that opposed them. But how, after global wars and genocide, can we retain faith in any conception of shared moral progress? That is our present predicament. A seamless blend of philosophy and intellectual history, The Shadow of God is a profound exploration of secular modernity’s theistic inheritance.},
    abstract_source = {openalex},
}

@book{kant2022traume,
    author = {Kant, Immanuel},
    title = {Träume eines Geistersehers, erläutert durch Träume der Metaphysik. Historisch-kritische Edition},
    publisher = {Felix Meiner Verlag},
    year = {2022},
    doi = {10.28937/978-3-7873-3959-4},
    note = {SUMMARY: New edition of Kant's 1766 Dreams of a Spirit-Seer, edited with introduction and notes by Lothar Kreimendahl and Michael Oberhausen (editors named in web search results for the Meiner edition). The publisher describes it as presenting Kant's text for the first time in historical-critical form, with German translations of the passages from Swedenborg's Arcana Coelestia to which Kant refers, and extensive commentary linking the treatise to contemporary philosophy and to Kant's pre-critical and critical works; the text is read as turning a critique of Swedenborg into a rejection of traditional metaphysics and as already containing basic features of Kant's moral philosophy (publisher description). SUBFIELD AND DEBATE: Pre-critical work and editions: the 1766 treatise as the end of the pre-critical phase and a precursor of the critique of metaphysics. SIGNIFICANCE INDICATORS: New critical edition of a Kant text (Meiner, Philosophische Bibliothek series); CrossRef is-referenced-by-count 0; no S2 record and no review found (2026-10-01). YEAR NOTE: edition of a text first published by Kant in 1766; dated by the 2022 edition year.},
    keywords = {kant, precritical, edition-trans, debate-other-metaphysics-critique, type-translation-edition, Medium, summary-source-abstract},
    abstract = {Diese Kritik weitet sich zu einer Ablehnung der gesamten herkömmlichen Metaphysik aus, deren Scheitern Kant zum Anlass nimmt, nach der angemessenen Methode in der Philosophie zu fragen. Als solche empfiehlt er die Hinwendung zu erfahrungswissenschaftlichen Verfahren. Damit hat Kant bereits wesentliche Momente seiner späteren Vernunftkritik erarbeitet. Aber auch die praktische Philosophie profitiert von der im Geist des Skeptizismus und im Tonfall ironisch­sarkastischer Redeweise durchgeführten Untersuchung. Es zeigt sich, dass die Grundzüge von Kants Moralphilosophie bereits 1766 gefunden sind. Kants Abhandlung bedeutet somit in mehrfacher Hinsicht das Ende seiner vorkritischen Phase und markiert die eigentliche Geburtsstunde des Kritizismus. Die Ausgabe präsentiert Kants Text erstmals in historisch­kritischer Gestalt und mit deutschen Übersetzungen der Stellen aus den »Arcana Coelestia« Sweden­borgs, auf die sich Kant bezieht. Die umfänglichen Erläuterungen decken die Anknüpfungen an die zeitgenössische Philosophie auf und stellen die Verbindung der Abhandlung mit Kants vorkritischen wie kritischen Werken her.},
    abstract_source = {openalex},
}

@book{basile2022opus,
    author = {Basile, Giovanni Pietro and Lyssy, Ansgar},
    title = {Perspectives on Kant's Opus postumum},
    publisher = {Routledge},
    year = {2022},
    doi = {10.4324/9781003090946},
    note = {SUMMARY: Edited volume (CrossRef lists the two editors as authors) offering new perspectives on the theoretical elements of the Opus postumum, which it reads as central to the relation between Kant's transcendental philosophy and his natural philosophy, practical philosophy, philosophy of religion and metaphysics, and as showing Kant correcting and developing the critical philosophy. Chapters address the transition from the Metaphysical Foundations of Natural Science to physics as an answer to a deficiency in critical thought, the ether and its transcendental deduction, self-affection and the self-positing of the subject, and the idea of God in the highest standpoint of transcendental philosophy (publisher abstract). SUBFIELD AND DEBATE: Opus postumum: the transition project, the ether proofs and the Selbstsetzungslehre, and the unity of the critical system. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 0 and S2 citations 0 (retrieved 2026-10-01). Publisher: Routledge. SEP: cited in the kant-science entry bibliography (dated 2023). No review found by CrossRef search. YEAR NOTE: CrossRef gives online publication 2022-09-28 and no print date, and S2 gives 2022, while the SEP bibliography dates the volume 2023; dated 2022 here, so check against a 2023 duplicate.},
    keywords = {kant, opus-postumum, tp-science-math, debate-other-transition, type-edited-volume, Medium, summary-source-abstract},
    abstract = {"This book offers new perspectives on the theoretical elements of the Opus postumum, Kant's project of a final work which remained unknown until eighty years after his death. The contributors read the OP as a central work in establishing the relation between Kant's transcendental philosophy, his natural philosophy, practical philosophy, philosophy of religion, metaphysics, and his broader epistemology. Interpreting the OP is an important task because it helps reveal how Kant himself tried to correct and develop his critical philosophy. It also sheds light on the foundational role of the three Critiques for other philosophical inquiries, as well as the unified philosophical system that Kant sought to establish. The chapters in this volume address a range of topics relevant to the epistemological and theoretical problems raised in the OP, including the transition from the Metaphysical Foundations of Natural Science to physics as an answer to a deficiency in critical thought; the notion of ether and, more specifically, its transcendental deduction; self-affection and the self-positing of the subject; and the idea of God and the system of ideas in the highest standpoint of transcendental philosophy. Perspectives on Kant's Opus postumum will be of interest to upper-level students and scholars working on Kant"--},
    abstract_source = {openalex},
}

@book{kimschoenecker2022ai,
    editor = {Kim, Hyeongjoo and Schönecker, Dieter},
    title = {Kant and Artificial Intelligence},
    publisher = {De Gruyter},
    year = {2022},
    doi = {10.1515/9783110706611},
    note = {SUMMARY: Asks how artificial intelligence, and the strong claims of its philosophical advocates, look from a Kantian perspective, and conversely what AI and its functions can teach about the validity claims of Kantian philosophy. The volume treats the self, spirit and self-consciousness, ethics, law and aesthetics (publisher abstract). SUBFIELD AND DEBATE: Kant and technology: self-consciousness and machine cognition, robot ethics, machine autonomy and law. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 8 and S2 citations 5 (retrieved 2026-10-01). Publisher: De Gruyter. Review: Kantian Review (Compston, 2024). SEP: chapters by Baiasu, Benossi and Bernecker, Dierksmeier, Schmidt, Schoenecker and Wright are cited in the kant-moral entry bibliography. YEAR NOTE: CrossRef gives online publication 2022-03-29 and print publication 2022-04-19.},
    keywords = {kant, pp-ethics, tp-mind, debate-other-ai, type-edited-volume, Medium, summary-source-abstract},
    abstract = {How are artificial intelligence (AI) and the strong claims made by their philosophical representatives to be understood and evaluated from a Kantian perspective? Conversely, what can we learn from AI and its functions about Kantian philosophy’s claims to validity? This volume focuses on various aspects, such as the self, the spirit, self-consciousness, ethics, law, and aesthetics to answer these questions.},
    abstract_source = {openalex},
}

@book{wilson2022naturalistic,
    author = {Wilson, Catherine},
    title = {Kant and the Naturalistic Turn of 18th Century Philosophy},
    publisher = {Oxford University Press},
    year = {2022},
    doi = {10.1093/oso/9780192847928.001.0001},
    note = {SUMMARY: Argues that the critical philosophy was meant as a bulwark against radical naturalism (determinism, atheism, materialism), which was associated with the radical Enlightenment of Locke, La Mettrie, Buffon, Hume, Maupertuis, Holbach, Herder and the Goettingen materialists, while leaving room for empirical work in physics, chemistry and the life sciences. It presents Kant as at best a proponent of a moderate Enlightenment and holds that, on science, mind-body relations, altruism, justice, animals, women, warfare, non-Europeans and evolution, the more progressive positions were held by his opponents (publisher abstract). The NDPR reviewer, Courtney Fugate, describes the book as a sharp attack on Kant scholarship and on Kant himself that treats the critical turn, the Hume problem, the deduction, the categorical imperative and other doctrines. SUBFIELD AND DEBATE: Historical context and critique of Kant: Kant against eighteenth-century naturalism; a dissenting reading that questions the standard picture of Kant as the progressive Enlightenment figure. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 4 and S2 citations 1 (retrieved 2026-10-01). Publisher: Oxford University Press. NDPR review: yes (ndpr.nd.edu/reviews/kant-and-the-naturalistic-turn-of-18th-century-philosophy; Fugate).},
    keywords = {kant, tp-mind, anthro-hist-edu, debate-other-naturalism, type-monograph, Medium, summary-source-abstract, summary-source-ndpr},
    abstract = {According to his own exposition, the chief targets of Kant’s critical philosophy were determinism, atheism, and materialism. These positions, a source of existential anxiety for his contemporaries, were associated with the eighteenth-century radical Enlightenment in Europe, whose representatives included Locke, La Mettrie, Buffon, Hume, Maupertuis, Holbach, Herder, and the Göttingen materialists. Appealing to the powers of nature and to empirical enquiry, these philosophers typically ridiculed academic metaphysics, rejected appeals to incorporeal substances, emphasized the animal-human continuum, grounded ethics and law in convention and utility, and challenged the legitimacy of worldly hierarchies and priestly authority. The present study focuses on Kant’s transcendental idealism and his theory of human nature. Reversing certain more familiar characterizations, it shows how the critical philosophy was intended to constitute a bulwark against a radical naturalism while leaving space for nonthreatening investigations in physics, chemistry, and the sciences of life. It substantiates earlier claims that Kant was, at best, a proponent of ‘moderate Enlightenment’, while offering a cleared pathway to comprehension through his famously complicated expositions. The reader is further encouraged to reflect critically on Kant’s philosophical relevance for us, given that our present concerns and anxieties are so different from his. The most progressive and humane positions, from our current perspective, with respect to scientific explanation, mind-body relations, altruism, economic and criminal justice, animals, women, warfare, non-Europeans, and evolution, were in fact held by Kant’s implied and declared opponents.},
    abstract_source = {s2},
}

@book{luadler2023race,
    author = {Lu-Adler, Huaping},
    title = {Kant, Race, and Racism: Views from Somewhere},
    publisher = {Oxford University Press},
    year = {2023},
    doi = {10.1093/oso/9780197685211.001.0001},
    note = {SUMMARY: Challenges the assumptions that Kant's racism is personal prejudice that can be disentangled from his core philosophy and that it contradicts his moral theory. It argues that Kant's raciology, divided into racialism and racism, is integral to his philosophical system, and treats racism as an ideological formation in which Kant took part both as a scholar who developed a scientific theory of race as Naturforscher and as an educator who transmitted denigrating depictions of racialized others; it urges Kant scholars and teachers to engage in antiracist work in a color-conscious way (publisher abstract). SUBFIELD AND DEBATE: Anthropology, philosophy of history and race: Kant and race, in particular the questions whether the racism is separable from the critical philosophy and whether it contradicts Kant's moral universalism; continues the author's articles of 2022 (Domain 5, 2022 entries). SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 127 (retrieved 2026-10-01); S2 title-matched record not retrieved. Publisher: Oxford University Press. Reviews found by CrossRef search: Mind (Kleingeld, 2025), Journal of the History of Philosophy (Zanetti, 2025), Kantian Review (Marwah, 2024), Teaching Philosophy (Schwitteck, 2024), and two Critical Philosophy of Race discussions (Huseyinzadegan; Mateo, 2025). SEP: listed in the kant-social-political entry bibliography. NDPR review: not found (the NDPR search returned an unrelated review). YEAR NOTE: CrossRef gives online publication 2023-04-20 and print publication 2023-06-27.},
    keywords = {kant, anthro-hist-edu, debate-race, type-monograph, High, summary-source-abstract},
    sep_context = {SEP entry kant-social-political (Kant's Social and Political Philosophy), section 10 Social Philosophy, cites Lu-Adler 2023 for the claim that Kant's racism was consistent, in contrast to Kleingeld 2012 and 2025, cited for claims of reform on Kant's part, in the sentence about Kant's biological explanation of race and his view that non-European peoples had full political rights late in his career.},
    abstract = {Abstract Kant scholars have paid relatively little attention to his raciology. They assume that his racism, as personal prejudice, can be disentangled from his core philosophy. They also assume that racism contradicts his moral theory. This book challenges both assumptions. It shows how Kant’s raciology—divided into racialism and racism—is integral to his philosophical system as a whole. It also rejects the individualistic approach to Kant and racism. Instead, it uses the notion of racism as ideological formation to demonstrate how Kant, from his social location both as a prominent scholar and as a lifelong educator, participated in the formation of modern racist ideology. As a scholar, Kant developed a groundbreaking scientific theory of race from the standpoint of a philosophical investigator of nature or Naturforscher. As an educator, he transmitted denigrating depictions of the racialized others and imbued them with normative relevance. In both roles, he presented a worldview that excluded nonwhites from such goods as recognitional respect and candidacy for cultural and moral achievements. Some effects of this worldview are still palpable today. Scholars who research and teach Kant’s philosophy therefore have an unshakable burden to take part in the ongoing antiracist struggles, through their teaching practices as well as their scholarship. And they must do so in a color-conscious as opposed to colorblind way, with a pragmatic attention to nonideal social realities and a clear normative orientation toward substantial racial justice, equality, and inclusion.},
    abstract_source = {openalex},
}

@book{schafer2023reason,
    author = {Schafer, Karl},
    title = {Kant's Reason: The Unity of Reason and the Limits of Comprehension in Kant},
    publisher = {Oxford University Press},
    year = {2023},
    doi = {10.1093/oso/9780192868534.001.0001},
    note = {SUMMARY: Develops an interpretation of Kant's conception of reason on which theoretical and practical reason are two manifestations of one capacity for theoretical and practical understanding ("comprehension"), both governed by a version of the Principle of Sufficient Reason and both essentially autonomous. The resulting position is a "rational constitutivism" that treats neither substantive reasons or values nor merely structural rationality as fundamental, and that contrasts with "reasons fundamentalism" and with the "agency-first constitutivism" that has dominated Kantian metaethics (publisher abstract). SUBFIELD AND DEBATE: Theoretical and practical philosophy: the unity of reason, the Principle of Sufficient Reason, and constitutivism in Kantian metaethics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 34 (retrieved 2026-10-01); S2 title-matched record not retrieved. Publisher: Oxford University Press. Reviews found by CrossRef search: Ethics (Tenenbaum, 2026), Kant-Studien (Kohl, 2026). NDPR review: not found (the NDPR search returned an unrelated review). YEAR NOTE: CrossRef gives print publication 2023-08-22 and online 2023-08-24.},
    keywords = {kant, tp-cpr, pp-ethics, debate-constructivism, type-monograph, Medium, summary-source-abstract},
    abstract = {Abstract Kant’s Reason develops a novel interpretation of Kant’s conception of reason and its philosophical significance, focusing on two claims. First, it argues that Kant presents a powerful model for understanding the unity of theoretical and practical reason as two manifestations of a unified capacity for theoretical and practical understanding (or “comprehension”). This model allows us to do justice to the deep commonalities between theoretical and practical rationality, without reducing either to the other. In particular, through it we see why the activities of both theoretical and practical reason are governed by a version of the Principle of Sufficient Reason, and why reason is essentially autonomous. At the same time, Kant’s Reason reads Kant as presenting us with a compelling picture of the role that reason (as a capacity or power) should play in a systematic approach to foundational philosophical questions. In doing so, it argues for an account of the fundamental norms that apply to rational beings that treats as fundamental neither substantive reasons or values nor merely structural rationality, but instead a robust conception of reason as a power or capacity for theoretical and practical understanding. The result is a form of “rational constitutivism,” which contrasts both with the forms of “reasons fundamentalism” that are currently fashionable and the forms of “agency-first constitutivism” that have dominated Kantian metaethics. In this sense, the book’s aim is to vindicate Kant’s insistence that his philosophy represents nothing more or less than reason’s implicit self-understanding coming to explicit and systematic self-consciousness.},
    abstract_source = {openalex},
}

@article{stang2023schematism,
    author = {Stang, Nicholas F.},
    title = {Kant's Schematism of the Categories: An Interpretation and Defence},
    journal = {European Journal of Philosophy},
    year = {2023},
    volume = {31},
    number = {1},
    pages = {30--64},
    url = {https://doi.org/10.1111/ejop.12761},
    note = {SUMMARY: Reconstructs the argument of the Schematism chapter of the Critique of Pure Reason, whose task is to solve the problem of the inhomogeneity of intuitions and categories. The reconstruction rests on two premises, Subsumption Sufficiency and Real Possibility, which with a modal link entail that objects can be subsumed under categories; the author reads transcendental schemata as time-determinations, understood as rules for reflexively representing the temporal relations among our own representational states, and concludes that on this reading the argument is sound (abstract). SUBFIELD AND DEBATE: Theoretical philosophy, Schematism and the relation of sensibility and understanding in the Analytic of Principles; offered as an interpretation and defence of an argument often treated as obscure. SIGNIFICANCE INDICATORS: S2 citations 4 and CrossRef is-referenced-by-count 6 (retrieved 2026-10-01). Venue: European Journal of Philosophy 31(1). YEAR NOTE: CrossRef gives online publication 2022-03-31 and print publication 2023-03 (volume 31, issue 1); dated by print year.},
    keywords = {kant, tp-cpr, tp-mind, debate-other-schematism, type-article, Medium, summary-source-abstract},
    abstract = {The aim of the Schematism chapter of the Critique of Pure Rea-son is to solve the problem posed by the “ inhomogeneity ” of intuitions and categories: the sensible properties of objects represented in intuition are of a different kind than the properties represented by categories. Kant's solution is to introduce what he calls “ transcendental schemata, ” which mediate the subsumption of objects under categories. I reconstruct Kant's solution in terms of two substantive premises, which I call Subsumption Sufficiency (i.e., that subsuming an object under a transcendental schema is sufficient to subsume it under the corresponding category) and Real Possibility (i.e., that it is really possible to subsume objects under each of the transcendental schemata). These two principles, together with a trivial modal one (the Subsumption-Possibility Link), entail that it is possible to subsume objects under categories; in other words, the argument of the Schematism is valid . The main work of the paper consists in reconstructing Kant's arguments for, and explanations of, these premises. I argue that they hinge on Kant's claim that transcendental schemata are “ time-determinations, ” which I interpret to mean: rules for reflexively representing the temporal relations among our own representational states. On the basis of this reading, I reconstruct Kant's argument for Subsumption Sufficiency, category by category. I also explain why Real Possibility follows almost immediately. Granting Kant the argument up to this point in the Critique , the argument of the Schematism is sound .},
    abstract_source = {s2}
}

@book{cooper2023naturalhistory,
    author = {Cooper, Andrew},
    title = {Kant and the Transformation of Natural History},
    publisher = {Oxford University Press},
    year = {2023},
    doi = {10.1093/oso/9780192869784.001.0001},
    note = {SUMMARY: Presents itself as the first systematic study of Kant's account of natural history, and argues that Kant contributed to the introduction of time into the frame in which explanations are sought and justified in natural science. It challenges the claim that Kant's theory of science rules out a developmental conception of nature, argues that it supplies a method by which natural historians can dispute historical claims, and uses that method to expose flaws in Kant's own historical reasoning, including the formation and defence of his racist views (publisher abstract). The NDPR review describes the book as rejecting the standard reading on which natural history was an early interest later sidelined by the critical philosophy, and as locating natural history in the critical project through reason's regulative use. SUBFIELD AND DEBATE: Philosophy of science and the life sciences: Kant on natural history, historical explanation, regulative principles and teleology, with links to the race debate. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 6 (retrieved 2026-10-01); S2 title-matched record not retrieved. Publisher: Oxford University Press. NDPR review: yes (reviewer listed in the fetched record as Naragon). Other reviews found by CrossRef search: European Journal of Philosophy (Sandford, 2024), Kantian Review (Demarest, 2025), HOPOS (Howard, 2025), The European Legacy (Lawrenz, 2025). YEAR NOTE: CrossRef gives online publication 2023-08-24 and print publication 2023-09-01.},
    keywords = {kant, tp-science-math, aes-teleo, debate-other-natural-history, type-monograph, Medium, summary-source-abstract, summary-source-ndpr},
    abstract = {Abstract In this book, Andrew Cooper undertakes the first systematic study of Kant’s account of natural history. He contends that Kant made a decisive contribution to one of the most explosive and understudied revolutions in the history of science: the addition of time to the frame in which explanations are required, sought, and justified in natural science. Addressing a wide range of Kant’s works, Cooper challenges the claim that Kant’s theory of science denies a developmental conception of nature and argues instead that it establishes a method by which natural historians can genuinely dispute historical claims. This method, Cooper argues, can be used to expose serious flaws in Kant’s own historical reasoning, including the formation and defence of his racist views. The book will be valuable to philosophers seeking to discern both the power and the limitations of Kant’s theory of science, and to historians of science working on the fractured landscape of eighteenth-century Newtonianism.},
    abstract_source = {openalex},
}

@book{kohl2023freedom,
    author = {Kohl, Markus},
    title = {Kant on Freedom and Rational Agency},
    publisher = {Oxford University Press},
    year = {2023},
    doi = {10.1093/oso/9780198873143.001.0001},
    note = {SUMMARY: Gives a comprehensive interpretation of Kant's doctrine of freedom on which absolute transcendental freedom, or rational autonomy, is the necessary presupposition of all norm-governed human agency in its moral, epistemic and aesthetic dimensions. Kant's doctrine emerges as a systematic critique of a naturalistic worldview, culminating in the argument that naturalistic cognizers cannot explain away our freedom from natural forces because they must presuppose it in devising rationally valid theories (publisher abstract). The NDPR review reports that the book argues against non-metaphysical readings of the practical standpoint and takes moral freedom to depend on the freedom of cognitive faculties. SUBFIELD AND DEBATE: Practical and theoretical philosophy: transcendental freedom, the practical standpoint, and metaphysical against non-metaphysical readings of Kant on freedom. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 6 (retrieved 2026-10-01); S2 title-matched record not retrieved. Publisher: Oxford University Press. NDPR review: yes (reviewer listed in the fetched record as Rauscher). Other reviews found by CrossRef search: Philosophical Review (McLear, 2025), The Thomist (Chapman, 2025), Kant-Studien (Walsh, 2026). SEP: listed in the kant-moral entry bibliography. YEAR NOTE: CrossRef gives online publication 2023-06-22 and print publication 2023-07-06.},
    keywords = {kant, pp-ethics, tp-cpr, debate-other-freedom, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {Abstract Kant on Freedom and Rational Agency provides an original, comprehensive interpretation of Kant’s doctrine of freedom. It shows that for Kant absolute transcendental freedom or rational autonomy is the necessary presupposition of all meaningful, norm-governed human agency in its moral, epistemic, and aesthetic dimensions. The book thereby gives a compelling sense to Kant’s estimation that freedom is a “cardinal point,” even the “keystone” of his entire critical philosophy. Kant’s doctrine of freedom emerges as a systematic critique of a naturalistic worldview that regards all our capacities, representations, and actions as the causal upshot of natural laws and forces. The book shows why Kant holds that the naturalistic worldview fatally undermines our self-conception as rational agents. Kant’s critique of naturalism culminates in the argument that naturalistic cognizers cannot explain away our freedom from natural forces because they must presuppose such freedom in their own cognitive efforts when they aim to devise rationally valid naturalistic theories.},
    abstract_source = {openalex},
}

@book{howard2023latenature,
    author = {Howard, Stephen},
    title = {Kant's Late Philosophy of Nature},
    publisher = {Cambridge University Press},
    year = {2023},
    doi = {10.1017/9781009031028},
    note = {SUMMARY: Treats the Opus postumum, Kant's final drafts attempting a "transition from the metaphysical foundations of natural science to physics". It outlines a framework combining the systematic ambition of early twentieth-century readings with the rigor of recent studies, sets aside the question which "gap" in the earlier philosophy the project was meant to fill, and directs attention to fascicles X and XI and to the "arrival point" of the transition, Kant's question "What is physics?" (publisher abstract; the abstract calls the work an Element). SUBFIELD AND DEBATE: Opus postumum and philosophy of science: the transition project and its interpretation; engages the interpretive dispute over the gap the project was to fill. SIGNIFICANCE INDICATORS: S2 citations 10 and CrossRef is-referenced-by-count 12 (retrieved 2026-10-01). Publisher: Cambridge University Press. SEP: listed in the kant-science entry bibliography. No review found by CrossRef search or NDPR (the NDPR search returned an unrelated review). YEAR NOTE: CrossRef gives online publication 2023-03-09 and print publication 2023-04-30.},
    keywords = {kant, opus-postumum, tp-science-math, debate-other-transition, type-monograph, Medium, summary-source-abstract},
    abstract = {Kant's final drafts, known as his Opus postumum, attempt to make what he calls a 'transition from the metaphysical foundations of natural science to physics.' Interpreters broadly agree that in this project Kant seeks to connect the general a priori principles of natural science, as set out in the major critical works, to the specific results of empirical physics. Beyond this, however, basic interpretative issues remain controversial. This Element outlines a framework that aims to combine the systematic ambition of early twentieth-century readings with the rigor of more recent studies. The author argues that a question that has animated much recent scholarship – which 'gap' in Kant's previous philosophy does the Opus postumum seek to fill? – can be profitably set aside. In its place, renewed attention should be given to a crucial part of the manuscript, fascicles X/XI, and to the problematic 'arrival point' of the transition, namely, Kant's question: What is physics?},
    abstract_source = {s2},
}

@article{fahmy2023merely,
    author = {Fahmy, Melissa Seymour},
    title = {Never Merely as a Means: Rethinking the Role and Relevance of Consent},
    journal = {Kantian Review},
    year = {2023},
    volume = {28},
    number = {1},
    pages = {41--62},
    url = {https://doi.org/10.1017/s136941542200053x},
    note = {SUMMARY: Argues that consent-based criteria for using another merely as a means, built over several decades on the Groundwork false-promising example, yield counter-intuitive and un-Kantian verdicts in relatively simple cases. The false-promising example involves a consent-sensitive duty and so encourages too narrow an understanding; the prohibition on using another merely as a means covers both consent-sensitive and consent-insensitive duties, and the article offers a duty-based account that reflects this (abstract). SUBFIELD AND DEBATE: Practical philosophy, Formula of Humanity: the meaning of "merely as a means" and the role of consent, against consent-based interpretations. SIGNIFICANCE INDICATORS: S2 citations 11 and CrossRef is-referenced-by-count 14 (retrieved 2026-10-01). Venue: Kantian Review 28(1). SEP: listed in the persons-means entry bibliography. YEAR NOTE: CrossRef gives online publication 2022-12-12 and print publication 2023-03 (volume 28, issue 1); dated by print year.},
    keywords = {kant, pp-ethics, debate-other-formula-of-humanity, type-article, Medium, summary-source-abstract},
    abstract = {Abstract For several decades, Kant scholars, inspired by the Groundwork false-promising example, have constructed consent-based criteria for using another merely as a means. Unfortunately, these consent-based accounts produce assessments that are both counter-intuitive and un-Kantian in relatively simple cases. This article investigates why these consent-based accounts fail and offers an alternative. The Groundwork false-promising example has encouraged a problematically narrow understanding of the conditions for using another merely as a means in virtue of the fact that the example involves a consent-sensitive duty. This article demonstrates that the scope of the prohibition on using another merely as a means includes both consent-sensitive and consent-insensitive duties and offers a duty-based account that reflects this.},
    abstract_source = {s2}
}

@article{kleingeld2023volitional,
    author = {Kleingeld, Pauline},
    title = {A Defense and Development of the Volitional Self-Contradiction Interpretation of Kant's Formula of Universal Law},
    journal = {Philosophia},
    year = {2023},
    volume = {51},
    number = {2},
    pages = {505--524},
    doi = {10.1007/s11406-023-00641-0},
    note = {SUMMARY: Replies to comments by Mark Timmons, Michael Walschots, Paola Romero and Stefano Lo Re on the author's 2017 reading of the Formula of Universal Law as requiring that one can will, without volitional self-contradiction, both the maxim as one's own action principle and its becoming a universal law. The reply expands the interpretation, holding that Kant also constructs the diagnostic contradiction between willing a maxim to become a universal law and willing what finite rational beings necessarily will, namely the means to their actual and possible ends, and it contrasts the view with the Practical Contradiction and Logical Contradiction interpretations (abstract). SUBFIELD AND DEBATE: Practical philosophy, Groundwork and the Formula of Universal Law: the contradiction-in-conception and contradiction-in-will tests; part of an exchange in which Timmons's and Walschots's responses appear in the S2 results for 2023 (Philosophia). SIGNIFICANCE INDICATORS: S2 citations 3 and CrossRef is-referenced-by-count 1 (retrieved 2026-10-01). Venue: Philosophia 51(2). The comments by Timmons and Walschots are separate 2023 articles in the same journal and were not selected as entries.},
    keywords = {kant, pp-ethics, debate-other-universal-law, type-article, Low, summary-source-abstract},
    abstract = {Abstract Kant’s Formula of Universal Law (FUL) is generally believed to require you to act only on the basis of maxims that you can will without contradiction to become universal laws. In “Contradiction and Kant’s Formula of Universal Law” (2017), I have proposed to read the FUL instead as requiring that, for any maxim on which you act, you can will two things simultaneously, without volitional self-contradiction: (1) willing the maxim as your own action principle and (2) willing that it become a universal law. In the present essay, I reply to comments by Mark Timmons, Michael Walschots, Paola Romero, and Stefano Lo Re. In response to their comments concerning the application of the FUL, I expand the interpretive framework of the Volitional Self-Contradiction Interpretation. I argue that Kant also constructs the diagnostic volitional self-contradiction as a contradiction between (1) willing a tested maxim to become a universal law and (2) willing what humans, qua finite rational beings, necessarily will, namely the means to their actual and possible future ends. I also clarify how the two ways in which Kant specifies the test are related. Furthermore, I clarify the relation between the Volitional Self-Contradiction interpretation and other interpretations of the FUL, in particular the ‘Practical Contradiction’ and ‘Logical Contradiction’ interpretations, as well as its difference from the Golden Rule. I also address the objection that the volitional self-contradiction is superfluous, clarify the relation between the Formula of Universal Law and the Formula of the Law of Nature, and explain why the will of an immoral agent does not contain a volitional self-contradiction of the type at issue.},
    abstract_source = {openalex},
}

@book{rinne2023sex,
    editor = {Rinne, Pärttyli and Brecher, Martin},
    title = {Kant on Sex, Love, and Friendship},
    publisher = {De Gruyter},
    year = {2023},
    doi = {10.1515/9783111291130},
    note = {SUMMARY: Collection of essays on how sex, love and friendship function in Kant's philosophy, individually and in conjunction. The essays examine the theory of sexuality, marriage (including same-sex marriage), morality and sexual objectification, love and autonomy, love of human beings, the conceptual structure of love, friendship, misanthropy and the highest good (publisher abstract). SUBFIELD AND DEBATE: Metaphysics of Morals and the Doctrine of Virtue, with anthropology: Kant on sex, marriage and friendship, set against what the volume calls common prejudices about Kant's contribution to these topics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 0 and no S2 record retrieved (retrieved 2026-10-01). Publisher: De Gruyter. No review found by CrossRef search. Included for coverage of the Metaphysics of Morals, virtue and gender-related cells in 2023. YEAR NOTE: CrossRef gives online publication 2023-08-31 and print publication 2023-09-18.},
    keywords = {kant, pp-mm-virtue, anthro-hist-edu, debate-other-sex-love, type-edited-volume, Low, summary-source-abstract},
    abstract = {Sex, love, and friendship play an integral role in Immanuel Kant’s conception of human life. Against common prejudices, Kant provides substantial contributions to the philosophical discussion of these topics. This unique collection of essays sheds light on how the notions function in Kant’s philosophy, both individually and in conjunction with each other. The essays examine intertwined issues such as theory of sexuality, marriage (including same-sex marriage), morality and sexual objectification, love and autonomy, love of human beings, the conceptual structure of love, friendship, misanthropy, and the highest good. The contributors include internationally well-known experts in the field. They approach the topics diversely from historical, philosophical, critical, and interpretative perspectives. The collection will be an invaluable resource for Kant scholars and for anyone interested in affective social relations in the history of philosophy and beyond.},
    abstract_source = {openalex},
}

@article{davies2023selfsufficiency,
    author = {Davies, Luke},
    title = {Kant on Civil Self-Sufficiency},
    journal = {Archiv für Geschichte der Philosophie},
    year = {2023},
    volume = {105},
    number = {1},
    pages = {118--140},
    doi = {10.1515/agph-2020-0030},
    note = {SUMMARY: Argues that Kant attributes civil self-sufficiency, the qualification for active citizenship and political participation, to those who are not under the authority of any private individual for their survival. The author holds this reading to be more textually grounded than the dominant reading, which understands self-sufficiency in terms of economic relations alone, and that Kant's interest in relations of authority reflects a concern to eliminate certain forms of corruption in public lawgiving (abstract). SUBFIELD AND DEBATE: Political and legal philosophy, Doctrine of Right: the active/passive citizen distinction and the dependence of passive citizens; bears on the debate over Kant's exclusion of dependents from citizenship. SIGNIFICANCE INDICATORS: S2 citations 12 and CrossRef is-referenced-by-count 13 (retrieved 2026-10-01). Venue: Archiv für Geschichte der Philosophie 105(1). YEAR NOTE: CrossRef gives print publication 2023-03-13 and online publication 2023-03-15.},
    keywords = {kant, pp-right-politics, debate-other-active-citizenship, type-article, Medium, summary-source-abstract},
    abstract = {Abstract Kant distinguishes between ‘active’ and ‘passive’ citizens and holds that only the former are civilly self-sufficient and possess rights of political participation. Such rights are important, since for Kant state institutions are a necessary condition for individual freedom. Thus, only active citizens are entitled to contribute to a necessary condition for the freedom of each. I argue that Kant attributes civil self-sufficiency to those who are not under the authority of any private individual for their survival. This reading is more textually grounded than the dominant reading, which understands civil self-sufficiency in terms of economic relations alone. I further argue that Kant was interested in relations of authority because he was concerned to eliminate certain forms of corruption. This indicates that Kant’s contested distinction between active and passive citizens was a response to a key problem of any account of public lawgiving.},
    abstract_source = {openalex},
}

@book{sweet2023territory,
    author = {Sweet, Kristi},
    title = {Kant on Freedom, Nature, and Judgment: The Territory of the Third Critique},
    publisher = {Cambridge University Press},
    year = {2023},
    doi = {10.1017/9781009036634},
    note = {SUMMARY: Treats the Critique of Judgment as examining a genuinely independent sphere of human life rather than as serving either practical or theoretical interests, and argues that the Critique answers the question "for what may I hope?". The answer lies in Kant's account of "territory", a region of experience that underlies and mediates between freedom and nature and the context in which purposiveness without a purpose, the Ideal of Beauty, the sensus communis, genius and aesthetic ideas, and Kant's conception of life and proof of God are best interpreted (publisher abstract). The NDPR reviewer notes that commentators have tended to treat the third Critique as two projects, aesthetics and philosophy of biology, and that the literature stressing its unity is sparse. SUBFIELD AND DEBATE: Aesthetics and teleology: the unity of the Critique of the Power of Judgment and the gulf between nature and freedom. SIGNIFICANCE INDICATORS: S2 citations 7 and CrossRef is-referenced-by-count 13 (retrieved 2026-10-01). Publisher: Cambridge University Press. NDPR review: yes (reviewer listed in the fetched record as Ostaric). Other reviews found by CrossRef search: European Journal of Philosophy (Stoner, 2023), Kantian Review (McQuillan, 2024), Graduate Faculty Philosophy Journal (Cantone, 2024), Kant-Studien (Perulli, 2025), Philosophy Today (Goldman, 2026). YEAR NOTE: CrossRef gives print publication 2023-02-09 and online publication 2023-08-07.},
    keywords = {kant, aes-teleo, debate-other-unity-third-critique, type-monograph, Medium, summary-source-abstract, summary-source-ndpr},
    abstract = {Kant's Critique of Judgment seems not to be an obviously unified work. Unlike other attempts to comprehend it as a unity, which treat it as serving either practical or theoretical interests, Kristi Sweet's book posits it as examining a genuinely independent sphere of human life. In her in-depth account of Kant's Critical philosophical system, Sweet argues that the Critique addresses the question: for what may I hope? The answer is given in Kant's account of 'territory,' a region of experience that both underlies and mediates between freedom and nature. Territory forms the context in which purposiveness without a purpose, the Ideal of Beauty, the sensus communis, genius and aesthetic ideas, and Kant's conception of life and proof of God are best interpreted. Encounters in this sphere are shown to refer us to a larger, more cosmic sense of a whole to which both freedom and nature belong.},
    abstract_source = {s2},
}

@book{clewis2023origins,
    author = {Clewis, Robert R.},
    title = {The Origins of Kant's Aesthetics},
    publisher = {Cambridge University Press},
    year = {2023},
    doi = {10.1017/9781009209403},
    note = {SUMMARY: Examines the sources and development of Kant's aesthetics through his publications, correspondence, handwritten notes and university lectures, in eight chapters on aesthetic judgment and normativity, formal beauty, partly conceptual beauty, genius, the fine arts, the sublime, ugliness and disgust, and humor. It considers how Kant's thought was shaped by authors including Wolff, Baumgarten, Meier, Mendelssohn, Sulzer, Herder, Hutcheson, Hume, Burke, Home, Batteux, Rousseau and Voltaire (publisher abstract). SUBFIELD AND DEBATE: Aesthetics with pre-critical and lecture material: the development of Kant's aesthetic theory before and around the third Critique, and its eighteenth-century sources. SIGNIFICANCE INDICATORS: S2 citations 10 and CrossRef is-referenced-by-count 10 (retrieved 2026-10-01). Publisher: Cambridge University Press. Reviews found by CrossRef search: Kantian Review (McQuillan, 2024), Estetika (Erkan, 2025); a Kantian Review discussion piece by Zinkin (2024) also addresses the book. NDPR review: not retrieved. YEAR NOTE: CrossRef gives print publication 2023-01-26 and online publication 2024-01-10.},
    keywords = {kant, aes-teleo, precritical, debate-other-aesthetic-sources, type-monograph, Medium, summary-source-abstract},
    abstract = {Organized around eight themes central to aesthetic theory today, this book examines the sources and development of Kant's aesthetics by mining his publications, correspondence, handwritten notes, and university lectures. Each chapter explores one of eight themes: aesthetic judgment and normativity, formal beauty, partly conceptual beauty, artistic creativity or genius, the fine arts, the sublime, ugliness and disgust, and humor. Robert R. Clewis considers how Kant's thought was shaped by authors such as Christian Wolff, Alexander Baumgarten, Georg Meier, Moses Mendelssohn, Johann Sulzer, Johann Herder, Francis Hutcheson, David Hume, Edmund Burke, Henry Home, Charles Batteux, Jean-Jacques Rousseau, and Voltaire. His resulting study uncovers and illuminates the complex development of Kant's aesthetic theory and will be useful to advanced students and scholars in fields across the humanities and studies of the arts.},
    abstract_source = {s2},
}

@article{chignell2023hope,
    author = {Chignell, Andrew},
    title = {Demoralization and Hope: A Psychological Reading of Kant's Moral Argument},
    journal = {The Monist},
    year = {2023},
    volume = {106},
    number = {1},
    pages = {46--60},
    doi = {10.1093/monist/onac022},
    note = {SUMMARY: Examines three varieties of Kant's "moral proof" under the doctrine of the primacy of the practical, and argues that the third, a "moral-psychological argument" based on the need to sustain moral hope and avoid demoralization, has advantages over the others. It starts from a premise that coheres better with Kant's mature account of moral motivation and invokes plausible empirical-psychological theses to support a commitment to the full-blown classical deity, which is the result Kant wanted (abstract). SUBFIELD AND DEBATE: Religion and moral philosophy: the moral argument for God and the postulates, the primacy of the practical, and moral hope. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 12; S2 record without a citation count (retrieved 2026-10-01). Venue: The Monist 106(1). YEAR NOTE: CrossRef gives print and online publication 2023-05-30.},
    keywords = {kant, religion, pp-ethics, debate-other-moral-argument, type-article, Medium, summary-source-abstract},
    abstract = {Abstract Kant’s “primacy of the practical” doctrine says that we can form morally justified commitments regarding what exists, even in the absence of sufficient epistemic grounds. In this paper I critically examine three different varieties of Kant’s “moral proof” that can be found in the critical works. My claim is that the third variety—the “moral-psychological argument” based in the need to sustain moral hope and avoid demoralization—has some intriguing advantages over the other two. It starts with a premise that more clearly coheres with Kant’s mature account of moral motivation, and it invokes plausible empirical-psychological theses to motivate a commitment to the full-blown classical deity—the result Kant clearly wanted. From the point of view of its structure, I think this third variety of moral argument also has the most by way of contemporary interest.},
    abstract_source = {openalex},
}

@book{lambeth2023heidegger,
    author = {Lambeth, Morganna},
    title = {Heidegger's Interpretation of Kant: The Violence and the Charity},
    publisher = {Cambridge University Press},
    year = {2023},
    doi = {10.1017/9781009239271},
    note = {SUMMARY: Gives a new account of Heidegger's method of interpreting Kant, arguing that it is more promising than usually recognized, which has limited its uptake in anglophone Kant scholarship. On the account, Heidegger finds Kant's greatest insights in moments of tension where Kant struggles to articulate something new, so that the interpreter must disentangle competing strands of argument and decide which is most compelling; the book traces this method through Heidegger's reading of the Critique of Pure Reason, situates it against other post-Kantian readings, and shows how the engagement bears on Heidegger's own views (publisher abstract). SUBFIELD AND DEBATE: Reception (phenomenology): Heidegger's Kant interpretation and the question of interpretive method, set against the charge that Heidegger reads himself into the philosophers he interprets. SIGNIFICANCE INDICATORS: S2 citations 12 and CrossRef is-referenced-by-count 10 (retrieved 2026-10-01). Publisher: Cambridge University Press. No review found by CrossRef search; the NDPR search returned an unrelated review. YEAR NOTE: CrossRef gives online publication 2023-06-01 and print publication 2023-07-31.},
    keywords = {kant, recep-phenom, debate-other-heidegger-kant, type-monograph, Medium, summary-source-abstract},
    abstract = {Heidegger has a reputation for reading himself into the philosophers he interprets, and his interpretation of Kant has therefore had little uptake in anglophone Kant scholarship. In this book, Morganna Lambeth provides a new account of Heidegger's method of interpreting Kant, arguing that it is more promising than is typically recognized. On her account, Heidegger thinks that Kant's greatest insights are located in moments of tension, where Kant struggles to articulate something new about his subject-matter. The role of the interpreter, then, is to disentangle competing strands of argument, and to determine which strand is most compelling. Lambeth traces Heidegger's interpretive method across his reading of Kant's Critique of Pure Reason and situates Heidegger's reconstruction of Kant's best line of argument against other post-Kantian readings. She finally shows how Heidegger's deep engagement with Kant sheds light on Heidegger's own philosophical views.},
    abstract_source = {s2},
}

@book{baiasu2023kantianmind,
    author = {Baiasu, Sorin and Timmons, Mark},
    title = {The Kantian Mind},
    publisher = {Routledge},
    year = {2023},
    doi = {10.4324/9781003406617},
    note = {SUMMARY: Edited reference volume (CrossRef lists the two editors as authors) in the Routledge Philosophical Minds series, with forty-five chapters in four parts: Background to the Critical Philosophy, Transcendental Philosophy (Critique and Doctrine), Posthumous Writings and Lectures, and Kant and Contemporary Kantians. Besides the main works it covers Kant's views on logic, mathematics, the natural sciences, anthropology, religion, politics and education, and the influence of Kant on contemporary analytic and continental philosophy; each chapter has suggestions for further reading (publisher description from the Routledge page, retrieved by web search). SUBFIELD AND DEBATE: Reference work covering all subfields of Kant scholarship, including posthumous writings and lectures and reception. SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 1 (retrieved 2026-10-01); citation counts do not measure a reference volume of this kind. Publisher: Routledge. SEP: a chapter on the methodology of pure practical reason is cited in the kant-moral entry bibliography. No review found. YEAR NOTE: CrossRef gives online/issued date 2023-06-22 and no print date; the Routledge page snippet gives publication on 20 July 2023; dated 2023.},
    keywords = {kant, reference, type-edited-volume, type-reference-work, Medium, summary-source-publisher, INCOMPLETE, no-abstract}
}

@book{matherne2024seeing,
    author = {Matherne, Samantha},
    title = {Seeing More: Kant's Theory of Imagination},
    publisher = {Oxford University Press},
    year = {2024},
    doi = {10.1093/9780191999291.001.0001},
    note = {SUMMARY: Defends a systematic interpretation of Kant's theory of imagination, on which imagination is a flexible cognitive capacity that is exercised as much in relation to real and present objects as to absent or unreal ones, so that imagining pervades our lives. The book traces its exercise in perception and ordinary experience, in the appreciation of beauty and sublimity, in the production of art, and in the pursuit of happiness and of morality, and holds that one unified theory underlies these uses (publisher abstract). The NDPR review describes the book as answering what imagination is for Kant and what role it plays in his picture, set against skeptics who take the imagination to be of little importance to his system. SUBFIELD AND DEBATE: Theoretical philosophy and mind, with aesthetics and moral philosophy: the unity and scope of Kant's account of imagination across the three Critiques. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 23 (retrieved 2026-10-01). Publisher: Oxford University Press. NDPR review: yes (ndpr.nd.edu/reviews/seeing-more-kants-theory-of-imagination). Other reviews found by CrossRef search: Journal of Transcendental Philosophy (Kerimov, 2025), Philosophical Review (Grune, 2026), Journal of the History of Philosophy (Stephenson, 2026), British Journal for the History of Philosophy (McQuillan, 2026); European Journal of Philosophy (Biss, 2025) carries comments on Part IV. SEP: cited in the kant-conceptualism entry bibliography. YEAR NOTE: CrossRef gives online publication 2024-03-20 and print publication 2024-05-07.},
    keywords = {kant, tp-mind, aes-teleo, pp-ethics, debate-other-imagination, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {Abstract The book defends a systematic interpretation of the philosopher Immanuel Kant’s theory of imagination. To this end, it offers an account of what kind of mental capacity Kant takes imagination to be in general, as well as an account of the way in which we use this capacity in theoretical, aesthetic, and practical contexts. In contrast with more traditional theories of imagination, as a kind of fantasy that we exercise only in relation to objects that are not real or not present, it proposes that Kant theorizes imagination as something that we exercise just as much in relation to objects that are real and present. It thus attributes to Kant a view of imagining as something that pervades our lives. In order to bring out this pervasiveness, it explores Kant’s account of how we exercise our imagination in perception, ordinary experience, the appreciation of beauty and sublimity, the production of art, the pursuit of happiness, and the pursuit of morality. However, it also makes the case that Kant’s analysis of this wide range of phenomena is underwritten by a unified theory of what imagination is as a remarkably flexible cognitive capacity that we can exercise in constrained and creative, playful and serious ways.},
    abstract_source = {openalex},
}

@book{smyth2024intuition,
    author = {Smyth, Daniel},
    title = {Intuition in Kant: The Boundlessness of Sense},
    publisher = {Cambridge University Press},
    year = {2024},
    doi = {10.1017/9781009330305},
    note = {SUMMARY: Offers an overview of Kant's conception of intuition in all its species (divine, receptive, sensible and human). Kant treats sense perception as the paradigm of intuition yet holds that infinities can be represented in intuition; the book argues that the features Kant ascribes to intuition remedy specific cognitive shortcomings arising from the discursivity of our intellect, so that intuition acts as the intellect's cognitive partner, and it reconstructs the role of this conception in Kant's philosophy of mind, epistemology and philosophy of mathematics (publisher abstract). The NDPR review presents the question of how Kant justifies his characterizations of sensibility and understanding, which his transcendental idealism presupposes, as the book's point of entry. SUBFIELD AND DEBATE: Theoretical philosophy, Transcendental Aesthetic and the sensibility-understanding relation, with Kant's philosophy of mathematics and mind; a case that sensibility is as innovative as Kant's theory of the understanding. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 0 (retrieved 2026-10-01); a 2024 monograph with early citations not yet recorded. Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/intuition-in-kant-the-boundlessness-of-sense). Other reviews found by CrossRef search: Kantian Review (Friebe, 2026), The Thomist (2026). YEAR NOTE: CrossRef gives print publication 2024-02-29 and online 2024-03-07.},
    keywords = {kant, tp-cpr, tp-mind, tp-science-math, debate-other-intuition, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {In this book Daniel Smyth offers a comprehensive overview of Immanuel Kant's conception of intuition in all its species – divine, receptive, sensible, and human. Kant considers sense perception a paradigm of intuition, yet claims that we can represent infinities in intuition, despite the finitude of sense perception. Smyth examines this heterodox combination of commitments and argues that the various features Kant ascribes to intuition are meant to remedy specific cognitive shortcomings that arise from the discursivity of our intellect Intuition acting as the intellect's cognitive partner to make knowledge possible. He reconstructs Kant's conception of intuition and its role in his philosophy of mind, epistemology, and philosophy of mathematics, and shows that Kant's conception of sensibility is as innovative and revolutionary as his much-debated theory of the understanding.},
    abstract_source = {openalex},
}

@article{rosefeldt2024initself,
    author = {Rosefeldt, Tobias},
    title = {`In Itself': A New Investigation of Kant's Adverbial Wording of Transcendental Idealism},
    journal = {Kantian Review},
    year = {2024},
    volume = {29},
    number = {2},
    pages = {209--227},
    doi = {10.1017/s1369415424000190},
    note = {SUMMARY: Presents what it calls the first systematic investigation, since Gerold Prauss's book on the problem of things in themselves, of the linguistic forms in which Kant expresses transcendental idealism. It argues that Prauss's case for reading "in itself" as an adverbial expression modifying verbs of philosophical reflection is flawed, so that exegetical evidence for methodological two-aspect interpretations is poor; Kant's adverbial uses of "in itself" mostly reduce to a standard use modifying verbs of predicative being such as the copula, and the paper discusses how this fits two-object and ontological two-aspect interpretations (abstract). SUBFIELD AND DEBATE: Theoretical philosophy, transcendental idealism: the two-aspect versus two-object debate, argued from Kant's use of language. SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 4 (retrieved 2026-10-01). Venue: Kantian Review 29(2). YEAR NOTE: CrossRef gives online publication 2024-04-01 and print publication 2024-06.},
    keywords = {kant, tp-cpr, debate-two-aspect, type-article, Medium, summary-source-abstract},
    abstract = {Abstract This article offers the first systematic investigation of the linguistic forms in which Kant expresses his transcendental idealism since Gerold Prauss’ seminal book Kant und das Problem der Dinge an sich. It is argued that Prauss’ own argument for the claim that ‘in itself’ is an adverbial expression that standardly modifies verbs of philosophical reflection is flawed and that there is hence very poor exegetical evidence for so-called ‘methodological two-aspect’ interpretations of Kant’s transcendental idealism. A comprehensive investigation of Kant’s adverbial uses of ‘in itself’ rather reveals that there are various groups of verbs that ‘in itself’ modifies, which can more or less all be reduced to a standard use in which ‘in itself’ modifies verbs of predicative being such as the copula. It is also discussed how these findings can be accommodated by the two main alternative kinds of interpretations, that is, two-object and ontological two-aspect interpretations.},
    abstract_source = {openalex},
}

@article{russell2024fantasy,
    author = {Russell, Francey},
    title = {Kant's Fantasy},
    journal = {Mind},
    year = {2024},
    volume = {133},
    number = {531},
    pages = {714--741},
    doi = {10.1093/mind/fzae003},
    note = {SUMMARY: Reconstructs Kant's conception of fantasy (Phantasie), the unintentional, unstructured, obscure and pleasurable imaginative activity that his anthropology describes and criticizes, and asks whether it might play a positive role in experience. Kant distinguishes the lawless freedom of imagination in fantasy from the free lawfulness of imagination in aesthetic judgment; the paper argues, departing from Kant and drawing on Susan Sontag, that certain modernist works positively invite fantasy, so that fantasy belongs to proper aesthetic appreciation while remaining normatively ambiguous (abstract). SUBFIELD AND DEBATE: Mind and anthropology, with aesthetics: Kant's account of imagination and the free play of the faculties. SIGNIFICANCE INDICATORS: S2 citations 6 and CrossRef is-referenced-by-count 5 (retrieved 2026-10-01). Venue: Mind 133(531). YEAR NOTE: CrossRef gives online publication 2024-04-02 and print publication 2024-07-23.},
    keywords = {kant, tp-mind, aes-teleo, anthro-hist-edu, debate-other-imagination, type-article, Medium, summary-source-abstract},
    abstract = {
    abstract_source = {s2},
 Throughout his lectures and published writings on anthropology, Kant describes a form of unintentional, unstructured, obscure, and pleasurable imaginative mental activity, which he calls fantasy (Phantasie), where we ‘take pleasure in letting our mind wander about in obscurity’ (LA 25:480). In the context of his pragmatic anthropology, Kant is concerned not only to describe this form of mental activity as a fact of human psychology, but more importantly, to criticize and discourage it. But must we share Kant’s negative evaluation? Could fantasy play a positive role in some kinds of experience? In this paper I first reconstruct Kant’s conception of fantasy, and then consider what role fantasy might play in aesthetic experience. Precisely because of his anxieties about fantasy, Kant is careful to distinguish between the lawless freedom of the imagination in fantasy and the ‘free lawfulness’ of the imagination in aesthetic judgment. Departing from Kant, and with help from Susan Sontag, I argue that certain aesthetic objects, especially certain works of modernist art, positively invite fantasy, making fantasy part of proper aesthetic appreciation. I conclude by suggesting that while fantasy can indeed play a positive role in aesthetic appreciation, there is still reason to regard fantasy as ‘normatively ambiguous’.},
}

@book{guyer2024impact,
    author = {Guyer, Paul},
    title = {Kant's Impact on Moral Philosophy},
    publisher = {Oxford University Press},
    year = {2024},
    doi = {10.1093/oso/9780199592456.001.0001},
    note = {SUMMARY: Traces the response to the moral philosophy of Kant's Groundwork, second Critique, Religion and Metaphysics of Morals from Fichte, Schelling and Hegel through T. H. Green, Josiah Royce and Nietzsche to Rawls, O'Neill, Korsgaard and Parfit. It argues that the most profound responses have developed Kant's ideal of maximal but equal freedom as the inner worth of the world, answering charges of empty formalism, of leaving no room for happiness, for responsibility for evil or for moral feeling (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy and reception: the reception of Kantian ethics in German idealism, nineteenth-century and analytic moral philosophy, read as a history of Kant's autonomy and freedom. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 13 (retrieved 2026-10-01). Publisher: Oxford University Press. Reviews found by CrossRef search: Kant-Studien (Sticker, 2024), Philosophical Review (Darwall, 2025), Kantian Review (Wilson, 2026). SEP: cited in the kant-moral entry bibliography. NDPR review: not found. YEAR NOTE: CrossRef gives online publication 2024-01-18 and print publication 2024-02-01.},
    keywords = {kant, pp-ethics, recep-idealism, recep-analytic, debate-other-autonomy, type-monograph, High, summary-source-abstract},
    abstract = {Abstract Immanuel Kant’s Groundwork for the Metaphysics of Morals in 1785, followed by his Critique of Practical Reason in 1788, Religion within the Boundaries of Mere Reason in 1793, and Metaphysics of Morals in 1798, introduced a new paradigm into modern moral philosophy. For Kant, the fundamental goal of morality is not the realization of the greatest happiness for the greatest number, but the realization of human autonomy governed by pure reason through the “categorical imperative.” Kant’s ideal of autonomy is nothing less than the greatest possible freedom of each human being to set his or her own ends compatible with the equal freedom of every other human being to do the same. Kant’s work immediately drew the attention of both critics and supporters. While some argued that Kant’s categorical imperative was an “empty formalism,” that he left no room for happiness in his morality, that he could not explain responsibility for evil, and that he allowed no room for moral feeling in morally worthy motivation, others have found inspiration in his underlying idea that maximal but equal freedom is the “inner worth of the world.” This book examines the response to Kant by philosophers from Fichte, Schelling, and Hegel through T. H. Green, Josiah Royce, and Friedrich Nietzsche, to John Rawls, Onora O’Neill, Christine Korsgaard, and Derek Parfit, with many stops along the way. It argues that the most profound responses to Kant have been precisely those that have developed in their own way Kant’s ideal of freedom as the inner worth of the world.},
    abstract_source = {openalex},
}

@book{ameriks2024dignity,
    author = {Ameriks, Karl},
    title = {Kantian Dignity and its Difficulties},
    publisher = {Oxford University Press},
    year = {2024},
    doi = {10.1093/9780198917656.001.0001},
    note = {SUMMARY: A systematic and historical study of Kant's conception of dignity. It defends dignity as rooted in a basic capacity of reason for morality and as an unconditional, inviolable feature of all human beings that deserves universal respect, then examines how the notion was clarified, misunderstood or neglected in five contexts (the Baltics and Herder, Berlin and the rise of Fascism, Philadelphia, London and Richard Price, Washington and Thomas Mann), arguing that Kant held racist and anti-Semitic prejudices and a general old-world elitism in conflict with his own principles (publisher abstract). The NDPR review identifies two issues: what dignity is for Kant, and the complex good and bad influence of Kant's concepts on race, religion, nationalism, colonialism and cosmopolitanism. SUBFIELD AND DEBATE: Practical philosophy and reception: dignity and respect in Kantian ethics, together with Kant's racism and the political reception of his ethics. SIGNIFICANCE INDICATORS: S2 citations 5 and CrossRef is-referenced-by-count 5 (retrieved 2026-10-01). Publisher: Oxford University Press. NDPR review: yes (ndpr.nd.edu/reviews/kantian-dignity-and-its-difficulties). Other reviews found by CrossRef search: Kantian Review (Palatnik, 2025), European Journal of Philosophy (Ertl, 2025), Philosophical Review (van der Rijt, 2026), Journal of Moral Philosophy (Luft, 2026). YEAR NOTE: CrossRef gives online publication 2024-06-17 and print publication 2024-07-18.},
    keywords = {kant, pp-ethics, anthro-hist-edu, recep-other, debate-race, type-monograph, High, summary-source-abstract, summary-source-ndpr},
    abstract = {
    abstract_source = {s2},
 This book is a systematic and historical study of the nature and reception of Kant’s distinctive conception of dignity. The first chapter discusses contemporary interpretations and defends Kant’s concept of dignity as rooted in a basic capacity of reason for morality, and as an unconditional, all-or-nothing, and inviolable feature of all human beings, one that deserves universal respect. The next four chapters build on this systematic account by explaining how Kant’s notion of dignity was further clarified, or seriously misunderstood or neglected, in five significant contexts: the Baltics (Herder and Prussia's relation to the east), Berlin (the rise of Fascism), Philadelphia (the Declaration of Independence), London (Richard Price and reactions to the American and French Revolutions), and Washington (twentieth-century threats to democracy, in relation to Thomas Mann's career). These chapters stress the surprising fact that Kant ignored the enlightened institutions of the United States. They argue that, in addition to expressing specific racist and anti-Semitic prejudices, Kant held to a general old-world elitist prejudice, in conflict with his own principles. The book concludes with a discussion of Thomas Mann as an especially relevant and influential thinker. At first, Mann advocated a chauvinist misunderstanding of Kantian dignity, but later he promoted a cosmopolitan understanding of dignity that included—unlike Kant—an appreciation of the enlightened aspects of the American tradition. Ironically, when Mann arrived at his later view under the influence of Walt Whitman, this helped him to better appreciate the Kantian features of Early Romantic writings in his own tradition.},
}

@book{walschots2024cpr,
    author = {Walschots, Michael},
    title = {Kant's Critique of Practical Reason: Background Source Materials},
    publisher = {Cambridge University Press},
    year = {2024},
    doi = {10.1017/9781108846899},
    note = {SUMMARY: A collection of new and first-time English translations of texts by Kant's predecessors and contemporaries that he read and responded to in the second Critique, together with several later reactions to it, in eleven chapters with editorial material on each author and text. The NDPR review lists the contents: selections from Wolff's German Ethics and Crusius's guide to living rationally, reviews of the Groundwork by Flatt, Tittel and Pistorius, and Wizenmann's 1787 essay, among others (publisher abstract and NDPR). SUBFIELD AND DEBATE: Practical philosophy, editions and translations: the historical context of the Critique of Practical Reason. SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 3 (retrieved 2026-10-01). Publisher: Cambridge University Press. NDPR review: yes (ndpr.nd.edu/reviews/kants-critique-of-practical-reason-background-and-source-materials). Another review found by CrossRef search: British Journal for the History of Philosophy (Rampinini, 2026). YEAR NOTE: CrossRef gives print publication 2024-03-28 and an online date of 2025-01-31; dated by print year; the texts are translations of eighteenth-century sources, not Kant's own works.},
    keywords = {kant, pp-ethics, edition-trans, type-translation-edition, Medium, summary-source-abstract, summary-source-ndpr},
    abstract = {Kant did not initially intend to write the Critique of Practical Reason, let alone three Critiques. It was primarily the reactions to the Critique of Pure Reason and the Groundwork of the Metaphysics of Morals that encouraged Kant to develop his moral philosophy in the second Critique. This volume presents both new and first-time English translations of texts written by Kant's predecessors and contemporaries that he read and responded to in the Critique of Practical Reason. It also includes several subsequent reactions to the second Critique. Together, the translations in this volume present the Critique of Practical Reason in its full historical context, offering scholars and students new insight into Kant's moral philosophy. The detailed editorial material appended to each of the eleven chapters helps introduce readers to the life and works of the authors, outlines the texts translated, and points to relevant passages across Kant's works.},
    abstract_source = {s2},
}

@book{vilhauer2024sympathy,
    author = {Vilhauer, Benjamin},
    title = {Kant on Rational Sympathy},
    publisher = {Cambridge University Press},
    year = {2024},
    doi = {10.1017/9781009371193},
    note = {SUMMARY: An Element explaining Kant's distinction between rational sympathy, regulated by practical reason and necessary for adopting as our own those ends of others that are contingent from the standpoint of practical rationality, and natural sympathy, which is passive and can prompt affect and dispose us to act wrongly. On the account given, sympathy is a function of a posteriori productive imagination, and in rational sympathy we freely use the imagination to step into others' first-person perspectives (publisher abstract). SUBFIELD AND DEBATE: Practical philosophy, Metaphysics of Morals and the Doctrine of Virtue: duties of sympathy and moral feeling, with Kant's philosophy of mind. SIGNIFICANCE INDICATORS: S2 citations 10 and CrossRef is-referenced-by-count 11 (retrieved 2026-10-01). Publisher: Cambridge University Press, short monograph in the Cambridge Elements format. No review found by CrossRef search or NDPR search. YEAR NOTE: CrossRef gives online publication 2024-12-02 and print publication 2024-12-31.},
    keywords = {kant, pp-mm-virtue, tp-mind, debate-other-moral-feeling, type-monograph, Medium, summary-source-abstract},
    abstract = {This Element explains Kant's distinction between rational sympathy and natural sympathy. Rational sympathy is regulated by practical reason and is necessary for adopting as our own those ends of others which are contingent from the perspective of practical rationality. Natural sympathy is passive and can prompt affect and dispose us to act wrongly. Sympathy is a function of a posteriori productive imagination. In rational sympathy, we freely use the imagination to step into others' first-person perspectives and associate imagined intuitional contents with the concepts others use to communicate their feelings. This prompts feelings in us that are like their feelings.},
    abstract_source = {openalex},
}

@book{guyer2024right,
    author = {Guyer, Paul},
    title = {The Moral Foundation of Right},
    publisher = {Cambridge University Press},
    year = {2024},
    doi = {10.1017/9781009464505},
    note = {SUMMARY: An Element arguing that Kant's Universal Principle of Right follows straightforwardly from the foundational idea of his moral philosophy as a whole. Right is the coercively enforceable part of morality, contrasted with Ethics as the part that is not coercively enforceable, and the author sets this against those who have questioned whether Right is part of morality (publisher abstract). SUBFIELD AND DEBATE: Political and legal philosophy, Doctrine of Right: the relation of Right to morality, the question of the independence of Kant's legal philosophy from his ethics. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 14 (retrieved 2026-10-01). Publisher: Cambridge University Press, short monograph in the Cambridge Elements format. SEP: cited in the kant-social-political entry bibliography. No review found by CrossRef search or NDPR search. YEAR NOTE: CrossRef gives online publication 2024-12-04 and print publication 2024-12-31.},
    keywords = {kant, pp-right-politics, debate-other-right-morality, type-monograph, Medium, summary-source-abstract},
    sep_context = {SEP entry kant-social-political (Kant's Social and Political Philosophy), preamble, cites Guyer 2024 (the Moral Foundation of Right Element is the 2024 Guyer item in the entry bibliography) among work that stresses the broader connections between Kant's legal and political philosophy and his critical and moral philosophy overall, alongside Rosen 1993, Williams 1983, Murphy 1970 and Shell 1980 and 1996.},
    abstract = {Kant defined 'Right' (Recht) as the condition that obtains among a population of physically embodied persons capable of setting their own ends who live on a finite surface and therefore cannot avoid interaction with each other if each is as free to set their own ends as is consistent with the freedom of all to do the same. He regarded this rational idea, heir to the traditional idea of 'natural Right, as the test of the legitimacy of the laws of any actual state, or 'positive Right.' He clearly considered Right to be part of morality as a whole, namely the coercively enforceable part, as contrasted to Ethics, which is the non-coercively enforceable part of morality. Some have questioned whether Right is part of morality, but this Element shows how Kant's "Universal Principle of Right" follows straightforwardly from the foundational idea of Kant's moral philosophy as a whole.},
    abstract_source = {openalex},
}

@article{papish2024race,
    author = {Papish, Laura},
    title = {Kant on race and the radical evil in the human species},
    journal = {European Journal of Philosophy},
    year = {2024},
    volume = {32},
    number = {1},
    pages = {49--66},
    doi = {10.1111/ejop.12921},
    note = {SUMMARY: Reads Religion within the Boundaries of Mere Reason alongside Kant's natural history writings on the concept of race and the development of the human races, a pairing the literature has neglected. It argues that this clarifies the claim of a radical evil in the human species: that evil is not a static property but a dynamic, changing defect in human nature that increasingly threatens aspirations to collective moral perfection (abstract). SUBFIELD AND DEBATE: Religion and anthropology: radical evil in the Religion and the Kant and race debate, which the paper approaches through Kant's natural history. SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Venue: European Journal of Philosophy 32(1). YEAR NOTE: CrossRef gives online publication 2024-01-12 and print publication 2024-03.},
    keywords = {kant, religion, anthro-hist-edu, debate-race, debate-other-radical-evil, type-article, Medium, summary-source-abstract},
    abstract = {Religion within the Boundaries of Mere Reason remains one of the most opaque of Kant's published writings. Though this opacity belongs, partly, to the text itself, a key claim of this article is that this opacity stems also from the narrow lenses through which his readers view this text. Often read as part of Kant's moral philosophy or his universal history, the literature has thus far neglected a different vantage point on the Religion, one that does not refute the utility of these lenses but complements them. This paper places the Religion alongside parts of Kant's corpus that it is less typically paired with, namely his natural history writings—in particular, his writings on the concept of race and the development of the human races. I argue that by doing so, we can shed much light on Kant's infamous claim that there is a radical evil in the human species. More precisely, we will come to appreciate that this evil is not, as it is usually understood, a static property or fixed characteristic of human beings. Instead, radical evil concerns a dynamic, changing defect in human nature that increasingly threatens our aspirations to collective moral perfection.},
    abstract_source = {s2},
}

@article{huseyinzadegan2024haiti,
    author = {Huseyinzadegan, Dilek},
    title = {Conjectures on Kant and the Haitian Revolution},
    journal = {The Southern Journal of Philosophy},
    year = {2024},
    volume = {62},
    number = {S1},
    pages = {72--81},
    doi = {10.1111/sjp.12562},
    note = {SUMMARY: Puts forward, as a suspicion only, that Kant never thought Black lives had dignity but only price. Following Michel-Rolph Trouillot's argument that the Haitian Revolution was unthinkable for Enlightenment philosophers, it conjectures what Kant could or should have said about the revolution, drawing on his writings on the American and French Revolutions; if the suspicion is right, Kantianism cannot accommodate an antiracist program, which should change how racism, slavery and colonialism are discussed in Kant scholarship (abstract). SUBFIELD AND DEBATE: Race, colonialism and political philosophy: the systematic-link question about Kant's racism and the critical philosophy, argued here on the negative side. SIGNIFICANCE INDICATORS: S2 citations 11 and CrossRef is-referenced-by-count 9 (retrieved 2026-10-01). Venue: The Southern Journal of Philosophy 62 (issue S1). Related earlier work in this project: Huseyinzadegan's 2022 Kantian Review contribution to the Mills symposium is listed under considered works for 2022. YEAR NOTE: CrossRef gives online publication 2024-03-22 and print publication 2024-09.},
    keywords = {kant, anthro-hist-edu, pp-right-politics, debate-race, debate-colonialism, type-article, Medium, summary-source-abstract},
    abstract = {In this article, I put forward, as a suspicion only, that Kant never thought Black lives had dignity but only price. I follow Michel‐Rolph Trouillot's argument that the Haitian Revolution is unthinkable for Enlightenment philosophers to examine what Kant could have, would have, or should have said about this world‐historical event. By making conjectures about Kant's silence on the Haitian Revolution, I also draw from Kant's writings on the American and French Revolutions. If my suspicion is right, then Kantianism cannot accommodate an antiracist program. This ought to change how we talk about racism, slavery, and colonialism in Kant scholarship and in the history of philosophy.},
    abstract_source = {s2},
}

@book{fugate2024baumgarten,
    editor = {Fugate, Courtney D. and Hymers, John},
    title = {Baumgarten and Kant on the Foundations of Practical Philosophy},
    publisher = {Oxford University Press},
    year = {2024},
    doi = {10.1093/oso/9780192873538.001.0001},
    note = {SUMMARY: Thirteen chapters on the historical background and philosophical content of Baumgarten's Elements of First Practical Philosophy (1760) and its relation to Kant's work. The volume follows the editors' earlier Kant and Baumgarten on Metaphysics (2018) and builds on their first English translations of Baumgarten's Elements and Kant's Reflections on Moral Philosophy (2020), and it treats the Baumgarten connection as a neglected aspect of classical German philosophy (publisher abstract). SUBFIELD AND DEBATE: Pre-critical and early practical philosophy: the Wolffian and Baumgartenian background to Kant's moral philosophy, including chapters on conscience and perfectionism seen in CrossRef chapter records. SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 1 (retrieved 2026-10-01). Publisher: Oxford University Press. Review found by CrossRef search: Kantian Review (Osawa, 2026). NDPR review: not found. YEAR NOTE: CrossRef gives online and print publication 2024-06-20.},
    keywords = {kant, precritical, pp-ethics, debate-other-baumgarten, type-edited-volume, Medium, summary-source-abstract},
    abstract = {
    abstract_source = {s2},
 This volume consists of thirteen chapters examining the historical background and philosophical content of Alexander Gottlieb Baumgarten’s Elements of First Practical Philosophy (Initia philosophiae practicae primae, 1760) and its relation to the work of Immanuel Kant. All the contributors are well-established scholars and the chapters, taken together, provide a comprehensive, balanced, and indeed ground-breaking treatment of this neglected aspect of classical German philosophy. Like its predecessor, Kant and Baumgarten on Metaphysics (OUP, 2018), this volume aims to capitalize on the editors’ recent, first-ever translation into English of two key texts, namely, Baumgarten’s Elements and Kant’s Reflections on Moral Philosophy (Bloomsbury, 2020).},
}

@article{kinzel2024neokantian,
    author = {Kinzel, Katherina},
    title = {Neo-Kantian conceptualism: between scientific experience and everyday perception},
    journal = {British Journal for the History of Philosophy},
    year = {2024},
    volume = {32},
    number = {6},
    pages = {1350--1373},
    url = {https://doi.org/10.1080/09608788.2023.2237070},
    note = {SUMMARY: Reconstructs the major transformations in the Marburg neo-Kantian account of experience by focusing on the problem of conceptualism. It links four issues central to the Marburg philosophers' transcendental projects (the interpretation of Kant, the critique of experiential givenness, objective cognition in science, and the relation of scientific and pre-scientific experience) and identifies two shifts: from Cohen's conceptualist answer to subjectivism to Cassirer's functionalist answer to empiricism, and from Cassirer's conceptualism about scientific experience to his symbolic non-conceptualism about everyday perception (abstract). SUBFIELD AND DEBATE: Neo-Kantian reception: Marburg neo-Kantianism and the conceptualism versus nonconceptualism debate. SIGNIFICANCE INDICATORS: S2 citations 3 and CrossRef is-referenced-by-count 1 (retrieved 2026-10-01). Venue: British Journal for the History of Philosophy 32(6). YEAR NOTE: CrossRef gives online publication 2023-08-08 and print publication 2024-11 (volume 32, issue 6); dated by print year per the project rule.},
    keywords = {kant, recep-neokantian, debate-conceptualism, type-article, Medium, summary-source-abstract},
    abstract = {ABSTRACT This paper reconstructs the major transformations in the Marburg neo-Kantian account of experience. By focusing on the problem of ‘conceptualism’, it traces connections between four issues that are central to the transcendental projects of the Marburg philosophers: the interpretation of Kant, the critique of experiential givenness, the account of objective cognition in science, and the relation between scientific and pre-scientific experience. My historical narrative identifies two shifts. The first is from Cohen's conceptualist answer to the threat of subjectivism to Cassirer's functionalist answer to empiricism. The second is from Cassirer's conceptualism about scientific experience to his symbolic non-conceptualism about everyday perception. My reconstruction reveals the fate of neo-Kantian conceptualism to be linked to the fate of pre-scientific perception and suggests that the continuing significance of the Marburg philosophers lies in their responses to the coming apart of the manifest and the scientific image.},
    abstract_source = {s2}
}

@book{aigner2024technics,
    author = {Aigner, Franziska},
    title = {Kant and Technics: From the Critique of Pure Reason to the Opus Postumum},
    publisher = {Bloomsbury Publishing Plc},
    year = {2024},
    doi = {10.5040/9781350299061},
    note = {SUMMARY: Answers the claim, associated with Heidegger, Simondon and Stiegler, that Kant's philosophy is incapable of thinking technics. It argues that there is an explicit concept of technics at work in Kant's philosophy and that, from the Critique of Pure Reason (1780) to the posthumously published Opus Postumum (1796-1803), transcendental philosophy is at once constituted against, reliant upon and proceeding from technics; so Kant cannot be treated as philosophy's most prominent techno-oblivious thinker (publisher abstract). SUBFIELD AND DEBATE: Opus postumum and reception: Kant and technology read against Heidegger, Simondon and Stiegler, with attention to the late manuscripts (CrossRef chapter records include one on the Opus Postumum and Gerhard Lehmann). SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Publisher: Bloomsbury. No review found by CrossRef search or NDPR search. YEAR NOTE: CrossRef gives 2024 for both print and issued dates, without month.},
    keywords = {kant, opus-postumum, recep-phenom, recep-other, debate-other-technics, type-monograph, Low, summary-source-abstract},
    abstract = {Martin Heidegger, Gilbert Simondon, and Bernard Stiegler each argued in their own way that, ever since its inception in ancient Greece, western philosophy is incapable of thinking technics, which reaches its clearest expression in the philosophy of Immanuel Kant.According to Heidegger, Kant articulated the essence of modern technics as enframing (Gestell) without understanding the nature of his own insight, while Simondon claimed that transcendental philosophy is structurally incapable of thinking technics as its answer to the question of technics either comes too early (a priori) or too later (a posteriori). Stiegler synthesized both positions in his claim that Kant was incapable of acknowledging the technical constitution of his own consciousness. All three thinkers thus argue, in one way or another, that Kant was essentially incapable of seeing, understanding, let alone thinking, technics.
    abstract_source = {s2},
 The intention of this book is two-fold. On the one hand, it argues that, despite Heidegger, Simondon, and Stiegler’s inability of recognizing it, there is an explicit concept of technics at work in Kant’s philosophy. This technics is however notatechnics that was overlooked by Heidegger, Simondon, and Stiegler. Instead, this book shows that, from theCritique of Pure Reason(1780) until the posthumously publishedOpus Postumum(1796-1803), transcendental philosophy is at once constitutedagainst, while at the same time relyingupon, and proceedingfromtechnics. On the other hand, this book engages with the broader relation between philosophy and technics. If there is indeed such a thing as a Kantian thought on technics, then Kant can no longer be considered philosophy’s most prominent ‘techno-oblivious’ thinker. The question about the relation between Kant and technics is thus nothing less than a question about the relation between philosophy and technics as a whole.},
}

@book{gomes2024handbook,
    editor = {Gomes, Anil and Stephenson, Andrew},
    title = {The Oxford Handbook of Kant},
    publisher = {Oxford University Press},
    year = {2024},
    doi = {10.1093/oxfordhb/9780198854586.001.0001},
    note = {SUMMARY: A handbook of newly commissioned essays that present where the study of Kant's philosophy stands in the twenty-first century. It is organized around Kant's four questions (what can I know, what ought I to do, what may I hope, what is the human being), and aims to help students and scholars think for themselves about the topics on which he wrote (publisher abstract). CrossRef chapter records show chapters on, among others, transcendental idealism, logic, mathematics, the special sciences, autonomy and freedom, virtue, right, religion, evil, hope, education, race, and sex and gender. SUBFIELD AND DEBATE: Reference work covering all subfields, published in the tercentenary year; it supplies an overview of the state of Kant studies and, via its chapters on race, sex and gender, and education, a thin but explicit point of entry to those subfields in this year. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 2 for the volume (retrieved 2026-10-01); chapter-level counts are 0 to 3. Publisher: Oxford University Press, Oxford Handbooks series. No review found by CrossRef search or NDPR search. YEAR NOTE: CrossRef gives online publication 2024-10-22 and print publication 2024-10-31; chapters were available online during 2024.},
    keywords = {kant, reference, type-edited-volume, type-reference-work, Medium, summary-source-abstract},
    abstract = {Abstract Immanuel Kant (1724–1804) is a towering figure of Western philosophy, someone whose work continues to exert an influence across all areas of the discipline. His work is characterized by both breadth and unity: he writes powerfully about mind, epistemology, metaphysics, logic, mathematics, natural science, ethics, politics, religion, history, aesthetics, education, and more. And across those areas, he is concerned to work out and defend a view of human beings and their place in nature according to which our own reason enables us to discover and uphold the laws of nature and freedom—that is, to think for ourselves. The newly commissioned essays which make up this Handbook collectively present a picture of where the study of Kant’s philosophy finds itself, at this point in the twenty-first century. They are organized around the four questions which Kant said unite all interest of our reason: (1) What can I know? (2) What ought I to do? (3) What may I hope? and (4) What is the human being? Their aim is to help students and scholars of Kant’s philosophy think for themselves about the topics about which he wrote with such insight.},
    abstract_source = {openalex},
}
