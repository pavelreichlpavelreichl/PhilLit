@article{chignell2023hope,
    author = {Chignell, Andrew},
    title = {Demoralization and Hope: A Psychological Reading of Kant's Moral Argument},
    journal = {The Monist},
    year = {2023},
    volume = {106},
    number = {1},
    pages = {46--60},
    doi = {10.1093/monist/onac022},
    note = {SUMMARY: Examines three varieties of Kant's "moral proof" under the doctrine of the primacy of the practical, and argues that the third, a "moral-psychological argument" based on the need to sustain moral hope and avoid demoralization, has advantages over the others. It starts from a premise that coheres better with Kant's mature account of moral motivation and invokes plausible empirical-psychological theses to support a commitment to the full-blown classical deity, which is the result Kant wanted (abstract). SUBFIELD AND DEBATE: Religion and moral philosophy: the moral argument for God and the postulates, the primacy of the practical, and moral hope. SIGNIFICANCE INDICATORS: CrossRef is-referenced-by-count 12; S2 record without a citation count (retrieved 2026-10-01). Venue: The Monist 106(1). YEAR NOTE: CrossRef gives print and online publication 2023-05-30.},
