@book{heneghan2025environmental,
  author = {Heneghan, Fiacha D.},
  title = {Kantian Ethics and Environmental Philosophy: Pursuing the Good in an Age of Crisis},
  publisher = {Edinburgh University Press},
  year = {2025},
  doi = {10.3366/edinburgh/9781399531535.001.0001},
  note = {SUMMARY: Argues that a Kantian perspective on the good illuminates a structural tension in moral thought relevant to the environmental crisis. Kant's ethics shows that we are inclined to believe that pursuing our interests is reconcilable with promoting the general good, which leads us to expect environmental win-wins; the author argues that this expectation has no basis in reality and that the way forward in the Anthropocene runs through non-consolatory hope (publisher abstract).

SUBFIELD AND DEBATE: Practical philosophy and environmental ethics: the highest good, hope and the demands of morality applied to the environmental crisis; this entry covers the ecological and non-human nature strand of Kant scholarship.

SIGNIFICANCE INDICATORS: S2 book-level record not located; CrossRef is-referenced-by-count 1 (retrieved 2026-10-01). Publisher: Edinburgh University Press. Reviews found by CrossRef search: Vereb, Kantian Review (2026); Baumeister, Environmental Philosophy (2026). NDPR review: not found.

YEAR NOTE: CrossRef gives print and issued publication 2025-01-31 and online publication 2025-09-18; a second CrossRef record for the same title (De Gruyter eBook, DOI 10.1515/9781399531559) gives print 2025-12-31 and online 2024-11-25.},
  keywords = {kant, pp-ethics, debate-other-environment, type-monograph, Medium, summary-source-abstract},
  abstract = {This book argues that a Kantian perspective on the good illuminates a structural tension in human moral thought particularly relevant to the environmental crisis. Kant’s ethics reveals that we are naturally inclined to believe that pursuing our interests is reconcilable with the promotion of the general good. This inclination leads us to expect an abundance of environmental “win-wins,” in which we can fulfil our environmental duties without sacrificing any material interests. If the argument of this book is correct, however, this thought has no basis in reality. It is, in fact, only an instance of that broader inclination, which in philosophical terms might be called “consolation.” The way forward for humanity as it enters the Anthropocene must instead run through some form of non-consolatory hope. This would involve an acknowledgement of the difficult choices ahead—a necessary first step to forming a coherent and rational hope for a better world.},
  abstract_source = {openalex},
}

@book{bruno2025facticity,
  author = {Bruno, G. Anthony},
  title = {Facticity and the Fate of Reason After Kant},
  publisher = {Oxford University Press},
  year = {2025},
  doi = {10.1093/9780191987533.001.0001},
  note = {SUMMARY: A history of the concept of facticity from Fichte, who coins it to denote brute conditions that reason presupposes, through Hegel's presuppositionless science and Schelling's objection to it, to Heidegger's hermeneutics of facticity. It argues that the post-Kantian trajectory from German idealism to phenomenology is one in which facticity first impedes the science of intelligibility and then characterizes the situation in which that science is possible (publisher abstract); the NDPR review adds chapters on Lask, Dilthey and Heidegger.

SUBFIELD AND DEBATE: Reception: post-Kantian German idealism, neo-Kantian and phenomenological responses to Kant, on whether a science of intelligibility can tolerate brute facts.

SIGNIFICANCE INDICATORS: S2 citations 5 and CrossRef is-referenced-by-count 4 (retrieved 2026-10-01). Publisher: Oxford University Press. NDPR review: yes (2025.10.9, reviewer Crowell). Other reviews found by CrossRef search: Beiser, British Journal for the History of Philosophy (2026); Fisher, European Journal of Philosophy (2026); Ellis, Graduate Faculty Philosophy Journal (2026); author's response in British Journal for the History of Philosophy (2026).

YEAR NOTE: CrossRef gives online (issued) publication 2025-01-30 and print publication 2025-03-04.},
  keywords = {kant, recep-idealism, recep-phenom, recep-neokantian, type-monograph, High, summary-source-abstract},
  abstract = {
  abstract_source = {s2},
 Facticity and the Fate of Reason After Kant is the first history of the concept of facticity. It shows that this concept’s coining, transmission, and repurposing by post-Kantian thinkers leaves a lasting divide concerning the question of whether a science of intelligibility can tolerate brute facts. ‘Facticity’ is associated with phenomenology, for which it denotes undeducibly brute conditions of intelligibility. While this suggests an affirmative answer to the post-Kantian question, ‘facticity’ originates with German idealism, whose proponents answer negatively. Fichte coins ‘facticity’ to denote intolerably brute conditions that are putatively presupposed by reason. A science of intelligibility must eliminate bruteness to be systematic, as Fichte says, or presuppositionless, as Hegel says. Moreover, eliminating bruteness requires dialectical logic, which Fichte invents and Hegel develops, to deduce conditions of intelligibility from reason’s self-contradictions. German idealism’s logical revolution provokes Heidegger’s objection that dialectic ineluctably presupposes factical conditions of lived experience, which must be interpreted hermeneutically. The untold history of ‘facticity’ thus contains the deepest parting of the ways after Kant. On the one hand, Hegel follows Fichte in pursuing a presuppositionless science, although Schelling charges Hegel with presupposing both that science’s value and existence itself. On the other hand, Heidegger rejects presuppositionlessness for a hermeneutics of facticity. The trajectory from German idealism to phenomenology is accordingly one in which facticity initially impedes the science of intelligibility yet ultimately characterizes the situation in which this science is possible. Within this trajectory, reason is fated to transform from the hand holding the world to the thrown activity of being-in-the-world.},
}

