@article{luadler2026colonialslavery,
  author = {Lu-Adler, Huaping},
  title = {Kant, the Political Economy of Colonial Slavery, and Racial Capitalism},
  journal = {Canadian Journal of Philosophy},
  year = {2026},
  doi = {10.1017/can.2026.10083},
  note = {SUMMARY: Notes that Kant observed that enslaved Africans functioned as money in trade and that their number measured a nation's wealth, while he racialised the Negro as suited to slave labour, benefited indirectly from such labour, did not call colonial slavery unjust and at times signalled anti-abolitionist sympathies. On this background the paper asks what the prospects are for a deracialised, radical Kantian liberalism (abstract).

SUBFIELD AND DEBATE: Race, colonialism and political economy: Kant's views on slavery and race and whether Kantian liberalism can be revised; contributes to the debate over Kant's racism and the universalist reading.

SIGNIFICANCE INDICATORS: S2 citations 0 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Venue: Canadian Journal of Philosophy (online first). The author's book Kant, Race, and Racism is the subject of the 2025 Mind critical notice by Kleingeld included in this file.

YEAR NOTE: CrossRef gives online publication 2026-08-11 and no print date; the entry qualifies on the 2026 online date and has no volume or issue yet.},
  keywords = {kant, anthro-hist-edu, pp-right-politics, debate-race, debate-colonialism, type-article, Medium, summary-source-abstract},
  abstract = {
  abstract_source = {s2},
 Colonial slavery supercharged Europe’s prosperity in the eighteenth century. It was legally sanctioned, supported by state powers, and largely condoned by the public. Against this backdrop, Kant observed that “Negro slaves” functioned as money in trade, their number measured a nation’s wealth, and the slavery business was therefore intertwined with a competitive intra-European politics. Meanwhile, he racialized the “Negro” as uniquely suited for slave labor, indirectly benefited from such labor, refrained from calling colonial slavery an unjust institution, and occasionally signaled anti-abolitionist sympathies. Given these facts, what is the prospect of a deracialized, radical Kantian liberalism?},
}

@book{noller2026respect,
  author = {Noller, Jörg},
  title = {Kant on Respect (Achtung)},
  publisher = {Cambridge University Press},
  year = {2026},
  url = {https://doi.org/10.1017/9781009511049},
  note = {SUMMARY: A Cambridge Element reconstructing Kant's statements on the moral feeling of respect (Achtung) by its position across the three Critiques, the Religion and the Metaphysics of Morals: noumenal causation, moral motivation, the dynamic sublime, and imputability and education. It argues from the self-reflective volitional structure of respect for a compatibilist account on which both the intellectualist and the affectivist interpretations are true (publisher abstract).

SUBFIELD AND DEBATE: Moral psychology and moral motivation: respect as moral feeling, in the intellectualist versus affectivist debate on the Second Critique.

SIGNIFICANCE INDICATORS: S2 citations 0 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Publisher: Cambridge University Press (Cambridge Elements). Reviews found by CrossRef search: Falduto, Journal of Transcendental Philosophy (2026); Rigolli, Con-Textos Kantianos (2026).

YEAR NOTE: CrossRef gives online publication 2025-12-15 and print publication 2026-01-31; S2 gives 2025. Dated by print year per the project rule. The DOI is given as a url so that the metadata cleaner does not overwrite the year.},
  keywords = {kant, pp-ethics, tp-mind, debate-other-moral-feeling, type-monograph, Medium, summary-source-abstract},
  abstract = {This Element reconstructs Kant's puzzling statements about the moral feeling of respect (Achtung), which is 'a feeling self-wrought by means of a rational concept and therefore specifically different' from all common feelings (4:401n.). The focus is on the systematic position of respect within the framework of Kant's major works and within the faculties of the human mind. The concept of respect is discussed with regard to (i) the transcendental problem of noumenal causation in Kant's first Critique; (ii) the practical problem of moral motivation in Kant's second Critique; (iii) the aesthetic problem of feeling and the dynamic sublime in Kant's third Critique; and (iv) the problem of moral imputability and education in Kant's Religion and Metaphysics of Morals. By considering its self-reflective volitional structure, this Element argues for a compatibilist account of the moral feeling of respect, according to which both intellectualist and affectivist interpretations are true.},
  abstract_source = {crossref},
}

@book{khurana2026lifefreedom,
  author = {Khurana, Thomas},
  title = {The Life of Freedom in Kant and Hegel},
  publisher = {Cambridge University Press},
  year = {2026},
  doi = {10.1017/9781009542432},
  note = {SUMMARY: Argues that the dominant conception of autonomy generates the paradox of self-legislation and a dualistic opposition of freedom and nature, and develops from Kant's and Hegel's concepts of life an understanding of freedom as a form of life. On this view we are autonomous by inhabiting our living nature in the right way, which calls for a critical theory of second nature (publisher abstract).

SUBFIELD AND DEBATE: Ethics and the theory of autonomy, with the Kant-Hegel reception: a critical reinterpretation of Kantian autonomy and self-legislation through the concept of life.

SIGNIFICANCE INDICATORS: S2 citations 2 and CrossRef is-referenced-by-count 2 (retrieved 2026-10-01). Publisher: Cambridge University Press. No review found by CrossRef search or NDPR sitemap check.

YEAR NOTE: CrossRef gives online publication 2026-04-07 and print publication 2026-04-30.},
  keywords = {kant, pp-ethics, recep-idealism, debate-constructivism, type-monograph, Medium, summary-source-abstract},
  abstract = {Autonomy is one of the central aspirations of our time, yet there is a growing worry that autonomy, as we have understood and practised it, has not liberated us but subjected us to new forms of domination. In his ground-breaking reinterpretation of Kant and Hegel, Thomas Khurana reveals the source of these problems in the very concept of autonomy and develops a new understanding of human self-determination. While the dominant conception of autonomy gives rise to the paradox of self-legislation and remains caught up in a dualistic opposition of freedom and nature, we can overcome these problems by understanding freedom as a form of life. Elaborating both Kant's and Hegel's compelling concepts of life, Khurana shows that we are not autonomous despite or against our living nature, but by inhabiting it in the right way. To understand freedom, we need a critical theory of our second nature.},
  abstract_source = {s2},
}

@book{tuna2026artcriticism,
  author = {Tuna, Emine Hande},
  title = {Kantian Art Criticism},
  publisher = {Cambridge University Press},
  year = {2026},
  doi = {10.1017/9781009620291},
  note = {SUMMARY: Argues that Kant's aesthetics can ground a theory of art criticism despite his rejection of aesthetic testimony and of general rules of taste. It locates the solution in Kant's overlooked judgments of perfection, which mediate between aesthetic evaluations and descriptions of a work's non-aesthetic features (publisher abstract).

SUBFIELD AND DEBATE: Aesthetics: the Critique of the Power of Judgment on judgments of taste, testimony and perfection; applies Kantian aesthetics to critical practice.

SIGNIFICANCE INDICATORS: S2 citations 0 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Publisher: Cambridge University Press. No review found by CrossRef search or NDPR sitemap check.

YEAR NOTE: CrossRef gives online publication 2026-06-23 and print publication 2026-08-31.},
  keywords = {kant, aes-teleo, debate-other-aesthetic-testimony, type-monograph, Low, summary-source-abstract},
  abstract = {Combining historical insight with contemporary theory, this book demonstrates that Kant's aesthetics can ground a robust theory of art criticism. It challenges the widespread view that Kant's rejection of aesthetic testimony – the idea that we cannot simply adopt someone else's judgment without first-hand experience - and his dismissal of general rules such as 'symmetry guarantees beauty' or 'a tragic ending ensures depth' leaves critics powerless. If testimony and rules are excluded, evaluations such as 'Blade Runner is a masterpiece' lose authority, while descriptions like 'most of the story takes place in perpetual rain and darkness' seems irrelevant to the critic's evaluation. This book locates the solution in Kant's overlooked judgments of perfection such as 'the film innovates within the neo-noir genre.' It reimagines what critical communication can be by positioning these judgments as mediators. They guide aesthetic evaluations and draw support from descriptions of a work's non-aesthetic features.},
  abstract_source = {s2},
}
