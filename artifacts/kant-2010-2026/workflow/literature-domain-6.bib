@book{bruno2025facticity,
  author = {Bruno, G. Anthony},
  title = {Facticity and the Fate of Reason After Kant},
  publisher = {Oxford University Press},
  year = {2025},
  doi = {10.1093/9780191987533.001.0001},
  note = {SUMMARY: A history of the concept of facticity from Fichte, who coins it to denote brute conditions that reason presupposes, through Hegel's presuppositionless science and Schelling's objection to it, to Heidegger's hermeneutics of facticity. It argues that the post-Kantian trajectory from German idealism to phenomenology is one in which facticity first impedes the science of intelligibility and then characterizes the situation in which that science is possible (publisher abstract); the NDPR review adds chapters on Lask, Dilthey and Heidegger.

SUBFIELD AND DEBATE: Reception: post-Kantian German idealism, neo-Kantian and phenomenological responses to Kant, on whether a science of intelligibility can tolerate brute facts.

