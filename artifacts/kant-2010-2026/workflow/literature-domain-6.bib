@book{thomson2025opus,
  author = {Thomson, Terrence},
  title = {Metaphysics of Nature and Failure in Kant's Opus postumum},
  publisher = {Bloomsbury Publishing Plc},
  year = {2025},
  doi = {10.5040/9781350418516},
  note = {SUMMARY: Argues that the Opus postumum is Kant's last attempt to deliver the promised system of speculative reason in a work called metaphysics of nature, and reads the surviving drafts for how they fail to establish that work rather than for projected success. It maintains that this failure gives reason to study the Opus postumum seriously, not to abandon it (publisher abstract).

SUBFIELD AND DEBATE: Opus postumum and the late metaphysics of nature: whether the late drafts continue, rupture with or complete the critical system.

