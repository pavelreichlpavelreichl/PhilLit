@book{anderson2025skeptical,
  author = {Anderson, Abraham},
  title = {The Skeptical Roots of Critique: Hume's Attack on Theology and the Origin of Kant's Antinomy},
  publisher = {Oxford University Press},
  year = {2025},
  doi = {10.1093/oso/9780197684009.001.0001},
  note = {SUMMARY: Argues that the Antinomy of Pure Reason, like the Critique of Pure Reason as a whole, stems from Hume's attack on metaphysics, so that Kant's two "awakenings" from dogmatic slumber (by Hume and by the Antinomy) are reconciled. The Antinomy is traced to Hume's challenge to the causal principle of rationalism and to the metaphysics founded on that principle (publisher abstract).

SUBFIELD AND DEBATE: Theoretical philosophy: the origin and development of the Critique of Pure Reason, the Hume-Kant relation and the Antinomy; bears on the debate over what woke Kant from dogmatic slumber.

SIGNIFICANCE INDICATORS: S2 citations 0 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Publisher: Oxford University Press. Review found by CrossRef search: Falkenstein, Kantian Review (2026). NDPR review: not found.

YEAR NOTE: CrossRef gives online publication 2025-01-23 and print publication 2025-03-12.},
  keywords = {kant, tp-cpr, debate-other-hume, type-monograph, Medium, summary-source-abstract}
}

@article{stang2025obsolete,
  author = {Stang, Nicholas F.},
  title = {Is Kant's Critique of Metaphysics Obsolete?},
  journal = {Philosophy and Phenomenological Research},
  year = {2025},
  volume = {111},
  number = {1},
  pages = {25--53},
  doi = {10.1111/phpr.70002},
  note = {SUMMARY: Takes from Kant the problem of what explains why the terms of our metaphysical theories (such as property or grounding) refer to entities and structures in the world. It distinguishes a deflationary meta-metaphysics, which answers this easily, from a substantive view for which the explanatory task is harder, and argues that the substantive metaphysician's replies are inadequate or depend on the idea of joint carving (abstract).

SUBFIELD AND DEBATE: Theoretical philosophy and metaphysics: a Kantian challenge to contemporary substantive metaphysics, in the debate over Kant's critique of metaphysics and its current relevance.

SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 1 (retrieved 2026-10-01). Venue: Philosophy and Phenomenological Research 111(1).

YEAR NOTE: CrossRef gives online publication 2025-04-04 and print publication 2025-07.},
  keywords = {kant, tp-cpr, debate-other-metametaphysics, type-article, Medium, summary-source-abstract}
}

@article{hogan2025nutshell,
  author = {Hogan, Desmond},
  title = {Kant's Nutshell Argument for Idealism},
  journal = {Noûs},
  year = {2025},
  volume = {59},
  number = {3},
  pages = {652--677},
  url = {https://doi.org/10.1111/nous.12528},
  note = {SUMMARY: Takes up a neglected passage in which Kant supports transcendental idealism by observing that the whole world could be contained in a nutshell and all elapsed time in a second without any difference being met with. Against the background of Poincare's and the logical empiricists' treatment of the universal-doubling hypothesis as empty, it asks what Kant's Nutshell Argument means and notes that the word also may signal an idealist argument distinct from those in the published works (abstract).

SUBFIELD AND DEBATE: Theoretical philosophy and philosophy of space and geometry: an unpublished-notes argument for transcendental idealism about space and time.

SIGNIFICANCE INDICATORS: S2 citations 0 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Venue: Nous 59(3).

YEAR NOTE: CrossRef and S2 give online publication 2024-09-24 (S2 year 2024); print publication is 2025-09 (volume 59, issue 3), and the entry is dated by print year per the project rule. The DOI is given as a url so that the metadata cleaner does not overwrite the year.},
  keywords = {kant, tp-cpr, tp-science-math, debate-two-aspect, type-article, Medium, summary-source-abstract}
}

