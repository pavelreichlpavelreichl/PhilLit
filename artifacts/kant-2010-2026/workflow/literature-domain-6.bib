  url = {https://doi.org/10.1093/9780197781296.001.0001},
  note = {SUMMARY: Lays out connections between Kant's and Freud's views of the mind, against the accepted contrasts (rational forms necessary for cognition and moral motivation versus an irrational unconscious core). It argues that a more fine-grained reading finds proto-Freudian aspects in Kant and elements of a genealogy of the mind in Freud, and draws lessons for philosophy of mind and moral psychology (publisher abstract).

SUBFIELD AND DEBATE: Mind and psychology, and the reception of Kant in psychoanalysis: Kantian consciousness and unity of representation versus the Freudian unconscious.

SIGNIFICANCE INDICATORS: S2: no record found by DOI or title search; CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Publisher: Oxford University Press. No review found by CrossRef search or NDPR sitemap check.

YEAR NOTE: CrossRef gives print publication 2026-01-06 and issued (online) 2025-10-30; dated by print year per the project rule. The DOI is given as a url so that the metadata cleaner does not overwrite the year.},
  keywords = {kant, tp-mind, recep-other, type-monograph, Medium, summary-source-abstract},
  abstract = {The book lays out connections between Immanuel Kant’s and Sigmund Freud’s respective views of the mind. Those connections run afoul of generally accepted contrasts between the two views. Whereas Kant investigates the forms of rational thinking that are necessary conditions for theoretical cognition and moral motivation, in contrast, Freud reveals the irrational core of our mental life. Whereas conscious states and their unity play an essential role in Kant’s view of the mind, in contrast, Freud takes the core of our mental life to be unconscious and inhabited by insuperable conflicts. While acknowledging such contrasts, the book argues that a more fine-grained understanding of each thinker reveals proto-Freudian aspects in Kant’s view and elements for a genealogy of the mind as analyzed by Kant in Freud’s view. The two views remain irreducible to one another but understanding the development from one to the other yields important lessons for contemporary philosophy of mind and moral psychology.},
  abstract_source = {crossref},
}

@article{schlicht2026predictive,
  author = {Schlicht, Tobias},
  title = {Predictive processing's flirt with transcendental idealism},
  journal = {Noûs},
  year = {2026},
  volume = {60},
  number = {1},
  pages = {87--109},
  url = {https://doi.org/10.1111/nous.12552},
  note = {SUMMARY: Argues that many proponents of predictive processing endorse a form of Kantian transcendental idealism, by characterising experiential content as the brain's best current hypothesis about the world, and that this endorsement undermines the framework's three ambitions: completeness, Bayesian realism and naturalism. The argument draws on philosophy-of-science discussions of realism, computational models and the foundational role of consciousness for science (abstract).

SUBFIELD AND DEBATE: Mind and cognitive science: Kantian transcendental idealism in predictive-processing theories of perception and cognition.

SIGNIFICANCE INDICATORS: S2 citations 4 and CrossRef is-referenced-by-count 4 (retrieved 2026-10-01). Venue: Nous 60(1).

YEAR NOTE: CrossRef gives online publication 2025-05-15 and print publication 2026-03 (volume 60, issue 1); dated by print year per the project rule. The DOI is given as a url so that the metadata cleaner does not overwrite the year.},
  keywords = {kant, tp-mind, tp-cpr, recep-other, debate-other-predictive-processing, type-article, Medium, summary-source-abstract},
  abstract = {The popular predictive processing (PP) framework posits prediction error minimization (PEM) as the sole mechanism in the brain that can account for all mental phenomena, including consciousness. I first highlight three ambitions associated with major presentations of PP: (1) Completeness (PP aims for a comprehensive account of mental phenomena), (2) Bayesian realism (PP claims that PEM is implemented in the brain rather than providing only a model), and (3) Naturalism (PP is typically presented as yielding a naturalistic view of the mind). Then I demonstrate that many proponents of PP also endorse a form of Kantian transcendental idealism (TI), based on a characterization of experiential content as the brain's currently best hypothesis about the world. I argue that endorsing this claim (4), that is, that we only experience the world as it appears, but not the world itself, sabotages achieving the three ambitions. The argument proceeds by discussing the prospects of each ambition in turn, drawing on discussions in the philosophy of science about realism and its alternatives, about the motivation and features of computational models, and about the foundational role of consciousness for science.},
  abstract_source = {crossref},
}

@book{brecher2026lawmorality,
  editor = {Brecher, Martin and Hirsch, Philipp-Alexander},
  title = {Law and Morality in Kant},
  publisher = {Cambridge University Press},
  year = {2026},
  url = {https://doi.org/10.1017/9781009292030},
  note = {SUMMARY: A volume of new essays on how law and morality relate in Kant: whether law is an application of general moral principles to legal institutions or has its own normativity irreducible to morality. The essays treat the justification of legal coercion, freedom and autonomy in law and politics, legal punishment and its ethical presuppositions, moral luck and permissive laws (publisher abstract).

SUBFIELD AND DEBATE: Legal and political philosophy: the Doctrine of Right and its relation to the Doctrine of Virtue and moral philosophy (dependence versus independence of Right from morality).

SIGNIFICANCE INDICATORS: S2: no record found for the volume by title search (only its reviews); CrossRef is-referenced-by-count 1 (retrieved 2026-10-01). Publisher: Cambridge University Press; the publisher abstract states the title is also available as Open Access. Reviews found by CrossRef search: Borbone, Philosophy in Review (2026); Pinheiro, Con-Textos Kantianos (2026). NDPR: no 2026 entries in the sitemap.

YEAR NOTE: CrossRef gives online publication 2025-12-16 and print publication 2026-01-31; dated by print year per the project rule. The DOI is given as a url so that the metadata cleaner does not overwrite the year.},
  keywords = {kant, pp-right-politics, pp-mm-virtue, type-edited-volume, Medium, summary-source-abstract},
  abstract = {How do law and morality relate to each other in Kant's philosophy? Is law to be understood merely as an application of general moral principles to legal institutions, or does law have its own normativity that cannot be traced back to that of morality? This volume of new essays is a comprehensive treatment of law and morality in Kant, which also sheds new light on Kant's practical philosophy more broadly. The essays present different approaches to this core issue and address related topics including the justification of legal coercion, the role of freedom and autonomy for law and politics, legal punishment and the question of its ethical presuppositions, moral luck, and the role of permissive laws in Kant's legal and political philosophy. The volume will be of interest to researchers and graduate students working on Kant's moral and legal philosophy. This title is also available as Open Access on Cambridge Core},
  abstract_source = {core},
}

@book{hunter2026kantianreligion,
  author = {Hunter, Ian},
  title = {The Kantian Religion},
  publisher = {Princeton University Press},
  year = {2026},
  doi = {10.2307/jj.35079609},
  note = {SUMMARY: A historical study that treats Kantian philosophy as a form of philosophical religion. Against the view of Kant as supplying a universal theory of knowledge and morality from timeless principles of the human mind, it argues that Kant's arguments were assembled from historical sources and served as ascetic devices for forming the Kantian philosopher's self, which his contemporaries took to be an extra-ecclesiastical path of spiritual and moral regeneration (publisher page).

