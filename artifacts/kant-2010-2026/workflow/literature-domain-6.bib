@book{teufel2025teleology,
  author = {Teufel, Thomas},
  title = {Kant and Teleology},
  publisher = {Cambridge University Press},
  year = {2025},
  doi = {10.1017/9781108529617},
  note = {SUMMARY: A Cambridge Element arguing that Kant's mature teleological philosophy in the Critique of the Power of Judgment, and a fortiori his aesthetics and philosophy of biology, cannot be understood without a systematic account of the challenges it answers (a threat of transcendental chaos between sensibility and understanding, and of critical chaos between determination and reflection) and of its innovations (a transcendental conception of purposiveness, a principle of nature's purposiveness, a self-governing power of judgment, and a view on which nature does make leaps); it presents such an account (publisher abstract).

SUBFIELD AND DEBATE: Aesthetics and teleology: purposiveness and reflective judgment in the third Critique and its role in the unity of the critical system.

