@book{cureton2025sovereign,
  author = {Cureton, Adam},
  title = {Sovereign Reason: Autonomy and Our Interests of Reason},
  publisher = {Oxford University Press},
  year = {2025},
  doi = {10.1093/9780191960253.001.0001},
  note = {SUMMARY: Develops, from a wide range of Kant's texts, a Sovereignty Conception of Reason on which an autonomous person governs herself completely by reason: reason legislates, executes and adjudicates for all our mental powers and for all kinds of rational standards, not just moral ones, and includes substantive interests (in knowledge, enlightenment, happiness, solidarity) and a principle of justifiability. It contrasts this with other theories and applies it to rational principles of beneficence, coercion, deception, friendship, respect, happiness and self-development (publisher abstract).

SUBFIELD AND DEBATE: Practical philosophy: Kantian autonomy and practical reason; the book extends traditional Kantian conceptions of rational self-governance and contrasts itself with other prominent theories of reason.

SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 2 (retrieved 2026-10-01). Publisher: Oxford University Press. No review found by CrossRef search or NDPR search.

