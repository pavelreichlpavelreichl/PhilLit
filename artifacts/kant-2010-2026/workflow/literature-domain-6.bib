@book{thomson2025opus,
  author = {Thomson, Terrence},
  title = {Metaphysics of Nature and Failure in Kant's Opus postumum},
  publisher = {Bloomsbury Publishing Plc},
  year = {2025},
  doi = {10.5040/9781350418516},
  note = {SUMMARY: Argues that the Opus postumum is Kant's last attempt to deliver the promised system of speculative reason in a work called metaphysics of nature, and reads the surviving drafts for how they fail to establish that work rather than for projected success. It maintains that this failure gives reason to study the Opus postumum seriously, not to abandon it (publisher abstract).

SUBFIELD AND DEBATE: Opus postumum and the late metaphysics of nature: whether the late drafts continue, rupture with or complete the critical system.

SIGNIFICANCE INDICATORS: S2 citations 0 and CrossRef is-referenced-by-count 0 (retrieved 2026-10-01). Publisher: Bloomsbury. Review found by CrossRef search: Zhang, Graduate Faculty Philosophy Journal (2026). NDPR review: not found.

YEAR NOTE: CrossRef gives 2025 for print and issued dates, without month.},
  keywords = {kant, opus-postumum, tp-science-math, type-monograph, Medium, summary-source-abstract},
  abstract = {Focusing on moments of continuity and rupture, as well as the thin lines of fracture in Critical philosophy itself,Metaphysics of Nature and Failure in Kant’sOpus postumum navigates the rough terrain of Kant’s final thoughts.Terrence Thomson argues thatOpus postumumconstitutes Kant’s last attempt to deliver on the promise of a system of speculative reason in a work called ‘metaphysics of nature’. He journeys through the drafts left on Kant’s desk when he died to encounter their failure to establish this work rather than their projected success. Far from this signaling that we give up on serious study of theOpus postumum, however, Thomson shows how failure is not something Kant shied away from but rather embraced as fuel for his continued thinking. Indeed, it is this failure that opens the door to a greater understanding of the dissonances at the core of Critical philosophy itself. Moreover, it indicates what it means to be in the process of philosophizing and that Kant was well-aware that to think often means to repeatedly fail.
  abstract_source = {s2},
 Suggesting how the very call for a metaphysics to be established upon the Critical philosophy can only ever fail to abide by the threshold it sets up, this book offers a new perspective on the central bind Kant repeatedly confronts inOpus postumumwithin the modern European tradition of philosophy. To deliver the system of metaphysics Kant calls for means to transgress the bounds of Critical philosophy, but to attempt to deliver it is nonetheless an unavoidable part of Critical philosophy itself.},
}

@book{cureton2025sovereign,
  author = {Cureton, Adam},
  title = {Sovereign Reason: Autonomy and Our Interests of Reason},
  publisher = {Oxford University Press},
  year = {2025},
  doi = {10.1093/9780191960253.001.0001},
  note = {SUMMARY: Develops, from a wide range of Kant's texts, a Sovereignty Conception of Reason on which an autonomous person governs herself completely by reason: reason legislates, executes and adjudicates for all our mental powers and for all kinds of rational standards, not just moral ones, and includes substantive interests (in knowledge, enlightenment, happiness, solidarity) and a principle of justifiability. It contrasts this with other theories and applies it to rational principles of beneficence, coercion, deception, friendship, respect, happiness and self-development (publisher abstract).

SUBFIELD AND DEBATE: Practical philosophy: Kantian autonomy and practical reason; the book extends traditional Kantian conceptions of rational self-governance and contrasts itself with other prominent theories of reason.

SIGNIFICANCE INDICATORS: S2 citations 1 and CrossRef is-referenced-by-count 2 (retrieved 2026-10-01). Publisher: Oxford University Press. No review found by CrossRef search or NDPR search.

YEAR NOTE: CrossRef gives online publication 2025-01-27 and print publication 2025-04-17.},
  keywords = {kant, pp-ethics, debate-constructivism, type-monograph, Medium, summary-source-abstract},
  abstract = {
  abstract_source = {s2},
 We often invoke reason, rationality, reasonableness, reasons, and related concepts in common sense. Despite what many serious thinkers claim, the reason of everyday life is far more substantive than cold logic or calculating self-interest. This book explores the idea that our power of reason includes an expansive set of governing abilities, motives, and principles. It develops this novel theory drawing on a wide variety of Kant’s texts and highlighting themes in ordinary ways of speaking and thinking that have not been sufficiently investigated. The book’s unifying idea is of an autonomous person who governs herself completely by reason. The Sovereignty Conception of Reason dramatically extends traditional Kantian conceptions of rational self-governance. We can use reason to govern our many mental powers, not just to make choices. We can legislate, execute, and adjudicate in ourselves all kinds of rational standards, not just moral ones. The Sovereignty Conception of Reason holds that our reason includes substantive interests in various things. Part of having a rational nature is to care about knowledge, enlightenment, happiness, solidarity, and other things for their own sake. The Sovereignty Conception of Reason also holds that our reason includes a principle of justifiability according to which mental acts of all kinds are required by reason if and because they are justifiable to rational people on the basis of their substantive interests of reason. The book contrasts the Sovereignty Conception of Reason with other prominent theories and explores rational principles concerning beneficence, coercion, deception, friendship, respect, happiness, and self-development.},
}

