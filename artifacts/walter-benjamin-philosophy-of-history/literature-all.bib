@article{list2020political,
  author = {List, Lotte},
  title = {Political Theology and Historical Materialism: Reading Benjamin against Agamben},
  journal = {Theory, Culture \& Society},
  year = {2020},
  volume = {38},
  number = {3},
  pages = {117--140},
  doi = {10.1177/0263276420936355},
  note = {
  CORE ARGUMENT: List argues that Agamben's political defeatism stems from a double misreading: a formalistic reduction of Schmitt and a "Schmittian reduction of Benjamin" that replaces Benjamin's historical materialist critique with messianic nihilism. By recovering Benjamin's own materialism against Agamben's assimilation of it to Schmittian decisionism, she demonstrates that a genuinely radical political theology must remain anchored in historical materialist critique rather than dissolving into juridical abstraction.

  RELEVANCE: This article directly addresses the domain's central question -- how political theology and historical materialism stand to one another in Benjamin -- by arguing that the two cannot be separated but that materialism provides the critical content that prevents theology from becoming apolitical or defeatist. It offers a sharp contrast to Agamben's influential theological reading and reclaims Benjamin as a political thinker.

  POSITION: Benjamin's historical materialism is primary; theology is the motivating force but not the critical substance. The article defends a reading of Benjamin as genuinely Marxist against both theological and post-political receptions.
  },
  keywords = {political-theology, historical-materialism, Agamben, Schmitt, class-struggle, High},
  abstract = {Giorgio Agamben’s work on the power of sovereignty has been greatly influential in recent political thought. However, it has also overshadowed the independently original contributions of his two primary theoretical sources, Carl Schmitt and Walter Benjamin. In this article, I argue that Agamben’s political defeatism can be traced back to a double misconception in his reception of these two authors: first a formalistic reduction of Schmitt, and second a Schmittian reduction of Benjamin. Through this reduction to juridical formalism, the radicality of Benjamin’s historical materialist critique is replaced by a messianic nihilism, leading to the colonization of society by the logic of the concentration camp. Though Agamben’s theory of sovereignty and its implications for a positive political project have been contested, this origin of the decline of radical philosophy has not previously undergone a systematic critique.},
  abstract_source = {s2},
}

@article{marramao2008messianism,
