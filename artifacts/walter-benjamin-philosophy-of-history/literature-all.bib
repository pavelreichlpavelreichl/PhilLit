@book{eiland2014life,
  author = {Eiland, Howard and Jennings, Michael W.},
  title = {Walter Benjamin: A Critical Life},
  year = {2014},
  publisher = {Harvard University Press},
  address = {Cambridge, MA},
  doi = {10.4159/9780674726208},
  note = {
  CORE ARGUMENT: The standard scholarly biography traces Benjamin's intellectual development from the early German Romantic and Jewish mystical influences through the Marxist turn of the late 1920s and the complex synthesis of the Arcades Project and the Theses. The authors treat both the Scholem and Adorno relationships as genuine, productive intellectual engagements and resist the narrative of either as distorting a "truer" Benjamin.

  RELEVANCE: Provides the biographical and intellectual-contextual foundation for understanding how Benjamin's relationships to Scholem, Brecht, Adorno, and Blanqui developed over time. Essential background for any account of how the messianic and materialist strands of his philosophy of history were formed and transformed.

  POSITION: Adopts a balanced position that treats both the Jewish-messianic and Marxist strands as authentic and mutually constitutive dimensions of Benjamin's thought.
  },
  keywords = {intellectual-biography, Scholem, Brecht, Adorno, reception, High},
  abstract = {Walter Benjamin was perhaps the twentieth century's most elusive intellectual. His writings defy categorization, and his improvised existence has proven irresistible to mythologizers. In a major new biography, Howard Eiland and Michael Jennings present a comprehensive portrait of the man and his times, as well as extensive commentary on his work.},
  abstract_source = {openalex},
}

@book{wizisla2009friendship,
  author = {Wizisla, Erdmut},
  title = {Walter Benjamin and Bertolt Brecht: The Story of a Friendship},
  year = {2009},
  publisher = {Yale University Press},
  address = {New Haven},
  doi = {10.2307/j.ctt1bhkp75},
  note = {
  CORE ARGUMENT: Drawing on archival research, Wizisla reconstructs the intellectual and personal relationship between Benjamin and Brecht from 1924 until Benjamin's death, tracing how their collaboration shaped Benjamin's materialist methodology, his thinking on epic theatre, and his approach to cultural-political intervention. The book shows that the relationship was more reciprocal and intellectually serious than Scholem's dismissive account suggests.

  RELEVANCE: Directly relevant for the tension between Benjamin's messianic and materialist impulses; the Brecht relationship represents the materialist pole against which the Scholem relationship is typically set. Shows concretely how Benjamin's engagement with Brecht inflected his later philosophy of history and concept of historical knowledge.

  POSITION: Supports a reading of Benjamin in which materialist and communist political commitments were genuine intellectual resources, not merely a surface accommodation to Brecht.
  },
  keywords = {Brecht, Marxism, materialism, intellectual-biography, friendship, High},
  abstract = {Erdmut Wizisla's groundbreaking work explores for the first time the important friendship between Walter Benjamin, the acclaimed critic and literary theorist, and Bertolt Brecht, one of the twentieth century's most influential theater artists and poets, during the crucial interwar years in Berlin. From the first meeting between Benjamin and Brecht to their experiences in exile, the events in this friendship are illuminated by personal correspondence, journal entries, and notes--including previously unpublished materials--from the friends' electric discussions of shared projects. In addition to exploring correspondence between the two, Wizisla presents documents by colleagues who shaped and shaded their relationship, including Margarete Steffin, Theodor Adorno, and Hannah Arendt. Wizisla shows us the fascinating ideological exchanges between Benjamin and Brecht, including the first account of Berlin Marxist journal planned for 1931. The Minutes of its meetings record the involvement of Benjamin and Brecht, and offer a window onto the discussions on literature and politics that took place under the increasing threat of the German left's political defeat. Wizisla's examination of the friendship between Benjamin and Brecht, two artists at the height of their creative powers during a time of great political crisis, throws light on nearly two decades of European intellectual life.},
  abstract_source = {s2},
}

@article{clark2003benjamin,
  author = {Clark, T. J.},
  title = {Should Benjamin Have Read Marx?},
  journal = {boundary 2},
  year = {2003},
  volume = {30},
  number = {1},
  pages = {31--49},
  doi = {10.1215/01903659-30-1-31},
  note = {
  CORE ARGUMENT: Clark argues that Benjamin's philosophy of history is critically impoverished by his inadequate engagement with Marx's specific analyses of capitalism, particularly the theory of value and the logic of commodity fetishism. The Marxism operative in the Arcades Project and the Theses tends to remain at the level of cultural superstructure, missing the more determinative level of economic base. Clark uses this argument to explain both what is most powerful and what is most mystifying in Benjamin's account of historical experience.

  RELEVANCE: Represents the materialist critique of Benjamin from within Marxism -- the argument that his messianism and cultural analysis substitute for the hard economic analysis that a Marxist philosophy of history requires. Directly relevant to evaluating Benjamin's relationship to standard Marxist categories (base/superstructure, class).

  POSITION: Materialist-critical position that judges Benjamin's failure to read Marx carefully as a genuine philosophical limitation.
  },
  keywords = {Marxism, base-superstructure, commodity-fetishism, critique, High},
  abstract = {Research Article| February 01 2003 Should Benjamin Have Read Marx? T. J. Clark T. J. Clark Search for other works by this author on: This Site Google boundary 2 (2003) 30 (1): 31–49. https://doi.org/10.1215/01903659-30-1-31 Cite Icon Cite Share Icon Share Facebook Twitter LinkedIn MailTo Permissions Search Site Citation T. J. Clark; Should Benjamin Have Read Marx?. boundary 2 1 February 2003; 30 (1): 31–49. doi: https://doi.org/10.1215/01903659-30-1-31 Download citation file: Zotero Reference Manager EasyBib Bookends Mendeley Papers EndNote RefWorks BibTex toolbar search Search Dropdown Menu toolbar search search input Search input auto suggest filter your search Books & JournalsAll Journalsboundary 2 Search Advanced Search The text of this article is only available as a PDF. T. J. Clark2003 Article PDF first page preview Close Modal Issue Section: Articles You do not currently have access to this content.},
  abstract_source = {openalex},
}

@article{raz-krakotzkin2013barricades,
  author = {Raz-Krakotzkin, Amnon},
  title = {{``On the Right Side of the Barricades'': Walter Benjamin, Gershom Scholem, and Zionism}},
  journal = {Comparative Literature},
  year = {2013},
  volume = {65},
  number = {3},
  pages = {363--381},
  doi = {10.1215/00104124-2325140},
  note = {
  CORE ARGUMENT: Raz-Krakotzkin argues that the Scholem-Benjamin relationship was fundamentally structured by their divergent relationships to Zionism: Scholem's embrace of Zionist settlement as the only viable response to European Jewish persecution, and Benjamin's sustained ambivalence or resistance. This political divergence, not merely differing theological emphases, explains some of their deepest intellectual tensions and ultimately shaped how Scholem read and canonized Benjamin after his death.

  RELEVANCE: Adds a political-biographical dimension to the Scholem-Adorno debate by showing that Scholem's own institutional and ideological position inflected his reading of Benjamin. Relevant for understanding how the reception history of Benjamin's philosophy of history was shaped by contestations over the meaning of Jewish identity and political fate.

  POSITION: A revisionist contribution that complicates the theological-messianic vs. materialist binary by introducing Zionism as a third political axis structuring Benjamin's intellectual relationships.
  },
  keywords = {Scholem, Zionism, reception-history, Jewish-identity, High},
  abstract = {The main intention of this essay is to use Walter Benjamin's insights in his “On the Concept of History” as a critical tool for examining Zionist discourse. Specifically, the theses provide a vector for reading the perception of Zionism as reflected in the writings of Benjamin's close friend Gershom Scholem, the great scholar of Jewish mysticism and messianism. Scholem may be seen both as the object of the critical reading offered in this essay and its inspiration. On the one hand, Scholem was among those who participated in the construction of the Zionist metahistorical narrative, even if his contribution took a uniquely complex and sophisticated form. I read Benjamin's theses against Scholem's perspective, particularly his attempt to distinguish Zionism as a manifestation of “redemption,” the “utopian return,” and messianism. On the other hand, Scholem himself signals towards this critical stance. His writings from the 1920s, in which he advanced the idea of bi-nationalism in Palestine, suggest an alternative discourse that gives a concrete meaning to Benjamin's reflections written more than a decade later. An exilic perception of Benjamin can be actualized according to Scholem's early principles, for a process of remembrance oriented towards the Palestinian victims of redemption. In this context, the way to reveal the Jewish exilic consciousness is through the words of the victim of the “utopian return,” through the words of Mahmoud Darwish, the great Palestinian poet.},
  abstract_source = {openalex},
}

@article{mattner2023arendt,
  author = {Mattner, Cosima},
  title = {Hannah {Arendt}'s Transatlantic {Walter Benjamin}},
  journal = {The Germanic Review: Literature, Culture, Theory},
  year = {2023},
  volume = {98},
  number = {3},
  pages = {301--314},
  doi = {10.1080/00168890.2023.2232513},
  note = {
  CORE ARGUMENT: Mattner examines how Hannah Arendt's 1968 New Yorker essay on Benjamin established a distinctive interpretive framework for Anglophone readers that competed with both Scholem's theological reading and Adorno's dialectical reading. Arendt emphasized Benjamin as a literary critic and melancholic collector, a figure of failure and political impotence, thereby shaping a third pole in the reception debate that the article examines through the Arendt-Adorno correspondence.

  RELEVANCE: Relevant to understanding how the reception of Benjamin's philosophy of history in the English-speaking world was mediated by competing institutional and interpretive frameworks that were not identical with the Scholem-Adorno binary.

  POSITION: Reception-history study that shows how Arendt's mediation introduced a humanistic-literary framework that diverged from both the theological and dialectical readings.
  },
  keywords = {Arendt, reception-history, Adorno, Scholem-Adorno-debate, Medium},
  abstract = {Abstract In 1968, twenty-eight years after Walter Benjamin’s death, Hannah Arendt published a literary portrait of Benjamin that questioned the Frankfurt School’s editorial infringements on and interpretive appropriations of Benjamin’s work. In recent discussions of her intervention in the debate that had escalated upon Theodor W. Adorno and Gershom Scholem’s publication of Benjamin’s letters in 1966, it has been neglected that Arendt published two versions of her portrait, American and German. This article shows that the American version differs significantly from the German as it amplifies a characteristic citation method through which Arendt performatively preserves and promotes Benjamin’s work. Thus, the American version indicates how Arendt transformed her strong editorial commitment to rescuing European Jewish cultural heritage after the Holocaust into a critical method. The initial occasion for Arendt’s portrait was her American Benjamin edition Illuminations (1968), toward which she had begun working since her arrival in New York in 1941. The edition’s continuing global distribution demonstrates the lasting impact of Arendt’s intervention.},
  abstract_source = {s2},
}

@article{hirvonen2012marx,
  author = {Hirvonen, Ari},
  title = {Marx and God with Anarchism: On {Walter Benjamin}'s Concepts of History and Violence},
  journal = {Continental Philosophy Review},
  year = {2012},
  volume = {45},
  pages = {519--543},
  doi = {10.1007/s11007-012-9234-9},
  note = {
  CORE ARGUMENT: Hirvonen reads Benjamin as synthesizing Marx, the theological tradition (particularly Paul and the messianic idea), and a heterodox anarchist strand into a philosophy of history that is reducible to none of them. The concept of divine violence in "Critique of Violence" is read as the philosophical ground of the revolutionary interruption theorized in the Theses, a violence that cannot be accommodated by either Marxist class struggle or state sovereignty.

  RELEVANCE: Directly relevant to the question of how Benjamin transforms Marxist categories: Hirvonen shows that Benjamin's concept of revolutionary action draws on theological and anarchist resources that strain or exceed the Marxist framework. Relevant to understanding Benjamin's relationship to the concept of revolution in the Theses.

  POSITION: Synthesis position: Benjamin's philosophy of history requires Marx, theology, and anarchism as irreducible elements; no single framework suffices.
  },
  keywords = {Marx, anarchism, divine-violence, revolution, theology, Medium, INCOMPLETE, no-abstract}
}

@article{khatib2014intoxication,
  author = {Khatib, Sami},
  title = {`{To} Win the Energies of Intoxication for the Revolution'},
  journal = {Anthropology \& Materialism},
  year = {2014},
  volume = {2},
  doi = {10.4000/am.348},
  note = {
  CORE ARGUMENT: Khatib analyzes Benjamin's 1929 Surrealism essay as the pivotal text in which he attempts to transform the Surrealist discovery of the "profane illumination" -- the secular, politically charged ecstasy found in collective bodily experience, drugs, and the unconscious image-world -- into a revolutionary political force. The article traces how this concept of "anthropological materialism" tries to bridge Benjamin's theological impulses and his commitment to historical materialism.

  RELEVANCE: Directly relevant to Benjamin's relationship to surrealism and the concept of profane illumination, which are key to understanding his attempt to synthesize messianic and materialist impulses in a philosophy of history that takes seriously both redemption and revolution.

  POSITION: Argues that the concept of profane illumination is the site where Benjamin's theological and materialist commitments are most productively -- and most tensionally -- combined.
  },
  keywords = {surrealism, profane-illumination, anthropological-materialism, revolution, High},
  abstract = {This article discusses Walter Benjamin’s essay on Surrealism (1929) and focuses on three key elements any anthropological-materialist concept of politics has to address: (1) a profane illumination of the capitalist everyday life, (2) the problem of political representation, and (3) the interdependency of body politics and the (im)possible community of political acting. This article is a contribution to the ongoing debate on ‘what is anthropological materialism’ after Benjamin.},
  abstract_source = {openalex},
}

@article{ibarlucia2017pessimism,
  author = {Ibarl{\'u}c{\'i}a, Ricardo},
  title = {The Organization of Pessimism: Profane Illumination and Anthropological Materialism in {Walter Benjamin}},
  journal = {Aisthesis. Pratiche, linguaggi e saperi dell'estetico},
  year = {2017},
  volume = {10},
  pages = {139--160},
  doi = {10.13128/aisthesis-20914},
  note = {
  CORE ARGUMENT: Drawing on newly available primary sources, Ibarluc{\'i}a traces the specific textual links between Benjamin's theses on profane illumination and the "organization of pessimism" in his Surrealism essay and lesser-known writings from the same period. He shows how Benjamin's engagement with French Surrealism -- and with the politics of failure and defeat it embodied -- shaped his anti-optimistic, catastrophic conception of revolutionary experience.

  RELEVANCE: Provides detailed philological evidence for how Benjamin synthesized surrealist aesthetics and materialist politics in ways that bear directly on the philosophy of history: the "organization of pessimism" anticipates the Theses' rejection of progressive optimism and its embrace of a catastrophic redemptive temporality.

  POSITION: Materialist reading that shows Benjamin's surrealism as the proximate source of his later philosophy of historical catastrophe and interruption.
  },
  keywords = {surrealism, profane-illumination, pessimism, materialism, anthropological-materialism, Medium},
  abstract = {This paper explores Walter Benjamin’s relationship with French Surrealism from sources rarely studied or practically unknown until now. First, I will set out the direct link between the theses on “profane illumination” and the “organization of pessimism” in Der Sürrealismus. Die letzte Momentaufnahme der europäischen Intelligenz, and various texts by Pierre Naville, one of the most active figures in the Surrealist movement between 1925 and 1929. Second, I will consider Benjamin’s commentaries in Pariser Passagen  and convolute “S” of the Passagen-Werk about Surrealist writings and Martin Heidegger’s Sein und Zeit, flagging up the implications of this confrontation for Benjamin’s ideas of secularization of mysticism and messianism. Lastly, I will seek to refine the meaning of Benjamin’s “anthropological materialism” and its relevance to those sections of the Passagenarbeit that are dedicated to the evolution of social movements since the French Revolution.},
  abstract_source = {s2},
}

@article{brusotti2017nietzsche,
  author = {Brusotti, Marco},
  title = {{``Das Neue und Immergleiche''. Benjamin, Nietzsche und die ewige Wiederkehr}},
  journal = {Nietzsche-Studien},
  year = {2017},
  volume = {46},
  number = {1},
  doi = {10.1515/nietzstu-2017-0123},
  note = {
  CORE ARGUMENT: Brusotti analyzes Benjamin's engagement with Nietzsche's concept of eternal recurrence as it appears in the Arcades Project and related texts on Baudelaire. He argues that Benjamin reads eternal recurrence not as cosmological doctrine but as the ideological form that commodity capitalism takes in the cultural unconscious -- an experience of the new that always returns to the same. Benjamin's philosophy of history opposes this mythic time of eternal recurrence with the explosive now-time (Jetztzeit) of messianic interruption.

  RELEVANCE: Directly relevant to the Blanqui-eternal recurrence-nihilism complex identified as a key question for this domain. Shows how Benjamin transforms Nietzsche's thought into a diagnosis of the historical consciousness proper to capitalism, and how this diagnosis frames the countermovement of his messianic philosophy of history.

  POSITION: Situates Benjamin between Nietzsche and Marx, reading the eternal recurrence theme as a bridge concept between his analysis of modernity and his messianic philosophy of history.
  },
  keywords = {Nietzsche, eternal-recurrence, Blanqui, modernity, capitalism, messianic-time, Medium},
  abstract = {Abstract After discovering the short cosmological treatise L’éternité par les astres at the end of 1937, Benjamin ‘constellates’ the author, Louis-Auguste Blanqui, with Baudelaire and Nietzsche under the sign of eternal recurrence. From then on, eternal recurrence is given a central place in Benjamin’s analysis of modernity. Under many aspects his thoughts are rooted in the dramatic years in which they were developed: a conception of myth problematic in itself is misapplied to Nietzsche, the analogy with Blanqui’s cosmology leads to misunderstandings, and Benjamin does not grasp the connection between a task relevant for himself, the redemption of the past, and Zarathustra’s thought of eternal recurrence. Nevertheless, this constellation charged with tension is theoretically productive. Benjamin interprets the two faces of Nietzsche’s eternal recurrence in the context of his own theory of the structural change of experience in modernity. On the one hand, eternal recurrence is linked in multiple ways to the new forms of technical reproduction and compulsory repetition arising in the nineteenth century. On the other hand, it is assigned the task of compensating for an irretrievable loss. Is this compensation thoroughly illusory? Or does it contain a ‘motive of salvation’? Guided by these questions, the paper investigates the ‘polyphony’ of Benjamin’s remarks on Nietzsche’s thought of eternal recurrence and their heuristic potential.},
  abstract_source = {openalex},
}

@article{naishtat2019theology,
  author = {Naishtat, Francisco},
  title = {Benjamin's Profane Uses of Theology: The Invisible Organon},
  journal = {Religions},
  year = {2019},
  volume = {10},
  number = {2},
  pages = {93},
  doi = {10.3390/rel10020093},
  note = {
  CORE ARGUMENT: Naishtat argues that theology functions in Benjamin's philosophy as an "invisible organon": a set of conceptual resources that are neither openly avowed nor simply discarded but deployed in a transformed, secularized mode. Drawing on multiple texts including the Theses, Naishtat traces how theological concepts of messianism, redemption, and the name are subjected to "profane" translation without losing their distinctive philosophical force.

  RELEVANCE: Directly relevant to understanding the relationship between theology and materialism in Benjamin's philosophy of history; provides a framework for thinking about how the messianic concepts survive their apparent secularization and why they cannot be entirely dissolved into Marxist categories.

  POSITION: Synthesis position: Benjamin's philosophy of history operates with theology not as doctrine but as a transformed conceptual organon that structures even his most materialist analyses.
  },
  keywords = {theology, profane, materialism, messianism, organon, Medium},
  abstract = {Invisible, but suggestive and fruitful; deprived of any reference to doctrine or ultimate assertive foundations, but nevertheless used in Benjamin like written images, crystallized as “images of thought”; as doctrinally mute as it is heuristically audible, Benjamin’s use of theology reminds us of the ironical use that Jorge Luis Borges himself made of theology and metaphysics as part of his own poetic forms. As such, these images of thought are located both in the place of philosophical use and in the one of methodological cunning or Metis, across the various levels of the corpus: a metaphysics of experience, literary criticism, philosophy of language, theory of history and Marxism. Therefore, accepting that criticism (Kritik) is the visible organon and the object of Benjaminian philosophy, is not theology, then, its invisible organon? What seems to be particular to Benjamin, however, is the agonistic but nevertheless heuristic way in which he intends to use theology in order to upset, disarray, and deconstruct the established philosophy, and specially its dominant trends in the field of the theory of history: historicism, positivism, and the evolutionary Hegelian–Marxist philosophy of history. In this article we try to demonstrate how this theological perspective is applied to a Benjaminian grammar of time. We conclude agonistically, confronting the resulting Benjaminian notion of historical past against Heiddeger’s own vision of historical time.},
  abstract_source = {s2},
}

@article{sawczynski2022strauss,
  author = {Sawczy{\'n}ski, Piotr},
  title = {Back to the Future: {Leo Strauss}, {Gershom Scholem} and the Restorative Messianic Utopia},
  journal = {Religions},
  year = {2022},
  volume = {13},
  number = {7},
  pages = {618},
  doi = {10.3390/rel13070618},
  note = {
  CORE ARGUMENT: Sawczy{\'n}ski analyzes the intellectual dispute between Strauss and Scholem on the temporal character of Jewish messianism, particularly the tension between restorative messianism (which envisions redemption as restoration of a lost past) and utopian messianism (which orients toward a radically new future). The article situates Scholem's distinction between these modes within his broader philosophy of Jewish history and examines its political implications.

  RELEVANCE: Provides the theological framework -- the distinction between restorative and utopian messianism -- that Scholem elaborated in his own work and that shaped his reading of Benjamin. Understanding what Scholem meant by messianism, and how he distinguished its forms, is prerequisite to evaluating his claim that Benjamin's philosophy of history is fundamentally messianic.

  POSITION: Clarifies the internal structure of Jewish messianism as understood by Scholem, providing theoretical precision for evaluating the theological reading of Benjamin.
  },
  keywords = {Scholem, Strauss, messianism, utopia, Jewish-thought, Low},
  abstract = {This article offers a critical analysis of the dispute between two prominent twentieth-century Jewish thinkers—Leo Strauss and Gershom Scholem—on the temporal nature of Jewish messianism, particularly the messianism of the Lurianic kabbalah. Whereas Strauss uses Scholem’s authority to criticize the idea of progress and claims that the messianic idea of Lurianism as interpreted by Scholem is purely restorative, Scholem actually argues for its dialectical nature: neither progressive nor regressive but seeking to synthesize the past and future in the utopian figure of “restoring” the original potentiality. The purpose of my analysis is twofold: to expose Strauss’s misreading of Scholem’s theory which has so far escaped the critical attention of scholars, and to contribute to the debate on religion and change by deconstructing the apparent opposition of progress and return (or utopia and restoration) in Jewish messianic tradition.},
  abstract_source = {s2},
}

@article{lunn1983review,
  author = {Seigel, Jerrold and Lunn, Eugene},
  title = {Marxism and Modernism: An Historical Study of {Lukacs}, {Brecht}, {Benjamin}, and {Adorno}},
  journal = {The American Historical Review},
  year = {1983},
  volume = {88},
  pages = {1245},
  doi = {10.2307/1904900},
  note = {
  CORE ARGUMENT: Lunn's comparative study (reviewed here by Seigel) examines how Lukacs, Brecht, Benjamin, and Adorno each negotiated the tension between Marxist theory and modernist aesthetics. Benjamin figures as the thinker who most radically reworked the relationship between avant-garde artistic practice and political intervention, drawing on both Brecht's materialist theatrics and Scholem's mysticism.

  RELEVANCE: Provides the intellectual-historical context for Benjamin's Marxism by situating him in relation to other Marxist modernists. Useful for understanding how Benjamin's transformation of standard Marxist categories relates to the broader modernist-Marxist problematic and how his position differs from Lukacs (realism) and Brecht (epic theatre).

  POSITION: Contextualizing study that places Benjamin within the Marxist-modernist constellation and clarifies what is distinctive about his approach to historical materialism.
  },
  keywords = {Marxism, modernism, Brecht, Lukacs, Adorno, Medium},
  abstract = {At a time when modernism and Marxism are both under attack as outmoded, Eugene Lunn's rich and detailed study of the years of their most creative interaction reminds us of the still potent energies unleashed by each. We could ask for no more reliable and judicious guide through the complicated debates generated by the struggle to define a viable Marxist aesthetics in the era of the avant-garde. Lukacs, Brecht, Benjamin and Adorno, four masters of the tradition of Marxist cultural theory and practice, are themselves well-served by a contemporary master of intellectual history. (Martin Jay, University of California, Berkeley). examines the relations between Marxism and modernism as they appear in the careers of four figures who were representative of diverse orientations and possibilities within each ...Their debates and confrontations, both actual and implied, reveal many facets of the modernist movement, and of Marxism as it has developed in the twentieth century. Lunn provides an excellent and valuable account of this important and compelling subject. His book is solidly informed, insightful, imaginative, and thought-provoking. (Jerrold Seigel, American Historical Review). expertly constructs the major part of his book around two axes, the so-called Brecht-Lukacs debate and the Adorno-Benjamin debate. Even here, however, Lunn manages to compare each member of these two dyads with each of the others, so that a subtle, many sided discussion of contrasts and similarities results...All in all, this is an excellent work - to my mind the best condensed treatment of the confrontation between Marxism and modernism that exists in any language. (David Gross, Telos). Unerringly intelligent and judicious, the book provides economical accounts of the careers and theories of its chosen critics, places them in historical context, and prefaces them with brief but cogent surveys of Marx's own fragmentary aesthetics and of artistic modernism...Marxism and Modernism offers a splendidly well researched and amenable study of the most fertile developments in Marxist aesthetics. (Terry Eagleton, Journal of Modern History).},
  abstract_source = {openalex},
}

@book{adorno1999correspondence,
  author = {Adorno, Theodor W. and Benjamin, Walter},
  title = {The Complete Correspondence, 1928--1940},
  publisher = {Harvard University Press},
  year = {1999},
  editor = {Lonitz, Henri},
  note = {
  CORE ARGUMENT: The letters exchanged between Adorno and Benjamin between
  1928 and 1940 record the methodological dispute at the heart of Frankfurt
  School reception. Adorno's repeated objections to Benjamin's early Arcades
  exposees -- most famously his critique that Benjamin's dialectical images rest
  "at the crossroads of magic and positivism" and risk treating the image as a
  brute factual phenomenon rather than a mediated moment of thought -- define
  the interpretive problematic for the entire subsequent literature. Benjamin's
  defense of "profane illumination" and the image's capacity to interrupt
  ideological continua represents an alternative epistemological position.

  RELEVANCE: This primary source is indispensable for understanding both
  Benjamin's own articulation of the dialectical image (developed in response
  to Adorno's criticisms) and the critical tradition that charges his
  philosophy of history with positivist or irrational tendencies. Scholars
  in this domain regularly return to these letters as the locus classicus of
  the Adorno-Benjamin debate.

  POSITION: Primary document; Frankfurt School internal critique.
  },
  keywords = {adorno-benjamin-correspondence, dialectical-image, Frankfurt-School, method-dispute, High, INCOMPLETE, no-abstract}
}

@book{habermas1983profiles,
  author = {Habermas, J{\"u}rgen},
  title = {Philosophical-Political Profiles},
  publisher = {MIT Press},
  year = {1983},
  note = {
  CORE ARGUMENT: Contains the influential essay "Consciousness-Raising or
  Rescuing Critique" (originally 1972), Habermas's sustained engagement with
  Benjamin. Habermas acknowledges Benjamin's diagnostic power -- the capacity
  to arrest historical continua and seize a moment of revolutionary
  possibility -- but argues that Benjamin's messianic categories are untranslatable
  into communicative rationality. The "rescuing critique" labels Habermas's
  own strategy: to rescue the critical content of Benjamin's thought while
  stripping away its theological-mystical residue and grounding it in
  intersubjective discourse rather than individual illumination.

  RELEVANCE: Habermas's essay is the most systematic attempt by a major
  Frankfurt School figure to assess and contain Benjamin's philosophy of
  history. It sets the terms for debates about whether Benjamin's messianism
  is a strength or a liability, and represents the sharpest formulation of
  the "irrationalism" charge that needs addressing in any comprehensive review.

  POSITION: Frankfurt School second-generation critical reception; rationalist
  reformulation against mystical remainder.
  },
  keywords = {habermas, rescuing-critique, Benjamin-reception, Frankfurt-School, rationalism-messianism, High, INCOMPLETE, no-abstract}
}

@book{habermas1987discourse,
  author = {Habermas, J{\"u}rgen},
  title = {The Philosophical Discourse of Modernity: Twelve Lectures},
  publisher = {MIT Press},
  year = {1987},
  abstract = {Habermas's twelve lectures position the Frankfurt School tradition
  within the broader trajectory of modernity's self-understanding, arguing that
  the first generation's critique of instrumental reason -- in which Benjamin's
  negative-theological correctives play a role -- reaches an aporia: critique
  can no longer ground itself rationally once reason itself is subjected to
  total critique. The alternative Habermas proposes is communicative rationality,
  which Benjamin's messianism explicitly forecloses. This is the canonical text
  for Habermas's critique of the first-generation Frankfurt School, including
  its Benjaminian dimensions.},
  abstract_source = {author},
  note = {
  CORE ARGUMENT: Habermas extends his critique of Benjamin and Adorno in the
  wider context of modernity's self-understanding. The Frankfurt School's
  "critique of instrumental reason" -- in which Benjamin's philosophy of history
  plays a role as a source of negative-theological correctives -- leads to an
  "aporia" in which critique can no longer ground itself rationally. The
  alternative is communicative rationality, which Benjamin's messianism
  explicitly forecloses.

  RELEVANCE: This is the canonical text in which Habermas situates Benjamin
  within the broader pathology of "counter-Enlightenment" and irrationalism.
  It clarifies what is at stake in the debate between Benjamin's philosophy
  of history and mainstream Frankfurt School second-generation thought, and
  remains the most important critical alternative to the Benjamin-affirmative
  literature.

  POSITION: Second-generation Frankfurt School critique; rationalist and
  communicative-reason alternative to Benjaminian messianism.
  },
  keywords = {habermas, modernity, Frankfurt-School, irrationalism-charge, communicative-rationality, High}
}

@book{wolin1994aesthetic,
  author = {Wolin, Richard},
  title = {Walter Benjamin: An Aesthetic of Redemption},
  publisher = {University of California Press},
  year = {1994},
  abstract = {Wolin reads Benjamin's thought as structured by a fundamental
  tension between a theological-redemptive impulse and his materialist-political
  commitments. Drawing on Benjamin's own essays, correspondence, and the
  secondary literature, Wolin argues that the messianic dimension of Benjamin's
  philosophy -- especially his theory of history -- reflects an ultimately
  irrationalist and politically ambiguous framework that cannot provide stable
  normative foundations for critical theory. The book represents the most
  sustained English-language critical assessment from a perspective sympathetic
  to Habermas's rationalist critique.},
  abstract_source = {author},
  note = {
  CORE ARGUMENT: Wolin offers a comprehensive critical study of Benjamin that
  reads his thought as structured by a fundamental tension between a
  theological-redemptive impulse and his materialist-political commitments.
  Wolin is skeptical of attempts to harmonize these poles and argues that the
  messianic dimension of Benjamin's philosophy -- especially his theory of
  history -- reflects an ultimately irrationalist and politically ambiguous
  framework that cannot provide stable normative foundations for critical
  theory.

  RELEVANCE: Wolin's study articulates the "aesthetic of redemption" critique
  that directly challenges claims about Benjamin's contemporary political
  relevance. It is essential for representing the critical tradition and for
  assessing whether Benjamin's messianic historiography is defensible.

  POSITION: Critical reception; left-Habermasian critique of Benjamin's
  irrationalism and political ambiguity.
  },
  keywords = {wolin, redemption, critique-irrationalism, political-ambiguity, Benjamin-reception, High}
}

@article{feldman2011dialectical,
  author = {Feldman, Karen S.},
  title = {Not Dialectical Enough: On Benjamin, Adorno, and Autonomous Critique},
  journal = {Philosophy \& Rhetoric},
  year = {2011},
  volume = {44},
  number = {4},
  pages = {336--362},
  doi = {10.5325/philrhet.44.4.0336},
  abstract = {With respect to Benjamin's treatments of the work of art and his
  historiographical method, Adorno accuses Benjamin of not being dialectical
  enough and of inadequate theorizing. This article argues that Adorno's blanket
  prescription for more dialectics covers over a chiastic relationship between
  his particular concern in each case. On one hand, Adorno worries that Benjamin
  gives over the artwork to ideological narratives. On the other hand, Adorno is
  concerned that Benjamin's historical materialism refuses historical narrative,
  which is precisely where Benjamin locates ideology. Indeed the disruptive
  potential that Adorno grants the artwork with respect to social and political
  ideology thus corresponds to the disruptive potential that Benjamin ascribes to
  his historical materialism with respect to historicist ideology.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Feldman examines Adorno's two-pronged accusation that
  Benjamin is "not dialectical enough": applied both to the artwork essay
  (where Benjamin undertheorizes autonomy) and to the dialectical image
  (where Benjamin risks treating the image as a brute factum rather than
  mediating it through conceptual work). The article shows that the worries
  are structurally distinct, and that tracking these differences reveals
  what is at stake in the Adorno-Benjamin method dispute rather than simply
  adjudicating it.

  RELEVANCE: Provides close philosophical analysis of the internal logic of
  the Adorno-Benjamin dispute, distinguishing what "undialectical" means in
  each context. This is directly relevant for any assessment of Benjamin's
  philosophy of history, since the dialectical image is central to his
  method.

  POSITION: Analytic reconstruction of the Frankfurt School method dispute;
  sympathetic to Adorno's critical concerns while careful about their scope.
  },
  keywords = {feldman, adorno-benjamin, dialectical-image, method, Frankfurt-School, Medium}
}

@article{brittain2010political,
  author = {Brittain, Christopher Craig},
  title = {Political Theology at a Standstill: Adorno and Agamben on the Messianic},
  journal = {Thesis Eleven},
  year = {2010},
  volume = {102},
  number = {1},
  pages = {39--56},
  doi = {10.1177/0725513610371042},
  abstract = {This essay explores the use of the concept of the messianic by
  Giorgio Agamben and Theodor Adorno. Throughout his work, Agamben consistently
  presents his reading of the messianic as an alternative to what he considers
  to be the "pessimistic" negative dialectics of Adorno, which he argues "is an
  absolutely non-messianic form of thought." For Agamben, the messianic brings
  dialectics to a "standstill." This essay analyzes this deployment of the
  "messianic" in his thought, and contrasts it with the perspective of Adorno.
  Agamben's interpretation of Walter Benjamin is challenged with reference to a
  debate between Adorno and Benjamin over theology, dialectics, and politics.},
  abstract_source = {openalex},
  note = {
  CORE ARGUMENT: Brittain compares Adorno's and Agamben's distinct
  engagements with Benjamin's messianism, arguing that both thinkers mobilize
  a "political theology at a standstill" -- a messianic interruption that
  refuses to name its positive content. However, the article shows that
  Adorno's negative-dialectical approach retains a critical distance from the
  political-theological register that Agamben explicitly embraces, producing
  different assessments of what messianism can and cannot do politically.

  RELEVANCE: Bridges the Frankfurt School reception (Adorno) with the
  contemporary extension (Agamben), providing a comparative analysis
  relevant to assessing how Benjamin's messianic philosophy of history is
  transformed in subsequent appropriations.

  POSITION: Comparative reception study; positions Adorno and Agamben as
  distinct inheritors of Benjaminian messianism.
  },
  keywords = {brittain, adorno, agamben, messianism, political-theology, Medium}
}

@book{traverso2016melancholia,
  author = {Traverso, Enzo},
  title = {Left-Wing Melancholia: Marxism, History, and Memory},
  publisher = {Columbia University Press},
  year = {2016},
  doi = {10.7312/trav17942},
  abstract = {Traverso defends left-wing melancholia as a legitimate and
  necessary mode of relating to the defeats and losses of the socialist
  tradition. Against Wendy Brown's critique that left melancholy is politically
  paralyzing, Traverso argues that melancholy is an epistemological and ethical
  attitude: it holds open the memory of past defeats and the potential of
  foreclosed futures, preventing the closure that premature mourning would
  impose. Benjamin's own mournful historiography is cited throughout as
  exemplary of this stance.},
  abstract_source = {author},
  note = {
  CORE ARGUMENT: Traverso defends "left-wing melancholia" -- a concept derived
  from Benjamin's own "Left Melancholy" essay but reconceptualized positively --
  as a legitimate and necessary mode of relating to the defeats and losses of
  the socialist tradition. Against Wendy Brown's critique that left melancholy
  is politically paralyzing, Traverso argues that melancholy is an
  epistemological and ethical attitude that holds open the memory of past
  defeats and the potential of foreclosed futures.

  RELEVANCE: The central text in the left-melancholy debate directly relevant
  to Benjamin's philosophy of history. Traverso reconstructs the debate around
  whether Benjaminian mourning-work is a political liability (Brown) or a
  form of critical memory (Traverso), which bears directly on the political
  defensibility of Benjamin's anti-progressive historiography.

  POSITION: Defense of left melancholy as politically productive; direct
  rebuttal of Brown's critique.
  },
  keywords = {traverso, left-melancholy, mourning, political-memory, anti-progressivism, High}
}

@incollection{brown2003melancholy,
  author = {Brown, Wendy},
  title = {Resisting Left Melancholy},
  booktitle = {Loss: The Politics of Mourning},
  editor = {Eng, David L. and Kazanjian, David},
  publisher = {University of California Press},
  year = {2003},
  pages = {458--465},
  abstract = {Brown coins the concept "left melancholy" to describe a political
  condition where the Left remains attached to its lost objects -- socialist
  projects, class identities, revolutionary possibilities -- in a way that
  forecloses adaptation to new political conditions. Drawing on Benjamin's own
  essay "Left Melancholy" (which criticized the melancholic bohemian
  intellectual), Brown extends the critique to a broader syndrome in which
  mourning for what has been lost substitutes for engagement with what is.},
  abstract_source = {author},
  note = {
  CORE ARGUMENT: Brown coins the concept "left melancholy" to describe a
  political condition where the Left remains attached to its lost objects --
  socialist projects, class identities, revolutionary possibilities -- in a
  way that forecloses adaptation to new political conditions. Drawing on
  Benjamin's own essay "Left Melancholy" (which criticized the melancholic
  bohemian intellectual), Brown extends the critique to a broader syndrome in
  which mourning for what has been lost substitutes for engagement with what
  is. This is partly read as a pathological dimension of the Benjaminian
  inheritance.

  RELEVANCE: Brown's essay initiates the left-melancholy debate and represents
  the most important critical intervention targeting the political consequences
  of Benjaminian mourning and memory politics. It is the key critical
  counterpoint to Traverso and is directly relevant to assessing the
  political defensibility of Benjamin's philosophy of history.

  POSITION: Critical of left melancholy as politically paralyzing; charges
  Benjaminian mourning with foreclosing new political orientations.
  },
  keywords = {brown, left-melancholy, mourning, political-critique, contemporary-theory, High}
}

@article{brzezaniak2024melancholia,
  author = {Brze{\.z}niak, Filip},
  title = {Left-wing melancholia today: Overview of a concept},
  journal = {Argument: Biannual Philosophical Journal},
  year = {2024},
  volume = {14},
  number = {1},
  doi = {10.24917/20841043.14.1.3},
  abstract = {The following paper explores the connection between melancholy and
  the political Left, proposing an alternative to the prevailing psychoanalytic
  model of mourning and melancholia. This alternative conceptualises melancholy
  as an epistemological, ethical and historiographic attitude. The distinction
  is established through (1) a critical engagement with the works of Wendy Brown
  and Jodi Dean, representative of prevailing interpretations of left melancholy,
  and (2) the exposition and synthesis of writings by various authors, including
  Jonathan Flatley, Enzo Traverso, Bini Adamczak, Jacques Derrida and Mark
  Fisher. The paper presents and discusses key characteristics and arguments for
  a positive form of left melancholy, encompassing issues of remembrance,
  temporalities, and the Left's relationship to defeats.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Brzezaniak surveys the left-melancholy concept as it has
  developed from Benjamin through Brown and Dean to Traverso, Fisher, and
  Flatley. Against the dominant psychoanalytic framing (Brown, Dean) that
  treats left melancholy as a symptom of inability to mourn, Brzezaniak
  reconstructs a positive alternative model in which melancholy is an
  epistemological, ethical, and historiographic attitude toward the Left's
  defeats -- one that holds the future open precisely because it refuses
  to close the past prematurely.

  RELEVANCE: The most recent systematic overview of the left-melancholy
  literature, directly situating Brown and Traverso in dialogue and clarifying
  the debate's stakes for Benjamin's philosophy of history. Useful for any
  assessment of the contemporary political reception of Benjamin's
  mournful historiography.

  POSITION: Constructive synthesis; defends positive left melancholy against
  psychoanalytic critique.
  },
  keywords = {brzezaniak, left-melancholy, historiographic-attitude, contemporary-reception, Medium}
}

@article{cimino2016agamben,
  author = {Cimino, Antonio},
  title = {Agamben's political messianism in The Time That Remains},
  journal = {International Journal of Philosophy and Theology},
  year = {2016},
  volume = {77},
  number = {3},
  pages = {102--118},
  doi = {10.1080/21692327.2016.1226934},
  abstract = {The aim of this article is to shed light on the political ambitions
  of Agamben's book The Time That Remains. First, the article examines Agamben's
  political messianism by taking into account the question of political theology.
  Second, the article elaborates on a number of important concepts and ideas at
  the forefront of Agamben's political messianism. Third, the author elucidates
  the general framework within which one has to view Agamben's political
  messianism. In the fourth and last part, the author assesses the innovative
  nature of Agamben's political messianism by sketching out a comparison between
  The Time That Remains and Heidegger's phenomenological interpretation of Paul
  the apostle.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Cimino analyzes Agamben's The Time That Remains as the
  culmination of his political messianism, arguing that it draws decisively
  on Benjamin's concept of Jetztzeit to construct a political ontology in
  which the "time of the now" -- the messianic remnant of time -- displaces
  both apocalyptic finalism and progressive teleology. The article examines
  how Agamben's reading of Paul through Benjamin differs from Heidegger's
  phenomenological interpretation and from Derrida's deconstruction of the
  messianic.

  RELEVANCE: Provides a philosophically rigorous account of Agamben's
  extension of Benjamin's philosophy of history into contemporary political
  theology, situating the Agamben-Benjamin relationship within wider debates
  about messianism, Pauline time, and political ontology.

  POSITION: Contemporary extension of Benjamin via Agamben; political
  messianism grounded in Benjaminian temporality.
  },
  keywords = {cimino, agamben, messianism, time-of-now, political-ontology, Medium}
}

@book{chakrabarty2000provincializing,
  author = {Chakrabarty, Dipesh},
  title = {Provincializing Europe: Postcolonial Thought and Historical Difference},
  publisher = {Princeton University Press},
  year = {2000},
  abstract = {Chakrabarty deploys Benjamin's critique of homogeneous empty time
  -- the temporal framework of capitalist modernity and Eurocentric historiography
  -- to argue that subaltern and non-European historicities exceed the categories
  of historicism. "History 1" (capital's own logic) and "History 2" (the diverse
  pasts that capital encounters but cannot fully subsume) maps onto Benjamin's
  distinction between the progressive continuum and the messianic interruption,
  making Benjamin's anti-progressivism a resource for postcolonial historiography.},
  abstract_source = {author},
  note = {
  CORE ARGUMENT: Chakrabarty deploys Benjamin's critique of homogeneous empty
  time to argue that subaltern and non-European historicities exceed the
  categories of historicism. "History 1" (capital's own logic) and "History 2"
  (the diverse pasts that capital encounters but cannot fully subsume) maps onto
  Benjamin's distinction between the progressive continuum and the messianic
  interruption. This makes Benjamin's anti-progressivism a foundational resource
  for postcolonial historiography.

  RELEVANCE: Chakrabarty's book is the canonical text demonstrating how
  Benjamin's philosophy of history has been taken up in postcolonial and
  subaltern studies, addressing directly the question of whether Benjamin's
  anti-progressive temporality is useful for non-Eurocentric critique.

  POSITION: Postcolonial extension; uses Benjamin's critique of homogeneous
  time for decolonial historiography.
  },
  keywords = {chakrabarty, postcolonial, subaltern, homogeneous-time, provincializing-europe, High}
}

@article{montanelli2020baudelaire,
  author = {Montanelli, Marco},
  title = {Baudelaire Laboratory. Brief History of a Project by Walter Benjamin},
  journal = {Aisthesis. Pratiche, linguaggi e saperi dell'estetico},
  year = {2020},
  doi = {10.13128/AISTHESIS-12087},
  abstract = {The article retraces, from a historical-philological point of view,
  the main steps of Walter Benjamin's unfinished research on Baudelaire. It
  delves into the composition process of The Arcades Project, from which the
  idea of a book on Baudelaire then takes shape. The article examines the crucial
  stages of this second project's development through the correspondence between
  Benjamin and Theodor Adorno and Max Horkheimer: from the 1935 expose for The
  Arcades Project to The Paris of the Second Empire in Baudelaire, to the 1939
  essay On some Motifs in Baudelaire. The focus is set on the
  dialectical-constructive method that guides Benjamin in the composition of the
  Passagen-Werk and the Baudelaire essays.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Montanelli traces the development of Benjamin's Baudelaire
  project through the correspondence with Adorno and Horkheimer, from the
  1935 Arcades exposee through The Paris of the Second Empire in Baudelaire
  to the 1939 essay on Baudelaire's motifs. The article argues that the
  dialectical-constructive method guiding the Passagen-Werk is precisely what
  is at stake in the Adorno-Benjamin correspondence dispute, and that
  Benjamin's revision of the Baudelaire essay under Adorno's pressure
  represents a significant but incomplete reconciliation of their
  methodological differences.

  RELEVANCE: Provides detailed evidence for the Adorno-Benjamin method dispute
  as it played out in specific textual negotiations, making it useful for
  understanding the correspondence's stakes for the philosophy of history
  project.

  POSITION: Historical-philological reconstruction of the Frankfurt School
  method dispute.
  },
  keywords = {montanelli, baudelaire, adorno-benjamin-correspondence, arcades, methodology, Low}
}

