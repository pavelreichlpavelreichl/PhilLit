@article{andrew-benjamin2003roman,
  author = {Benjamin, Andrew},
  title = {Being Roman Now: The Time of Fashion. A Commentary on Walter Benjamin's `Theses on the Philosophy of History' XIV},
  journal = {Thesis Eleven},
  year = {2003},
  volume = {75},
  number = {1},
  pages = {39--53},
  note = {
  CORE ARGUMENT: Andrew Benjamin offers a close reading of Thesis XIV—the tiger's leap into the past—focusing on the figure of fashion (Mode) as a mode of temporal citation. He argues that fashion models a form of repetition that is neither mere imitation nor dialectical progress but a citing of the past that is inherently political in its temporality. The Romans of the French Revolution did not merely imitate antiquity but performed a now-time citation that made the past politically available.

