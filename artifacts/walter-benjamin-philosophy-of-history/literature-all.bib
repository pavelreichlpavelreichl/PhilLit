@article{wohlfarth1978messianic,
  author = {Wohlfarth, Irving},
  title = {On the Messianic Structure of Walter Benjamin's Last Reflections},
  journal = {Glyph},
  year = {1978},
  volume = {3},
  pages = {148--212},
  note = {
