  pages = {91--100},
  doi = {10.36253/aisthesis-13117},
  note = {
  CORE ARGUMENT: Tagliacozzo argues that the Theological-Political Fragment's concept of happiness illuminates a structural parallel between Benjamin and Kant: both articulate a "redemptive pessimism" in which the profane pursuit of happiness and the messianic order run in opposite directions yet together constitute a rhythm of history. The fragment's argument that "nature is messianic by reason of its eternal and total caducity" positions happiness as the transient, secular mode through which the messianic indirectly operates.

  RELEVANCE: The Theological-Political Fragment is the key text for understanding how Benjamin relates the profane and messianic orders -- a question that directly structures the puppet-dwarf image. This article's Kantian reading offers a bridge between Benjamin's early theological writings and his mature Marxist-messianic synthesis in the Theses.

  POSITION: The Fragment positions theology and the secular order in a relation of inverse parallelism rather than simple instrumentality: each enables the other while moving in opposite directions.
  },
  keywords = {theological-political-fragment, happiness, messianism, Kant, profane, Medium},
  abstract = {On the basis of a citation from the final part of Walter Benjamin’s Theological-Political Fragment (1920-21), we shall hypothesize a similarity between Benjamin and Kant, the political thinker and philosopher of history, in his Idea of a Universal History with a Cosmopolitan Intent. According to Kant, the man who participates in history and in the human race seeks happiness and the means to procure it for himself as a member of «free» humanity, thus seeking to unify external freedom and happiness in institutions of law. During the period 1920-1921 Benjamin was strongly critical of the concept of law, including also that of Kant, which he saw as contradictory to the idea of justice; in opposition, Benjamin held first an anarchist-libertarian view, then a revolutionary one. From a dialectical perspective, however, we find in common in Benjamin and Kant a redemptive pessimism that foresees, in the «twisted wood» of mankind, an ultimate providential and messianic possibility: «The spiritual restitutio in integrum, that leads to immortality, correspond to a worldly restitution that leads to an eternity of downfall, and the rhythm of this eternally transient worldly existence, transient in its totality, in its spatial but also in its temporal totality», the eternal succession of generations and their institutions, which is «the rhythm of messianic nature», is happiness. Nature eternalizes itself in this virtual spatial and temporal totality in the history of humanity moving toward the realization of the idea of law and, spatially, the achievement of global, cosmopolitan politics: «nature is messianic by reason of its eternal and total caducity».},
  abstract_source = {s2},
}

@article{hay2024unlearning,
  author = {Hay, Natasha},
  title = {Unlearning Pauline Messianism: Prophetic Study and Historical Injustice in Walter Benjamin and Hermann Cohen},
  journal = {The Journal of Speculative Philosophy},
  year = {2024},
  volume = {38},
  number = {3},
  pages = {313--323},
  doi = {10.5325/jspecphil.38.3.0313},
  note = {
  CORE ARGUMENT: Hay challenges Agamben's Pauline reading of Benjamin's theopolitics by recovering Benjamin's critical inheritance of Hermann Cohen's Jewish ethics -- specifically the concepts of unintentional sin and atonement. She argues that this Cohenian-prophetic register (Talmud Torah, attention to the cultural afterlives of historical violence) is incompatible with the antinomian, anarcholibertarian messianism Agamben projects onto Benjamin.

  RELEVANCE: This recent article intervenes in the dominant reception of Benjamin's messianism by showing that its Jewish sources are Cohenian-normative rather than Pauline-antinomian, which directly affects how one reads the "weak messianic power" and the alliance of theology with historical materialism. It also situates Benjamin within debates in political theology that go beyond the Schmitt-Benjamin opposition.

  POSITION: Benjamin's theopolitics belongs to the prophetic-normative tradition of Jewish ethics, not to the antinomian-messianic tradition; this affects the meaning of both his theology and his Marxism.
  },
  keywords = {messianism, Cohen, Agamben, Paul, Jewish-ethics, political-theology, Medium},
  abstract = {abstract:This article argues against Giorgio Agamben’s use of Paul’s Epistles to align Walter Benjamin’s critique of violence with antinomian theology and anarcholibertarian politics. It focuses specifically on Benjamin’s critical inheritance of Hermann Cohen’s concepts of unintentional sin and atonement to show that he reactivates a prophetic register of education in Jewish religious ethics. The article contends that these normative and narrative elements of Talmud Torah refute a reductive view of Jewish legalism in confronting the cultural afterlives of historical violence. This argument not only uncouples the reception of Benjamin’s theopolitics from contemporary continental philosophy’s revivals of Pauline messianism, but also contributes to a plural field of political theology emerging beyond the scope of secularized concepts of governance derived from a spurious universalism. This article proposes that the nonidentity between human law and divine justice can orient necessary resistance to justifications for and acts of state violence committed in a community’s name.},
  abstract_source = {s2},
}

@misc{lowy2019jewish,
  author = {L{\"o}wy, Michael},
  title = {Walter Benjamin and Jewish Radical Culture},
  year = {2019},
  howpublished = {\url{https://doi.org/10.1093/acrefore/9780190201098.013.44}},
  doi = {10.1093/acrefore/9780190201098.013.44},
  abstract = {Walter Benjamin (1892-1940) was situated among a constellation of
  early-20th-century radical Jewish thinkers delving into questions of German
  culture and philosophy in Mitteleuropa. Within this Jewish Central European
  radical culture, a complex network of links, of "elective affinities," brought
  together romanticism, Jewish messianism, anti-bourgeois cultural rebellion,
  and revolutionary utopias. Benjamin should thus be viewed as a religious
  atheist with anarchist leanings, who only discovers Marxism in the mid-1920s.
  He became the first Marxist to break radically with the ideology of progress.
  This philosophical peculiarity comes from his ability to incorporate into
  Marxist revolutionary theory insights from Jewish messianism and from the
  German Romantic critique of modern civilization.},
  abstract_source = {s2},
  note = {
  CORE ARGUMENT: Loewy situates Benjamin within the constellation of early
  twentieth-century German-Jewish radical intellectuals (Lukacs, Bloch, Kafka)
  who combined Jewish messianism with romantic anti-capitalism and
  revolutionary socialist politics. This "elective affinity" explains
  Benjamin's unique synthesis: a religious atheism in which the messianic
  structure of redemption is secularized into the revolutionary rupture of
  homogeneous time. Loewy emphasizes that Benjamin was the "first Marxist to
  break radically with the ideology of progress."

  RELEVANCE: Provides the cultural-historical context needed to understand
  why Benjamin's messianism takes the particular form it does, and situates
  the philosophy of history within a broader tradition of German-Jewish
  radical thought. This is essential context for assessing the left melancholy
  and Frankfurt School debates.

  POSITION: Affirmative reception; contextualization within German-Jewish
  radical intellectual culture.
  },
  keywords = {lowy, jewish-messianism, romanticism, anti-capitalism, German-Jewish, High}
}

@article{khanlarzadeh2020theology,
  author = {Khanlarzadeh, Mina},
  title = {Theology of Revolution: In Ali Shari'ati and Walter Benjamin's Political Thought},
  journal = {Religions},
  year = {2020},
  volume = {11},
  number = {10},
  pages = {504},
  doi = {10.3390/rel11100504},
  note = {
  CORE ARGUMENT: Khanlarzadeh offers a comparative analysis of Benjamin and Iranian revolutionary thinker Ali Shari'ati, arguing that both created theological-political conceptions of revolution in which theology and Marxism are not merely combined but dialectically transformed by each other: theology is animated by historical-materialist analysis, and Marxism is charged with the redemptive force of religious remembrance. Both thinkers theorize an "active messianism" in which every present moment carries messianic potential.

  RELEVANCE: The comparative structure illuminates what is structurally specific to Benjamin's synthesis of theology and Marxism (particularly his concepts of remembrance/Eingedenken and the present as moment of revolutionary possibility) by showing how similar syntheses arose independently in non-Western revolutionary contexts. This broadens the domain beyond the Eurocentric reception.

  POSITION: Benjamin's theological-political synthesis is not merely a European-Jewish phenomenon but exemplifies a broader form of revolutionary thought that combines materialist analysis with theological motivation.
  },
  keywords = {theology, revolution, messianism, Marxism, Shari-ati, comparative, Medium},
  abstract = {In this paper, I offer a comparative analysis of the political thoughts of twentieth century Iranian revolutionary thinker and sociologist Ali Shari’ati (1933–1977) and German-Jewish philosopher Walter Benjamin (1892–1940). Despite their conspicuously independent historical-theoretical trajectories, both Shari’ati and Benjamin engaged with theology and Marxism to create theological–political conceptions of the revolution of the oppressed. Shari’ati re-interpreted and re-animated Shia history from the angle of contemporary concerns to theorize a revolution against all forms of domination. In comparison, Benjamin fused Marxism with Jewish theology in his call to seize the possibilities of past failed revolutions in the present. Both Shari’ati and Benjamin conceptualized an active messianism led by each generation, eliminating the wait for the return of a messiah. As a result, each present moment takes on a messianic potential; the present plays an essential role to both thinkers. Past was also essential to both, because theology (through remembrance) had made the past sufferings incomplete to them. Both thinkers viewed past sufferings as an integral part of present struggles for justice in the form of remembrance (or yād or zekr for Shari’ati, and Zekher for Benjamin). I explore the ways Shari’ati and Benjamin theorized the role of the past in the present, remembrance, and messianism to create a dialectical relation between theology and Marxism to reciprocally transform and compliment both of them.},
  abstract_source = {s2},
}

@article{simpson2021migrants,
  author = {Simpson, Sid},
  title = {Migrants in the Profane: Critical Theory and the Question of Secularization},
  journal = {Political Theology},
  year = {2021},
  volume = {22},
  pages = {350--352},
  doi = {10.1080/1462317x.2021.1917223},
  note = {
  CORE ARGUMENT: This review of Peter Gordon's book Migrants in the Profane synthesizes Gordon's argument that Benjamin represents a theorist of "ambivalent secularization" -- the hidden puppet operator (theology) is not eliminated but concealed and transformed in historical materialism. Gordon's worry that extra-historical theology risks devolving into Schmittian decisionism is noted as the key critical stakes of Benjamin's move.

  RELEVANCE: The review reconstructs the puppet-dwarf image's logic with precision: theology does not run independently of historical materialism but constitutes its animating concealed operator, rendering Benjamin's secularization processual and dialectical rather than terminal. Gordon's charge of potential Schmittian decisionism raises the question of whether theological "weak force" can be critically controlled within materialism.

  POSITION: Benjamin occupies an unstable position "between Marxism and messianism" that is productive as critique but potentially dangerous if theology escapes the discipline of materialist analysis.
  },
  keywords = {secularization, Gordon, puppet-dwarf, Schmitt, Critical-Theory, Low},
  abstract = {The Frankfurt School’s considerable indebtedness to Marx’s historical materialism and Weber’s reflections on the “disenchantment of the world” make for an unexpected critical resource for thinking through the question of secularization. InMigrants in the Profane: Critical Theory and the Question of Secularization, Peter E. Gordon finds inWalter Benjamin, Max Horkheimer, and Theodor Adorno distinct attempts to theorize how modern secularization required religion’s transformation rather than its mere disappearance. As Adorno explained in a 1963 letter to Gershom Scholem; “Nothing of theological content will persist without being transformed; every content will have to put itself to the test of migrating into the realm of the secular, the profane” (111–112). The book, adapted from Gordon’s 2017 Franz Rosenzweig Lectures in Jewish Thought at Yale University, interrogates each of the three Frankfurt School critical theorists’ approach to theology. First is Benjamin, whose well known thesis on history and Paul Klee’s Angelus Novus already betrays the uneasy admixture of theology and historical materialism at the center of his thought. Gordon looks to Benjamin’s image of the undefeatable chess-playing mechanical Turk as a cipher for his position on theology. Though it appeared to function by virtue of its ingenious technical creation, the automaton in truth concealed a human operator. In Benjamin’s reading, the mechanical puppet is “historical materialism,” while the hidden flesh and blood operator is “theology, which today, as we know, is wizened and has to keep out of sight.” In other words, Benjamin contends that an extra-historical concept of the messianic animates historical materialism, and paradoxically renders secularization a process of theological concealment rather than disappearance. This is no genuinemessianism but rather what Benjamin calls a “weak messianic power”: a dialectical transformation of theology that animates motivation to revolution. On this basis, Gordon declares Benjamin a theorist of “ambivalent secularization, poised in indecision between Marxism and messianism” (53). Gordon’s worry, however, is that an appeal to an extra-historical principle that escapes critical scrutiny risks devolving into Schmittian decisionism. In Gordon’s mind, Horkheimer’s position on the role of theology transformed greatly throughout his life. The young Horkheimer dismissed any metaphysical considerations outside of material history, theological or otherwise. The older Horkheimer who co-authored with Adorno Dialectic of Enlightenment held a more ambivalent view: that Judaism “signified both an emancipatory principle opposed to the world-immanence of myth and a model for world-transcendent reason whose appearance marked an inaugural state in the dialectic of enlightenment” (145). On his view, monotheism became Janus-faced in modernity: it represented an alternative to the instrumental rationality that structured the emergence of Western subjectivity, despite its formative role in that history. Later still, this ambivalence would ultimately give way to a straightforward appeal to theology as “a final refuge for critical resistance to the supremacy of the merely given” (93). That theism alone sustained “the longing for something other than this world” (89) was trouble for Horkheimer’s commitment},
  abstract_source = {s2},
}

@incollection{khatib2024benjamins,
  author = {Khatib, Sami},
  title = {Benjamin's Materialism: Anthropological, Historical, or Dialectical?},
  booktitle = {The Palgrave Walter Benjamin Handbook},
  editor = {Ross, Nathan},
  year = {2024},
  publisher = {Springer Nature Switzerland},
  address = {Cham},
  pages = {579--593},
  note = {
  CORE ARGUMENT: Khatib maps the three major strands of Benjamin's materialism -- anthropological (image space and body space), historical (ideology as phantasmagoria and dialectical image), and dialectical (commodity fetishism and Marx's value theory) -- and argues that Benjamin's heterodox materialism is irreducible to any one of them. The chapter traces the Adorno-Benjamin debates of the 1930s over the relation between "theological" and "materialist" modes and shows how Benjamin navigated between Frankfurt School orthodoxy and Brechtian vulgar Marxism.

  RELEVANCE: This handbook chapter provides systematic coverage of Benjamin's materialism across his career, directly contextualizing the Theses' puppet-dwarf image within the broader trajectory of Benjamin's materialist method. It situates the theology-materialism relation within the Adorno-Benjamin correspondence, a crucial context for understanding the Theses' composition.

  POSITION: Benjamin's materialism is "neither Frankfurt nor Brechtian nor vulgar" -- it constitutes a genuinely new materialist position that can only be understood through its entanglement with theological motifs.
  },
  keywords = {materialism, Adorno, dialectical-image, phantasmagoria, commodity-fetishism, Medium, INCOMPLETE, no-abstract}
}

@article{loveluck2011redemption,
  author = {Loveluck, Benjamin},
  title = {The Redemption of Experience: On {Walter Benjamin}'s `Hermeneutical Materialism'},
  journal = {Philosophy \& Social Criticism},
  year = {2011},
  volume = {37},
  number = {2},
  pages = {167--188},
  doi = {10.1177/0191453710387069},
  note = {
  CORE ARGUMENT: Loveluck argues that Benjamin's project can be understood as a "hermeneutical materialism" that seeks to redeem human experience by moving beyond both the idealist hermeneutics of authenticity (Heidegger) and pure historicism. Benjamin chooses a path closer to Gadamer while radicalizing it: experience must be salvaged from the ruins of modernity without recourse to the nostalgic continuity of tradition.

  RELEVANCE: Locates Benjamin's theory of experience in relation to the hermeneutical tradition and distinguishes his approach from Heideggerian alternatives; illuminates the stakes of Benjamin's Erfahrung concept for philosophy of history, specifically why the redemption of experience is a philosophical and not merely aesthetic project.

  POSITION: Positions Benjamin as offering a third path between Gadamerian hermeneutics and Heideggerian authenticity, grounded in the materiality of historical experience.
  },
  keywords = {Erfahrung, hermeneutics, materialism, redemption, modernity, High},
  abstract = {The aim of this article is to show how philosopher and critic Walter Benjamin related to the hermeneutical tradition — and tried to move beyond it by ‘redeeming’ human experience, while avoiding the pitfalls of the philosophy of ‘authenticity’. Though convinced that questions relating to historicity were central to any understanding of modern human experience, Benjamin explicitly rejected the Heideggerian alternative, and chose a path closer to Hans-Georg Gadamer’s. He attempted to combine theological interpretation with dialectical materialism, always grounding hermeneutics in the concrete manifestations of social life, inaugurating a method which I suggest could be called ‘hermeneutical materialism’. At stake was a politically motivated defence of the ‘mimetic faculty’ — understood as (re)interpretation — in the modern, technologically organized world.},
  abstract_source = {openalex},
}

@article{pensky2010contributions,
  author = {Pensky, Max},
  title = {Contributions Toward a Theory of Storms: Historical Knowing and Historical Progress in Kant and Benjamin},
  journal = {The Philosophical Forum},
  year = {2010},
  volume = {41},
  number = {1-2},
  pages = {149--174},
  doi = {10.1111/j.1467-9191.2009.00356.x},
  note = {
  CORE ARGUMENT: Pensky argues that Benjamin's Angel of History thesis is best understood as a direct response to Kant's philosophy of historical progress, not merely to Rankean historicism or social-democratic Marxism. Where Kant grounded historical progress in regulative ideas and signs of mankind's moral advance, Benjamin substitutes the allegorical figure of the angel to show that what presents itself as progress in time is in fact an accumulation of catastrophe for those who do not occupy the perspective of the victors. The "storm from paradise" is read as Benjamin's inversion of Kantian teleology.

  RELEVANCE: This is among the most philosophically precise treatments of the Angel thesis, situating it within the history of philosophy of history rather than reading it purely as political critique or allegory. For the overall review, it establishes what exactly Benjamin is arguing against when he contests progress ideology, and why the Kant comparison is illuminating.

  POSITION: Represents a Kantian-critical reading of the Angel, as opposed to purely Marxist or theological interpretations.
  },
  keywords = {angel-of-history, critique-of-progress, Kant, Angelus-Novus, High},
  abstract = {There is a picture by Klee called Angelus Novus . It shows an angel who seems about to move away from something he stares at. His eyes are wide, his mouth is open, his wings are spread. This is how the angel of history must look. His face is turned toward the past. Where a chain of events appears before us, he sees one single catastrophe, which keeps piling wreckage upon wreckage and hurls it at his feet. The angel would like to stay, awaken the dead, and make whole what has been smashed. But a storm is blowing from Paradise and has got caught in his wings; it is so strong that the angel can no longer close them. This storm drives him irresistibly into the future, to which his back is turned, while the pile of debris before him grows toward the sky. What we call progress is this storm. 1},
  abstract_source = {openalex},
}

@incollection{vaki2024angel,
  author = {Vaki, Fotini},
  title = {Benjamin's ``Angel of History'' and the Critique of Progress},
  booktitle = {The Palgrave Walter Benjamin Handbook},
  editor = {Ross, Nathan},
  publisher = {Springer Nature Switzerland},
  year = {2024},
  pages = {579--593},
  doi = {10.1007/978-3-031-76688-6_29},
  note = {
  CORE ARGUMENT: Vaki examines Benjamin's critique of progress ideology as articulated in "On the Concept of History," arguing that his rejection of both Rankean historicism's narrative continuity and social-democratic Marxism's teleological determinism calls for a revolutionary historiography centered on Jetztzeit (now-time) and the redemption of suppressed historical moments. The Angelus Novus figure is read as a philosophical argument: history appears as wreckage rather than progress only from the standpoint of those who do not identify with the victors.

  RELEVANCE: As a handbook chapter in the most recent major Benjamin reference work, this provides the state-of-the-field synthesis on the Angel thesis and its relationship to the critique of progress. It connects the themes of this domain to Benjamin's broader philosophy of history and is the most recent survey-level treatment available.

  POSITION: Comprehensive overview position, integrating allegorical, political, and historiographical readings.
  },
  keywords = {angel-of-history, critique-of-progress, historicism, Angelus-Novus, High, INCOMPLETE, no-abstract}
}

@article{hope2019figuring,
  author = {Hope, Alexander},
  title = {Figuring out Benjamin's `Angel of History': `Reading', {Angelus Novus} and Sublime Metaphor},
  journal = {Textual Practice},
  year = {2019},
  volume = {34},
  number = {6},
  pages = {995--1020},
  doi = {10.1080/0950236x.2019.1586755},
  note = {
  CORE ARGUMENT: Hope argues that the proliferation of competing interpretations of "On the Concept of History" is not a scholarly failure but is structurally produced by the text's own rhetorical architecture. An interplay between grammar and rhetoric in the Angel thesis generates an imperative to "translate" that is irreducible to any single reading; the text thus performs the very anti-historicist argument it makes, resisting the totalizing readings that historicism demands. Drawing on Jakobson's theory of translation and Lyotard's notion of "bearing witness to the unpresentable," Hope shows that the sublime metaphor of the angel is not a cipher to be decoded but a productive excess.

  RELEVANCE: This is the most detailed rhetorical-philosophical analysis of the Angel thesis qua text, and establishes why the image generates interpretive controversy. For the overall review, it explains a persistent feature of the Benjamin reception and situates the Angel's hermeneutic openness as philosophically intentional.

  POSITION: Anti-hermeneutic, rhetorical approach; in tension with allegorical and biographical readings.
  },
  keywords = {angel-of-history, Angelus-Novus, rhetoric, sublime, interpretation, High},
  abstract = {ABSTRACT The image of the ‘angel of history’ forms the centrepiece of one of Walter Benjamin’s most famous essays: ‘On the Concept of History’. This text has a troubled exegetical history, with numerous competing interpretations attempting to explain what Benjamin really meant. Few, with the exceptions of Timothy Bahti and Sigrid Weigel, have stopped to examine the fragments’ rhetorical structure or to ask what it is about ‘On the Concept of History’ that leads to such a proliferation of readings. This essay, rather than searching Benjamin’s corpus for the ciphers to decode the fragments’ meaning, instead focuses on the complex rhetorical structure of ‘the angel of history’. It argues that an interplay between grammar and rhetoric induces a multiplication of possible interpretations, and indeed that this poetic density seems to involve an imperative to ‘translate’, both the ‘original’ (German or French) text and its complex relationship with the ‘derived’ English version, both interlinguistically and intralinguistically, as Roman Jakobson (1959) would say. It shows that this complex rhetorical structure actually performs the argument put forward in the fragments about the impossibility of historicist totalising readings of history, yet in its injunction to translate or interpret, ‘bear witness to the unpresentable’ (Lyotard), seems to ask that very impossible over and over again.},
  abstract_source = {s2},
}

@article{nobleolson2020angels,
  author = {Noble-Olson, Matthew},
  title = {The Angels of Accumulated Suffering},
  journal = {New German Critique},
  year = {2020},
  volume = {47},
  number = {2},
  pages = {217--246},
  doi = {10.1215/0094033x-8288209},
  note = {
  CORE ARGUMENT: Noble-Olson reads Benjamin's description of Klee's Angelus Novus through Adorno's theory of art's contradictory sociality. Just as the angel is compelled to observe historical wreckage from afar without being able to intervene, the art object in Adorno's aesthetics remains framed within its socially produced constraints, expressing suffering it cannot alleviate. The essay then asks what happens to the angel figure under conditions of contemporary art's weakened autonomy, where art embraces sociality directly.

  RELEVANCE: This article bridges Benjamin's philosophy of history and Frankfurt School aesthetics, showing how the Angel thesis has implications for a theory of critical art under capitalism. It connects Domain 3 to questions of allegory and melancholy (relevant to other domains in the review).

  POSITION: Adornian-aesthetic reading of the Angel, extending the catastrophe thesis into art theory.
  },
  keywords = {angel-of-history, Adorno, aesthetics, catastrophe, High},
  abstract = {This essay reads Walter Benjamin’s description of Paul Klee’s Angelus Novus through Theodor Adorno’s theorization of art’s contradictory sociality. In this analysis, the object that is illustrative of Benjamin’s imagined angel of history takes on the characteristics of that figure as the art object itself in Adorno’s analysis of art’s enforced distance from empirical reality. Just as the angel is forced to observe the wreckage of history from afar, the art object must remain framed within its own socially produced constraints, which protects it from what it observes but also ensures that it may take no action on behalf of the suffering that it expresses. This analysis is then used to consider the possible status of the angel in the moment of contemporaneity, as art embraces sociality and faces a weakened autonomy.},
  abstract_source = {s2},
}

@article{khatib2017where,
  author = {Khatib, Sami},
  title = {Where the Past Was, There History Shall Be},
  journal = {Anthropology \& Materialism},
  year = {2017},
  volume = {Special Issue | I},
  doi = {10.4000/am.789},
  note = {
  CORE ARGUMENT: Khatib argues that Benjamin's injunction to write history from the "tradition of the oppressed" is not simply a political slogan but rests on a specific materialist epistemology derived from Marx and reworked through Benjamin's concept of the dialectical image. The past is not finished but retains an unfulfilled claim on the present; historical materialism is the practice of responding to that claim by "blasting" specific constellations out of the homogeneous continuum. Benjamin's critique of Ranke's "how it really was" is the negative corollary: empathy with the victor forecloses the constellation by anchoring it in a sovereign narrative.

  RELEVANCE: This is the most thorough treatment of Benjamin's concept of the "tradition of the oppressed" (Theses VI, VIII) and its relationship to the critique of historicism, directly addressing two of the domain's key questions. It establishes the epistemological stakes of "brushing against the grain" as more than a metaphor.

  POSITION: Materialist-Marxist reading, emphasizing epistemological rather than purely ethical dimensions.
  },
  keywords = {tradition-oppressed, historicism, Ranke, brushing-against-grain, historical-materialism, High},
  abstract = {As the proverb has it, ‘tradition is not to preserve the ashes but to pass on the flame’. Taking this image as a starting point, this paper is interested in non-conservative concepts of tradition and (dis)continuity. If the concept of tradition is normally associated with continuity, the concept of tradition poses the question of transmittability. Is there a continuous medium in which narrations, customs, rites or other material practices can be handed down from the past to the present? If the transmittability of tradition is not a given, a commodified object, but subject to historical change, the question of tradition and inheritance is inextricably linked to social and political struggles. The concept of tradition, however, has mostly been theorized by conservative thinkers. In this vein, traditional historical materialism viewed tradition as a counter-progressive retarding force. Walter Benjamin (1940), however, proposed a different concept of historical time and tradition. History is not based on a progressive flow of “homogeneous, empty time” but on disruptive constellations of the present and the past. The past is never fully gone; it can never be fully historicized. The medium in which the present is connected to all lost causes and struggles of those who literally and metaphorically lost their histories is called the “tradition of the oppressed.” Paradoxically, this medium is a discontinuum – its texture is woven out of struggles, empty-spots and disconnected elements which cannot be represented in one transmittable image or inscribed into one multifaceted yet coherent world-history. If the “tradition of all dead generations weighs like a nightmare on the brains of the living” (Marx), then the tradition of the oppressed will also haunt all attempts to repress it completely and erase its experience in the linear continuum of “victor’s history.” But how are we to pass on an oppressed tradition? How can the tradition of the oppressed be recalled, actualized and “worked through”?},
  abstract_source = {s2},
}

@article{wu2020historical,
  author = {Wu, Yi},
  title = {The Historical and Its Discontents: Nietzsche and Benjamin Against ``Historicism''},
  journal = {The Journal of Speculative Philosophy},
  year = {2020},
  volume = {34},
  number = {1},
  pages = {49--68},
  doi = {10.5325/jspecphil.34.1.0049},
  note = {
  CORE ARGUMENT: Wu traces an unbroken critical line from Nietzsche's "On the Uses and Disadvantages of History for Life" to Benjamin's "On the Concept of History," arguing that both diagnose historicism as the defining "sickness of time" in modernity. For Nietzsche, historicism is the malady of an excess of historical consciousness that prevents life from shaping itself; for Benjamin, it is the specific form taken by this excess when it aligns with progress ideology and empathy with the victor. The two critiques are juxtaposed to reveal what is continuous (the assault on historicism's pretension to objectivity) and what differentiates them (Benjamin's messianic interruption vs. Nietzsche's vitalist forgetting).

  RELEVANCE: This article directly addresses the Ranke/historicism critique that is central to the domain and situates Benjamin's argument within a longer nineteenth-century intellectual genealogy. It establishes what is distinctive about Benjamin's anti-historicism by comparing it to Nietzsche's, which is helpful for the overall review's treatment of method.

  POSITION: Intellectual-historical reading, against purely theological or Marxist interpretations.
  },
  keywords = {historicism, Nietzsche, Ranke, critique-of-progress, historiography, High},
  abstract = {abstract:Representations of historicism as the loss of meaning in history and critiques of historicism as the critique of such a loss had been pervasive from the late nineteenth century until World War II. Among historicism’s most powerful and representative critics were the young Friedrich Nietzsche and Walter Benjamin in his Parisian exile. This essay seeks to trace from Nietzsche to Benjamin an unbroken yet growing line of critique of historicism—as the “sickness of time” from which modernity both suffers and has been trying to recover. Two attempts at such a recovery will be examined and juxtaposed: Nietzsche’s “On the Uses and Disadvantages of History for Life” and Benjamin’s “Theses on the Philosophy of History.” By thus situating both historicism and its critiques within the desires and anxieties of modernity, this essay tries to delineate and to understand the peculiarly modernist shapes assumed by the historical and its discontents.},
  abstract_source = {s2},
}

@article{beiner1984benjamin,
  author = {Beiner, Ronald},
  title = {Walter Benjamin's Philosophy of History},
  journal = {Political Theory},
  year = {1984},
  volume = {12},
  number = {3},
  pages = {423--434},
  doi = {10.1177/0090591784012003005},
  note = {
  CORE ARGUMENT: Beiner reads Benjamin's philosophy of history as a politics of memory against forgetting: the theses on history are an argument that the socialist labor movement has acquiesced to progress ideology in a way that leaves the dead unredeemed and disarms the present against fascism. Benjamin's messianism is read as a political rather than theological concept, a call for revolutionary action that "seizes hold" of the past at the moment of danger.

  RELEVANCE: This is an early and influential political-theoretical reading of Benjamin's philosophy of history that treats the Angel thesis and the critique of progress in a unified framework. It establishes the political stakes of Benjamin's argument and serves as a reference point for subsequent political readings.

  POSITION: Political-theoretical reading; emphasizes the anti-fascist stakes of Benjamin's historiography.
  },
  keywords = {philosophy-of-history, critique-of-progress, messianism, political-theory, Medium},
  abstract = {What is Walter Benjamin's intention in his enigmatic on Philosophy of History'?' According to Benjamin's friend Gershom Scholem, Theses he accomplished his awakening from shock of pact.2 According to Scholem, Theses mark Benjamin's decisive break with materialism and a return to metaphysical-theological concerns of his early thought: What Theses have left in common with materialism is only ironic relation of termini technici'; frequently nothing remains of materialism except term itself.4 The secret core of theses is in fact, for Scholem, hope of a leap into transcendence.5 In support of his interpretation, Scholem cites first thesis, where Benjamin proposes an alliance between materialism and theology. Historical materialism must take its guidance from theology if it is to win day. History is likened to a chess game, where materialism appears to be in command, whereas in fact it is a mere puppet controlled by unseen hand of theology.6 On Scholem's reading of theses, angel of history (in thesis IX) cannot make whole again fragments of history, and therefore Benjamin must have resort, in last thesis, to Messiah, who alone can succeed where angel must fail-namely, in redemption of history.7 On this reading, Benjamin appears as a theologian manque, fighting to break out of materialistic categories, who finally forsakes angel of materialism for Messiah of Jewish theology. The Theses themselves present a very different face. In every one of theses, Benjamin gives impression of struggling to define true nature of materialism, as well as struggling to formulate his position in relation to historicism generally. Phrases such as the materialist knows this, historical materialists must be aware of that, run throughout Theses. In each of theses Benjamin},
  abstract_source = {openalex},
}

@article{dejoya2014vision,
  author = {De Joya, Preciosa Regina},
  title = {A Vision of Hell: Walter Benjamin's {Angelus Novus} and the Catastrophe of Progress},
  journal = {Budhi: A Journal of Ideas and Culture},
  year = {2014},
  volume = {18},
  number = {1},
  pages = {18--53},
  doi = {10.13185/bu2014.18102},
  note = {
  CORE ARGUMENT: De Joya offers a close reading of the Angelus Novus thesis arguing that Benjamin's vision of progress as catastrophe is not pessimistic but dialectical: the catastrophe does not close off hope but is its precondition, since only by recognizing the wreckage as wreckage can the historical materialist identify the moment of revolutionary possibility. The angel sees hell, but the theological underside of this vision is a negative theology of redemption.

  RELEVANCE: This article connects the catastrophe thesis to Benjamin's negative theology and messianism, and provides a detailed reading of the visual-allegorical dimension of Thesis IX. It bridges the Angel interpretation literature with the messianism literature.

  POSITION: Theological-dialectical reading; against defeatist or purely melancholic interpretations.
  },
  keywords = {angel-of-history, catastrophe, Angelus-Novus, negative-theology, Medium},
  abstract = {Before his untimely death in 1940, the German philosopher Walter Benjamin wrote an essay, entitled “Theses on the Philosophy of History,” marking his recovery from the shock of the Hitler-Stalin non-aggression pact. This study reflects on the philosophical and historical significance of this essay, unraveling Benjamin’s critique of Marxism as a critique of progress. Progress, which the angel of history sees as a storm coming from paradise, has caused a growing pile of rubble of historical blunders and environmental disasters. This uncritical submission to progress, however, can be seen not only in the blind confidence of the communists and the social democrats towards Marxist teleology, but also in historicism, which reduces the writing of history to a form of disaster: a “heaping up of information” that forgets the memory of “enslaved ancestors,” thus losing its “weak, Messianic power.”},
  abstract_source = {openalex},
}

@article{fiedler2021angel,
  author = {Fiedler, Emma Barrett},
  title = {The Angel of History and the Ruins of {Paris}: Walter Benjamin in France or the Progress as Catastrophe},
  journal = {European Journal of Social Sciences Studies},
  year = {2021},
  volume = {7},
  number = {1},
  doi = {10.46827/ejsss.v7i1.1154},
  note = {
  CORE ARGUMENT: Fiedler connects Benjamin's Angel of History thesis (1940) to the much earlier Arcades Project (1927--1940), arguing that both share a conception of progress as a permanent "state of emergency" rather than an exceptional event. Drawing on Benjamin's reading of Haussmann's modernization of Paris and the Copernican revolution in historical method he proposes, Fiedler situates the catastrophe thesis within a radical paradigm that locates catastrophe in the past and present rather than anticipating it for the future.

  RELEVANCE: This article provides an extended materialist analysis of the Angel thesis by grounding it in the Arcades Project's treatment of Parisian modernity, showing how the philosophical claim about progress-as-catastrophe is connected to Benjamin's concrete historical investigations. It is useful for the review's treatment of the relationship between "On the Concept of History" and the Arcades Project.

  POSITION: Materialist-historical reading, against abstract-philosophical or purely theological approaches.
  },
  keywords = {angel-of-history, catastrophe, Arcades-Project, progress, state-of-emergency, Medium},
  abstract = {If Walter Benjamin's writings have been mostly interpreted in the fields of art and literature critique, we would like here to take his philosophy of history more seriously, despite its acknowledged lack of unity (Habermas 1988: 32) and systematicity (Arendt 1960: 248). Drawing from the well-known allegory of the “Angel” developed in his theses on the concept of history written at the beginning of the Second World War and just before his death in Port-Bou, we will further analyze his genealogical critique of Parisian modernity contained in the Arcades Project, a work undertook more than a decade before, during his exile in France. In echo with the imagination of prospective ruins which florished during the modernization of the French capital after the 1850's, Benjamin's conception of progress, understood as a catastrophe submitting industrial capitalist societies to a permanent “state of emergency”, is thus combined with the theorization of a “Copernician revolution in the field of historical method” (Benjamin 1999: 348). Beyond Benjamin's phenomenological enterprise of a physiognomy of material modernity, and the romantic and surrealistic sensibility of his “anthropological materialism”, his philosophy of progress inscribes itself in a radical paradigm rendering its centrality to the idea of catastrophe (Anders 1972; Dupuy 2004; Stengers 2009), against the accidental role it holds in the principles of precaution and “responsibility” (Jonas 1979) and in the nowadays dominant paradigm of “risk” (Beck 1986); furthermore, “our” catastrophes would have in a Benjaminian perspective to be diagnosed in the past and the present rather than anticipated for the future. 
  abstract_source = {s2},
 
  Article visualizations:},
}

@article{frelek2025hope,
  author = {Frelek, Andrzej},
  title = {Hope in a Warming World: Rereading Adorno on Progress},
  journal = {New German Critique},
  year = {2025},
  volume = {52},
  number = {1},
  pages = {131--160},
  doi = {10.1215/0094033x-11503213},
  note = {
  CORE ARGUMENT: Frelek argues for the contemporary relevance of Adorno's 1962 essay "Progress" by reading it against the climate crisis, while tracing Adorno's argument back to its debts to Benjamin. Adorno's analysis of history and catastrophe, his critique of philosophies of progress and their theological inheritance, and his dialectical concept of a "negative hope" are all shown to depend on Benjamin's earlier reformulations. Frelek defends retaining a form of negative critical hope against both resigned catastrophism and naive progressivism.

  RELEVANCE: This recent article (2025) extends the Benjamin-Adorno relationship on progress ideology into the present, showing how the critique of progress continues to be worked through in Critical Theory. It provides material for the review's treatment of the legacy and contemporary relevance of Benjamin's catastrophe thesis.

  POSITION: Critical Theory extension of Benjamin's catastrophe thesis; connects to Adorno and climate ethics.
  },
  keywords = {critique-of-progress, Adorno, catastrophe, climate, Critical-Theory, Medium},
  abstract = {This article argues for the value inherent in rereading Theodor Adorno’s 1962 essay “Progress,” placing his thoughts in the context of the climate crisis and arguing for the necessity of retaining a form of negative hope in critical theory. First, the article retraces his analysis of the relation between history and catastrophe, itself indebted to the writings of Walter Benjamin. Second, the article shows how Adorno relates the aforementioned idea to the historical genealogy of philosophies of progress and their theological inheritance. Third, the article focuses on his critical reworking of the concept of progress and its relation to the dialectic of freedom and unfreedom. Finally, the article attempts to place Adorno’s ideas in the context of the dangers posed by the climate crisis, showing that his thought remains extremely relevant to the present historical situation.},
  abstract_source = {s2},
}

@article{hong2026crisis,
  author = {Hong, June Soung},
  title = {Crisis, Angels, and Political Theology: Incapacitated Transcendence in Klee and Benjamin Against Schmitt},
  journal = {Religions},
  year = {2026},
  volume = {17},
  number = {5},
  pages = {546},
  doi = {10.3390/rel17050546},
  note = {
  CORE ARGUMENT: Hong develops the concept of "incapacitated transcendence" through a reading of Paul Klee's angel paintings (including the Angelus Novus) as a theological counterpoint to Carl Schmitt's theory of sovereignty. Klee's malformed or flightless angels present a divine presence that is ontologically present but structurally incapable of sovereign intervention, subverting Schmitt's secularized miracle of sovereign decision. Benjamin's Angel of History is then read as the culmination of this incapacitated transcendence: its incompetence in the face of historical wreckage is the site of a hope that refuses the logic of sovereign power.

  RELEVANCE: This is the most recent (2026) article on the Angel thesis and provides a reading that directly engages the political theology literature, connecting Benjamin's image to the Schmitt-Benjamin debate and the question of whether Benjamin's theology implies decisionism. It updates the domain for the current year.

  POSITION: Political theology reading, using Klee's visual work as interpretive key; against both theological triumphalism and secular dismissal.
  },
  keywords = {angel-of-history, Klee, Schmitt, political-theology, incapacitated-transcendence, Low},
  abstract = {This study explores “incapacitated transcendence”—a divine presence that remains ontologically present but lacks sovereign power to intervene—within Paul Klee’s angel paintings. It reinterprets these figures as a critical counterpoint to Carl Schmitt’s theory of sovereignty. While Schmitt rationalized the “decision” of an omnipotent sovereign as a secularized miracle, Klee’s malformed or flightless angels present a starkly different theological device. Influenced by Nietzsche, Klee rejected traditional afterlife-oriented transcendence while preserving it as a domain inassimilable to human finitude. Following World War I, this evolved into “incapacity”—not an absence of the divine, but the structural impossibility of its manifestation through fragile human existence. By contrasting Klee’s Angelus Novus with Schmitt’s sovereign, this study argues that incapacitated transcendence deconstructs the myth of absolute political power. Drawing on Walter Benjamin’s “Angel of History,” this study concludes that this very incompetence constitutes a site of hope. This reinterpretation suggests that aesthetics can offer a profound critique of political theology, challenging absolutist models of power in contemporary crisis.},
  abstract_source = {s2},
}

@book{buckmorss1989dialectics,
  author = {Buck-Morss, Susan},
  title = {The Dialectics of Seeing: Walter Benjamin and the Arcades Project},
  year = {1989},
  publisher = {MIT Press},
  address = {Cambridge, MA},
  note = {
  CORE ARGUMENT: Buck-Morss reconstructs the entire Arcades Project as a
  coherent philosophical argument organized around the concept of the
  dialectical image. She argues that Benjamin developed a materialist
  visual epistemology in which commodity culture generates collective
  dream-images (phantasmagorias) that the dialectical image disrupts by
  making their historical and social constitution visible. The "dialectics
  of seeing" names a mode of historical cognition that is optical before
  it is conceptual.

  RELEVANCE: This is the foundational secondary work on Benjamin's
  historiographic method in the Arcades Project and the primary reference
  for any engagement with the dialectical image. Buck-Morss also provides
  an indispensable reconstruction of Konvolut N's methodological
  reflections and situates them within the project's overall architecture.

  POSITION: Defends the dialectical image as a genuinely materialist
  category against Adorno's charge that Benjamin had psychologized or
  empiricized it; reads Benjamin's method as closer to Brechtian montage
  than to Hegelian dialectics.
  },
  keywords = {dialectical-image, arcades-project, materialism, Buck-Morss, High, INCOMPLETE, no-abstract}
}

@article{friedlander2008measure,
  author = {Friedlander, Eli},
  title = {The Measure of the Contingent: Walter Benjamin's Dialectical Image},
  journal = {boundary 2},
  year = {2008},
  volume = {35},
  number = {3},
  pages = {1--26},
  doi = {10.1215/01903659-2008-010},
  note = {
  CORE ARGUMENT: Friedlander argues that Benjamin's dialectical image
  constitutes a distinctive mode of philosophical objectivity that cannot
  be reduced either to Hegelian dialectical sublation or to empiricist
  representation. The image "measures" the contingent by arresting the
  flow of historical time at a moment where past and present become
  mutually legible -- what Benjamin calls the "now of recognizability."
  Friedlander situates this within Benjamin's broader neo-Kantian and
  post-Kantian philosophical formation.

  RELEVANCE: One of the most philosophically rigorous treatments of the
  dialectical image concept available in English, directly relevant to
  the question of how Benjamin's method differs from Hegelian dialectics
  and what kind of historical knowledge it makes possible.

  POSITION: Defends the dialectical image as a genuine philosophical
  category with its own epistemological standards, contributing to the
  debate between "objective" and "experiential" readings of the concept.
  },
  keywords = {dialectical-image, now-of-recognizability, Friedlander, epistemology, High},
  abstract = {The present essay sketches in broad outlines the philosophical armature of Walter Benjamin's Arcades Project by analyzing the central theoretical notion in that incomplete manuscript of his: the dialectical image. So as to bring out the uniqueness of Benjamin's use of image, I consider his account of its relation to language. Rather than setting an opposition between language and image, I argue that language is the medium in which the dialectical image can emerge at all. I further think of the emerging image as characterizing the mode of presentation of the material of the investigation as a whole, or in other words, the dialectical image is what constitutes the presentation of what Kant calls an idea with the material of experience. The image so revealed is not a representation of reality, but rather Benjamin thinks of it, after Goethe, as an archetype, a standard for judging the significance of historical reality. The possibility of recognizing the image of the past further depends on being attuned to a peculiar temporality, a movement within the medium of memory in which the meaning of the past is realized in the present. Finally, as I argue, the past emerges in authentic historical remembrance initially in a distorted form which Benjamin compares to the form of meaning in dream experience. The recognition of the image must then be understood as the traversal of that space of semblance which brings out its truth, as the awakening from the dream.},
  abstract_source = {openalex},
}

@article{helmling2003constellation,
  author = {Helmling, Steven},
  title = {Constellation and Critique: Adorno's Constellation, Benjamin's Dialectical Image},
  journal = {Postmodern Culture},
  year = {2003},
  volume = {14},
  number = {1},
  doi = {10.1353/pmc.2003.0036},
  note = {
  CORE ARGUMENT: Helmling examines the relationship between Adorno's
  method of "constellation" and Benjamin's "dialectical image," arguing
  that both concepts respond to the same problem -- the arrested or
  stalled progress of modernity -- but in different ways. Adorno's
  constellation extends and subjects to immanent critique what Benjamin
  formulated as dialectics at a standstill; Adorno worried that
  Benjamin's images reinforced stasis rather than critiquing it. The
  essay reads this productive tension through Adorno's Holderlin essay,
  his debate with Lukacs, and the Dialectic of Enlightenment.

  RELEVANCE: Directly addresses the Benjamin-Adorno dispute over the
  dialectical image, which is the central controversy in the secondary
  literature on Benjamin's historiographic method. Situates "dialectics
  at a standstill" in the broader context of critical theory's engagement
  with modernist form.

  POSITION: Neither simply Adornian nor Benjaminian; maps the productive
  tension between their approaches to show what each gains and loses.
  },
  keywords = {dialectical-image, Adorno, constellation, dialectics-at-standstill, High},
  abstract = {Constellation and Critique: Adorno’s Constellation, Benjamin’s Dialectical Image Steven Helmling (bio) Abstract This essay considers Adorno’s theory and practice of “constellation,” most centrally in relations both of influence and of tension with Walter Benjamin’s practice of the “dialectical image.” In later years, Adorno frequently ascribed to Benjamin’s practice a “Medusa-gaze” that effectively petrified, or (telling ambivalence) exposed the always-already-petrified reification, of its ideological object; in this way, Benjamin’s work aimed to evoke the baffled or arrested progress of modernity that he famously evoked in the phrase “dialectics at a standstill.” This was a thematic Adorno prolonged, but from very early on, Adorno had misgivings about the effect of stasis that Benjamin’s dialectical image as much reinforced as critiqued. The essay looks closely at various of Adorno’s formulations about Benjamin as well as about such related matters as “immanent critique,” Gestalt psychology, and Hölderlin’s practice of “parataxis,” to elicit the tensions in Adorno’s thinking, over the course of his career, about the critical or dialectical mimesis necessarily obtaining between critique and its object (the representation of the object, the representation of the overcoming of the object). A particular focus here is narrative, a standard property of the type(s) of critique that Adorno meant to refuse; Adorno’s “debate” with Lukàcs here appears as embodying the transition from “realism” to “modernism” that was the debate’s ostensible theme. The essay closes with reflections on failed progress, or progress reverting to regress. Benjamin’s “dialectics at a standstill” could be the apt formula, but also the fate from which Adorno and Horkheimer so desperately hope to redeem Enlightenment. —sh Fredric Jameson years ago characterized Adorno’s chief critical device or method as the “historical trope” (Marxism and Form 3–59), so it shouldn’t strike anyone as a novel claim that Adorno’s “constellation” displays affinities with other now-familiar devices of modernist art and literature—Eisensteinian montage, cubist collage, the Joycean “epiphany,” the Poundian “ideogram.” The young Adorno presumably first encountered the word’s relevant usages when he read Benjamin’s Trauerspiel in the late 1920s; however that may be, the word recurs in his work throughout his career, from “The Actuality of Philosophy” (1931) to the late pieces collected in Critical Models. Its connotations are diverse and often conflicting, and one could make an interesting study of such tellingly divergent uses, as well as an interesting speculation of the rarity of Adorno’s own second-level reflections on the word.1 The present study, however, attempts nothing so comprehensive.2 I want in this paper to unpack some of the implications of constellation as a critical practice and elicit their tension or contradiction (a word not necessarily a vitiation in Adorno’s usage, and in many contexts a term of high praise) with the overall program, derived from Hegel, that Adorno regularly calls “immanent critique.” To that end, I will consider constellation in relation to Walter Benjamin’s “dialectical image,” with which it has obvious but also qualified affinities, to the Gestalt psychology of Wolfgang Köhler, from which Adorno would have been anxious to distinguish it, and to the epic device of “parataxis” as Adorno commends Hölderlin’s use of it. I will end by bringing the issues that emerge to bear on the 1944 Dialectic of Enlightenment, co-authored with Max Horkheimer, and the curiously agitated stasis “motivating” its thematic of Western Civilization’s “progress” and “regress.” Adorno and Benjamin It is in his “Portrait of Walter Benjamin” that Adorno speaks most suggestively and, for his own practice, most revealingly, about the theory, the practice, and the effect, of Benjamin’s dialectical image: The [Benjaminian] essay as form consists in the ability to regard historical moments, manifestations of the objective spirit, “culture,” as though they were natural. Benjamin could do this as no one else. The totality of this thought is characterized by what may be called “natural history.” He was drawn to the petrified, frozen or obsolete elements of civilization, to everything in it devoid of domestic vitality [...]. The French word for still-life, nature morte, could be written above the...},
  abstract_source = {openalex},
}

@incollection{pensky2004method,
  author = {Pensky, Max},
  title = {Method and Time: Benjamin's Dialectical Images},
  booktitle = {The Cambridge Companion to Walter Benjamin},
  year = {2004},
  pages = {177--198},
  publisher = {Cambridge University Press},
  doi = {10.1017/ccol0521793297.010},
  note = {
  CORE ARGUMENT: Pensky argues that Benjamin's dialectical image is
  best understood as a temporal concept -- a figure for the collision of
  different historical temporalities in a moment of historical
  recognizability -- rather than as a visual or spatial category. He
  traces how the concept develops from Benjamin's early work on
  allegory and the Trauerspiel through the Arcades methodology, showing
  how time functions as both the medium and the object of dialectical
  historical cognition.

  RELEVANCE: This is the primary handbook treatment of Benjamin's
  historiographic method in English, written for a philosophical audience.
  It is the natural starting point for understanding how method and
  temporality are connected in Benjamin's mature work.

  POSITION: Interprets the dialectical image primarily as a temporal
  rather than visual category, contrasting with Buck-Morss's emphasis on
  the visual-material dimension.
  },
  keywords = {dialectical-image, method, temporality, Pensky, Cambridge-Companion, High},
  abstract = {It's not that what is past casts its light on what is present, or what is present its light on the past; rather, image is that wherein what has been comes together in a flash with the now to form a constellation. In other words, image is dialectics at a standstill. For while the relation of the present to the past is a purely temporal, continuous one, the relation of what-has-been to the now is dialectical: is not progression but image, suddenly emergent. – Only dialectical images are genuine images (that is, not archaic); and the place where one encounters them is language."Awakening" (Arcades, 462; n2a, 3)},
  abstract_source = {openalex},
}

@book{buckmorss1977origins,
  author = {Buck-Morss, Susan},
  title = {The Origin of Negative Dialectics: Theodor W. Adorno, Walter Benjamin, and the Frankfurt Institute},
  year = {1977},
  publisher = {Free Press},
  address = {New York},
  note = {
  CORE ARGUMENT: Buck-Morss reconstructs the intellectual relationship
  between Adorno and Benjamin from the late 1920s through the 1930s,
  showing how Adorno's negative dialectics emerged partly in response to
  and in productive tension with Benjamin's materialist image theory. The
  dispute over the dialectical image -- whether it should be understood
  as an objective category or as grounded in collective experience -- is
  traced through their correspondence and publications.

  RELEVANCE: Essential background for the Benjamin-Adorno dispute over
  the dialectical image, providing the historical context for
  understanding why Adorno criticized Benjamin's Arcades methodology as
  lacking immanent critique and being insufficiently dialectical.

  POSITION: Broadly sympathetic to Benjamin's procedure while
  acknowledging Adorno's legitimate philosophical objections; establishes
  the framework within which later commentators (Helmling, Friedlander)
  work.
  },
  keywords = {Adorno, Benjamin, dialectical-image, negative-dialectics, Frankfurt-School, Medium, INCOMPLETE, no-abstract}
}

@book{cohen1993profane,
  author = {Cohen, Margaret},
  title = {Profane Illumination: Walter Benjamin and the Paris of Surrealist Revolution},
  year = {1993},
  publisher = {University of California Press},
  address = {Berkeley},
  note = {
  CORE ARGUMENT: Cohen argues that surrealism, particularly Breton's
  concept of "profane illumination," provided the decisive theoretical
  resource for Benjamin's Arcades methodology. She reads the Arcades
  Project as an attempt to develop a materialist historiography that
  appropriates and transforms surrealism's capacity to produce shock
  recognition of the social content of commodity images. The "dream"
  in Benjamin is not a metaphor but a historically specific collective
  unconscious that must be "read" as historical evidence.

  RELEVANCE: Establishes the surrealist genealogy of Benjamin's
  dialectical image and awakening concepts, directly relevant to the
  question of how Benjamin's method relates to surrealism. Cohen's
  account of "profane illumination" as a historiographic category is
  essential for understanding the image-dream-awakening complex in
  Konvolut N.

  POSITION: Reads Benjamin's method as a critical appropriation and
  materialist transformation of surrealism, rather than a simple
  continuation; situates the dialectical image within a politics of
  historical memory.
  },
  keywords = {surrealism, profane-illumination, arcades-project, dream-awakening, Cohen, High, INCOMPLETE, no-abstract},
  sep_context = {Cited in SEP entry "Walter Benjamin," section 6 (The Arcades Project): "The city was the seedbed of Benjamin's 'gothic' Marxism (Cohen 1993); Paris its testing ground." Cohen is the reference for characterizing Benjamin's Gothic Marxism and the surrealist origins of the Arcades Project.}
}

@article{jorgensen2014uses,
  author = {Jorgensen, Darren},
  title = {Uses of the Dialectical Image: Adorno, Surrealism, Breton, Benjamin},
  journal = {Continuum},
  year = {2014},
  volume = {28},
  number = {6},
  pages = {876--884},
  doi = {10.1080/10304312.2014.941328},
  note = {
  CORE ARGUMENT: Jorgensen traces the concept of the dialectical image
  across the uses made of it by Adorno, Breton, and Benjamin,
  arguing that the three figures employ the concept to different ends
  -- Adorno for immanent critique of the culture industry, Breton for
  the liberation of desire, and Benjamin for historiographic
  illumination. The article highlights the contested and plural
  character of the concept across the Frankfurt-surrealism axis.

  RELEVANCE: Provides a concise comparative treatment of how the
  dialectical image functions differently in Benjamin and Adorno,
  useful for the synthesis discussion of what distinguishes Benjamin's
  methodology from adjacent Frankfurt School positions.

  POSITION: Pluralist and comparative; resists reducing the dialectical
  image to any single theoretical program.
  },
  keywords = {dialectical-image, Adorno, surrealism, Breton, comparative, Medium},
  abstract = {Contemporary interpretations of Walter Benjamin's concept of the dialectical image tend to substitute object images, such as photographs, for subjective ones. In his own time, Benjamin's contemporaries Theodor Adorno and Andre Breton were suspicious of the role that objective images played in commodity capitalism. Adorno's Frankfurt School Marxism and Breton's Marxist surrealism illustrate the way that subjective images can be mobilized to think through the totality of capitalism rather than its products. This essay argues against the confusion of the dialectical image and its method with commodities.},
  abstract_source = {openalex},
}

@article{ross2020firstphilosophy,
  author = {Ross, Nathan},
  title = {Walter Benjamin's First Philosophy: Towards a Constellational Definition of Experience},
  journal = {Open Philosophy},
  year = {2020},
  volume = {3},
  number = {1},
  pages = {81--101},
  doi = {10.1515/opphil-2020-0006},
  note = {
  CORE ARGUMENT: Ross argues for the philosophical coherence of
  Benjamin's early work and its continuity with his later materialist
  methodology. Focusing on Benjamin's early program for a philosophy
  of experience, Ross shows that the "constellational" method of
  inquiry -- holding concepts together in tension rather than resolving
  them -- is present from the beginning and not merely a product of his
  Marxist turn. This grounds the later dialectical image in a sustained
  epistemological project.

  RELEVANCE: Provides the philosophical basis for understanding why
  Benjamin's historiographic method takes the form of constellation and
  image rather than systematic argument, situating the Arcades
  methodology in Benjamin's earliest philosophical commitments.

  POSITION: Argues for strong continuity between early and late Benjamin,
  against accounts that treat the dialectical image as a post-1924
  Marxist innovation discontinuous with his earlier metaphysical work.
  },
  keywords = {constellation, experience, early-Benjamin, method, continuity, Medium},
  abstract = {Abstract This essay argues for the philosophical standing of Walter Benjamin’s early work and posits a deeper continuity between this early work as a philosopher and the subsequent development of his work as a writer. When these fragments are read in proper relation to each other, they reveal for the first time many of the key innovations of Benjamin as a philosopher, as well as his points of influence on Horkheimer and Adorno. His early ‘Program’ critiques the Enlightenment conception of experience as a means for gaining empirical knowledge, and announces the need for a new concept of experience. Benjamin follows through on this program with a method of philosophical enquiry that is by turns fragmentary and constellational, developing a series of provisional notions of experience, which form a constellation with one another: perception, mimesis, language as a medium of experience, observation and memory.},
  abstract_source = {s2},
}

@article{vanreijen2001aura,
  author = {van Reijen, Willem},
  title = {Breathing the Aura -- The Holy, the Sober Breath},
  journal = {Theory, Culture \& Society},
  year = {2001},
  volume = {18},
  number = {6},
  pages = {31--50},
  doi = {10.1177/02632760122052039},
  note = {
  CORE ARGUMENT: Van Reijen traces the relationship between Benjamin's
  concepts of aura and dialectical image, arguing that the decline of
  the aura under modern conditions of mechanical reproduction is not
  merely an aesthetic loss but an epistemological transformation: the
  dialectical image takes the place of the aura as the medium through
  which historical truth becomes legible. Drawing on Goethe's
  diastole/systole and Holderlin's notion of sacred sobriety, he shows
  that Benjamin conceived awakening from aura as a condition of critical
  historical knowledge.

  RELEVANCE: Addresses the relationship between aura, image, and
  historical truth in Benjamin -- an underexplored connection relevant
  to understanding why the dialectical image emerges precisely as the
  aura declines and what historiographic work it is called upon to do.

  POSITION: Situates the dialectical image within Benjamin's philosophy
  of truth, connecting his epistemology to his aesthetic theory rather
  than treating the two as separate domains.
  },
  keywords = {aura, dialectical-image, truth, Goethe, historical-knowledge, Medium},
  abstract = {Benjamin's famous description of the aura in the `Small History of Photography' starts: `What is aura? A strange texture of space and time...', and ends with: `That means breathing the aura of these mountains and this branch'. Until now, the meaning of `breathing' has hardly been subject to interpretation. In this article it will be shown that Benjamin refers to Goethe's `diastole/systole', and to Hölderlin's concept of the unity of antagonistic dispositions, for example the paradoxical constellation of the sacred/sobriety ( das `heilig nüchterne'). To Benjamin `breathing' means the original, prehistorical, situation of harmony and peace. Together with the decline of bourgeois society, parallel to the development of a new technology in photography and film, the aura disappears. In its place we find the dialectical image ( `dialektisches Bild'). Benjamin tries to show that the decline of the aura is not just some aesthetic question, but that it is connected to the traditional philosophical problem of defining the truth and the relation between myth and rationality. Referring to Benjamin's cosmological speculations, as well as to his references to Baudelaire, it can be argued that, notwithstanding his lyrical description of the aura, Benjamin was in favour of the destruction of the aura. Under the conditions of a capitalist economy and a malfunctioning republic, a society which can be defined as `false', the traditional idea of aura, being the `shine' of a true society, cannot be taken for granted. The `dialectical image', showing that antagonistic forces hide behind a `shine' of unity and harmony, enables us to see that the traditional idea of truth is obsolete and to look for a new solution.},
  abstract_source = {openalex},
}

@article{ikkos2024nowtime,
  author = {Ikkos, George and Stanghellini, Giovanni and Morgan, Alastair},
  title = {History, `nowtime' (\textit{jetztzeit}) and Dialectical Images: Introduction to Walter Benjamin for Psychiatry (I)},
  journal = {International Review of Psychiatry},
  year = {2024},
  volume = {36},
  number = {6},
  pages = {585--599},
  doi = {10.1080/09540261.2024.2359468},
  note = {
  CORE ARGUMENT: The article introduces Benjamin's concepts of Jetztzeit
  (now-time), dialectical image, and literary montage to a psychiatric
  audience, providing one of the clearest available expositions of how
  the "now of recognizability" structures Benjamin's theory of historical
  knowledge. The authors situate these concepts in relation to Benjamin's
  broader social-historical and critical methodology, emphasizing the
  political and ethical implications of his account of historical time.

  RELEVANCE: Despite its psychiatric framing, this is a philosophically
  substantive introduction to the now-time/dialectical-image complex that
  is directly useful for the synthesis discussion of what Benjamin means
  by the "now of its recognizability" (Jetzt der Erkennbarkeit). The
  article's clarity on the temporal structure of the dialectical image
  makes it valuable for the overall review.

  POSITION: Primarily expository rather than polemical; follows
  Friedlander's interpretive line in treating the dialectical image as
  an epistemological category.
  },
  keywords = {jetztzeit, now-of-recognizability, dialectical-image, historical-time, Medium},
  abstract = {Abstract Considered by many the foremost German language literary critic of the first half of the 20th century, Walter Benjamin remains a star in our contemporary constellation of cultural criticism. His broad range of reference coupled with his dazzling linguistic versatility and radical understanding of technological transformation and its relation to society, continue to offer insights that help us respond better to the 21 century’s disorienting pace of innovation and change. Also, to measure the distance we have travelled since his contributions. Here we introduce aspects of his times, life, philosophical formation, and social-historical and critical work, including his use of literary montage and concepts of history, now-time (Jetztzeit), non-sensuous similarities, and dialectical images. Benjamin’s methodology and discoveries offer penetrating tools to any psychiatry which is truly committed to understanding culture beyond the conservative or descriptive ethnographic study of tradition in order to make sense of the nature and psychopathological impact of accelerating upheavals in our era of international conflict, climate change, social media, artificial intelligence and imperfect and threatened liberal pluralism. This era demands an approach open to co-creation and co-production and we discuss the relevance, including the limitations, of Benjamin’s work.},
  abstract_source = {s2},
}

@article{pujol2025phantasmagorias,
  author = {Pujol-Le\'on, Ernest},
  title = {Benjamin's Phantasmagorias: Socially Necessary Semblance and the Dialectical Image of Capital},
  journal = {South Atlantic Quarterly},
  year = {2025},
  volume = {124},
  number = {4},
  pages = {761--787},
  doi = {10.1215/00382876-11963104},
  note = {
  CORE ARGUMENT: Pujol-Leon argues that phantasmagoria -- not the
  dialectical image -- is the central concept of Benjamin's late Arcades
  work, grounded in his intensified reading of Marx's mature writings
  in the late 1930s. Phantasmagoria is interpreted as a category of
  social-aesthetic mediation intrinsically linked to capitalism's
  organization of historical consciousness; the dialectical image is then
  what disrupts phantasmagoric temporality by interrupting "empty time."

  RELEVANCE: Reframes the relationship between phantasmagoria and
  dialectical image in a way that bears directly on how the Arcades
  methodology relates to Marx's theory of ideology and commodity
  fetishism -- essential context for understanding the materialist
  dimension of Benjamin's historiographic method.

  POSITION: Argues for a late Marxist turn in Benjamin that grounds the
  dialectical image in the Marxian critique of political economy, against
  readings that emphasize messianism or surrealism as the primary frame.
  },
  keywords = {phantasmagoria, dialectical-image, capital, Marx, materialism, 2025, High},
  abstract = {This article contributes to recent value-theoretical efforts to ground capitalist mystification in its social structure by reconstructing WalterBenjamins late work on phantasmagoria. Following Benjamin’s theoretical trajectory, the author examines his systematic attempt to theorize ideology through its phenomenal forms of appearance. Though often treated as a merely psychological category, phantasmagoria emerged in the late 1930s as the central concept of Benjamin’s work through his intensified engagement with Marx’s mature writings and Karl Korschs commentaries. Contextualizing this crucial turn in Benjamin’s thought, this article interprets phantasmagoria as a category of social-aesthetic mediation, intrinsically linked to capitalism’s social logic and organization of temporality and historical consciousness. This interpretation, which grounds Benjamin’s work in the Marxian problematic of critical representation or Darstellung, sheds new light on his more well-known views on history and capitalist modernity. The article contends that it was only through his late encounter with Marx and Korsch that Benjamin came to see revolution as an interruption of the capitalist phantasmagorias of empty time and civilizational progress.},
  abstract_source = {s2},
}

@article{villegasvelez2019allegory,
  author = {Villegas V\'elez, Daniel},
  title = {Allegory, Noise, and History: the \textit{Arcades Project} Looks Back at the \textit{Trauerspielbuch}},
  journal = {New Writing},
  year = {2019},
  volume = {16},
  number = {4},
  pages = {429--432},
  doi = {10.1080/14790726.2019.1567795},
  note = {
  CORE ARGUMENT: Villegas Velez examines the relationship between the
  Arcades Project and the Trauerspiel book, arguing (following Benjamin's
  own claim in Konvolut N) that both texts share a rejection of
  period-based historiography. The article focuses on the sonorous
  dimension of the dialectical image, exploring how allegory, noise, and
  fragmentation function as shared formal-methodological resources across
  Benjamin's two major works.

  RELEVANCE: Addresses the internal methodological continuity of
  Benjamin's practice -- specifically the claim in Konvolut N that the
  Arcades Project extends the method of the Trauerspiel book -- which is
  important for understanding the formal status of montage and allegory
  in Benjamin's historiography.

  POSITION: Emphasizes formal and methodological continuity between
  early and late Benjamin, contributing to debates about the coherence
  of his philosophical project.
  },
  keywords = {allegory, Trauerspiel, Arcades-Project, Konvolut-N, method-continuity, Medium},
  abstract = {ABSTRACT In Convolute N, Benjamin claims that both the Arcades Project and the Trauerspielbuch reject a historiography based on the notion of periods of decline. Reflecting on the sonorous dimension of the dialectical image as presented in Convolute N, I suggest allegory as another link between the two works, which I explore in connection to sound and noise through an example from Monteverdi’s Orfeo while remarking on the role of sound in Benjamin.},
  abstract_source = {s2},
}

@article{fan2024antiquity,
  author = {Fan, Jiani},
  title = {Antiquity and Modernity at a Standstill: Interpreting Walter Benjamin's Allegorical Image and Dialectical Image Through Charles Baudelaire},
  journal = {Cowrie: Comparative and World Literature},
  year = {2024},
  volume = {1},
  number = {1},
  pages = {170--182},
  doi = {10.1515/cwl-2024-2005},
  note = {
  CORE ARGUMENT: Fan traces how Benjamin moves from allegory (figured
  as melancholic, backward-looking) to the dialectical image (figured as
  potentially awakening) in his two interpretive attempts on Baudelaire's
  poems "The Swan" and "To a Woman Passing By." The dialectical image
  is shown to replace melancholic allegory as a method for producing
  awakening from capitalist phantasmagoria, though Fan argues that
  Benjamin's dialectical images remain limited by their focus on
  consciousness-transformation rather than material revolution.

  RELEVANCE: Traces the transition from allegory to dialectical image in
  Benjamin's work on Baudelaire, directly relevant to understanding how
  the two concepts relate and what the dialectical image is supposed to
  accomplish that allegory cannot.

  POSITION: Critically sympathetic: accepts Benjamin's analysis while
  arguing from an orthodox Marxist standpoint that the dialectical image
  is insufficient as a political category because it is confined to the
  transformation of mass consciousness.
  },
  keywords = {allegory, dialectical-image, Baudelaire, awakening, standstill, 2024, Medium},
  abstract = {Abstract In the preliminary schematization of the Arcades Project, Walter Benjamin conceived the title “Antiquity and Modernity” for the second part of the book. In his unpublished paper “Introduction to Charles Baudelaire: A Lyric Poet in the Era of High Capitalism,” Michael Jennings asserts that the second part of the book on Baudelaire develops, as a formal element of allegorical perception, the “dissolve” through which antiquity comes to light in modernity and modernity in antiquity. In Baudelaire’s terms, nothing in his own century comes closer to the task of the hero of antiquity than the task of giving form to modernity. This paper investigates how Walter Benjamin, by interpreting Baudelaire’s two poems—“The Swan” and “To a Woman Passing By”—processed a symptomatic diagnosis of modernity and attempted different methods of salvation for modernity. In the first attempt, Benjamin resorts to the allegorical images of ancient myths to break through the projection of the linear chain of historical progress, but he suffers from a sense of incurable melancholy and nostalgia due to the irretrievable ancient grandeur in modernity. In the second attempt, he replaces these melancholic allegories with dialectic images in the hope of awakening the masses from the Capitalist phantasmagoria. Nevertheless, from a fundamentalist Marxist point of view, Walter Benjamin’s mystification of Marxist dialectics and his revised Marxism focus mainly on the transformation of consciousness. It is thus arguable that Benjamin distorted and reversed the hierarchy of superstructure and economic base in the orthodox Marxist historical materialism. More regrettably, Benjamin’s dialectic image pales into insignificance due to its confinement within the transformation of mass consciousness and its renouncement of revolution in the economic and production realms.},
  abstract_source = {s2},
}

@article{andre1998aphrodite,
  author = {Andre, Chris},
  title = {Aphrodite's Children: Hopeless Love, Historiography, and Benjamin's Dialectical Image},
  journal = {SubStance},
  year = {1998},
  volume = {27},
  number = {1},
  pages = {105--128},
  doi = {10.2307/3685719},
  note = {
  CORE ARGUMENT: Andre examines the constellation of esoteric love,
  historical method, language, and the dialectical image in both the
  Trauerspiel study and the "Theses on the Philosophy of History,"
  arguing that Benjamin's reflection on surrealism is oriented toward
  constructing a model of historical analysis in which language is
  treated as a historical form of cultural expression. The dialectical
  image is read as a means of avoiding both the aestheticization of
  image-culture and the supremacy of the visual image as the totality
  of human experience.

  RELEVANCE: An early English-language article to treat the dialectical
  image as a specifically historiographic category across Benjamin's
  major texts, connecting the Trauerspiel and the Theses rather than
  treating them as separate works.

  POSITION: Situates the dialectical image within Benjamin's philosophy
  of language and his account of historical experience, rather than
  within his politics or his materialism.
  },
  keywords = {dialectical-image, historiography, language, surrealism, Trauerspiel, Low},
  abstract = {Etude de la conception de l'amour, de la production des images poetiques et des theories de l'historiographie developpees par W. Benjamin dans le sens de formes particulieres et analogues de la conscience moderne. Examinant la constellation de l'amour esoterique, de la methode historique, du langage et de l'image dialectique dans l'etude sur «Les origines de la tragedie allemande» (1925) et dans les «Theses sur la philosophie de l'histoire» (1940), l'A. montre que la reflexion de Benjamin sur le surrealisme est orientee vers la construction d'un modele pour son analyse historique de la culture occidentale moderniste, ou le langage doit etre consedere comme une forme historique de l'expression culturelle et de l'experience sociale, evitant a la fois la tendance a l'esthetisation de la culture de l'image et la suprematie de l'image visuelle comme totalite de l'experience humaine},
  abstract_source = {openalex},
}

@article{bohn2019historiography,
  author = {Bohn, Charlotte Odilia},
  title = {Historiography and Remembrance: On {Walter Benjamin}'s Concept of {Eingedenken}},
  journal = {Religions},
  year = {2019},
  volume = {10},
  number = {1},
  pages = {40},
  doi = {10.3390/REL10010040},
  abstract = {Engaging with Walter Benjamin's concept of Eingedenken (remembrance), this article explores the pivotal role that remembrance plays in his attempt to develop a radically new vision of history, temporality, and human agency. Building on his essay "On Some Motifs in Baudelaire" and on his last written text, "Theses on the Philosophy of History," it will trace how memory and historiography are brought together in a curious fusion of materialist and messianic thinking. Emerging from a critique of modernity and its ideology of progress that is cast as crisis, the practice of remembrance promises a "way out." Many of Benjamin's secular Marxist critics such as Max Horkheimer and Rolf Tiedemann denied the political significance of Eingedenken, dismissing it as theological or banishing it to the realm of aesthetics. Rejecting this critique, the author suggests that the radical ethical aspects of Eingedenken can be grasped only once the theological dimension is embraced in its own right and that it is in precisely this blend of materialist and messianic thought that revolutionary hope may be found.},
  note = {
  CORE ARGUMENT: Bohn argues that Eingedenken is not merely an aesthetic or theological supplement to Benjamin's materialism but is itself the site where materialist and messianic thought fuse into a politically and ethically significant historiographic practice. Against critics like Tiedemann who see the theological dimension as undermining the political, she contends that the theological remainder is precisely what gives Eingedenken its redemptive, counter-ideological force.

  RELEVANCE: Directly addresses the central question of whether Eingedenken can bear the weight Benjamin places on it as a historiographic category; engages the Horkheimer-Tiedemann critique that Benjamin's theology is incompatible with historical materialism. Essential for understanding debates about the unity of Benjamin's late philosophy.

  POSITION: Defends the inseparability of materialist and messianic dimensions in Benjamin's concept of remembrance, against purely secular-political readings.
  },
  keywords = {Eingedenken, remembrance, historiography, messianism, materialism, High}
}

@article{lindroos2001scattering,
  author = {Lindroos, Kia},
  title = {Scattering Community: {Benjamin} on Experience, Narrative and History},
  journal = {Philosophy \& Social Criticism},
  year = {2001},
  volume = {27},
  number = {6},
  pages = {19--41},
  doi = {10.1177/019145370102700602},
  note = {
  CORE ARGUMENT: Lindroos examines Benjamin's analysis of the fragmentation of communal experience in modernity, focusing on the "The Storyteller" essay's account of how the decline of Erfahrung dissolves the narrative bonds of community into scattered, private Erlebnis. She argues that Benjamin develops a historiography of fragments that preserves the traces of communal experience without nostalgically reconstructing it.

  RELEVANCE: Directly addresses the Erfahrung/Erlebnis distinction in relation to community, narrative, and historical agency; connects Benjamin's cultural diagnosis to his historiographical practice of collecting and redeeming fragments.

  POSITION: Reads Benjamin's account of experiential decline as the basis for a critical historiography that works through fragments rather than totalizing narratives.
  },
  keywords = {Erfahrung, Erlebnis, storyteller, narrative, community, High},
  abstract = {In discussing the cultural history of the 19th century, Walter Benjamin diagnosed the emergence of the modern novel and its form of narration as the sign of a fracturing experience. The split in experience is related to the scattering of a homogeneous idea of space and time, constituted especially during the Enlightenment and in the German historicism. Benjamin's claim reflected the fracturing temporality of modern communities as well as the transformations in the understanding of the meaning of tradition. Here, I begin by discussing Benjamin's conceptions of experience and memory in detail. Secondly, I consider his ideas on history in the framework of challenging the new forms of narration. In the end, I consider the loss of a unified community, especially by indicating ways in which the after-modern community reflects the relationship between aesthetics and politics in Jean-François Lyotard's thought.},
  abstract_source = {openalex},
}

@article{elsaesser2009erlebnis,
  author = {Elsaesser, Thomas},
  title = {Between {Erlebnis} and {Erfahrung}: Cinema Experience with {Benjamin}},
  journal = {Paragraph},
  year = {2009},
  volume = {32},
  number = {3},
  pages = {292--312},
  doi = {10.3366/E0264833409000625},
  note = {
  CORE ARGUMENT: Elsaesser uses Benjamin's Erfahrung/Erlebnis distinction to analyze cinema spectatorship, arguing that the cinema offers Erlebnis without Erfahrung -- an intense perceptual-somatic event that lacks the integrative, narrated dimension of accumulated experience. This is not simply deficient: Benjamin's framework reveals cinema as the art form corresponding to modernity's shock-structured experience.

  RELEVANCE: While focused on cinema, the essay provides a careful reconstruction of the Erfahrung/Erlebnis distinction and its connection to Benjamin's analysis of shock, aura, and modernity; useful for understanding how the conceptual pair functions across Benjamin's writings on Baudelaire, technology, and media.

  POSITION: Applies the experience-distinction to film theory, emphasizing the continuity between Benjamin's Baudelaire essays and his media philosophy.
  },
  keywords = {Erfahrung, Erlebnis, cinema, shock, modernity, Medium},
  abstract = {The ‘turn’ to emotion and affect in film and media studies may take its distance from earlier ways of understanding spectatorial involvement (modelled on psychoanalytic notions of identification). But such approaches, whether cognitivist in intent, or inspired by phenomenology, also return to an earlier interest in bodily sensations and somatic responses when exposed to sudden motion and moving images (associated with ideas such as innervation, shock and over-stimulation). The essay proposes to bring Walter Benjamin into the debate, with a term central to his idea of modernity, namely ‘experience’, and to revive his distinction between Erfahrung and Erlebnis. Noting certain features of excess and liminiality in contemporary cinema, and mapping them across the three distinct domains of body, time and agency, Benjamin's own attempt to locate the emotional core of the technical media is reappraised. Grounded in the peculiar variability but also interdependence of place, narration and perception, the cinema would then appear to provide Erlebnis without Erfahrung, a state formerly associated with trauma, but now the very definition of the media event.},
  abstract_source = {openalex},
}

@article{jessop2013children,
  author = {Jessop, Sharon},
  title = {Children, Redemption and Remembrance in {Walter Benjamin}},
  journal = {Journal of Philosophy of Education},
  year = {2013},
  volume = {47},
  number = {4},
  pages = {642--657},
  doi = {10.1111/1467-9752.12046},
  note = {
  CORE ARGUMENT: Jessop argues that Benjamin's account of childhood in Berlin Childhood and elsewhere grounds a connection between childhood experience and the possibility of redemption: the child's mode of perception -- mimetic, non-instrumental, open to correspondences -- models the kind of remembrance that can rescue the past from triumphalist history. Remembrance reactivates a childlike openness to the world that modernity suppresses.

  RELEVANCE: Connects the remembrance-redemption complex to Benjamin's philosophy of experience through the concept of childhood; shows how Eingedenken is not only an intellectual or historiographic operation but depends on a particular phenomenology of perception and recognition.

  POSITION: Reads Benjamin's pedagogy and philosophy of childhood as a foundation for his theory of redemptive remembrance.
  },
  keywords = {childhood, redemption, remembrance, mimesis, pedagogy, Medium},
  abstract = {Walter Benjamin wrote extensively on children and childhood, though this aspect of his work has hitherto received scant attention despite continuing and growing interest in his thought. This article makes explicit the connection between his acute observations of childhood and his distinctive messianic philosophy. The twin aspects of redemption in Benjamin's writings: remembrance and now-time, as illustrated in Wim Wender's Wings of Desire, are explored in relation to the ‘task of childhood’. Benjamin asserts the emancipatory potential held within the development of historical consciousness, and leads us to question how our understanding of childhood can foster this potential},
  abstract_source = {openalex},
}

@article{palermo2011hilo,
  author = {Palermo, S.},
  title = {El hilo sutil de la rememoración. Felicidad y redención histórica en la obra de {Walter Benjamin}},
  journal = {Isegoría},
  year = {2011},
  pages = {575--594},
  doi = {10.3989/ISEGORIA.2011.I45.743},
  abstract = {This paper presents an analysis of the structure of the Messianic time that Benjamin tries to think from the point of view of its inextricable connection to the concepts of happiness and redemption. The conceptual route goes from the early writings, in which the constellation happiness-redemption acquires a definite physiognomy -- combining with an elegant and specific critique of modernity -- to the thesis Uber den Begriff der Geschichte, in which this constellation is intertwined with the figure of Eingedenken, which determines an important conceptual shift in the theoretical horizon of the author.},
  note = {
  CORE ARGUMENT: Palermo traces the development of the concepts of happiness and redemption from Benjamin's early writings through the "Theses on the Philosophy of History," arguing that the figure of Eingedenken marks a decisive conceptual shift: messianic time is no longer an eschatological event but a structure activated by remembrance itself, linking the happiness of the remembered to the possibility of historical redemption.

  RELEVANCE: Provides a genealogical account of how Benjamin's concept of redemption becomes articulated through Eingedenken specifically in his late work; important for understanding the "every second the small gate" claim in Thesis XVIII.

  POSITION: Argues for developmental continuity in Benjamin's messianism, with Eingedenken as the late synthesis.
  },
  keywords = {Eingedenken, messianism, happiness, redemption, Theses, High}
}

@article{alias2023escatologico,
  author = {Alías, Antonio},
  title = {El resto escatológico de la {Eingedenken} benjaminiana},
  journal = {HUMAN Review. International Humanities Review / Revista Internacional de Humanidades},
  year = {2023},
  volume = {18},
  number = {5},
  pages = {1--8},
  doi = {10.37819/revhuman.v18i5.1658},
  abstract = {This essay addresses the conceptualization process of Benjamin's remembrance [Eingedenken], understood by the German thinker as a critical exercise on an idea of history that, since Hegel, has been assimilated to progress as the guiding principle of modern societies. Thus, by taking different epistemological assumptions, Walter Benjamin seeks in memory a new historical time to come, activated dialectically by certain messianism as an eschatological remainder in the field of a modern secularization.},
  note = {
  CORE ARGUMENT: Alías argues that Eingedenken functions as an "eschatological remainder" (resto escatológico) within Benjamin's secular-materialist philosophy: even after the secularization of theological categories, a residual messianic structure persists in the dialectics of remembrance, preventing historical time from collapsing into mere progressivism.

  RELEVANCE: Engages the question of how much theological content survives Benjamin's materialist transformation, specifically with respect to remembrance; contributes to the debate between theological and secular readings of Eingedenken.

  POSITION: Defends a weak messianism interpretation in which eschatological structure is preserved as a formal remainder, not a substantive theological commitment.
  },
  keywords = {Eingedenken, eschatology, secularization, messianism, modernity, Medium}
}

@article{llorens2018memoria,
  author = {Llorens, M.},
  title = {La memoria involuntaria: {Marcel Proust} y el descubrimiento poético del interior. Un análisis desde la perspectiva filosófica de {Walter Benjamin}},
  journal = {Areté},
  year = {2018},
  volume = {30},
  number = {2},
  pages = {305--331},
  doi = {10.18800/ARETE.201802.006},
  abstract = {In this article, we undertake, from the perspective of Walter Benjamin's philosophical work, the phenomenon of involuntary memory discovered by Marcel Proust in the writing process of In Search of Lost Time (1908-1922). In the analysis the following approaches are developed: the relation between oblivion and memory (from Sigmund Freud, Henri Bergson and Charles Baudelaire), the poetic discovery of involuntary memory (in relation to the qualities of profane illumination), the conditions for the revelation of mnemic images -- images of the inner world -- (the ancient and medieval predecessors and the surrealist contemporaries), the recovery of the lost time and of the narration in the novel, and the auratic character of the involuntary memory's images.},
  note = {
  CORE ARGUMENT: Llorens reconstructs Benjamin's reading of Proustian involuntary memory through a wide set of philosophical interlocutors (Freud, Bergson, Baudelaire) and argues that involuntary memory, for Benjamin, is the paradigmatic instance of "profane illumination" -- a moment in which a past image breaks into the present with auratic intensity, offering a template for the historiographic practice of Eingedenken.

  RELEVANCE: The Proust essay is crucial for understanding Benjamin's concept of involuntary memory and its relation to historiography; this article carefully situates Benjamin's reading within his broader theory of experience, aura, and profane illumination, connecting the literary analysis to the philosophy of history.

  POSITION: Reads Benjamin's Proust essay as a philosophical staging ground for the theory of historiographic remembrance that culminates in the "Theses."
  },
  keywords = {Proust, involuntary memory, Erfahrung, profane illumination, aura, High}
}

@article{bielsa2022baudelaire,
  author = {Bielsa, Esperança},
  title = {{Benjamin}'s {Baudelaire}: Translation and Modern Experience},
  journal = {Journal of Classical Sociology},
  year = {2022},
  volume = {24},
  number = {2},
  pages = {111--129},
  doi = {10.1177/1468795X221097001},
  note = {
  CORE ARGUMENT: Bielsa examines Benjamin's translations of Baudelaire alongside his theoretical essays, arguing that the practice of translation and the theory of modern experience are inseparable: translation for Benjamin models the redemptive transfer of experience across temporal and linguistic gaps, and Baudelaire's poetry models the shock-saturated, auratic-less Erlebnis of the modern crowd. The translator and the historian share a similar redemptive vocation.

  RELEVANCE: Connects Benjamin's philosophy of experience (Erfahrung/Erlebnis distinction) to his practice of translation, demonstrating how these projects are philosophically unified; also addresses the decline of aura and the new kind of experience (Chockerlebnis) that emerges in industrial modernity.

  POSITION: Emphasizes the practical-philosophical unity of Benjamin's Baudelaire project and its implications for understanding experience and redemption.
  },
  keywords = {Baudelaire, translation, Erfahrung, Erlebnis, shock, modernity, Medium},
  abstract = {This article focusses on Walter Benjamin’s approach to the experience of modernity through his long-term engagement with the poetry of Charles Baudelaire. Benjamin translated Baudelaire and produced a theoretical reflection on translation based on this experience in his essay ‘The Task of the Translator’. Years later, he would place Baudelaire at the centre of his attempt to reconstruct the prehistory of modernity in his great unfinished work The Arcades Project. This article brings to light the relationship between translating and interpreting Baudelaire in Benjamin’s work, attempting to recover a systematicity in his thought that escapes from traditional disciplinary borders. In order to do so, it reads Benjamin’s essay on ‘The Task of the Translator’ in light of major issues that can only be clarified with reference to his later adoption of historical materialism and, conversely, it approaches Benjamin’s interpretation of Baudelaire as the writer of modern life as a revision of philosophical concerns that were first approached in his metaphysics of language and translation. A concluding section explores how such an interpretation relates to a materialist physiognomics which puts language and translation at the heart of a critique of modernity.},
  abstract_source = {s2},
}

@article{losiggio2018subjetividad,
  author = {Losiggio, Daniela},
  title = {El problema de la subjetividad en la obra de {Walter Benjamin}: consciencia y rememoración},
  journal = {Agora: papeles de Filosofía},
  year = {2018},
  volume = {37},
  pages = {77--98},
  doi = {10.15304/AG.37.2.4171},
  abstract = {The approach of Benjaminian criticism to the concept of history is linked to a question about the role of the subject and the possibilities for the transformation of the present. In Benjamin's work, subjectivity is, sometimes, connected to the collective unconscious (through the influence of S. Freud); on other occasions, to the Marxist awareness (through the inheritance of G. Lukacs); finally, to the idea of remembrance (Eingedenken). Studying the early theory of knowledge in Benjamin's work, we will seek to illuminate the emergence of the concept of "remembrance" in late works. We will argue that this notion contains the problem of subjectivity in the new theoretical context.},
  note = {
  CORE ARGUMENT: Losiggio traces the problem of historical subjectivity in Benjamin from his early epistemology through his late engagement with Freud, Lukács, and finally Eingedenken, arguing that remembrance is Benjamin's resolution to the question of how a subject can be the agent of historical transformation while remaining embedded in unconscious and collective structures.

  RELEVANCE: Addresses the connection between Benjamin's theory of knowledge, his account of subjectivity, and Eingedenken; important for understanding how individual involuntary memory connects to collective historical agency in his philosophy of history.

  POSITION: Reads Eingedenken as Benjamin's late answer to the problem of historical subjectivity, synthesizing his epistemological and political concerns.
  },
  keywords = {Eingedenken, subjectivity, historical materialism, Freud, Lukacs, Medium}
}

@book{pensky1993melancholy,
  author = {Pensky, Max},
  title = {Melancholy Dialectics: {Walter Benjamin} and the Play of Mourning},
  publisher = {University of Massachusetts Press},
  year = {1993},
  note = {
  CORE ARGUMENT: Pensky offers a sustained analysis of the concept of melancholy in Benjamin, arguing that melancholy is not simply a psychological condition but a dialectical epistemic stance -- a mode of knowing that dwells on the ruin and fragment in order to redeem them. Drawing on the Trauerspiel book, the Baudelaire essays, and the Theses, Pensky reconstructs melancholy as Benjamin's characteristically modern form of historical consciousness, one that refuses consolation while remaining open to messianic interruption.

  RELEVANCE: The book addresses the constellation of allegory, mourning, and historical experience at the heart of this domain; "Melancholy Dialectics" is widely cited as a key account of how loss, mourning, and the ruin of experience function in Benjamin's philosophy of history.

  POSITION: Interprets melancholy as a productive epistemic-historical posture rather than a pathology, linking the Trauerspiel's allegory to the late philosophy of history.
  },
  keywords = {melancholy, mourning, allegory, Trauerspiel, dialectics, High, INCOMPLETE, no-abstract}
}

@book{friedlander2012portrait,
  author = {Friedlander, Eli},
  title = {{Walter Benjamin}: A Philosophical Portrait},
  publisher = {Harvard University Press},
  year = {2012},
  note = {
  CORE ARGUMENT: Friedlander reads Benjamin as a unified philosophical thinker whose diverse writings are organized around the concepts of image, language, time, and remembrance. The book argues that "rescue" (Rettung) and "remembrance" are not peripheral but central to Benjamin's philosophical project: the task of philosophy is to rescue past appearances by finding the constellation in which they become legible. This is linked to Benjamin's account of involuntary memory, dream, and the "now of recognizability."

  RELEVANCE: Provides the most philosophically systematic English-language account of how rescue and remembrance function in Benjamin's overall project; addresses the connections among Proust, the dialectical image, and the philosophy of history that are central to this domain.

  POSITION: Defends a philosophical-systematic reading of Benjamin that emphasizes the unity of his writings around a theory of truth as historical appearing.
  },
  keywords = {rescue, remembrance, image, language, philosophical portrait, High},
  abstract = {Is concern with Walter Benjamin a form of political activism? Should it be? This question has divided commentators since the 1960s, when Benjamin served not only as a banner for the student revolt, but also -- in direct contrast -- as a model for the sober scholarship gradually returning to the German universities.
  abstract_source = {ndpr},

Undoubtedly the latter view has prevailed, if only in the sense that Benjamin today is a staple of the Ph.D. industry. Steiner's book, which in essence is a chronological catalogue of Benjamin'soeuvre, rather confirms this. There is nothing wrong with this, in principle. Certainly there is only a limited amount of mileage to be extracted from Benjamin's career as a martyr, moving though it may be. And his work provides little direct guidance for the class struggle.

Despite this, criticism of the universities, or more generally of intellectual practice in general, underlies Benjamin's whole project. From our perspective, it is not just the oft-lamented failure of Frankfurt University to recognise Benjamin's talents which need concern us. German universities were at the forefront of the whole Nazi "movement", as indeed were other major components of public culture including the legal system and even, in part, the Churches. All these institutions, little changed, still exist. Is it possible to do justice to Benjamin's work without raising questions which bear directly on modern academic life? This is an issue which Steiner, consistent with the sober approach taken by his book, does not pursue. Related topics which have to be mentioned because of their prominence in Benjamin's work, such as the "Strategist in the Literary Struggle", are firmly consigned to scare quotes. At the end of his book, when Steiner raises the question of Benjamin's "relevance", he rather despairingly finds it in the fact that academics seem forever able to discover "new and hitherto overlooked aspects in his oeuvre".

This strikes me as a little disappointing, and it certainly raises the question of what Steiner might have missed in his subject. If one thing is missing in Steiner's basically thorough account, it is not the leftist political background, which he explains quite fully, but something rather different, namelytheology. Benjamin regularly appeals to themes from "theology". He did not define what he meant by this term, except indirectly in the famous first Thesis on the Philosophy of History, where theology is the master dialectician whose resources enable politically progressive standpoints ("historical materialism") to prevail in argument. This master, Benjamin concedes, is a dwarf who is "small and ugly, and cannot allow himself to be seen".

Theology, for Benjamin, is the form of analysis which can identify the primary ideological underpinning of a social and economic system. In that sense it is able to make good claims which "historical materialism", left to itself, cannot do. But obviously "theology" isn't "historical materialism". So what is it?

One way of understanding the term is to emphasise the attribute of concealment. Theology, by that account, is the esoteric, the concealed, the elite. "Even though the esoteric cannot determine the practical implementation of learning, nonetheless learning's laws of form and content inevitably appear to great researchers as theologically determined", Benjamin noted in his sketches forOne-Way Street(Steiner quotes this passage with approval).Benjamin's model for this esotericism seems to have been the George circle, according to which the unacknowledged leaders of progress were the poets and artists, protected from the baser elements of life by a devoted coterie of disciples.

Benjamin undoubtedly felt some sympathy for the esoteric, if only in the sense that the profundity and opacity of his own work made few concessions to the casual reader. To set this at the heart of his thinking would be wrong, however. The connection between theology and the esoteric is fortuitous. However much Benjamin may have valued certain aspects of the George circle's work, he regarded it as politically entirely reactionary.

The second manifestation of "theology" in Benjamin's thinking is what might be called the millenarian aspect. Millenarianism, at least in the context of the early twentieth century, was the notion that a thousand-year New Order was about to arrive, led either by the Aryan race or by the proletariat, according to taste. One relatively sophisticated application of this was Carl Schmitt's argument that the true sovereign was he who ruled over the emergency, revolutionary emergencies being the lawless and formless instant from which the genuinely new proceeded. Benjamin's own take on this was, by contrast, nihilistic. For him, the hiatus was to arise by means of humankind's "pulling the emergency cord" and turning its back on history altogether. The epistemology associated with this plays a prominent part in Benjamin's work, whether it be the notion of reading history against the grain, of dialectical instants, or of the "leap under the open skies of history". Benjamin valued Schmitt's work, particularly the notion of the revolutionary instant, which he linked with his own insistence on the "extreme" as the point at which truth becomes manifest.},
}

@article{de2025comic,
  author = {De, Soumick},
  title = {Comic Intelligence and Its Anarchic Origins in Modernity},
  journal = {Kritike: An Online Journal of Philosophy},
  year = {2025},
  doi = {10.25138/19.1.a3},
  abstract = {This paper examines what constitutes comic thinking in light of Agnes Heller's understanding of freedom in modernity. Taking as the point of departure Walter Benjamin's famous distinction between two types of experience of reality in the modern world -- the short-term experience of Erlebnis and the long-term Erfahrung -- the paper connects their relation to the concept of the comic in Charles Baudelaire and Henri Bergson.},
  note = {
  CORE ARGUMENT: De uses Benjamin's Erfahrung/Erlebnis distinction as a diagnostic framework for analyzing the concept of the comic in modernity, arguing that Erlebnis and Erfahrung generate two different types of comic response (Bergson's mechanical comedy vs. Baudelaire's more complex engagement with modernity's anarchic freedom). Benjamin's distinction illuminates how comedy itself is structured by modern experiential fragmentation.

  RELEVANCE: Illustrates the continued productivity of the Erfahrung/Erlebnis distinction for analyzing cultural phenomena in modernity; the article extends the reach of Benjamin's experiential categories and confirms their centrality to understanding his broader cultural theory.

  POSITION: Applies the Erfahrung/Erlebnis distinction to aesthetic theory of comedy, demonstrating the framework's wider philosophical reach.
  },
  keywords = {Erfahrung, Erlebnis, comedy, Baudelaire, modernity, Low}
}

@book{scholem1981benjamin,
  author = {Scholem, Gershom},
  title = {Walter Benjamin: The Story of a Friendship},
  year = {1981},
  publisher = {Review Books},
  address = {New York},
  note = {
  CORE ARGUMENT: Scholem's memoir of his forty-year friendship with Benjamin argues that the "real" Benjamin was a Jewish religious thinker whose deepest impulses were theological and mystical. Scholem portrays Benjamin's Marxism -- particularly his relationship with Brecht -- as a misguided and ultimately fatal detour, and reads the messianic theology of the Theses as the culmination of Benjamin's authentic intellectual trajectory rooted in Jewish mysticism and linguistic philosophy.

  RELEVANCE: This is the foundational document for the theological-messianic reading of Benjamin's philosophy of history and constitutes one pole of the Scholem-Adorno debate. Any account of how messianism shapes Benjamin's eschatology must engage with Scholem's reading; it also provides biographical context for the intellectual relationships (to Brecht, to Adorno) that inflect interpretation of the Theses.

  POSITION: Represents the theological-messianic reading pole, arguing for the priority of kabbalistic and Jewish messianic traditions in Benjamin's thought.
  },
  keywords = {Benjamin-Scholem-relationship, Jewish-messianism, theological-reading, intellectual-biography, High},
