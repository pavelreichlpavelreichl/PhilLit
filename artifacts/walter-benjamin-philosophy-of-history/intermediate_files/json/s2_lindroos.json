      "paperId": "e73fca16d6c90bda374de7b4b2811562cd1046dd",
      "title": "Searching for Entanglement: Roma and Jews in Dismembered Czechoslovakia during World War II",
      "authors": [
        {
          "name": "Kate\u0159ina \u010capkov\u00e1",
          "authorId": "2391253849"
        },
        {
          "name": "Benjamin Frommer",
          "authorId": "2391256897"
        },
        {
          "name": "Michala Jand\u00e1k L\u00f4n\u010d\u00edkov\u00e1",
