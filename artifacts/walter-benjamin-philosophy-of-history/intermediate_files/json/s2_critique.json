    {
      "paperId": "f21ed9307da9e6086790c3192f715c657a6f24a0",
      "title": "Liberalism\u2019s All-inclusive Promise of Freedom and its Illiberal Effects: A Critique of the Concept of Globalization",
      "authors": [
        {
          "name": "Constanze Demuth",
          "authorId": "2080877549"
        }
      ],
