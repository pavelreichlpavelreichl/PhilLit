      "doi": "10.12681/eadd/36333",
      "title": "\u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03b9\u03ba\u03ad\u03c2 \u03b5\u03be\u03b5\u03bb\u03af\u03be\u03b5\u03b9\u03c2 \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u03c4\u03ad\u03c4\u03b1\u03c1\u03c4\u03bf \u03c4\u03bf\u03c5 20\u03bf\u03c5 \u03b1\u03b9\u03ce\u03bd\u03b1",
      "authors": [
        {
          "name": "\u0391\u03b3\u03b3\u03b5\u03bb\u03b9\u03ba\u03ae \u039a\u03bf\u03c5\u03c6\u03bf\u03cd",
          "openalex_id": "A5097636339"
        }
      ],
      "publication_year": 2015,
      "publication_date": "2015-05-01",
      "abstract": "\u0397 \u03b4\u03b9\u03b1\u03c4\u03c1\u03b9\u03b2\u03ae \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b5\u03cd\u03b5\u03c4\u03b1\u03b9 \u03c4\u03bf \u03b5\u03c0\u03af\u03bc\u03b1\u03c7\u03bf \u03b6\u03ae\u03c4\u03b7\u03bc\u03b1 \u03c4\u03b7\u03c2 \u03b3\u03bb\u03c9\u03c3\u03c3\u03b9\u03ba\u03ae\u03c2 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03c4\u03b7\u03bd \u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1, \u03ad\u03bd\u03b1 \u03b6\u03ae\u03c4\u03b7\u03bc\u03b1 \u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03b1\u03c0\u03bf\u03c4\u03ad\u03bb\u03b5\u03c3\u03b5 \u03c0\u03b5\u03b4\u03af\u03bf \u03b4\u03b9\u03b1\u03bc\u03b1\u03c7\u03ce\u03bd \u03ba\u03b1\u03b9 \u03b1\u03bd\u03c4\u03b9\u03c0\u03b1\u03c1\u03b1\u03b8\u03ad\u03c3\u03b5\u03c9\u03bd \u03bc\u03b5\u03c4\u03b1\u03be\u03cd \u03c4\u03c9\u03bd \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ce\u03bd, \u03ba\u03b1\u03c4\u03ac \u03c4\u03bf \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03bf \u03c4\u03ad\u03c4\u03b1\u03c1\u03c4\u03bf \u03c4\u03bf\u03c5 \u03b5\u03b9\u03ba\u03bf\u03c3\u03c4\u03bf\u03cd \u03b1\u03b9\u03ce\u03bd\u03b1. \u03a0\u03c1\u03cc\u03ba\u03b5\u03b9\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03bc\u03b9\u03b1 \u03c0\u03b1\u03c1\u03b1\u03b4\u03b5\u03b9\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bc\u03b5\u03c4\u03b1\u03b2\u03bf\u03bb\u03ae \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03c4\u03b5\u03bb\u03ad\u03c3\u03c4\u03b7\u03ba\u03b5 \u03c3\u03c4\u03bf\u03bd \u03c7\u03ce\u03c1\u03bf \u03c4\u03b7\u03c2 \u03b8\u03b5\u03c9\u03c1\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae\u03c2 \u03c4\u03b7\u03c2 \u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03b4\u03b5\u03b9\u03ba\u03bd\u03cd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03c3\u03b7\u03bc\u03b1\u03c3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03c1\u03cc\u03bb\u03bf\u03c5 \u03c4\u03b7\u03c2 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b1\u03bd\u03b1\u03c0\u03b1\u03c1\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ae\u03c2 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2, \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03ac \u03c4\u03b7\u03bd \u03b1\u03bd\u03b1\u03c0\u03b1\u03c1\u03b1\u03c3\u03c4\u03b1\u03c4\u03b9\u03ba\u03ae \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1. \u039f\u03b9 \u03ba\u03b1\u03c4\u03b1\u03b2\u03bf\u03bb\u03ad\u03c2 \u03c4\u03b7\u03c2 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bf\u03bb\u03ae\u03c2 \u03b1\u03c5\u03c4\u03ae\u03c2 \u03b1\u03bd\u03b9\u03c7\u03bd\u03b5\u03cd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03c3\u03b7\u03bc\u03b5\u03b9\u03bf\u03bb\u03bf\u03b3\u03b9\u03ba\u03ae \u03b8\u03b5\u03c9\u03c1\u03af\u03b1 \u03c4\u03bf\u03c5 \u0395\u03bb\u03b2\u03b5\u03c4\u03bf\u03cd \u03b3\u03bb\u03c9\u03c3\u03c3\u03bf\u03bb\u03cc\u03b3\u03bf\u03c5 Ferdinand de Saussure, \u03b7 \u03bf\u03c0\u03bf\u03af\u03b1 \u03c4\u03c1\u03bf\u03c6\u03bf\u03b4\u03cc\u03c4\u03b7\u03c3\u03b5 \u03c4\u03bf \u03ba\u03af\u03bd\u03b7\u03bc\u03b1 \u03c4\u03bf\u03c5 \u03b3\u03b1\u03bb\u03bb\u03b9\u03ba\u03bf\u03cd \u03b4\u03bf\u03bc\u03b9\u03c3\u03bc\u03bf\u03cd \u03c0\u03bf\u03c5 \u03ad\u03bc\u03b5\u03bb\u03bb\u03b5 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03bc\u03b1\u03c4\u03af\u03c3\u03b5\u03b9 \u03b9\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b1 \u03ba\u03b1\u03b8\u03bf\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03c1\u03cc\u03bb\u03bf \u03c3\u03c4\u03bf \u03b4\u03b9\u03b1\u03bd\u03bf\u03b7\u03c4\u03b9\u03ba\u03cc \u03c3\u03c4\u03b5\u03c1\u03ad\u03c9\u03bc\u03b1, \u03c3\u03c5\u03bc\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c3\u03c4\u03b7\u03bd \u03b4\u03b9\u03b1\u03bc\u03cc\u03c1\u03c6\u03c9\u03c3\u03b7 \u03bf\u03bb\u03cc\u03ba\u03bb\u03b7\u03c1\u03c9\u03bd \u03b5\u03c0\u03b9\u03c3\u03c4\u03b7\u03bc\u03bf\u03bd\u03b9\u03ba\u03ce\u03bd \u03ba\u03bb\u03ac\u03b4\u03c9\u03bd.\u03a3\u03c4\u03b7\u03bd \u03b4\u03b9\u03b1\u03c4\u03c1\u03b9\u03b2\u03ae \u03b5\u03c1\u03b5\u03c5\u03bd\u03ac\u03c4\u03b1\u03b9 \u03c4\u03bf \u03c6\u03ac\u03c3\u03bc\u03b1 \u03c4\u03c9\u03bd \u03b4\u03b9\u03b1\u03bd\u03bf\u03b7\u03c4\u03b9\u03ba\u03ce\u03bd \u03b5\u03be\u03b5\u03bb\u03af\u03be\u03b5\u03c9\u03bd \u03c3\u03c4\u03b9\u03c2 \u03b1\u03bd\u03b8\u03c1\u03c9\u03c0\u03b9\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c0\u03bf\u03c5\u03b4\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ad\u03c3\u03c4\u03b7\u03c3\u03b1\u03bd \u03b4\u03c5\u03bd\u03b1\u03c4\u03ae \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03b4\u03c5\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03b3\u03bb\u03c9\u03c3\u03c3\u03b9\u03ba\u03ae\u03c2 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03c4\u03b7\u03bd \u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1. \u0399\u03b4\u03b9\u03b1\u03af\u03c4\u03b5\u03c1\u03b7 \u03ad\u03bc\u03c6\u03b1\u03c3\u03b7 \u03b1\u03c0\u03bf\u03b4\u03af\u03b4\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03bf \u03ad\u03c1\u03b3\u03bf \u03c4\u03bf\u03c5 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03bf\u03cd \u03ba\u03b1\u03b9 \u03b8\u03b5\u03c9\u03c1\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd \u03c4\u03b7\u03c2 \u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1\u03c2, Hayden White, \u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03af \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03c4\u03bf\u03bc\u03ae \u03c4\u03b7\u03c2 \u03b5\u03c0\u03b5\u03be\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03b3\u03ae\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03bd \u03bb\u03cc\u03b3\u03c9 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03c4\u03b7\u03bd \u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1. \u0397 \u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1 \u03b5\u03c0\u03b9\u03ba\u03b5\u03bd\u03c4\u03c1\u03ce\u03bd\u03b5\u03c4\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ad\u03c1\u03b3\u03bf\u03c5 \u03c4\u03bf\u03c5 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b4\u03b5\u03ba\u03b1\u03b5\u03c4\u03af\u03b1 \u03c4\u03bf\u03c5 1960 \u03bc\u03ad\u03c7\u03c1\u03b9 \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1, \u03ba\u03b1\u03b8\u03ce\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03c5\u03c0\u03bf\u03b4\u03bf\u03c7\u03ae \u03c4\u03bf\u03c5, \u03c3\u03c4\u03b7 \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03b3\u03cd\u03c1\u03c9 \u03b1\u03c0\u03cc \u03b1\u03c5\u03c4\u03cc \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b7\u03bd \u03ba\u03c1\u03b9\u03c4\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5. \u03a0\u03c1\u03cc\u03ba\u03b5\u03b9\u03c4\u03b1\u03b9 \u03b3\u03b9\u03b1 \u03bc\u03b9\u03b1 \u03b8\u03b5\u03c9\u03c1\u03b7\u03c4\u03b9\u03ba\u03ae \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7, \u03c3\u03c4\u03b7\u03bd \u03bf\u03c0\u03bf\u03af\u03b1 \u03c4\u03bf \u03ad\u03c1\u03b3\u03bf \u03c4\u03bf\u03c5 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c4\u03b5\u03af\u03c4\u03b1\u03b9 \u03bc\u03ad\u03c3\u03b1 \u03c3\u03c4\u03bf \u03b3\u03b5\u03bd\u03b9\u03ba\u03cc\u03c4\u03b5\u03c1\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03c9\u03bd \u03b5\u03be\u03b5\u03bb\u03af\u03be\u03b5\u03c9\u03bd \u03c3\u03c4\u03b7\u03bd \u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1, \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bf\u03b9 \u03bc\u03b5\u03af\u03b6\u03bf\u03bd\u03b5\u03c2 \u03ac\u03be\u03bf\u03bd\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03c0\u03c1\u03bf\u03b2\u03bb\u03b7\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae\u03c2 \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03bb\u03cd\u03bf\u03bd\u03c4\u03b1\u03b9 \u03bf\u03b9 \u03ba\u03c5\u03c1\u03b9\u03cc\u03c4\u03b5\u03c1\u03bf\u03b9 \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03af \u03c3\u03c4\u03b7\u03bd \u03c0\u03bf\u03c1\u03b5\u03af\u03b1 \u03c4\u03bf\u03c5 \u03c3\u03c4\u03bf\u03c7\u03b1\u03c3\u03bc\u03bf\u03cd \u03c4\u03bf\u03c5. \u03a3\u03c4\u03bf \u03c4\u03ad\u03bb\u03bf\u03c2, \u03b5\u03be\u03b5\u03c4\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03b7 \u03b1\u03c0\u03ae\u03c7\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ad\u03c1\u03b3\u03bf\u03c5 \u03c4\u03bf\u03c5, \u03b7 \u03c3\u03c5\u03bc\u03b2\u03bf\u03bb\u03ae \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b9\u03c2 \u03b9\u03c3\u03c4\u03bf\u03c1\u03b9\u03ba\u03ad\u03c2 \u03c3\u03c0\u03bf\u03c5\u03b4\u03ad\u03c2, \u03b5\u03bd\u03ce \u03b5\u03c0\u03b9\u03c7\u03b5\u03b9\u03c1\u03b5\u03af\u03c4\u03b1\u03b9 \u03ba\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03b1\u03c0\u03bf\u03c4\u03af\u03bc\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03c3\u03c5\u03bd\u03b5\u03b9\u03c3\u03c6\u03bf\u03c1\u03ac\u03c2 \u03c4\u03b7\u03c2 \u03b3\u03bb\u03c9\u03c3\u03c3\u03b9\u03ba\u03ae\u03c2 \u03c3\u03c4\u03c1\u03bf\u03c6\u03ae\u03c2 \u03c3\u03c4\u03b7\u03bd \u0399\u03c3\u03c4\u03bf\u03c1\u03b9\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1.",
