    {
      "openalex_id": "W2065114277",
      "doi": "10.1515/pol-2013-0010",
      "title": "Modifying the Past: Nietzschean Approaches to History",
      "authors": [
        {
          "name": "Riccardo Baldissone",
          "openalex_id": "A5046709681",
          "institutions": [
            "Curtin University",
            "Singer (United States)",
