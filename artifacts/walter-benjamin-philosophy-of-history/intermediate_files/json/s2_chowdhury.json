      "paperId": "eba6337e7fb8ab00b294a8255e28955105bd6870",
      "title": "Temporal Loitering: Psychological Ageing and Animated Fl\u00e2nerie",
      "authors": [
        {
          "name": "Ra\u00fal JAMBRINA ROJO",
          "authorId": "2432158331"
