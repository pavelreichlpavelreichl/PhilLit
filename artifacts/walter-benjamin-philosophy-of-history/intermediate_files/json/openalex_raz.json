    {
      "openalex_id": "W4405742279",
      "doi": "10.17131/milel.1576905",
      "title": "The Concept of Time and the Future Perception of Zionism Based on the Messianic Doctrine: Forcing God into the Golden Age",
      "authors": [
        {
          "name": "Semiha Karahan",
          "openalex_id": "A5050377045",
          "orcid": "https://orcid.org/0000-0002-5105-5736",
          "institutions": [
            "Istanbul University"
