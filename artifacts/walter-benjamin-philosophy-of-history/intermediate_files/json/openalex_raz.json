    {
      "openalex_id": "W4410886733",
      "doi": "10.5325/pir.2.2.0006",
      "title": "\u201cEvery New Synagogue Is Both a Religious and a Security Fortress\u201d: Synagogues in Israeli Urban Internal Frontiers as Symbols of Sovereignty",
      "authors": [
        {
          "name": "David Borabeck",
          "openalex_id": "A5117770307",
          "orcid": "https://orcid.org/0000-0002-3553-2459",
