    {
      "openalex_id": "W2163009771",
      "doi": null,
      "title": "The Relationship of Canon and Messiah: The Convergence of Jan Assmann and Walter Benjamin on a Theory of Monotheistic Canon",
      "authors": [
        {
          "name": "Colby Dickinson",
          "openalex_id": "A5032967608",
