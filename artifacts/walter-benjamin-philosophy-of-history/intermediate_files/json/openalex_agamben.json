    {
      "openalex_id": "W2010602660",
      "doi": "10.4102/hts.v66i1.426",
      "title": "Holistic redemptive pastoral ministry in the fragmented transit hall of existence",
      "authors": [
        {
          "name": "Johann-Albrecht Meylahn",
          "openalex_id": "A5027437888",
