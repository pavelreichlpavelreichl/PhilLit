    {
      "openalex_id": "W2593050901",
      "doi": "10.4000/am.789",
      "title": "Where the Past Was, There History Shall Be",
      "authors": [
        {
          "name": "Sami Khatib",
          "openalex_id": "A5048049510",
          "orcid": "https://orcid.org/0000-0002-4949-5038",
          "institutions": [
