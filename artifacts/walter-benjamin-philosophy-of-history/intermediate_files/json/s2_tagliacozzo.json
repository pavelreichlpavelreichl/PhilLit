    {
      "paperId": "6e02a7eedad079451b9a8dd358268727cf599c6e",
      "title": "Do Large Language Models know what humans know?",
      "authors": [
        {
          "name": "Sean Trott",
          "authorId": "3393311"
        },
        {
          "name": "Cameron J. Jones",
          "authorId": "2115254698"
        },
