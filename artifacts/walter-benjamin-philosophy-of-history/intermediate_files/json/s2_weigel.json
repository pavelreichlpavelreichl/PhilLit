    {
      "paperId": "b5a98bf389d22c1a5a5eb2e6907eedb2f4e5f488",
      "title": "EMBODIED AND EXBODIED MIND: WHAT IN BETWEEN WHEN BODY IMAGE AND BODY SCHEMA (DE)-CONNECT?",
      "authors": [
        {
          "name": "A. Zatti",
          "authorId": "115162047"
