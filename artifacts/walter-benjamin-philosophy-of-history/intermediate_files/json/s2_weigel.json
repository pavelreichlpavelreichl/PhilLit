      "paperId": "725c0c989fc1388156f7ffe078b374defc15253c",
      "title": "Body image and scar assessment: A longitudinal cohort analysis of cardiothoracic, neurosurgery and urology patients.",
      "authors": [
        {
          "name": "Dorit Shorka",
          "authorId": "40962644"
        },
        {
          "name": "Noa Yemini",
          "authorId": "2135776812"
        },
        {
          "name": "Gila Ben Shushan",
