    {
      "openalex_id": "W2616448242",
      "doi": "10.17742/image.gdr.8-1.9",
      "title": "Troubled Faces: The Melancholy Passion of Anna Seghers\u2019s Die Entscheidung",
      "authors": [
        {
          "name": "Benjamin Lincoln Robinson",
          "openalex_id": "A5044327967",
          "orcid": "https://orcid.org/0000-0001-9525-4860",
          "institutions": [
