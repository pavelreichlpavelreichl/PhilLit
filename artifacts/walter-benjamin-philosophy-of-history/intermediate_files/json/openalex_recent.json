    {
      "openalex_id": "W2626358562",
      "doi": "10.31269/triplec.v15i2.898",
      "title": "G\u00fcnther Anders\u2019 Undiscovered Critical Theory of Technology in the Age of Big Data Capitalism",
      "authors": [
        {
          "name": "Christian Fuchs",
          "openalex_id": "A5060268505",
          "orcid": "https://orcid.org/0000-0003-0589-4579",
