      "openalex_id": "W4220965723",
      "doi": "10.1177/00380261221084426",
      "title": "Governing progress: From cybernetic homeostasis to Simondon\u2019s politics of metastability",
      "authors": [
        {
          "name": "Andrea Bardin",
          "openalex_id": "A5074382726",
          "orcid": "https://orcid.org/0000-0001-7228-8195",
