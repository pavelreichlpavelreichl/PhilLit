    {
      "openalex_id": "W1536796123",
      "doi": "10.5040/9781472549105",
      "title": "Levinas, Messianism and Parody",
      "authors": [
        {
          "name": "Terence Joseph Holden",
          "openalex_id": "A5109861392"
