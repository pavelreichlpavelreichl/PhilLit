    {
      "openalex_id": "W2149099223",
      "doi": "10.1215/01903659-2008-011",
      "title": "<i>Homo Profanus</i>: Giorgio Agamben's Profane Philosophy",
      "authors": [
        {
          "name": "Leland de la Durantaye",
          "openalex_id": "A5111898561"
