      "paperId": "34f023234a5437ff18125fc06ca0d25fb1770b14",
      "title": "Benjamin\u2019s Baudelaire: Translation and modern experience",
      "authors": [
        {
          "name": "Esperan\u00e7a Bielsa",
          "authorId": "104743919"
        }
