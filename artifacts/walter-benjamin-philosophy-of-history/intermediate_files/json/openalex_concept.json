    {
      "openalex_id": "W3001767529",
      "doi": "10.1111/1467-8365.12490",
      "title": "Decolonizing Art History",
      "authors": [
        {
          "name": "Catherine Grant",
          "openalex_id": "A5053878631",
          "orcid": "https://orcid.org/0000-0003-2742-1238"
