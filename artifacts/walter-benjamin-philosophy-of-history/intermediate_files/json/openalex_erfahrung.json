    {
      "openalex_id": "W2897968760",
      "doi": null,
      "title": "Cultural Memory and the Traumatic Past: Examining the Voids in Contemporary German and Uruguayan Literature, Museums, and Film",
      "authors": [
        {
          "name": "Jessica Paola Marino",
          "openalex_id": "A5087733400"
