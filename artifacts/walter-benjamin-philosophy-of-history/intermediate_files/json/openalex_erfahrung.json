      "title": "Intentional entanglement : Walter Benjamin, transcendental yet speculative, Darstellung",
      "authors": [
        {
          "name": "A. Brooks",
          "openalex_id": "A5040176033",
          "orcid": "https://orcid.org/0009-0009-3443-429X"
