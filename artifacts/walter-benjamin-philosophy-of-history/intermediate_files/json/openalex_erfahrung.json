    {
      "openalex_id": "W2953788322",
      "doi": "10.17615/cg6n-mj68",
      "title": "Time, Space, and Capital: Walter Benjamin in Apollinaire's \"Zone\" and Clair's Paris qui dort",
      "authors": [
        {
          "name": "Andrew Clark",
