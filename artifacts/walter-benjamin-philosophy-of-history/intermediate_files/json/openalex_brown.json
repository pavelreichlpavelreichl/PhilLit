    {
      "openalex_id": "W2595089685",
      "doi": null,
      "title": "A Grievous Necessity: The Subject of Marriage in Transatlantic Modern Women\u2019s Novels\u2014Woolf, Rhys, Fauset, Larsen, and Hurston",
      "authors": [
        {
          "name": "Kristin Czarnecki",
