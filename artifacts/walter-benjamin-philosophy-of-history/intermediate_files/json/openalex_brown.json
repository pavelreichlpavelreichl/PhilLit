    {
      "openalex_id": "W2795153324",
      "doi": null,
      "title": "Reading the personal: Toward a theory and practice of self -narrative in student writing",
      "authors": [
        {
          "name": "Megan Fulwiler",
          "openalex_id": "A5087296089"
