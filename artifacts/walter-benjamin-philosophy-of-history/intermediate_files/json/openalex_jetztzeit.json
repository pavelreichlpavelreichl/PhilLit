      "openalex_id": "W3091147109",
      "doi": "10.3390/rel11100504",
      "title": "Theology of Revolution: In Ali Shari\u2019ati and Walter Benjamin\u2019s Political Thought",
      "authors": [
        {
          "name": "Mina Khanlarzadeh",
          "openalex_id": "A5050833837",
          "orcid": "https://orcid.org/0000-0002-3138-4428",
