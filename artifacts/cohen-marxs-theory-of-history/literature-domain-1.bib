@misc{cohen1978karlmarx,
    author = "Cohen, G. A.",
    title = "Karl Marx's Theory of History: A Defence",
    year = "1978",
    note = {CORE ARGUMENT: Cohen reconstructs historical materialism as two interlocking claims: the Development Thesis (productive forces tend to develop through history) and the Primacy Thesis (the level of development of the productive forces explains the character of the economic structure, which in turn explains the legal-political superstructure). He argues this explanatory priority is best understood as functional explanation, modeled on evolutionary biology: economic structures obtain because, and only while, they are suited to developing the productive forces they contain, and are superseded once they "fetter" further development. Central to the argument is a distinction between the purely material and the social (legally/normatively described) properties of productive forces and relations of production, which allows the economic structure to be characterized independently of ("rechtsfrei" of) the legal categories it is supposed to explain. The expanded 2000/2001 edition adds a new introduction and several essays responding to a decade of criticism. RELEVANCE: This is the primary text under review; every other entry in this domain, and the reception/debate literature covered elsewhere in the project, responds directly to the argument set out here. POSITION: Founding text of Analytical Marxism and a paradigmatic modern reconstruction of historical materialism as a determinate, testable social theory.},
    keywords = "primacy-thesis, development-thesis, functional-explanation, analytical-marxism, primary-text, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "First published in 1978, this book rapidly established itself as a classic of modern Marxism. Cohen's masterful application of advanced philosophical techniques in an uncompromising defense of historical materialism commanded widespread admiration. In the ensuing twenty years, the book has served as a flagship of a powerful intellectual movement--analytical Marxism. In this expanded edition, Cohen offers his own account of the history, and the further promise, of analytical Marxism. He also expresses reservations about traditional historical materialism, in the light of which he reconstructs the theory, and he studies the implications for historical materialism of the demise of the Soviet Union.",
    abstract_source = "openalex"
}

@misc{cohenacton1970criticisms,
    author = "Cohen, Gerald A. and Acton, H. B.",
    title = "On Some Criticisms of Historical Materialism",
    year = "1970",
    note = "CORE ARGUMENT: In this symposium piece predating the 1978 book by eight years, Cohen answers standard objections to historical materialism (that it is unfalsifiable, that it neglects the causal role of ideas, that base/superstructure cannot be non-circularly distinguished) using the analytical apparatus that would later structure Karl Marx's Theory of History; Acton presses the classical skeptical case against the theory's determinism and its base/superstructure distinction. RELEVANCE: Documents the argumentative groundwork — especially the attempt to give a non-circular, materially specified account of the economic structure — that Cohen would systematize in the 1978 book; shows the primacy thesis was defended piecemeal before its full reconstruction. POSITION: Early defence of historical materialism against standard mid-century objections; precursor to the 1978 book's systematic treatment.",
    keywords = "primacy-thesis, base-superstructure, precursor, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Gerald A. Cohen, H. B. Acton; On Some Criticisms of Historical Materialism, Aristotelian Society Supplementary Volume, Volume 44, Issue 1, 12 July 1970, Pa",
    abstract_source = "openalex"
}

@misc{cohen1974being,
    author = "Cohen, G. A.",
    title = "Being, Consciousness and Roles: On the Foundations of Historical Materialism",
    year = "1974",
    note = {CORE ARGUMENT: Cohen examines how Marx's base/superstructure distinction can be given content without presupposing the very legal and normative categories it is meant to explain, developing an account of production relations in terms of effective (material) control rather than legal ownership — the germ of the "rechtsfrei" characterization later central to Karl Marx's Theory of History. The abstract itself sets out three requirements a clarified version of historical materialism must meet: specifying what would confirm/disconfirm it, remaining recognizable as Marx's thesis, and staying substantive rather than trivial. RELEVANCE: Directly anticipates the material/social property distinction that does crucial explanatory work in the 1978 book's account of the economic structure and its relation to the legal superstructure, and previews the methodological demand for a non-trivial, falsifiable formulation that the 1978 book fulfills at length. POSITION: Precursor essay establishing the material-control account of production relations independently of legal categories.},
    keywords = "material-social-distinction, rechtsfrei, base-superstructure, precursor, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "The thesis exhibited above is obscure. It is not clear what sort of evidence should weaken confidence in it, nor what sort may be adduced in its support. But that it is not clear does not show that it cannot be clarified. A satisfactory clarification must fulfil three requirements: 1. It must state what evidence has to be like to confirm it, and to disconfirm it. 2. The thesis so elucidated must be recognisable. It must be reasonable to claim it as a more express version of the thesis Marx maintained and which historians have affirmed and denied in controversy over particular issues.1 3. The thesis must remain interesting. It must become neither trivially true nor trivially false. (A clarification which passes the second test thereby passes the third, unless historians have been more confused than I am willing to suppose.)",
    abstract_source = "openalex"
}

@misc{ruben1981cohenmarx,
    author = "Ruben, David-Hillel",
    title = "Cohen, Marx and the Primacy Thesis",
    year = "1981",
    note = "CORE ARGUMENT: Ruben scrutinizes Cohen's formulation of the Primacy Thesis, asking whether the textual and philosophical case for explanatory priority of the productive forces over relations of production is as strong as Cohen claims, and probing whether Cohen's functional-explanation strategy actually secures a genuinely explanatory (rather than merely correlational) primacy. The retrieved abstract situates the book as setting a new standard of definitional and argumentative rigor for Marxist philosophy compared to earlier continental treatments, before proceeding to the detailed critique. RELEVANCE: One of the earliest sustained philosophical examinations of the Primacy Thesis specifically, directly engaging the core interpretive claim that structures this domain. POSITION: Critical but internal engagement with Cohen's reconstruction, focused on whether the Primacy Thesis is adequately supported rather than on rejecting historical materialism outright.",
    keywords = "primacy-thesis, functional-explanation, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "As Jon Elster remarked in an earlier review, G. A. Cohen's Karl Marx's Theory of History: A Defence ‘sets a new standard for Marxist philosophy’. In one way, the praise is too faint. Existing paradigms of continental Marxist philosophy are marred by an absence of careful definition, clear and precise argumentation, and the sort of sustained discussion that is committed to the teasing out of the intellectual difficulties of the author's own position – in short, marred by an absence of those virtues in the attainment of which the philosophy practised in Britain, the United States, and the Scandinavian countries on the whole excels. Cohen would, presumably, agree that this has nothing intrinsically to do with Marx, or Marxism, but in the main arises from the fortuitous coupling of Marxism with continental philosophical fashions. If this sounds like some sort of cultural chauvinism, it also happens to be the truth. So the ‘new’ standards for Marxist philosophy, then, are only the same standards by which it is right to judge all philosophy, wherever it is written, and which any philosophy must pass in order to be accounted good. What is perhaps less faint praise of Cohen is to say that his book is good philosophy (without the qualifying adjective ‘Marxist’). It is an ingenious and imaginative volume, in which precision and detailed attention to argument count for everything.",
    abstract_source = "openalex"
}

@misc{elster1980cohenmarx,
    author = "Elster, Jon",
    title = "Cohen on Marx's Theory of History",
    year = "1980",
    note = {CORE ARGUMENT: Elster's review lays out Cohen's Development and Primacy Theses and raises the objection that would define the subsequent functional-explanation controversy: functional explanations of the "economic structures persist because they develop the productive forces" form require an independently specified causal mechanism (an "elaboration") linking the beneficial consequence to the structure's persistence, and Cohen's appeal to the biological analogy of natural selection does not by itself supply one for the social case. RELEVANCE: The founding critical statement of the functional-explanation problem that Cohen's reconstruction of the Primacy Thesis depends on; essential for understanding why Cohen's method (not just his substantive claims) became the focus of debate. POSITION: Skeptical of functional explanation as applied to historical materialism; inaugurates what becomes the central methodological controversy over the book.},
    keywords = "functional-explanation, primacy-thesis, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{cohen1980functionalreply,
    author = "Cohen, G. A.",
    title = "Functional Explanation: Reply to Elster",
    year = "1980",
    note = "CORE ARGUMENT: Cohen responds directly to Elster's review, defending functional explanation without a fully specified causal elaboration by arguing that well-confirmed functional explanations in evolutionary biology were accepted long before their underlying mechanisms (natural selection) were understood in detail, and that comparable inductive support can in principle be marshaled for historical materialism's functional claims. RELEVANCE: Cohen's first-hand methodological self-defence, published back-to-back with Elster's critique, making this pairing indispensable for understanding the terms of the functional-explanation debate as Cohen himself understood it. POSITION: Defends functional explanation as a legitimate, if elaboration-requiring, explanatory form in historical materialism.",
    keywords = "functional-explanation, primacy-thesis, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{cohen1982functionalexplanation,
    author = "Cohen, G. A.",
    title = "Functional explanation, consequence explanation, and Marxism",
    year = "1982",
    note = {CORE ARGUMENT: Cohen offers his fullest methodological statement of functional (or "consequence") explanation, distinguishing it from mere correlational or teleological claims and specifying the conditions under which citing a beneficial consequence of a structure can explain that structure's existence. As the retrieved abstract details, the paper defends historical materialism's explanations as functional/consequence explanations, rejects Elster's proposal that game theory should instead play the central explanatory role in Marxist theory, revises the relation between "functional" and "consequence" explanation from his 1978 position, and rebuts metaphysical and epistemological doubts about consequence explanation. RELEVANCE: The most systematic statement of the methodological thesis that functional explanation is the logical form of historical materialism, going well beyond the brief reply to Elster to lay out the general theory of consequence explanation. POSITION: Full articulation and defence of functional/consequence explanation as historical materialism's characteristic explanatory form, and a direct rejoinder to Elster's game-theoretic alternative.},
    keywords = "functional-explanation, methodology, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "I argued in Karl Marx's Theory of History that the central claims of historical materialism are functional explanations, and I said that functional explanations are consequence explanations, ones, that is, in which something is explained by its propensity to have a certain kind of effect. I also claimed that the theory of chance variation and natural selection sustains functional explanations, and hence consequence explanations, of organismic equipment. In Section I I defend the thesis that historical materialism offers functional or consequence explanations, and I reject Jon Elster's contention that game theory can, and should, assume a central role in the Marxist theory of society. In Section II I contrast functional and consequence explanation, thereby revising the position of Karl Marx's Theory of History, and I question whether evolutionary biology supports functional explanations. Section III is a critique of Elster's views on functional explanation, and Sections IV and V defend consequence explanation against metaphysical and epistemological doubts. A concluding section summarizes my present understanding of the status of historical materialist explanations.",
    abstract_source = "openalex"
}

@misc{suchting1982productive,
    author = "Suchting, Wal",
    title = {"Productive Forces" and "Relations of Production" in Marx},
    year = "1982",
    note = "CORE ARGUMENT: Suchting criticizes the view, which he attributes to Cohen's reconstruction, that productive forces determine relations of production and that the growth of the former basically determines the course of history. He instead presents what he argues is Marx's actual conception of productive forces and relations of production, identifying class struggle rather than forces-driven development as the primary factor for the historically significant periods Marx analyzed. RELEVANCE: Directly challenges the material/social property distinction that Cohen uses to make the economic structure explanatorily independent of the legal superstructure; part of the Analyse \& Kritik symposium to which Cohen replied (Cohen 1983). POSITION: Textually grounded critique of Cohen's core definitional apparatus and of the Primacy Thesis's downgrading of class struggle, from within sympathetic engagement with Marxist theory.",
    keywords = "material-social-distinction, forces-relations-production, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Abstract This paper criticises the view that, according to Marx, “productive forces” determine “relations of production” and that the growth of the former basically determines the course of history. The particular version of this account discussed is that to be found in G.A. Cohen’s Karl Marx's Theory of History: A Defence. The main part of this criticism in:-volves a presentation of what, it is suggested, was in fact Marx's conception of "productive forces", "relations of production" and their relations, and an identification of class-struggle as the primary factor at least for the historically significant periods with which Marx was concerned.},
    abstract_source = "openalex"
}

@misc{cohen1983replyfour,
    author = "Cohen, G. A.",
    title = "Reply to Four Critics",
    year = "1983",
    note = "CORE ARGUMENT: Cohen responds to four critics (Van Parijs, Suchting, Fisk, and Lukes) of Karl Marx's Theory of History. He clarifies an ambiguity in his argument for historical materialism, contends against Van Parijs that historical materialism is consistent only if production relations are explained functionally by their propensity to develop the productive forces, rebuts Suchting's and Fisk's view that class struggle should play a larger explanatory role than he assigns it, and defends his account of base and superstructure against Lukes's skepticism. RELEVANCE: A direct, sustained self-defence of the material/social property distinction and of the subordination of class struggle to functional explanation against some of its most detailed contemporary critics, including Suchting (this domain). POSITION: Defends the 1978 reconstruction's definitional core and functionalist methodology while conceding specific clarifications to individual critics.",
    keywords = "material-social-distinction, forces-relations-production, self-revision, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This article is a response to criticisms of my book on Karl Marx’s Theory of History which were made by four authors in last December’s number of Analyse \& Kritik. After clarifying (section 2) an ambiguity in an argument for historical materialism which is presented in the book , I contend (3-5), against objections raised by Philippe Van Parijs , that historical materialism is consistent only if it explains production relations functionally, by reference to their propensity to develop the productive forces. Next (6-8) I address and rebut the views of Wal Suchting and Milton Fisk , who both think that the role of class struggle in historical materialism is larger than the one I assign to it. Finally (9-12) I try to vindicate the doctrine of base and superstructure proposed in my book against the skepticism of Steven Lukes.",
    abstract_source = "openalex"
}

@misc{cohen1986restrictedinclusive,
    author = "Cohen, G. A.",
    title = "Restricted and Inclusive Historical Materialism",
    year = "1986",
    note = {CORE ARGUMENT: Cohen distinguishes a "restricted" version of historical materialism, confined to explaining the general trajectory of successive economic structures via the Development and Primacy Theses, from a more "inclusive" version that also attempts to explain particular historical events and the content of the superstructure and ideology in detail; he argues the restricted version is the one properly defended in the 1978 book and is more defensible than the inclusive ambitions sometimes attributed to Marxism. RELEVANCE: A key self-revision clarifying the scope of the Primacy Thesis defended in Karl Marx's Theory of History, delimiting exactly what the book's argument does and does not claim to explain. POSITION: Cohen's own scope-limiting refinement of his reconstruction, narrowing the ambitions of the Primacy Thesis rather than abandoning it.},
    keywords = "primacy-thesis, self-revision, scope-of-explanation, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{shaw1986historical,
    author = "Shaw, William H.",
    title = "Historical Materialism and the Development Thesis",
    year = "1986",
    note = "CORE ARGUMENT: Shaw examines the textual and philosophical basis for the Development Thesis — the claim that productive forces have a built-in tendency to develop — assessing the rationality-based argument Cohen gives for it (that humans, facing scarcity, tend to seize opportunities to improve productive power) and whether history in fact displays the relevant developmental tendency. RELEVANCE: A focused treatment of the Development Thesis specifically, complementing the more numerous treatments of the Primacy Thesis and directly answering one of this domain's key questions. POSITION: Sympathetic but probing assessment of Cohen's rationality-based defence of the Development Thesis.",
    keywords = "development-thesis, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{duquette1992critique,
    author = "Duquette, David A.",
    title = "A Critique of the Technological Interpretation of Historical Materialism",
    year = "1992",
    note = {CORE ARGUMENT: Duquette argues that Cohen's Primacy Thesis amounts to a "technological determinist" interpretation of Marx, in which human technology (productive forces) is the primary explanatory factor for economic and social change. He focuses the attack on Cohen's way of distinguishing the material from the social characteristics — the "content" from the "form" — of a system of production, arguing this distinction is defective and so fails to support the Primacy Thesis, and that the resulting position is not, in any case, Marx's own. RELEVANCE: Directly addresses this domain's key question of how the Primacy Thesis differs from vulgar technological determinism, arguing that Cohen's version does not, in fact, escape the charge. POSITION: Critical of Cohen's Primacy Thesis as a covert technological determinism; represents the "vulgar determinism" charge that Shaw's reply (this domain) directly answers.},
    keywords = "primacy-thesis, technological-determinism, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This essay examines and criticizes G. A. Cohen's interpretation of Marx's materialistic conception of history as presented in Cohen's book Karl Marx's Theory of History. In particular, the author attacks Cohen's Primacy Thesis, the claim that (for Marx) human technology is the primary explanatory factor for economic and social change and for historical development generally. The focus of the attack is Cohen's way of distinguishing between the material and social characteristics, or the content and form, of a system of production. The argument is that Cohen's distinctions are defective and therefore fail to provide adequate support for the Primacy Thesis and that, moreover, the position that Cohen defends is not Marx's.",
    abstract_source = "openalex"
}

@misc{shaw1992duquette,
    author = "Shaw, William H.",
    title = "Duquette and the Primacy Thesis",
    year = "1992",
    note = {CORE ARGUMENT: Shaw replies directly to Duquette's charge that Cohen's Primacy Thesis is a disguised technological determinism, arguing that the thesis can be read as asserting explanatory (not unilateral causal) primacy of the productive forces, compatible with relations of production reacting back upon and even temporarily constraining the forces, without collapsing into the "vulgar" reading Duquette attacks. RELEVANCE: Forms a direct published exchange with Duquette (1992) in the same journal issue, giving this domain a self-contained debate over exactly how the Primacy Thesis should be distinguished from technological determinism. POSITION: Defends a moderate reading of the Primacy Thesis as compatible with reciprocal (if asymmetric) causal influence between forces and relations of production.},
    keywords = "primacy-thesis, technological-determinism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{mills1989immaterial,
    author = "Mills, Charles W.",
    title = "Is it immaterial that there's a 'material' in 'historical materialism'?",
    year = "1989",
    note = {CORE ARGUMENT: Mills argues that Cohen's "technological determinist" reading of Marx rests on an idiosyncratic interpretation of Marx's term "material": Cohen takes historical materialism to assert the determination of the social by the material/asocial — socio-neutral facts about human nature and rationality manifested in the tendency of productive forces to develop. Reviewing Marx's own writings, Mills argues the textual evidence favors the traditional interpretation that for Marx "material" already includes the economic and is thus inescapably social, so that critics who insist relations of production belong within historical materialism's explanans (rather than being excluded as merely "social") have Marx's own terminology and concepts on their side. RELEVANCE: Bears directly on this domain's key question about how the material/social property distinction does philosophical work in Cohen's argument, offering a textually grounded challenge to whether "material" (as Cohen uses it) picks out a category Marx himself recognized. POSITION: Critical of Cohen's material/social distinction as textually unsupported; aligns with critics (e.g., Suchting) who want relations of production included within the "material" explanantia of historical materialism.},
    keywords = "material-social-distinction, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "G. A. Cohen's influential ‘technological determinist’ reading of Marx's theory of history rests in part on an interpretation of Marx's use of ‘material’ whose idiosyncrasy has been insufficiently noticed. Cohen takes historical materialism to be asserting the determination of the social by the material/asocial, viz. ‘socio‐neutral’ facts about human nature and human rationality which manifest themselves in a historical tendency for the forces of production to develop. This paper reviews Marx's writings to demonstrate the extensive textual evidence in favour of the traditional interpretation ‐ that for Marx, the ‘material’ includes the economic, and is thus ineluctably social in character. Thus those critics of Cohen who have urged the inclusion of the relations of production in historical materialism's explanans do seem to have Marx's terminological and conceptual backing.",
    abstract_source = "openalex"
}

@misc{miller1981productive,
    author = "Miller, Richard W.",
    title = "Productive Forces and the Forces of Change: A Review of Gerald A. Cohen, Karl Marx's Theory of History: A Defense",
    year = "1981",
    note = {CORE ARGUMENT: Miller situates Cohen's book as the culmination of a decade-long project rehabilitating Marx against mid-century Anglo-American critics (Acton, Popper, Plamenatz) who dismissed Marx's theories as too obscure for serious philosophical engagement, then offers a detailed critical review questioning whether the textual evidence Cohen assembles genuinely supports the strong explanatory priority the Primacy Thesis assigns to productive forces, and whether "fettering" is well enough defined to do the causal work Cohen needs for his account of revolutionary transitions between economic structures. RELEVANCE: A substantive early philosophical review that engages closely with the primacy thesis and the fettering/forces-relations relationship, two of this domain's key questions. POSITION: Sympathetic critic who accepts much of Cohen's interpretive framework while doubting specific evidential and definitional claims.},
    keywords = "primacy-thesis, fettering, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In the fifties and sixties, the point of most Anglo-American Marx studies was to show that Marx's theories were not worth studying, except as historically important relics. Acton, Berlin, Popper, and Plamenetz are just a few of those who argued that Marx's ideas were too confused, unclear, metaphysical, or obviously mistaken to merit further empirical investigation. In philosophy, Gerald Cohen has been a leader, probably the leader, in turning this tide. In a series of articles written over the last ten years, he has defined and defended Marx's views with the analytic resourcefulness of the best Anglo-American philosophy, and with grace, wit, and good humor that are altogether rare. In his articles, he was necessarily discussing small fragments of Marx's extremely synoptic social theory. His book on Marx's general theory of society and social change, Marx's Theory of History: A Defense, ' has, therefore, been eagerly awaited. Cohen's skill, style, and influence make it likely that his book will be the most widely read sympathetic exposition of Marx, among philosophers, for the next several years. Two groups of readers will find it of special use. Those who fear that sympathetic discussions of Marx must make his theories obscure or utterly implausible, or, otherwise, reduce them to platitudes will find this book an impressive counterexample. Those with their own interpretations of Marx will find that their thinking about him is enriched, clarified, and stimulated, even if their final thought about Cohen's book is that it is deeply wrong.",
    abstract_source = "openalex"
}

@misc{joshuacohen1982karlmarx,
    author = "Cohen, Joshua",
    title = "Karl Marx's Theory of History: A Defence",
    year = "1982",
    note = "CORE ARGUMENT: Joshua Cohen's review reconstructs and evaluates the book's overall argumentative structure, giving particular attention to the functional-explanation strategy used to secure the Primacy Thesis and to whether the distinction between material and social properties of production successfully insulates the economic structure from the legal superstructure it is meant to explain. RELEVANCE: A widely cited overview and assessment of the book's core theses, useful as a well-informed contemporary map of exactly what the 1978 argument claims and where its pressure points lie. POSITION: Careful, largely sympathetic exposition combined with targeted philosophical criticism of specific argumentative steps.",
    keywords = "primacy-thesis, functional-explanation, material-social-distinction, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{railton1986explanatory,
    author = "Railton, Peter",
    title = "Explanatory Asymmetry in Historical Materialism",
    year = "1986",
    note = "CORE ARGUMENT: Railton examines the asymmetric explanatory relationship the Primacy Thesis posits between productive forces and relations of production, asking what kind of explanatory (as opposed to merely correlational or statistical) dependence Cohen's functionalist reconstruction actually establishes, and situating the question within broader philosophy-of-science debates about explanatory asymmetry. RELEVANCE: Brings philosophy-of-science tools to bear on precisely the explanatory-priority claim at the heart of the Primacy Thesis, complementing the more Marxological treatments elsewhere in this domain. POSITION: Analytically oriented assessment of whether Cohen's functional explanation secures genuine (asymmetric) explanatory priority for the productive forces.",
    keywords = "primacy-thesis, functional-explanation, philosophy-of-science, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{sierminski2025young,
    author = "Siermiński, Michał",
    title = "Young Karl Marx in the Age of Progress: the Historical Materialism of the 1840s and Its Limits",
    year = "2025",
    note = "CORE ARGUMENT: Using Cohen's Development Thesis (history as continuous development of the productive forces) and Primacy Thesis (productive forces determine social relations) as its reference framework, this paper argues that the young Marx's 1840s historical materialism, formed in the era of expanding capitalist technology, could not adequately ground his simultaneous commitment to working-class struggle, generating an internal tension between technological progressivism and revolutionary class politics. RELEVANCE: A recent example of scholars continuing to use Cohen's own Development/Primacy Thesis terminology as the standard vocabulary for reconstructing Marx's early theory of history, confirming the durability of Cohen's conceptual framework independent of agreement with his conclusions. POSITION: Treats Cohen's Development and Primacy Theses as accurate characterizations of Marx's 1840s position while arguing this early position is internally strained.",
    keywords = "development-thesis, primacy-thesis, recent-scholarship, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "The article discusses an early version of Karl Marx’s historical materialism. The young Marx was a child of his time—the era of rapid development of technology and science that accompanied the expansion of capitalism. In the 1840s his historical materialism was based on two premises: the Development Thesis (history is the continuous development of the productive forces) and the Primacy Thesis (the level of development of the productive forces determines social relations). On the basis of these assumptions, Marx had serious problems in theoretically grounding his growing enthusiasm for the workers’ class struggle.",
    abstract_source = "s2"
}

@misc{sierminski2025against,
    author = "Siermiński, Michał",
    title = "Marx Against Marx: An Outline of Mature Historical Materialism",
    year = "2025",
    note = {CORE ARGUMENT: Siermiński argues that in the 1850s, following his engagement with classical political economy in the Grundrisse, Marx broke with the technological determinism of his 1840s formulations and began according explanatory primacy to the relations of production over the productive forces in explaining the origins and dynamics of capitalism — effectively reversing the priority ordering central to Cohen's Primacy Thesis. RELEVANCE: Offers a direct challenge to whether Cohen's Primacy Thesis, as textually defended for the "mature" Marx of Capital, actually holds; useful counterpoint for assessing how far Cohen's reconstruction of the "1859 Preface" period generalizes to Marx's later economic writings. POSITION: Argues against the Primacy Thesis as a reading of mature Marx, contending Marx's later work reverses the forces-over-relations priority Cohen attributes to him.},
    keywords = "primacy-thesis, forces-relations-production, recent-scholarship, Low, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "In the 1850s, Karl Marx’s thought underwent a genuine revolution. After relocating to England, he confronted classical political economy anew, finding it unable to account for value growth and capitalist accumulation. Beginning with the methodological turn in the Grundrisse and its explicitly anti-positivist stance, Marx shifted explanation from market appearances to the sphere of production, where surplus value becomes fundamental. This reorientation culminated in a decisive break with his early technolgical determinism: Marx accords primacy to the rela tions of production over productive forces in explaining the origins of capitalism, the dynamics of accumulation and the specifically capitalist drive toward productivity growth.",
    abstract_source = "s2"
}
