@misc{cohen2000reflectionsanalyticalmarxism,
    author = "Cohen, G. A.",
    title = "Introduction to the 2000 Edition: Reflections on Analytical Marxism",
    year = "2000",
    note = {CORE ARGUMENT: In this new introduction added to the expanded edition, Cohen offers a retrospective account of the origins and trajectory of analytical Marxism as an intellectual movement, registers explicit reservations about traditional historical materialism as originally reconstructed in 1978, and works through what the demise of Soviet-style communism implies for the theory's central claims. RELEVANCE: This is the primary textual site where Cohen, twenty-two years after the original Defence, publicly qualifies his own earlier commitments and situates the book's argument within a movement whose "further promise" he takes to lie increasingly in normative political philosophy rather than in historical materialism proper. POSITION: Cohen's own authoritative retrospective self-assessment, distinct from the original 1978 text and from the individual scope-limiting essays anthologized in History, Labour, and Freedom.},
    keywords = "self-revision, analytical-marxism, expanded-edition, trajectory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, type:@incollection->@misc"
}

@misc{cohen1999marxismcollapse,
    author = "Cohen, G. A.",
    title = "Marxism after the Collapse of the Soviet Union",
    year = "1999",
    note = "CORE ARGUMENT: Cohen examines what the collapse of the Soviet Union implies for historical materialism, arguing that the failure of the Soviet socialist project does not straightforwardly refute the theory's central claims but requires reassessment of how the Development and Primacy Theses bear on twentieth-century history. RELEVANCE: A concise primary document of Cohen reckoning, in real time, with the single most significant empirical challenge to historical materialism during his lifetime; source material later folded into the fuller reflections of the 2000 expanded edition's introduction. POSITION: Cohen's own qualified response to a historical event that pressed hardest against the optimistic reading of the Development Thesis.",
    keywords = "self-revision, soviet-collapse, development-thesis, empirical-challenge, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{cohen2000egalitarianrich,
    author = "Cohen, G. A.",
    title = "If You're an Egalitarian, How Come You're So Rich?",
    year = "2000",
    note = "CORE ARGUMENT: Based on Cohen's 1996 Gifford Lectures, this book traces how his personal history -- a communist upbringing in 1940s Montreal that instilled a strongly egalitarian socialist doctrine -- shaped his subsequent philosophical trajectory, and argues that egalitarian justice is a matter of personal choice and ethos as well as of institutional rules, thereby engaging directly with Rawlsian liberalism. RELEVANCE: Cohen's own explicit, autobiographically framed narration of his intellectual journey from Marxist historical materialism to normative political philosophy, making it a central primary source for reconstructing how Cohen himself understood and justified his departure from the 1978 book's project. POSITION: First-person retrospective self-narration of the shift from historical materialism to egalitarian political philosophy.",
    keywords = "self-narration, trajectory, egalitarianism, rawls, gifford-lectures, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{cohen1988historylabourfreedom,
    author = "Cohen, G. A.",
    title = "History, Labour, and Freedom: Themes from Marx",
    year = "1988",
    note = {CORE ARGUMENT: This collection gathers Cohen's essays from the decade after Karl Marx's Theory of History, including "Reconsidering Historical Materialism" and "Restricted and Inclusive Historical Materialism," in which Cohen narrows the scope of the Primacy Thesis, works through functional explanation more carefully (including the "hollow bones" analogy and the distinction between functional explanation and its microfoundational "elaborations"), and engages proletarian unfreedom and exploitation. RELEVANCE: The central primary collection documenting Cohen's own decade-plus of self-revision and qualification of the 1978 book's theses prior to the 2000 expanded edition; cited repeatedly (six times) in SEP's "Analytical Marxism" entry as the authoritative statement of Cohen's functional-explanation methodology as revised through the 1980s. POSITION: Cohen's own consolidated self-revision of historical materialism's scope and method, short of abandoning functional explanation but qualifying its ambitions. SEP\_CONTEXT: SEP's Analytical Marxism entry (section 3.3, Functional Explanation) draws repeatedly on this volume to explain Cohen's functional-explanation methodology, including the claim that functional explanations need not be invalidated by the absence of elaborated microfoundations, and (section 3.4) to illustrate Cohen's treatment of dialectical transformation as non-necessitated stage succession.},
    keywords = "self-revision, functional-explanation, restricted-inclusive, primary-source, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{levine1991historylabourfreedom,
    author = "Levine, Andrew",
    title = "History, Labour and Freedom: Themes from Marx",
    year = "1991",
    note = "CORE ARGUMENT: A review essay assessing Cohen's 1988 collection, evaluating how the individual essays -- on historical materialism's restricted scope, on functional explanation, and on proletarian unfreedom -- cohere as a body of revision to the 1978 book's original theses. RELEVANCE: Provides a contemporaneous scholarly reception of the specific texts in which Cohen narrowed and qualified his earlier commitments, offering an external check on how far Cohen's self-revision was perceived, at the time, as a substantive retreat versus a clarification. POSITION: A critical-notice-style review situating the 1988 collection within the trajectory of Cohen's post-1978 thought.",
    keywords = "review, self-revision, reception, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{agar2003functionalexplanation,
    author = "Agar, Joly",
    title = "G. A. Cohen's Functional Explanation",
    year = "2003",
    note = "CORE ARGUMENT: Agar re-examines and ultimately rejects the functional explanation that underpins Cohen's account of the relations of production, explicitly framing the discussion in light of the book's recent (2000) republication and the reservations Cohen himself had by then expressed about the theory. RELEVANCE: Directly engages the functional-explanation methodology as it stood after Cohen's own qualifications, testing whether the post-1988/2000 restricted version survives criticisms that the original 1978 functionalism could not. POSITION: A critical assessment concluding that functional explanation remains untenable even in its qualified, post-revision form.",
    keywords = "functional-explanation, critique, republication, expanded-edition, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{kennedy2005cohenmarxinterview,
    author = "Kennedy, Simon",
    title = "G.A. Cohen's Karl Marx's Theory of History: A Defence",
    year = "2005",
    note = "CORE ARGUMENT: Combines a review of Karl Marx's Theory of History (assessed across both the 1978 original and the 2000 expanded edition) with material drawn from an interview with Cohen, addressing why he came to qualify traditional historical materialism and how he understood the book's legacy within, and beyond, analytical Marxism. RELEVANCE: One of the few secondary sources that puts Cohen's own retrospective account of his retreat from strong historical materialism (as given directly by Cohen) alongside independent critical assessment of the 2000 edition's new material, making it a useful bridge between primary self-revision and secondary reception. POSITION: Sympathetic but critical retrospective assessment combining review and first-person testimony.",
    keywords = "review, interview, expanded-edition, self-revision, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{vrousalis2010visionofsocialism,
    author = "Vrousalis, Nicholas",
    title = "G. A. Cohen's Vision of Socialism",
    year = "2010",
    note = {CORE ARGUMENT: Vrousalis reconstructs the elements of Cohen's thinking about socialism chronologically across his "long intellectual voyage from Marxism to political philosophy," using Cohen's successive books as thematic signposts, and argues that a coherent vision of socialism -- organized around equality, community, and self-ownership -- can be pieced together across the trajectory. RELEVANCE: Offers a systematic secondary reconstruction of exactly the trajectory this domain investigates, treating Cohen's shift from historical materialism to egalitarian political philosophy as a continuous development rather than a clean break, and identifying which commitments persisted versus were revised. POSITION: A sympathetic reconstructive account arguing for underlying continuity beneath Cohen's overt theoretical retreats.},
    keywords = "trajectory, socialism, luck-egalitarianism, continuity, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{vrousalis2015politicalphilosophy,
    author = "Vrousalis, Nicholas",
    title = "The Political Philosophy of G.A. Cohen: Back to Socialist Basics",
    address = "New York",
    year = "2015",
    note = "CORE ARGUMENT: The first full-length study of Cohen's political philosophy, covering equality, freedom, fraternity, and his critical engagements with Marx, Nozick, and Rawls, and critically reconstructing how these diverse strands of Cohen's post-Marxist thought fit together in the context of contemporary political, economic, and social theory. RELEVANCE: The most extensive secondary treatment of the destination of Cohen's trajectory (his mature political philosophy), providing the fullest available account of how the positions Cohen arrived at after retreating from historical materialism relate back to the concerns of the 1978 book. POSITION: A systematic, largely sympathetic reconstruction of Cohen's post-Marxist political philosophy as continuous with, rather than a repudiation of, his socialist commitments.",
    keywords = "trajectory, political-philosophy, monograph, continuity, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{tarrit2023continuiteruptures,
    author = "Tarrit, Fabien",
    title = "Continuité et ruptures chez Cohen. À propos d'un livre de Nicholas Vrousalis",
    year = "2023",
    note = {CORE ARGUMENT: Reviewing Vrousalis's The Political Philosophy of G.A. Cohen, Tarrit organizes his discussion explicitly around the question of continuity and rupture in Cohen's intellectual development, assessing how far Cohen's turn from historical materialism to egalitarian political philosophy represents a genuine methodological break versus a continuation of underlying commitments under a different theoretical vocabulary. RELEVANCE: Directly engages the "why and how" question central to this domain -- whether Cohen's retreat from the primacy thesis should be read as rupture or continuity -- through critical engagement with Vrousalis's continuity-emphasizing reconstruction. POSITION: A more skeptical counterpoint to Vrousalis, probing where the continuity thesis about Cohen's trajectory is best supported and where it papers over real methodological discontinuities.},
    keywords = "continuity-rupture, trajectory, review, French-language, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{sypnowich2024cohen,
    author = "Sypnowich, Christine",
    title = "G. A. Cohen: Liberty, Justice and Equality",
    address = "Hoboken, NJ",
    year = "2024",
    note = "CORE ARGUMENT: A comprehensive study of Cohen's political thought spanning his Marxist and post-Marxist phases, examining how his work on freedom, equality, and justice developed out of, and in reaction against, the historical materialism of his earlier career. RELEVANCE: As a recent, comprehensive treatment by a scholar closely associated with Cohen (editor of The Egalitarian Conscience, a festschrift for Cohen), this book provides an up-to-date synthesis of how Cohen's later egalitarian liberalism relates to the historical materialism he increasingly qualified and eventually left behind. POSITION: A comprehensive intellectual study treating Cohen's career as a unified object of study across both its Marxist and post-Marxist phases.",
    keywords = "trajectory, political-philosophy, monograph, recent, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}
