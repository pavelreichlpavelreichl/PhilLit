@misc{elster1982marxism,
    author = "Elster, Jon",
    title = "Marxism, Functionalism, and Game Theory: The Case for Methodological Individualism",
    year = "1982",
    note = {CORE ARGUMENT: Elster's fullest statement of the case against Marxist functional explanation, arguing that functionalism in social science requires either an underlying causal mechanism (e.g., natural selection in biology) or intentional microfoundations, and that Marxist functional explanations of the Cohen type supply neither. He proposes game theory as the appropriate substitute for functionalist "consequence laws," reconstructing questions about class interest and revolutionary action as collective-action problems requiring individual-level strategic analysis rather than functional fit. RELEVANCE: This is Elster's most systematic single statement of the methodological-individualist critique that frames the whole debate beyond the 1980 review exchange already covered in Domain 1; it directly provoked the Van Parijs and Roemer replies below and set the terms ("black box," "filtering mechanism," "microfoundations") that later commentators (Wood, Schwartz, Pettit, Kincaid) all engage. POSITION: Methodological individualism / anti-functionalist critique of historical materialism.},
    keywords = "functional-explanation, methodological-individualism, microfoundations, game-theory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{vanparijs1982functionalist,
    author = "Van Parijs, Philippe",
    title = "Functionalist Marxism Rehabilitated: A Comment on Elster",
    year = "1982",
    note = {CORE ARGUMENT: Responding directly to Elster's companion piece in the same issue, Van Parijs argues that functional explanation in the social sciences does not require the same kind of mechanism (natural selection) that legitimates it in biology; a broader class of "equilibration" or self-stabilizing processes can license functional explanations of social institutions, so Elster's demand that Marxist functionalism be scrapped wholesale is too strong. RELEVANCE: Provides the most direct contemporaneous defense of Cohen-style functionalism against the 1982 Elster critique, articulating the "rehabilitation" strategy (broadening what counts as an adequate filtering mechanism) that later analytical Marxists and philosophers of social science (e.g., Pettit) develop further. POSITION: Qualified defense of functional explanation against methodological individualism.},
    keywords = "functional-explanation, methodological-individualism, teleology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{roemer1982methodological,
    author = "Roemer, John E.",
    title = "Methodological Individualism and Deductive Marxism",
    year = "1982",
    note = {CORE ARGUMENT: Roemer largely endorses Elster's demand that Marxist explanations be given individual-level (game-theoretic or equilibrium) microfoundations, but argues that this demand does not require abandoning the substantive explananda Cohen and other Marxists care about -- exploitation, class formation, systemic crisis tendencies -- since these can in principle be reconstructed deductively from models of individual optimizing behavior under structural constraints. RELEVANCE: This is Roemer's central specific contribution to the functionalism/microfoundations debate that the project explicitly asks for: it stakes out a position distinct from both Cohen's unreconstructed functionalism and Elster's largely negative critique, showing how "rational choice Marxism" proposed to supersede rather than simply reject Cohen's project. POSITION: Microfoundationalist reconstruction of Marxism (distinct from both Cohen's functionalism and Elster's largely negative critique).},
    keywords = "methodological-individualism, microfoundations, rational-choice-Marxism, Roemer, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{wood1986historical,
    author = "Wood, Allen W.",
    title = "Historical Materialism and Functional Explanation",
    year = "1986",
    note = "CORE ARGUMENT: Writing in an Inquiry symposium occasioned by Elster's Making Sense of Marx, Wood grants that Marx's own particular deployments of functional explanation may be defective, but argues that Elster's principled philosophical objection to functional explanation as such -- and his parallel dismissal of Marx's use of teleology -- rest on a caricature of what these explanatory forms actually claim, so the general case against functionalism and teleology in historical materialism is considerably weaker than Elster suggests. RELEVANCE: Directly connects the Cohen-Elster dispute to the general philosophy-of-science literature on functional and teleological explanation, defending the legitimacy in principle of the explanatory form Cohen employs even while conceding ground on particular applications -- a nuanced position between unqualified defense (Van Parijs) and Elster's rejection. POSITION: Defends the principled legitimacy of functional/teleological explanation against Elster's philosophical critique, while granting flaws in some of Marx's specific applications.",
    keywords = "functional-explanation, teleology, historical-materialism, philosophy-of-science, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This paper is a critical examination of one central theme in Jon Elster's Making Sense of Marx; Elster's defense of ‘methodological individualism’ in social science and his related critique of Marx's use of ‘functional explanation’. The paper does not quarrel with Elster's claim that the particular instances of functional explanation advanced by Marx are defective; what it criticizes is Elster's attempt to raise principled, philosophical objections to this type of explanation in the social sciences. It is argued that Elster's philosophical critique of functional explanation rests on a caricature of this kind of explanation, just as his critique of Marx's use of teleology in the philosophy of history rests on a caricature of the kinds of teleological claims Marx is concerned to make. The paper ends with a brief discussion of a recently published passage from Marx's notebooks of 1861–1863, where Elster claims to have found Marx explicitly criticizing capitalist exploitation as an injustice to the workers.",
    abstract_source = "openalex"
}

@misc{schwartz1993functional,
    author = "Schwartz, Justin",
    title = "Functional Explanation and Metaphysical Individualism",
    year = "1993",
    note = {CORE ARGUMENT: Schwartz argues, against both parties to the original dispute, that Elster's "mechanical" conception of explanation (requiring an intelligible causal process) actually provides a better basis for vindicating functional explanation than Cohen's own "nomological" conception, which cannot on its own adequately underwrite functional claims; he further argues that Elster's objection that functional explanation commits us to metaphysically bizarre collective subjects rests on an implausible, eliminativist reading of methodological individualism. RELEVANCE: Reframes the Cohen-Elster dispute by showing that Elster's own explanatory standards, properly applied, support rather than undermine functional explanation in social science -- a distinctive third position in the broader philosophy-of-science reception of the debate, alongside Wood's and Pettit's. POSITION: Defends functional explanation using Elster's own mechanical standard against Cohen's nomological account, while rejecting Elster's metaphysical-individualist objection to collective explananda.},
    keywords = "functional-explanation, methodological-individualism, mechanism, philosophy-of-science, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "G. A. Cohen defends and Jon Elster criticizes Marxist use of functional explanation. But Elster's mechanical conception of explanation is, contrary to Elster's claims, a better basis for vindication of functional explanation than Cohen's nomological conception, which cannot provide an adequate account of functional explanation. Elster also objects that functional explanation commits us to metaphysically bizarre collective subjects, but his argument requires an implausible reading of methodological individualism which involves an unattractive eliminativism about social phenomena.",
    abstract_source = "openalex"
}

@misc{pettit2000rational,
    author = "Pettit, Philip",
    title = "Rational Choice, Functional Selection and Empty Black Boxes",
    year = "2000",
    note = {CORE ARGUMENT: Pettit examines the "empty black box" objection -- the charge, central to Elster's critique of Cohen, that functional explanations are explanatorily vacuous unless they specify the selecting mechanism -- and argues that rational choice explanation itself is frequently open to the same objection, since appeals to agents' rationality often function as an unexplicated filtering assumption rather than a specified causal mechanism. RELEVANCE: Turns the central charge against Cohen's functionalism back onto its critics, showing that the "black box" problem Elster raised against Marxist functional explanation is a general feature of functional-selection reasoning (including much rational choice explanation), which sharpens rather than resolves the terms of the original Cohen-Elster dispute. POSITION: Symmetry thesis: functional and rational-choice explanations face structurally parallel "black box" worries.},
    keywords = "functional-explanation, rational-choice, black-box, philosophy-of-social-science, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In order to vindicate rational-choice theory as a mode of explaining social patterns in general - social patterns beyond the narrow range of economic behaviour - we have to recognize the legitimacy of explaining the resilience of certain patterns of behaviour: that is, explaining, not necessarily why they emerged or have been sustained, but why they are robust and reliable. And once we allow the legitimacy of explaining resilience, then we can see how functionalist theory may also serve us well in social science; we lose the basis - the empty black box argumenton which the rational-choice critique of the theory has mostly been grounded.",
    abstract_source = "openalex"
}

@misc{warren1988marx,
    author = "Warren, Mark",
    title = "Marx and Methodological Individualism",
    year = "1988",
    note = {CORE ARGUMENT: Warren argues that Marx's own theoretical practice is not straightforwardly holist or functionalist in the way Cohen's reconstruction suggests, nor straightforwardly individualist in Elster's sense; he reconstructs a distinctively "relational" or structural mode of explanation in Marx that resists assimilation to either side of the methodological individualism/holism dichotomy as usually posed in the Cohen-Elster debate. RELEVANCE: Complicates the binary the Cohen-Elster-Roemer exchange tends to assume, offering the review a resource for showing that the "holism vs. individualism" framing of the debate was itself contested territory among Marx scholars, not just among analytical Marxists. POSITION: Relational/structural alternative to both methodological individualism and functionalist holism.},
    keywords = "methodological-individualism, holism, Marx-scholarship, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{wolff1990methodological,
    author = "Wolff, Robert Paul",
    title = "Methodological Individualism and Marx: Some Remarks on Jon Elster, Game Theory, and Other Things",
    year = "1990",
    note = {CORE ARGUMENT: Wolff subjects Elster's game-theoretic reconstruction of Marx to critical scrutiny, arguing that the formal apparatus of game theory and rational choice does not deliver the explanatory gains Elster claims over functionalist or structural readings of Marx, and that methodological individualism as a general constraint on social explanation is less self-evidently correct than Elster and Roemer assume. RELEVANCE: Provides a skeptical outside assessment of the individualist alternative to Cohen's functionalism from a philosopher independent of the analytical Marxist circle, useful for showing that the individualist program itself drew criticism on its own methodological terms, cited in SEP's Analytical Marxism entry as evidence that methodological individualism has no necessary tie to rational choice explanation. RELATED\_SEP\_DISCUSSION: Cited in SEP's "Analytical Marxism" entry (section 3.2, Methodological Individualism) for the point that methodological individualism and rational choice explanation are conceptually separable commitments. POSITION: Critical of both Elster's game-theoretic individualism and the strong version of methodological individualism it presupposes.},
    keywords = "methodological-individualism, game-theory, Elster-critique, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    sep_context = {SEP "Analytical Marxism" (3.2 Methodological Individualism): cited for the claim that methodological individualism has "no necessary connection with rational choice explanations."},
    abstract = "In recent years, philosophers trained in the techniques and constrained by the style of what is known in the Anglo-American world as ‘analytic philosophy’ have in growing numbers undertaken to include within their methodological ambit the theories and insights of Karl Marx.",
    abstract_source = "openalex"
}

@misc{moggach1991monadic,
    author = "Moggach, Douglas",
    title = "Monadic Marxism",
    year = "1991",
    note = {CORE ARGUMENT: Moggach argues that Elster's methodological individualism rests on an impoverished, "monadic" conception of individual agents abstracted from the relational and social framework of production, so that Elster's rational choice reconstruction cannot adequately capture the interactive, teleological character of social reproduction and transformation that Cohen's functionalism (however imperfectly) was trying to model. RELEVANCE: Offers a sustained critique of Elster's individualism specifically as an alternative to Cohen's functional explanation, arguing that the individualist reconstruction sacrifices explanatory resources rather than replacing them, directly relevant to assessing whether Elster's critique of Cohen succeeds on its own terms. POSITION: Critical of Elster's methodological individualism from a broadly structuralist/relational standpoint sympathetic to holist explanation.},
    keywords = "methodological-individualism, Elster-critique, functional-explanation, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Elster's work unstably combines Leibnizian and utilitarian conceptions of action and offers various deconstructions of rationality and individuality. His method ological individualism gives an inadequate account of its privileged object, individual teleologies, and a distorted account of the relational framework of social reproduction and transformation. Elster has not properly conceptualized the relation of the teleological act to patterns of material and social causality, and his rational choice theory proves unable to accommodate the interactions of his postulated monadic individuals. His most recent work dearly illustrates the limits of an individualist approach, while remaining committed to its principles.",
    abstract_source = "openalex"
}

@misc{weldes1989marxism,
    author = "Weldes, Jutta",
    title = "Marxism and Methodological Individualism",
    year = "1989",
    note = "CORE ARGUMENT: Weldes surveys the methodological individualism debate as it developed within analytical Marxism after Elster, arguing that the individualist program, taken to its logical conclusion, undermines core explanatory ambitions of Marxist theory (class structure, systemic tendencies) that neither Elster nor Roemer's reconstructions adequately preserve, without endorsing an unreconstructed return to Cohen's functionalism either. RELEVANCE: Functions as a critical survey/stock-taking of the individualism side of the debate roughly contemporaneous with Roemer's and Elster's key statements, useful for the review's account of how the individualist program was received within Marxist theory more broadly. POSITION: Skeptical assessment of methodological individualism's adequacy for Marxist social theory.",
    keywords = "methodological-individualism, Marxist-theory, survey, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{carling2002analytical,
    author = "Carling, Alan",
    title = "Analytical Marxism and the Debate on Social Evolution",
    year = "2002",
    note = "CORE ARGUMENT: Carling reconstructs the analytical Marxist debate over functional explanation as fundamentally a debate about social evolution, arguing that Cohen's consequence explanations can be given a defensible selectionist reading modeled on evolutionary biology (competitive selection among social forms), which would answer Elster's mechanism objection without requiring full individualist microfoundations. RELEVANCE: Directly addresses the project's question of how the Cohen-Elster-Roemer debate connects to broader biology/social-science analogies for functional explanation, proposing an evolutionary-selection model as the missing mechanism Elster demanded. POSITION: Selectionist/evolutionary rehabilitation of Cohen's functionalism, extending the Van Parijs line of defense.",
    keywords = "functional-explanation, evolutionary-analogy, social-evolution, Medium, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "According to Erik Wright, Andrew Levine and Elliott Sober (1992, 50) a theory counts as historical only when it has built into it ‘the idea of direction’ . Both Darwinism and classical historical materialism are in their view genuinely historical theories: Darwinism because it posits (in the words of one authority) that ‘any population (with the properties of multiplication, heredity and variation) will evolve by natural selection so as to become better adapted to its environment’ (Smith 1975, 96); Marxism likewise because it portrays societies as developing so as to improve their forces of production. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

@misc{carling2006karl,
    author = "Carling, Alan",
    title = "Karl Marx's Theory of History and the Recovery of the Marxian Tradition",
    year = "2006",
    note = "CORE ARGUMENT: A retrospective assessment of Cohen's Karl Marx's Theory of History roughly a quarter-century after publication, Carling argues that the research program the book inaugurated -- including its functional-explanation apparatus -- retains vitality despite the individualist critiques of Elster and Roemer, provided contemporary defenders confront the negative legacy of Marxism's historical failures rather than treating the theory of history purely as an abstract methodological exercise. RELEVANCE: Offers a direct, decades-later stock-taking of Cohen's KMTH specifically, assessing what survived of the functional-explanation program after the Elster/Roemer critiques and situating that assessment within the wider fate of the Marxian tradition -- a natural bridge between the functional-explanation debate and the review's reception/legacy sections. POSITION: Sympathetic retrospective defense of the KMTH research program, including its functionalist core, against the individualist critiques.",
    keywords = "Cohen-reception, functional-explanation, retrospective, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The Marxist tradition consists of a distinctive combination of social and historical theory, socialist values and political practice, with secular materialist underpinnings. The theory of history inspired by G. A. Cohen's work retains its vitality as a research program, and the socialist value base is also in reasonable shape. Any recovery of the tradition needs however to confront the negative legacy of Marxism's historical past. The theory of history does influence socialist political practice, as has been assumed by most Marxists but denied by Cohen. This influence is not necessarily conducive to classical socialist goals, however, and a considerable tension exists between the most defensible version of historical materialism and socialism's anti-market values.",
    abstract_source = "openalex"
}

@misc{callinicos2004making,
    author = "Callinicos, Alex",
    title = "Making History",
    year = "2004",
    note = "CORE ARGUMENT: Callinicos develops a structurationist account of the relation between agency and social structure and, in the course of doing so, criticizes Cohen's functional explanation of production relations for failing to specify how individual agency mediates between the developmental tendency of the productive forces and the class struggles that supposedly bring compatible production relations about; he argues that a satisfactory account needs a theory of structural constraint and enablement rather than either unreconstructed functionalism or Elster-style individualist reduction. RELEVANCE: Represents a structuralist/Marxist (rather than analytical-Marxist) critique of Cohen's functionalism, offering the review a position distinct from both the individualist (Elster/Roemer) and defensive-functionalist (Van Parijs/Wright-Levine-Sober) camps, and connecting the functional-explanation debate to the broader structure/agency debate in social theory. POSITION: Structurationist critique of both Cohen's functionalism and Elster's individualism, seeking a middle path via a theory of structural constraint on agency.",
    keywords = "functional-explanation, structure-agency, Callinicos, structuralist-Marxism, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Making History is about the question - central to social theory - of how human agents draw their powers from the social structures they are involved in. Drawing on classical Marxism, analytical philosophy, and a wide range of historical writing, Alex Callinicos seeks to avoid two unacceptable extremes - dissolving the subject into an impersonal flux, as poststructuralists tend to - and treating social structures as the mere effects of individual action (for example, rational-choice theory). Among those discussed are Althusser, Anderson, Benjamin, Brenner, Cohen, Elster, Foucault, Giddens, Habermas, and Mann. Callinicos has written an extended introduction to this new edition that reviews developments since Making History was first published in 1987. This republication gives a new generation of readers access to an important intervention in Marxism and social theory.",
    abstract_source = "openalex"
}

@misc{wrightlevinesober1992reconstructing,
    author = "Wright, Erik Olin and Levine, Andrew and Sober, Elliott",
    title = "Reconstructing Marxism: Essays on Explanation and the Theory of History",
    year = "1992",
    address = "London/New York",
    note = {CORE ARGUMENT: Wright, Levine, and Sober -- the latter a philosopher of biology specializing in the logic of selection explanation -- jointly assess the explanatory apparatus of historical materialism after both Cohen's functionalism and Elster's individualist critique, arguing (echoing but developing Van Parijs) that functional explanations of social structure can be legitimate when a genuine, even if unspecified in detail, selection-like mechanism is plausible, while conceding significant ground to the individualist demand for mechanism specification in cases where no such process is evident. RELEVANCE: As a co-authored intervention explicitly bridging philosophy of biology (Sober) and analytical Marxist social theory (Wright, Levine), this book is the most sustained attempt to adjudicate the Cohen/Elster/Roemer/Van Parijs dispute by importing the biological literature on functional and selection explanation that the project's fourth key question specifically asks about. POSITION: Mediating position: functional explanation is conditionally legitimate given a plausible (if unspecified) selection mechanism, more permissive than Elster, more demanding than unreconstructed Cohen. RELATED\_SEP\_DISCUSSION: Cited repeatedly in SEP's "Analytical Marxism" entry (3.2 Methodological Individualism) on the separability of methodological individualism from rational choice explanation and from atomism about explanatory entities.},
    keywords = "functional-explanation, selection-explanation, philosophy-of-biology-analogy, historical-materialism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc",
    sep_context = {SEP "Analytical Marxism" (3.2 Methodological Individualism): cited (at pp. 110, 126) for distinguishing methodological individualism from both rational-choice explanation and "atomism" about explanatorily relevant entities.}
}

@misc{kincaid2002functionalist,
    author = "Kincaid, Harold",
    title = "Functionalist Successes and Excesses in the Social Sciences",
    year = "2002",
    note = "CORE ARGUMENT: Kincaid surveys functional explanation across the social sciences, distinguishing cases where functionalist reasoning has been explanatorily successful from cases (which he takes some Marxist functionalism to exemplify) where it overreaches by positing self-correcting social equilibria without adequate evidence of the requisite feedback or selection process. RELEVANCE: Situates the specific Cohen/Elster dispute within a general taxonomy of when functionalist explanation succeeds or fails in social science, giving the review a comparative framework for assessing Cohen's consequence explanation against other functionalist research programs. POSITION: Selectively permissive: functional explanation is sometimes legitimate in social science but requires case-by-case evidential support for the posited equilibrating process.",
    keywords = "functional-explanation, philosophy-of-social-science, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This paper presents a model of functional explanations as a species of ordinary causal explanation and argues that they are widespread for understandable reasons in the social sciences. The remainder of the paper then looks at specific functional explanations in the social research and examines the prospects and problems for those accounts.",
    abstract_source = "openalex"
}

@misc{vanbouwel2019mechanism,
    author = "Van Bouwel, Jeroen",
    title = "Do Mechanism-Based Social Explanations Make a Case for Methodological Individualism?",
    year = "2019",
    note = {CORE ARGUMENT: Van Bouwel examines the more recent "analytical sociology" turn toward mechanism-based explanation (which descends in part from Elster's mechanism demands) and argues that the availability of social mechanisms does not by itself vindicate methodological individualism, since mechanisms can operate at, or link, multiple levels rather than bottoming out uniquely in individual-level facts. RELEVANCE: Extends the mechanism-versus-functionalism question central to the Cohen-Elster dispute into contemporary philosophy of social science, showing that the "mechanism" demand Elster leveled against Cohen's functionalism does not straightforwardly settle the individualism/holism dispute even by today's mechanist standards. POSITION: Mechanism pluralism: mechanistic explanation is compatible with holist as well as individualist commitments, against a simple equation of "mechanism" with "microfoundations."},
    keywords = "mechanisms, methodological-individualism, contemporary-reception, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In the recent philosophy of social science literature, we notice an increasing support for mechanism-based social explanations. Earlier pleas for social mechanisms were often closely linked to defenses of methodological individualism. However, more recent contributions by, e.g. Daniel Little and Petri Ylikoski, seem to be loosening that link and develop a more sophisticated account-ascribing a less important role to microfoundations. In this paper, we want to review the impact of the social mechanisms-approach on methodological individualism and draw more radical conclusions with regard to the individualism/holism debate, severing the link between the social mechanisms-approach and individualism. Four steps will be taken in severing the link: (a) there are more than two levels of social explanation; (b) levels of explanation are perspectival, thus neither absolute, nor unique; (c) seeking microfoundations has a heuristic value, but so has seeking macrofoundations; (d) there are no general preference rules with respect to the level of social explanations. In conclusion, the answer to the title question is that the social mechanisms approach does not strengthen the case for methodological individualism",
    abstract_source = "core"
}

@misc{kumar2008pragmatist,
    author = "Kumar, Chandra",
    title = "A Pragmatist Spin on Analytical Marxism and Methodological Individualism",
    year = "2008",
    note = "CORE ARGUMENT: Kumar reassesses the analytical Marxist methodological individualism debate from a broadly pragmatist standpoint, arguing that the dispute over whether functional or individualist explanations are metaphysically required is often less important than pragmatic questions about which explanatory strategy is more fruitful for particular explanatory projects within Marxist social theory. RELEVANCE: Represents a 2000s-era extension of the debate that steps back from the metaphysical stakes emphasized by Elster and Cohen, offering the review a late, deflationary perspective on whether the functionalism/individualism dispute needed to be resolved in principle at all. POSITION: Pragmatist deflation of the methodological individualism/functionalism dispute.",
    keywords = "methodological-individualism, pragmatism, later-reception, Low, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The debates of the 1980s and 1990s on methodological individualism versus methodological holism have not been adequately resolved. Within analytical Marxism, G.A. Cohen, John Roemer, Jon Elster and others have come down in favour of methodological individualism as part of the effort to make analytical Marxism more ‘scientific’ and ‘rigorous’ than earlier versions of Marxism. In doing so they have presented methodological individualism as a necessary ingredient in ridding Marxism of obscurantism. This view is here challenged from a pragmatist philosophical perspective. It is argued that, from such a perspective, the debates between the individualists and holists should have been dissolved rather than resolved in favour of the individualists. It is suggested that such dissolution would even strengthen analytical Marxism by redirecting analytical energies towards real social and political problems in the contemporary world and away from endless methodological debate.",
    abstract_source = "openalex"
}
