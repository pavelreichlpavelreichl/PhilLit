@misc{roemer1986analyticalmarxism,
    editor = "Roemer, John E.",
    title = "Analytical Marxism",
    year = "1986",
    note = {CORE ARGUMENT: Foundational anthology collecting programmatic essays by Cohen, Elster, Van Parijs, Wright, and others that apply rational-choice, game-theoretic, and analytic-philosophical tools to core Marxian categories (exploitation, class, history, ideology). Roemer's introduction frames the volume as documenting a "new species in social theory," analytically sophisticated Marxism pursuing Marxian questions "with contemporary tools of logic, mathematics, and model building." Per SEP, the collection's title is the first print appearance of the "analytical Marxism" label (coined by Elster). RELEVANCE: This is the anthology that gave the September Group's project institutional and terminological consolidation, several years after Cohen's 1978 KMTH; several contributions (Roemer on exploitation, Wright on class) extend and complicate Cohen's functionalist reading of historical materialism in directions the project explores as later divergence. POSITION: Founding, self-defining document of the Analytical Marxism/September Group school.},
    keywords = "analytical-marxism, september-group, movement-formation, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{elster2011obscurantism,
    author = "Elster, Jon",
    title = "Hard and Soft Obscurantism in the Humanities and Social Sciences",
    year = "2011",
    abstract = {Abstract The paper argues that the contemporary social sciences and humanities are in a deep crisis, due to the prevalence of obscurantist arguments. Whereas many have denounced the "soft obscurantism" derived from what is sometimes called "French theory", the "hard obscurantism" of many forms of mathematical and statistical social science also deserves to be singled out for criticism. The paper further argues that obscurantism does not merely represent a waste of intellectual effort, but has caused harm to countless individuals, ranging from parents of autistic children to market investors. Finally the paper considers some of the psychological mechanisms that may sustain obscurantism and constitute obstacles to overcoming it.},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Distinguishes "hard" and "soft" obscurantism in the humanities and social sciences. In the course of the argument, Elster retrospectively characterizes his own earlier involvement in the September Group/analytical Marxism project as a case of "intellectual autophagy," concluding that "non-bullshit Marxism" turned out to be "largely an empty set," and that Marx's only remaining contribution of value concerns his normative conception of the good life as active, joint self-realization rather than his substantive social-scientific claims. RELEVANCE: Primary-source evidence, from one of the September Group's founding conveners, of the movement's internal fragmentation and the rational-choice wing's eventual retreat from the explanatory ambitions Cohen's KMTH had set out to defend; central to the project's account of AM's trajectory. POSITION: Terminal self-assessment of the rational-choice/Elster wing, in tension with Cohen's continued (if revised) defense of historical materialism.},
    keywords = "analytical-marxism, elster, rational-choice, fragmentation, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{przeworski2007capitalism,
    author = "Przeworski, Adam",
    editor = "Munck, Gerardo L. and Snyder, Richard",
    title = "Capitalism, Democracy, and Science",
    year = "2007",
    note = {CORE ARGUMENT: Autobiographical/retrospective chapter on Przeworski's career in comparative political economy, including reflection on his participation in, and 1993 departure (with Elster) from, the September Group. Przeworski explains the departure by suggesting the Group's original purpose — critically evaluating Marxism — had been completed, concluding "not much of Marxism is left and there really wasn't much more to learn." RELEVANCE: Primary testimony on the internal rupture between the September Group's "leavers" (Elster, Przeworski) and "remainers" (Cohen, Roemer, Wright, van Parijs), and on how a political-economy member's work diverged from Cohen's historical-materialist framework toward mainstream comparative democratic theory. POSITION: Exit narrative of the rational-choice/political-economy wing of analytical Marxism.},
    keywords = "analytical-marxism, september-group, przeworski, fragmentation, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc"
}

@misc{roemer2015testament,
    author = "Roemer, John E.",
    title = "Thoughts on G. A. Cohen's Final Testament",
    year = "2015",
    abstract = "Abstract I present briefly G. A. Cohen's theory of distributive justice, discuss the relationship that I think he believed held between human nature and justice, and offer thoughts on the feasibility of Cohenesque justice, or Cohenesque socialism. I introduce the idea of Kantian equilibrium, as a way of explaining how people cooperate. Expanding the domain of activities in which humans cooperate will, I believe, go a long way towards achieving Cohenesque socialism, and the history of human society suggests it is feasible to do so.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Roemer's response to Cohen's late/posthumous writings, assessing Cohen's career-long shift away from the explanatory, historical-materialist project of KMTH toward normative egalitarian political philosophy, and reflecting on what remains defensible in Cohen's Marxism from Roemer's own, by then largely post-Marxist, standpoint in political economy. RELEVANCE: Documents how two September Group co-founders' paths diverged after the KMTH-era debates — Cohen toward normative theory, Roemer toward market-socialist political economy — while remaining in direct dialogue about the legacy of Cohen's functionalist project. POSITION: Rational-choice/political-economy wing's assessment of the afterlife of Cohen's historical-materialist project.",
    keywords = "analytical-marxism, cohen, roemer, legacy, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{burawoy2020taleoftwomarxisms,
    author = "Burawoy, Michael",
    title = "A Tale of Two Marxisms: Remembering Erik Olin Wright (1947--2019)",
    year = "2020",
    abstract = "Intended to capture the entangled history of Marxism, Alvin Gouldner's two Marxisms also frame the intellectual biography of Erik Olin Wright. In the 1970s Wright's Scientific and Critical Marxisms were joined, but later they came apart as each developed its own autonomous trajectory. Erik's Scientific Marxism was the program of class analysis that first brought him international fame. Begun in graduate school, it tailed off in the last two decades of his life, when it played second fiddle to the Critical Marxism of the Real Utopias Project that Erik began in the early 1990s.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: Retrospective essay distinguishing Wright's "Scientific Marxism" — the class-structural, analytically rigorous program continuous with Cohen's and Roemer's project — from his later "Critical Marxism," the normatively driven Real Utopias Project, arguing the two frameworks increasingly diverged over the course of Wright's career and that the latter eventually predominated. RELEVANCE: Provides an assessed legacy of the class-analytic wing of analytical Marxism, tracing how Wright's engagement with Cohen-style structural/functional Marxism gave way to a more normative, utopian political project — a trajectory paralleling the wider movement's evolution documented elsewhere in this domain. POSITION: Sociological assessment, from within the Marxist tradition, of the class-analysis strand of analytical Marxism and its divergence from Cohen's original functionalist framework.},
    keywords = "analytical-marxism, erik-olin-wright, class-analysis, legacy, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{roberts1996analyticalmarxism,
    author = "Roberts, Marcus",
    title = "Analytical Marxism: A Critique",
    year = "1996",
    note = {CORE ARGUMENT: Book-length critical history charting what Roberts calls the "growth, development and ultimate dilution or disintegration" of the theses originally advanced by Cohen, Elster, and Roemer, arguing the Analytical Marxist project failed both on its own terms and as a form of Marxism more generally, and attributing part of this failure to the movement's institutional and social remoteness from practical politics (the "donnish remoteness of the whole project," in Roberts's phrase, quoted in SEP). RELEVANCE: The fullest sustained external historiographical critique of the September Group/analytical Marxism as a whole, directly engaging the adequacy of substituting rational-choice and methodological-individualist microfoundations for Cohen's original functionalist framework, and assessing the movement's overall trajectory. POSITION: Sympathetic-but-ultimately-negative outside assessment of analytical Marxism's coherence and political relevance; the primary target of Bertram's (1998) review-response in this domain.},
    sep_context = {SEP (Analytical Marxism entry) quotes Roberts on the "donnish remoteness of the whole project" as a critique of the September Group's academic insularity, and cites Roberts (1996: 14) for the claim that some September Group participants can be read as "remaining true to their analytical methods by slowly abandoning their Marxism" -- i.e. that the tension between "analytical" and "Marxist" commitments was resolved, for some members, in the analytical methods' favor.},
    keywords = "analytical-marxism, historiography, critique, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{wright2005fallingintomarxism,
    author = "Wright, Erik Olin",
    editor = "Sica, Alan and Turner, Stephen",
    title = "Falling into Marxism; Choosing to Stay",
    year = "2005",
    note = {CORE ARGUMENT: Autobiographical essay recounting Wright's intellectual formation as a Marxist sociologist and his participation in the September Group, describing its meeting practices (pre-circulated papers, biannual meetings), gender composition, and gradual evolution away from treating Marxism as "a comprehensive theoretical paradigm capable of constituting a general theory of history and society" toward a looser, shared egalitarian orientation among participants. RELEVANCE: A first-person institutional history of the September Group that is the primary documentary source (extensively cited by the SEP entry on Analytical Marxism) for reconstructing how the group formed after Cohen's KMTH, how it operated, and how its self-understanding changed over two decades. POSITION: Insider "remainer" account of the Group's evolution, written from a sociological class-analysis perspective rather than Cohen's philosophical one.},
    sep_context = {SEP (Analytical Marxism entry) draws extensively on this chapter for its institutional history of the September Group: for the group's practice of pre-circulating papers introduced by a discussant other than the author (Wright 2005a: 343-344); for the observation that the Group's early practices "reproduced, rather than challenged, the contemporary marginalisation of women in the relevant academic disciplines" (2005a: 344); for the claim that the 2000 decision to continue meeting biannually was motivated "as much by fellowship as strictly intellectual pay-offs" (2005a: 345); and for Wright's observation that by the mid-2000s even self-identified Marxists in the Group were less likely to treat Marxism as "a comprehensive theoretical paradigm capable of constituting a general theory of history and society" (2005a: 342).},
    keywords = "analytical-marxism, september-group, wright, institutional-history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc"
}

@misc{veneziani2012analyticalmarxism,
    author = "Veneziani, Roberto",
    title = "Analytical Marxism",
    year = "2012",
    abstract = "Abstract This paper provides a comprehensive survey of the literature on Analytical Marxism (AM) and analyses its relevance for social theory. AM is precisely defined and distinguished from Rational Choice Marxism (RCM). The different substantive implications of the two approaches are discussed: according to RCM, the role of Marxism in the social sciences is exhausted, whereas AM has reconstructed a set of propositions that aim to provide the foundations of a distinctive approach in social theory. The methodological debate around and within AM is analysed and the shortcomings of methodological individualism and rational choice theory are stressed, raising doubts on the claim that RCM is the only scientific approach to Marx's theory. Yet, wholesale rejections on a priori methodological or exegetical grounds are questioned. A focused, immanent critique of RCM is developed, which emphasizes the lack of an adequate analysis of structural constraints and endogenous preferences in RCM models. It is argued that the analysis of endogenous preferences and structural constraints is consistent with an anti-reductionist AM approach and it may provide the outline of a fertile, distinctive research programme in explanatory social theory that builds on the core of Marxism identified by AM.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Comprehensive survey that precisely defines Analytical Marxism (AM) and distinguishes it from the narrower "Rational Choice Marxism" (RCM), arguing that an anti-reductionist AM approach incorporating endogenous preferences and structural constraints remains consistent with, and can sustain, a distinctive research program in explanatory social theory building on the core insights AM identified in Marxism. RELEVANCE: Provides a systematic taxonomy of the movement's internal methodological divisions — separating the broader analytical-Marxist project (which Cohen's functionalism belongs to) from the narrower rational-choice/methodological-individualist current associated with Elster and (in places) Roemer — directly useful for mapping the functionalist-versus-rational-choice dispute this domain addresses. POSITION: Sympathetic economist's survey and partial defense of AM against both dismissive external critiques and overly reductionist RCM readings of the school.},
    keywords = "analytical-marxism, rational-choice-marxism, methodology, survey, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{heath2009habermas,
    author = "Heath, Joseph",
    title = "Habermas and Analytical Marxism",
    year = "2009",
    abstract = {John Roemer once described the 'intellectual foundations' of analytical Marxism as the recognition that, despite having a valid core, Marxism rested upon outdated social science. The solution, he believed, was to update the theory 'using state-of-the-art methods of analytical philosophy and "positivist" social science'. If one takes this definition literally, Jürgen Habermas' early work qualifies as that of an analytical Marxist. Yet although he developed his project in a way that was independent of the self-identified analytical Marxists, there are important points of convergence in their views. In particular, in their efforts to update Marxism, both Habermas and the analytical Marxists managed to talk themselves out of being Marxists in any recognizable sense of the term. This is a noteworthy outcome, given the differences in their points of departure. This article tracks the intellectual history of these two movements, in order to identify the tendencies that pushed this rather disparate group of theorists in the same direction.},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Traces the parallel intellectual trajectories of Habermas and the analytical Marxists, arguing that both groups, in trying to update Marxism with more defensible social-scientific and normative foundations, ended up "talking themselves out of being Marxists in any recognizable sense of the term" — despite starting from very different theoretical points of departure. RELEVANCE: Situates Cohen-inspired analytical Marxism within a broader mid-to-late twentieth-century pattern of Marxist revisionism, offering an external comparative vantage point on the movement's ultimate trajectory and what Heath diagnoses as its self-undermining logic. POSITION: Comparative intellectual-historical assessment, skeptical of analytical Marxism's (and critical theory's) long-run capacity to remain distinctively "Marxist."},
    keywords = "analytical-marxism, habermas, legacy, comparative, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{bertram1998analyticalmarxism,
    author = "Bertram, Christopher",
    title = "Analytical Marxism: A Critique",
    year = "1998",
    note = {CORE ARGUMENT: Review essay engaging Marcus Roberts's Analytical Marxism: A Critique, assessing Roberts's charge that AM's substitution of methodological individualism and rational choice for functional and dialectical explanation undermined the coherence of Marxist theory as a whole. RELEVANCE: Offers a contemporaneous, more sympathetic counter-reading of Roberts's critique from a position close to the analytical-Marxist tradition itself, showing that the movement's own assessment of its "impasse" (per Chitty's phrase, discussed in the SEP entry) was contested rather than settled. POSITION: Qualified defense of analytical Marxism against the most sustained published external historiographical critique (Roberts 1996).},
    keywords = "analytical-marxism, historiography, review, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{tarrit2015cohenmarxism,
    author = "Tarrit, Fabien",
    title = "G. A. Cohen and Marxism",
    year = "2015",
    abstract = "Abstract The philosopher Gerald A. Cohen died on the 5th of August 2009. His contributions were at first based on Marx's thought. He really appeared on the intellectual stage in 1978 with his Karl Marx's Theory of History: A Defence. Later on, he gradually departed from Marx's theory. He discussed the libertarian concept of self-ownership and the possibility of associating it with a Marxist approach, before entering into the normative debate around Rawls's Theory of Justice, while his Marxism was withering away. Based on Kantian philosophy, his critique of Rawls was that he allowed too little autonomy to individual choices. This paper discusses the consistency of Jerry Cohen's intellectual journey with regards to his relation with Marx's work.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Examines G.A. Cohen's specific relationship to Marxism across his career, from the functionalist historical materialism of KMTH to his later turn toward normative egalitarian political philosophy, situating Cohen's own trajectory within, and in relation to, the wider Analytical Marxist school he helped found. RELEVANCE: Directly addresses how Cohen's evolving self-positioning relative to Marxism — and relative to the other September Group members' divergent paths — should be understood, bearing on whether and in what sense Cohen remained committed to the theses of KMTH throughout his career; published in the same Analyse \& Kritik symposium issue as Roemer's companion piece on Cohen's "final testament." POSITION: Intellectual-historical reconstruction of Cohen's Marxism from a sympathetic Marxian-economics perspective.},
    keywords = "analytical-marxism, cohen, legacy, intellectual-history, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{casal2020feministcritique,
    author = "Casal, Paula",
    title = "G. A. Cohen's Historical Materialism: A Feminist Critique",
    year = "2020",
    abstract = "Forty years on, G. A. Cohen's reconstruction and defence of Marx's theory of history is still widely, and justifiably, considered the best of its kind, and it remains unsurpassed in clarity, argumentation and textual support. This article presents an under-explored critique of the theory that arises once we recognize that it is meant to apply to the circumstances of women as well as men. The article argues that, when extended to women, the reconstructed theory's predictions fail to materialize, its characterizations of historical stages fall apart, and its functional explanations appear implausible. In addition, although the theory claims to be able to explain the emergence and diffusion of different ideologies by their effects on productive development, it cannot plausibly explain the presence of sexist ideologies despite their pervasive and profound impact across history. The article concludes by showing that these flaws highlight the many respects in which Cohen's orthodox version of Marxism is a conservative ideology, and one that egalitarians in particular should view with suspicion. Once we analyse the different components of the theory, the idea of a right-wing Marxism no longer seems as odd as it sounds.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Subjects Cohen's historical materialism to feminist critique, examining how KMTH's central categories — productive forces, the primacy thesis, functional explanation of relations of production by productive forces — handle, or fail to handle, gender relations and social reproduction. RELEVANCE: Extends the critical reception of Cohen's theory into a dimension largely absent from the original 1970s–80s functional-explanation debates (covered in Domains 1 and 3), indicating a substantive gap that the predominantly male September Group itself did not address; relevant to the project's account of the theory's contested legacy. POSITION: External feminist critique of Cohen's specific formulation of historical materialism, distinct from both the functionalist-defense and rational-choice critiques already covered.",
    keywords = "cohen, historical-materialism, feminist-critique, legacy, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{leiter2002irrelevance,
    author = "Leiter, Brian",
    title = "Marxism and the Continuing Irrelevance of Normative Theory",
    year = "2002",
    note = "CORE ARGUMENT: Reviewing Cohen's If You're an Egalitarian, How Come You're So Rich? (2000), Leiter argues that Cohen's turn from the explanatory project of historical materialism toward normative political philosophy exemplifies a broader tendency among analytical Marxists to become continuous with mainstream liberal-egalitarian normative theory, thereby — in Leiter's critical view — abandoning what was distinctively Marxist and explanatorily ambitious about the original project. RELEVANCE: Directly engages the movement's trajectory question by tracking how its leading figure moved from defending historical materialism (KMTH, 1978) to defending normative egalitarianism, and offers a skeptical outside assessment of the value of that shift for Marxist theory. POSITION: Critical of the normative turn taken by Cohen and, by extension, much of later analytical Marxism, favoring explanatory social theory over normative political philosophy as Marxism's proper domain.",
    keywords = "cohen, normative-turn, legacy, review, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

