}

@misc{agar2003functionalexplanation,
    author = "Agar, Joly",
    title = "G. A. Cohen's Functional Explanation",
    year = "2003",
    note = "CORE ARGUMENT: Agar re-examines and ultimately rejects the functional explanation that underpins Cohen's account of the relations of production, explicitly framing the discussion in light of the book's recent (2000) republication and the reservations Cohen himself had by then expressed about the theory. RELEVANCE: Directly engages the functional-explanation methodology as it stood after Cohen's own qualifications, testing whether the post-1988/2000 restricted version survives criticisms that the original 1978 functionalism could not. POSITION: A critical assessment concluding that functional explanation remains untenable even in its qualified, post-revision form.",
    keywords = "functional-explanation, critique, republication, expanded-edition, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
