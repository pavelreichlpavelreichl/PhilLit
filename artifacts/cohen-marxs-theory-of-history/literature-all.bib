@misc{kennedy2005cohenmarxinterview,
    author = "Kennedy, Simon",
    title = "G.A. Cohen's Karl Marx's Theory of History: A Defence",
    year = "2005",
    note = "CORE ARGUMENT: Combines a review of Karl Marx's Theory of History (assessed across both the 1978 original and the 2000 expanded edition) with material drawn from an interview with Cohen, addressing why he came to qualify traditional historical materialism and how he understood the book's legacy within, and beyond, analytical Marxism. RELEVANCE: One of the few secondary sources that puts Cohen's own retrospective account of his retreat from strong historical materialism (as given directly by Cohen) alongside independent critical assessment of the 2000 edition's new material, making it a useful bridge between primary self-revision and secondary reception. POSITION: Sympathetic but critical retrospective assessment combining review and first-person testimony.",
    keywords = "review, interview, expanded-edition, self-revision, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{vrousalis2010visionofsocialism,
    author = "Vrousalis, Nicholas",
    title = "G. A. Cohen's Vision of Socialism",
    year = "2010",
    note = {CORE ARGUMENT: Vrousalis reconstructs the elements of Cohen's thinking about socialism chronologically across his "long intellectual voyage from Marxism to political philosophy," using Cohen's successive books as thematic signposts, and argues that a coherent vision of socialism -- organized around equality, community, and self-ownership -- can be pieced together across the trajectory. RELEVANCE: Offers a systematic secondary reconstruction of exactly the trajectory this domain investigates, treating Cohen's shift from historical materialism to egalitarian political philosophy as a continuous development rather than a clean break, and identifying which commitments persisted versus were revised. POSITION: A sympathetic reconstructive account arguing for underlying continuity beneath Cohen's overt theoretical retreats.},
    keywords = "trajectory, socialism, luck-egalitarianism, continuity, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{vrousalis2015politicalphilosophy,
    author = "Vrousalis, Nicholas",
    title = "The Political Philosophy of G.A. Cohen: Back to Socialist Basics",
    address = "New York",
    year = "2015",
    note = "CORE ARGUMENT: The first full-length study of Cohen's political philosophy, covering equality, freedom, fraternity, and his critical engagements with Marx, Nozick, and Rawls, and critically reconstructing how these diverse strands of Cohen's post-Marxist thought fit together in the context of contemporary political, economic, and social theory. RELEVANCE: The most extensive secondary treatment of the destination of Cohen's trajectory (his mature political philosophy), providing the fullest available account of how the positions Cohen arrived at after retreating from historical materialism relate back to the concerns of the 1978 book. POSITION: A systematic, largely sympathetic reconstruction of Cohen's post-Marxist political philosophy as continuous with, rather than a repudiation of, his socialist commitments.",
    keywords = "trajectory, political-philosophy, monograph, continuity, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{tarrit2023continuiteruptures,
    author = "Tarrit, Fabien",
    title = "Continuité et ruptures chez Cohen. À propos d'un livre de Nicholas Vrousalis",
    year = "2023",
    note = {CORE ARGUMENT: Reviewing Vrousalis's The Political Philosophy of G.A. Cohen, Tarrit organizes his discussion explicitly around the question of continuity and rupture in Cohen's intellectual development, assessing how far Cohen's turn from historical materialism to egalitarian political philosophy represents a genuine methodological break versus a continuation of underlying commitments under a different theoretical vocabulary. RELEVANCE: Directly engages the "why and how" question central to this domain -- whether Cohen's retreat from the primacy thesis should be read as rupture or continuity -- through critical engagement with Vrousalis's continuity-emphasizing reconstruction. POSITION: A more skeptical counterpoint to Vrousalis, probing where the continuity thesis about Cohen's trajectory is best supported and where it papers over real methodological discontinuities.},
    keywords = "continuity-rupture, trajectory, review, French-language, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{sypnowich2024cohen,
