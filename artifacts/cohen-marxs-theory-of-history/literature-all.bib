}

@misc{cohen2000reflectionsanalyticalmarxism,
    author = "Cohen, G. A.",
    title = "Introduction to the 2000 Edition: Reflections on Analytical Marxism",
    year = "2000",
    note = {CORE ARGUMENT: In this new introduction added to the expanded edition, Cohen offers a retrospective account of the origins and trajectory of analytical Marxism as an intellectual movement, registers explicit reservations about traditional historical materialism as originally reconstructed in 1978, and works through what the demise of Soviet-style communism implies for the theory's central claims. RELEVANCE: This is the primary textual site where Cohen, twenty-two years after the original Defence, publicly qualifies his own earlier commitments and situates the book's argument within a movement whose "further promise" he takes to lie increasingly in normative political philosophy rather than in historical materialism proper. POSITION: Cohen's own authoritative retrospective self-assessment, distinct from the original 1978 text and from the individual scope-limiting essays anthologized in History, Labour, and Freedom.},
    keywords = "self-revision, analytical-marxism, expanded-edition, trajectory, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, type:@incollection->@misc"
}

@misc{cohen1999marxismcollapse,
    author = "Cohen, G. A.",
    title = "Marxism after the Collapse of the Soviet Union",
