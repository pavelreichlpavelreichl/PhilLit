@misc{levine1980rationality,
    author = "Levine, Andrew and Wright, Erik Olin",
    title = "Rationality and Class Struggle",
    year = "1980",
    abstract = "It is commonplace for writers on Marx, whether Marxists of various tendencies or critics of varying degrees of sympathy for Marxism, to hold that among Marx's major theoretical achievements was the inauguration of a new 'theory' of history, designated 'historical materialism'. While aspects of this theory were intimated . . .",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Levine and Wright argue that the relations of production, rather than the productive forces, should be assigned explanatory primacy in historical materialism. They contend that class struggle -- conducted by agents whose interests and capacities are structured by given relations of production -- provides the mechanism that actually drives both the development of the productive forces and the transformation of the relations of production, so that Cohen's functional explanation of relations by forces gets the direction of dependency backwards or at least incomplete. RELEVANCE: This is the founding statement of the "relations/class-struggle primacy" position that this domain tracks, and the direct target (or shared reference point) of nearly every other entry here. It supplies the review's clearest articulation of the alternative to Cohen's development thesis and is essential for framing why critics call Cohen's primacy thesis "technological determinism." POSITION: Relations-of-production/class-struggle primacy, articulated from within analytical Marxism.},
    keywords = "primacy-thesis, class-struggle-primacy, technological-determinism, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{ruben1981cohen,
    author = "Ruben, David-Hillel",
    title = "Cohen, Marx and the Primacy Thesis",
    year = "1981",
    abstract = "As Jon Elster remarked in an earlier review, G. A. Cohen's Karl Marx's Theory of History: A Defence 'sets a new standard for Marxist philosophy'. In one way, the praise is too faint. Existing paradigms of continental Marxist philosophy are marred by an absence of careful definition, clear and precise argumentation, and the sort of sustained discussion that is committed to the teasing out of the intellectual difficulties of the author's own position -- in short, marred by an absence of those virtues in the attainment of which the philosophy practised in Britain, the United States, and the Scandinavian countries on the whole excels.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Writing shortly after Cohen's book and Levine and Wright's article, Ruben examines the primacy thesis's claim that the character of the relations of production is explained by the level of development of the productive forces, probing whether Cohen's functional-explanation strategy actually secures the explanatory priority he claims for the forces over the relations. RELEVANCE: As one of the earliest journal-length responses focused specifically on the primacy thesis (rather than on Cohen's book as a whole), it documents how quickly and precisely the "primacy" question became a discrete point of contention distinct from broader disputes about functional explanation, and it helps the review establish the immediate critical reception of the 1978/1980 primacy-thesis debate. POSITION: Diagnostic critique of the primacy thesis's explanatory structure, sympathetic to Cohen's rigor but skeptical of the primacy claim itself.},
    keywords = "primacy-thesis, functional-explanation, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{suchting1982productive,
    author = "Suchting, Wal",
    title = {"Productive Forces" and "Relations of Production" in Marx},
    year = "1982",
    abstract = {This paper criticises the view that, according to Marx, "productive forces" determine "relations of production" and that the growth of the former basically determines the course of history. The particular version of this account discussed is that to be found in G.A. Cohen's Karl Marx's Theory of History: A Defence. The main part of this criticism involves a presentation of what, it is suggested, was in fact Marx's conception of "productive forces", "relations of production" and their relations, and an identification of class-struggle as the primary factor at least for the historically significant periods with which Marx was concerned.},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Suchting rejects the technological-determinist reading of Marx directly, arguing on textual grounds that Marx's own conceptions of "productive forces" and "relations of production" do not support the claim that the growth of the forces basically determines historical development; instead, class struggle is identified as the primary explanatory factor in the epochal transitions Marx actually analyzed. RELEVANCE: Part of the 1982 Analyse \& Kritik special issue devoted to Cohen's book, this paper offers a sustained textual counter-reading to Cohen's, making it central evidence for the review's treatment of the "is Cohen's reading of Marx correct?" question that underlies the primacy-thesis debate. POSITION: Relations-of-production/class-struggle primacy, argued on exegetical grounds.},
    keywords = "primacy-thesis, class-struggle-primacy, textual-critique, Analyse-und-Kritik, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{fisk1982concept,
    author = "Fisk, Milton",
    title = "The Concept of Primacy in Historical Explanation",
    year = "1982",
    abstract = {G.A. Cohen interprets Marx as a technological materialist: the productive forces are "primary" in history. There are several mistakes here. First, for Marx technology is neither always nor predominantly the direct stimulus -- either causal or functional -- of the social relations of production. Second, it is not even the case that for Marx primacy in explanation is a matter of being a direct stimulus. It has to do rather with being a framework that underlies interconnections between direct stimuli and their results. It turns out that this framework cannot be technology but only the relations of production. Third, technological development is not an autonomous process but is for Marx one that is dependent on the cooperation of producers. This introduces the political element of the class struggle into technological development and refutes a technological reading of why a given class rules.},
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Fisk distinguishes different senses "primacy" could bear in historical explanation and argues that on the sense that actually matters -- being the underlying framework governing interconnections between causes and effects, rather than being a direct stimulus -- only the relations of production, not technology, can be primary. He further argues that technological development itself is not autonomous but depends on producers' cooperation, which reintroduces class struggle as a condition of technological change and undercuts Cohen's technological reading of class rule. RELEVANCE: Also from the 1982 Analyse \& Kritik special issue, this paper gives the review a precise conceptual apparatus (direct-stimulus primacy vs. framework primacy) for analyzing exactly what is and is not being claimed by "the primacy of the productive forces," complementing Suchting's textual critique with a more analytic one. POSITION: Relations-of-production primacy, argued by distinguishing senses of explanatory primacy and reintroducing class struggle as a condition of technological development.},
    keywords = "primacy-thesis, class-struggle-primacy, explanatory-primacy, Analyse-und-Kritik, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{gottlieb1987historical,
    author = "Gottlieb, Roger S.",
    title = "Historical Materialism, Historical Laws and Social Primacy: Further Discussion of the Transition Debate",
    year = "1987",
    note = {CORE ARGUMENT: Gottlieb continues the "transition debate" over feudalism's replacement by capitalism, examining whether Cohen-style "historical laws" grounded in the primacy of the productive forces can account for the social-property transformations at stake, or whether an independent, non-derivative appeal to class struggle and political power is required to explain which social forms actually emerge. RELEVANCE: This article connects the primacy-thesis debate to the empirical/historical-plausibility question the domain is asked to investigate: it tests the development thesis against concrete historiographical disputes about feudal-to-capitalist transition rather than treating primacy purely as an a priori conceptual matter. POSITION: Class-struggle/political-primacy critique of technologically grounded historical laws, situated within the Brenner-inflected transition debate. NOTE ON SOURCES: No abstract was recoverable from Semantic Scholar, OpenAlex, or CORE for this entry; the summary above is based on the verified title, venue, and its documented place (via co-indexed citing literature) in the "transition debate" over social primacy. Marked INCOMPLETE for synthesis purposes pending fuller access to the text.},
    keywords = "primacy-thesis, class-struggle-primacy, transition-debate, INCOMPLETE, Medium, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{mills1989immaterial,
    author = "Mills, Charles W.",
    title = "Is It Immaterial That There's a 'Material' in 'Historical Materialism'?",
    year = "1989",
    abstract = "G. A. Cohen's influential 'technological determinist' reading of Marx's theory of history rests in part on an interpretation of Marx's use of 'material' whose idiosyncrasy has been insufficiently noticed. Cohen takes historical materialism to be asserting the determination of the social by the material/asocial, viz. 'socio-neutral' facts about human nature and human rationality which manifest themselves in a historical tendency for the forces of production to develop. This paper reviews Marx's writings to demonstrate the extensive textual evidence in favour of the traditional interpretation -- that for Marx, the 'material' includes the economic, and is thus ineluctably social in character. Thus those critics of Cohen who have urged the inclusion of the relations of production in historical materialism's explanans do seem to have Marx's terminological and conceptual backing.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Mills argues that Cohen's "technological determinist" reading depends on an idiosyncratic construal of Marx's term "material" as socio-neutral fact about human nature and rationality. Marshalling textual evidence, Mills contends that for Marx the "material" is ineluctably social/economic, so that critics who want the relations of production folded into the very explanans of historical materialism have Marx's own terminology on their side. RELEVANCE: This is a distinct line of attack from the class-struggle-primacy papers: rather than arguing that class struggle does the explanatory work Cohen assigns to the forces, Mills attacks the terminological/conceptual foundation of Cohen's technological reading itself, showing that even the definitional starting point of "historical materialism" is contested. It broadens the review's account of technological-determinism critiques beyond the Levine-Wright line. POSITION: Textual/philological critique of the technological-determinist reading of "material," supporting relations-of-production-inclusive alternatives.},
    keywords = "technological-determinism, textual-critique, historical-materialism, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{carling1993analytical,
    author = "Carling, Alan",
    title = "Analytical Marxism and Historical Materialism: The Debate on Social Evolution",
    year = "1993",
    abstract = "Darwinian evolutionary theory marries a genetic account of the origin of species to a selectionist account of their subsequent fate. The Marxian theory of history is analogous: class struggle provides an account of the origins of new regimes of production and selection pressures explain their subsequent history. The theory is technologically determinist, but there are three distinct doctrines ascribing primacy in different ways to the technological forces of production over the social relations of production. Natural Primacy is probably true but of limited relevance to the debate about historical process. Intentional Primacy, as advocated by G. A. Cohen, is untenable. Competitive Primacy is a genuinely evolutionary doctrine that may even be true.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Carling distinguishes three doctrines that could each be called "primacy of the productive forces": Natural Primacy (true but historically inert), Intentional Primacy (Cohen's own doctrine, which Carling judges untenable), and Competitive Primacy (an evolutionary, selection-based doctrine on which class struggle explains the origin of new production regimes while competitive/selective pressures explain their subsequent survival, which Carling thinks may be defensible). RELEVANCE: Carling supplies a typology that lets the review precisely locate where Cohen's own version of the primacy thesis fails while showing that "primacy of the productive forces" need not be abandoned wholesale -- an evolutionary, class-struggle-inflected version might survive. This nuances the domain's overall verdict and sets up Chibber's later assessment of whether Carling's rescue attempt actually succeeds. POSITION: Rejects Cohen's "Intentional Primacy" while defending a class-struggle-based "Competitive Primacy" as a distinct, more defensible reconstruction of historical materialism.},
    keywords = "primacy-thesis, class-struggle-primacy, analytical-Marxism, social-evolution, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{laibman2006end,
    author = "Laibman, David",
    title = "The End of History? The Problem of Agency and Change in Historical Materialist Theory",
    year = "2006",
    abstract = "The project of developing a theoretically rigorous and fruitful historical materialism, launched by G. A. Cohen in the late 1970s, led to a wealth of new directions: concept clarification, various new proposals for substantiating productive forces primacy and directionality, and much work on specific historical periods, especially the English/Western European transition to capitalism. All of this needs to be re-integrated into a general theoretical framework, one that both captures the common core in social evolution, and elucidates the rich variety of forms and experiences in which that core is embodied. Directedness and necessity in historical transformation do not contradict or undermine agency, specificity and cultural variety; on the contrary, they enable us to make full use of the vast array of possibilities in the service of progress.",
    abstract_source = "openalex",
    note = "CORE ARGUMENT: Laibman surveys the research program Cohen's book launched -- concept clarification, new proposals for substantiating productive-forces primacy, and detailed historical work on the transition to capitalism -- and argues that agency, specificity, and cultural variety still need to be properly re-integrated into a general theoretical framework of social evolution; he maintains, against voluntarist readings, that directedness and necessity in historical change do not preclude agency. RELEVANCE: Writing nearly three decades after Cohen's book, Laibman offers a programmatic stock-taking from within analytical Marxism of how far the primacy-thesis research program has (and has not) resolved the agency/class-struggle problem, giving the review a mid-point retrospective between the 1980s critiques and Chibber's 2011 verdict. POSITION: Reconstructive defense of a (revised) productive-forces primacy framework that seeks to accommodate agency and class struggle rather than replace primacy with a class-struggle theory.",
    keywords = "primacy-thesis, agency, historical-materialism, analytical-Marxism, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{chibber2011living,
    author = "Chibber, Vivek",
    title = "What Is Living and What Is Dead in the Marxist Theory of History",
    year = "2011",
    abstract = "During the 1980s and 1990s, the debate on the Marxist theory of history centred largely around the work of Robert Brenner's property-relations-centred construal of it, and G.A. Cohen's attempt to revive the classical, determinist argument. This article examines two influential arguments by Erik Wright and his colleagues, and by Alan Carling, which acknowledge important weaknesses in Cohen's work, but which also try to construct a more plausible version of his theory. I show that the attempts to rescue Cohen are largely unsuccessful. And, to the extent that they render the argument plausible, they do so at the cost of turning it, willy-nilly, into a kind of class-struggle theory. I conclude that this spells the demise of the classical version of historical materialism, but also observe that this does not leave us with a voluntaristic understanding of history, as some of its defenders fear.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Chibber examines the two most influential attempts to rescue Cohen's primacy thesis -- Wright and colleagues' (Levine-Wright/Reconstructing Marxism) rational-choice-based reconstruction and Carling's evolutionary reconstruction -- and argues both succeed only by quietly converting historical materialism into a class-struggle theory, which amounts to abandoning rather than defending the classical, technologically determinist primacy thesis. He insists, however, that this "demise" does not entail a purely voluntaristic view of history. RELEVANCE: This is the domain's most direct retrospective verdict on the entire Levine-Wright-to-Carling line of argument, making it the natural capstone for a synthesis section on "does any version of the primacy thesis survive its Marxist critics?" It ties together nearly every other entry in this domain into a single assessment. POSITION: Concludes that the primacy thesis cannot be rescued in any form that preserves technological determinism; the surviving reconstructions are, in substance, class-struggle theories of history.},
    keywords = "primacy-thesis, class-struggle-primacy, technological-determinism, analytical-Marxism, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}
