@misc{taylor1980criticalnotice,
    author = "Taylor, Charles",
    title = "G. A. Cohen Karl Marx's Theory of History: A Defense. Oxford: Clarendon Press, 1978. Pp. xvi and 369",
    year = "1980",
    note = {CORE ARGUMENT: Published as a "Critical Notice" — the Canadian Journal of Philosophy's format for extended, argument-focused review essays — Taylor's piece is reported (in secondary characterizations of the same journal issue) to make Cohen's use of functional explanation the central object of critical discussion, treating the functionalist reconstruction of the base/superstructure relationship as the pivotal methodological commitment the book asks readers to accept. Full text of Taylor's specific objections was not recoverable from indexed sources. RELEVANCE: As one of the earliest substantial engagements with the book by a major philosopher working outside analytical Marxism, Taylor's notice shows that the functional-explanation controversy (Elster's review, Cohen's replies, catalogued in Domain 1) was not an isolated exchange internal to analytical Marxism but the issue around which the wider philosophical reception organized itself almost immediately. POSITION: Independent (non-Marxist) critical engagement centering on functionalist methodology rather than on textual/exegetical questions about Marx.},
    keywords = "functional-explanation, contemporary-reception, methodology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{mcbride1982tendencies,
    author = "McBride, William L.",
