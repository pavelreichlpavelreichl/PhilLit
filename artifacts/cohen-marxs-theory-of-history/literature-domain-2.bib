    year = "1982",
    note = {CORE ARGUMENT: McBride's review essay assesses Cohen's book alongside four contemporaneous studies of Marx's theory of history — Michel Henry's two-volume phenomenological reading of Marx, John McMurtry's structural account, and Melvin Rader's interpretive study — using the juxtaposition to characterize what is distinctive about Cohen's analytically rigorous, technically argued reconstruction relative to competing continental-phenomenological and more traditionally exegetical approaches to Marx's theory of history ("Marxology"). RELEVANCE: Situates Cohen's book within the wider landscape of late-1970s scholarship on Marx's theory of history rather than treating it in isolation, evidencing that reviewers were already using Cohen's analytical reconstruction as a benchmark against which rival interpretive traditions were measured within four years of publication. POSITION: Comparative assessment from within general Marx scholarship, evaluating Cohen's contribution relative to competing interpretive traditions rather than engaging narrowly with functional explanation or the primacy thesis.},
    keywords = "contemporary-reception, comparative-marxology, exegesis, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{shaw1979handmill,
    author = "Shaw, William H.",
    title = {"The Handmill Gives You the Feudal Lord": Marx's Technological Determinism},
    year = "1979",
    note = {CORE ARGUMENT: Shaw argues against the then-common view among Marxist scholars that technological determinism is a "vulgar" misreading of Marx, contending instead that the themes of the 1859 Preface to A Contribution to the Critique of Political Economy pervade Marx's wider corpus and correspondence. On Shaw's textual reconstruction, Marx held that the productive forces form the material basis of society and determine its economic, political, and religious structures — an explanatory priority defended through close reading of Marx's letters and later writings rather than through Cohen's functional-explanation apparatus. RELEVANCE: Published the year after Cohen's book, this article mounts an independent, exegetically driven defense of the same 1859 Preface reading that underwrites Cohen's Primacy Thesis, showing that the technological-determinist interpretation of historical materialism had a parallel textual champion working by different (non-functionalist) argumentative means. It anchors Shaw's subsequent decade-long engagement with Cohen's reconstruction (cf. Shaw's 1986 "Historical Materialism and the Development Thesis," already catalogued in Domain 1) and bears directly on this domain's question of whether reviewers disputed Cohen's exegetical claims about the 1859 Preface — Shaw independently corroborates rather than contests that reading, while relying on different textual evidence than Cohen adduces. POSITION: Textually grounded defense of technological determinism as Marx's own view, argued independently of Cohen's functional-explanation strategy and predating the bulk of the functional-explanation controversy.},
    keywords = "technological-determinism, primacy-thesis, 1859-preface, exegesis, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Une defense de l'interpretation de la theorie de l'histoire de Marx comme une theorie de determinisme technologique. Les forces productrices de l'homme, le materialisme historique.",
    abstract_source = "openalex"
}

@misc{rogers1981review,
    author = "Rogers, Ann",
    title = {Review of G. Cohen's "Karl Marx's Theory of History – A Defence"},
    year = "1981",
    howpublished = "International Socialism, series 2, no. 12, pp. 125--128, \url{https://www.marxists.org/history/etol/newspape/isj2/1981/isj2-012/rogers.html}",
    note = {CORE ARGUMENT: Writing from within the revolutionary-socialist (International Socialist) tradition, Rogers argues that Cohen's defense of historical materialism, for all its technical rigor, ends up undermining Marxism as a theory of revolutionary agency. She contends Cohen must treat counterevidence to the Development Thesis (e.g., the decline of productive forces in the fall of Rome) as "historical pathology," an ad hoc device rather than a principled response to capitalism's internal contradictions; that his appeal to fixed traits of "rational" human nature to explain the tendential development of the productive forces conflates biological with socially conditioned attributes, implicitly naturalizing worker passivity; and, most consequentially, that Cohen's framework cannot specify when class struggle becomes politically decisive or explain how the proletariat is to seize power, replacing revolutionary rupture with vague "broad alliance" building. RELEVANCE: Offers the domain's clearest statement of an early political (rather than narrowly philosophical) objection to Cohen's reconstruction: that the technological-determinist, functionalist framework evacuates class struggle as an independent causal-political force and licenses a reformist rather than revolutionary politics. This objection recurs, in more academic register, in later debates about the "primacy" of productive forces versus relations of production and class struggle (cf. Suchting 1982 in Domain 1). POSITION: Revolutionary-socialist political critique, arguing that Cohen's technological determinism is reformist in its political implications regardless of its philosophical sophistication.},
    keywords = "contemporary-reception, class-struggle, political-critique, web-source, High, INCOMPLETE, no-abstract"
}

