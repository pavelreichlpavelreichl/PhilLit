@misc{sayers1984dialecticalmethod,
    author = "Sayers, Sean",
    title = "Marxism and the Dialectical Method: A Critique of G.A. Cohen",
    year = "1984",
    note = {CORE ARGUMENT: Sayers argues that Cohen's KMTH gives an account of Marxism in "entirely non-dialectical -- indeed, in anti-dialectical -- terms," stripping out the Hegelian dialectical method (the categories of contradiction, totality, and internal relation) that Sayers holds is indispensable to Marx's own theory of history; he seeks to show that this dialectical method, not Cohen's analytic functional-explanation apparatus, is the necessary basis for an adequate Marxist theory of history. RELEVANCE: This is the clearest instance in the literature of a Hegelian-Marxist methodological critique aimed directly at KMTH, providing the review's main textual anchor for the "Hegelian Marxism versus analytical Marxism" debate that Key Question 4 asks about; it is repeatedly cited as a standard reference point by later commentators on Cohen (e.g., Dickman 1990, Mills 1989, Tarrit 2015). POSITION: Dialectical-Hegelian Marxist critique holding that Cohen's rational reconstruction, by discarding dialectics, cannot capture Marx's actual theory of history.},
    keywords = "hegelian-marxism, dialectical-method, cohen-critique, historicist, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{green1984egalitarian,
    author = "Green, David G.",
    title = "An Egalitarian Epistemology: A Note on E. P. Thompson's Critique of Althusser and Popper",
    year = "1984",
    note = {CORE ARGUMENT: Green analyzes the epistemological commitments underlying E.P. Thompson's Poverty of Theory polemic, identifying its target as the "theoreticism" Thompson attributed jointly to Althusserian structuralism and, more surprisingly, to Popperian philosophy of science, and reconstructs the "egalitarian epistemology" -- the idea that historical evidence can discipline theory from outside any given theoretical framework -- that underlies Thompson's position. RELEVANCE: Confirms empirically, rather than assuming, that Thompson's 1978 critique was aimed at Althusser and Popper and not at Cohen's contemporaneously published KMTH; this article is the review's primary evidentiary basis for concluding that no direct Thompson-Cohen engagement exists in the published record. POSITION: Reconstructs Thompson's target as Althusserian structuralism (plus Popperian philosophy of science), independently confirming the absence of any Cohen-directed argument in Thompson's polemic.},
    keywords = "thompson, poverty-of-theory, althusser, historicist, verification, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{delvallealcala2013multitude,
    author = "del Valle Alcalá, Roberto",
    title = "A Multitude of Hopes: Humanism and Subjectivity in E.P. Thompson and Antonio Negri",
    year = "2012",
    abstract = "E.P. Thompson's work on working-class formation is widely recognized as one of the crucial contributions to Marxist historiography in the twentieth century. His emphasis on notions of agency and subjectivity is intimately linked to a radical recasting of the socialist agenda against the objectivism of an earlier, 'orthodox', Marxism and of a later, and more theoretically sophisticated, structuralism. Thompson's conception of working-class agency as the primary element in historical materialism parallels Antonio Negri's theorization of proletarian subjectivity as an expansive process of collective self-constitution. In particular, Negri's analysis of 'power' as an autonomous dynamic of social creation offers an essential development of Thompson's ideas and a fresh theoretical template for the political re-actualization of radical humanism.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Del Valle Alcala reconstructs Thompson's conception of working-class agency and subjectivity as the organizing principle of his historical materialism, opposed to the "objectivism" of both orthodox (base-superstructure) Marxism and Althusserian structuralism, and traces affinities between this agency-centered historicism and Antonio Negri's theory of proletarian subjectivity. RELEVANCE: Provides the review's fullest secondary account of the theoretical commitments of Thompson's historicist/agency tradition -- the tradition the domain's search strategy sought to connect directly to Cohen -- while corroborating (via its silence on Cohen and explicit naming of structuralism as Thompson's foil) that this tradition's quarrel was with structuralism, not with analytical Marxism. POSITION: Sympathetic reconstruction of Thompson's humanist, agency-centered historical materialism as a rival to both orthodox determinism and structuralist anti-humanism; substitutes for a direct Thompson-Cohen comparison that the literature does not contain.},
    keywords = "thompson, agency, historicist, structuralism, substitution, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{evans2020capitalism,
    author = "Evans, Justin",
    title = "Capitalism as a Space of Reasons: Analytic, Neo-Hegelian Marxism?",
    year = "2020",
    abstract = "I suggest that we can read Marx in the light of recent analytic, neo-Hegelian thought. I summarize the Pittsburgh School philosophers' claims about the myth of the given, the claim that human experience is conceptual all the way out, and that we live in a space of reasons. I show how Hegel has been read in those terms, and then apply that reading of Hegel to Marx's argument that capital is akin to what Hegel called Geist, or spirit. We can understand capitalism as a space of reasons that is contradictory: while the space of reasons is supposed to make human freedom possible, our space of reasons makes freedom impossible. Reading Marx in this way is helpful, because it avoids the flaws of analytical Marxism, existentialism and structuralism. However, it raises a large problem of its own: Can the theory of the space of reasons be applied to a society that is not free of alienation? I argue that it can, but only in ways that would not satisfy the analytic neo-Hegelians themselves.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Evans proposes reading Marx's Capital through "analytic neo-Hegelian" (Pittsburgh School: McDowell, Brandom) resources, treating capital as a contradictory "space of reasons" that both enables and forecloses human freedom, and argues this reading is preferable because it "avoids the flaws of analytical Marxism, existentialism and structuralism." RELEVANCE: Demonstrates that the "Hegelian Marxism versus analytical Marxism" methodological contrast Key Question 4 asks about remains a live, explicitly named alternative in recent literature, decades after Sayers's 1984 critique of Cohen, showing the durability of the Hegelian challenge to Cohen-style rational reconstruction. POSITION: Contemporary analytic-Hegelian synthesis explicitly positioned against analytical Marxism (Cohen's tradition) as well as against structuralism and existentialism.},
    keywords = "hegelian-marxism, analytical-marxism, method-debate, contemporary, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{hartsock2005feministstandpoint,
    author = "Hartsock, Nancy C. M.",
    title = "The Feminist Standpoint: Developing the Ground for a Specifically Feminist Historical Materialism",
    year = "2005",
    note = {CORE ARGUMENT: Hartsock develops a feminist standpoint epistemology modeled on the Marxist theory of proletarian standpoint, arguing that women's structural position within the sexual division of labor -- centrally, reproductive and domestic labor -- generates a standpoint from which the inadequacies of existing (masculinist) historical materialism become visible, and that historical materialism must be reconstructed to make gender relations, not just class relations, constitutive of its basic categories. RELEVANCE: One of the two founding texts (with Vogel 1983) of feminist historical materialism contemporaneous with KMTH; establishes the theoretical case that Cohen's forces/relations-of-production schema, built on an ungendered concept of "production," cannot by itself capture the material relations organizing women's oppression. POSITION: Feminist standpoint historical materialism -- reconstructs historical materialism's core categories around a gendered division of labor rather than extending Cohen's framework to include women.},
    keywords = "feminist-standpoint, historical-materialism, domestic-labor, foundational, High, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "The power of the Marxian critique of class domination stands as an implicit suggestion that feminists should consider the advantages of adopting a historical materialist approach to understanding phallocratic domination. A specifically feminist historical materialism might enable us to lay bare the laws of tendency which constitute the structure of patriarchy over time and to follow its development in and through the Western class societies on which Marx’s interest centered. A feminist materialism might in addition enable us to expand the Marxian account to include all human activity rather than focussing on activity more characteristic of males in capitalism. The development of such a historical and materialist account is a very large task, one which requires the political and theoretical contributions of many feminists. Here I will address only the question of the epistemological underpinnings such a materialism would require. Most specifically, I will attempt to develop, on the methodological base provided by Marxian theory, an important epistemological tool for understanding and opposing all forms of domination — a feminist standpoint.",
    abstract_source = "openalex"
}

@misc{vogel1983marxism,
    author = "Vogel, Lise",
    title = "Marxism and the Oppression of Women: Toward a Unitary Theory",
    year = "1983",
    address = "New Brunswick, NJ",
    note = {CORE ARGUMENT: Vogel revisits classical Marxian texts and Marx's category of the social production and reproduction of material life to develop a "unitary theory" of women's oppression under capitalism, arguing that domestic labor's function in reproducing labor-power ties women's subordination directly to the capitalist mode of production rather than treating patriarchy as an autonomous, transhistorical system running alongside it. RELEVANCE: The founding text of what became social-reproduction theory, and the domain's clearest instance of a feminist theorist working with, rather than against, historical-materialist categories of production and reproduction -- directly bearing on whether Cohen's forces/relations schema, which brackets reproduction as outside "production," can be defended once gender is taken seriously. POSITION: Unitary-theory social reproduction feminism -- women's oppression is explained through capitalism's structural need to reproduce labor-power, not through an independent patriarchal system.},
    keywords = "social-reproduction-theory, domestic-labor, unitary-theory, foundational, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{gimenez2018whatsmaterial,
    author = "Gimenez, Martha E.",
    title = "What's Material about Materialist Feminism? A Marxist-Feminist Critique",
    year = "2018",
    note = {CORE ARGUMENT: Gimenez, writing from an orthodox Marxist-feminist standpoint, criticizes strands of "materialist feminism" (e.g., French materialist feminism, Delphy) for substituting an ahistorical, universal category of "patriarchy" for Marx's historically specific categories of class and mode of production, arguing this move abandons rather than extends historical materialism's explanatory core. RELEVANCE: Offers a feminist voice that shares Cohen's commitment to production-centered, historically specific explanation while contesting how "materialist feminism" as a rival research program has handled gender -- giving the review a feminist position that is methodologically closer to, rather than opposed to, Cohen's orthodox historical-materialist commitments. POSITION: Orthodox Marxist-feminist critique of non-Marxist "materialist feminism," defending historically specific class categories against ahistorical patriarchy theory. Originally published 2000 in Radical Philosophy 101:18--28; cited here via its 2018 book-chapter republication, the version for which verified metadata was obtainable.},
    keywords = "marxist-feminism, materialist-feminism, patriarchy, orthodox-marxism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{kain1993marxhousework,
    author = "Kain, Philip J.",
    title = "Marx, Housework, and Alienation",
    year = "1993",
    note = "CORE ARGUMENT: Kain examines whether Marx's own conceptual apparatus -- particularly his theory of alienated versus unalienated labor -- can make sense of housework and childcare, arguing that Marx's categories allow housework to be understood simultaneously as a paradigm case of unalienated labor and as a site of the deepest oppression, a tension feminist theorists have read in sharply divergent ways. RELEVANCE: Tests directly whether Marx's (and by extension Cohen's) categories of production and labor can accommodate domestic labor at all, bearing on whether the forces/relations-of-production schema's silence about housework is a contingent omission or a structural blind spot. POSITION: Internal reconstruction of Marx's categories to show they contain the resources (however ambivalent) to theorize housework, rather than requiring wholesale replacement by an independent feminist framework.",
    keywords = "housework, alienation, domestic-labor, marx-categories, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "For different feminist theorists, housework and child rearing are viewed in very different ways. I argue that Marx gives us the categories that allow us to see why housework and child care can be both a paradigm of unalienated labor and also involve the greatest oppression. In developing this argument, a distinction is made between alienation and oppression and the conditions are discussed under which unalienated housework can become oppressive or can become alienated.",
    abstract_source = "openalex"
}

@misc{hensman2011revisiting,
    author = "Hensman, Rohini",
    title = "Revisiting the Domestic-Labour Debate: An Indian Perspective",
    year = "2011",
    note = {CORE ARGUMENT: Hensman revisits the 1970s domestic-labour debate from the vantage point of the Indian economy, arguing that the classical debate's frameworks (is domestic labor productive or unproductive labor? does it produce value?) need revision once informal-sector, non-Western, and globally uneven patterns of household and market labor are taken into account. RELEVANCE: Extends the domestic-labour debate's core question -- whether the value-producing "production" that anchors the forces/relations schema can or should include domestic labor -- beyond its original Western-industrial context, showing the continuing unsettled status of a question central to any defense of Cohen's productive-forces concept as gender-neutral. POSITION: Revisionist domestic-labour-debate position emphasizing global/Southern specificity against the classical debate's assumption of a uniform capitalist household.},
    keywords = "domestic-labor-debate, social-reproduction, global-south, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract The class-struggle under capitalism is shaped by the fact that for capital, labour-power is merely a factor of production and source of profit, whereas for workers it is an element of their own lives. Given the centrality of labour-power to the accumulation of capital, it is surprising that Marx nowhere describes or analyses its production. The domestic-labour debate of the 1970s was a useful attempt to fill this gap, but left many issues unresolved. This article attempts to carry forward this theoretical task, using examples mainly from India, and to draw practical conclusions for the working-class struggle.",
    abstract_source = "openalex"
}

@misc{ferguson2016intersectionality,
    author = "Ferguson, Susan",
    title = "Intersectionality and Social-Reproduction Feminisms",
    year = "2016",
    note = "CORE ARGUMENT: Ferguson argues that intersectionality and social-reproduction feminism, often treated as rival paradigms, are in fact complementary: social-reproduction theory's account of how capitalism organizes the reproduction of labor-power provides the material-structural analysis that intersectionality's attention to the co-constitution of race, gender, and class needs, while intersectionality corrects social-reproduction theory's historical tendency to underplay race. RELEVANCE: Shows the trajectory of the domestic-labour-debate tradition (Vogel, Hensman) into contemporary social-reproduction theory and its engagement with intersectionality, illustrating how far feminist reworkings of historical-materialist categories have moved beyond anything addressed in Cohen's framework or its 1980s-90s analytical-Marxist reception. POSITION: Synthesizes social-reproduction theory and intersectionality as complementary rather than competing feminist-materialist frameworks.",
    keywords = "social-reproduction-theory, intersectionality, contemporary, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Seeking to capture the multi-layered, contradictory, nature of subjectivities and social positions through a framework which insists upon the complex, dynamic nature of the social, intersectionality feminism has inspired Marxist-Feminists to push the social-reproduction feminism paradigm beyond a narrow preoccupation with gender/class relations. Yet even its most politically radical articulations stop short of fully theorising the integrative logic they espouse. This article explores the roots of this under-theorisation, and suggests that a more fully integrative ontology informs certain formulations of social-reproduction feminism. In understanding the social as constituted by practical human activity whose object (the social and natural world) is organised capitalistically, social-reproduction feminism highlights the dialectical relationship between the capitalist whole and its differentiated parts. The challenge for Marxist-Feminism is to embrace this dialectical approach while building on the insights of intersectionality feminism to more convincingly capture the unity of a complex, diverse social whole.",
    abstract_source = "openalex"
}

@misc{portellabusk2024formal,
    author = "Portella, Elizabeth and Busk, Larry Alan",
    title = "The Formal and Real Subsumption of Gender Relations",
    year = "2024",
    abstract = "Attempts to unify Marxist and feminist social critique have been vexed by the fact that 'patriarchy' predates the advent of capitalism (its transhistorical status). Feminists within the Marxist, socialist, and materialist traditions have responded to this point by either granting patriarchy a certain autonomy relative to capitalism (the 'dual/triple systems' approach), or by suggesting that patriarchal relations have a foundational and necessary status in the history of capitalist development (which we term the 'origins-subsistence' approach). This paper offers an alternative account of the relationship between capitalism and the transhistorical status of 'patriarchy'. In aid of a 'unitary theory' of Marxist Feminism, we argue that the transhistorical status of patriarchy is better understood through an application of Marx's concepts of formal and real subsumption. A modified version of these concepts can illuminate not only capitalist appropriation of antecedent social and economic forms, but also its capacity to produce new forms of gendered exploitation and oppression.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Portella and Busk argue that Marx's concepts of formal and real subsumption -- rather than either granting patriarchy autonomy from capitalism (dual/triple-systems theory) or treating it as foundational to capitalism's origins -- best explain how a transhistorical patriarchy is reorganized and intensified by, without being reducible to, capitalist relations of production. RELEVANCE: Directly engages the same problem the domain's key questions raise about Cohen's schema: how can a theory built on historically specific modes of production (Cohen's forces/relations distinction) account for a form of oppression (patriarchy) that predates and outlasts any particular mode of production? This is the most recent and theoretically sophisticated attempt in the literature to resolve that tension via internal Marxian categories. POSITION: "Unitary theory" Marxist feminism using formal/real subsumption to integrate transhistorical patriarchy into a historical-materialist framework centered on modes of production.},
    keywords = "social-reproduction-theory, patriarchy, subsumption, unitary-theory, contemporary, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}
