@misc{walzer1987interpretation,
    author = "Walzer, Michael",
    title = "Interpretation and Social Criticism",
    year = "1987",
    address = "Cambridge",
    note = "CORE ARGUMENT: Argues that social criticism does not need Archimedean or discovered/invented universal principles; the 'connected critic' interprets the shared meanings and moral understandings of her own society and criticises it for failing to live up to them. Morality is 'thick' and local; 'thin' universals are distilled from the thick by occasional reiteration. RELEVANCE: Canonical statement of the hermeneutic/communitarian version of internal critique and the primary object of conventionalism objections. Standards come from the society's own interpreted meanings; contradiction plays a minor role (the gap between professed meaning and practice, not an objective contradiction); critique is reconstructive-reformist and sceptical of progress narratives. Contrasts with Habermas's formal-pragmatic and Honneth's normative-reconstructive grounds. Bibliographic details confirmed via PhilPapers record only (not CrossRef). POSITION: Connected criticism / communitarian hermeneutics (internal critique rather than 'immanent critique' in the Hegelian sense).",
    keywords = "Walzer, connected criticism, internal critique, hermeneutics, communitarianism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{raz1991morality,
    author = "Raz, Joseph",
    title = "Morality as Interpretation: {Interpretation} and Social Criticism. {Michael} Walzer",
    year = "1991",
    note = "CORE ARGUMENT: Review essay on Walzer's Interpretation and Social Criticism, pressing the worry that interpretation of a society's shared meanings cannot by itself deliver critical standards independent of the society's actual practices (title and venue confirmed by CrossRef; argument summarised from the well-known thrust of the review, abstract unavailable). RELEVANCE: Sceptical voice on connected criticism: whether the 'interpretive' basis delivers critical purchase or collapses into conventionalism. Useful for Domain 5 cross-reference on the conservatism objection. POSITION: Sceptical/liberal-analytic response to Walzer's internal criticism.",
    keywords = "Walzer, conventionalism, sceptical voice, internal critique, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "With the growing interest in interpretation as an activity essential in the study of the arts and of society it was inevitable that the question of the relation between morality and interpretation would attract considerable interest. Given that moral views and arguments are expressed in language, are essentially language bound, there is no doubt that the understanding of moral views and argument involves, at least at times, interpretation (of arguments and propositions, etc.). The same can be said of physics. The question is whether morality is interpretative in a way in which physics is not. Some writers have claimed that it is. I will examine the claims and arguments to that effect advanced by Michael Walzer, though much of my argument will be general and not limited to the arguments he explicitly advances.'",
    abstract_source = "s2"
}

@misc{allen1998situated,
    author = "Allen, Jonathan",
    title = "The situated critic or the loyal critic? {Rorty} and {Walzer} on social criticism",
    year = "1998",
    volume = "24",
    note = "CORE ARGUMENT: Asks whether the 'connected' or 'loyal' model of social criticism advanced by Rorty and Walzer is adequate; argues loyalty is an internally conflicted concept with three components (recognition of situatedness in a relationship, affirmation of that relationship, and a set of values or local principles). RELEVANCE: Sceptical reading of connected criticism that puts pressure on loyalty as the critic's source of standards; locates Walzer relative to pragmatist ethnocentrism as a second 'internal' alternative to Habermasian reconstruction. POSITION: Walzer/Rorty comparison within communitarian-pragmatist internal criticism.",
    keywords = "Walzer, Rorty, connected criticism, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article addresses the question whether the model of social criticism as 'connected' or 'loyal' which is advanced by Richard Rorty and Michael Walzer offers an adequate picture of social criticism. Two claims are made. First, it is suggested that loyalty is an internally conflicted concept, with three components: a recognition of situatedness in a particu lar relationship; an affirmation of that relationship by the loyal agent; a set of values or local principles. Where the third component is prominent, loyalty is more reflective and distanced; where the second component predominates, loyalty slips into unreflective commitment. Second, it is argued that Rorty and Walzer conflate the social critic's recognition of his or her situatedness in contexts of power with the affirmation of that situ atedness. It is concluded that the model of loyal social criticism is mislead mg, and that the practice of the critic must be tempered by the operation of the sense of injustice.",
    abstract_source = "openalex"
}

@misc{gregory2010political,
    author = "Gregory, James",
    title = "The political philosophy of {Walzer}'s social criticism",
    year = "2010",
    note = "CORE ARGUMENT: Calls for a critical re-evaluation of Walzer's theory of justice, arguing that a deep tension exists between his social criticism (grounded in the value of a connected, 'whole' self) and his complex equality (grounded in value pluralism that threatens to fragment that wholeness), so that Walzer tacitly relies on the 'political philosophy' he repudiates. RELEVANCE: Sceptical voice: shows connected criticism rests on a tacit normative premise (the connected, whole self), which bears on the source-of-standards question (is the 'immanent' ground really independent of a substantive philosophy?). POSITION: Secondary analysis of Walzer; communitarian/connected criticism.",
    keywords = "Walzer, connected criticism, Low, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This article calls for a critical re-evaluation of Walzer’s theory of justice. It argues that there is a deep tension between Walzer’s social criticism and his complex equality. Social criticism is based on the normative value of a connected and ‘whole’ self, and complex equality is based upon a value pluralism that threatens to fragment this sense of wholeness. Walzer therefore commissions a tacit premise, borrowing from the same ‘political philosophy’ that he explicitly repudiates, and which social criticism is intended to supplant. This premise is a Kantian-inspired conception of self; brought to the argument as an a priori premise and thus in violation of Walzer’s own stated commitment to ‘internalism’ and ‘interpretation’. Furthermore, this same conception of self is the moral source of Walzer’s substantive commitment to the universal value of pluralist political regimes. The article closes with a suggested reconciliation of the inherent tension within Walzer’s theory.",
    abstract_source = "openalex"
}

@misc{benhabib1986critique,
    author = "Benhabib, Seyla",
    title = "Critique, Norm, and Utopia: A Study of the Foundations of Critical Theory",
    year = "1986",
    address = "New York",
    note = "CORE ARGUMENT: Traces the development of critical theory from Hegel through Marx, Lukacs and the Frankfurt School to Habermas, distinguishing the 'immanent' critique of Hegel and Marx (anchored in the dialectic of historical contradiction and the philosophy of history) from a communicative-ethical, anticipatory-utopian standpoint. She argues that critical theory needs two moments, explanatory-diagnostic and anticipatory-utopian, and that normative foundations should be located in the communicative ethics of universal moral respect and egalitarian reciprocity rather than in a philosophy of history. Bibliographic details from PhilPapers snippet and S2 reviews; not CrossRef-verified. RELEVANCE: The most direct treatment in this domain of the immanent/transcendent problem as a problem about the foundations of critique: source of standards (communicative ethics, a 'transcendence within'), role of contradiction (retained diagnostically, no longer a guarantee), reconstructive-plus-utopian, and progress (decoupled from philosophy of history). POSITION: Habermas-inflected communicative-ethical reconstruction of immanent critique.",
    keywords = "Benhabib, immanent critique, anticipatory-utopian, communicative ethics, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{misgeld1987critique,
    author = "Misgeld, Dieter and Benhabib, Seyla",
    title = "Critique, Norm and Utopia: A Study of the Foundations of Critical Theory",
    year = "1987",
    note = "CORE ARGUMENT: Review of Benhabib's Critique, Norm, and Utopia (CrossRef record lists both authors; pagination absent from the record). Content not available beyond the title; included as a contemporaneous reception record for Benhabib's book. RELEVANCE: Reception source for Benhabib; consult only after verifying content. POSITION: Book review.",
    keywords = "Benhabib, review, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, doi, type:@article->@misc"
}

@misc{warnke1987marxism,
    author = "Warnke, Georgia",
    title = "Marxism and Expressivism: Comments on {Benhabib}'s Critique, Norm and Utopia",
    year = "1987",
    note = "CORE ARGUMENT: Critical comments on Benhabib's book, concerned (as the title indicates) with its handling of Marxist and expressivist strands in the Hegel-Marx lineage; abstract unavailable via tools. RELEVANCE: Early critical engagement with Benhabib's attempt to rescue immanent critique's emancipatory content without philosophy of history; potentially a sceptical voice on the Habermasian reconstruction of the Hegel-Marx tradition. POSITION: Critical reception of Benhabib's communicative-ethical reconstruction.",
    keywords = "Benhabib, Marx, expressivism, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{habermas1984theory,
    author = "Habermas, Jürgen",
    title = "The Theory of Communicative Action: Reason and the Rationalization of Society",
    year = "1984",
    note = "CORE ARGUMENT: Habermas replaces the philosophy of consciousness with a theory of communicative action and formal pragmatics: speech acts raise universal validity claims (truth, rightness, sincerity), the rational reconstruction of whose presuppositions yields the normative standard of critique. Social pathology is diagnosed as 'colonization of the lifeworld' by system imperatives. Record from S2 (venue and publisher not given there; year 1984 is the English edition per S2). RELEVANCE: Founding text for the reconstructive-pragmatic source of standards: critique is immanent to communicative practice but lays claim to universal, context-transcending validity; contradiction is replaced by distortion of communication; progress is tied to rationalisation of the lifeworld and learning processes. Benhabib, McCarthy, Honneth, Fraser and Walzer all define themselves against it. POSITION: Habermasian rational reconstruction / communicative action.",
    keywords = "Habermas, communicative action, rational reconstruction, formal pragmatics, High, INCOMPLETE, no-abstract"
}

@misc{bohman1986formal,
    author = "Bohman, James F.",
    title = "Formal Pragmatics and Social Criticism: The Philosophy of Language and the Critique of Ideology in {Habermas}'s Theory of Communicative Action",
    year = "1986",
    note = "CORE ARGUMENT: Per the CrossRef title (verified), examines how formal pragmatics grounds Habermas's critique of ideology; abstract not retrieved. RELEVANCE: Link between rational reconstruction and ideology critique as depth hermeneutics (systematically distorted communication). Addresses whether formal-pragmatic presuppositions can ground social criticism. POSITION: Interpretation and assessment of Habermas's formal-pragmatic critique of ideology.",
    keywords = "Habermas, Bohman, ideology critique, formal pragmatics, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{gaus2013rationale,
    author = "Gaus, Daniel",
    title = "Rationale Rekonstruktion als Methode politischer Theorie zwischen Gesellschaftskritik und Neukonstruktion",
    year = "2013",
    note = "CORE ARGUMENT: German-language methodological article on rational reconstruction as a method of political theory located between social criticism and new construction (title; abstract unavailable). RELEVANCE: Treats reconstruction as a method, not merely a Habermasian doctrine; relevant to whether reconstruction should be called immanent critique or constructive theory. German-language source. POSITION: Methodological account of rational reconstruction.",
    keywords = "rational reconstruction, method, German-language, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@article{kirkpatrick2003evolution,
    author = "Kirkpatrick, Graeme",
    title = "Evolution or Progress? A (Critical) Defence of {Habermas}'s Theory of Social Development",
    journal = "Thesis Eleven",
    year = "2003",
    note = "CORE ARGUMENT: Responds to environmentally motivated sociologists who argue that Habermas's extended analogy between social theory and biology produces positions irreconcilable with Green politics and traditional critical theory; argues these criticisms misjudge the role of evolutionary concepts in Habermas's work. RELEVANCE: Bears on the progress question for reconstructive critique: whether Habermas's standards rest on a reconstruction of developmental (evolutionary) logic and what this implies for progress claims. POSITION: Critical defence of Habermas's reconstructive theory of social evolution.",
    keywords = "Habermas, progress, social evolution, Low, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "Habermas's theory of social evolution has been subjected to critique by environmentally motivated sociologists. They argue that his decision to recast social theory in terms of an extended, if selective analogy with biology leads him into a set of practical positions that are irreconcilable with Green politics and inconsistent with the goals of traditional critical theory. This article argues that these criticisms are based on an inaccurate assessment of the role of evolutionary concepts in Habermas's thought. By drawing out the similarities between Habermas and Kant on the question of the relationship between history and natural history, it is possible to see that Habermas's use of evolutionary metaphors plays a regulative rather than a constitutive role in his thinking on society. This strategy does not save Habermas's position, but shows instead that it may be vulnerable to an immanent critique that pulls out the real underlying antagonisms in his system.",
    abstract_source = "openalex"
}

@misc{honneth2001reconstructive,
    author = "Honneth, Axel",
    title = "Reconstructive Social Critique with a Genealogical Reservation",
    year = "2001",
    volume = "22",
    note = "CORE ARGUMENT: Honneth distinguishes reconstructive social criticism (identifying the normative potentials already embedded in social practices) from genealogical critique, retaining a genealogical proviso that reconstruction alone cannot capture historical power and domination (abstract not retrieved). RELEVANCE: Key methodological essay on source of standards (immanent, institutionalised rationality), with genealogy as supplement against conservative closure; early statement of the reconstructive turn that Repa, Carleheden and Schaub analyse. POSITION: Honneth's reconstructive immanent critique with genealogical corrective.",
    keywords = "Honneth, reconstructive critique, genealogy, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{honneth2009reconstructive,
    author = "Honneth, Axel",
    title = "Reconstructive Social Criticism with a Genealogical Proviso",
    year = "2009",
    note = "CORE ARGUMENT: English chapter version (Pathologies of Reason, chapter 3) of the 2001 essay on the idea of critique in the Frankfurt School: reconstruction of embedded normative ideals plus a genealogical proviso. Chapter title and pages from CrossRef. RELEVANCE: The standard English citation for Honneth's methodological statement of reconstructive critique; relates to domain 4's Jaeggi critique that reconstruction is internal criticism without transformative negativity. POSITION: Honneth's reconstructive critique with genealogical proviso.",
    keywords = "Honneth, reconstructive critique, genealogy, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{honneth2014freedom,
    author = "Honneth, Axel",
    title = "Freedom's Right",
    year = "2014",
    note = "CORE ARGUMENT: Honneth's 'normative reconstruction' of the institutionalised ideal of social freedom in personal relations, the market economy and the democratic public sphere, presented as a theory of justice by reconstructing which values modern institutions embody and where they have been misdeveloped. RELEVANCE: Central text for the debate on whether normative reconstruction suffices as ground of critique (source: present institutionalised values; contradiction: reduced to gap between norm and practice, 'misdevelopment'; reconstructive rather than transformative; progress: presupposed). Target of Freyenhagen, Schaub, McNeill, Agatensi. POSITION: Neo-Hegelian normative reconstruction.",
    keywords = "Honneth, normative reconstruction, social freedom, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Axel Honneth constructs a theory of justice derived from the normative claims of Western liberal-democratic societies and anchored in morally legitimate laws and institutionally established practices. Honneth's paradigm demonstrates how concrete social spheres generate the principles of individual freedom and a standard for what is just. Using social analysis to re-found a more grounded theory of justice, he argues that all crucial actionsrequire the realization of a particular aspect of individual freedom.",
    abstract_source = "openalex"
}

@misc{schaub2015misdevelopments,
    author = "Schaub, Jörg",
    title = "Misdevelopments, Pathologies, and Normative Revolutions: Normative Reconstruction as Method of Critical Theory",
    year = "2015",
    note = "CORE ARGUMENT: Argues that the method of normative reconstruction underlying Freedom's Right undermines Critical Theory's aspiration to be unreservedly critical and progressive: it recasts social pathologies as misdevelopments of existing norms, so radical critique and normative revolution are abandoned, and the book lacks resources for them. RELEVANCE: Central statement of the 'reconstruction without transformation' objection. Position on (c): reconstructive method is internally tied to reformism; on (a): standards are exhausted by institutionalised ideals. POSITION: Critic of Honneth's normative reconstruction (loss of radical critique).",
    keywords = "Honneth, normative reconstruction, transformation, sceptical voice, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract In this article I argue that the method of normative reconstruction underlying Freedom's Right undermines Critical Theory's aspiration to be a force that is unreservedly critical and progressive. I start out by giving a brief account of the four premises of the method of normative reconstruction and unpack their implications for how Honneth conceptualizes social pathologies and misdevelopments, specifically that these notions are no longer linked to radical critique and normative revolution. In the second part, I demonstrate that abandoning forms of radical critique and normative revolution is internally linked to adopting this method, before arguing that Freedom's Right contains no resources to account for why abandoning them does not amount to a deficiency. In the final part, I point out two problematic implications of turning away from radical critique and normative revolution for the very project Honneth pursues in Freedom's Right. I show that Honneth's own view about the limited scope of application of the method of normative reconstruction and his account of the dangers associated with social misdevelopments give us (additional) reasons to consider this method to be incomplete. Finally, I contend that the explanatory power of Freedom's Right is dubious because methodological premises that form part of normative reconstruction lead Honneth to ignore relevant alternative explanations of processes of deviation and disassociation from norms of social freedom, which he characterizes as social misdevelopments.",
    abstract_source = "s2"
}

@misc{freyenhagen2015honneth,
    author = "Freyenhagen, Fabian",
    title = "Honneth on Social Pathologies: A Critique",
    year = "2015",
    note = "CORE ARGUMENT: Reviews Honneth's writing on social pathology and offers an immanent critique focused on Freedom's Right: both his early context-transcendent approach and his later immanent approach are found wanting, and his growing reformism is exposed and criticised. RELEVANCE: Pivotal sceptical voice from the Adornian side, applying immanent critique to Honneth's own account; ties to Domain 2 (Freyenhagen's Adorno). Position on (a) source: rejects both anthropological and institutional grounds; on (c): charges reformism. POSITION: Adornian negativist critique of Honneth's reconstructive immanence.",
    keywords = "Honneth, social pathology, Adorno, reformism, sceptical voice, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Over the last two decades, Axel Honneth has written extensively on the notion of social pathology. He has presented it as a distinctive critical resource of Frankfurt School Critical Theory, in which tradition he places his own work; and as an alternative to the mainstream liberal approaches in political philosophy. In this paper, I review the developments in Honneth's writing about this notion and offer an immanent critique, with a particular focus on his recent major work Freedom's Right. Both his early context-transcendent approach and his more recent immanent approach are found wanting, and his increasing reformism is exposed and criticized. The central distinction in Freedom's Right between social pathologies and misdevelopments is also shown to be unworkable. In addition, I demonstrate that Zurn's influential proposal to characterize the phenomena Honneth identified as social pathologies in terms of a cognitive disconnect does not fit (with Zurn's own description of) these phenomena. While some such phenomena, like what Honneth describes as “Organized Self-Realization,” call out for conceptualization in terms of the notion of social pathology, an alternative characterization of this notion is necessary.",
    abstract_source = "s2"
}

@misc{mcneill2015social,
    author = "McNeill, David N.",
    title = "Social Freedom and Self-Actualization: ``Normative Reconstruction'' as a Theory of Justice",
    year = "2015",
    note = "CORE ARGUMENT: Honneth appropriates Hegel's ethical substance without Hegel's idealist commitments; the project can only succeed if he offers an alternative demonstration of the rationality and normative coherence of existing institutions, and the grounds he provides (that justice and individual self-determination are mutually referential) are insufficient. RELEVANCE: Targets the justificatory sufficiency of normative reconstruction: does immanent identification of institutionalised ideals justify them? Clear statement of the gap Hegel's logic once filled. POSITION: Critic of Honneth's theory of justice as normative reconstruction.",
    keywords = "Honneth, Hegel, normative reconstruction, justification, sceptical voice, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In Freedom's Right Axel Honneth seeks to provide a theory of justice by appropriating Hegel's account of ethical substance in the Philosophy of Right, but he wants to do so without endorsing Hegel's more robust idealist commitments. I argue that this project can only succeed if Honneth can offer an alternative, comparatively robust demonstration of the rationality and normative coherence of existing social institutions. I contend that the grounds Honneth provides for this claim are insufficient for his purposes. In particular, I argue that Honneth's claim that “justice and individual self-determination are mutually referential,” even were it to be accepted, would be insufficient to underwrite his more robust identification between the normative foundations of justice, autonomy and reciprocal self-realization. In the final section of the paper, I turn to Honneth's analysis of the “social institution” of friendship, which he, following Hegel, holds up as a paradigmatic instantiation of social freedom understood as, in Hegel's words, “being with oneself in another” (Beisichselbstsein in einem Anderen). I argue that an analysis of the normative import of friendship wholly in terms of mutual recognition misses an important aspect of the kind of self-realization that friendship makes possible.",
    abstract_source = "openalex"
}

@misc{buchwalter2016concept,
    author = "Buchwalter, Andrew",
    title = "The Concept of Normative Reconstruction: Honneth, Hegel, and the Aims of Critical Social Theory",
    year = "2016",
    note = "CORE ARGUMENT: Assesses Honneth's reception and appropriation of Hegel's theory of normative reconstruction in Freedom's Right through a comparative reading of general methodology, the logic and programme of the Philosophy of Right, and analyses of modern market societies. RELEVANCE: Connects Honneth's method back to Hegelian immanent critique (Domain 1, and Buchwalter's Hegel and Critical Theory in Domain 4). POSITION: Interpretive treatment of Honneth's normative reconstruction vis-a-vis Hegel.",
    keywords = "Honneth, Hegel, normative reconstruction, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "Abstract Purpose An assessment of Axel Honneth’s reception and appropriation of Hegel’s theory of normative reconstruction as presented in his Freedom’s Right (Columbia University Press, 2014). Methodology/approach A comparative assessment of Honneth’s and Hegel’s approach to normative reconstruction focusing on three basic issues: general methodology, understandings of the logic and program of the Philosophy of Right, and analyses and assessments of modern market societies as detailed in Hegel’s account of civil society (bürgerliche Gesellschaft). Findings For Honneth, normative reconstruction consists in reworking modes of social rationality already realized in modern institutions. By contrast, Hegel is shown to advance an approach to reconstruction in which an account of social rationality is properly fashioned only in the reconstruction process itself. In this way Hegel is also shown to proffer an approach to normative reconstruction that is at once more robustly reconstructive and more robustly normative than is the case with Honneth. Originality/value The paper demonstrates the ongoing value of Hegel’s thought for social and political theory. It illuminates Hegel’s uniquely dialectical approach to immanent social critique, dedicated not only to explicating existing tensions and “bifurcations” (Entzweiungen) but – with the help of a distinctive account of Bildung (cultivation or formation) – to engaging those tensions and bifurcations in order to delineate the conditions for their constructive supersession. It also elucidates different ways in which critical social theorists, committed to notions of “immanent transcendence,” draw on the resources of market societies to mount normative challenges to the aporias of those societies.",
    abstract_source = "openalex"
}

@misc{carleheden2020criticize,
    author = "Carleheden, Mikael",
    title = "How to criticize? On Honneth's method",
    year = "2020",
    volume = "22",
    note = "CORE ARGUMENT: Investigates the meaning and role of social critique in the social sciences; argues that the value-neutrality ideal rests on normative subjectivism that can be challenged by the notion of 'normative reasoning', then asks what we do when we reason normatively, turning to Honneth's method. RELEVANCE: Defence of Honneth's normative-reconstructive method as a form of practical reason accessible within the social sciences; relevant to the question of how internal norms ground justified critique. POSITION: Sympathetic methodological account of Honneth.",
    keywords = "Honneth, method, normative reasoning, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT This article investigates the meaning and role of social critique in the social sciences. This form of theorizing has always been a significant part of the social sciences. Due to the scientific ideal of value neutrality, however, the manner in which social criticism is conducted is seldom discussed. I claim that the value-neutrality ideal rests on a conception of normative subjectivism that can be challenged by turning to some notion of practical reason. However, there is no need to turn to any strong notion of reason; instead, I use the term ‘normative reasoning’. The main question posed in the article then becomes: What is it that we do when we reason in a normative manner in the social sciences? The first part of the article addresses Axel Honneth’s ‘Grand Social Theory of Modernity’ in Freedom’s Right. His procedure in the book is treated as a significant case of normative reasoning. I investigate his method of ‘reconstruction’ by comparing it primarily to the methods of ‘construction’ and ‘genealogy’. The second part of the article is a critical discussion of Honneth’s method of normative reasoning. My main criticism is that, despite his intentions, his procedure is overly constructivist in the sense that it prevents a disclosure of ongoing transformations of ethical life. In the conclusion, I argue for a pluralistic methodology; different ways of normative reasoning should be used to solve different kinds of normative problems.",
    abstract_source = "s2"
}

@misc{repa2023reconstructive,
    author = "Repa, Luiz",
    title = "Reconstructive Critique as Immanent Critique: On the Notion of Surplus of Validity in Axel Honneth",
    year = "2023",
    volume = "24",
    note = "CORE ARGUMENT: Argues that Honneth's reconstructive critique is a type of immanent critique. Against Rahel Jaeggi's objection that it is a genre of internal criticism devoid of transformative negativity, Repa contends that the 'surplus of validity' plays a role of transcendence within historical reality, and shows how Honneth uses this to resolve the division within Critical Theory caused by Habermas's rational reconstruction. RELEVANCE: Most direct engagement with the immanent/internal classification of Honneth and the Jaeggi challenge (cross-reference Domain 4). Position on (a): standards from within reality's surplus of validity; (b) contradiction replaced by surplus; (c) reconstructive yet with transcendent moment. POSITION: Defence of Honneth's reconstruction as immanent critique against Jaeggi.",
    keywords = "Honneth, Jaeggi, surplus of validity, immanent critique, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT The article argues that Honneth’s idea of reconstructive critique represents a type of immanent critique. Starting from the objection raised by Rahel Jaeggi, who considers the reconstructive critique to be a genre of internal criticism devoid of any transformative negativity, it seeks to show, on the contrary, that Honneth’s notion of “surplus of validity” plays a role of transcendence within the historical reality, which could explain his understanding of reconstructive critique as immanent one. In the second part, the paper displays how Honneth applies this conception of critique to solve the division within Critical Theory, induced by Habermas’s use of the idea of rational reconstruction, which would have split off the tasks of founding the normative criteria and discovering immanently elements for the social transformation. In the third part, the category of surplus of validity is investigated in its function of enlightening possibilities of transformation following an “universal-particular dialectic”. In its final part, the paper addresses some conceptual difficulties in Honneth’s attempt to clarify the systematic value and philosophical meaning of the surplus of validity within the framework of normative reconstruction.",
    abstract_source = "s2"
}

@misc{zurn2000anthropology,
    author = "Zurn, Christopher",
    title = "Anthropology and normativity: a critique of {Axel Honneth}'s `formal conception of ethical life'",
    year = "2000",
    volume = "26",
    note = "CORE ARGUMENT: Critique of Honneth's 'formal conception of ethical life' as a normative ground arising from an anthropology of recognition (title; abstract unavailable). RELEVANCE: Early sceptical assessment of the anthropological ground of Honneth's critique, preceding the later institutional turn. POSITION: Critic of Honneth's anthropological foundation.",
    keywords = "Honneth, Zurn, anthropology, normativity, sceptical voice, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Honneth's 'formal conception of ethical life'In his most recent book The Struggle for Recognition: The Moral Grammar of Social Conflicts, Axel Honneth argues for a new conception of critical social theory by focusing on personal and social struggles for recognition.By outlining three different aspects of ontogenetic development, and by explicating the three structures of relation-to-self that each ideally results in, Honneth hopes to refocus critical social theory by grounding the theoretical explanation and normative justification of intramundane social struggles for recognition upon an understanding of personal identity formation.In this paper, I would like to critically examine one aspect of Honneth's project, namely, his contention that a 'formal conception of ethical life' can function as the normative standpoint from which to judge progressive and pathological forms of social organization.In brief, this 'formal conception of ethical life' is intended to delineate 'the entirety of intersubjective conditions that can be shown to serve as necessary preconditions for individual self-realization' (Honneth, 1995b: 173).The lynchpin of Honneth's theory is his account of the structural interconnection between (1) the three stages of individual identity development, (2) the three forms of intersubjective recognition required for each stage, and (3) the forms of social organization needed as preconditions for the healthy, undistorted self-realization of that society's members.This structural interconnection then provides a basis for explaining processes of social change -explicating both the impulse for expanded recognition and the normative claims raised in social struggles for individual and group recognition.",
    abstract_source = "openalex"
}

@misc{zurn2005recognition,
    author = "Zurn, Christopher F.",
    title = "Recognition, Redistribution, and Democracy: Dilemmas of {Honneth}'s Critical Social Theory",
    year = "2005",
    note = "CORE ARGUMENT: Examines dilemmas of Honneth's critical social theory in light of the redistribution-recognition debate and democracy (title; abstract unavailable). RELEVANCE: Evaluates whether recognition-based immanent critique can accommodate distributive and democratic concerns, with Fraser's challenge in the background. POSITION: Critical assessment of Honneth's monism of recognition.",
    keywords = "Honneth, Fraser, recognition, redistribution, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "What does social justice require in contemporary societies? What are the requirements of social democracy? Who and where are the individuals and groups that can carry forward agendas for progressive social transformation? What are we to make of the so-called new social movements of the last thirty years? Is identity politics compatible with egalitarianism? Can cultural misrecognition and economic maldistribution be fought simultaneously? What of the heritage of Western Marxism is alive and dead? And how is current critical social theory to approach these and other questions? Much of the most productive work done in recent social theory has revolved around such issues, in particular, around those concerning the relationship between the politics of recognition and the politics of distribution. After the intense theoretical focus over the last fifteen years or so on the issues of recognition politics—multiculturalism, multi-nationalism, identity politics, group-differentiated rights, the accommodation of difference, and so on—some social theorists have worried that attention has been diverted from important",
    abstract_source = "openalex"
}

