@misc{agatensi2025critique,
    author = "Agatensi, Elena",
    title = "A Critique of {Honneth}'s Account of Progress from a Foucauldian Perspective",
    year = "2025",
    volume = "26",
    note = "CORE ARGUMENT: Traces Honneth's teleological vision of history based on progress from The Critique of Power through The Struggle for Recognition to Freedom's Right and critiques it through Foucault's genealogical method, starting from Allen's The End of Progress; Honneth's choice of Hegel over Kant and his departure from Adornian negativity are emphasised. RELEVANCE: Recent sceptical voice on progress as a condition of normative reconstruction; connects to Domain 7 (Allen). POSITION: Genealogical (Foucauldian) critique of Honneth's progress narrative.",
    keywords = "Honneth, progress, Foucault, genealogy, sceptical voice, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT This article aims to explore Honneth’s account of progress and to show a possible critique of it through the tools offered by Foucauldian thought and especially by his genealogical method, starting from Allen’s The End of Progress. To trace Honneth’s path towards the development of his teleological vision of history based on the centrality of progress, the paper begins with The Critique of Power and arrives to Freedom’s Right, passing through The Struggle for Recognition. By emphasising Honneth’s choice to follow Hegel instead of Kant and, at the same time, his incapacity to leave Habermas and his consequent disclaim of the Adornian negativity, this essay outlines a theoretical short-circuit that arises from Honneth’s immanent reconstructivist method and his neo-Enlightenment approach towards Modernity and history. By considering Allen’s proposal to use Adorno and Foucault to overcome Honneth’s philosophy of history through the abandonment of the traditional concept of progress, this paper suggests a possible leap beyond Critical Theory outside its normative philosophical traits, thanks to Foucauldian thought and the breaking power of his genealogy.",
    abstract_source = "s2"
}

@misc{forst2011ground,
    author = "Forst, Rainer",
    title = "The ground of critique",
    year = "2011",
    note = "CORE ARGUMENT: Forst reconstructs the basic claim of human dignity, historically and normatively, as resting on the moral status of the person as a reason-giving, reason-demanding being, and offers this as the ground of social criticism (abstract from enrichment; title and pages confirmed by CrossRef). RELEVANCE: Source of standards: a context-transcending moral status (justificatory right to justification) rather than immanent institutionalised norms; representative of the justificatory alternative to Honneth's and Walzer's immanence (cross-reference Domain 5). POSITION: Constructivist/justificatory ground of critique.",
    keywords = "Forst, ground of critique, justification, sceptical voice, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In the practice of social criticism, the concept of human dignity has played and still plays an important role. In philosophical debates, however, we find widely divergent accounts of that concept, ranging from views based on a conception of human needs to religious approaches trying to explain the ‘inviolability’ of the person. The view presented here reconstructs the basic claim of human dignity historically and normatively as resting on the moral status of the person as a reason-giving, reason-demanding and reason-deserving being. The person as holding a basic moral right to justification is the true ground for the claim of having one’s dignity respected: as someone who must not be subjected to norms, rules, or institutions which cannot be properly justified to that person in appropriate practices of justification. To possess human dignity means being an equal member in the realm of subjects and authorities of justification and to be respected as such. This is the moral ground of social criticism, implied in particular social and political demands raised in given historical contexts. Thus, critical theory has to be reoriented towards a critique of the relations of justification in a given social order of justification.",
    abstract_source = "s2"
}

@misc{kompridis2011critique,
    author = "Kompridis, Nikolas",
    title = "On Critique and Disclosure",
    year = "2011",
    note = "CORE ARGUMENT: Kompridis replies to the symposium on Critique and Disclosure (title only; abstract unavailable). In the book he argues for a world-disclosing conception of critique as an alternative to Habermas's proceduralism. RELEVANCE: Disclosure model of critique as alternative to both reconstruction and justification; relevant to the transformative-vs-reconstructive question. POSITION: Disclosive/receptivity-oriented critical theory.",
    keywords = "Kompridis, disclosure, Habermas, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "I am deeply grateful to Amy Allen, Fred Rush, Morton Schoolman and Robert Sinnerbrink for their careful and thoughtful responses to Critique and Disclosure: Critical Theory between Past and Future. In particular, I am grateful for the generous spirit in which they express their reservations about my proposal for renewing critical theory. An author cannot expect to have better readers than they, attuned as they are to critical theory’s need of renewal, as well as to the obvious (and not so obvious) difficulties in providing it a new orientation in light of Heidegger’s idea of world disclosure. Since they have done such a good job of representing, clearly and graciously, the main lines of argument that run through the book I am spared the task of restating them here. 1 This leaves me free to reply to their reservations and doubts about my project, elaborating some new developments where I can.",
    abstract_source = "openalex"
}

@misc{kompridis2006critique,
    author = "Kompridis, Nikolas",
    title = "Critique and Disclosure: Critical Theory Between Past and Future",
    year = "2006",
    note = "CORE ARGUMENT: Argues that critical theory (Habermas, Honneth) has lost its capacity for world-disclosure and should recover the Heideggerian and romantic insight that critique can open new possibilities of meaning, not only apply already-validated norms. RELEVANCE: Offers a transformative alternative to reconstruction: standards are not already available but are disclosed. Bears on all four annotation headings (source, contradiction, transformation, progress). POSITION: Disclosure-based critical theory; critic of Habermasian reconstruction.",
    keywords = "Kompridis, disclosure, transformative critique, Habermas, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {A provocatively argued call for shifting the emphasis of critical theory from Habermasian "critique," restricted to normative clarification, to "disclosure," a possibility-enhancing approach that draws on and reinterprets ideas of Heidegger. In Critique and Disclosure, Nikolas Kompridis argues provocatively for a richer and more time-responsive critical theory. He calls for a shift in the normative and critical emphasis of critical theory from the narrow concern with rules and procedures of Jürgen Habermas's model to a change-enabling disclosure of possibility and the enlargement of meaning. Kompridis contrasts two visions of critical theory's role and purpose in the world: one that restricts itself to the normative clarification of the procedures by which moral and political questions should be settled and an alternative rendering that conceives of itself as a possibility-disclosing practice. At the center of this resituation of critical theory is a normatively reformulated interpretation of Martin Heidegger's idea of "disclosure" or "world disclosure." In this regard Kompridis reconnects critical theory to its normative and conceptual sources in the German philosophical tradition and sets it within a romantic tradition of philosophical critique. Drawing not only on his sustained critical engagement with the thought of Habermas and Heidegger but also on the work of other philosophers including Wittgenstein, Cavell, Gadamer, and Benjamin, Kompridis argues that critical theory must, in light of modernity's time-consciousness, understand itself as fully situated in its time—in an ever-shifting and open-ended horizon of possibilities, to which it must respond by disclosing alternative ways of thinking and acting. His innovative and original argument will serve to move the debate over the future of critical studies forward—beyond simple antinomies to a consideration of, as he puts it, "what critical theory should be if it is to have a future worthy of its past."},
    abstract_source = "openalex"
}

@misc{fraser2003redistribution,
    author = "Fraser, Nancy and Honneth, Axel",
    title = "Redistribution or Recognition?: A Political-Philosophical Exchange",
    year = "2003",
    note = "CORE ARGUMENT: Exchange in which Fraser argues that redistribution and recognition are two mutually irreducible dimensions of justice ('perspectival dualism') and Honneth that a differentiated theory of recognition can ground a theory of justice by itself. (S2 record; no publisher in tool output; Thompson 2005's abstract confirms the two positions.) RELEVANCE: Locus of the dispute over the source of standards: a single moral-psychological grammar of recognition (Honneth) versus an immanent critical-theoretical pluralism rooted in social movements and the status order (Fraser). POSITION: Fraser (dualism) vs. Honneth (monism of recognition).",
    keywords = "Fraser, Honneth, recognition, redistribution, High, INCOMPLETE, no-abstract"
}

@misc{thompson2005redistribution,
    author = "Thompson, Simon",
    title = "Is redistribution a form of recognition? comments on the {Fraser}--{Honneth} debate",
    year = "2005",
    note = "CORE ARGUMENT: Summarises Fraser's claim that redistribution and recognition are mutually irreducible elements of social justice and Honneth's that a differentiated account of recognition can ground a theory of justice alone, then critically assesses the exchange. RELEVANCE: Evaluative guide to the debate on whether recognition can serve as an immanent ground for critique of economic injustice. POSITION: Critical assessment of the Fraser-Honneth exchange.",
    keywords = "Fraser, Honneth, recognition, redistribution, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "It has been argued that, in political theory and political practice, a concern with the distribution of economic opportunities and resources has recently been displaced by a preoccupation with the acknowledgement of cultural identities and differences. In their jointly authored book, Redistribution or Recognition?, Nancy Fraser and Axel Honneth present their very different reactions to this development. While Fraser argues that redistribution and recognition are two mutually irreducible elements of an account of social justice, Honneth contends that a suitably differentiated account of recognition can provide the basis of a theory of justice on its own. This article critically assesses the relative merits of these two positions by focusing on their accounts of the nature of capitalism, the sort of social theories that are needed in light of these accounts, and the moral philosophies associated with these social theories. This assessment leads to a number of conclusions about the proper relationship between recognition and redistribution in a theory of social justice.",
    abstract_source = "s2"
}

