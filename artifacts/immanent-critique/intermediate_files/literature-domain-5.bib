@misc{allen2014normative,
    author = "Allen, Amy",
    title = "The Normative and the Transcendental: Comments on Colin Koopman's Genealogy as Critique",
    year = "2014",
    note = "CORE ARGUMENT: Comments on Koopman's Genealogy as Critique, which proposes a wholesale revision of Foucault's method by rethinking his relation to Kant's notion of critique and re-reading it as historical rather than transcendental critique; Allen takes up the normative and the transcendental in that reading. RELEVANCE: Gateway to Koopman's genealogy-as-critique thesis (the book itself was not found) and to the Foucault-Habermas dispute about whether genealogy has normative authority without immanent or transcendent grounding. Genealogy is the main non-immanent, non-foundational alternative here. POSITION: Genealogical critique; Foucault-Habermas debate.",
    keywords = "genealogy, Koopman, Foucault, normativity, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = {Genealogy as Critique: Foucault and the Problems of Modernity 1 is an ambitious and exciting book that makes significant contributions to the now vast secondary literature on Foucault, and to the ongoing Foucault-Habermas "debate."Despite Foucault's enormous influence across multiple disciplines, his philosophical method, according to Koopman, has all too often been misunderstood not only by his harshest critics but also by his most ardent supporters.Hence, Koopman proposes a wholesale revision of our understanding of Foucault's work, a revision that turns on two fundamental issues: first, rethinking Foucault's relationship to Kant's notion of critique; and, second, re-interpreting Foucault's oeuvre through the lens of the master concept of problematization.Re-reading Foucault's work in light of these two issues allows us to see not only how his diverse writings hang together as a consistent whole but also how his work provides a valuable and effective model of historico-philosophical critique that has much more in common with the traditions of American pragmatism and German critical theory than it does with some of the French and Italian philosophers-Derrida and Agamben, particularly-with whom Foucault is more often associated.To my mind, the most impressive and significant achievements of this book are twofold: first, the interpretive re-reading of Foucault's oeuvre through the lens of problematization and, second, the related constructive articulation of a Foucaultian model of critique as problematization.Foucault was notoriously prone to re-describing his earlier work in light of his present concerns.His late interviews in particular are littered with claims about what he was really up to all along: his main concern was not power but the subject, not the subject but truth, neither power nor the subject nor truth but problematization, and so on.What makes Foucault's work so unique-not to mention so tremendously productive and fertile-is that all of these claims are plausible.One can productively read Foucault's work as a whole in light of the concept of power, or of subjectivity, or of truth, or of problematization, and each of these readings is capable of yielding important insights.Koopman's book stands out as the best systematic reconstruction of Foucault's work through the lens of problematization to date, and 1 Colin Koopman, Genealogy as Critique: Foucault and the Problems of Modernity (Bloomington: Indiana University Press, 2013).Henceforth cited parenthetically in the text.},
    abstract_source = "openalex"
}

@misc{hanpile2016foucault,
    author = "Han-Pile, Béatrice",
    title = "Foucault, normativity and critique as a practice of the self",
    year = "2016",
    note = "CORE ARGUMENT: Distinguishes 'how possible' questions (enabling conditions) from 'whether permissible' questions (legitimacy), and examines their interplay in Foucault to explain the historical a priori and the accusations of crypto-normativity from Taylor and Habermas, charting available defenses. RELEVANCE: Treats the Habermas-style objection that genealogy covertly relies on norms, which parallels the smuggled-standards objection to immanent critique, and offers Foucault's response. Source of standards: critique as practice of the self. POSITION: Foucauldian reply to the crypto-normativity charge.",
    keywords = "Foucault, Habermas-Foucault, normativity, genealogy, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In this paper I distinguish between two main critical questions: ?how possible? questions, which look for enabling conditions (empirical or transcendental) and raise issues of epistemic normativity; and ?whether permissible? questions, which relate to conditions of legitimacy and ethical normativity. I examine the interplay of both types of questions in Foucault?s work and argue that this helps us to understand both the function of the historical a priori in the archeological period and the subsequent accusations of crypto-normativity levelled against Foucault by commentators such as Taylor and Habermas. I chart the complex conceptual space available for a defense. After examining several possible replies (in particular deflationary and constructivist), I conclude that the most effective option, and the one that fits Foucault?s approach best, is to refuse the demand for normative justification as self-defeating, and to opt for the cultivation of an appropriate ethical sensibility through an emphasis on critique as a performative practice of the self. I offer in conclusion some thoughts on what such practice may look like for Foucault",
    abstract_source = "core"
}

@misc{santos2022genealogy,
    author = "Santos, James William and Sobottka, Emil Albert",
    title = "Genealogy, Immanent Critique and Forms of Life: A Path for Decolonial Studies",
    year = "2022",
    volume = "33",
    note = "CORE ARGUMENT: Argues for a viable genealogical approach within critical theory that settles questions of its normative viability, pairing Jaeggi's critique of forms of life with Rosa's diagnosis of modernity through Saar's tridimensional genealogy; proposes this as a path for decolonial studies. RELEVANCE: Explicitly combines genealogy and immanent critique, treating genealogy as a variant rather than a rival. Source of standards: the normative inheritance of forms of life. Transformative aim; link to decolonial critique. POSITION: Genealogical immanent critique (Jaeggi, Rosa, Saar).",
    keywords = "genealogy, immanent-critique, Saar, Jaeggi, decolonial, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This article argues for a viable genealogical approach within critical theory that could settle the questions regarding normative viability of such critique. Then, the implications of the normative inheritance implied lead to the pairing of Jaeggi’s conceptualization and critique of forms of life with Rosa’s dual diagnosis of (late) modernity through the structural lenses of genealogy as tridimensional endeavor posed by Saar. In the end, the final argument is that a genealogical critique in these terms could be the next step towards the revitalization of decolonial studies and a path for direct political action.",
    abstract_source = "s2"
}

@article{santos2025foucault,
    author = "Santos, James William",
    title = "Foucault's genealogical normative stance",
    journal = "Thesis Eleven",
    year = "2025",
    note = "CORE ARGUMENT: Explores whether Foucault's genealogical approach can ground a normative stance, noting that Habermas's critique of Foucault's theory of power remains influential; proposes an immanent, performative normativity in which freedom is both precondition for power relations and criterion for critique. RELEVANCE: A recent Foucault/Habermas reading that reframes genealogy as immanent critique, bearing on the genealogy-versus-immanent-critique question. Standards: freedom, found in power relations themselves. POSITION: Immanent-performative reading of Foucault.",
    keywords = "Foucault, Habermas-Foucault, genealogy, immanent-normativity, Medium, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "This article explores Michel Foucault's genealogical approach and its potential for grounding a normative stance. Criticisms and further developments on genealogy within critical theory denote that, despite counterarguments, Habermas's critique of Foucault's theory of power remains influential. By analyzing Foucault's conceptual choices —such as the dispositif (apparatus)— and his historical critiques, the article demonstrates how power and freedom are intertwined; it proposes an immanent, performative normativity, where freedom is both a precondition for power relations and a dynamic criterion for critique. The normativity emerges through critical engagement with historical contingencies. Foucault's works—from Madness and Civilization to The History of Sexuality—demonstrate this process, exposing how norms are historically constituted. Ultimately, Foucault's genealogy offers a normative stance grounded on freedom as power's counterpart and as a meta-normative standard.",
    abstract_source = "openalex"
}

