@misc{mizrahi2010take,
    author = "Mizrahi, Moti",
    title = "Take My Advice---I Am Not Following It: Ad Hominem Arguments as Legitimate Rebuttals to Appeals to Authority",
    year = "2010",
    note = "CORE ARGUMENT: Argues that ad hominem arguments are not always fallacious: in practical reasoning, when a person advises others to do what she does not do, her circumstances are relevant, and such circumstantial arguments are legitimate rebuttals to appeals to authority rather than fallacious tu quoque. RELEVANCE: Argument-theoretic analogue of internal critique, where a view is criticized by its holder's own commitments. Peripheral to the social-critical debate; only flags the analytic tu quoque literature. POSITION: Informal logic; limited defence of circumstantial ad hominem.",
    keywords = "ad-hominem, tu-quoque, internal-critique, analytic-parallel, Low, METADATA\_CLEANED: journal, volume, number, doi, type:@article->@misc",
    abstract = "In this paper, I argue that ad hominem arguments are not always fallacious. More explicitly, in certain cases of practical reasoning, the circumstances of a person are relevant to whether or not the conclusion should be accepted. This occurs, I suggest, when a person gives advice to others or prescribes certain courses of action but fails to follow her own advice or act in accordance with her own prescriptions. This is not an instance of a fallacious tu quoque provided that such circumstantial ad hominem arguments are construed as rebuttals to appeals to (administrative) authority (of expertise), or so I argue.",
    abstract_source = "s2"
}
