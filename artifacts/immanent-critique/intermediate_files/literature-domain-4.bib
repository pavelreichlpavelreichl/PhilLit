@misc{stahl2013habermas,
    author = "Stahl, Titus",
    title = "Habermas and the Project of Immanent Critique",
    year = "2013",
    volume = "20",
    note = "CORE ARGUMENT: Stahl argues that, despite Habermas's own disclaimers, the discourse-theoretic reconstruction of the normative presuppositions of communication constitutes a novel and innovative form of immanent critique (PhilPapers summary). Standards come from reconstructed presuppositions of social practice rather than from an external moral theory. RELEVANCE: Connects the Habermasian reconstructive programme to Stahl's taxonomy; an anchor for the reconstructive (weak) pole of the strong/weak distinction and for the question whether Habermas's universalism is compatible with immanence. POSITION: Reconstructive immanent critique with a social-practice grounding (Habermas read as immanent critic).",
    keywords = "immanent-critique, Habermas, taxonomy, reconstructive, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {According to his own understanding, Jürgen Habermas' Theory of Communicative Action offers a new account of the normative foundations of critical theory. 1 Habermas' motivating insight is that neither a transcendental or metaphysical solution to the problem of normativity, nor a merely hermeneutic reconstruction of historically given norms, is sufficient to clarify the normative foundations of critical theory.In response to this insight, Habermas develops a novel account of normativity which locates the normative demands upon which critical theory draws within the socially instituted practice of communicative understanding.Although Habermas has claimed otherwise, this new foundation for critical theory constitutes a novel and innovative form of "immanent critique".To argue for and to clarify this claim, I offer, in section 1, a formal account of immanent critique and distinguish between two different ways of carrying out such a critique.In section 2, I examine Habermas' rejection of the first, hermeneutic option.Against this background, I then show, in section 3, that the Theory of Communicative Action attempts to formulate an immanent critique of contemporary societies according to a second, "practice-based" model.However, because Habermas, as I will argue in section 4, commits himself to an implausibly narrow view in regard to one central element of such a model -in regard to the social ontology of immanent normativity -his normative critique cannot develop its full potential (section 5). The Concept of Immanent CritiqueWhether a particular theoretical project should be described as "immanent critique" depends on the meaning of this term which, in spite of its importance, has rarely been clearly defined. Titus Stahl, "Habermas and the Project of Immanent Critique"Pre-review version -not suitable for citation.Hence, before turning to Habermas' model, I will clarify what I mean by "immanent critique," and the theoretical commitments I take such a project to entail.Critical theories -or at least, those varieties which locate themselves within the Frankfurt School tradition -generally derive some of their methodological commitments from Marx's early writings.Criticizing the Utopian tendencies of his time, Marx rejects all "dogmatic" forms of normative criticism, which postulate normative principles from a context-free, external vantage point. 2 However, criticizing Hegel, Marx also argues that social critique is not to be based on a reconstruction of "reason in history", but rather on an analysis of the material conditions of social reproduction.3 Thus, insofar as we can attribute any normative project to Marx, he must envisage a form of criticism that draws on norms which already exist in objective social reality.4 Many critical theorists have subsequently endorsed this broad strategy of justifying the normative standards of critique by reference to immanent potentials of social reality.In so doing, these theorists not only reject forms of moral constructivism and of moral realism that introduce norms from the "outside", but they also reject a merely "internal" application of those normative standards which are already accepted by their audience.5 However, any theory which attempts to draw on normative standards within objective social reality in this manner must solve three distinct problems: First, in order to justify a critical judgment by reference to immanent social standards, a theory must plausibly explain the sense in which such immanent standards "exist."Providing such an explanation requires a social ontology: a theoretical account that specifies the meaning of claims regarding the existence of particular social entities, and in this case, of socially immanent norms.Second, even given a justification for the assumption of immanent norms on the level of a social ontology, it is unclear what type of epistemic access social critics have to the relevant normative potentials immanent to social reality.Third and finally, it is an open question as to what kind of critical authority an immanent critique that draws upon them can aspire to.In summary, any model of immanent critique must clarify: the ontology of the immanent normative standards employed; its epistemology; and the consequences of its reliance upon those standards for its own critical capacity.Although these questions are seldom clearly distinguished, there have been numerous attempts to address the issues they raise.We can roughly divide these answers into two camps, which I will},
    abstract_source = "openalex"
}

@misc{stahl2013what,
    author = "Stahl, Titus",
    title = "What is Immanent Critique?",
    year = "2013",
    howpublished = "SSRN working paper",
    note = {CORE ARGUMENT: Distinguishes immanent critique, which reconstructs norms immanent in a social practice that point beyond its members' normative self-understanding, from both external critique and internal critique, and identifies three questions a theory of immanent critique must answer: a social-ontological, an epistemological and a justificatory one (PhilPapers summary). RELEVANCE: Provides the three-way taxonomy (external/internal/immanent) the domain's key question asks about, and the framework for assessing Jaeggi, Sabia and Honneth; also the source of the "source of standards" analysis (norms implicit in practices, not accepted explicitly). POSITION: Social-practice (Brandom/rule-following-inflected) account of immanent critique with a reconstructive-but-transcending standard.},
    keywords = "immanent-critique, taxonomy, internal-critique, external-critique, social-ontology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@misc{stahl2013immanente,
    author = "Stahl, Titus",
    title = "Immanente Kritik: Elemente einer Theorie sozialer Praktiken",
    year = "2013",
    note = "CORE ARGUMENT: Monograph asking whether there is a form of critique that neither applies empirically accepted standards nor independently justified norms but reconstructs norms immanent to social practices. It surveys Walzer, Taylor, MacIntyre, Habermas and Honneth, builds on social ontology and the rule-following discussion, and argues that immanent rules exist where participants recognize one another as members of rule-governed practices by attributing defeasible normative authority; it also treats second-order critique of reification (PhilPapers description). RELEVANCE: The fullest statement of the practice-theoretic account; defines the immanent/internal/external taxonomy and the role of (non-)conservative reconstruction. No venue or abstract data from CrossRef/S2. POSITION: Reconstructive immanent critique grounded in social ontology of practices.",
    keywords = "immanent-critique, social-practices, rule-following, taxonomy, High, INCOMPLETE, no-abstract"
}

@misc{stahl2017particular,
    author = "Stahl, Titus",
    title = "Immanent Critique and Particular Moral Experience",
    year = "2017",
    note = "CORE ARGUMENT: Critical theories are often sceptical of grounding critique in general normative principles; Stahl argues immanent critique can instead draw on particular moral experience embedded in practices (PhilPapers summary). RELEVANCE: Bears on the source-of-standards question (experience vs. principle) and on how immanent critique avoids both abstract moralism and conservatism. POSITION: Practice-based immanent critique with a particularist epistemology.",
    keywords = "immanent-critique, moral-experience, Stahl, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Critical theories often express scepticism towards the idea that social critique should draw on general normative principles, seeing such principles as bound to dominant conceptual frameworks. However, even the models of immanent critique developed in the Frankfurt School tradition seem to privilege principles over particular moral experiences. Discussing the place that particular moral experience has in the models of Honneth, Ferrara and Adorno, the article argues that experience can play an important negative role even for a critical theory that is committed to the necessity of conceptual mediation, as moral experiences can undermine our confidence in the appropriateness of our moral concepts. Building on McDowell’s account of moral perception and Brandom’s interpretation of Hegel’s theory of experience, one can reconstruct Adorno as providing a “radically negativist” approach to immanent critique that takes particular moral experience seriously.",
    abstract_source = "openalex"
}

@misc{stahl2024oppressive,
    author = "Stahl, Titus",
    title = "Oppressive Forms of Life",
    year = "2024",
    pages = "77--93",
    note = {CORE ARGUMENT: Extends Jaeggi's model of immanent critique of forms of life by considering oppressive forms of life, in which subordinated groups are excluded from the interpretive processes that determine the practice's values. This challenges immanent critique, since immanent norms are partly constituted by interpretations that oppression may distort; Stahl argues Jaeggi's model can be defended or adapted. RELEVANCE: Directly addresses the "which norms?"/distorted-norms problem and Jaeggi's crisis model's sufficiency; a bridge to Domain 5. POSITION: Friendly amendment of Jaeggi's transformative model; practice-theoretic.},
    keywords = "immanent-critique, forms-of-life, oppression, Jaeggi, conservatism, High, METADATA\_CLEANED: journal, volume, number, doi, type:@article->@misc",
    abstract = "ABSTRACT Rahel Jaeggi argues that forms of life ought to be the main reference point for a critical theory of society because the internal normative structure of life forms allows for immanent critique. In this article, I extend her model by systematically considering the possibility of oppressive forms of life. Oppressive forms of life are clusters of practices in which subordinated groups are systematically excluded or disabled from participating in the social processes of interpretation through which the values and purposes of those very practices are determined. The possibility of oppressive forms of life poses a challenge to the method of immanent critique because it seems that any such critique must rely on immanent norms that are at least partly constituted by interpretations and that can therefore be distorted by oppression. I argue that Jaeggi’s model of immanent critique can be extended to respond to that challenge, either by recovering a constitutive form of freedom within all forms of life or by consciously adopting a partisan stance in favour of oppressed and marginalised self-understandings.",
    abstract_source = "s2"
}

@misc{jaeggi2018critique,
    author = "Jaeggi, Rahel",
    title = "Critique of Forms of Life",
    year = "2018",
    note = {CORE ARGUMENT: Rejects liberal "ethical abstinence" and develops an immanent critique of forms of life, conceived as ensembles of practices that function as problem-solving instances. Standards arise from the failures (crises, including second-order problems) of such ensembles, and transformations that resolve them count as learning processes (NDPR review of the book: a "dialectical pragmatism" inspired by Hegel, with Dewey and MacIntyre). Standards: immanent, neither external moral norms nor merely accepted internal ones. RELEVANCE: Central transformative model for the domain; supplies the crisis/problem-solving account of contradiction and a progress-oriented criterion. Contrasted with Adorno's negativism and Stahl's reconstructive account. POSITION: Transformative (strong) immanent critique, Hegelian pragmatist, with a formal theory of progress as learning.},
    keywords = "Jaeggi, forms-of-life, problem-solving, crisis, progress, transformative, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "For liberals, the question “Do others live rightly?” seems to demand a follow-up question: “Who am I to judge?” Peaceful coexistence, in this view, is predicated on restraint from morally evaluating our peers. But Rahel Jaeggi argues that criticizing is not only valid but also useful. Moral judgment is no error—the error lies in how we go about it.",
    abstract_source = "openalex"
}

@misc{jaeggi2009rethinking,
    author = "Jaeggi, Rahel",
    title = "Rethinking Ideology",
    year = "2009",
    note = "CORE ARGUMENT: Reworks the concept of ideology, linking ideology critique to immanent critique of social practices instead of to a theory of false consciousness. (Only title and bibliographic data verified; no abstract available from the APIs.) RELEVANCE: Source for Jaeggi's treatment of ideology critique as immanent critique and for relations between contradiction and ideology; to be read with the Celikates 2006 and Ng 2015 pieces. POSITION: Ideology critique as immanent critique (Hegelian-Marxian, non-epistemic).",
    keywords = "Jaeggi, ideology-critique, immanent-critique, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "In this chapter, I try to make a case for the revitalization of the critique of ideology as a form of social critique. Although this concept cannot be solely attributed to Marxism, it did reach a certain “maturity” 1 in Marx’s writings, and it has been embraced by the various traditions of “Western Marxism” up until contemporary Critical Theory. Today, the conjectural tide has turned against it. Does this mean, however, that there are no more ideologies — or merely that there is no more ideology critique? I build my case for a reconstruction of the critique of ideology on the following diagnosis: One, I believe that there still are certain social circumstances, certain forms of social domination that require a critique of ideology. Two, to regain and develop the concept of ideology critique, we must not only reopen the question of how exactly a critique of ideology works — even at the peak of its popularity, this was frequently anything but clear, as is often the case with popular theorems — but also critically reconstruct some of its basic assumptions. It is, then, a matter of both bringing the critique of ideology into the present and of finding a new understanding of it. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

@misc{jaeggi2018lebensformen,
    author = "Jaeggi, Rahel",
    title = "Lebensformen als Problemlösungsinstanzen",
    year = "2018",
    note = "CORE ARGUMENT: Presents the problem-solving conception of forms of life that underlies Kritik von Lebensformen: forms of life are evaluated by how they respond to the problems they face. (Title-level information only; no abstract available.) RELEVANCE: German-language statement of the crisis/problem-solving model; useful for the key question of whether the model is sufficiently immanent. POSITION: Transformative immanent critique via problem-solving.",
    keywords = "Jaeggi, problem-solving, forms-of-life, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{celikates2018critique,
    author = "Celikates, Robin",
    title = "Critique as Social Practice",
    year = "2018",
    note = "CORE ARGUMENT: Asks whether critical theory can diagnose ideology from above or must follow the critical practices of ordinary agents, and argues for moving beyond this dichotomy: ordinary agents engage in complex everyday critique, but critical theory must still analyze conditions that obstruct reflexive capacities. The approach must be non-paternalistic, pragmatist and dialogical as well as critical. RELEVANCE: Supplies the alternative to a theorist-reconstructed standard: standards and critical capacities lie in agents' reflexive practices; engages the sociology of critique (Boltanski) and relates to immanent critique as a form of social self-understanding. POSITION: Reflexive-pragmatist critical theory; mid-position between reconstruction and external ideology critique.",
    keywords = "Celikates, critique-as-practice, ideology-critique, pragmatism, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Can critical theory diagnose ideological delusion and false consciousness from above, or does it have to follow the practices of critique ordinary agents engage in? This book argues that we have to move beyond this dichotomy, which has led to a theoretical impasse. Whilst ordinary agents engage in complex forms of everyday critique, it must remain the task of critical theory to provide analysis and critique of social conditions that obstruct the development of reflexive capacities and of their realization in corresponding practices of critique. Only an approach that is at the same time non-paternalistic, pragmatist, and dialogical as well as critical will be able to realize the emancipatory potential of the Frankfurt School tradition of critical theory in radically changing social circumstances. abstract\_source = {s2}, The translation of this work was funded by Geisteswissenschaften International – Translation Funding for Humanities and Social Sciences from Germany, a joint initiative of the Fritz Thyssen Foundation, the German Federal Foreign Office, the collecting society VG WORT and the Börsenverein des Deutschen Buchhandels (German Publisher \& Booksellers Association)"
}

@misc{celikates2006from,
    author = "Celikates, Robin",
    title = "From Critical Social Theory to a Social Theory of Critique: On the Critique of Ideology after the Pragmatic Turn",
    year = "2006",
    note = "CORE ARGUMENT: Title indicates a shift from critical social theory to a social theory of critique, reconstructing ideology critique after the pragmatic turn (no abstract available). It anticipates Celikates's later view that actors' own critical practices are the basis of theory. RELEVANCE: Early version of the Celikates programme that frames the source-of-standards problem in sociological-pragmatist terms; connects to Boltanski. POSITION: Reflexive-pragmatist reconstruction of ideology critique.",
    keywords = "Celikates, ideology-critique, pragmatic-turn, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{celikates2012naoreconhecimento,
    author = "Celikates, Robin and Mattos, Fernando Costa",
    title = "O não reconhecimento sistemático e a prática da crítica: Bourdieu, Boltanski e o papel da teoria crítica",
    year = "2012",
    note = {CORE ARGUMENT: Argues that Boltanski's "pragmatic turn" should not lead to abandoning critical theory: the reflective capacities and justificatory practices of ordinary actors reconstructed by the sociology of critique form the social and methodological basis of critical theory, but this should not grant participants' perspective epistemic authority immune to theoretically informed questioning. RELEVANCE: Clear statement of Celikates's position between Bourdieu (critical sociology from above) and Boltanski (deference to actors); source of the "critical theory without a hegemonic observer" idea. POSITION: Non-deferential pragmatist critique.},
    keywords = "Celikates, Boltanski, Bourdieu, sociology-of-critique, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {The "pragmatic turn'" proposed by Boltanski and others should not lead us to abandon the project of Critical Theory, as if all necessary criticism were already articulated within everyday practices of critique. The reflective capacities of "ordinary" actors and their practices of justification and critique, which are convincingly reconstructed by the sociology of critique, constitute the social and methodological basis of critical theory. However, this should not lead us to attribute an epistemic authority to the perspective of the participants that is immune to being put into question from a theoretically informed point of view.},
    abstract_source = "s2"
}

@misc{boltanski2014spirit,
    author = "Boltanski, Luc and Honneth, Axel and Celikates, Robin",
    title = "The Spirit of Luc Boltanski: Sociology of Critique or Critical Theory? Luc Boltanski and Axel Honneth in Conversation with Robin Celikates",
    year = "2014",
    note = {CORE ARGUMENT: A conversation between Boltanski and Honneth, moderated by Celikates, on the relation between the pragmatic sociology of critique and Frankfurt-style critical theory. (Title-level information only; no abstract or venue data verified from the APIs.) RELEVANCE: Brings the Boltanski branch of "sociology of critique" into direct contact with reconstructive (Honneth) and practice-based (Celikates) accounts of the source of critical standards. POSITION: Dialogue between pragmatic sociology of critique and critical theory.},
    keywords = "Boltanski, Honneth, Celikates, sociology-of-critique, Medium, INCOMPLETE, no-abstract"
}

@misc{boltanski2006justification,
    author = "Boltanski, Luc and Thévenot, Laurent",
    title = "On Justification",
    year = "2006",
    note = "CORE ARGUMENT: Analyses how actors justify claims and criticize one another by appeal to plural orders of worth (cities); critique operates through shared principles of equivalence available to participants (known from the work itself; verification limited to bibliographic data). RELEVANCE: The sociological counterpart to internal critique: standards are the plural justifications operative in practice, used by Celikates and others as a foil for immanent critique and critical theory. POSITION: Pragmatic sociology of justification/critique.",
    keywords = "Boltanski, Thevenot, justification, sociology-of-critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
