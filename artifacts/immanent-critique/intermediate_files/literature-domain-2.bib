@misc{freyenhagen2013adorno,
    author = "Freyenhagen, Fabian",
    title = "Adorno's Practical Philosophy",
    year = "2013",
    note = {CORE ARGUMENT: Argues that Adorno has a practical philosophy with a determinate normative basis: a negative, "negative Aristotelian" account in which the bad (suffering, the wrong life) is more knowable than the good, so that guidance is given as living "less wrongly". Critique proceeds by identifying what is wrong in society as a whole, without needing a positive conception of the good or a Habermasian discursive foundation. RELEVANCE: Source of standards: negative, grounded in experienced suffering and in the unfulfilled possibility of a better society. Role of contradiction: social antagonism reveals the wrong. Reconstructive vs transformative: neither, strictly; it is a negativist critique with an emancipatory orientation. Progress: anti-teleological. Main anchor for the wrong-life debate (cross-reference Domain 6) and for the reply to the "normative problem". POSITION: Negativist reading of Adorno; contrast with O'Connor and Bernstein (rational/ethical readings) and Finlayson (open normative problem).},
    keywords = "Adorno, wrong-life, negative-normativity, negativism, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Adorno notoriously asserted that there is no 'right' life in our current social world. This assertion has contributed to the widespread perception that his philosophy has no practical import or coherent ethics, and he is often accused of being too negative. Fabian Freyenhagen reconstructs and defends Adorno's practical philosophy in response to these charges. He argues that Adorno's deep pessimism about the contemporary social world is coupled with a strong optimism about human potential, and that this optimism explains his negative views about the social world, and his demand that we resist and change it. He shows that Adorno holds a substantive ethics, albeit one that is minimalist and based on a pluralist conception of the bad - a guide for living less wrongly. His incisive study does much to advance our understanding of Adorno, and is also an important intervention into current debates in moral philosophy.",
    abstract_source = "openalex"
}

@misc{freyenhagen2017whole,
    author = "Freyenhagen, Fabian",
    title = "A whole lot of misery: Adorno's negative Aristotelianism---Replies to Allen, Celikates, and O'Connor",
    year = "2017",
    note = "CORE ARGUMENT: Replies to critics of Adorno's Practical Philosophy. Defends the claim that Adorno's critique rests on a negative ethical naturalism (an Aristotelian focus on what harms human flourishing) and answers objections by Allen (on progress and Eurocentrism), Celikates (on the practice of critique) and O'Connor (on the rational basis). RELEVANCE: Shows where the negativist reading is contested: the status of the progress assumption, the relation of immanent critique to practice, and the rational ground. Useful for the sceptical voices on the source of standards and on progress. POSITION: Negativist defence against the rational/epistemic and decolonial-sceptical readings.",
    keywords = "Adorno, negativism, progress, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Can one both be an Aristotelian in ethics and a negativist, whereby the latter involves subscribing to the view that the good cannot be known in our social context but that ethical guidance is nonetheless possible in virtue of a pluralist conception of the bad (of which this context and human history provide us ample knowledge)? Moreover, is it possible to combine Aristotelianism with a thoroughly historical outlook? I have argued that such combinations are, indeed, possible, and that we can find an example of them in Adorno's work. In this paper, I reply to three critics (Allen, Celikates and O'Connor) who cast doubt on this proposal. I also reply to other concerns they raise, regarding immanent critique, negativism, the role of social theory in Adorno's work, and the danger of being co‐opted. I stress the holism of Adorno's position, and, amid some more deflationary moves, insist on the distinctiveness of the Aristotelian position that results.",
    abstract_source = "openalex"
}

@misc{finlayson2002adorno,
    author = "Finlayson, James Gordon",
    title = "Adorno on the Ethical and the Ineffable",
    year = "2002",
    note = "CORE ARGUMENT: Examines Adorno's claims that ethics cannot be systematically stated and that the good remains ineffable, and argues (per the abstract) that Adorno does have a normative ethics, albeit a minimal and negative ethics of resistance, while his ethical thought remains hard to articulate. RELEVANCE: Early statement on Adorno's source of standards: if immanent critique draws on no external or positive standard, what warrants its judgments, and what can be said of the ethical? Anticipates Freyenhagen's negativist reading within the wrong-life question. POSITION: Analytic reading attributing a minimal negative ethics to Adorno.",
    keywords = "Adorno, ethics, ineffable, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The thesis is that Adorno has a normative ethics, albeit a minimal and negative ethics of resistance. However Adorno’s ethical theory faces two problems: the problem of the availability of the good and the problem of whether a normative ethics is consistent with philosophical negativism. The author argues that a correct of understanding the role of the ineffable in Adorno’s Negative Dialectics solves both problems: it provides an account of the availability of the good that is consistent with his philosophical negativism. The author counters the prevalent objection that Adorno’s aporetic philosophy, like some negative theology, leads to irrationalism and mysticism. The parallel with negative theology is developed by means of a comparison with Nicholas of Cusa. Drawing on Wittgentstein’s saying/showing distinction and Adrian Moore’s work the author argues that Nicholas and Adorno can be seen to share a philosophically defensible notion of ineffable knowledge.",
    abstract_source = "s2"
}

@article{finlayson2003theory,
    author = "Finlayson, James Gordon",
    title = "The Theory of Ideology and the Ideology of Theory: Habermas Contra Adorno",
    journal = "Historical Materialism",
    year = "2003",
    note = "CORE ARGUMENT: Reconstructs Habermas's criticism of Adorno (and Horkheimer) as ideology critique lacking a normative standard, and offers an evaluation and qualified defense of Habermas's critique of Adorno's conceptions of ideology and ideology criticism (per the abstract), i.e. a largely Habermasian verdict on the limits of Adorno's immanent ideology critique. RELEVANCE: Bears directly on the performative-contradiction exchange and on the contrast between Habermas's reconstructive procedure and Adorno's immanent method. Source of standards: contradiction within ideology. Role of contradiction: central. POSITION: Qualified defence of the Habermasian critique of Adorno; sceptical about Adorno's ideology critique.",
    keywords = "Adorno, Habermas, ideology, performative-contradiction, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "An evaluation and qualified defense of Habermas's critique of Adorno's conceptions of ideology and ideology criticism.",
    abstract_source = "openalex"
}

@misc{finlayson2009morality,
    author = "Finlayson, J. G.",
    title = "Morality and Critical Theory: On the Normative Problem of Frankfurt School Social Criticism",
    year = "2009",
    note = {CORE ARGUMENT: Treats the "normative problem" of how Frankfurt School social criticism can claim authority without moral foundations, surveying immanent and externalist solutions across the generations (Horkheimer, Adorno, Habermas, Honneth) and arguing that none fully resolves it. RELEVANCE: A synoptic account of the source-of-standards question that links this domain to Habermas and Honneth (Domain 3) and the foundations debate (Domain 5). Sceptical in orientation. POSITION: Sceptical assessment of normative foundations in Critical Theory.},
    keywords = "Critical-Theory, normative-foundations, sceptical, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "I. The Problem of Normative Foundations: Habermas's Original Criticism of Adorno and Horkheimer In The Theory of Communicative Action, Jürgen Habermas writes: From the beginning, critical theory labored over the difficulty of giving an account of its own normative foundations …1 Call this Habermas's original objection to the problem of normative foundations. It has been hugely influential both in the interpretation and assessment of Frankfurt School critical theory and in the development of later variants of it. Nowadays it is a truth almost universally acknowledged that any critical social theory in possession of normative…",
    abstract_source = "s2"
}

@misc{oconnor2004adorno,
    author = "O'Connor, Brian",
    title = "Adorno's Negative Dialectic",
    year = "2004",
    note = "CORE ARGUMENT: Reads Negative Dialectics as a critique of Kant's and Hegel's idealism and defends Adorno's position as one that preserves critical rationality: experience of the object's non-identity corrects concepts, giving a rational yet non-foundational account of knowledge. RELEVANCE: Epistemic ground for immanent critique: standards arise from the failure of concepts to fit objects, tested within a rational practice. Role of contradiction: epistemic, in the non-identity of concept and object. Supports reading immanent critique as rationally defensible against Habermas (SEP notes O'Connor's defence of Adorno). POSITION: Rational-epistemic reading of Adorno; contrast with negativist (Freyenhagen) and sceptical (Geuss) readings.",
    keywords = "Adorno, negative-dialectics, non-identity, critical-rationality, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {The purely philosophical concerns of Theodor W. Adorno's negative dialectic would seem to be far removed from the concreteness of critical theory; Adorno's philosophy considers perhaps the most traditional subject of "pure" philosophy, the structure of experience, whereas critical theory examines specific aspects of society. But, as Brian O'Connor demonstrates in this highly original interpretation of Adorno's philosophy, the negative dialectic can be seen as the theoretical foundation of the reflexivity or critical rationality required by critical theory. Adorno, O'Connor argues, is committed to the "concretion" of philosophy: his thesis of nonidentity attempts to show that reality is not reducible to appearances. This lays the foundation for the applied "concrete" critique of appearances that is essential to the possibility of critical theory. To explicate the context in which Adorno's philosophy operates—the tradition of modern German philosophy, from Kant to Heidegger—O'Connor examines in detail the ideas of these philosophers as well as Adorno's self-defining differences with them. O'Connor discusses Georg LucÃ cs and the influence of his "protocritical theory" on Adorno's thought; the elements of Kant's and Hegel's German idealism appropriated by Adorno for his theory of subject-object mediation; the priority of the object and the agency of the subject in Adorno's epistemology; and Adorno's important critiques of Kant and the phenomenology of Heidegger and Husserl, critiques that both illuminate Adorno's key concepts and reveal his construction of critical theory through an engagement with the problems of philosophy.},
    abstract_source = "openalex"
}

@misc{stone2014adorno,
    author = "Stone, Alison",
    title = "Adorno, Hegel, and Dialectic",
    year = "2014",
    volume = "22",
    note = "CORE ARGUMENT: Argues that Adorno retains a Hegelian dialectical method but drops Hegel's closure and identity-thinking, treating contradictions as signs of the non-identity of concepts with their objects. RELEVANCE: Clarifies the link to Domain 1 (determinate negation): Adorno's immanent critique is dialectical without teleology or reconciliation. Position on progress: breaks with Hegelian progress. Role of contradiction: retained, with non-identity. POSITION: Hegel-Adorno continuity-with-revision reading.",
    keywords = "Adorno, Hegel, dialectic, non-identity, determinate-negation, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article explores critical theory's relations to German idealism by clarifying how Adorno's thought relates to Hegel's. Adorno's apparently mixed responses to Hegel centre on the dialectic and actually form a coherent whole. In his Logic, Hegel outlines the dialectical process by which categories – fundamental forms of thought and reality – necessarily follow one another in three stages: abstraction, dialectic proper, and the speculative (famously simplified as ‘thesis, antithesis, synthesis’). Adorno's allegiance to Hegel's dialectic emerges when he traces the dialectical process whereby enlightenment reverts to myth and human domination over nature reverts into our domination by nature. However, Adorno criticizes Hegel's dialectic as the ultimate form of ‘identity thinking’, subsuming unique, material objects under universal concepts by using dialectical reason to expand those concepts to cover objects utterly. These two responses cohere because Adorno shares Hegel's view that dialectical contradictions require reconciliation, but differs from Hegel on the nature of reconciliation. For Hegel, reconciliation unites differences into a whole; for Adorno, reconciled differences co-exist as differences. Finally, against Habermas who holds that Adorno cannot consistently criticize the enlightenment practice of critique, I show that Adorno can do so consistently because of how he reshapes Hegelian dialectic.",
    abstract_source = "openalex"
}

@misc{bernstein2001adorno,
    author = "Bernstein, J. M.",
    title = "Adorno: Disenchantment and Ethics",
    year = "2001",
    note = "CORE ARGUMENT: Argues that Adorno's philosophy is an ethical critique of disenchantment: instrumental rationality empties moral claims of their ground, and Adorno responds through a critical, dialectical thinking of the bearing of aesthetic and moral experience on modernity. Entry details taken from Semantic Scholar; no DOI usable (Choice review-stub only). RELEVANCE: Offers an ethical-reconstructive reading of Adorno's immanent critique, locating standards in the unredeemed promise of moral and aesthetic experience in the history of reason. Counterposes both Habermas's proceduralism and pure negativism. POSITION: Ethical/neo-Hegelian reading; compare Freyenhagen, O'Connor.",
    keywords = "Adorno, ethics, disenchantment, moral-experience, High, INCOMPLETE, no-abstract"
}

@misc{geuss1981idea,
    author = "Geuss, Raymond",
    title = "The Idea of a Critical Theory: Habermas and the Frankfurt School",
    year = "1981",
    note = {CORE ARGUMENT: Analyses Critical Theory as a form of reflective, emancipatory knowledge that criticises ideology by showing that agents' beliefs are false consciousness in an epistemic, functional or genetic sense, and that a critical theory is justified by the agents' acceptance under conditions of reflection. SEP (Adorno) cites Geuss for a defence of Adorno's "ad hoc" ideology critique against Habermas's more Kantian variety. RELEVANCE: Provides the analytic framework for evaluating immanent critique: how critique can be warranted without external standards, and the role of contradiction in unmasking ideology. Source of standards: agents' reflective acceptance. Sceptical on foundations; sets up Geuss's later realist critique (Domain 5). POSITION: Analytic reconstruction of Critical Theory; sympathetic to non-foundational, ideology-critical versions.},
    keywords = "Critical-Theory, ideology-critique, Habermas, Frankfurt-School, High, INCOMPLETE, no-abstract"
}

@misc{geuss2016forty,
    author = "Geuss, Raymond",
    title = "The Idea of a Critical Theory, Forty Years On",
    year = "2016",
    note = "CORE ARGUMENT: A short retrospective by Geuss on The Idea of a Critical Theory, reassessing its aims in the light of subsequent developments in Critical Theory. RELEVANCE: Documents Geuss's own revision of the epistemic account of critique; usable as a sceptical, realist voice bridging first-generation Critical Theory and the realist critique of moralized theory in Domain 5. POSITION: Realist-leaning retrospective on Critical Theory.",
    keywords = "Geuss, Critical-Theory, realism, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{cook2004adorno,
    author = "Cook, Deborah",
    title = "Adorno, Habermas and the Search for a Rational Society",
    year = "2004",
    note = "CORE ARGUMENT: Compares Adorno's and Habermas's conceptions of a rational society and argues that Adorno's critique of instrumental reason, and his appeal to reason's unrealized potential, avoid the performative-contradiction charge, while Habermas's communicative theory risks affirming existing rationalized structures. (Abstract-level description, enrichment pending.) RELEVANCE: Key defence of Adorno against Habermas (cited in SEP Critical Theory). Source of standards: the unrealized possibility of reason in existing society. Role of contradiction: between actual and potential rationality. POSITION: Pro-Adorno response to Habermas's critique of Dialectic of Enlightenment.",
    keywords = "Adorno, Habermas, performative-contradiction, rational-society, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Theodor W. Adorno and Jnrgen Habermas both champion the goal of a rational society. However, they differ significantly about what this society should look like and how best to achieve it. Exploring the premises shared by both critical theorists, along with their profound disagreements about social conditions today, this book defends Adorno against Habermas' influential criticisms of his account of Western society and prospects for achieving reasonable conditions of human life. The book begins with an overview of these critical theories of Western society. Both Adorno and Habermas follow Georg Lukacs when they argue that domination consists in the reifying extension of a calculating, rationalizing form of thought to all areas of human life. Their views about reification are discussed in the second chapter. In chapter three the author explores their conflicting accounts of the historical emergence and development of the type of rationality now prevalent in the West. Since Adorno and Habermas claim to have a critical purchase on reified social life, the critical leverage of their theories is assessed in chapter four. The final chapter deals with their opposing views about what a rational society would look like, as well as their claims about the prospects for establishing such a society. Adorno, Habermas and the Search for a Rational Society will be essential reading for students and researchers of critical theory, political theory and the work of Adorno and Habermas.",
    abstract_source = "openalex"
}

@article{cook2002communication,
    author = "Cook, Deborah",
    title = "Communication in Constellation: Adorno and Habermas on Communicative Practices under Late Capitalism",
    journal = "Philosophy Today",
    year = "2002",
    volume = "46",
    note = "CORE ARGUMENT: Compares Adorno's and Habermas's views of communicative practice under late capitalism and argues that Adorno's constellational thinking registers distortions of communication that Habermas's model underplays. RELEVANCE: Short companion to Cook's book; indicates the argument that immanent critique can diagnose systematic distortions without a theory of idealised communication. POSITION: Pro-Adorno comparison with Habermas.",
    keywords = "Adorno, Habermas, constellation, late-capitalism, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "On Theodor W. Adorno's account of late capitalism, the exchange principle distorts interpersonal relations to such a degree that individuals see themselves and others in much the same way that they view the commodities that they produce for the marketplace. Pressured to adapt to a thoroughly reified society, individuals currently display narcissistic personality traits; their relationships others shallow and self-centered; and their understanding of the world often consists in a positivistic endorsement of what exists. These negative effects of the exchange principle on personality, sociality, and culture have not left communication unscathed. In a characteristically bleak pronouncement, Adorno complained that present each communicative step is falsifying truth and selling it out.1 Agreeing his colleague Herbert Marcuse, who railed against the one-dimensional abridgement of language to a tautological affirmation of existing states of affairs, Adorno also observed that language-use currently resembles ventriloquism. Vacuous and mechanical, consisting in stock phrases and cliches, the words we use in conversation are coming to resemble the formulae which used to be reserved for greeting and leave-taking. Furthermore, everyday speech has become competitive, or sportified. When issues discussed today, speakers simply seek to pile up points: there is no conversation that is not infiltrated like a poison by an opportunity to compete.2 Yet, even as they cling tenaciously to their opinions, narcissistically investing them with affect,3 individuals seldom hold beliefs that deviate from the dominant or prevailing ones: what is believed to be true is usually nothing other what everyone thinks (ODS, 106). For his part, of course, Jurgen Habermas offers a markedly different assessment of the state of communicative practices today. Conceding that the functionalist rationality of the economic and political subsystems has succeeded in colonizing these practices and distorting them, he nonetheless attempts to counter Adorno's skepticism about communicative interaction. For this second generation critical theorist, a more authentic form of reason is already incarnated in contexts of communicative action and in structures of the lifeworld.4 Oriented towards an understanding (Verstandigung) of the world reached through argumentative practices that redeem claims to propositional truth, normative rightness, subjective truthfulness, and aesthetic harmony,5 reason now manifests itself in everyday conversation to the extent that communicative action satisfies the ideal presuppositions embedded in it. Very generally, when we converse to reach understanding, we cannot but presuppose that our arguments both exclude all external or internal coercion other than the force of the better argument, and neutralize all motives other than that of the cooperative search for truth.6 When the force of the better argument prevails in communicative practices, rational agreement about states of affairs, moral principles, and expressive matters may be achieved. Such agreement not only serves as a warrant for our knowledge about the world, it also sustains and promotes solidarity others, while fostering a measure of personal autonomy and responsibility. In turn, knowledge, solidarity, and autonomy may allow members of the lifeworld successfully to defend themselves more or less successfully against the colonizing encroachments of the economic and political subsystems. What I want to do here is to identify some of the more interesting points of contrast between Adorno's and Habermas' ideas about communication the immediate aim of pointing out precisely what is at stake when communication assumes the status of a philosophical problem in their work. To do this, I shall explore the constellation of concepts and ideas in which these theorists situate their accounts of communication. Subjectivity and intersubjectivity, fascism and democracy, unreason and reason, and dystopia and utopia four of the notional bodies around which their ideas of communication revolve. …",
    abstract_source = "openalex"
}

@misc{cook2018adorno,
    author = "Cook, D.",
    title = "Adorno, Foucault and the Critique of the West",
    year = "2018",
    note = "CORE ARGUMENT: Places Adorno and Foucault together as critics of Western reason, showing that both diagnose how rationality can become domination and argue that critique must proceed from within the formations it criticises (details from title and Semantic Scholar record; reviews by Erxleben/Riep 2020 and Lichtenstein 2020 exist). RELEVANCE: Connects first-generation immanent critique with genealogical critique, a contrast central to external vs immanent critique in Domain 5. POSITION: Comparative Adorno-Foucault reading.",
    keywords = "Adorno, Foucault, critique-of-reason, genealogy, Medium, INCOMPLETE, no-abstract"
}

@misc{gordon2016adorno,
    author = "Gordon, Peter E.",
    title = "Adorno and Existence",
    year = "2016",
    note = "CORE ARGUMENT: Argues that Adorno's philosophy is a critique of existentialism and Heideggerian ontology that nevertheless takes up the questions of human existence, presenting negative dialectics as a philosophy of non-identity that preserves the particular. SEP (Adorno) cites Gordon on the early writings. RELEVANCE: Historical reconstruction of how Adorno's methods of immanent critique developed against phenomenology; source of standards is the experience of the particular. Useful for the 'Adorno's relation to idealism and existential philosophy' background; reviewed by Finlayson, Hammer, Pippin and Wolin. POSITION: Intellectual-historical reading of Adorno.",
    keywords = "Adorno, existentialism, non-identity, Medium, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Adorno was forever returning to the philosophies of bourgeois interiority, seeking the paradoxical relation between their manifest failure and their hidden promise. As Peter E. Gordon shows, Adorno’s writings on Kierkegaard, Husserl, and Heidegger present us with a photographic negative—a philosophical portrait of the author himself.",
    abstract_source = "openalex"
}

@misc{hammer2025routledge,
    editor = "Hammer, Espen and Rush, Fred",
    title = "The Routledge Guidebook to Horkheimer and Adorno's Dialectic of Enlightenment",
    year = "2025",
    note = "CORE ARGUMENT: A guidebook to Dialectic of Enlightenment, reading the text's account of myth and enlightenment, culture industry and anti-Semitism. RELEVANCE: Recent edited reading by two anchor authors; use for the current understanding of the book's self-critical method and whether it leaves room for immanent critique (performative contradiction). Consult directly for the position on contradiction and progress. POSITION: Reference reading of the text.",
    keywords = "Dialectic-of-Enlightenment, Horkheimer, Adorno, Medium, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Composed whilst in exile in the United States during the Second World War, Max Horkheimer and Theodor W. Adorno’s Dialectic of Enlightenment is the most famous and influential text of the Frankfurt School. A theoretical exploration of history, modernity, and culture, its core warning of crisis and regression remains highly relevant today. However, it is also a notoriously complex work of philosophy. The Routledge Guidebook to Horkheimer and Adorno’s Dialectic of Enlightenment is the first fully contextualized introduction to this foundational text in philosophy and social theory, addressing its central themes, reception, and influence. This Guidebook examines: The conceptual and intellectual background to Dialectic of Enlightenment. The ideas, themes, and arguments of the text. The reception and legacy of Dialectic of Enlightenment. A comprehensive and clearly written guide to this important text, The Routledge Guidebook to Horkheimer and Adorno’s Dialectic of Enlightenment will be invaluable to students coming to the work for the first time, as well as more advanced students and researchers in philosophy, politics, sociology, and the history of ideas.",
    abstract_source = "openalex"
}

@misc{horkheimer2020dialectic,
    author = "Horkheimer, Max and Adorno, Theodor Wiesengrund",
    title = "Dialectic of Enlightenment",
    year = "2020",
    note = "CORE ARGUMENT: Argues that enlightenment reason, in its drive to dominate nature, reverts to myth and domination, which culminates in instrumental rationality and the culture industry. The text criticises enlightenment by its own aims, applying determinate negation to the concept of enlightenment itself. RELEVANCE: Primary text for the totalization worry: its self-referential critique prompted Habermas's performative-contradiction charge. Position on progress: dialectical, with progress turning into regress. Standards: the unrealized promise of enlightenment. POSITION: Primary source of first-generation negativist immanent critique.",
    keywords = "Dialectic-of-Enlightenment, primary-source, instrumental-reason, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Dialectic of Enlightenment is, quite justifiably, one of the most celebrated and often cited works of modern social philosophy. It has been identified as the keystone of the 'Frankfurt School', of which Theodor Adorno and Max Horkheimer were the leading members, and does not cease to impress in its wide-ranging ambition and panache. Adorno and Horkheimer addressees themselves to a question which went to the very heart of the modern age, namely 'why mankind, instead of entering into a truly human condition, is sinking into a new kind of barbarism'. Modernity, far from redeeming the promises and hopes of the Enlightenment, had resulted in a stultification of mankind and an administered society, characterised by simulation and candy-floss entertainment. To seek an answer to the question of how such a condition could arise, Adorno and Horkheier subjected the whole history of Western catagories of reason and nature, from Homer to Nietzsche, to a searching philosophical and psychological critique. Drawing on psychoanalytical insights, their own work on the 'culture industry', deep knowledge of the key Enlightenment and anti-Enlightenment thinkers, as well as fascinating considerations on the relationship between reason and myth - the rational and the irrational - the authors exposed the domination and violence towards both nature and humanity that underpin the Enlightenment project.",
    abstract_source = "s2"
}

@misc{habermas1985philosophical,
    author = "Habermas, J.",
    title = "The Philosophical Discourse of Modernity",
    year = "1985",
    note = "CORE ARGUMENT: In the chapters on Horkheimer and Adorno, Habermas charges that Dialectic of Enlightenment's totalizing critique of reason is a performative contradiction: it uses reason to criticise reason while denying the validity claims on which its critique depends, and neglects the rational potential of communicative action. (Characterisation follows SEP Adorno on Habermas's critique.) RELEVANCE: Original statement of the performative-contradiction charge that frames the question of whether the first generation leaves room for immanent critique. Habermas's alternative: reconstruction of communicative rationality (Domain 3). POSITION: Reconstructive critique of the first generation's totalization.",
    keywords = "Habermas, performative-contradiction, Dialectic-of-Enlightenment, High, INCOMPLETE, no-abstract"
}

@misc{merawi2018limits,
    author = "Merawi, Fasil",
    title = "Limits of Critical Theory, Critique and Emancipation in Habermas' Critique of Horkheimer and Adorno",
    year = "2018",
    volume = "2",
    note = "CORE ARGUMENT: Examines Habermas's critique of Horkheimer and Adorno and the limits it identifies in their critique of instrumental reason and conception of emancipation. RELEVANCE: Secondary summary of the Habermasian line on the first generation; limited as a source of original argument. POSITION: Expository, broadly Habermasian.",
    keywords = "Habermas, Horkheimer, Adorno, emancipation, Low, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Habermas' critical theory is partly an attempt to identify the limitations of critique and emancipation as espoused in the first generation critical theory of Max Horkheimer and Theodor Adorno.In their attempt to develop an interdisciplinary, reflexive, emancipatory and dialectical reason that is critical towards accepted realities, Horkheimer and Adorno in their monumental work The Dialectic of Enlightenment pictured a world trapped in instrumental rationality.Taking and revolutionizing traditional critical theory, Habermas argues that reason entails both emancipator as well as instrumental possibilities.Through an exposition of Habermas' critique of Horkheimer and Adorno in his discourse of modernity, this article argues that although Habermas successfully identifies the equation of the rational with the instrumental and offers an emancipator model in return; still he ends up not paying sufficient attention to aesthetic truth.",
    abstract_source = "openalex"
}

@misc{kalyvas2004back,
    author = "Kalyvas, Andreas",
    title = "Back to Adorno?",
    year = "2004",
    volume = "32",
    note = "CORE ARGUMENT: Review essay on the revival of Adorno scholarship, assessing whether Adorno's thought supplies resources for contemporary political theory. RELEVANCE: Illustrates the sceptical question of Adorno's political and normative deficit raised by his return to prominence; use as a contemporary sceptical voice. POSITION: Critical review of the Adorno revival.",
    keywords = "Adorno, political-theory, sceptical, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{decaux2024antinomic,
    author = "de Caux, Luiz Philipe",
    title = "Antinomic normativity: Negative dialectics, moral skepticism, and the problem of the normative foundations of critical theory",
    year = "2024",
    volume = "52",
    note = {CORE ARGUMENT: Argues that negative dialectics answers moral scepticism about the normative foundations of Critical Theory through an "antinomic" conception of normativity, in which norms arise from antinomies in concepts and social reality. RELEVANCE: Recent contribution to the source-of-standards debate with an explicit link between contradiction and normativity; useful for Domain 5's foundation debates. POSITION: Negative-dialectical answer to normative scepticism.},
    keywords = "Adorno, negative-dialectics, normative-foundations, antinomy, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article attempts to determine Adorno’s stance concerning two opposing positions in the relationship between critique and normativity. Although he rejects the demand to account for the normative foundations of critique, his negative dialectics does not fall back on the alternative of skepticism about normativity, of which it is often accused. I illustrate this problem by recovering the skeptical objections advanced by Justin Evans. Next, I turn to the young Hegel’s interpretation of the positive relationship between his speculative dialectics and skepticism to pose the question of what relationship now exists between negative dialectics and skepticism. The answer is outlined based on a reading of Minima Moralia under the interpretative key of the idea of real normative antinomies.",
    abstract_source = "s2"
}

@misc{skirke2024phenomenology,
    author = "Skirke, C.",
    title = "Phenomenology and the status quo: Adorno's mediation argument",
    year = "2024",
    volume = "52",
    note = {CORE ARGUMENT: Reconstructs Adorno's "mediation argument" against phenomenology as an immanent criticism: phenomenological description of experience is shown to be mediated by social conditions, and hence to reproduce the status quo. RELEVANCE: Recent analysis of how Adorno's immanent critique operates as a procedure, where the standard is the claim to immediacy of the criticised position. POSITION: Method-focused reading of Adorno's critique.},
    keywords = "Adorno, mediation, phenomenology, immanent-critique-method, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "In this paper, I discuss a well-known challenge against phenomenology as a viable form of social criticism. According to this challenge—the Mediation Argument—phenomenology falls short of the requirement that any kind of critique needs a suitable medium of representation because the phenomenological account of experience prioritizes immediacy or directness. I aim to show through a reconstruction of Adorno’s version of the Mediation Argument against Husserl that this challenge fails: it distorts the phenomenological account of meaning by misattributing problematic ontological commitments as well as an overly simplistic idea of normativity to phenomenology; and it systematically underplays critical aspects of the transcendental methodology of phenomenology by ignoring crucial contrasts between phenomenology and commonsense philosophy. Contrary to what the Mediation Argument suggests, I conclude, phenomenology is well-placed to confront the ontological commitments and normative assumptions that commonly lend ideological support to the status quo.",
    abstract_source = "s2"
}

@misc{ziegelmann2025immanent,
    author = "Ziegelmann, Robert",
    title = "Immanent Critique ``From the Standpoint of Redemption'': Adorno's Method and Its Sources in Kafka",
    year = "2025",
    note = {CORE ARGUMENT: Traces Adorno's immanent critique to Kafka and the notion of seeing things "from the standpoint of redemption" (Minima Moralia), linking the method to messianic or redemptive perspective. RELEVANCE: Directly theorises Adorno's immanent critique, connecting it to the Benjaminian redemptive strand and the problem of the standpoint from which to criticise a wrong life. Standards: the possibility of redemption as a limit perspective. POSITION: Redemptive/literary reading of Adorno's method.},
    keywords = "Adorno, immanent-critique, redemption, Kafka, Benjamin, High, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "Abstract At the conclusion of “Minima Moralia,” Theodor W. Adorno invokes a “standpoint of redemption.” I interpret this formulation as a methodological self-description and argue that it does not conflict with critical theory’s commitment to immanent critique. After distinguishing between two divergent accounts of immanent critique in recent scholarship, I turn to the idea of a “standpoint of redemption” or “inverse theology,” traced back to Siegfried Kracauer’s early writings on Franz Kafka. In his “Notes on Kafka,” Adorno develops motifs from Kracauer into his most thorough articulation of the negativist-messianic device. Instead of contrasting social phenomena with ideal alternatives, “inverse theology” presents the absurd as normal, rendering reality uncanny through analogies that depict humans as animals and the present as if it belonged to a distant past. In this way, the standpoint of redemption emerges indirectly, by estranging everyday life. Adorno’s reading of Kafka thus clarifies his own method of social critique. This method neither contradicts the version of immanent critique that, I contend, most faithfully captures the tradition of critical theory, nor does it entail substantive theological commitments. Rather, it can be understood as a form of “inverse utopianism.”",
    abstract_source = "s2"
}

@misc{athanassiadis2026ideology,
    author = "Athanassiadis, A.",
    title = "Adorno and the Kantian Sources of Ideology Critique",
    year = "2026",
    note = "CORE ARGUMENT: Argues that Adorno's ideology critique has Kantian sources (critique of illusion), alongside Hegelian-Marxist ones. (Based on title and S2 record; check abstract.) RELEVANCE: Bears on the source-of-standards question in ideology critique, pointing to a Kantian rather than purely Hegelian root for immanent critique; links to Domain 6 on ideology. POSITION: Kantian-genealogy reading of Adorno.",
    keywords = "Adorno, ideology-critique, Kant, Medium, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "Abstract Social theorists in the Marxian tradition often interpret philosophical problems as reflections of social problems. This approach is central to Adorno's interpretation of Kant's epistemology. Adorno claims that the Critique of Pure Reason develops a concept of subjectivity that mirrors the “functionalization” of experience in capitalist societies. He retains that concept contradictory just as the social functionalism it ideologically reflects. In this paper I argue that Kant's concept of subjectivity is not contradictory and that Adorno must rely on it to articulate his critique of functionalism. Recognizing this Kantian debt implies not just acknowledging the Kantian sources of Adorno's model of ideology critique, but also revising central aspects of his social theory.",
    abstract_source = "openalex"
}

@article{athanassiadis2026hegel,
    author = "Athanassiadis, A.",
    title = "Hegel in Adorno's post-Hegelianism",
    journal = "Hegel Bulletin",
    year = "2026",
    doi = "10.1017/hgl.2026.10093",
    note = "CORE ARGUMENT: Examines Hegel's role in Adorno's post-Hegelian philosophy, i.e. what Adorno retains and rejects of Hegelian dialectic. (Based on title and S2/CrossRef record.) RELEVANCE: Connects to Domain 1 on determinate negation and immanent critique; helps distinguish Hegelian from Adornian immanent critique on contradiction and reconciliation. POSITION: Hegel-Adorno relation.",
    keywords = "Adorno, Hegel, post-Hegelian, determinate-negation, Medium, METADATA\_CLEANED: pages",
    abstract = "Abstract According to a widely accepted interpretation, the dialectics of Adorno and Hegel pursue opposite goals despite their similar terminology. Adorno employs immanent critique and determinate negation within a negativistic model of social criticism, diagnosing the irrationality of Western capitalist societies without offering remedies. Hegel uses the same method to support a social quietism grounded in optimistic views about the rationality of modern societies. While I shall not dispute the thesis of a deep incompatibility between Adorno and Hegel, I argue that it overlooks a deeper issue. Adorno presents his negative dialectic as an alternative to Hegel’s, in so far as he claims to identify and criticize the latter’s identitarian character—its tendency to rationalize phenomena. I contend that Adorno’s critique misfires on several counts, most notably in its account of the source of Hegel’s identitarian problem. The crux of the matter, however, is neither Adorno’s Hegelianism nor his anti-Hegelianism, but the viability of his distinctive model of post-Hegelian philosophy.",
    abstract_source = "openalex"
}

@misc{martinson2014adorno,
    author = "Martinson, Mattias",
    title = "What Is Adorno Doing? Immanent Critique as Philosophical Performance",
    year = "2014",
    note = {CORE ARGUMENT: Treats Adorno's immanent critique as a performative philosophical practice rather than a theory with foundations, answering what Adorno is "doing" when he criticises. RELEVANCE: Offers a performance-based answer to the performative-contradiction and foundations worries: the critique is its enactment. Methodological focus on immanent critique in Adorno. POSITION: Practice-based reading of Adorno's method.},
    keywords = "Adorno, immanent-critique, method, performance, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "Anyone who approaches Adorno’s thought will soon become aware of several difficulties — a fact that commentators have been keen to point out: Adorno is an immensely difficult thinker (e.g. Brittain, Adorno and Theology 9; Jarvis, Adorno 2–3; Spitzer, Music as Philosophy 6–7; van Reijen, Adorno 1–2). Consequently, the traditional commentary on Adorno’s thought is there to help us in our understanding. Supported by commentators, who concentrate on this or that, we are supposed to slowly get around the main obstacles and get a clearer picture. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

@misc{antonio1981immanent,
    author = "Antonio, Robert J.",
    title = "Immanent Critique as the Core of Critical Theory: Its Origins and Developments in Hegel, Marx and Contemporary Thought",
    year = "1981",
    volume = "32",
    note = "CORE ARGUMENT: Argues that immanent critique, assessing a society by its own standards, is the core of Critical Theory and traces it from Hegel and Marx to the Frankfurt School and Habermas. RELEVANCE: Early historical account of immanent critique in Critical Theory; it supplies the long-run genealogy this review needs and flags differences between first-generation and Habermasian versions. Recorded as source for standards: the society's own norms. POSITION: Genealogical thesis that immanent critique unifies Critical Theory.",
    keywords = "immanent-critique, Critical-Theory, genealogy, Hegel, Marx, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Robert J. Antonio, Immanent Critique as the Core of Critical Theory: Its Origins and Developments in Hegel, Marx and Contemporary Thought, The British Journal of Sociology, Vol. 32, No. 3 (Sep., 1981), pp. 330-345",
    abstract_source = "openalex"
}

@misc{brincat2016traditional,
    author = "Brincat, S.",
    title = "Traditional, Problem-Solving and Critical Theory: An Analysis of Horkheimer and Cox's Setting of the `Critical' Divide",
    year = "2016",
    note = "CORE ARGUMENT: Compares Horkheimer's traditional/critical distinction with Cox's problem-solving/critical divide and examines the grounds on which each separates critical from non-critical theory. RELEVANCE: Secondary treatment of the Horkheimer essay; useful for the role of historical self-reflection in critical theory, though it is aimed at International Relations. POSITION: Comparative exposition.",
    keywords = "Horkheimer, traditional-critical-theory, Cox, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Robert W. Cox's dictum that ‘(t)heory is for someone and for some purpose’ (emphasis in the original) is said to be the most-quoted line in International Relations (IR) theory. Yet whilst this spurred a revolution in critical thinking in IR, it echoed a far older conception of Critical Theory advanced by Max Horkheimer in the 1930s that claimed there is ‘no theory of society … that does not contain political motivations'. Both sentiments emphasize the relation between knowledge and human interests, and yet both formulate two distinct—though allied—ways of approaching ‘critical’ theorizing. In order to understand the similarities and differences in their approaches, this paper draws out three loci of difference between Cox and Horkheimer regarding the question of emancipation: (i) the epistemological relation between ‘critical’ and ‘Problem-Solving’ (Cox) or ‘Traditional Theory’ (Horkheimer); (ii) the emphasis placed on transformation and historical process; and (iii) the importance of intersubjectivity in how each approach emancipation. It is argued that by actively combining critical (dialectical) approaches across the social sciences, broadening human agency through civilizational dialogue, and retaining a commitment to emancipatory (and visionary) political futures based on human association, that Critical International Theory can maintain ongoing relevance in IR.",
    abstract_source = "openalex"
}

@misc{gindner2023totality,
    author = "Gindner, Jette",
    title = "Totality Reconsidered: Lukács's History and Class Consciousness a Century On",
    year = "2023",
    note = "CORE ARGUMENT: Reassesses Lukacs's concept of totality in History and Class Consciousness, a century after its publication. RELEVANCE: Supplies recent scholarship on Lukacs's totality and reification as a precursor to later immanent critique: the standpoint of the totality supplies standards for criticising capitalist society, with the proletariat as the transformative subject. POSITION: Reappraisal of Lukacsian totality.",
    keywords = "Lukacs, totality, reification, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Georg Lukács’s essay collection History and Class Consciousness (1923) remains a foundational text of Western Marxism and a vital influence on contemporary German studies, not least by way of the Frankfurt School. Yet Lukács’s positing of the proletariat as the historical agent of revolutionary change raises difficult questions for radical Left theory and praxis in our rapidly deindustrializing world. Who or what is that working class that would redeem Lukács’s vision today? This article argues that the main concept for actualizing History and Class Consciousness is totality rather than class or reification. However, we should understand totality in a strictly negative sense, as a feature of capitalist coercion to be overcome in a free society.",
    abstract_source = "s2"
}

@misc{chari2010toward,
    author = "Chari, Anita",
    title = "Toward a political critique of reification: Lukács, Honneth and the aims of critical theory",
    year = "2010",
    note = "CORE ARGUMENT: Compares Lukacs's and Honneth's critiques of reification and argues for a political critique of reification that retains Lukacs's structural, practice-oriented focus against Honneth's recognition-theoretic reformulation. RELEVANCE: Contrasts transformative (Lukacs) and reconstructive (Honneth) models of immanent critique, and links the domain to Domain 3. Source of standards: social practice and proletarian standpoint for Lukacs, an antecedent recognition for Honneth. POSITION: Lukacsian critique of Honneth.",
    keywords = "Lukacs, Honneth, reification, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This article engages Axel Honneth’s recent work on Georg Lukács’ concept of reification in order to formulate a politically relevant and historically specific critique of capitalism that is applicable to theorizing contemporary democratic practice. I argue that Honneth’s attempt to reorient the critique of reification within the terms of a theory of recognition has done so at the cost of sacrificing the core of the concept, which forged a connection between the socio-political analysis of capitalist domination and an analysis of the unengaged, spectatorial stance of human beings toward the world, showing how they together impede emancipatory social transformation. In order to accomplish the unfinished task of rendering the critique of reification applicable to contemporary critical theory, I seek to synthesize the advantages of Honneth’s approach, which focuses on the normative aspects of the critique of reification, with Lukács’ emphasis on the practical, political-economic dimensions of reification and the historically specific pathologies of the capitalist social form.",
    abstract_source = "openalex"
}

@misc{buckmorss1977origin,
    author = "Buck-Morss, Susan",
    title = "The origin of negative dialectics: Theodor W. Adorno, Walter Benjamin and the Frankfurt Institute",
    year = "1977",
    note = "CORE ARGUMENT: Traces the formation of Adorno's negative dialectics in his exchange with Walter Benjamin and the Institute. SEP (Adorno) cites it for the influence of Kracauer, Lukacs and Benjamin on Adorno's pre-exile writings. RELEVANCE: Historical basis for the claim that Adorno's immanent critique developed from Benjamin's constellational method and from Lukacs's reification; clarifies how the two strands diverge on mediation and on theory's role. POSITION: Intellectual history of the Adorno-Benjamin relation.",
    keywords = "Adorno, Benjamin, negative-dialectics, constellation, High, INCOMPLETE, no-abstract"
}

@misc{helmling2003constellation,
    author = "Helmling, Steven",
    title = "Constellation and Critique: Adorno's Constellation, Benjamin's Dialectical Image",
    year = "2003",
    volume = "14",
    note = "CORE ARGUMENT: Compares Adorno's constellation with Benjamin's dialectical image as procedures of critique. RELEVANCE: Helps connect Benjamin's critique to Adorno's immanent critique: both avoid subsuming particulars under concepts. Locates differences over mediation and over the status of the image versus the concept. POSITION: Comparative reading of Adorno and Benjamin's methods.",
    keywords = "Benjamin, Adorno, constellation, dialectical-image, Medium, METADATA\_CLEANED: journal, number, doi, type:@article->@misc",
    abstract = "Constellation and Critique: Adorno’s Constellation, Benjamin’s Dialectical Image Steven Helmling (bio) Abstract This essay considers Adorno’s theory and practice of “constellation,” most centrally in relations both of influence and of tension with Walter Benjamin’s practice of the “dialectical image.” In later years, Adorno frequently ascribed to Benjamin’s practice a “Medusa-gaze” that effectively petrified, or (telling ambivalence) exposed the always-already-petrified reification, of its ideological object; in this way, Benjamin’s work aimed to evoke the baffled or arrested progress of modernity that he famously evoked in the phrase “dialectics at a standstill.” This was a thematic Adorno prolonged, but from very early on, Adorno had misgivings about the effect of stasis that Benjamin’s dialectical image as much reinforced as critiqued. The essay looks closely at various of Adorno’s formulations about Benjamin as well as about such related matters as “immanent critique,” Gestalt psychology, and Hölderlin’s practice of “parataxis,” to elicit the tensions in Adorno’s thinking, over the course of his career, about the critical or dialectical mimesis necessarily obtaining between critique and its object (the representation of the object, the representation of the overcoming of the object). A particular focus here is narrative, a standard property of the type(s) of critique that Adorno meant to refuse; Adorno’s “debate” with Lukàcs here appears as embodying the transition from “realism” to “modernism” that was the debate’s ostensible theme. The essay closes with reflections on failed progress, or progress reverting to regress. Benjamin’s “dialectics at a standstill” could be the apt formula, but also the fate from which Adorno and Horkheimer so desperately hope to redeem Enlightenment. —sh Fredric Jameson years ago characterized Adorno’s chief critical device or method as the “historical trope” (Marxism and Form 3–59), so it shouldn’t strike anyone as a novel claim that Adorno’s “constellation” displays affinities with other now-familiar devices of modernist art and literature—Eisensteinian montage, cubist collage, the Joycean “epiphany,” the Poundian “ideogram.” The young Adorno presumably first encountered the word’s relevant usages when he read Benjamin’s Trauerspiel in the late 1920s; however that may be, the word recurs in his work throughout his career, from “The Actuality of Philosophy” (1931) to the late pieces collected in Critical Models. Its connotations are diverse and often conflicting, and one could make an interesting study of such tellingly divergent uses, as well as an interesting speculation of the rarity of Adorno’s own second-level reflections on the word.1 The present study, however, attempts nothing so comprehensive.2 I want in this paper to unpack some of the implications of constellation as a critical practice and elicit their tension or contradiction (a word not necessarily a vitiation in Adorno’s usage, and in many contexts a term of high praise) with the overall program, derived from Hegel, that Adorno regularly calls “immanent critique.” To that end, I will consider constellation in relation to Walter Benjamin’s “dialectical image,” with which it has obvious but also qualified affinities, to the Gestalt psychology of Wolfgang Köhler, from which Adorno would have been anxious to distinguish it, and to the epic device of “parataxis” as Adorno commends Hölderlin’s use of it. I will end by bringing the issues that emerge to bear on the 1944 Dialectic of Enlightenment, co-authored with Max Horkheimer, and the curiously agitated stasis “motivating” its thematic of Western Civilization’s “progress” and “regress.” Adorno and Benjamin It is in his “Portrait of Walter Benjamin” that Adorno speaks most suggestively and, for his own practice, most revealingly, about the theory, the practice, and the effect, of Benjamin’s dialectical image: The [Benjaminian] essay as form consists in the ability to regard historical moments, manifestations of the objective spirit, “culture,” as though they were natural. Benjamin could do this as no one else. The totality of this thought is characterized by what may be called “natural history.” He was drawn to the petrified, frozen or obsolete elements of civilization, to everything in it devoid of domestic vitality [...]. The French word for still-life, nature morte, could be written above the...",
    abstract_source = "openalex"
}

@misc{feldman2011not,
    author = "Feldman, K.",
    title = "Not Dialectical Enough: On Benjamin, Adorno, and Autonomous Critique",
    year = "2011",
    volume = "44",
    note = {CORE ARGUMENT: Considers Adorno's criticism of Benjamin as "not dialectical enough" and what it shows about autonomous critique, i.e. critique that stands apart from the material it criticises. RELEVANCE: Bears on whether immanent critique can retain independence from its object; the Adorno-Benjamin exchange is a first-generation precedent for debates on mediation and autonomy. POSITION: Reads Adorno's critique of Benjamin as the paradigm dispute over critical autonomy.},
    keywords = "Benjamin, Adorno, autonomy, critique, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT With respect to Benjamin’s treatments of the work of art and his historiographical method, Adorno accuses Benjamin of not being dialectical enough and of inadequate theorizing. This article argues that Adorno’s blanket prescription for more dialectics covers over a chiastic relationship between his particular concern in each case. On one hand, Adorno worries that Benjamin gives over the artwork to ideological narratives. On the other hand, Adorno is concerned that Benjamin’s historical materialism refuses historical narrative, which is precisely where Benjamin locates ideology. Indeed the disruptive potential that Adorno grants the artwork with respect to social and political ideology thus corresponds to the disruptive potential that Benjamin ascribes to his historical materialism with respect to historicist ideology. In this context the article considers the nature of autonomy for Benjamin and Adorno and its relationship to subversion, disruption, and redemption.",
    abstract_source = "openalex"
}

@misc{weiss2014force,
