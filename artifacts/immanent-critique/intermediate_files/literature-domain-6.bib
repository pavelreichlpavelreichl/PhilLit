    author = "Levitas, Ruth",
    title = "Educated Hope: Ernst Bloch on Abstract and Concrete Utopia",
    year = "1991",
    note = "CORE ARGUMENT: Title indicates a discussion of Bloch's distinction between abstract and concrete utopia (abstract unavailable). RELEVANCE: Pointer to Bloch's concrete utopia, the anticipatory tendency in existing conditions (immanent transcendence); not verified beyond the title. POSITION: Secondary literature on Bloch's utopia (inferred).",
    keywords = "Bloch, utopia, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{rosa2013social,
    author = "Rosa, Hartmut",
    title = "Social Acceleration",
    year = "2013",
    note = "CORE ARGUMENT: Develops an account of the temporal structure of society from the perspective of critical theory: technological acceleration, acceleration of social change and acceleration of the pace of life, with the 'shrinking of the present'. RELEVANCE: Representative of a contemporary crisis-oriented critical theory of modernity; standards are not drawn from contradictions of a practice but from a time-theoretic diagnosis. Relevant to the crisis-theory question. POSITION: Time-theoretic critical theory of modernity.",
    keywords = "Rosa, acceleration, crisis, Low, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = {Hartmut Rosa advances an account of the temporal structure of society from the perspective of critical theory. He identifies three categories of change in the tempo of modern social life: technological acceleration, evident in transportation, communication, and production; the acceleration of social change, reflected in cultural knowledge, social institutions, and personal relationships; and acceleration in the pace of life, which happens despite the expectation that technological change should increase an individual's free time. According to Rosa, both the structural and cultural aspects of our institutions and practices are marked by the "shrinking of the present," a decreasing time period during which expectations based on past experience reliably match the future. When this phenomenon combines with technological acceleration and the increasing pace of life, time seems to flow ever faster, making our relationships to each other and the world fluid and problematic. It is as if we are standing on "slipping slopes," a steep social terrain that is itself in motion and in turn demands faster lives and technology. As Rosa deftly shows, this self-reinforcing feedback loop fundamentally determines the character of modern life.},
    abstract_source = "openalex"
}
