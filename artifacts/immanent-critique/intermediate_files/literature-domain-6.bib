@misc{stanley2015propaganda,
    author = "Stanley, Jason",
    title = "How Propaganda Works",
    year = "2015",
    note = "CORE ARGUMENT: Examines how propaganda operates subtly in democracies and undermines democratic ideals, particularly deliberation and equality; per Rossi (2017), the book argues that inequality causes ideologically flawed belief, which makes demagogic propaganda more effective. RELEVANCE: Epistemic account of ideology that appeals to democratic norms (equality, deliberation) as standards, not to the targets' own contradictions; useful as an external-standards contrast case, and the target of replies by Mills and Rossi. POSITION: Analytic epistemic ideology critique with (moralised) democratic norms.",
    keywords = "ideology, propaganda, epistemology, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Our democracy today is fraught with political campaigns, lobbyists, liberal media, and Fox News commentators, all using language to influence the way we think and reason about public issues. Even so, many of us believe that propaganda and manipulation aren't problems for us--not in the way they were for the totalitarian societies of the mid-twentieth century. In How Propaganda Works, Jason Stanley demonstrates that more attention needs to be paid. He examines how propaganda operates subtly, how it undermines democracy--particularly the ideals of democratic deliberation and equality--and how it has damaged democracies of the past",
    abstract_source = "openalex"
}

