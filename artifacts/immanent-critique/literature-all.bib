    keywords = "marx, postone, immanent-critique, frankfurt-school, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, publisher, type:@incollection->@misc"
}

@misc{heinrich2012introduction,
    author = "Heinrich, Michael",
    title = "An Introduction to the Three Volumes of Karl Marx's Capital",
    year = "2012",
    note = {CORE ARGUMENT: Heinrich presents the New Marx Reading: Marx's Capital is a critique of economic categories (the "monetary theory of value", value-form), not an alternative labour theory of value in the Ricardian sense. (Annotation from the book's known thesis; S2 record only provides title/year; CrossRef DOI found was a Choice review and is omitted.) RELEVANCE: Key source for the Neue Marx-Lektuere reading on which Capital is an immanent critique of the categories of political economy, including the scientific form of the economics. POSITION: Neue Marx-Lektuere; critique of categories, anti-substantialist value theory.},
    keywords = "marx, neue-marx-lektuere, value-form, High, INCOMPLETE, no-abstract"
}

@misc{arthur2002new,
