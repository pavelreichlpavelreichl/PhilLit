@misc{maker1994philosophy,
    author = "Maker, William",
    title = "Philosophy Without Foundations: Rethinking Hegel",
    year = "1994",
    note = {CORE ARGUMENT: Maker reads Hegel's system as a philosophy without foundations: the Phenomenology and Logic do not rest on a given first principle but justify themselves through their own self-critical development. (Annotation based on the title and published reviews surfaced in search; no abstract retrieved.) RELEVANCE: Gives the strongest non-foundationalist reading of the claim that Hegelian critique takes its standards from the object tested, directly bearing on the "source of standards" question and the worry about a circular or question-begging immanent method. Retained as a book-level entry (no DOI located). POSITION: Non-foundationalist, self-grounding interpretation of Hegel's method; contradiction as the engine of internal development.},
    keywords = "hegel, determinate-negation, non-foundationalism, High, INCOMPLETE, no-abstract"
}

@misc{pippin1989hegels,
    author = "Pippin, Robert B.",
    title = "Hegel's Idealism: The Satisfactions of Self-Consciousness",
    year = "1989",
    note = "CORE ARGUMENT: Pippin reads Hegel's idealism as a continuation of Kant's critical project, in which the Phenomenology's self-testing of forms of consciousness and the Logic's categorial argument vindicate the conditions of thought without recourse to external metaphysical claims. (Annotation grounded in SEP's citation of the work and the standard reading; confirm against abstract.) RELEVANCE: Anchor for the reading on which Hegel's critique of Kant is itself an immanent, post-Kantian continuation of critique rather than an external attack; the standards derive from the self-conscious activity of thought. POSITION: Kantian-continuity / non-metaphysical reading; criterion-testing as transcendental-style self-critique with historical elaboration.",
    keywords = "hegel, phenomenology, kant, criterion-testing, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "This is the most important book on Hegel to have appeared in the past ten years. Robert Pippin offers a completely new interpretation of Hegel's idealism, which focuses on Hegel's appropriation and development of kant's theoretical project. Hegel is presented neither as a precritical metaphysician nor as a social theorist, but as a critical philosopher whose disagreements with Kant, especially on the issue of intuitions, enrich the idealist arguments against empiricism, realism and naturalism. In the face of the dismissal of absolute idealism as either unintelligible or implausible, Pippin explains and defends an original account of the philosophical basis for Hegel's claims about the historical and social nature of selfconsciousness, and so of knowledge itself.",
    abstract_source = "openalex"
}

@misc{pinkard1994hegels,
    author = "Pinkard, Terry",
    title = "Hegel's Phenomenology: The Sociality of Reason",
    year = "1994",
    note = "CORE ARGUMENT: Pinkard reads the Phenomenology as showing that norms of reason are social achievements; failed shapes of consciousness fail because their implicit norms of mutual recognition cannot be sustained, and the sequence is a historical-social learning process. (Based on SEP's citation of the work and its title; no primary record with verified publisher located, DOI found belonged to a review.) RELEVANCE: Main source for the social-historical reading of determinate negation: the standard tested is a community's own normative practice, which supports a reconstructive/transformative reading later taken up by Frankfurt critical theory. POSITION: Social-historical, recognition-based reading; progress as retrospectively rational learning.",
    keywords = "hegel, phenomenology, sociality, recognition, High, INCOMPLETE, no-abstract"
}

@misc{rosen1982determinate,
    author = "Rosen, Michael",
    title = "Determinate Negation and Immanent Critique",
    year = "1982",
    note = "CORE ARGUMENT: The chapter examines Hegel's doctrine of determinate negation and the associated idea of immanent critique, asking whether criticism that takes its standards from the position criticised can generate a positive result without external assumptions. Rosen's book is a critical assessment of Hegel's dialectic and its claims. (Annotation based on title and context; SEP cites Rosen 1982 on determinate negation as a method.) RELEVANCE: The sceptical, analytic benchmark for the project: it frames the central question of whether immanent critique is probative or smuggles in external standards, and whether negation is logical or substantive. POSITION: Sceptical-analytic examination of Hegelian immanent critique and determinate negation.",
    keywords = "hegel, determinate-negation, immanent-critique, sceptic, High, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "It is the ways in to philosophy that are the most interesting part of the subject; for it is the course taken at the outset – in the first steps taken from ordinary ways of speaking to the extraordinary things which philosophers habitually say – that determines the whole of a thinker's theories. R. M. Hare The question which is to initiate the interpretation of Hegel is: can Hegel's speculative dialectic be criticized rationally? The question is of evident concern to the interpreter. But why should its openness to criticism be a special problem for the discussion of Hegel's system? What seems a forceful consideration presents itself: ‘The true’, Hegel writes, is the whole. But the whole is only the essence which completes itself through its development. It is to be said of the Absolute that it is essentially result , that only at the end is it that which it is in truth. ( P. d. G ., p. 21) And further: The true form in which the truth exists can only be as its Scientific system. ( P. d. G ., p. 12) If the truth requires a system, then it only properly exists at the point of completion of the system; what precedes it is only partial, but not adequate. As critics, however, what should interest us is how that point of completion is obtained, and whether we have arrived at it legitimately or not.",
    abstract_source = "openalex"
}

@misc{sedgwick1993pippin,
    author = "Sedgwick, Sally",
    title = "Pippin on Hegel's Critique of Kant",
    year = "1993",
    volume = "33",
    note = "CORE ARGUMENT: Sedgwick evaluates Pippin's account of Hegel's critique of Kant, assessing whether Hegel's criticisms of Kantian philosophy are internal to the critical project or depend on Hegelian premises. (Based on title and S2 record; no abstract retrieved.) RELEVANCE: A critical voice on the internal-versus-external character of Hegel's critique of Kant, which bears on whether Hegel's own immanence claim is secured. POSITION: Critical engagement with Pippin's Kantian-continuity reading.",
    keywords = "hegel, kant, external-critique, sceptic, Medium, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Commentaire sur l'interpretation de R.B. Pippin de la critique hegelienne de Kant dans « Hegel's Idealism: The Satisfactions of Self-Consciousness » (1989)",
    abstract_source = "openalex"
}

@misc{westphal2009blackwell,
    editor = "Westphal, Kenneth R.",
    title = "The Blackwell Guide to Hegel's Phenomenology of Spirit",
    year = "2009",
    doi = "10.1002/9781444306224",
    note = {CORE ARGUMENT: An edited guide with essays on the Phenomenology, including its Introduction's treatment of the criterion and its testing. (Annotation based on bibliographic record; content not read.) RELEVANCE: Source for the competing readings of the Introduction's criterion-testing (epistemological, social, pragmatic) that determine the "source of standards" in later immanent critique. POSITION: Plural collection spanning realist, pragmatist, and social readings.},
    keywords = "hegel, phenomenology, criterion-testing, Medium, METADATA\\_CLEANED: publisher, type:@book->@misc",
    abstract = "Notes on Contributors. References. Introduction. 1. Hegel's Phenomenological Method and Analysis of Consciousness: Kenneth R. Westphal (University of Kent, Canterbury). 2. Desire, Recognition, and the Relation between Bondsman and Lord: Frederick Neuhouser (Columbia University, New York). 3. Freedom and Thought: Stoicism, Skepticism, and Unhappy Consciousness: Franco Chiereghin (University of Padua). 4. Challenge of Reason: From Certainty to Truth: Cinzia Ferrini (University of Trieste). 5. Reason Observing Nature: Cinzia Ferrini (University of Trieste). 6. Shapes of Active Reason: Law of the Heart, Retrieved Virtue, and What Really Matters: Terry Pinkard (Georgetown University, Washington, DC). 7. Ethics of Freedom: Hegel on Reason as Law-Giving and Law-Testing: David Couzens Hoy (University of California, Santa Cruz). 8. Hegel, Antigone, and Feminist Critique: Spirit of Ancient Greece: Jocelyn B. Hoy (University of California, Santa Cruz). 9. Hegel's Critique of the Enlightenment in The Struggle of the Enlightenment with Superstition: Jurgen Stolzenberg (Martin-Luther-Universitat, Halle-Wittenburg). 10. Morality in Hegel's Phenomenology of Spirit: Frederick C. Beiser (Syracuse University, New York). 11. Religion, History, and Spirit in Hegel's Phenomenology of Spirit: George di Giovanni (McGill University, Montreal). 12. Absolute Knowing: Allegra de Laurentiis (SUNY-Stony Brook, New York). 13. Spirit and Concrete Subjectivity in Hegel's Phenomenology of Spirit: Marina F. Bykova (North Carolina State University). General Bibliography. Index of Names. Subject Index. Table of Concordances",
    abstract_source = "openalex"
}

@article{westphal2015hegels,
    author = "Westphal, Kenneth R.",
    title = "Hegel's Pragmatic Critique and Reconstruction of Kant's System of Principles in the 1807 Phenomenology of Spirit",
    journal = "Hegel Bulletin",
    year = "2015",
    note = "CORE ARGUMENT: Westphal argues that Hegel's 1807 Phenomenology offers a pragmatic critique and reconstruction of Kant's system of principles. (Based on the title; abstract to be confirmed.) RELEVANCE: Treats Hegel's critique of Kant as reconstructive rather than purely external, linking immanent critique to reconstruction of the criticised position. POSITION: Pragmatic-realist reading of Hegel's Phenomenology.",
    keywords = "hegel, kant, reconstruction, Medium, METADATA\\_CLEANED: volume, number, pages, doi",
    abstract = "Peirce's study of Kant, and later of Hegel, and Dewey's (1930) retention of much of Hegel's social philosophy are recognised idealist sources of pragmatism. Here I argue that the transition from idealism to pragmatic realism was already achieved by Hegel. Hegel's ‘Objective Logic’ corresponds in part to Kant's ‘Transcendental Logic’ (WdL,GW21:47.1-3). Hegel faults Kant for relegating concepts of reflection to an Appendix to his Transcendental Logic (WdL,GW12:19.34-38), and for treating reason as ‘only dialectical’ and as ‘merely regulative’ (WdL,GW12:23.12, .16-17). I present three important yet neglected features of Kant'sCritique of Pure Reasonwhich are key enthymemes undergirding Hegel's critical reconstruction of Kant's Critical philosophy (§2). I then summarise some features of the philosophical context within which Hegel begins to re-assess and reconstruct Kant's Transcendental Logic (§3), and review several key steps in this direction Hegel undertook in the 1807Phenomenology(§4). (A related paper extends these results to Hegel'sLogicandEncyclopaedia.) These points show that Hegel's reanalysis of Kant's Critical philosophy is the first and still one of the most sophisticated and adequate pragmatic — specifically pragmatic realist — accounts of thea priori.",
    abstract_source = "openalex"
}

@article{ninos2024hegels,
    author = "Ninos, Giannis",
    title = "Hegel's Theory of Finite Cognition and Marx's Critique of Political Economy",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "46",
    pages = "489--514",
    doi = "10.1017/hgl.2024.22",
    note = "CORE ARGUMENT: Ninos relates Hegel's theory of finite cognition (as in the Logic) to Marx's critique of political economy, treating the latter's method as informed by Hegelian dialectic. (Based on title; abstract pending.) RELEVANCE: Recent contribution connecting the Logic's method to Marx's critique of political economy, relevant to whether Marx's immanent critique inherits a logical or a social operation of determinate negation. POSITION: Hegel-Marx methodological continuity.",
    keywords = "hegel, marx, method, critique-of-political-economy, Medium, METADATA\\_CLEANED: number",
    abstract = "Abstract The article examines the role of Hegel's theory of finite cognition in Marx's critique of classical political economy. I argue that Hegel's distinction of finite cognition between analytic and synthetic in the Science of Logic constitutes the methodological framework through which Marx delineates the different stages of the development of political economy. Focusing on the Grundrisse, I reveal the Hegelian influence behind Marx's statements on previous political economists’ methods. Thus, Marx's immanent critique of the classical political economy is construed as undertaken from the level of the systematic dialectical method of Capital, and is modelled on Hegel's immanent critique of analytic and synthetic cognition from the perspective of absolute cognition. In this context, and focusing on Marx's critique of Ricardo's method, I argue that the latter's limitations are associated with the deficiencies of synthetic cognition as presented by Hegel. Therefore, the article sheds light on an important yet underexplored topic of the Hegel-Marx relationship. By indicating the centrality of Hegel's theory of finite cognition in Marx's methodological underpinnings, the article provides a new perspective on Hegel-Marx scholarship.",
    abstract_source = "s2"
}

@article{smith2022hegels,
    author = "Smith, Tony",
    title = "Hegel's Logic and Marx's Concept of Capital",
    journal = "Hegel Bulletin",
    year = "2022",
    note = "CORE ARGUMENT: Smith discusses how Hegel's Logic informs Marx's concept of capital, from the perspective of the systematic-dialectical approach. (Based on title; abstract pending.) RELEVANCE: A current statement of the systematic-dialectical reading, where categories in Capital are developed through internal conceptual necessity. POSITION: Systematic dialectic; Logic as model for Capital's presentation.",
    keywords = "hegel, marx, systematic-dialectic, Medium, METADATA\\_CLEANED: volume, number, pages, doi",
    abstract = "Arash Abazari's Hegel's Ontology of Power is a superb study of the relevance of Hegel's logic to Marx's theory. Hegel is often dismissed by Marxists as an ‘idealist’ denying the reality of the world, as if Hegel were Bishop Berkeley with a German accent.1 Abazari recognizes this is not the case: ‘(T)he logical categories are not self-standing, but shadow, or track, the empirical world’ (Abazari 2020: 7). But the world in its full actuality does not simply consist of the objects we sense or perceive. It is intrinsically intelligible, and its intelligibility can be comprehended only in thought. When it is, the ‘idealist’ thesis of the identity (in difference) of thought and being holds. Anyone asserting a truth claim implicitly asserts this identity. In so far as Marx asserts that Capital comprehends the capitalist mode of production, he too is an ‘idealist’ in the Hegelian sense of the term.",
    abstract_source = "s2"
}

@misc{moseley2014marxs,
    editor = "Moseley, Fred and Smith, Tony",
    title = "Marx's Capital and Hegel's Logic: A Reexamination",
    year = "2014",
    note = "CORE ARGUMENT: Edited volume reexamining how far Marx's Capital relies on Hegel's Logic, with contributions ranging from systematic-dialectic defences to critical views. (Annotation from record; contents not read in full.) RELEVANCE: Collects the main positions on whether Capital's method is a Hegelian immanent development of categories, a debate central to the question of Marx's immanence. POSITION: Plural collection on Hegel-Marx method debate.",
    keywords = "marx, hegel, capital, method, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "This book provides a wide-ranging and in-depth reappraisal of the relation between Marx’s economic theory in Capital and Hegel’s Logic by leading Marxian economists and philosophers from around the world. The subjects dealt with include: systematic dialectics, the New Dialectics, materialism vs. idealism, Marx’s ‘inversion’ of Hegel, Hegel’s Concept logic (universality-particularity-singularity), Hegel’s Essence logic (essence-appearance), Marx’s levels of abstraction of capital in general and competition, and capital as Hegelian Subject. The papers in this volume were originally presented at the 22nd annual meeting of the International Symposium on Marxian Theory at Mount Holyoke College in August 2011. The twelve authors are divided between seven economists and five philosophers, as is fitting for the interdisciplinary subject of the relation between Marx’s economic theory and Hegel’s logic. Contributors are: Chris Arthur, Riccardo Bellofiore, Roberto Fineschi, Gastón Caligaris, Igor Hanzel, Juan Iñigo Carrera, Mark Meaney, Fred Moseley, Patrick Murray, Geert Reuten, Mario Robles, Tony Smith, and Guido Starosta.",
    abstract_source = "openalex"
}

@misc{smith2014hegel,
    author = "Smith, Tony",
    title = "Hegel, Marx and the Comprehension of Capitalism",
    year = "2014",
    note = "CORE ARGUMENT: Smith argues that Hegel's Logic provides resources for comprehending capitalism, defending a systematic-dialectical approach to Marx's Capital. (Based on title and record.) RELEVANCE: Defence of the view that Marx's critique unfolds by internal categorial development, which bears on source-of-standards and role-of-contradiction. POSITION: Systematic dialectic.",
    keywords = "marx, hegel, systematic-dialectic, Medium, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "The main features of Marx's concept of capital can perhaps best be introduced by contrasting Marx's position with non-Marxian perspectives. There are texts where Marx argues for the primacy of the drive to expand monetary circuits by simply appealing to Hegel's logical point that the very concept of a quantitative limit implies the concept of quantities beyond those limits. Approaching the question from the Hegel side, one consideration that should make us pause before accepting the standard picture of Hegel accepted by Marx, Postone and so many others is the content of the culminating section of Hegel's Logic , the 'Absolute Idea'. Marx reveals the social ontology of generalised commodity-production to be more complex, and more bizarre, than anything found in Hegelian social theory. In the Logic , Hegel developed a methodological framework progressing from simple and abstract determinations to progressively more complex and concrete levels of analysis. Keywords: capitalism; generalised commodity-production; Hegelian social theory; Marx",
    abstract_source = "openalex"
}

@misc{caligaris2014which,
    author = "Caligaris, Gaston and Starosta, Guido",
    title = "Which 'Rational Kernel'? Which 'Mystical Shell'? A Contribution to the Debate on the Connection between Hegel's Logic and Marx's Capital",
    year = "2014",
    pages = "89--111",
    note = "CORE ARGUMENT: Caligaris and Starosta take part in the debate on the connection between Hegel's Logic and Marx's Capital, probing which parts of Hegel's dialectic Marx retained (rational kernel) and which he rejected (mystical shell). (Based on title; contents not read.) RELEVANCE: Bears on whether Marx's materialist critique transforms or merely reconstructs Hegelian immanent critique. POSITION: Critical of a straightforward Logic-to-Capital homology; historical-materialist inversion.",
    keywords = "marx, hegel, inversion, Medium, METADATA\\_CLEANED: booktitle, publisher, type:@incollection->@misc, METADATA\_CLEANED: doi",
    abstract = "The question about Hegel's legacy in the Marxian critique of political economy has been one of the most widely debated issues within the history of Marxist thought. This debate about the significance of the Logic for the critique of political economy can be reframed in terms of Marx's well-known explicit statement about the relationship between his dialectical method and Hegel's: the key issue at stake seems to be the establishment of the precise nature of the rational kernel within the mystical shell. This chapter attempts to contribute to the debate by providing an alternative perspective on the connection between Hegel's Logic and Marx's Capital . According to the argument put forward in his book The Logic of Marx's 'Capital' , Hegel's Logic deals with the fundamental categories of thought that are necessary to grasp the inner intelligibility of reality. Keywords: Hegel's Logic ; Marx's Capital ; mystical shell; rational kernel",
    abstract_source = "openalex"
}

@misc{postone1993time,
    author = "Postone, Moishe",
    title = "Time, Labor, and Social Domination",
    year = "1993",
    note = {CORE ARGUMENT: Postone reinterprets Marx's critical theory as a critique of the historically specific social forms of capitalism (value, abstract labour, abstract time), grounded in capitalism's own categories rather than from an external standpoint of labour. RELEVANCE: The paradigm of Marx as immanent critic: the object (capitalist social forms) generates both critique and the possibility of its transformation; standards are historically specific, not transhistorical, and contradiction is between the forms and their historical development. Challenges "traditional Marxism" and its labour-standpoint critique. POSITION: Categorial, historically specific immanent critique; anti-teleological about progress.},
    keywords = "marx, capital, immanent-critique, value-form, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Moishe Postone undertakes a fundamental reinterpretation of Karl Marx's mature critical theory. He calls into question many of the presuppositions of traditional Marxist analyses and offers new interpretations of Marx's central arguments. He does so by developing concepts aimed at grasping the essential character and historical development of modern society, and also at overcoming the familiar dichotomies of structure and action, meaning and material life. These concepts lead him to an original analysis of the nature and problems of capitalism and provide the basis for a critique of 'actually existing socialism'. According to this new interpretation, Marx identifies the core of the capitalist system with an impersonal form of social domination generated by labor and the industrial production process are characterized as expressions of domination generated by labor itself and not simply with market mechanisms and private property. Proletarian labor and the industrial production process are characterized as expressions of domination rather than as means of human emancipation. This reinterpretation entails the form of economic growth and the structure of social labor in modern society to the alienation and domination at the heart of capitalism. This reformulation, Postone argues, provides the foundation for a critical social theory that is more adequate to late twentieth-century capitalism.",
    abstract_source = "openalex"
}

