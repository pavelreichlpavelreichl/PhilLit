    keywords = "Fraser, Honneth, Hegel, recognition, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, number, pages, doi"
}

@misc{fraser2017behind,
    author = "Fraser, Nancy",
    title = "Behind Marx's Hidden Abode: For an Expanded Conception of Capitalism",
    year = "2017",
    note = "CORE ARGUMENT: Argues for an expanded conception of capitalism that includes its non-economic background conditions (social reproduction, nature, political power), whose contradictions generate crises (title and venue from CrossRef; abstract not retrieved). RELEVANCE: Fraser's relocation of immanent critique into the structural contradictions of capitalism, an alternative to Honneth's normative reconstruction; contradiction regains central role. POSITION: Fraser's critical theory of capitalist crisis (Marxian immanent contradictions).",
    keywords = "Fraser, capitalism, crisis, contradiction, Medium, METADATA\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc",
    abstract = "After decades in which the term ‘capitalism’ could scarcely be found outside the writings of Marxian thinkers, commentators of varying stripes now worry openly about its sustainability, scholars from every school scramble to systematize criticisms of it, and activists throughout the world mobilize in opposition to its practices. Nevertheless, the current boom in ‘capitalism’ talk remains largely rhetorical—more a symptom of the desire for systematic critique than a substantive contribution to it. Traditional Marxist conceptions of capitalism and its crisis are of no help here, since they fail systematically to incorporate the insights of feminism, postcolonialism and ecological thought. As a result, we lack conceptions of capitalism and capitalist crisis that are adequate to our time. In this chapter, Fraser suggests a way in which the Marxian conceptions of capitalism and capitalist crisis might be rethought in order to remedy this lacuna.",
    abstract_source = "openalex"
}

@misc{fraser2018capitalism,
    author = "Fraser, Nancy and Jaeggi, Rahel",
    title = "Capitalism: A Conversation in Critical Theory",
    year = "2018",
    note = "CORE ARGUMENT: Dialogue between Fraser and Jaeggi developing an expanded concept of capitalism as an institutionalised social order with crisis tendencies (S2 record; no publisher in tool output). RELEVANCE: Joint statement of a crisis-theoretic form of immanent critique that treats contradictions as sources of critical standards; contrast with Honneth's normative reconstruction. Cross-reference Domain 4 (Jaeggi). POSITION: Fraser/Jaeggi crisis critique of capitalism.",
    keywords = "Fraser, Jaeggi, capitalism, crisis, Medium, INCOMPLETE, no-abstract"
}

@misc{oKane2021critical,
    author = "O'Kane, Chris",
    title = "Critical Theory and the Critique of Capitalism: An Immanent Critique of {Nancy Fraser}'s ``Systematic'' Conception",
    year = "2021",
    note = "CORE ARGUMENT: Argues that Fraser's 'systematic' crisis-critique of capitalism as an 'institutionalized social order' is fragmentary and internally inconsistent: its Marxian premises are at odds with its Habermasian notions of capitalism, contradiction, crises and emancipation. RELEVANCE: Sceptical Marxian voice on the role of contradiction in Fraser's account; also a use of 'immanent critique' as a label for the method. POSITION: Marxian critique of Fraser's capitalism theory.",
    keywords = "Fraser, capitalism, Marx, immanent critique, Low, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The predominant approach to contemporary critical theory lacks a critical theory of capitalist society. Nancy Fraser has endeavored to provide such a critical theory in her “systematic” “crisis-critique” of capitalism as an “institutionalized social order.” Yet Fraser's “systematic” theory is not systematic, but fragmentary and internally inconsistent. The Marxian premises of Fraser's theory are at odds with its ensuing Habermasian notions of capitalism, contradiction, crises, and emancipation, and her theory consequently lacks a robust explication of these dynamics. This raises the alternative possibility of developing a contemporary critical theory of the crisis-ridden reproduction of the negative totality of capitalist society that brings Adorno and Horkheimer's critical theory together with the subterranean strand of contemporary critical theory: the New Reading of the critique of political economy as a critical social theory.",
    abstract_source = "s2"
}

@misc{stahl2013habermas,
    author = "Stahl, Titus",
    title = "Habermas and the Project of Immanent Critique",
    year = "2013",
    volume = "20",
    note = "CORE ARGUMENT: Stahl argues that, despite Habermas's own disclaimers, the discourse-theoretic reconstruction of the normative presuppositions of communication constitutes a novel and innovative form of immanent critique (PhilPapers summary). Standards come from reconstructed presuppositions of social practice rather than from an external moral theory. RELEVANCE: Connects the Habermasian reconstructive programme to Stahl's taxonomy; an anchor for the reconstructive (weak) pole of the strong/weak distinction and for the question whether Habermas's universalism is compatible with immanence. POSITION: Reconstructive immanent critique with a social-practice grounding (Habermas read as immanent critic).",
    keywords = "immanent-critique, Habermas, taxonomy, reconstructive, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {According to his own understanding, Jürgen Habermas' Theory of Communicative Action offers a new account of the normative foundations of critical theory. 1 Habermas' motivating insight is that neither a transcendental or metaphysical solution to the problem of normativity, nor a merely hermeneutic reconstruction of historically given norms, is sufficient to clarify the normative foundations of critical theory.In response to this insight, Habermas develops a novel account of normativity which locates the normative demands upon which critical theory draws within the socially instituted practice of communicative understanding.Although Habermas has claimed otherwise, this new foundation for critical theory constitutes a novel and innovative form of "immanent critique".To argue for and to clarify this claim, I offer, in section 1, a formal account of immanent critique and distinguish between two different ways of carrying out such a critique.In section 2, I examine Habermas' rejection of the first, hermeneutic option.Against this background, I then show, in section 3, that the Theory of Communicative Action attempts to formulate an immanent critique of contemporary societies according to a second, "practice-based" model.However, because Habermas, as I will argue in section 4, commits himself to an implausibly narrow view in regard to one central element of such a model -in regard to the social ontology of immanent normativity -his normative critique cannot develop its full potential (section 5). The Concept of Immanent CritiqueWhether a particular theoretical project should be described as "immanent critique" depends on the meaning of this term which, in spite of its importance, has rarely been clearly defined. Titus Stahl, "Habermas and the Project of Immanent Critique"Pre-review version -not suitable for citation.Hence, before turning to Habermas' model, I will clarify what I mean by "immanent critique," and the theoretical commitments I take such a project to entail.Critical theories -or at least, those varieties which locate themselves within the Frankfurt School tradition -generally derive some of their methodological commitments from Marx's early writings.Criticizing the Utopian tendencies of his time, Marx rejects all "dogmatic" forms of normative criticism, which postulate normative principles from a context-free, external vantage point. 2 However, criticizing Hegel, Marx also argues that social critique is not to be based on a reconstruction of "reason in history", but rather on an analysis of the material conditions of social reproduction.3 Thus, insofar as we can attribute any normative project to Marx, he must envisage a form of criticism that draws on norms which already exist in objective social reality.4 Many critical theorists have subsequently endorsed this broad strategy of justifying the normative standards of critique by reference to immanent potentials of social reality.In so doing, these theorists not only reject forms of moral constructivism and of moral realism that introduce norms from the "outside", but they also reject a merely "internal" application of those normative standards which are already accepted by their audience.5 However, any theory which attempts to draw on normative standards within objective social reality in this manner must solve three distinct problems: First, in order to justify a critical judgment by reference to immanent social standards, a theory must plausibly explain the sense in which such immanent standards "exist."Providing such an explanation requires a social ontology: a theoretical account that specifies the meaning of claims regarding the existence of particular social entities, and in this case, of socially immanent norms.Second, even given a justification for the assumption of immanent norms on the level of a social ontology, it is unclear what type of epistemic access social critics have to the relevant normative potentials immanent to social reality.Third and finally, it is an open question as to what kind of critical authority an immanent critique that draws upon them can aspire to.In summary, any model of immanent critique must clarify: the ontology of the immanent normative standards employed; its epistemology; and the consequences of its reliance upon those standards for its own critical capacity.Although these questions are seldom clearly distinguished, there have been numerous attempts to address the issues they raise.We can roughly divide these answers into two camps, which I will},
    abstract_source = "openalex"
}

@misc{stahl2013what,
    author = "Stahl, Titus",
    title = "What is Immanent Critique?",
    year = "2013",
    howpublished = "SSRN working paper",
    note = {CORE ARGUMENT: Distinguishes immanent critique, which reconstructs norms immanent in a social practice that point beyond its members' normative self-understanding, from both external critique and internal critique, and identifies three questions a theory of immanent critique must answer: a social-ontological, an epistemological and a justificatory one (PhilPapers summary). RELEVANCE: Provides the three-way taxonomy (external/internal/immanent) the domain's key question asks about, and the framework for assessing Jaeggi, Sabia and Honneth; also the source of the "source of standards" analysis (norms implicit in practices, not accepted explicitly). POSITION: Social-practice (Brandom/rule-following-inflected) account of immanent critique with a reconstructive-but-transcending standard.},
    keywords = "immanent-critique, taxonomy, internal-critique, external-critique, social-ontology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@misc{stahl2013immanente,
    author = "Stahl, Titus",
    title = "Immanente Kritik: Elemente einer Theorie sozialer Praktiken",
    year = "2013",
    note = "CORE ARGUMENT: Monograph asking whether there is a form of critique that neither applies empirically accepted standards nor independently justified norms but reconstructs norms immanent to social practices. It surveys Walzer, Taylor, MacIntyre, Habermas and Honneth, builds on social ontology and the rule-following discussion, and argues that immanent rules exist where participants recognize one another as members of rule-governed practices by attributing defeasible normative authority; it also treats second-order critique of reification (PhilPapers description). RELEVANCE: The fullest statement of the practice-theoretic account; defines the immanent/internal/external taxonomy and the role of (non-)conservative reconstruction. No venue or abstract data from CrossRef/S2. POSITION: Reconstructive immanent critique grounded in social ontology of practices.",
    keywords = "immanent-critique, social-practices, rule-following, taxonomy, High, INCOMPLETE, no-abstract"
}

@misc{stahl2017particular,
    author = "Stahl, Titus",
    title = "Immanent Critique and Particular Moral Experience",
    year = "2017",
    note = "CORE ARGUMENT: Critical theories are often sceptical of grounding critique in general normative principles; Stahl argues immanent critique can instead draw on particular moral experience embedded in practices (PhilPapers summary). RELEVANCE: Bears on the source-of-standards question (experience vs. principle) and on how immanent critique avoids both abstract moralism and conservatism. POSITION: Practice-based immanent critique with a particularist epistemology.",
    keywords = "immanent-critique, moral-experience, Stahl, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Critical theories often express scepticism towards the idea that social critique should draw on general normative principles, seeing such principles as bound to dominant conceptual frameworks. However, even the models of immanent critique developed in the Frankfurt School tradition seem to privilege principles over particular moral experiences. Discussing the place that particular moral experience has in the models of Honneth, Ferrara and Adorno, the article argues that experience can play an important negative role even for a critical theory that is committed to the necessity of conceptual mediation, as moral experiences can undermine our confidence in the appropriateness of our moral concepts. Building on McDowell’s account of moral perception and Brandom’s interpretation of Hegel’s theory of experience, one can reconstruct Adorno as providing a “radically negativist” approach to immanent critique that takes particular moral experience seriously.",
    abstract_source = "openalex"
}

@misc{stahl2024oppressive,
    author = "Stahl, Titus",
    title = "Oppressive Forms of Life",
    year = "2024",
    pages = "77--93",
    note = {CORE ARGUMENT: Extends Jaeggi's model of immanent critique of forms of life by considering oppressive forms of life, in which subordinated groups are excluded from the interpretive processes that determine the practice's values. This challenges immanent critique, since immanent norms are partly constituted by interpretations that oppression may distort; Stahl argues Jaeggi's model can be defended or adapted. RELEVANCE: Directly addresses the "which norms?"/distorted-norms problem and Jaeggi's crisis model's sufficiency; a bridge to Domain 5. POSITION: Friendly amendment of Jaeggi's transformative model; practice-theoretic.},
    keywords = "immanent-critique, forms-of-life, oppression, Jaeggi, conservatism, High, METADATA\_CLEANED: journal, volume, number, doi, type:@article->@misc",
    abstract = "ABSTRACT Rahel Jaeggi argues that forms of life ought to be the main reference point for a critical theory of society because the internal normative structure of life forms allows for immanent critique. In this article, I extend her model by systematically considering the possibility of oppressive forms of life. Oppressive forms of life are clusters of practices in which subordinated groups are systematically excluded or disabled from participating in the social processes of interpretation through which the values and purposes of those very practices are determined. The possibility of oppressive forms of life poses a challenge to the method of immanent critique because it seems that any such critique must rely on immanent norms that are at least partly constituted by interpretations and that can therefore be distorted by oppression. I argue that Jaeggi’s model of immanent critique can be extended to respond to that challenge, either by recovering a constitutive form of freedom within all forms of life or by consciously adopting a partisan stance in favour of oppressed and marginalised self-understandings.",
    abstract_source = "s2"
}

@misc{jaeggi2018critique,
    author = "Jaeggi, Rahel",
    title = "Critique of Forms of Life",
    year = "2018",
    note = {CORE ARGUMENT: Rejects liberal "ethical abstinence" and develops an immanent critique of forms of life, conceived as ensembles of practices that function as problem-solving instances. Standards arise from the failures (crises, including second-order problems) of such ensembles, and transformations that resolve them count as learning processes (NDPR review of the book: a "dialectical pragmatism" inspired by Hegel, with Dewey and MacIntyre). Standards: immanent, neither external moral norms nor merely accepted internal ones. RELEVANCE: Central transformative model for the domain; supplies the crisis/problem-solving account of contradiction and a progress-oriented criterion. Contrasted with Adorno's negativism and Stahl's reconstructive account. POSITION: Transformative (strong) immanent critique, Hegelian pragmatist, with a formal theory of progress as learning.},
    keywords = "Jaeggi, forms-of-life, problem-solving, crisis, progress, transformative, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "For liberals, the question “Do others live rightly?” seems to demand a follow-up question: “Who am I to judge?” Peaceful coexistence, in this view, is predicated on restraint from morally evaluating our peers. But Rahel Jaeggi argues that criticizing is not only valid but also useful. Moral judgment is no error—the error lies in how we go about it.",
    abstract_source = "openalex"
}

@misc{jaeggi2009rethinking,
    author = "Jaeggi, Rahel",
    title = "Rethinking Ideology",
    year = "2009",
    note = "CORE ARGUMENT: Reworks the concept of ideology, linking ideology critique to immanent critique of social practices instead of to a theory of false consciousness. (Only title and bibliographic data verified; no abstract available from the APIs.) RELEVANCE: Source for Jaeggi's treatment of ideology critique as immanent critique and for relations between contradiction and ideology; to be read with the Celikates 2006 and Ng 2015 pieces. POSITION: Ideology critique as immanent critique (Hegelian-Marxian, non-epistemic).",
    keywords = "Jaeggi, ideology-critique, immanent-critique, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "In this chapter, I try to make a case for the revitalization of the critique of ideology as a form of social critique. Although this concept cannot be solely attributed to Marxism, it did reach a certain “maturity” 1 in Marx’s writings, and it has been embraced by the various traditions of “Western Marxism” up until contemporary Critical Theory. Today, the conjectural tide has turned against it. Does this mean, however, that there are no more ideologies — or merely that there is no more ideology critique? I build my case for a reconstruction of the critique of ideology on the following diagnosis: One, I believe that there still are certain social circumstances, certain forms of social domination that require a critique of ideology. Two, to regain and develop the concept of ideology critique, we must not only reopen the question of how exactly a critique of ideology works — even at the peak of its popularity, this was frequently anything but clear, as is often the case with popular theorems — but also critically reconstruct some of its basic assumptions. It is, then, a matter of both bringing the critique of ideology into the present and of finding a new understanding of it. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

@misc{jaeggi2018lebensformen,
    author = "Jaeggi, Rahel",
    title = "Lebensformen als Problemlösungsinstanzen",
    year = "2018",
    note = "CORE ARGUMENT: Presents the problem-solving conception of forms of life that underlies Kritik von Lebensformen: forms of life are evaluated by how they respond to the problems they face. (Title-level information only; no abstract available.) RELEVANCE: German-language statement of the crisis/problem-solving model; useful for the key question of whether the model is sufficiently immanent. POSITION: Transformative immanent critique via problem-solving.",
    keywords = "Jaeggi, problem-solving, forms-of-life, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{celikates2018critique,
    author = "Celikates, Robin",
    title = "Critique as Social Practice",
    year = "2018",
    note = "CORE ARGUMENT: Asks whether critical theory can diagnose ideology from above or must follow the critical practices of ordinary agents, and argues for moving beyond this dichotomy: ordinary agents engage in complex everyday critique, but critical theory must still analyze conditions that obstruct reflexive capacities. The approach must be non-paternalistic, pragmatist and dialogical as well as critical. RELEVANCE: Supplies the alternative to a theorist-reconstructed standard: standards and critical capacities lie in agents' reflexive practices; engages the sociology of critique (Boltanski) and relates to immanent critique as a form of social self-understanding. POSITION: Reflexive-pragmatist critical theory; mid-position between reconstruction and external ideology critique.",
    keywords = "Celikates, critique-as-practice, ideology-critique, pragmatism, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Can critical theory diagnose ideological delusion and false consciousness from above, or does it have to follow the practices of critique ordinary agents engage in? This book argues that we have to move beyond this dichotomy, which has led to a theoretical impasse. Whilst ordinary agents engage in complex forms of everyday critique, it must remain the task of critical theory to provide analysis and critique of social conditions that obstruct the development of reflexive capacities and of their realization in corresponding practices of critique. Only an approach that is at the same time non-paternalistic, pragmatist, and dialogical as well as critical will be able to realize the emancipatory potential of the Frankfurt School tradition of critical theory in radically changing social circumstances. abstract\_source = {s2}, The translation of this work was funded by Geisteswissenschaften International – Translation Funding for Humanities and Social Sciences from Germany, a joint initiative of the Fritz Thyssen Foundation, the German Federal Foreign Office, the collecting society VG WORT and the Börsenverein des Deutschen Buchhandels (German Publisher \& Booksellers Association)"
}

@misc{celikates2006from,
    author = "Celikates, Robin",
    title = "From Critical Social Theory to a Social Theory of Critique: On the Critique of Ideology after the Pragmatic Turn",
    year = "2006",
    note = "CORE ARGUMENT: Title indicates a shift from critical social theory to a social theory of critique, reconstructing ideology critique after the pragmatic turn (no abstract available). It anticipates Celikates's later view that actors' own critical practices are the basis of theory. RELEVANCE: Early version of the Celikates programme that frames the source-of-standards problem in sociological-pragmatist terms; connects to Boltanski. POSITION: Reflexive-pragmatist reconstruction of ideology critique.",
    keywords = "Celikates, ideology-critique, pragmatic-turn, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{celikates2012naoreconhecimento,
    author = "Celikates, Robin and Mattos, Fernando Costa",
    title = "O não reconhecimento sistemático e a prática da crítica: Bourdieu, Boltanski e o papel da teoria crítica",
    year = "2012",
    note = {CORE ARGUMENT: Argues that Boltanski's "pragmatic turn" should not lead to abandoning critical theory: the reflective capacities and justificatory practices of ordinary actors reconstructed by the sociology of critique form the social and methodological basis of critical theory, but this should not grant participants' perspective epistemic authority immune to theoretically informed questioning. RELEVANCE: Clear statement of Celikates's position between Bourdieu (critical sociology from above) and Boltanski (deference to actors); source of the "critical theory without a hegemonic observer" idea. POSITION: Non-deferential pragmatist critique.},
    keywords = "Celikates, Boltanski, Bourdieu, sociology-of-critique, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {The "pragmatic turn'" proposed by Boltanski and others should not lead us to abandon the project of Critical Theory, as if all necessary criticism were already articulated within everyday practices of critique. The reflective capacities of "ordinary" actors and their practices of justification and critique, which are convincingly reconstructed by the sociology of critique, constitute the social and methodological basis of critical theory. However, this should not lead us to attribute an epistemic authority to the perspective of the participants that is immune to being put into question from a theoretically informed point of view.},
    abstract_source = "s2"
}

@misc{boltanski2014spirit,
    author = "Boltanski, Luc and Honneth, Axel and Celikates, Robin",
    title = "The Spirit of Luc Boltanski: Sociology of Critique or Critical Theory? Luc Boltanski and Axel Honneth in Conversation with Robin Celikates",
    year = "2014",
    note = {CORE ARGUMENT: A conversation between Boltanski and Honneth, moderated by Celikates, on the relation between the pragmatic sociology of critique and Frankfurt-style critical theory. (Title-level information only; no abstract or venue data verified from the APIs.) RELEVANCE: Brings the Boltanski branch of "sociology of critique" into direct contact with reconstructive (Honneth) and practice-based (Celikates) accounts of the source of critical standards. POSITION: Dialogue between pragmatic sociology of critique and critical theory.},
    keywords = "Boltanski, Honneth, Celikates, sociology-of-critique, Medium, INCOMPLETE, no-abstract"
}

@misc{boltanski2006justification,
    author = "Boltanski, Luc and Thévenot, Laurent",
    title = "On Justification",
    year = "2006",
    note = "CORE ARGUMENT: Analyses how actors justify claims and criticize one another by appeal to plural orders of worth (cities); critique operates through shared principles of equivalence available to participants (known from the work itself; verification limited to bibliographic data). RELEVANCE: The sociological counterpart to internal critique: standards are the plural justifications operative in practice, used by Celikates and others as a foil for immanent critique and critical theory. POSITION: Pragmatic sociology of justification/critique.",
    keywords = "Boltanski, Thevenot, justification, sociology-of-critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{sabia2010defending,
    author = "Sabia, Dan",
    title = "Defending Immanent Critique",
    year = "2010",
    note = "CORE ARGUMENT: Defends the view that meaningful and potentially efficacious criticism must be connected to criteria and understandings internal to the criticized practice; answers objections (PhilPapers summary). RELEVANCE: Standard reference for the defence against conservatism and for distinguishing internal from external criticism; a baseline for Stahl and Jaeggi. POSITION: Defence of immanent/internal critique against conservatism objection.",
    keywords = "Sabia, immanent-critique, conservatism, defence, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This article develops, illustrates, and defends a conception of immanent critique. Immanent critique is construed as a form of hermeneutical practice and second-order political and normative criticism. The common charge that immanent critique is a form of philosophical conventionalism necessarily committed to value relativism and to the rejection of transcultural and cosmopolitan norms is denied. But immanent critique insists that meaningful and potentially efficacious criticism must be connected to relevant criteria and understandings internal to the culture or social order at which the criticism is directed. The complaint that this demand will likely limit political and moral criticism is also denied, and the ability of immanent critique to develop from convention unconventional thinking is defended and demonstrated.",
    abstract_source = "openalex"
}

@misc{ng2015ideology,
    author = "Ng, Karen",
    title = "Ideology Critique from Hegel and Marx to Critical Theory",
    year = "2015",
    volume = "22",
    note = "CORE ARGUMENT: Title indicates a reconstruction of ideology critique from Hegel and Marx to critical theory (no abstract available from the APIs). RELEVANCE: Connects ideology critique with immanent critique and contradiction in the Hegelian-Marxian line; used as a bridge from Domain 1 to the contemporary theories. POSITION: Hegelian-Marxian ideology critique as immanent critique.",
    keywords = "Ng, ideology-critique, Hegel, Marx, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{procyshyn2019conditions,
    author = "Procyshyn, Alexei",
    title = "The Conditions of Immanent Critique",
    year = "2019",
    note = "CORE ARGUMENT: Compares immanent critique with other argumentative strategies and extracts three requirements: inherence, contradiction, access. These imply a heuristic and ampliative character, and that immanent critique is not a method in any strict sense since the requirements are multiply interpretable. RELEVANCE: Directly addresses the role of contradiction and the stability of the immanent/internal/external boundary. POSITION: Deflationary, taxonomic account of immanent critique.",
    keywords = "immanent-critique, taxonomy, contradiction, method, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT This article contributes to methodological debates in contemporary critical theory regarding the scope and features of immanent critique. I spell out the philosophical commitments presupposed by this approach to criticism and identify its basic features by comparing it with more recognizable argumentative or interpretative strategies. This comparison yields three immanent-critical requirements – for inherence, contradiction, and access – which bring into relief the heuristic and ampliative character of immanent criticism. Yet, these requirements also imply that “immanent critique” is not a method in any strict sense, since they are multiply interpretable and hence generative of distinctive critical comportments.",
    abstract_source = "s2"
}

@article{becker2018immanent,
    author = "Becker, Michael A.",
    title = "On Immanent Critique in Hegel's {Phenomenology}",
    journal = "Hegel Bulletin",
    year = "2018",
    volume = "41",
    note = {CORE ARGUMENT: Identifies an ambiguity in post-Hegelian literature: immanent critique as (a) judging an object by its internal norms, or (b) accounting for one's own standpoint with reference to the object. Both appear in the Phenomenology, yielding revisionist readings of the "internal criteria" and "self-examination" tropes. RELEVANCE: Offers a Hegel-exegetical taxonomy that cuts across Stahl's internal/immanent distinction and feeds the history-to-contemporary link. POSITION: Hegel-scholarly clarification of the two senses of immanent critique.},
    keywords = "immanent-critique, Hegel, Phenomenology, taxonomy, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "Abstract I begin by identifying an ambiguity in the post-Hegelian literature on Immanent Critique, distinguishing two possible definitions: (a) judging an object against its ‘internal’ norms; and (b) accounting for one’s own standpoint with reference to the object. I then claim that both definitions are represented in Hegel’s Phenomenology, and develop extended interpretations of material from the Introduction in order to clarify and substantiate this thesis. This yields revisionist readings of the famous ‘internal criteria’ and ‘self examination’ tropes. My discussion builds towards elucidating the relation between the two definitions of Immanent Critique I have distinguished, as it is developed in the Phenomenology.",
    abstract_source = "s2"
}

@misc{sarkela2017immanent,
    author = "Särkelä, Arvi",
    title = "Immanent Critique as Self-Transformative Practice: Hegel, Dewey, and Contemporary Critical Theory",
    year = "2017",
    volume = "31",
    note = {CORE ARGUMENT: Distinguishes two traditions: one (Frankfurt) treats immanence as a quality of the standard, requiring a "model of immanent critique" showing the standard is immanent in the object; the other (Hegel's Phenomenology, Dewey) treats immanence as the form of critical practice itself (PhilPapers abstract). RELEVANCE: Offers an alternative to Stahl/Jaeggi on the source of standards and ties immanent critique to self-transformation of practices. POSITION: Pragmatist (Hegel-Dewey) self-transformative immanent critique.},
    keywords = "immanent-critique, Hegel, Dewey, pragmatism, self-transformation, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT There are two traditions of immanent social critique. One of them, prominent in contemporary Frankfurt school critical theory, regards the immanence of critique as a quality of the standard employed. Such a conception of immanent critique needs to show, prior to the concrete practice of critique, how the standard is immanent in the object of critique. Showing this is the task of a “model of immanent critique.” The other tradition, going back to Hegel's Phenomenology of Spirit and practiced in particular by Dewey in his later works, regards the immanence of critique as the form of critical practice itself. Because such a conception of immanent critique does not, at the outset, ask how the standard is immanent to its object, it also does not need a model licensing critical practice. Indeed, it must be inherently hostile to any attempt at modeling immanent critique because the immanence lies in the power of critical practice to transform any models it applies.",
    abstract_source = "openalex"
}

@misc{finlayson2014hegel,
    author = "Finlayson, James Gordon",
    title = "Hegel, Adorno and the Origins of Immanent Criticism",
    year = "2014",
    volume = "22",
    note = {CORE ARGUMENT: Criticizes the "Continuity Thesis" (Hegel invented immanent criticism, Marx developed it, the Frankfurt School refined it): examines whether Hegel originates immanent criticism, whether his dialectic is immanent criticism, and whether Adorno practises and endorses it as a description of his own practice. RELEVANCE: Sceptical genealogical voice undermining the neat continuity from Hegel to Adorno to contemporary theories; key for the "overview from Hegel to today". POSITION: Sceptical/revisionist historical account.},
    keywords = "immanent-critique, Hegel, Adorno, genealogy, sceptical, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "‘Immanent criticism' has been discussed by philosophers of quite different persuasions, working in separate areas and in different traditions of philosophy. Almost all of them agree on roughly the same story about its origins: It is that Hegel invented immanent criticism, that Marx later developed it, and that the various members of the Frankfurt School, particularly Adorno, refined it in various ways, and that they are all paradigmatic practitioners of immanent criticism. I call this the Continuity Thesis. There are four different claims that interest me. (i) Hegel is the originator of immanent criticism. (ii) Hegel's dialectical method is that of immanent criticism. (iii) Adorno practises immanent criticism and endorses the term as a description of his practice. (iv) Adorno's dialectical method is fundamentally Hegelian. In this article, I offer an account of immanent criticism, on the basis of which, I evaluate these four claims and argue that the Continuity Thesis should be rejected.",
    abstract_source = "s2"
}

@misc{buchwalter1991hegel,
    author = "Buchwalter, Andrew",
    title = "Hegel, Marx, and the Concept of Immanent Critique",
    year = "1991",
    volume = "29",
    note = "CORE ARGUMENT: Treats immanent critique as a concept linking Hegel and Marx (title-level information; no abstract available from the APIs). RELEVANCE: Older historical account of immanent critique from Hegel to Marx, cited by contemporary accounts; complements Buchwalter 2016 in Domain 3. POSITION: Hegelian-Marxian continuity reading.",
    keywords = "immanent-critique, Hegel, Marx, history, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {Hegel, Marx, and the Concept of Immanent Critique ANDREW BUCHWALTER WITH OTHERS, MARXcriticizes Hegel's Philosophyof Right for its apologetic stance regarding the status quo. For Marx as well, Hegel's political thought dogmatically assigns rationality to existing social and political reality. Unlike many critics, however, Marx does not consider Hegel's so-called attitude of accommodation to be simply a moral failing or an expression of political cowardice.' He does not follow Arnold Ruge in accusing Hegel of betraying essentially critical principles in order to curry favor with state authorities.2 In Marx's view, Hegel's conservatism is rooted in the innermost structure of his thought.3 Because the PhilosophyofRightis conceived as part of a metaphysical system based on the identity of reason and reality, it necessarily sanctifies existing political arrangements. "There can no longer be any question about an act of accommodation on Hegel's part vis-a-vis.., the state, etc., since this lie is the lie of his principle."4 Marx was not alone in arguing that the purported conservatism of Hegelian politics is rooted in a speculative identity philosophy. In his t857 Hegel undseineZeit,Rudolph Haym marshalled similar arguments to criticize a political philosophy that, for him, represented the "scientific lodging of the spirit of As he writes in his 1841 doctoral dissertation: "it is mere ignorance on the part of his [Hegel's] pupils, when they explain one or the other determination of his system by his desire for accommodation and the like, hence, in one word, explain it in terms of morality" (The Marx-Engels Reader, ed. Richard Tucker, 2d ed. [New York: Norton, t978], 9). ' Arnold Ruge, "Hegel's 'Philosophy of Right' and the Politics of Our Times," in Lawrence S. Stepelevich, ed., The Young Hegelians: An Anthology (Cambridge: Cambridge University Press, t983), 211-36. s See Karl-Heinz Ilting, "Hegel's Concept of the State and Marx's Early Critique," in Z. A. Pelczynski, ed., The State and Civil Society(Cambridge: Cambridge University Press, 1984), 93- l 134 The Marx-Engels Reader, 118f. As he writes in his dissertation: Hegel's "apparent accommodation has its deepest roots in an inadequacy of or in an inadequate formulation of his principle itself" (Marx-Engels Werke 2,\textasciitilde\ [Berlin: Dietz, 198o], 64). [253] 254 JOURNAL OF THE HISTORY OF PHILOSOPHY 29:2 APRIL t99I the Prussian restoration."s For Haym as well, Hegel's speculative equation of reason and reality was "the absolute formula of political conservatism.''6 Unlike Haym, however, Marx does not finger the conjunction of reason and reality as itself the source of Hegelian dogmatism. The conservatism entailed by Hegel's identity philosophy does not derive from a failure to distinguish between what is and what rationally ought to be, between fact and value.7 Far from criticizing Hegel on this score, Marx actually appropriates Hegel's principle of the homogeneity of reason and reality when formulating his own account of normative theory,s For Marx, Hegel's conjunction of thought and being furnished the methodological parameters for a concept of social criticism which avoids the dichotomy of descriptive and prescriptive analysis. Marx calls this immanent critique. Unlike the utopian forms of criticism identifiable with anarchists, Young Hegelians, Kantians, and naturallaw theorists, immanent critique evaluates reality not with alien principles of rationality but with those intrinsic to reality itself. An immanent approach to social criticism exposes the way reality conflicts not with some "transcendent" concept of rationality but with its own avowed norms. In Hegelian speculation Marx found the rudiments of an objective or "scientific" approach to critical theory, one in which reality is challenged not with arbitrary constructions but with norms whose acknowledged validity is part and parcel of reality itself.9 What Marx did find objectionable in Hegel's principle of the unity of reason and reality was not the principle itself but its dogmatic formulation. Invoking Feuerbach's claim that Hegel inverts subject and predicate, Marx argues that Hegel subordinates the conjunction of reason and reality to the requirements of a metaphysical system which twists what is critical into a philosophical benediction of existing social-political conditions. Hegel does not focus on the disparity between reality and its...},
    abstract_source = "openalex"
}

@misc{fraser2023limits,
    author = "Fraser, Rachel",
    title = "{IV}---The Limits of Immanent Critique",
    year = "2023",
    note = "CORE ARGUMENT: Argues that prospects for immanent criticism, which promises criticism of the social order without external normative standards, are bleak: it must commit to an implausible social ontology, a flawed meta-normative theory, or both. RELEVANCE: Analytic sceptical challenge to Stahl/Jaeggi-style accounts; foil for the justification problem in Domain 5. POSITION: Sceptical: immanence cannot ground normative authority.",
    keywords = "immanent-critique, scepticism, social-ontology, metanormativity, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract The tradition of immanent critique promises a lot. It promises to be critical of the existing social order without appealing to ‘external’ normative standards. I argue that the prospects for immanent criticism are bleak: they must either commit to an implausible social ontology, a flawed meta-normative theory, or both.",
    abstract_source = "openalex"
}

@misc{vonsamson2025immanent,
    author = "von Samson, Livia",
    title = "Is Immanent Critique Possible?",
    year = "2025",
    volume = "33",
    note = {CORE ARGUMENT: Argues that recent literature collapses a metanormative and a social-ontological question, assuming a standard acquires normative authority for participants by being embedded in their practice (the "collapse assumption"). Rejects this and holds that immanent critique's specificity is to clarify immanent contradictions (PhilPapers snippets). RELEVANCE: Responds to the normative-authority objection by redefining the role of contradiction; recent contribution to the debate with Fraser. POSITION: Revisionary defence centring contradiction over embedded norms.},
    keywords = "immanent-critique, contradiction, metanormativity, recent, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Our social world is governed by norms. But do we have reason to follow them? On the one hand, critical theorists deny this: just because gendered norms tell women to cook and racialized people to serve does not mean that they should. On the other, critical theory relies on immanent critique. Recent literature on what it means for social critique to be immanent collapses the answers to a metanormative and a social ontological question. I call this the ‘collapse assumption’: a putative normative standard acquires normative authority for those engaged in a social practice via being suitably embedded in that practice. However, on this understanding, critical theorists face a dilemma: Either they grant normative authority to de facto governing norms, which renders social critique structurally conservative. Or they deny it, in which case immanent critique loses its normative bite. This paper argues that this understanding of immanent critique is confused and offers a different understanding according to which this dilemma does not arise. Immanent critique must not rely on the collapse assumption to meet the immanence constraint. Rather, the specificity of the method is that it clarifies immanent contradictions. Individual reasons thus become secondary to social theory.",
    abstract_source = "openalex"
}

@misc{solinas2019political,
    author = "Solinas, Marco",
    title = "The Political Deficit of Immanent Critique. On Jaeggi's Objections to Walzer's Criticism",
    year = "2019",
    volume = "22",
    note = {CORE ARGUMENT: Shows Jaeggi's objections to Walzer's model of internal critique are in many respects inconsistent and indicate a "political deficit" in the neo-Hegelian methodology she adopts; the same deficit affects her use of Marx's critique of ideology, which Walzer's reading of Gramsci's hegemony could rework. RELEVANCE: Tests Jaeggi's distinction between her immanent critique and internal critique à la Walzer, and whether her crisis model is sufficiently political. POSITION: Critical of Jaeggi; defends Walzer-style internal critique.},
    keywords = "Jaeggi, Walzer, internal-critique, politics, sceptical, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT The paper aims to show that Rahel Jaeggi's objections to Walzer's model of internal critique are in many respects inconsistent, and above all that these objections are a sign of a political deficit in the neo-Hegelian methodology adopted by Jaeggi to develop her model of immanent critique. The same deficit concerns Jaeggi's use of Marx's model of the critique of ideology, which can be fruitfully reworked by Walzer's reinterpretation of Gramsci's theory of the struggle for hegemony.",
    abstract_source = "s2"
}

