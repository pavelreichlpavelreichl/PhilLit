}

@misc{rossi2017stanley,
    author = "Rossi, Enzo",
    title = "Stanley on ideology, or how to de-moralise democracy",
    year = "2017",
    note = "CORE ARGUMENT: Argues that Stanley's non-moral argument for equality (inequality causes ideologically flawed belief which makes propaganda more effective) is promising but weakened by its reliance on a heavily moralised conception of democracy, and suggests embracing a more realistic conception of democracy. RELEVANCE: Sceptical, realist voice on whether ideology critique needs external moral standards; links to Rossi 2024, Sleat 2024 and Clark 2024 in Domain 5. POSITION: Political-realist critique of moralised ideology critique.",
    keywords = "ideology, political-realism, Rossi, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In *How Propaganda Works* Jason Stanley argues that democratic societies require substantial material equality because inequality causes ideologically flawed belief, which, in turn, make demagogic propaganda more effective. And that is problematic for the quality of democracy. In this brief paper I unpack that argument, in order to make two points: (a) the non-moral argument for equality is promising, but weakened by its reliance on a heavily moralised conception of democracy; (b) that problem may be remedied by whole-heartedly embracing a more realistic conception of democracy. That conception is at least compatible with Stanley’s argument, if not implicit in parts of it.",
    abstract_source = "openalex"
}

