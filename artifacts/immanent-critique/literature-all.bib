@misc{cozzaglio2020political,
    author = "Cozzaglio, Ilaria",
    title = "Political realism, legitimacy, and a place for external critique",
    year = "2020",
    volume = "47",
    note = {CORE ARGUMENT: Realists build "internal" legitimacy theories whose normativity comes from within the political context under evaluation (reconnecting legitimacy to subjects' beliefs) rather than from pre-political moral standards. Cozzaglio argues that such internalism still needs room for external critique. RELEVANCE: Realist version of the immanent/external dilemma. Standards come from the context's own legitimating beliefs; the paper asks whether purely internal standards can criticize a context whose beliefs are themselves defective. Bears on the norm-selection problem. Treats internal standards as primary, with external critique as a supplement. POSITION: Political realism; internalist legitimacy with a defended role for external critique.},
    keywords = "political-realism, legitimacy, internal-external-critique, norm-selection, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Political realists claim that politics should be regulated by a distinctive political normativity, one that does not rely on external, pre-political moral standards. It is in this sense that they distinguish political realism from ‘political moralism’, regarded as an approach that understands political theory as applied ethics. Importantly, realists’ anti-moralism is not motivated by the conviction that moral considerations do not play any role in the political realm. Rather, the target is the externalism of the normative resources on which moralist theories typically ground their conceptions of legitimacy. In contrast to moralists, some realists have argued for the need to elaborate internal theories of legitimacy, ones that develop normativity internally – that is, from within the political context under evaluation. This commitment entails the effort to reconnect legitimacy to the beliefs and attitudes of people subjected to the political power. In these accounts of legitimacy, critique is typically exercised internally, by means of self-reflection and ideology critique. Contra some realists, I argue that some forms of externalism are desirable and compatible with internalist accounts of legitimacy, and I show how to accommodate them within internalist theories of legitimacy. They are desirable because they strengthen the emancipatory potential of internal reflection and, in some cases, even stimulate it, as when, because of political circumstances, internal critique cannot be exercised. In addition, they prevent internalist approaches from falling into descriptive accounts of de facto acceptance of power. These forms of external critique can be compatible with internalist accounts of legitimacy, provided that they do not contrast with what I call methodological and substantive internalism. Accordingly, in the article, I discuss which stances of external critique can and should be accommodated within internalist accounts of legitimacy, without renouncing to the realist character of the approach.",
    abstract_source = "s2"
}

@misc{aytac2022ideology,
    author = "Aytac, Ugur and Rossi, Enzo",
    title = "Ideology Critique without Morality: A Radical Realist Approach",
    year = "2022",
    note = {CORE ARGUMENT: Against Anglo-American views on which ideology critique is moral critique, the authors argue that ideology critique should be genealogical and empirical: it debunks beliefs and practices by showing they are produced by self-justifying power, itself understood as an epistemic rather than moral flaw. RELEVANCE: Source of standards: epistemic, not moral, standards drawn from the critique's own target (beliefs produced by power). This answers the "smuggled moral standards" objection by dropping morality, but invites the objection (Sleat 2024; Clark 2024) that critical edge is lost. Role of contradiction is minimal; the mode is debunking-genealogical, not reconstructive. Progress is not a theme. POSITION: Radical realism; nonmoralized, genealogical ideology critique.},
    keywords = "political-realism, ideology-critique, genealogy, nonmoralized-critique, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "What is the point of ideology critique? Prominent Anglo-American philosophers recently proposed novel arguments for the view that ideology critique is moral critique, and ideologies are flawed insofar as they contribute to injustice or oppression. We criticize that view and make the case for an alternative and more empirically oriented approach, grounded in epistemic rather than moral commitments. We make two related claims: (a) ideology critique can debunk beliefs and practices by uncovering how, empirically, they are produced by self-justifying power and (b) the self-justification of power should be understood as an epistemic rather than moral flaw. Drawing on the recent realist revival in political theory, we argue that this genealogical approach has more radical potential, despite being more parsimonious than morality-based approaches. We demonstrate the relative advantages of our view by discussing the results of empirical studies on the contemporary phenomenon of neopatriarchy in the Middle East and North Africa.",
    abstract_source = "s2"
}

@misc{sleat2024against,
    author = "Sleat, Matt",
    title = "Against Realist Ideology Critique",
    year = "2024",
    volume = "41",
    note = "CORE ARGUMENT: Presents a two-part critique of realist ideology critique, which tries to ground political judgment in nonmoral values: first an internal critique of the approach's own commitments, then the argument that doing ideology critique without morality is misguided. RELEVANCE: The sceptical response to Aytac and Rossi. The paper uses internal critique as a method against a rival position and claims that normative moral standards are indispensable to critique, which supports the covert-externalism worry. Standards are moral and not purely context-derived. No treatment of contradiction or progress in the abstract. POSITION: Moralized (liberal-realist) critic of nonmoralized ideology critique.",
    keywords = "political-realism, ideology-critique, morality, external-standards, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Is it possible to do ideology critique without morality? In recent years a small group of theorists has attempted to develop such an account and, in doing so, makes claim to a certain sort of “radical realism” distinguished by the ambition to ground political judgments and prescriptions in nonmoral values, principles, or concepts. This essay presents a twofold critique of this realist ideology critique (RIC) by first offering an internal critique of the approach and then arguing that the very attempt to do political theory generally—and ideology critique more specifically—in a way that abjures morality is misguided. In doing so, I contribute both to current debates around “new” ideology critiques and to contested questions about what it means to do political theory realistically.",
    abstract_source = "s2"
}

@misc{rossi2024critical,
    author = "Rossi, Enzo",
    title = "Critical Responsiveness: How Epistemic Ideology Critique Can Make Normative Legitimacy Empirical",
    year = "2024",
    volume = "41",
    note = "CORE ARGUMENT: Proposes an empirically grounded account of normative legitimacy: a power structure's responsiveness to the values of the ruled gives normative purchase only once those preferences are filtered through nonmoralized epistemic ideology critique, grounded in an empirical account of how belief in legitimacy is formed. RELEVANCE: Supplies a concrete answer to the norm-selection problem: distorted preferences are filtered out by an empirical-epistemic test applied to the very beliefs on which legitimacy rests. Standards remain internal (the ruled's values) but are corrected. Reconstructive in orientation; no explicit account of contradiction or progress. POSITION: Realist, empirically grounded ideology critique.",
    keywords = "political-realism, legitimacy, ideology-critique, norm-selection, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This essay outlines an empirically grounded account of normative political legitimacy. The main idea is to give a normative edge to empirical measures of sociological legitimacy through a nonmoralized form of ideology critique. A power structure’s responsiveness to the values of those subjected to its authority can be measured empirically and may be explanatory or predictive insofar as it tracks belief in legitimacy, but by itself it lacks normative purchase. It merely describes a preference alignment, and so tells us nothing about whether the ruled have reason to support the rulers. I argue that we can close this gap by filtering the preferences of the ruled through a form of nonmoralized epistemic ideology critique, itself grounded in an empirical account of how belief in legitimacy is formed.",
    abstract_source = "openalex"
}

@misc{rossi2024comment,
    author = "Rossi, Enzo",
    title = "A Comment on Immanent Critique, Ideology, and Power",
    year = "2024",
    note = "CORE ARGUMENT: A short commentary on a symposium on critical theory and capitalism, focused on how to understand immanent critique and especially empirically grounded versions of it. Rossi argues that critique should rediscover its vocation as a science (Wissenschaft) and that radical realism can show new ways of exposing power structures. RELEVANCE: Explicitly places the realist programme inside the immanent-critique debate and ties immanence to empirical social science. Standards come from empirical findings about power rather than from norms of the social formation. Short and programmatic. POSITION: Radical realism reading immanent critique empirically.",
    keywords = "immanent-critique, political-realism, ideology-critique, empirical, Medium, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = {All contributors to the Radical Critical Theory Circle's symposium ‘Thinking Capitalism in the 21st Century"" highlight deficiencies in mainstream critical theory’s analysis of capitalism, but also point to some possible avenues of renewal. This this brief commentary focuses on how one should understand immanent critique - and in particular empirically-grounded versions of immanent critique. The piece's main contentions are that critique should rediscover its high modernist vocation as a Wissenschaft, and that a radical realist approach can uncover new ways for political theory to expose the most important power structures in society.},
    abstract_source = "s2"
}

@misc{clark2024moderate,
    author = "Clark, Rebecca L.",
    title = "Moderate realist ideology critique",
    year = "2024",
    volume = "32",
    note = "CORE ARGUMENT: Realist ideology critique (developed to answer the charge that realism is biased toward the status quo) debunks a belief in an institution's legitimacy by showing the institution itself causes it. Clark argues its defenders face a dilemma: implausible epistemological assumptions, or a tempered epistemology that leaves it toothless; she then dissolves the dilemma through a distinction between strengths of realist ideology critique. RELEVANCE: Directly addresses the conservatism objection as it arises within realism, and tests whether debunking from within the target's own causal story can have critical force. Source of standards: epistemic. Role of contradiction: none, debunking replaces it. POSITION: Realist ideology critique, defended in a moderate form.",
    keywords = "political-realism, ideology-critique, conservatism-objection, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Realist ideology critique (RIC) is a strand of political realism recently developed in response to concerns that realism is biased toward the status quo. RIC aims to debunk an individual's belief that a social institution is legitimate by revealing that the belief is caused by that very same institution. Despite its growing prominence, RIC has received little critical attention. In this article, I buck this trend. First, I improve on contemporary accounts of RIC by clarifying its status and the role of motivated reasoning. Second, I show that realist ideology critics face a dilemma: either their account makes deeply implausible epistemological assumptions, or they temper its epistemology at the expense of rendering it toothless. I argue for each horn in turn before revealing the dilemma to be a false one by making a novel distinction between varying strengths of RIC based on their underlying epistemological assumptions. I propose Moderate RIC as a solution: upon discovering that one reason for your belief that a social institution is legitimate is likely malignantly epistemically circular, the belief should undergo further epistemic testing. I respond to three potential objections and suggest that Moderate RIC would make a fruitful addition to political theorists' methodological toolkit.",
    abstract_source = "s2"
}

@misc{rossi2016facts,
    author = "Rossi, Enzo",
    title = "Facts, Principles, and (Real) Politics",
    year = "2015",
    note = "CORE ARGUMENT: Asks whether factual understanding should constrain normative theorising. Disputing Cohen's claim that ultimate principles are fact-independent, Rossi argues that resisting the conclusion that principles rest on facts about possibility requires an unsatisfactory account of how principles generate political judgments, forcing theorists to choose between principles unbiased by current circumstances and ones that generate action-guiding judgments. RELEVANCE: Realist reply to Cohen's anti-constructivism: it defends fact-sensitivity of political normativity, which is the realist and immanentist side of the source-of-standards question. Bears on the charge that fact-sensitive standards are conservative. Contradiction and progress are not at issue. POSITION: Political realism, fact-sensitive normativity, against Cohen's fact-independence thesis.",
    keywords = "political-realism, facts-and-principles, Cohen, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Should our factual understanding of the world influence our normative theorising about it? G.A. Cohen has argued that our ultimate normative principles should not be constrained by facts (e.g. about feasibility, human nature, and so on). Many others have defended or are committed to various versions or subsets of that claim. In this paper I dispute those positions by arguing that, in order to resist the conclusion that ultimate normative principles rest on facts about possibility or conceivability, one has to embrace an unsatisfactory account of how principles generate normative political judgments. So political theorists have to choose between principles ostensibly unbiased by our current understanding of human motivation and political reality, or principles capable of reliably generating political judgments. I conclude with wider methodological observations in defence of the latter option, and so of a return to political philosophy’s traditional blend of normative and descriptive elements",
    abstract_source = "core"
}

@misc{ypi2012global,
    author = "Ypi, Lea",
    title = "Global Justice and Avant-Garde Political Agency",
    year = "2011",
    note = "CORE ARGUMENT: Develops a theory of avant-garde political agency within a statist cosmopolitan view of global justice. From the table of contents (the abstract is a contents list): Part I treats history and method, including 'Activist Political Theory and Avant-Garde Agency'; later parts address principles and agency. RELEVANCE: Plan-assigned as a response to the norm-selection problem: a politically committed agent selects which tensions in existing associative relations to press. Pairs method and agency, so it is transformative rather than purely reconstructive. Detailed claims should be checked against the text before the synthesis relies on them. POSITION: Activist, practice-based political theory (per section titles).",
    keywords = "avant-garde-agency, transformative, norm-selection, Medium, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Introduction. - Part I: On History and Method. - 1: The Historical Controversy. - 2: Activist Political Theory and Avant-Garde Agency. - Part II: Defending the State, Defending Cosmopolitanism. - 3: Politics and Associative Relations. - 4: Global Egalitarianism. - Part III: Statist Cosmopolitanism. - 5: On Principles. - 6: On Agency. - 7: The Cosmopolitan Avant-Garde. - Conclusion",
    abstract_source = "openalex"
}

@misc{geuss2008philosophy,
    author = "Geuss, Raymond",
    title = "Philosophy and Real Politics",
    year = "2008",
    note = "CORE ARGUMENT: Geuss argues that philosophers should first understand why real political actors behave as they do, since politics is not applied ethics, and criticizes liberal political philosophies built on abstract conceptions of rights and justice. RELEVANCE: Sceptical anchor of the realist critique of ideal theory and, via the Frankfurt School heritage (see Domain 2 entry geuss1981idea), an immanence-leaning alternative. Standards are historical and context-bound. Skeptical of moral progress narratives. Prinz (2016) reads this as a radicalization of realism. POSITION: Historically oriented political realism.",
    keywords = "political-realism, ideal-theory-critique, ideology, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Many contemporary political thinkers are gripped by the belief that their task is to develop an ideal theory of rights or justice for guiding and judging political actions. But in Philosophy and Real Politics, Raymond Geuss argues that philosophers should first try to understand why real political actors behave as they actually do. Far from being applied ethics, politics is a skill that allows people to survive and pursue their goals. To understand politics is to understand the powers, motives, and concepts that people have and that shape how they deal with the problems they face in their particular historical situations.Philosophy and Real Politics both outlines a historically oriented, realistic political philosophy and criticizes liberal political philosophies based on abstract conceptions of rights and justice. The book is a trenchant critique of established ways of thought and a provocative call for change.",
    abstract_source = "s2"
}

@misc{williams1981internal,
    author = "Williams, Bernard",
    title = "Internal and external reasons",
    year = "1981",
    note = "CORE ARGUMENT: Distinguishes two readings of 'A has a reason to phi': an internal reading, on which the sentence is true only if phi-ing would serve some motive in A's motivational set, and an external reading, on which no such condition holds. RELEVANCE: Analytic model of the internal/external distinction for reasons: criticism of an agent from standards that are not already in the agent's motivational set has no reason-giving force on the internal reading. This parallels the immanent critic's requirement that standards be recognizable to the criticized and carries the same conservatism worry; Williams' later political realism extends the idea to legitimacy. POSITION: Reasons internalism.",
    keywords = "internal-reasons, Williams, analytic-parallel, High, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "Sentences of the forms ‘ A has a reason to φ’ or ‘There is a reason for A to φ’ (where ‘φ’ stands in for some verb of action) seem on the face of it to have two different sorts of interpretation. On the first, the truth of the sentence implies, very roughly, that A has some motive which will be served or furthered by his φ-ing, and if this turns out not to be so the sentence is false: there is a condition relating to the agent's aims, and if this is not satisfied it is not true to say, on this interpretation, that he has a reason to φ. On the second interpretation, there is no such condition, and the reason-sentence will not be falsified by the absence of an appropriate motive. I shall call the first the ‘internal’, the second the ‘external’, interpretation. (Given two such interpretations, and the two forms of sentence quoted, it is reasonable to suppose that the first sentence more naturally collects the internal interpretation, and the second the external, but it would be wrong to suggest that either form of words admits only one of the interpretations.) I shall also for convenience refer sometimes to ‘internal reasons’ and ‘external reasons’, as I do in the title, but this is to be taken only as a convenience.",
    abstract_source = "openalex"
}

@misc{cohen2008rescuing,
    author = "Cohen, G. A.",
    title = "Rescuing Justice and Equality",
    year = "2008",
    note = {CORE ARGUMENT: Cohen argues against Rawlsian egalitarianism, and methodologically against constructivism that derives principles from facts about practices (per contents: "Some Methodological Disagreements," "Rescuing Justice from Constructivism"). RELEVANCE: The "Facts and Principles" argument, that fundamental principles do not depend on facts about social practice, is the strongest analytic argument against making social practices the source of normative standards, which is the immanent critic's commitment. It supports the external-standards pole of the dilemma. Realists such as Rossi (2016) reply. POSITION: Fact-independent normative foundationalism; anti-constructivism.},
    keywords = "Cohen, facts-and-principles, constructivism, external-standards, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
