    keywords = "rational reconstruction, method, German-language, Low, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@article{kirkpatrick2003evolution,
    author = "Kirkpatrick, Graeme",
    title = "Evolution or Progress? A (Critical) Defence of {Habermas}'s Theory of Social Development",
    journal = "Thesis Eleven",
    year = "2003",
    note = "CORE ARGUMENT: Responds to environmentally motivated sociologists who argue that Habermas's extended analogy between social theory and biology produces positions irreconcilable with Green politics and traditional critical theory; argues these criticisms misjudge the role of evolutionary concepts in Habermas's work. RELEVANCE: Bears on the progress question for reconstructive critique: whether Habermas's standards rest on a reconstruction of developmental (evolutionary) logic and what this implies for progress claims. POSITION: Critical defence of Habermas's reconstructive theory of social evolution.",
    keywords = "Habermas, progress, social evolution, Low, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "Habermas's theory of social evolution has been subjected to critique by environmentally motivated sociologists. They argue that his decision to recast social theory in terms of an extended, if selective analogy with biology leads him into a set of practical positions that are irreconcilable with Green politics and inconsistent with the goals of traditional critical theory. This article argues that these criticisms are based on an inaccurate assessment of the role of evolutionary concepts in Habermas's thought. By drawing out the similarities between Habermas and Kant on the question of the relationship between history and natural history, it is possible to see that Habermas's use of evolutionary metaphors plays a regulative rather than a constitutive role in his thinking on society. This strategy does not save Habermas's position, but shows instead that it may be vulnerable to an immanent critique that pulls out the real underlying antagonisms in his system.",
    abstract_source = "openalex"
}

@misc{honneth2001reconstructive,
    author = "Honneth, Axel",
    title = "Reconstructive Social Critique with a Genealogical Reservation",
    year = "2001",
    volume = "22",
    note = "CORE ARGUMENT: Honneth distinguishes reconstructive social criticism (identifying the normative potentials already embedded in social practices) from genealogical critique, retaining a genealogical proviso that reconstruction alone cannot capture historical power and domination (abstract not retrieved). RELEVANCE: Key methodological essay on source of standards (immanent, institutionalised rationality), with genealogy as supplement against conservative closure; early statement of the reconstructive turn that Repa, Carleheden and Schaub analyse. POSITION: Honneth's reconstructive immanent critique with genealogical corrective.",
    keywords = "Honneth, reconstructive critique, genealogy, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{honneth2009reconstructive,
    author = "Honneth, Axel",
    title = "Reconstructive Social Criticism with a Genealogical Proviso",
    year = "2009",
    note = "CORE ARGUMENT: English chapter version (Pathologies of Reason, chapter 3) of the 2001 essay on the idea of critique in the Frankfurt School: reconstruction of embedded normative ideals plus a genealogical proviso. Chapter title and pages from CrossRef. RELEVANCE: The standard English citation for Honneth's methodological statement of reconstructive critique; relates to domain 4's Jaeggi critique that reconstruction is internal criticism without transformative negativity. POSITION: Honneth's reconstructive critique with genealogical proviso.",
    keywords = "Honneth, reconstructive critique, genealogy, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
