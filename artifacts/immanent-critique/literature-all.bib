}

@misc{decaux2024antinomic,
    author = "de Caux, Luiz Philipe",
    title = "Antinomic normativity: Negative dialectics, moral skepticism, and the problem of the normative foundations of critical theory",
    year = "2024",
    volume = "52",
    note = {CORE ARGUMENT: Argues that negative dialectics answers moral scepticism about the normative foundations of Critical Theory through an "antinomic" conception of normativity, in which norms arise from antinomies in concepts and social reality. RELEVANCE: Recent contribution to the source-of-standards debate with an explicit link between contradiction and normativity; useful for Domain 5's foundation debates. POSITION: Negative-dialectical answer to normative scepticism.},
    keywords = "Adorno, negative-dialectics, normative-foundations, antinomy, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article attempts to determine Adorno’s stance concerning two opposing positions in the relationship between critique and normativity. Although he rejects the demand to account for the normative foundations of critique, his negative dialectics does not fall back on the alternative of skepticism about normativity, of which it is often accused. I illustrate this problem by recovering the skeptical objections advanced by Justin Evans. Next, I turn to the young Hegel’s interpretation of the positive relationship between his speculative dialectics and skepticism to pose the question of what relationship now exists between negative dialectics and skepticism. The answer is outlined based on a reading of Minima Moralia under the interpretative key of the idea of real normative antinomies.",
    abstract_source = "s2"
}

@misc{skirke2024phenomenology,
    author = "Skirke, C.",
    title = "Phenomenology and the status quo: Adorno's mediation argument",
    year = "2024",
    volume = "52",
    note = {CORE ARGUMENT: Reconstructs Adorno's "mediation argument" against phenomenology as an immanent criticism: phenomenological description of experience is shown to be mediated by social conditions, and hence to reproduce the status quo. RELEVANCE: Recent analysis of how Adorno's immanent critique operates as a procedure, where the standard is the claim to immediacy of the criticised position. POSITION: Method-focused reading of Adorno's critique.},
    keywords = "Adorno, mediation, phenomenology, immanent-critique-method, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "In this paper, I discuss a well-known challenge against phenomenology as a viable form of social criticism. According to this challenge—the Mediation Argument—phenomenology falls short of the requirement that any kind of critique needs a suitable medium of representation because the phenomenological account of experience prioritizes immediacy or directness. I aim to show through a reconstruction of Adorno’s version of the Mediation Argument against Husserl that this challenge fails: it distorts the phenomenological account of meaning by misattributing problematic ontological commitments as well as an overly simplistic idea of normativity to phenomenology; and it systematically underplays critical aspects of the transcendental methodology of phenomenology by ignoring crucial contrasts between phenomenology and commonsense philosophy. Contrary to what the Mediation Argument suggests, I conclude, phenomenology is well-placed to confront the ontological commitments and normative assumptions that commonly lend ideological support to the status quo.",
    abstract_source = "s2"
}

@misc{ziegelmann2025immanent,
    author = "Ziegelmann, Robert",
    title = "Immanent Critique ``From the Standpoint of Redemption'': Adorno's Method and Its Sources in Kafka",
    year = "2025",
    note = {CORE ARGUMENT: Traces Adorno's immanent critique to Kafka and the notion of seeing things "from the standpoint of redemption" (Minima Moralia), linking the method to messianic or redemptive perspective. RELEVANCE: Directly theorises Adorno's immanent critique, connecting it to the Benjaminian redemptive strand and the problem of the standpoint from which to criticise a wrong life. Standards: the possibility of redemption as a limit perspective. POSITION: Redemptive/literary reading of Adorno's method.},
    keywords = "Adorno, immanent-critique, redemption, Kafka, Benjamin, High, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "Abstract At the conclusion of “Minima Moralia,” Theodor W. Adorno invokes a “standpoint of redemption.” I interpret this formulation as a methodological self-description and argue that it does not conflict with critical theory’s commitment to immanent critique. After distinguishing between two divergent accounts of immanent critique in recent scholarship, I turn to the idea of a “standpoint of redemption” or “inverse theology,” traced back to Siegfried Kracauer’s early writings on Franz Kafka. In his “Notes on Kafka,” Adorno develops motifs from Kracauer into his most thorough articulation of the negativist-messianic device. Instead of contrasting social phenomena with ideal alternatives, “inverse theology” presents the absurd as normal, rendering reality uncanny through analogies that depict humans as animals and the present as if it belonged to a distant past. In this way, the standpoint of redemption emerges indirectly, by estranging everyday life. Adorno’s reading of Kafka thus clarifies his own method of social critique. This method neither contradicts the version of immanent critique that, I contend, most faithfully captures the tradition of critical theory, nor does it entail substantive theological commitments. Rather, it can be understood as a form of “inverse utopianism.”",
    abstract_source = "s2"
}

@misc{athanassiadis2026ideology,
    author = "Athanassiadis, A.",
    title = "Adorno and the Kantian Sources of Ideology Critique",
    year = "2026",
    note = "CORE ARGUMENT: Argues that Adorno's ideology critique has Kantian sources (critique of illusion), alongside Hegelian-Marxist ones. (Based on title and S2 record; check abstract.) RELEVANCE: Bears on the source-of-standards question in ideology critique, pointing to a Kantian rather than purely Hegelian root for immanent critique; links to Domain 6 on ideology. POSITION: Kantian-genealogy reading of Adorno.",
    keywords = "Adorno, ideology-critique, Kant, Medium, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "Abstract Social theorists in the Marxian tradition often interpret philosophical problems as reflections of social problems. This approach is central to Adorno's interpretation of Kant's epistemology. Adorno claims that the Critique of Pure Reason develops a concept of subjectivity that mirrors the “functionalization” of experience in capitalist societies. He retains that concept contradictory just as the social functionalism it ideologically reflects. In this paper I argue that Kant's concept of subjectivity is not contradictory and that Adorno must rely on it to articulate his critique of functionalism. Recognizing this Kantian debt implies not just acknowledging the Kantian sources of Adorno's model of ideology critique, but also revising central aspects of his social theory.",
    abstract_source = "openalex"
}

@article{athanassiadis2026hegel,
    author = "Athanassiadis, A.",
    title = "Hegel in Adorno's post-Hegelianism",
    journal = "Hegel Bulletin",
    year = "2026",
    doi = "10.1017/hgl.2026.10093",
    note = "CORE ARGUMENT: Examines Hegel's role in Adorno's post-Hegelian philosophy, i.e. what Adorno retains and rejects of Hegelian dialectic. (Based on title and S2/CrossRef record.) RELEVANCE: Connects to Domain 1 on determinate negation and immanent critique; helps distinguish Hegelian from Adornian immanent critique on contradiction and reconciliation. POSITION: Hegel-Adorno relation.",
    keywords = "Adorno, Hegel, post-Hegelian, determinate-negation, Medium, METADATA\_CLEANED: pages",
    abstract = "Abstract According to a widely accepted interpretation, the dialectics of Adorno and Hegel pursue opposite goals despite their similar terminology. Adorno employs immanent critique and determinate negation within a negativistic model of social criticism, diagnosing the irrationality of Western capitalist societies without offering remedies. Hegel uses the same method to support a social quietism grounded in optimistic views about the rationality of modern societies. While I shall not dispute the thesis of a deep incompatibility between Adorno and Hegel, I argue that it overlooks a deeper issue. Adorno presents his negative dialectic as an alternative to Hegel’s, in so far as he claims to identify and criticize the latter’s identitarian character—its tendency to rationalize phenomena. I contend that Adorno’s critique misfires on several counts, most notably in its account of the source of Hegel’s identitarian problem. The crux of the matter, however, is neither Adorno’s Hegelianism nor his anti-Hegelianism, but the viability of his distinctive model of post-Hegelian philosophy.",
    abstract_source = "openalex"
}

@misc{martinson2014adorno,
    author = "Martinson, Mattias",
    title = "What Is Adorno Doing? Immanent Critique as Philosophical Performance",
    year = "2014",
    note = {CORE ARGUMENT: Treats Adorno's immanent critique as a performative philosophical practice rather than a theory with foundations, answering what Adorno is "doing" when he criticises. RELEVANCE: Offers a performance-based answer to the performative-contradiction and foundations worries: the critique is its enactment. Methodological focus on immanent critique in Adorno. POSITION: Practice-based reading of Adorno's method.},
    keywords = "Adorno, immanent-critique, method, performance, Medium, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "Anyone who approaches Adorno’s thought will soon become aware of several difficulties — a fact that commentators have been keen to point out: Adorno is an immensely difficult thinker (e.g. Brittain, Adorno and Theology 9; Jarvis, Adorno 2–3; Spitzer, Music as Philosophy 6–7; van Reijen, Adorno 1–2). Consequently, the traditional commentary on Adorno’s thought is there to help us in our understanding. Supported by commentators, who concentrate on this or that, we are supposed to slowly get around the main obstacles and get a clearer picture. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.",
    abstract_source = "openalex"
}

@misc{antonio1981immanent,
