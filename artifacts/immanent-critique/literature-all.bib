@misc{bellofiore2015neue,
    author = "Bellofiore, R. and Redolfi Riva, Tommaso",
    title = "The Neue Marx-Lektuere. Putting the critique of political economy back into the critique of society",
    year = "2015",
    note = "CORE ARGUMENT: Bellofiore and Redolfi Riva survey the Neue Marx-Lektuere and argue for its approach of re-centring the critique of political economy within a critique of society. (Based on title; venue not given in the API record.) RELEVANCE: Overview of the NML school (Backhaus, Reichelt, Heinrich) that fills a gap left by German-language sources not retrieved directly. POSITION: Secondary survey; sympathetic to NML.",
    keywords = "marx, neue-marx-lektuere, survey, Medium, INCOMPLETE, no-abstract"
}

@misc{brudney1998marxs,
    author = "Brudney, Daniel",
    title = "Marx's Attempt to Leave Philosophy",
    year = "1998",
    note = "CORE ARGUMENT: Brudney examines Marx's early writings and his attempt to move beyond philosophy, asking in what sense Marx's critique relies on moral or philosophical standards. (Based on title and reviews retrieved; abstract pending.) RELEVANCE: Pertains to whether the early Marx's critique of Feuerbach and the Young Hegelians relinquishes philosophy for a different critical stance, and what standard (e.g., an ethical one) remains. POSITION: Interpretation of early Marx; tension between critique and philosophy.",
    keywords = "marx, early-marx, young-hegelians, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Brudney traces post-Hegelian thought from Feuerbach through Bauer to Marx’s work of 1844 and his Theses on Feuerbach , and ends with an examination of The German Ideology . He shows how Marx attempted to reveal humanity’s nature and a notion of the good life, while polemicizing against any concern with metaphysics and epistemology.",
    abstract_source = "openalex"
}

@misc{leopold2007young,
    author = "Leopold, David",
    title = "The Young Karl Marx: German Philosophy, Modern Politics, and Human Flourishing",
    year = "2007",
    note = "CORE ARGUMENT: Leopold reconstructs the early Marx within German philosophy and modern politics, with human flourishing as an evaluative concern. SEP's ideology entry also cites Leopold (2007). (Based on title and SEP citation.) RELEVANCE: Source on the early Marx's engagement with Hegel and the Young Hegelians and on the standards (flourishing, alienation) implicit in his critique, and on Marx's theory of ideology. POSITION: Interpretive history of early Marx; some evaluative standard retained.",
    keywords = "marx, early-marx, ideology, Medium, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "The Young Karl Marx is an innovative and important study of Marx's early writings. These writings provide the fascinating spectacle of a powerful and imaginative intellect wrestling with complex and significant issues, but they also present formidable interpretative obstacles to modern readers. David Leopold shows how an understanding of their intellectual and cultural context can illuminate the political dimension of these works. An erudite yet accessible discussion of Marx's influences and targets frames the author's critical engagement with Marx's account of the emergence, character, and (future) replacement of the modern state. This combination of historical and analytical approaches results in a sympathetic, but not uncritical, exploration of such fundamental themes as alienation, citizenship, community, anti-semitism, and utopianism. The Young Karl Marx is a scholarly and original work which provides a radical and persuasive reinterpretation of Marx's complex and often misunderstood views of German philosophy, modern politics, and human flourishing.",
    abstract_source = "openalex"
}

@misc{breckman1998marx,
    author = "Breckman, Warren",
    title = "Marx, the Young Hegelians, and the Origins of Radical Social Theory: Dethroning the Self",
    year = "1998",
    doi = "10.1017/cbo9780511624704",
    note = {CORE ARGUMENT: Breckman traces the Young Hegelians' critique of Hegelian and religious conceptions of selfhood and its role in the origins of radical social theory, including Marx. (Based on title and reviews retrieved.) RELEVANCE: Historical context for the Left-Hegelian reception of immanent critique (Feuerbach, "ruthless criticism"). POSITION: Intellectual history of Young Hegelian critique.},
    keywords = "young-hegelians, feuerbach, marx, Medium, METADATA\\_CLEANED: publisher, type:@book->@misc",
    abstract = "This is the first major study of Marx and the Young Hegelians in twenty years. The book offers a new interpretation of Marx's early development, the political dimension of Young Hegelianism, and that movement's relationship to political and intellectual currents in early nineteenth-century Germany. Warren Breckman challenges the orthodox distinction drawn between the exclusively religious concerns of Hegelians in the 1830s and the sociopolitical preoccupations of the 1840s. He shows that there are inextricable connections between the theological, political and social discourses of the Hegelians in the 1830s. The book draws together an account of major figures such as Feuerbach and Marx, with discussions of lesser-known but significant figures such as Eduard Gans, August Cieszkowski, Moses Hess, F. W. J. Schelling as well as such movements as French Saint-Simonianism and 'positive philosophy'. Wide-ranging in scope and synthetic in approach, this is an important book for historians of philosophy, theology, political theory and nineteenth-century ideas.",
    abstract_source = "openalex"
}

@misc{wood1980marxian,
    author = "Wood, Allen W.",
    title = "The Marxian Critique of Justice",
    year = "1980",
    note = "CORE ARGUMENT: Wood argues that Marx does not condemn capitalism as unjust: on his view justice is a juridical standard internal to a mode of production, and capitalist exploitation is just by the standard appropriate to it. Marx's critique thus does not rest on a transhistorical standard of justice. RELEVANCE: Central to whether Marx's critique is immanent (judged by capitalism's own norms of justice) or external (a moral standard); Wood's view yields a non-moral critique based on other values (freedom, self-actualization). POSITION: Non-moral, immanent-justice reading of Marx.",
    keywords = "marx, justice, wood, immanent-vs-external, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{husami1980marx,
    author = "Husami, Ziyad I.",
    title = "Marx on Distributive Justice",
    year = "1980",
    note = "CORE ARGUMENT: Husami argues that Marx does condemn capitalism as unjust, by a proletarian or communist standard of distributive justice (e.g., needs and exploitation), against Wood. RELEVANCE: The opposing pole of the Marx-and-justice debate: an external or class-relative moral standard grounds Marx's critique. POSITION: Moralist reading; Marx criticises capitalism as unjust.",
    keywords = "marx, justice, husami, external-standard, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{wood1980right,
