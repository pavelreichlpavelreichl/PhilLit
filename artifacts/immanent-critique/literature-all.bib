@misc{solinas2025goodbyehegel,
    author = "Solinas, Marco",
    title = "Goodbye Hegel! Overcoming ``Geschichtsteleologie'' in German Critical Theory",
    year = "2025",
    volume = "26",
    note = "CORE ARGUMENT: Takes up Allen's challenge from a post- and de-colonial perspective and argues that the neo-Hegelian method of normative reconstruction adopted by Honneth, and in some respects Habermas, carries a post-metaphysical teleology of history (Geschichtsteleologie), which obstructs Allen's challenge and makes a theory of historical development difficult. RELEVANCE: Directly links reconstructive immanent critique to teleology, answering the key question whether the Hegelian line presupposes progress. Supports the view that reconstructive critique is the form most exposed to the progress objection. POSITION: Pro-Allen; reconstructive critique (Honneth) requires teleology, which should be abandoned.",
    keywords = "Honneth, normative reconstruction, teleology, progress, decolonial, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "The paper takes up Amy Allen’s challenge to contemporary German critical theory from the perspective of post- and de-colonial studies, focusing on the role played by Hegel’s legacy. More precisely, it takes up the neo-Hegelian method of normative reconstruction adopted by Axel Honneth and, in some respects, by Habermas. This perspective led Honneth to adopt a teleology of history, in the strict sense of a Geschichtsteleologie, although certainly in a post-metaphysical form, which represents an obstacle to Allen’s challenge. The teleological conception of the progressive realization of reason, especially during modernity, leads in fact to difficulties in developing a theory of history able to deal with the themes of coloniality, and more generally to discuss from this perspective the correlations between normativity, history and power relations. Finally, from the point of view of the opportunity to establish an organic connection between social critic and subaltern subjects and cultures, this conception is very problematic, especially considering the neo-Hegelian model of immanent critique.",
    abstract_source = "openalex"
}

@misc{kim2022believe,
    author = "Kim, Min Seong",
    title = "To Believe in Historical Progress: On Axel Honneth's Normative Grounding of Critique",
    year = "2022",
    volume = "32",
    note = "CORE ARGUMENT: Argues that Honneth grounds the normativity of critique beyond communicative reason, and that an affirmative stance toward historical progress is critical to this project, because it lets Honneth derive the validity of the normative presuppositions of the existing social order and so practice a robust immanent critique. RELEVANCE: States the dependency thesis cleanly: for Honneth, immanent critique's normative standard is secured by progress. This is the claim Allen and Solinas contest. POSITION: Interpretive account of Honneth; source of standards = norms vindicated by historical progress (reconstructive).",
    keywords = "Honneth, progress, immanent critique, reconstructive, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "One of the most ambitious contributions Axel Honneth has made to critical theory consists in his attempt to ground the normativity of critique beyond communicative reason—the normative ground of critique that had been proposed by Honneth’s predecessor at the Institut für Sozialforschung, Jürgen Habermas. Defending an affirmative stance toward historical progress is critical to Honneth’s project, which attempts to pursue the aspiration of the Frankfurt School to practice a robust form of immanent critique: for preserving the idea of progress allows Honneth to derive the validity of the underlying normative presuppositions of the existing social order, thereby securing the normative grounds of critique without relying on transcendent or transhistorical principles. Through a consideration of an aspect of the relation between universality and particularity that remains undertheorized in Honneth’s account, this essay attempts to question the success of his strategy for grounding the normativity of critique.",
    abstract_source = "s2"
}

@misc{chen2025progress,
    author = "Chen, Yang",
    title = "The progress without ``progress'': Critique of Jaeggi's pragmatist theory of progress",
    year = "2025",
    volume = "29",
    note = "CORE ARGUMENT: Criticizes Jaeggi's pragmatist theory of progress, which rejects moralist and historicist views and treats progress as non-teleological enrichment of experience through problem-solving; argues that her analogy between social-moral and scientific progress fails and, drawing on Kuhn's incommensurability, offers a psychologist alternative. RELEVANCE: Tests Jaeggi's attempt to keep immanent critique (problem-solving, learning processes) while avoiding teleology; the objection is that the analogy to science cannot do the work. Complements Melo 2025 and Unal 2025 (Domain files) on Jaeggi. POSITION: Critical of Jaeggi's non-teleological progress as standard for immanent critique.",
    keywords = "Jaeggi, progress, problem-solving, incommensurability, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article criticizes the pragmatist theory of progress developed by Rahel Jaeggi and argues for a psychologist alternative. In her theory, Jaeggi rejects both moralist and historicist understandings of progress, arguing that progress should be regarded as a non-teleological process of experience enrichment. However, by identifying progress with problem-solving activities, Jaeggi explicitly makes a parallelist argument between social-moral and scientific progress, which is highly questionable. In this analysis, I argue that Jaeggi's analogy fails. And by referring to Kuhn's notion of incommensurability, I demonstrate a more radical, psychologist approach, which departs from any idea of experience enrichment in history. The lack of a sufficient account of progress is not the failure of Kuhn. In contrast, it is his very own insight.",
    abstract_source = "s2"
}

@misc{volpe2025progress,
    author = "Volpe, Alessandro",
    title = "Progress, Self-criticism, and Normativity",
    year = "2025",
    volume = "26",
    note = "CORE ARGUMENT: Engages theoretical issues arising from Allen's End of Progress, situating it within the relation of critical theory to progress, traditionally carried out through self-criticism understood as an immanent, reflexive effort to expose internal paradoxes of concepts and transform them from the inside; Allen's postcolonial and Foucauldian engagement extends that feature. RELEVANCE: Reads Allen's work as itself a continuation of immanent critique of the concept of progress, which bears on whether the decolonial critique is external or immanent to critical theory. POSITION: Sympathetic to Allen; frames her critique as immanent self-criticism of critical theory.",
    keywords = "Allen, progress, self-criticism, immanent critique, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This essay engages with some theoretical issues emerging from Amy Allen’s book The End of Progress: Decolonizing the Normative Foundations of Critical Theory. It begins by situating Allen’s work within the broader relationship between critical theory and progress, a relationship traditionally carried on by the practice of self-criticism – an immanent and reflexive endeavour that seeks to expose internal odds, paradoxes and pitfalls of concepts and transform them from the inside. Drawing on post-colonial studies and Foucauldian genealogy, Allen’s book contributes to and enriches such distinctive feature of critical theory in its engagement with the language of progress and development. However, this essay attempts to raise two main critical remarks/open questions regarding Allen’s pars construens, specifically her claim for a negativistic meta-normative contextualism and the dismissal of backward-looking progress. Whilst Allen’s explicit intention is to avoid delivering an “abstract negation of modern morality”, her normative solutions, in both instances, risks being overly one-sided and undetermined, and eventually preserving little of that inheritance. The guiding idea of such critical analysis is the advocacy of self-criticism as an immanent task and discourse ethics as the framework for an emancipative dialogue with the subalterns and colonised subjects.",
    abstract_source = "openalex"
}

