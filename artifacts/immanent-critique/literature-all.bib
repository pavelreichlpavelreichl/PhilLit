}

@misc{walzer1987interpretation,
    author = "Walzer, Michael",
    title = "Interpretation and Social Criticism",
    year = "1987",
    address = "Cambridge",
    note = "CORE ARGUMENT: Argues that social criticism does not need Archimedean or discovered/invented universal principles; the 'connected critic' interprets the shared meanings and moral understandings of her own society and criticises it for failing to live up to them. Morality is 'thick' and local; 'thin' universals are distilled from the thick by occasional reiteration. RELEVANCE: Canonical statement of the hermeneutic/communitarian version of internal critique and the primary object of conventionalism objections. Standards come from the society's own interpreted meanings; contradiction plays a minor role (the gap between professed meaning and practice, not an objective contradiction); critique is reconstructive-reformist and sceptical of progress narratives. Contrasts with Habermas's formal-pragmatic and Honneth's normative-reconstructive grounds. Bibliographic details confirmed via PhilPapers record only (not CrossRef). POSITION: Connected criticism / communitarian hermeneutics (internal critique rather than 'immanent critique' in the Hegelian sense).",
    keywords = "Walzer, connected criticism, internal critique, hermeneutics, communitarianism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{raz1991morality,
    author = "Raz, Joseph",
    title = "Morality as Interpretation: {Interpretation} and Social Criticism. {Michael} Walzer",
    year = "1991",
    note = "CORE ARGUMENT: Review essay on Walzer's Interpretation and Social Criticism, pressing the worry that interpretation of a society's shared meanings cannot by itself deliver critical standards independent of the society's actual practices (title and venue confirmed by CrossRef; argument summarised from the well-known thrust of the review, abstract unavailable). RELEVANCE: Sceptical voice on connected criticism: whether the 'interpretive' basis delivers critical purchase or collapses into conventionalism. Useful for Domain 5 cross-reference on the conservatism objection. POSITION: Sceptical/liberal-analytic response to Walzer's internal criticism.",
    keywords = "Walzer, conventionalism, sceptical voice, internal critique, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "With the growing interest in interpretation as an activity essential in the study of the arts and of society it was inevitable that the question of the relation between morality and interpretation would attract considerable interest. Given that moral views and arguments are expressed in language, are essentially language bound, there is no doubt that the understanding of moral views and argument involves, at least at times, interpretation (of arguments and propositions, etc.). The same can be said of physics. The question is whether morality is interpretative in a way in which physics is not. Some writers have claimed that it is. I will examine the claims and arguments to that effect advanced by Michael Walzer, though much of my argument will be general and not limited to the arguments he explicitly advances.'",
    abstract_source = "s2"
}

@misc{allen1998situated,
    author = "Allen, Jonathan",
    title = "The situated critic or the loyal critic? {Rorty} and {Walzer} on social criticism",
    year = "1998",
    volume = "24",
    note = "CORE ARGUMENT: Asks whether the 'connected' or 'loyal' model of social criticism advanced by Rorty and Walzer is adequate; argues loyalty is an internally conflicted concept with three components (recognition of situatedness in a relationship, affirmation of that relationship, and a set of values or local principles). RELEVANCE: Sceptical reading of connected criticism that puts pressure on loyalty as the critic's source of standards; locates Walzer relative to pragmatist ethnocentrism as a second 'internal' alternative to Habermasian reconstruction. POSITION: Walzer/Rorty comparison within communitarian-pragmatist internal criticism.",
    keywords = "Walzer, Rorty, connected criticism, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article addresses the question whether the model of social criticism as 'connected' or 'loyal' which is advanced by Richard Rorty and Michael Walzer offers an adequate picture of social criticism. Two claims are made. First, it is suggested that loyalty is an internally conflicted concept, with three components: a recognition of situatedness in a particu lar relationship; an affirmation of that relationship by the loyal agent; a set of values or local principles. Where the third component is prominent, loyalty is more reflective and distanced; where the second component predominates, loyalty slips into unreflective commitment. Second, it is argued that Rorty and Walzer conflate the social critic's recognition of his or her situatedness in contexts of power with the affirmation of that situ atedness. It is concluded that the model of loyal social criticism is mislead mg, and that the practice of the critic must be tempered by the operation of the sense of injustice.",
    abstract_source = "openalex"
}

@misc{gregory2010political,
    author = "Gregory, James",
    title = "The political philosophy of {Walzer}'s social criticism",
    year = "2010",
    note = "CORE ARGUMENT: Calls for a critical re-evaluation of Walzer's theory of justice, arguing that a deep tension exists between his social criticism (grounded in the value of a connected, 'whole' self) and his complex equality (grounded in value pluralism that threatens to fragment that wholeness), so that Walzer tacitly relies on the 'political philosophy' he repudiates. RELEVANCE: Sceptical voice: shows connected criticism rests on a tacit normative premise (the connected, whole self), which bears on the source-of-standards question (is the 'immanent' ground really independent of a substantive philosophy?). POSITION: Secondary analysis of Walzer; communitarian/connected criticism.",
    keywords = "Walzer, connected criticism, Low, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This article calls for a critical re-evaluation of Walzer’s theory of justice. It argues that there is a deep tension between Walzer’s social criticism and his complex equality. Social criticism is based on the normative value of a connected and ‘whole’ self, and complex equality is based upon a value pluralism that threatens to fragment this sense of wholeness. Walzer therefore commissions a tacit premise, borrowing from the same ‘political philosophy’ that he explicitly repudiates, and which social criticism is intended to supplant. This premise is a Kantian-inspired conception of self; brought to the argument as an a priori premise and thus in violation of Walzer’s own stated commitment to ‘internalism’ and ‘interpretation’. Furthermore, this same conception of self is the moral source of Walzer’s substantive commitment to the universal value of pluralist political regimes. The article closes with a suggested reconciliation of the inherent tension within Walzer’s theory.",
    abstract_source = "openalex"
}

@misc{benhabib1986critique,
    author = "Benhabib, Seyla",
    title = "Critique, Norm, and Utopia: A Study of the Foundations of Critical Theory",
    year = "1986",
    address = "New York",
    note = "CORE ARGUMENT: Traces the development of critical theory from Hegel through Marx, Lukacs and the Frankfurt School to Habermas, distinguishing the 'immanent' critique of Hegel and Marx (anchored in the dialectic of historical contradiction and the philosophy of history) from a communicative-ethical, anticipatory-utopian standpoint. She argues that critical theory needs two moments, explanatory-diagnostic and anticipatory-utopian, and that normative foundations should be located in the communicative ethics of universal moral respect and egalitarian reciprocity rather than in a philosophy of history. Bibliographic details from PhilPapers snippet and S2 reviews; not CrossRef-verified. RELEVANCE: The most direct treatment in this domain of the immanent/transcendent problem as a problem about the foundations of critique: source of standards (communicative ethics, a 'transcendence within'), role of contradiction (retained diagnostically, no longer a guarantee), reconstructive-plus-utopian, and progress (decoupled from philosophy of history). POSITION: Habermas-inflected communicative-ethical reconstruction of immanent critique.",
    keywords = "Benhabib, immanent critique, anticipatory-utopian, communicative ethics, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

