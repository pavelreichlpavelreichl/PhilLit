@book{ware2020fichte,
  author = {Ware, Owen},
  title = {Fichte's Moral Philosophy},
  year = {2020},
  publisher = {Oxford University Press},
  doi = {10.1093/oso/9780190086596.001.0001},
  note = {
  CORE ARGUMENT: Offers a sustained reading of Fichte's System of
  Ethics (1798) as an "ethics of wholeness," arguing that Fichte's
  ethics is structured around a theory of drives (Triebe) that unites
  freedom, moral feeling, and conscience. Challenges the standard
  reading that Fichte's ethics is simply a radicalization of Kantian
  autonomy by showing the role of affective and communal elements.

  RELEVANCE: The System of Ethics is one of Fichte's three major
  practical works alongside the Foundations of Natural Right and the
  Closed Commercial State; this study provides the authoritative
  English-language treatment of its arguments, essential for
  understanding how ethics relates to right and history in Fichte's
  practical system.

  POSITION: Interprets ethics as complementing rather than grounding
  right, contributing to discussions of how freedom's practical
  dimensions relate to its historical realization.
  },
  keywords = {ethics, moral-philosophy, System-of-Ethics, freedom, High},
  abstract = {This book develops and defends a new interpretation of Fichte’s moral philosophy as an ethics of wholeness. While virtually forgotten for most of the twentieth century, Fichte’s System of Ethics (1798) is now recognized by scholars as a masterpiece in the history of post-Kantian philosophy and a key text for understanding the work of later German idealist thinkers. This book provides a careful examination of the intellectual context in which Fichte’s moral philosophy evolved and of the specific arguments he offers in response to Kant and his immediate successors. A distinctive feature of the study is a focus on the foundational concepts of Fichte’s ethics—freedom, morality, feeling, conscience, community—and their connection to his novel but largely misunderstood theory of drives. By way of conclusion, the book shows that what appears to be two conflicting commitments in Fichte’s ethics, a commitment to the feelings of one’s conscience and a commitment to engage in open dialogue with others, are two aspects of his theory of moral perfection. The result is a fresh understanding of Fichte’s System of Ethics as offering a compelling resolution to the personal and interpersonal dimensions of moral life.},
  abstract_source = {s2},
}

@article{nance2012recognition,
  author = {Nance, Michael},
  title = {Recognition, Freedom, and the Self in {Fichte}'s {Foundations of Natural Right}},
  journal = {European Journal of Philosophy},
  year = {2012},
  volume = {23},
  number = {3},
  pages = {608--632},
  doi = {10.1111/j.1468-0378.2012.00552.x},
  note = {
  CORE ARGUMENT: Presents a detailed reconstruction of Fichte's
  transcendental argument in the Foundations of Natural Right for
  mutual recognition as a condition of the possibility of
  self-consciousness. Identifies what Nance calls a "modal dilemma":
  either the necessity Fichte establishes is too strong (metaphysically
  implausible) or too weak (failing to ground normative conclusions
  about right). Proposes a reading that escapes this dilemma by
  distinguishing the argument's transcendental structure from its
  normative implications.

  RELEVANCE: Directly addresses the foundational structure of the
  Foundations of Natural Right and the relationship between recognition
  and freedom — two concepts central to the domain's question of how
  right is grounded in intersubjective conditions that history must
  actualize.

  POSITION: Recognition-focused analytical reading of the FNR, in
  debate with McNulty (2016) over the modal structure of Fichte's
  argument.
  },
  keywords = {recognition, Anerkennung, natural-right, intersubjectivity, transcendental, High},
  abstract = {In this paper I present an interpretation of J. G. Fichte's transcendental argument for the necessity of mutual recognition (Anerkennung) in Foundations of Natural Right. Fichte's argument purports to show that, as a condition of the possibility of self-consciousness, we must take ourselves to stand in relations of mutual recognition with other agents like ourselves. After reconstructing the steps of Fichte's argument, I present what I call the ‘modal dilemma’, which highlights a serious ambiguity in Fichte's deduction. According to the modal dilemma, the conclusion to Fichte's transcendental argument—that as a condition of the possibility of our self-consciousness, we must recognize and be recognized by others—expresses either metaphysical or normative necessity. However, no normative conclusion follows from Fichte's premises, and the metaphysical claim that does follow from his argument appears to be implausibly strong. Thus the argument looks like a failure on either interpretation of the conclusion's modality. In the penultimate section of the paper, I propose a new interpretation of the argument that avoids the modal dilemma and provides a normative grounding of Fichte's concept of right.},
  abstract_source = {openalex},
}

@article{mcnulty2016transcendental,
  author = {McNulty, Jacob},
  title = {Transcendental Philosophy and Intersubjectivity: Mutual Recognition as a Condition for the Possibility of Self-Consciousness in Sections 1--3 of {Fichte}'s {Foundations of Natural Right}},
  journal = {European Journal of Philosophy},
  year = {2016},
  volume = {24},
  number = {4},
  pages = {788--810},
  doi = {10.1111/ejop.12131},
  note = {
  CORE ARGUMENT: Defends a new interpretation of Fichte's argument for
  mutual recognition in the opening sections of the Foundations of
  Natural Right, addressing what Nance calls the modal dilemma. McNulty
  argues that the argument relies on a distinctive kind of practical
  necessity: recognizing others is necessary not as a logical condition
  but as a condition of the rational activity of self-positing.

  RELEVANCE: Represents the most sophisticated recent account of the
  transcendental argument connecting self-consciousness, freedom, and
  recognition — the philosophical core of how Fichte grounds right
  independently of moral theory and positions it as a structure
  requiring historical realization.

  POSITION: Recognition-focused, in dialogue with Nance (2012); defends
  a distinctive modal reading that has implications for the normative
  status of right.
  },
  keywords = {recognition, intersubjectivity, transcendental, natural-right, self-consciousness, High},
  abstract = {Abstract In the opening sections of his Foundations of Natural Right , Fichte argues that mutual recognition is a condition for the possibility of self‐consciousness. However, the argument turns on the apparently unconvincing claim that, in the context of transcendental philosophy, conceptions of the subject as an isolated individual give rise to a vicious circle the resolution of which requires the introduction of a second rational being to ‘summon’ the first. In this essay, my aim is to present a revised account of the opening arguments on which they are more convincing. In particular, I argue that the problem of a circle is genuine and may be seen to result from a relation of mutual dependence between agency and cognition which ensures that for an exercise of either capacity to take place, an exercise of the other would have already had to have taken place with the result that neither can occur. Moreover, the solution is successful. The summons (the claim of the other) prevents us from being driven around the circle once more because it is a ‘synthesis’ that reconciles the constraint to which I am subject as a cognizer of independently given objects and my freedom as a self‐determining subject.},
  abstract_source = {openalex},
}

@article{arreseigror2019morality,
  author = {Arrese Igor, Hector Oscar},
  title = {Morality and State in the {Fichtean} Political Philosophy},
  journal = {Araucaria},
  year = {2019},
  number = {41},
  pages = {79--96},
  doi = {10.12795/araucaria.2019.i41.04},
  note = {
  CORE ARGUMENT: Argues that Fichte's philosophy of history in the
  Characteristics of the Present Age (1804/5) is required to resolve
  a fundamental problem in the synchronic Jena theory of right: the
  Foundations of Natural Right cannot guarantee the stability of a
  state composed solely of rationally self-interested individuals,
  because its mechanism of coercive enforcement (the ephorate) requires
  a degree of civic virtue inconsistent with the system's own
  foundational assumptions. The diachronic perspective supplied by the
  philosophy of history enables Fichte to project the resolution of
  this inconsistency into a future epoch of genuine civic solidarity.

  RELEVANCE: This is the most direct treatment of how Fichte's
  philosophy of history is required by the internal structure of his
  political philosophy — exactly the relationship at the center of the
  research project's key questions.

  POSITION: Rupture/tension thesis — the philosophy of history is
  needed to address problems Fichte cannot solve at the synchronic
  level of right.
  },
  keywords = {philosophy-of-history, natural-right, state, morality, continuity, High},
  abstract = {The philosophy of history of 1804 and 1805 enables Fichte to place his natural right, developed previously at Jena, against a diachronic background. This means that Fichte does not reason merely synchronically from a timeless conception of society and state. From a synchronic viewpoint, Fichte cannot solve the problem of the control of political power because he has to draw on the assumption of a virtuous ephorate. This assumption is not consistent with the Fichtean ideal of a philosophy of right completely independent from moral considerations. Thus, the control of government is possible only if at least a group of citizens can go beyond the mere rational egoism. This new temporal conception of the state leads Fichte to think that the problems of consistency of his theory of Jena are unavoidable, given that a society integrated by egoist individuals cannot be sustained. However, his later philosophy of history enables Fichte to state the inexorable annihilation of this type of community and gives place to an ensuing epoch, when citizens are not self-interested anymore.},
  abstract_source = {s2},
}

@article{james2016staatslehre,
  author = {James, David},
  title = {The Political Theology of {Fichte}'s {Staatslehre}: Immanence and Transcendence},
  journal = {British Journal for the History of Philosophy},
  year = {2016},
  volume = {24},
  number = {6},
  pages = {1157--1175},
  doi = {10.1080/09608788.2016.1207611},
  note = {
  CORE ARGUMENT: Examines the late Staatslehre (1813) and its attempt
  to provide a normative-political theory in which the state is charged
  with realizing moral freedom historically. James argues that Fichte
  introduces a concept of transcendence (via the figure of the
  Zwingherr — the "compellor") that implicitly borrows from political
  theology, creating a tension between the immanent logic of right and
  the transcendent necessity of a quasi-providential political
  authority to force historical actualization.

  RELEVANCE: Directly addresses the late period of Fichte's political
  philosophy, where the state takes on a stronger historical-teleological
  role. Illuminates the development from the early Jacobin Fichte
  through the Addresses to the German Nation to the authoritarian
  tendencies of the Staatslehre.

  POSITION: Continuity thesis with qualifications — the late Fichte
  is read as extending the Jena project while introducing new tensions.
  },
  keywords = {Staatslehre, late-fichte, political-theology, state, freedom, High},
  abstract = {Given its use of religious concepts and language, it is tempting to class Fichte’s rarely discussed Staatslehre as a political theology. I argue that the Staatslehre can be classed as a political theology because of the way in which it can be understood in terms of the concepts of immanence and transcendence. The concept of immanence applies to Fichte’s account of history in particular. Fichte himself allows for a moment of transcendence at the very beginning of history. I argue that the concept of transcendence is also implicit in the Staatslehre in relation to some problems faced by Fichte’s own account of the role of the Zwingherr in the historical development and actualization of right and moral freedom, despite his attempt to avoid introducing theologically based explanations of political concepts at this stage of his Staatslehre.},
  abstract_source = {openalex},
}

@article{maliks2025politics,
  author = {Maliks, Reidar},
  title = {Fichte's Politics of Cultural Awakening},
  journal = {Kantian Review},
  year = {2025},
  volume = {30},
  number = {1},
  pages = {29--43},
  doi = {10.1017/s1369415425000159},
  note = {
  CORE ARGUMENT: Argues that Fichte's political philosophy across the
  early-to-late trajectory is unified by a theory of "cultural
  awakening": the state's task is not merely to enforce right but to
  transform citizens into genuinely self-determining rational agents
  capable of sustaining republican institutions. Maliks reads this as
  a coherent extension of the Jena project rather than a nationalist
  departure, connecting the Addresses to the German Nation and the
  Staatslehre back to the Foundations of Natural Right.

  RELEVANCE: Directly addresses the key research question about the
  relationship between the early republican Fichte and the later
  statist/national Fichte. Provides an integrative account that
  challenges the standard rupture narrative.

  POSITION: Continuity thesis — the politics of cultural awakening
  unifies Fichte's practical philosophy from 1793 to 1814.
  },
  keywords = {cultural-awakening, nationalism, republicanism, state, late-fichte, High},
  abstract = {Abstract Although scholars agree that Fichte’s earliest political writings are Kantian, they contain a theory of individual emancipation through a culture of perfection that is foreign to Kant’s Doctrine of Right. I argue that Fichte based his theory on Kant’s moral duty and therefore derived the conclusion that individual morality should be the constitution’s aim. As a result, principles of right are not limited to securing relations of external freedom among equals but concerned with creating a society of autonomous individuals. Reaching that end goes through emancipation both from the oppression of sensibility over rationality and from the false consciousness that upholds voluntary servitude to unjust regimes. As an alternative Kantian path, Fichte provides philosophical grounding for movements seeking political emancipation through cultural awakening.},
  abstract_source = {s2},
}

@article{clarke2011hegel,
  author = {Clarke, James},
  title = {Hegel's Critique of {Fichte} in the 1802/3 Essay on Natural Right},
  journal = {Inquiry},
  year = {2011},
  volume = {54},
  number = {3},
  pages = {207--225},
  doi = {10.1080/0020174x.2011.574998},
  note = {
  CORE ARGUMENT: Reconstructs Hegel's critique of Fichte's Foundations
  of Natural Right in the 1802/3 essay on natural right, arguing that
  Hegel's objection is that Fichte's intersubjective theory of right
  remains "abstract" — it cannot generate genuine ethical life (Sittlichkeit)
  because it treats recognition purely as a formal mechanism rather than
  as constitutive of a concrete community. Clarke evaluates the critique
  as raising a genuine problem for Fichte even if not fully vindicating
  Hegel's alternative.

  RELEVANCE: Clarifies the philosophical stakes in the transition from
  Fichte's theory of right to later German idealist philosophy of the
  state; places Fichte's account of right and recognition in a critical
  philosophical dialogue that illuminates its limits.

  POSITION: Critical of the Jena theory's abstractness from a Hegelian
  standpoint; important interlocutor for the Fichte-Hegel transition.
  },
  keywords = {Hegel, natural-right, recognition, critique, ethical-life, Medium},
  abstract = {Abstract This paper provides a reconstruction and critical assessment of Hegel's critique of Fichte's political philosophy in his 1802/3 essay On the Scientific Ways of Treating Natural Right. I argue that Hegel's critique, while not entirely successful, raises a serious problem for Fichte's political philosophy as presented in the 1796/7 Foundations of Natural Right.},
  abstract_source = {openalex},
}

@article{clarke2009fichte,
  author = {Clarke, James Alexander},
  title = {Fichte and {Hegel} on Recognition},
  journal = {British Journal for the History of Philosophy},
  year = {2009},
  volume = {17},
  number = {2},
  pages = {365--385},
  doi = {10.1080/09608780902761745},
  note = {
  CORE ARGUMENT: Contrasts Fichte's account of recognition in the
  Foundations of Natural Right with Hegel's in the 1802/3 System of
  Ethical Life. Argues that Fichte's recognition is instrumental and
  normatively thin — it is a mutual acknowledgment of rights without
  moral content — whereas Hegel demands that recognition also constitute
  an attitude of moral regard. Clarke defends the significance of this
  difference for the philosophy of right and ethical life.

  RELEVANCE: Provides a careful comparison of Fichte and Hegel on
  recognition that situates Fichte's theory in the tradition and
  clarifies what is at stake in the move from right to ethical life.

  POSITION: Fichte-Hegel comparative framework, emphasizing the
  distinction between legal and moral recognition.
  },
  keywords = {recognition, Hegel, right, ethical-life, intersubjectivity, Medium},
  abstract = {In this paper I provide an interpretation of Hegel’s account of ‘recognition’ (Anerkennung) in the 1802-3 System of Ethical Life as a critique of Fichte’s account of recognition in the 1796-7 Foundations of Natural Right. In the first three sections of the paper I argue that Fichte’s account of recognition in the domain of right is not concerned with recognition as a moral attitude. I then turn, in section four, to a discussion of Hegel’s critique and transformation of Fichte’s conception of recognition. Hegel’s transformation consists, I argue, in the claim that a comprehensive account of recognition in the domain of right must be concerned with recognition as a moral attitude.},
  abstract_source = {openalex},
}

@article{nance2019property,
  author = {Nance, Michael},
  title = {Property and Economic Planning in {Fichte}'s Contractualism},
  journal = {European Journal of Philosophy},
  year = {2019},
  volume = {27},
  number = {3},
  pages = {643--660},
  doi = {10.1111/ejop.12446},
  note = {
  CORE ARGUMENT: Reconstructs Fichte's theory of property across the
  Foundations of Natural Right and the Closed Commercial State, arguing
  that Fichte's republicanism commits him to rejecting both classical
  liberal property rights and a market economy. The state is required
  to enforce an economic plan as a condition of ensuring that every
  citizen has guaranteed access to the property needed for free agency.

  RELEVANCE: Links the theory of right in the FNR to the political
  economy of the Closed Commercial State, showing how the normative
  foundations of Fichte's state commit it to economic planning as a
  condition for freedom's realization.

  POSITION: Property-focused reading of Fichte's contractualism,
  emphasizing the statist implications of the theory of right.
  },
  keywords = {property, political-economy, closed-commercial-state, contractualism, state, Medium},
  abstract = {Abstract My paper reconstructs Fichte's property theory and political economy in Foundations of Natural Right and The Closed Commercial State . Fichte's theory of property requires the rejection of the classical liberal theory of property rights. Fichte's alternative theory of property, in conjunction with his republican account of the state's role in guaranteeing individual rights, further requires the rejection of a market economy in favor of a planned economy. For Fichte's view entails the normative necessity of a political economy in which the production and transfer of goods and services, across large sectors of the economy, are mandated by the state in advance in accordance with an economic plan. As a result, Fichte reconceives his contractualism as necessarily including the negotiation of a state‐enforced plan for economic activity. Thus, Fichte's new theory of property in Foundations of Natural Right has extremely wide‐ranging implications for the rest of his political and economic thought. The negotiation of fair terms of political association characteristic of classical contractualist thought becomes in Fichte's hands the negotiation of an economic plan that defines each individual's socioeconomic rights. I conclude with some brief remarks on the sense in which Fichte's theory serves as a cautionary tale for later socialists.},
  abstract_source = {openalex},
}

@article{alessiato2021striving,
  author = {Alessiato, Elena Paola Carola},
  title = {Striving for Freedom. Some Notes about {Fichte}'s Idealism},
  journal = {Ethics in Progress},
  year = {2021},
  volume = {12},
  number = {2},
  pages = {46--60},
  doi = {10.14746/eip.2021.2.4},
  note = {
  CORE ARGUMENT: Analyzes freedom in Fichte's idealism across
  transcendental, moral, and social-historical registers. Starting from
  the Tathandlung, traces how freedom as infinite striving (Streben)
  connects the I's transcendental self-positing with moral activity in
  the world and with the social goal of a free community. Argues for
  the unity of Fichte's system as a philosophy in which individual
  freedom and the historical goal of rational community are internally
  related.

  RELEVANCE: Provides a synoptic account of freedom's multiple
  dimensions in Fichte — from the foundational Wissenschaftslehre to
  ethics and social philosophy — connecting the theoretical and
  practical aspects that bear on the philosophy of history question.

  POSITION: Unitary-system reading that connects Fichte's
  transcendental idealism to its practical and historical dimensions.
  },
  keywords = {freedom, striving, idealism, Tathandlung, moral-philosophy, Medium},
  abstract = {Moving from Fichte’s assumption that “the essence of the I is its activity”, this paper tries to analyze the meaning and implications of the idea of “activity” [Tathandlung] in order to explicate the peculiarities of Fichte’s critical, transcendental, and moral idealism. Fichte’s idea of activity will be examined with reference to such basic concepts as collision [Anstoss], interaction [Wechselwirkung], inter-determination [Wechselbestimmung], and striving [Streben]. However, it is freedom which frames and connects the core components of Fichte’s thinking and sets up the goal of his philosophy of action. What freedom accounts for, can be identified both at the transcendental level, in the internal dynamic of infinity and finitude constituting the subjectivity of the I, and at the moral and social levels of Fichte’s thought, as the goal of the human action in history and in the society. In assuming the unitary character of Fichte’s philosophical system, concluding remarks are developed concerning the moral meaning of the act of striving for freedom and, conversely, the immorality of attitudes and feelings such as fear, resignation, and fatigue.},
  abstract_source = {s2},
}

@article{james2010reappraisal,
  author = {James, David},
  title = {Fichte's Reappraisal of {Kant}'s Theory of Cosmopolitan Right},
  journal = {History of European Ideas},
  year = {2010},
  volume = {36},
  number = {1},
  pages = {61--70},
  doi = {10.1016/j.histeuroideas.2009.07.003},
  note = {
  CORE ARGUMENT: Argues that Fichte's Closed Commercial State is best
  understood as a critique and revision of Kant's cosmopolitan right.
  Whereas Kant permits commercial interaction among states as a form of
  cosmopolitan hospitality, Fichte argues that asymmetric economic
  dependence generated by free trade undermines genuine political
  independence. The closed commercial state is therefore Fichte's
  answer to the problem of how to preserve state sovereignty as a
  condition of freedom in an interconnected world.

  RELEVANCE: Clarifies the political-philosophical motivation for the
  Closed Commercial State by situating it in relation to Kant's
  international political philosophy, revealing how economic autarchy
  is a consequence of Fichte's commitment to right-based freedom.

  POSITION: Places the Closed Commercial State in Kant-Fichte
  continuity/contrast framework regarding cosmopolitan right.
  },
  keywords = {closed-commercial-state, Kant, cosmopolitan-right, international, sovereignty, Medium},
  abstract = {I argue that although in the Foundations of Natural Right Fichte adopts a theory of cosmopolitan right that is in a number of important respects formally identical to the one developed by Kant, he later came in The Closed Commercial State to reassess his earlier Kantian cosmopolitanism. This work can in fact be seen to identify a problem with Kant's cosmopolitanism, namely, Kant's failure to recognize the possibility of an indirect form of coercion based on unequal relations of economic dependence. I argue that Kant's failure to acknowledge such a possibility stems from his uncritical acceptance of this type of relation. Whereas Fichte's awareness of the possibility of one-sided forms of economic dependence leads him to offer a solution to the problems it raises: the severing of all commercial relations with other states. This solution is itself highly problematic, however, as I indicate with reference to Fichte's remarks on ‘natural frontiers’.},
  abstract_source = {openalex},
}

@article{ramsauer2023thinking,
  author = {Ramsauer, Laurenz},
  title = {Between Thinking and Acting: {Fichte}'s Deduction of the Concept of Right},
  journal = {Manuscrito},
  year = {2023},
  volume = {46},
  number = {2},
  pages = {156--197},
  doi = {10.1590/0100-6045.2023.v46n2.lr},
  note = {
  CORE ARGUMENT: Provides a careful reconstruction of Fichte's
  a priori deduction of the concept of right in the Foundations of
  Natural Right, emphasizing the move from pure self-positing activity
  to the practical necessity of limiting one's freedom in light of
  others. Argues that Fichte's deduction generates a genuinely
  non-moral normativity of right — obligation arises from the
  conditions of agency itself, not from the moral law.

  RELEVANCE: Illuminates the philosophical foundations of Fichte's
  theory of right as an independent systematic domain, clarifying what
  kind of normativity is at stake when freedom is institutionalized
  through legal and political structures in history.

  POSITION: Analytical reconstruction of the FNR's deductive
  structure, arguing for right's independence from morality.
  },
  keywords = {natural-right, deduction, normativity, agency, right, Medium},
  abstract = {: Fichte’s ambitious project in the Foundations of Natural Right is to provide an a priori deduction of the concept of right independently from morality. So far, interpretations of Fichte’s deduction of the concept of right have persistently fallen into one of two rough categories: either they (re)interpret the normative necessity of right in terms of moral or quasi-moral normativity or they interpret right’s normative necessity in terms of hypothetical imperatives. However, each of these interpretations faces significant exegetical difficulties. By contrast, I argue that we can  I am grateful to the participants of the University of Chicago’s German Philosophy Workshop for their helpful feedback on an earlier draft of this paper. Special thanks are owed to Matthias Haase, whose insightful feedback has helped me immensely thinking through this topic.},
  abstract_source = {s2},
}

@incollection{bradley2025incomplete,
  author = {Bradley, J. Colin},
  title = {Fichte's Incomplete Republicanism},
  booktitle = {Kant's Early Followers in Political Philosophy},
  year = {2025},
  pages = {47--68},
  doi = {10.4324/9781003516545-4},
  note = {
  CORE ARGUMENT: Characterizes Fichte's political philosophy as an
  "incomplete republicanism" — a theory that commits to republican
  principles of collective self-governance and the rule of law but
  cannot fully realize them within its own theoretical resources.
  Bradley traces the incompleteness to the structural tension between
  the theory of right's formalism and the concrete institutional
  demands of self-governing republics, which the philosophy of history
  is intended to address.

  RELEVANCE: Directly addresses the developmental question of how
  Fichte's early republican commitments relate to his later statist
  views, framing the trajectory as an attempt (never fully achieved)
  to complete a republican political philosophy.

  POSITION: Tension thesis with continuity elements — republicanism
  is incomplete but remains the animating goal throughout.
  },
  keywords = {republicanism, political-philosophy, right, state, development, Medium},
  abstract = {Despite obvious similarities, Kant's and Fichte's philosophies of right contain sharply different understandings of the inadequacy of the state of nature and the basic justification for a coercive state. Both argue that rights in a state of nature are “provisional” or “incomplete” and that a coercive republic is necessary to guarantee freedom for people who cannot help interacting with one another. But for Fichte, the problem with the state of nature is that we cannot trust one another to protect our rights, whereas for Kant the problem is that no private person has the authority to enforce her rights over others. This chapter argues that Fichte's focus on trust prevents him from developing a consistently republican position that the state and rule of law really are necessary for freedom. Fichte is unable to explain why coercion is a necessary part of right, and so, from Kant's perspective, Fichte's Foundations of Natural Right fails to constitute a philosophy of right at all.},
  abstract_source = {openalex},
}

@book{williams1992recognition,
  author = {Williams, Robert R.},
  title = {Recognition: {Fichte} and {Hegel} on the Other},
  year = {1992},
  publisher = {State University of New York Press},
  note = {
  CORE ARGUMENT: Examines the concept of recognition (Anerkennung) in
  Fichte and Hegel as the foundational structure of intersubjectivity
  and ethical life. Williams argues that Fichte's account of the summons
  (Aufforderung) in the Foundations of Natural Right introduces a
  genuinely other-directed conception of the self that precedes and
  shapes both Hegel's dialectic of recognition and modern recognition
  theory.

  RELEVANCE: Provides the philosophical context for the recognition
  debate in Fichte scholarship; situates the FNR within the broader
  trajectory from Fichte to Hegel and establishes that mutual
  recognition is both a transcendental condition and a normative ideal
  whose historical realization is the task of practical philosophy.

  POSITION: Foundational account of recognition in German idealism;
  emphasizes continuity and mutual influence between Fichte and Hegel.
  },
  keywords = {recognition, Anerkennung, Hegel, intersubjectivity, other, Low, INCOMPLETE, no-abstract}
}
