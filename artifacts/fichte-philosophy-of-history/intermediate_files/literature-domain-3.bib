@article{gaudio2021people,
  author = {Gaudio, Mariano},
  title = {People, Nation, State: The Ground in {Fichte}'s {Addresses}},
  journal = {Comparative and Continental Philosophy},
  year = {2021},
  volume = {13},
  number = {1},
  pages = {75--87},
  doi = {10.1080/17570638.2021.1915110},
  note = {
  CORE ARGUMENT: Gaudio analyzes which concept — people (Volk), nation, or
  state — functions as the foundational ground in the Addresses. He argues
  that despite the text's emphasis on nation and language, it is ultimately
  the rational state (as developed in the Grundlage des Naturrechts) that
  provides the necessary ground for education, people, and nation: without
  the state's institutional framework, Fichte's educational programme cannot
  be realized.

  RELEVANCE: Directly addresses the project's question about the structural
  role of the nation in Fichte's historical vision and its relation to
  Nationalerziehung, while foregrounding the continuity between the Addresses
  and the political philosophy.

  POSITION: Systematic-reconstructive; draws on Comparative and Continental
  Philosophy traditions.
  },
  keywords = {fichte, nation, state, people, education, philosophy-of-history, Medium},
  abstract = {ABSTRACT In Fichte’s Addresses to the German Nation (1807–8), one important issue is which of the concepts works as a foundation for the others. People, nation, language, state, or education are all possible candidates to take a central place. First, this paper analyzes the problems presented by the notions of “people” and “nation,” such as their ambiguous and even contradictory aspects. Second, we focus on how the concept of education needs a solid ground from which an educational plan can develop. Finally, we show that the fundamental concept of Fichte’s Addresses is the same one as in his Natural Right: the State. According to Fichte, only the rational State can guarantee the realization of education, people, and nation.},
  abstract_source = {s2},
}

