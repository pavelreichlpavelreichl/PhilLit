    {
      "openalex_id": "W4323647945",
      "doi": "10.1051/shsconf/202316102001",
      "title": "Kant\u2019s philosophy as the development of the intentions of enlightenment",
      "authors": [
        {
          "name": "\u041b. \u0410. \u041a\u0430\u043b\u0438\u043d\u043d\u0438\u043a\u043e\u0432",
