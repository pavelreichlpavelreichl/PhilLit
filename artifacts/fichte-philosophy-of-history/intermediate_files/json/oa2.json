      "openalex_id": "W4327555414",
      "doi": "10.1080/21692327.2023.2188243",
      "title": "Hegel\u2019s vanity. Schelling\u2019s early critique of absolute idealism",
      "authors": [
        {
          "name": "Juan Jos\u00e9 Rodr\u00edguez",
          "openalex_id": "A5086533843",
          "orcid": "https://orcid.org/0000-0002-1585-3992",
