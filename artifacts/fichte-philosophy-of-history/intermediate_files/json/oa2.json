      "title": "Fichte and Schelling : the Spinoza connection",
      "authors": [
        {
          "name": "Alexandre Anselmo Guilherme",
          "openalex_id": "A5002103035",
          "orcid": "https://orcid.org/0000-0003-4578-1894"
