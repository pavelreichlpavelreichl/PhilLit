        {
          "name": "\u0421\u0435\u0440\u0433\u0435\u0439 \u0410\u043d\u0430\u0442\u043e\u043b\u044c\u0435\u0432\u0438\u0447 \u041d\u0438\u043a\u043e\u043b\u044c\u0441\u043a\u0438\u0439",
