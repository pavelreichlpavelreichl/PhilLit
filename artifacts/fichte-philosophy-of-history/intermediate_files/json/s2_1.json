    {
      "paperId": "5f60f086c1832a7bbfa281f257cd6426bc797620",
      "title": "The relevance of J.G.Fichte\u2019s Wissenschaftslehre (towards the 260th anniversary of the thinker\u2019s birth)",
      "authors": [
        {
