      "openalex_id": "W4210780326",
      "doi": "10.18662/po/13.1/382",
      "title": "Musical Performance in the Age of Postmodernism",
      "authors": [
        {
          "name": "Gabriella Astalosh",
          "openalex_id": "A5077500622",
          "orcid": "https://orcid.org/0000-0002-5539-2713",
          "institutions": [
            "Lviv National Musical Academy named after Mykola Lysenko",
