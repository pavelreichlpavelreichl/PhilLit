    {
      "openalex_id": "W3034703146",
      "doi": "10.1007/s10739-020-09609-2",
      "title": "Axiomatic Natural Philosophy and the Emergence of Biology as a Science",
      "authors": [
        {
          "name": "Hein van den Berg",
