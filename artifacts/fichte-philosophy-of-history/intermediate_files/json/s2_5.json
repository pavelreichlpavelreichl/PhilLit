    {
      "paperId": "ace8a8d910c1667f3c30b6b2933558cec4b387f9",
      "title": "\u201cThe Letter Kills, but the Spirit Gives Life\u201d: Letters on the Spirit and the Letter of Hegel's Philosophy",
