    {
      "openalex_id": "W4213287863",
      "doi": "10.1093/oso/9780198868705.001.0001",
      "title": "The Practical Origins of Ideas",
      "authors": [
        {
          "name": "Matthieu Queloz",
          "openalex_id": "A5075238146",
          "orcid": "https://orcid.org/0000-0001-6644-9992",
          "institutions": [
