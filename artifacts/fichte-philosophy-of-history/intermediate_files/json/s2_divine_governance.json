    {
      "paperId": "7ae7f0184b8e979bbfe89418667a0c4537011700",
      "title": "\u0642\u0631\u0622\u0646 \u06a9\u0627 \u0646\u0638\u0631\u06cc\u06c1 \u0639\u0645\u0648\u0645\u0650 \u0631\u0633\u0627\u0644\u062a: \u0628\u062f\u06be \u0645\u062a \u06a9\u0627 \u062a\u062c\u0632\u06cc\u0627\u062a\u06cc \u0645\u0637\u0627\u0644\u0639\u06c1",
      "authors": [
        {
          "name": "Qazi Raza Ahmed Qureshi",
          "authorId": "2424216861"
