      "openalex_id": "W2767975435",
      "doi": null,
      "title": "Hegel on Indian Philosophy: Spinozism, Romanticism, Eurocentrism",
      "authors": [
        {
          "name": "Gino Signoracci",
          "openalex_id": "A5086093277"
