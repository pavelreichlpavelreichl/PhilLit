      "openalex_id": "W4388664254",
      "doi": "10.4324/9781003439745",
      "title": "The Concept of Property in Kant, Fichte, and Hegel",
      "authors": [
        {
          "name": "Jacob Blumenfeld",
          "openalex_id": "A5032699701",
          "orcid": "https://orcid.org/0000-0001-7745-8704",
