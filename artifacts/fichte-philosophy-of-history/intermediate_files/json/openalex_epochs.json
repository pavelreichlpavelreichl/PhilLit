    {
      "openalex_id": "W3086083296",
      "doi": "10.3846/jau.2020.13053",
      "title": "ARCHITECTURAL MEMORY AND FORMS OF ITS EXISTENCE",
      "authors": [
        {
          "name": "\u041e\u043b\u0435\u043d\u0430 \u0420\u0435\u043c\u0456\u0437\u043e\u0432\u0430",
