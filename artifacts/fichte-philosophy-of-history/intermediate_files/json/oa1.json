      "openalex_id": "W2907926696",
      "doi": "10.4000/ref.952",
      "title": "The Imagination in Kant and Fichte",
      "authors": [
        {
          "name": "Virginia L\u00f3pez-Dom\u00ednguez",
          "openalex_id": "A5110985097"
