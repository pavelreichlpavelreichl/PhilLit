    {
      "openalex_id": "W1988874653",
      "doi": "10.1080/00201740802120731",
      "title": "Fichte's Fictions Revisited",
      "authors": [
        {
          "name": "Benjamin D. Crowe",
          "openalex_id": "A5038391672",
          "institutions": [
