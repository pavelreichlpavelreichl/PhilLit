    {
      "openalex_id": "W2323728376",
      "doi": "10.1111/phpr.12286",
      "title": "Fichte on Conscience",
      "authors": [
        {
          "name": "Owen Ware",
          "openalex_id": "A5012872507",
          "orcid": "https://orcid.org/0000-0001-6480-6423",
          "institutions": [
