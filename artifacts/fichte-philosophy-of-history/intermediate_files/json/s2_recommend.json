      "venue": "St. Tikhons' University Review"
    },
    {
      "paperId": "23c3242d8370123523e0f2285b0679e2b08132ff",
      "title": "Romantic Idealism v/s Modern Realism: Nature in Wordsworth and Frost",
      "authors": [
