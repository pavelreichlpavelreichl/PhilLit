  POSITION: Pluralist collection; represents both sympathetic-reconstructive
  and critical-reception perspectives.
  },
  keywords = {fichte, addresses-german-nation, nationalism, education, language, reception, High, INCOMPLETE, no-abstract}
}

@article{martyn1997borrowed,
  author = {Martyn, David},
  title = {Borrowed Fatherland: Nationalism and Language Purism in {Fichte}'s {Addresses} to the {German Nation}},
  journal = {The Germanic Review: Literature, Culture, Theory},
  year = {1997},
  volume = {72},
  number = {4},
  pages = {303--315},
  doi = {10.1080/00168899709597352},
  note = {
  CORE ARGUMENT: Martyn argues that Fichte's nationalist appeal to a pure
  German language is paradoxical: the Addresses themselves are written in
  a German shaped by foreign borrowings and rhetorical conventions, making
  the national idiom Fichte champions a "borrowed fatherland." This
  deconstruction reveals an internal contradiction in the linguistic theory
  of nationalism — the very vehicle of Fichte's argument undermines the
  organic purity it asserts.

  RELEVANCE: Offers a critical counter-reading to the cosmopolitan
  interpretations of Fichte's language theory, showing that the Urvolk
  concept's claims to linguistic purity are destabilized by close attention
  to the rhetorical texture of the Addresses themselves. Relevant to the
  project's treatment of language and historical mission.

  POSITION: Critical / deconstructive reading; Germanic literature and
  cultural theory perspective.
  },
  keywords = {fichte, language, urvolk, nationalism, purism, High},
  abstract = {(1997). Borrowed Fatherland: Nationalism and Language Purism in Fichte's Addresses to the German Nation. The Germanic Review: Literature, Culture, Theory: Vol. 72, No. 4, pp. 303-315.},
  abstract_source = {openalex},
}

@incollection{james2019concept,
  author = {James, David},
  title = {Fichte's Concept of the Nation},
  booktitle = {Palgrave Handbooks in {German} Idealism},
  publisher = {Springer International Publishing},
  year = {2019},
  pages = {353--372},
  doi = {10.1007/978-3-030-26508-3_16},
  note = {
  CORE ARGUMENT: James provides a systematic account of how Fichte's concept
