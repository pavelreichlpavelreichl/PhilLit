@article{bykova2025hegel,
  author = {Bykova, Marina},
  title = {On the Real Content of Hegel's Philosophy of History: An Attempt at Demystification},
  journal = {Istoriko-filosofskij ezhegodnik},
  year = {2025},
  volume = {40},
  pages = {175},
  doi = {10.21146/0134-8655-2025-40-175-221},
  note = {
  CORE ARGUMENT: Bykova argues that Hegel's philosophy of history is systematically misread through the lens of determinism and fatalism. Key concepts -- the "cunning of Reason," the "march of Spirit," the "end of history" -- do not imply metaphysical determinism but rather a dynamic framework in which freedom is both the process and the goal of historical development. Historical development is neither mechanistically predetermined nor externally imposed; it unfolds through the interaction of particular actors.

  RELEVANCE: Provides a contemporary philosophical account of Hegel's philosophy of history that is useful as a contrast term for assessing how far Fichte's a priori framework anticipates or differs from Hegel's. The distinction between Hegel's dynamic framework and any determinist reading helps clarify what makes Hegel's account genuinely "developmental" in a way Fichte's may not be.

  POSITION: Defends a non-determinist, freedom-centered reading of Hegel's philosophy of history, which complicates the standard forerunner narrative by showing Hegel's approach is more open-ended than commonly assumed.
  },
  keywords = {Hegel, philosophy-of-history, Spirit, freedom, cunning-of-reason, Low},
  abstract = {Hegel’s philosophy of history is often misinterpreted through the lens of determinism, providentialism, or teleology, leading to widespread misconceptions about the true significance of his understanding of history. Such Hegelian concepts as the “cunning of Reason” (List der Vernunft), the “march of Spirit in history” (Der Gang des Geistes in der Geschichte), and the so-called “end of history” are frequently misread as implying an external goal and as asserting external control over historical events, a fixed historical trajectory, or a predetermined conclusion to human development. This article seeks to clarify the actual role of these concepts in Hegel’s philosophy of history and correct such distortions. Hegel conceives history as a rational and necessary process emerging from the concrete actions of individuals and nations, through which the World Spirit (Weltgeist) progressively attains self-consciousness and freedom. Historical development is neither mechanistically predetermined nor imposed from outside; it unfolds through the interaction of particular actors, each contributing to the realization of freedom. Hegel’s philosophical analysis reveals the rational structure of historical processes without reducing them to fatalism or metaphysical determinism. By examining the “cunning of Reason,” the “march of Spirit in history,” and the philosophical notion of the “end of history,” the article demonstrates how Hegel reconciles human agency with the rational logic of history. His philosophy of history thus presents a dynamic framework in which freedom is both the process and the goal, offering insightful understanding into the structure and meaning of historical development.},
  abstract_source = {s2},
}

@article{phillips2025protofascist,
  author = {Phillips, Rory Lawrence},
  title = {Was Fichte a Proto-Fascist?},
  journal = {The European Legacy},
  year = {2025},
  volume = {30},
  number = {5},
  pages = {539--558},
  doi = {10.1080/10848770.2025.2500229},
  note = {
  CORE ARGUMENT: Phillips examines the NS appropriation of Fichte --- the
  most discussed episode in the reception history of his political philosophy
  --- through the lens of recent scholarship on fascism (Griffin, Eatwell,
  Sternhell). Analyzing Fichte's views on political economy, nationhood, and
  anti-Semitism, he concludes that Fichte was not a proto-fascist: his
  thought lacks the palingenetic ultranationalist core definitive of fascism,
  though specific rhetorical features did prove attractive to fascists.

  RELEVANCE: Directly addresses the most politically charged question in
  Fichte reception --- the degree to which his philosophy of history and
  national pedagogy prepared the ground for National Socialism. The paper
  distinguishes Fichte's actual arguments from their later instrumentalization,
  which is central to any assessment of his philosophy of history.

  POSITION: Revisionist rehabilitation against the proto-fascist charge,
  using empirical fascism studies rather than purely textual exegesis.
  },
  keywords = {reception-history, nationalism, proto-fascism, NS-appropriation, High}
}

@article{nomer2005socialism,
  author = {Nomer, Nedim},
  title = {Fichte and the Idea of Liberal Socialism},
  journal = {Journal of Political Philosophy},
  year = {2005},
  volume = {13},
  number = {1},
  pages = {53--73},
  doi = {10.1111/j.1467-9760.2005.00213.x},
  note = {
  CORE ARGUMENT: Nomer argues that Fichte's political philosophy occupies
  an original position between liberalism and socialism, anticipating what
  Nomer calls "liberal socialism": a commitment to individual rights and
  freedom that simultaneously requires substantial state intervention to
  guarantee the economic conditions for the exercise of those rights. This
  reading challenges both the collectivist-statist charge and purely liberal
  domestications of Fichte.

  RELEVANCE: Addresses the critical objection that Fichte's statism is
  incompatible with liberal values, by showing that his economic interventionism
  is motivated by liberal premises about rational self-determination rather
  than collectivist subordination of the individual to the state.

  POSITION: Revisionist liberal reading: rehabilitates Fichte against the
  anti-liberal and proto-totalitarian charges.
  },
  keywords = {liberalism, socialism, political-economy, statism, Fichte, Medium}
}

@article{ries2018mythos,
  author = {Ries, Klaus},
  title = {Mythos Fichte: Die Reden an die deutsche Nation als universalistischer Appell},
  journal = {Fichte-Studien},
  year = {2018},
  volume = {45},
  number = {1},
  pages = {242--266},
  doi = {10.1163/18795811_04501013},
  note = {
  CORE ARGUMENT: Ries reconstructs how the "Mythos Fichte" --- the image
  of Fichte as Prussian nationalist and prophet of German greatness ---
  was constructed historically: written for spiritual and political rebirth
  after 1806-07, the Reden were initially set aside, then instrumentalized
  under Bismarck's Reich, and only then became the founding text of pan-German
  nationalism. Ries argues the actual content of the Addresses is a
  universalist appeal grounded in Enlightenment values.

  RELEVANCE: Key reception-history paper directly relevant to the question
  of how Fichte's philosophy of history was instrumentalized by nationalist
  movements. Distinguishes between Fichte's intentions and subsequent mythologization.

  POSITION: Reception-history and rehabilitative: deconstructs the nationalist
  myth by historical analysis of the text's afterlife.
  },
  keywords = {reception-history, nationalism, Reden, myth, German-idealism, Medium}
}

@article{benyehoshua2025germanness,
  author = {Ben-Yehoshua, Jo{\"e}l},
