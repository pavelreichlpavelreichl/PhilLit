}

@article{williams1973base,
  author    = {Williams, Raymond},
  title     = {Base and Superstructure in Marxist Cultural Theory},
  journal   = {New Left Review},
  year      = {1973},
  volume    = {1},
  number    = {82},
  pages     = {3--16},
  doi       = {10.64590/vvo},
  note      = {
  CORE ARGUMENT: Williams argues that the base/superstructure metaphor,
  as conventionally read, is a misleading simplification. He proposes
  replacing the static, reductive reading with a dynamic model of
  "determination" as the setting of limits and the exerting of pressures,
  and introduces the concepts of "dominant," "residual," and "emergent"
  cultural formations to capture the complexity of the relation between
  economic activity and cultural life.

  RELEVANCE: Provides the most widely cited reformulation of the
  base/superstructure metaphor within Western Marxism, directly relevant to
  the question of how superstructural elements are causally related to
  economic base. Represents a humanist-culturalist alternative to
  Althusserian structuralism and to economistic reductions.

  POSITION: Western Marxism; relative autonomy; cultural materialism;
  critique of economistic base/superstructure.
  },
  keywords  = {base-superstructure, relative-autonomy, cultural-theory, Western-Marxism, High},
  abstract = {Any modern approach to a Marxist theory of culture must begin by considering the proposition of a determining base and a determined superstructure. From a strictly theoretical point of view this is not, in fact, where we might choose to begin. It would be in many ways preferable . . .},
  abstract_source = {openalex},
}

@article{honderich1982teleological,
  author    = {Honderich, Ted},
  title     = {Against Teleological Historical Materialism},
  journal   = {Inquiry},
  year      = {1982},
  volume    = {25},
  number    = {4},
  pages     = {451--469},
  doi       = {10.1080/00201748208601980},
  note      = {
  CORE ARGUMENT: Honderich argues that historical materialism, including
  Cohen's reconstruction, is committed to a teleological explanation of
  historical development -- one that explains earlier events by later
  outcomes -- and that this commitment is philosophically untenable. He
  contends that the functional explanations central to Cohen's defense
  covertly reintroduce teleology, and that no available non-teleological
  reconstruction succeeds.

  RELEVANCE: Directly addresses the teleology question: whether a
  scientifically respectable historical materialism can avoid commitment to
  historical inevitability. Provides the sharpest philosophical critique of
  Cohen's functional explanation strategy, published in the same journal as
  Cohen's reply.

  POSITION: Critical; anti-teleological; challenges the coherence of
  functionalist reconstruction of historical materialism.
  },
  keywords  = {teleology, functional-explanation, critique-of-Cohen, historical-materialism, High},
  abstract = {Marx may be taken to hold that productive forces (e.g. the steam engine) explain productive relations (e.g. capitalism) more than the other way on, and that productive relations explain superstructures (e.g. the legal system) more than the other way on. There are no satisfactory standard causal understandings of these claims about explanatory primacy. That is, no standard causal understanding saves Marx from the traditional objection that relations very greatly affect forces, and superstructures very greatly affect relations. One satisfactorily articulated attempt to save Marx has been the attempt to understand the claims teleologically. Three such understandings can be distinguished, but they do not work. The first fails since it attempts to explain events by way of abstract objects. The second fails since it attempts to explain a thing by means of that thing. The third fails for a related reason. Each understanding also fails for another reason as fundamental. So‐called teleological explanations are in fact claims that standard causal explanations exist, which relevant explanations conflict with the ruling idea of Marx's philosophy, that history is somehow independent of men's consciousness and wills. There may be no evidence that Marx himself intended historical materialism to be understood teleologically. There may be evidence against.},
  abstract_source = {openalex},
}

@article{cohen1982functional,
  author    = {Cohen, G. A.},
  title     = {Functional Explanation, Consequence Explanation, and Marxism},
  journal   = {Inquiry},
  year      = {1982},
  volume    = {25},
  number    = {1},
  pages     = {27--56},
  doi       = {10.1080/00201748208601953},
  note      = {
  CORE ARGUMENT: Cohen defends the legitimacy of functional explanation
  in historical materialism by distinguishing "consequence explanation"
  (where the fact that X has effect Y explains X's occurrence) from
  standard causal explanation. He argues that Marx employs consequence
  explanations that are scientifically respectable even without specifying
  the mechanism, and responds to critics who demand such specification by
  pointing to analogous practices in evolutionary biology.

  RELEVANCE: Cohen's principal defense of the explanatory methodology of
  KMTH, directly responding to the teleology objection. Essential for
  understanding how the primacy thesis was defended in the 1980s debate
  and how functional explanation was positioned against teleological
  readings.

  POSITION: Analytical Marxism; functionalism; defense of consequence
  explanation in historical materialism.
  },
  keywords  = {functional-explanation, consequence-explanation, analytical-marxism, teleology, High},
  abstract = {I argued in Karl Marx's Theory of History that the central claims of historical materialism are functional explanations, and I said that functional explanations are consequence explanations, ones, that is, in which something is explained by its propensity to have a certain kind of effect. I also claimed that the theory of chance variation and natural selection sustains functional explanations, and hence consequence explanations, of organismic equipment. In Section I I defend the thesis that historical materialism offers functional or consequence explanations, and I reject Jon Elster's contention that game theory can, and should, assume a central role in the Marxist theory of society. In Section II I contrast functional and consequence explanation, thereby revising the position of Karl Marx's Theory of History, and I question whether evolutionary biology supports functional explanations. Section III is a critique of Elster's views on functional explanation, and Sections IV and V defend consequence explanation against metaphysical and epistemological doubts. A concluding section summarizes my present understanding of the status of historical materialist explanations.},
  abstract_source = {openalex},
}

@article{carling1993analytical,
  author    = {Carling, Alan},
  title     = {Analytical Marxism and Historical Materialism: The Debate on Social Evolution},
  journal   = {Science \& Society},
  year      = {1993},
  volume    = {57},
  number    = {1},
  pages     = {31--65},
  doi       = {10.1177/003682379305700103},
  note      = {
  CORE ARGUMENT: Carling surveys the debate between analytical Marxists
  (Cohen, Roemer, Elster) and their critics on the question of social
  evolution: whether historical materialism is committed to a unilinear
  developmental sequence, whether game-theoretic reconstructions of class
  struggle are compatible with Marx's framework, and whether the functional
  explanation strategy can be defended. He identifies the key fault lines
  and assesses the state of the debate after a decade of intensive
  argument.

  RELEVANCE: Provides a comprehensive analytical map of the debates this
  domain addresses -- forces vs. relations, teleology vs. non-teleological
  reconstruction, and the coherence of historical materialism as a research
  program. Situates Cohen, Brenner, Elster, and Wood in relation to each
  other.

  POSITION: Analytical survey; maps the analytical Marxism/social
  relations debate; broadly sympathetic to the analytical program.
  },
  keywords  = {analytical-marxism, social-evolution, debate-survey, forces-vs-relations, Medium},
  abstract = {Darwinian evolutionary theory marries a genetic account of the origin of species to a selectionist account of their subsequent fate. The Marxian theory of history is analogous: class struggle provides an account of the origins of new regimes of production and selection pressures explain their subsequent history. The theory is technologically determinist, but there are three distinct doctrines ascribing primacy in different ways to the technological forces of production over the social relations of production. Natural Primacy is probably true but of limited relevance to the debate about historical process. Intentional Primacy, as advocated by G. A. Cohen, is untenable. Competitive Primacy is a genuinely evolutionary doctrine that may even be true.},
  abstract_source = {s2},
}

@book{wood1995democracy,
  author    = {Wood, Ellen Meiksins},
  title     = {Democracy against Capitalism: Renewing Historical Materialism},
  year      = {1995},
  publisher = {Cambridge University Press},
  doi       = {10.1017/cbo9780511558344},
  note      = {
  CORE ARGUMENT: Wood argues for a renewal of historical materialism
  centered on the concept of social property relations rather than
  productive forces. She critiques both Althusserian structuralism (for
  dissolving the economic into the political-ideological) and post-Marxist
  tendencies (Laclau-Mouffe) for abandoning class as the central
  explanatory category. Her chapter "Rethinking Base and Superstructure"
  argues that the base/superstructure metaphor encodes a distinctive
  claim about the historically specific form of the capitalist separation
  of the political from the economic.

  RELEVANCE: The major statement of "political Marxism" as a systematic
  theoretical position, directly engaging all five debate axes:
  base/superstructure, forces vs. relations, teleology, agency, and
  unilinear history. It represents the social relations school's
  alternative to both Cohen's analytical Marxism and Althusserian
  structuralism.

  POSITION: Political Marxism; social property relations primacy; critique
  of technological determinism and post-Marxism.
  },
  keywords  = {political-marxism, base-superstructure, social-relations, Wood, High},
  abstract = {Ellen Meiksins Wood argues that with the collapse of Communism the theoretical project of Marxism and its critique of capitalism is more timely and important than ever. Current intellectual fashions of the left which emphasise 'post-modern' fragmentation, 'difference', contingency and the 'politics of identity' can barely accommodate the idea of capitalism, let alone subject the capitalist system to critique. In this book she sets out to renew the critical programme of historical materialism by redefining its basic concepts and its theory of history in original and imaginative ways, using them to identify the specificity of capitalism as a system of social relations and political power. She goes on to explore the concept of democracy in both the ancient and modern world, examining the concept's relation to capitalism, and raising questions about how democracy might go beyond the limits imposed on it by capitalism.},
  abstract_source = {openalex},
}

@article{chibber2011living,
  author    = {Chibber, Vivek},
  title     = {What Is Living and What Is Dead in the Marxist Theory of History},
  journal   = {Historical Materialism},
  year      = {2011},
  volume    = {19},
  number    = {2},
  pages     = {60--91},
  doi       = {10.1163/156920611x573798},
  note      = {
  CORE ARGUMENT: Chibber argues that historical materialism can be
  reconstructed on a defensible basis by abandoning the primacy of
  productive forces thesis while retaining the core explanatory framework
  of class and exploitation. He identifies what is scientifically
  problematic in Cohen's reconstruction (the development tendency, the
  reliance on functional explanation) and argues that an explanatory
  program centered on class interest and conflict -- closer to Wood and
  Brenner -- is both viable and distinctively Marxist.

  RELEVANCE: Provides a recent synthetic assessment of the Cohen/Brenner
  debate, directly relevant to the question of what a viable 21st-century
  historical materialism looks like. Situates the theoretical debates
  within a broader assessment of what is salvageable in Marx's theory of
  history.

  POSITION: Synthesis position; class-centered historical materialism;
  critical of productive forces primacy while retaining Marxist framework.
  },
  keywords  = {historical-materialism, class, synthesis, productive-forces-critique, High},
  abstract = {Abstract During the 1980s and 1990s, the debate on the Marxist theory of history centred largely around the work of Robert Brenner’s property-relations-centred construal of it, and G.A. Cohen’s attempt to revive the classical, determinist argument. This article examines two influential arguments by Erik Wright and his colleagues, and by Alan Carling, which acknowledge important weaknesses in Cohen’s work, but which also try to construct a more plausible version of his theory. I show that the attempts to rescue Cohen are largely unsuccessful. And, to the extent that they render the argument plausible, they do so at the cost of turning it, willy-nilly, into a kind of class-struggle theory. I conclude that this spells the demise of the classical version of historical materialism, but also observe that this does not leave us with a voluntaristic understanding of history, as some of its defenders fear.},
  abstract_source = {openalex},
}

@book{callinicos2004making,
  author    = {Callinicos, Alex},
  title     = {Making History: Agency, Structure, and Change in Social Theory},
  year      = {2004},
  publisher = {BRILL},
  doi       = {10.1163/9789047404767},
  note      = {
  CORE ARGUMENT: Callinicos addresses the agency/structure problem in
  historical materialism by arguing that the two poles are not opposed but
  mutually constitutive. He engages with structuration theory (Giddens),
  analytical Marxism (Cohen, Elster), and the humanist tradition
  (Thompson) to defend a position in which social structures constrain
  and enable agents who reproduce or transform them through class struggle.
  He argues that revolutionary agency is intelligible within a structurally
  constrained framework.

  RELEVANCE: Directly addresses the agency/structure tension central to
  this domain, engaging the key positions in the debate. Represents the
  attempt to integrate the Thompson/humanist tradition's emphasis on class
  struggle with the analytical and structuralist emphases on structural
  determination.

  POSITION: Agency/structure synthesis; Marxist realism; defense of
  revolutionary agency within structural constraints.
  },
  keywords  = {agency-structure, class-struggle, historical-materialism, social-theory, Medium},
  abstract = {Making History is about the question - central to social theory - of how human agents draw their powers from the social structures they are involved in. Drawing on classical Marxism, analytical philosophy, and a wide range of historical writing, Alex Callinicos seeks to avoid two unacceptable extremes - dissolving the subject into an impersonal flux, as poststructuralists tend to - and treating social structures as the mere effects of individual action (for example, rational-choice theory). Among those discussed are Althusser, Anderson, Benjamin, Brenner, Cohen, Elster, Foucault, Giddens, Habermas, and Mann. Callinicos has written an extended introduction to this new edition that reviews developments since Making History was first published in 1987. This republication gives a new generation of readers access to an important intervention in Marxism and social theory.},
  abstract_source = {openalex},
}

@article{shaw1986development,
  author    = {Shaw, William H.},
  title     = {Historical Materialism and the Development Thesis},
  journal   = {Philosophy of the Social Sciences},
  year      = {1986},
  volume    = {16},
  number    = {2},
  pages     = {197--210},
  doi       = {10.1177/004839318601600203},
  note      = {
  CORE ARGUMENT: Shaw examines the "development thesis" -- Cohen's claim
  that the productive forces tend to develop throughout history -- and
  argues that this thesis faces serious empirical and conceptual
  difficulties. He questions whether the notion of productive force
  "development" is sufficiently determinate to carry the explanatory weight
  Cohen places on it, and examines the conditions under which the
  development tendency can be expected to hold.

  RELEVANCE: Addresses a specific but crucial component of Cohen's
  reconstruction: the empirical and conceptual status of the development
  tendency that grounds the primacy thesis. Situates the philosophical
  debate about forces and relations within the philosophy of social science.

  POSITION: Critical reconstruction; analytical philosophy of social
  science; cautious about strong development thesis.
  },
  keywords = {development-thesis, productive-forces, Cohen-critique, philosophy-social-science, Medium, INCOMPLETE, no-abstract}
}

@article{roberts1998analytical,
  author    = {Roberts, Marcus},
  title     = {Analytical Marxism},
  journal   = {Philosophy East and West},
  year      = {1998},
  volume    = {48},
  number    = {1},
  pages     = {187},
  doi       = {10.2307/1399937},
  note      = {
  CORE ARGUMENT: Roberts surveys the analytical Marxism program and its
  philosophical commitments, examining the extent to which the move to
  methodological individualism, rational choice theory, and game-theoretic
  modeling is compatible with Marx's materialist framework. He identifies
  the program's achievements (rigorous micro-foundations for exploitation
  theory) and its limitations (difficulty accommodating collective class
  action and structural determination).

  RELEVANCE: Provides an external critical perspective on the analytical
  Marxism program that grounds Cohen's reconstruction of historical
  materialism. Relevant for assessing what the analytical tradition
  gained and lost in translating Marx into analytic philosophy.

  POSITION: Critical survey; sympathetic but skeptical about analytical
  Marxism's adequacy to Marx's broader theory of history.
  },
  keywords = {analytical-marxism, methodological-individualism, critique, rational-choice, Low, INCOMPLETE, no-abstract}
}
