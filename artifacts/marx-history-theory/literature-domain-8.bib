@comment{
====================================================================
DOMAIN: Contemporary Scholarship on Marx's Philosophy of History (2005-present)
SEARCH_DATE: 2026-03-28
PAPERS_FOUND: 14 total (High: 7, Medium: 6, Low: 1)
SEARCH_SOURCES: Semantic Scholar, PhilPapers, CrossRef (verification)
====================================================================

DOMAIN_OVERVIEW:
Contemporary scholarship on Marx's philosophy of history has been
transformed by three overlapping developments since 2005. First, the
ongoing publication of the Marx-Engels-Gesamtausgabe (MEGA2) has made
available previously unpublished or underread manuscripts — including
Marx's late ethnological notebooks, the Grundrisse in new critical
editions, and extensive scientific excerpts — revealing a thinker far
more attentive to natural science, non-Western societies, and
historical plurality than the standard "modes of production" narrative
allows. Musto's work in particular has drawn attention to how MEGA2
complicates teleological readings. Second, ecological Marxism has
reconstituted historical materialism around the concept of "metabolic
rift" — drawn from Marx's Capital and natural-scientific notebooks —
arguing that capitalism structurally disrupts the metabolic exchange
between humanity and nature. Saito's Karl Marx's Ecosocialism (2017)
and Marx in the Anthropocene (2023) represent the most developed
reconstruction, using MEGA2 sources to argue that the late Marx
abandoned productivist assumptions in favor of a "degrowth" vision.
This strand has generated debate: Moore argues the metabolic rift
framework remains too dualistic and proposes a world-ecology approach
that integrates nature into the logic of capital. Third, revisionist
readings of historical materialism's core concepts have proliferated.
Postone's Time, Labor, and Social Domination — published in 1993 but
increasingly influential — reinterprets labor not as the ontological
foundation of social life but as a historically specific form of
social domination under capitalism, dissolving the base/superstructure
model. Tomba's Marx's Temporalities extends this by arguing that
historical materialism operates with plural and non-synchronous
temporal layers rather than a single developmental logic. Banaji's
Theory as History (2010) challenges the standard succession of modes
of production, showing how "free" wage labor and "unfree" labor coexist
within capitalism's historical trajectory.

RELEVANCE_TO_PROJECT:
This domain directly covers the most contested contemporary
reinterpretations of Marx's philosophy of history, providing the
contemporary end of any trajectory tracing interpretations from Marx's
own time to the present. The MEGA2 scholarship, ecological readings,
and temporality debates together reframe what "historical materialism"
means as a theory of history, offering the research project its
contemporary landscape.

NOTABLE_GAPS:
Direct engagement with Althusser's influence on current debates is
underrepresented in the verified literature, as is systematic
treatment of how Anglo-American analytic Marxism (Cohen, Elster) now
stands in relation to these newer interpretations. Several core books
(Saito 2017, Postone 1993, Tomba 2013, Banaji 2010) lack
machine-readable abstracts in S2/CrossRef and are marked INCOMPLETE.

SYNTHESIS_GUIDANCE:
Synthesis should contrast the "metabolic rift" strand (Saito, Foster,
Moore) with the "temporalities" strand (Tomba, Postone) and the
"modes of production" revisionism (Banaji, Anderson), showing how
each engages differently with MEGA2's textual resources and with
the Promethean critique of classical historical materialism.

KEY_POSITIONS:
- Ecological/metabolic rift: 4 papers — Marx's critique of capitalism
  as disruption of humanity-nature metabolism; MEGA2 grounds degrowth reading
- Temporality and abstract domination: 3 papers — plural historical
  temporalities; abstract labor as historically specific social form
- Modes of production revisionism: 3 papers — non-linear succession;
  colonial and racial dimensions of capitalist history
- MEGA2 textual scholarship: 2 papers — new archival findings reshape
  the Marx of the late manuscripts and ethnological notebooks
====================================================================
}

@book{saito2017ecosocialism,
  author = {Saito, Kohei},
  title = {Karl Marx's Ecosocialism},
  publisher = {Monthly Review Press},
  year = {2017},
  doi = {10.2307/j.ctt1gk099m},
  note = {
  CORE ARGUMENT: Saito argues, drawing extensively on MEGA2 manuscripts
  including Marx's natural-scientific notebooks, that Marx developed a
  systematic ecological critique of capitalism centered on the concept
  of "metabolic rift" — the structural disruption of the metabolic
  interchange between humanity and nature under capitalist production.
  Against charges of Prometheanism and productivist utopianism, Saito
  shows the mature Marx abandoned assumptions of unlimited technological
  mastery in favor of a critique grounded in natural limits.

  RELEVANCE: Provides the most comprehensive philological reconstruction
  of Marx's ecological thinking as it evolved through the MEGA2 sources,
  directly reframing what Marx's theory of history entails for the
  relation between human labor and natural conditions. Won the Deutscher
  Prize (2018), marking it as the reference point for subsequent debates.

  POSITION: Eco-Marxist / MEGA2-based reconstruction of historical
  materialism.
  },
  keywords = {ecological-marxism, metabolic-rift, MEGA2, High, INCOMPLETE, no-abstract}
}

@book{saito2023anthropocene,
  author = {Saito, Kohei},
  title = {Marx in the Anthropocene},
  publisher = {Cambridge University Press},
  year = {2023},
  doi = {10.1017/9781108933544},
  note = {
  CORE ARGUMENT: Saito extends his MEGA2-based reading to argue that
  the late Marx (c.1868-1883) shifted toward a "degrowth communism"
  that explicitly subordinates capital accumulation and technological
  progress to sustainable metabolic reproduction. This marks a break
  from the teleological developmentalism of the earlier writings and
  from Engels's subsequent systematization of historical materialism.

  RELEVANCE: Directly challenges the standard narrative of historical
  materialism as a theory of progressive historical stages, arguing
  instead for a late-Marx vision of non-linear social transformation
  conditioned by ecological limits — central to any account of how
  interpretations of Marx's philosophy of history have shifted in the
  twenty-first century.

  POSITION: Degrowth / late-Marx ecological turn; challenges
  teleological historical materialism.
  },
  keywords = {ecological-marxism, MEGA2, degrowth, philosophy-of-history, High, INCOMPLETE},
  abstract = {Facing global climate crisis, Karl Marx's ecological critique of capitalism more clearly demonstrates its importance than ever. This book explains why Marx's ecology had to be marginalized and even suppressed by Marxists after his death throughout the twentieth century. Marx's ecological critique of capitalism, however, revives in the Anthropocene against dominant productivism and monism. Investigating new materials published in the complete works of Marx and Engels (Marx-Engels-Gesamtausgabe), Saito offers a wholly novel idea of Marx's alternative to capitalism that should be adequately characterized as degrowth communism. This provocative interpretation of the late Marx sheds new lights on the recent debates on the relationship between society and nature and invites readers to envision a post-capitalist society without repeating the failure of the actually existing socialism of the twentieth century.},
  abstract_source = {s2},
}

@article{saito2020metabolism,
  author = {Saito, Kohei},
  title = {Marx's Theory of Metabolism in the Age of Global Ecological Crisis},
  journal = {Historical Materialism},
  year = {2020},
  volume = {28},
  number = {2},
  pages = {3--24},
  doi = {10.1163/1569206x-20202802},
  note = {
  CORE ARGUMENT: Saito classifies three distinct levels of Marx's
  concept of metabolic rift — between humanity and nature in general,
  between town and country, and between industrial agriculture and
  soil chemistry — and argues that each level implies a corresponding
  "metabolic shift" required for a post-capitalist ecology. The paper
  situates Marx's theory in relation to Meszaros's social metabolism
  framework and to Foster/Burkett's metabolic rift school.

  RELEVANCE: Provides a concise programmatic statement of the
  metabolic rift reading of Marx's philosophy of history and its
  implications for postcapitalist theory, making it the most
  accessible entry-point to the debate for synthesis purposes.

  POSITION: Ecological Marxism; metabolic rift school.
  },
  keywords = {ecological-marxism, metabolic-rift, historical-materialism, High, INCOMPLETE, no-abstract}
}

@book{postone1993time,
  author = {Postone, Moishe},
  title = {Time, Labor, and Social Domination},
  publisher = {Cambridge University Press},
  year = {1993},
  doi = {10.1017/cbo9780511570926},
  note = {
  CORE ARGUMENT: Postone reinterprets Marx's critique of political
  economy as a critique of capitalism as a historically specific form
  of social domination constituted by abstract labor and abstract time,
  not a critique made from the standpoint of labor as such. The
  dominant form of social mediation under capitalism — value — is
  not transhistorical but uniquely modern; historical materialism
  must therefore abandon its grounding in labor as an ontological
  human activity.

  RELEVANCE: Dissolves the base/superstructure model and the
  succession-of-modes framework that characterize standard accounts
  of Marx's philosophy of history, replacing them with an analysis
  of capitalism as a self-moving totality that produces its own forms
  of temporality and necessity. The Postone reading underlies Tomba's
  temporalities work and informs much recent critical theory.

  POSITION: Value-form critique; against "traditional Marxism" and
  labor-ontology readings.
  },
  keywords = {abstract-labor, value-form, historical-materialism, social-domination, High, INCOMPLETE, no-abstract}
}

@book{tomba2013temporalities,
  author = {Tomba, Massimiliano},
  title = {Marx's Temporalities},
  publisher = {BRILL},
  year = {2013},
  doi = {10.1163/9789004236790},
  note = {
  CORE ARGUMENT: Tomba argues that Marx's historical materialism
  operates with a plurality of non-synchronous temporal layers rather
  than a single developmental logic moving from one mode of production
  to another. Drawing on the Grundrisse and Capital, he reconstructs
  Marx's concept of "surplus history" — temporal zones that coexist
  with but are not reducible to the dominant rhythm of capitalist
  accumulation — and uses this to criticize progressivist and
  Eurocentric readings of historical materialism.

  RELEVANCE: Provides one of the most philosophically sophisticated
  responses to postcolonial and anti-teleological critiques of Marx's
  theory of history, arguing that Marx himself contains the resources
  for a plural and non-linear philosophy of historical time. Directly
  relevant to how contemporary scholarship repositions the concept of
  historical stages.

  POSITION: Pluralist temporalities; anti-historicist Marxism.
  },
  keywords = {temporality, historical-materialism, anti-teleology, High, INCOMPLETE},
  abstract = {The book rethinks the central categories of Marx's work beyond any philosophy of history, providing a critical analysis of his political and theoretical development from his early writings, to the elaboration of the critique of political economy and his final anthropological studies on pre-individualistic and communist forms. The study aims to integrate the paradigm of the spatialisation of time with that of the temporalisation of space, showing how capital places diverse temporalities into hierarchies that incessantly produce and reproduce new forms of class struggle. An adequate historiographical paradigm for globalised capitalism has to consider the plurality of temporal layers that are combined and come into conflict in the violently unifying historical dimension of modernity.},
  abstract_source = {openalex},
}

@article{tomba2009temporalities,
  author = {Tomba, Massimiliano},
  title = {Historical Temporalities of Capital: An Anti-Historicist Perspective},
  journal = {Historical Materialism},
  year = {2009},
  volume = {17},
  number = {4},
  pages = {44--65},
  doi = {10.1163/146544609x12537556703115},
  note = {
  CORE ARGUMENT: Tomba develops an anti-historicist reading of Marx's
  Capital, arguing that capitalism does not produce a uniform
  homogeneous historical time but rather multiple, coexisting
  temporalities corresponding to different regimes of surplus value
  extraction. This complicates any reading of historical materialism
  as a theory of linear historical progress.

  RELEVANCE: The article form of arguments later developed in the
  book, useful for tracing how Tomba's reading of Marx challenges
  stagist philosophy of history and engages with Benjamin's "now-time"
  as an alternative materialist concept of historical temporality.

  POSITION: Anti-historicist Marxism; plural temporalities within
  Capital.
  },
  keywords = {temporality, historical-materialism, anti-historicism, High},
  abstract = {Abstract Marx's rethinking of the combination between absolute surplus-value and relative surplus-value during the 1860s is very important in order to reconsider the co-presence of different forms of historical temporality and exploitation. Postmodernism presents a picture of a plurality of historical times in which the old lies beside the modern and the sweatshop beside the high-tech factory. Because it fails to provide an explanation of the relation between these forms, postmodernism produces a false image of an 'ahistorical' present. In this article I want to show how the combination of differentials of surplus-value works and why a representation of a plurality of historical temporalities synchronised by the temporality of socially-necessary labour is the most adequate image to comprehend it. The theoretical task is to show how the mature categorial structure of Capital not only does not need an historicist philosophy of history, but is in fact incompatible with it.},
  abstract_source = {openalex},
}

@book{banaji2010theory,
  author = {Banaji, Jairus},
  title = {Theory as History},
  publisher = {BRILL},
  year = {2010},
  doi = {10.1163/ej.9789004183681.i-406},
  note = {
  CORE ARGUMENT: Banaji argues against the standard Marxist schema
  of succession from ancient slavery to feudalism to capitalism,
  showing that "free" wage labor and "unfree" labor (slavery,
  bonded labor, sharecropping) coexist within a single global
  capitalist mode of production across different historical periods.
  Forms of labor exploitation do not map onto distinct historical
  epochs; rather, capital subsumes radically different labor regimes
  within one totalizing logic.

  RELEVANCE: Directly challenges the teleological schema of historical
  materialism as a succession of modes of production, showing that
  historical diversity is internal to capitalism rather than
  representing pre-capitalist "survivals." This has major implications
  for interpretations of Marx's philosophy of history as it concerns
  the non-Western world and colonial capitalism.

  POSITION: Modes-of-production revisionism; against stagist
  historical materialism.
  },
  keywords = {modes-of-production, historical-materialism, capitalism, labor-forms, High, INCOMPLETE},
  abstract = {Winner of the 2011 Isaac and Tamara Deutscher Memorial Prize. The essays collected here straddle four decades of work in both historiography and Marxist theory, combining source-based historical work in a wide range of languages with sophisticated discussion of Marx's categories. Key themes include the distinctions that are crucial to restoring complexity to the Marxist notion of a 'mode of production'; the emergence of medieval relations of production; the origins of capitalism; the dichotomy between free and unfree labour; and essays in agrarian history that range widely from Byzantine Egypt to 19th-century colonialism. The essays demonstrate the importance of reintegrating theory with history and of bringing history back into historical materialism. An introductory chapter ties the collection together and shows how historical materialists can develop an alternative to Marx's 'Asiatic mode of production'.},
  abstract_source = {openalex},
}

@article{moore2017metabolic,
  author = {Moore, Jason W.},
  title = {Metabolic rift or metabolic shift? dialectics, nature, and the world-historical method},
  journal = {Theory and Society},
  year = {2017},
  volume = {46},
  number = {4},
  pages = {285--318},
  doi = {10.1007/s11186-017-9290-6},
  note = {
  CORE ARGUMENT: Moore argues that the metabolic rift framework
  (Foster, Saito) remains trapped in a Cartesian dualism between
  Society and Nature as external entities, and proposes a
  "world-ecology" approach in which nature is not an external
  condition of capitalism but constitutive of it — capitalism
  develops through the appropriation of cheap nature and produces
  ecological crises as internal contradictions of capital accumulation.

  RELEVANCE: Represents the major critical alternative to Saito's and
  Foster's metabolic rift reading within ecological Marxism, directly
  relevant to the question of how Marx's philosophy of history
  conceptualizes the human-nature relation and whether a dualist
  or monist ontology better captures it.

  POSITION: World-ecology critique of metabolic rift dualism.
  },
  keywords = {ecological-marxism, metabolic-rift, world-ecology, Medium},
  abstract = {In the flowering of Red-Green Thought over the past two decades, metabolic rift thinking is surely one of its most colorful varieties. The metabolic rift has captured the imagination of critical environmental scholars, becoming a shorthand for capitalism’s troubled relations in the web of life. This article pursues an entwined critique and reconstruction: of metabolic rift thinking and the possibilities for a post-Cartesian perspective on historical change, the world-ecology conversation. Far from dismissing metabolic rift thinking, my intention is to affirm its dialectical core. At stake is not merely the mode of explanation within environmental sociology. The impasse of metabolic rift thinking is suggestive of wider problems across the environmental social sciences, now confronted by a double challenge. One of course is the widespread—and reasonable—sense of urgency to evolve modes of thought appropriate to an era of deepening biospheric instability. The second is the widely recognized—but inadequately internalized—understanding that humans are part of nature.},
  abstract_source = {s2},
}

@book{anderson2010margins,
  author = {Anderson, Kevin B.},
  title = {Marx at the Margins},
  publisher = {University of Chicago Press},
  year = {2010},
  doi = {10.7208/chicago/9780226019840.001.0001},
  note = {
  CORE ARGUMENT: Anderson argues that Marx's writings on nationalism,
  ethnicity, and non-Western societies — including his journalism on
  India, Ireland, and Russia, and his late ethnological notebooks —
  reveal a thinker who progressively moved away from a unilinear
  Eurocentric view of historical development toward recognition of
  multiple historical pathways and the agency of non-Western peoples
  in anti-colonial struggle.

  RELEVANCE: One of the major pre-MEGA2 works to draw on previously
  underused textual sources (late manuscripts, journalistic writings)
  to complicate the dominant stagist reading of Marx's philosophy of
  history. Directly relevant to the historiography of how interpretations
  of Marx have shifted to account for colonial history and non-Western
  social formations.

  POSITION: Multilinear / non-Eurocentric historical materialism.
  },
  keywords = {historical-materialism, non-Western, multilinear, MEGA2, Medium},
  abstract = {Jeff McMahan’sThe Ethics of Killingseeks to achieve two objectives, it seems to me. The first is to defend a particular theory of the rights and wrongs of killing, in particular abortion and euthanasia, on the basis of a theory of personal identity. With a careful application of metaphysics to ethics, McMahan has developed a field of argument that has been insufficiently explored, and in so doing, created a whole new structure for the debates surrounding abortion and euthanasia. This makes this a novel and, at times, exciting book. The second objective is to survey the literature on the rights and wrongs of killings and show why alternative theories are wrong. This makes the book comprehensive, very long, and, at times, trying.
  abstract_source = {ndpr},

McMahan begins from the very beginning – to develop an ethics of killing, it is essential that we first establish when it is we kill an entity “of a sort that you and I once were, or might become” (3). Was I ever a fetus? Could I suffer from severe cognitive impairment, or will I, by then, have ceased to exist? To answer these questions, we must first establish what kinds of entities we are. After arguing comprehensively against substance dualism, hylomorphism, and the theory that we are organisms, McMahan develops a theory that claims we are embodied minds. I began to exist with the onset of (the capacity for) consciousness in ‘my’ organism.

The identity of a mind is given, in some way, by a continuity of consciousness. This could be just a matter of psychological connections within the contents of consciousness: desire and its fulfillment, continuation of belief, experience and its memory, etc. Derek Parfit has claimed that identity is given by psychological continuity – overlapping chains of strong psychological connectedness, where strong psychological connectedness holds just in case at least half the number of psychological connections as are normally present in persons hold. But it follows from this that, if – as seems likely – infants do not have strong psychological connectedness day-to-day, I am not identical with the conscious being of the infant that became me – so who was this conscious being? Likewise, should I contract Alzheimer’s, when the number of day-to-day connections decreases below half the normal number, I will cease to be, and some other conscious being will exist instead – who is this?

McMahan replaces Parfit’s account by the claim that a consciousness is the same consciousness if 1) there isanydegree of psychological connectedness,and2) it is sustained by physical and functional continuity, i.e. enough of the same brain must continue to exist and work to support the same consciousness (this latter condition is needed to distinguish identity from qualitatively identical replication in cases such as teletransportation). McMahan admits that (2) is not very well established, but it is also less important morally, as psychological continuity without physical continuity is not something we yet need to take into account in practical ethics.

McMahan combines this account of identity with an account of ‘what matters’. This idea can be understood through that of ‘egoistic concern’: “Each of us has a special sort of concern for his or her own future…[which] is different from our attitude to the future experiences of others.” (41) At first blush, egoistic concern appears to be based upon identity. However, McMahan argues that it – or rather a technical variation on it – can be present in some cases where identity is not preserved, e.g. if the two hemispheres of my brain were separated and transplanted into two different bodies. So instead of identity mattering, the bases for egoistic concern are 1) the physical and functional continuity of those parts of the brain in which consciousness is realized; and 2) psychological unity, a function of the proportion of mental life sustained, the richness of that mental life, and the degree of internal reference between mental states (i.e. a function of psychological continuity and connectedness). Normally, these criteria equally support identity, but, as in the split brain case, need not always.

This distinction between identity and the bases of egoistic concern forms the crux of the entire book. The practical application of this distinction lies in the fact that,unlike identity, the bases for egoistic concern can be present in degrees. Rational egoistic concern varies primarily with the degree of psychological unity. McMahan makes a distinction between a being’s interests – goods over its whole life – and itstime-relativeinterests – goods it has rational egoistic concern for at a particular time (80). The latter factor in the degree to which the bases for egoistic concern hold between the time of having the interests and when the goods/bads will be realized. This distinction in turn produces two theories of the badness of death: the Life Comparative Account (LCA), which claims the badness of death is proportional to the total value of the interests thwarted; and the Time-Relative Interest Account (TRIA), which claims that the badness of death is proportional to the strength of the victim’s time-relative interest in continuing to live, i.e. it additionally takes into account the degree of rational egoistic concern for this future value.

One advantage of the latter account is explaining why the death of a fetus can be less bad than that of an adult human. If LCA were correct, this death would be worse, because more good would be lost. But TRIA takes into account the fact that a fetus is not related to its future in ways that matter. In particular, if a being has no psychological unity over time, then there is little reason to carefor its sakeif it continues to live. Its future is related to it now much like the future of another being.

The wrongness of killing is distinct from the badness of death, for in the case of persons, it is not proportional to the amount of good lost. Here McMahan defends a morality of respect, on the basis that we do not discriminate the wrongness of killing someone by their time-relative interests. These can vary dramatically from one person to another – young, old, gifted, ungifted, and so on. But killing a person is equally wrong in each case because it violates respect for the person.},
}

@article{musto2020mega2,
  author = {Musto, Marcello},
  title = {New Profiles of Marx after the Marx-Engels-Gesamtausgabe (MEGA2)},
  journal = {Contemporary Sociology: A Journal of Reviews},
  year = {2020},
  doi = {10.1177/0094306120946339},
  note = {
  CORE ARGUMENT: Musto surveys how the ongoing publication of MEGA2
  has altered understanding of Marx's thought across several domains:
  the development of the theory of value, the late ethnological
  notebooks, the ecological dimensions of the natural-scientific
  excerpts, and Marx's engagement with non-European social formations.
  He argues that MEGA2 decisively refutes reductive interpretations
  of Marx as a unilinear economic determinist.

  RELEVANCE: Provides a concise scholarly overview of how MEGA2 has
  reshaped the contemporary landscape for interpreting Marx's philosophy
  of history — essential contextual piece for synthesis.

  POSITION: MEGA2 philological scholarship; critical of dogmatic
  historical materialism.
  },
  keywords = {MEGA2, historical-materialism, textual-scholarship, Medium},
  abstract = {For more than a decade now, prestigious newspapers and journals with a wide readership have been describing Karl Marx as a farseeing theorist whose topicality receives constant confirmation. Many authors with progressive views maintain that his ideas continue to be indispensable for anyone who believes it is necessary to build an alternative to capitalism. Almost everywhere, he is now the theme of university courses and international conferences. His writings, reprinted or brought out in new editions, have reappeared on bookshop shelves, and the study of his work, after twenty years or more of neglect, has gathered increasing momentum. The years 2017 and 2018 have brought further intensity to this ‘‘Marx revival,’’ thanks to many initiatives around the world linked to the 150 anniversary of the publication of Capital and the bicentenary of Marx’s birth. Marx’s ideas have changed the world. Yet despite the affirmation of Marx’s theories, turned into dominant ideologies and state doctrines for a considerable part of humankind in the twentieth century, there is still no full edition of all his works and manuscripts. The main reason for this lies in the incomplete character of Marx’s oeuvre; the works he published amount to considerably less than the total number of projects left unfinished, not to speak of the mountainous Nachlass of notes connected with his unending researches. Marx left many more manuscripts than those he sent to the printers. The sometimes-grinding poverty in which he lived, as well as his constant ill health, added to his daily worries; his rigorous method and merciless self-criticism increased the difficulties of many of his undertakings. Moreover, his passion for knowledge remained unaltered over time and always drove him on to fresh study. Nevertheless, his ceaseless labors would have the most extraordinary theoretical consequences for the future. Of particular value for a reevaluation of Marx’s achievement was the resumed publication in 1998 of the Marx-Engels-Gesamtausgabe (MEGA), the historical-critical edition of the complete works of Marx and Friedrich Engels. Twenty-eight more volumes have already appeared (40 were published between 1975 and 1989), and others are in the course of preparation. The MEGA is organized in four sections: (1) all the works, articles, and drafts written by Marx and Engels (with the exception of Capital); (2) Capital and all its preparatory materials; (3) the correspondence—consisting of 4,000 letters by Marx and Engels and 10,000 written to them by others, a large number published for the first time in the MEGA; and (4) the excerpts, annotations, and marginal notes. This fourth section bears witness to Marx’s truly encyclopedic labors: ever since his time at university, it was his habit},
  abstract_source = {s2},
}

@article{musto2023ethnological,
  author = {Musto, Marcello},
  title = {A reappraisal of Marx's Ethnological Notebooks: family, gender, individual vs. state, and colonialism},
  journal = {Inter-Asia Cultural Studies},
  year = {2023},
  doi = {10.1080/14649373.2023.2156124},
  note = {
  CORE ARGUMENT: Musto offers a systematic analysis of Marx's
  Ethnological Notebooks (1879-1882), drawing on MEGA2 editions, to
  show that Marx's late engagement with Morgan's Ancient Society and
  other anthropological sources led him to reconceptualize gender
  relations, family structures, and the state as historically variable
  and irreducible to the dynamics of economic production. The late Marx
  treats colonialism as producing specific forms of historical regression.

  RELEVANCE: Demonstrates how MEGA2's archival resources are reshaping
  the interpretation of Marx's late philosophy of history, particularly
  its treatment of pre-capitalist and non-Western social formations —
  directly relevant to the trajectory from Marx's 19th-century thought
  to 21st-century reinterpretations.

  POSITION: MEGA2 scholarship; multilinear and anti-Eurocentric
  historical materialism.
  },
  keywords = {MEGA2, ethnological-notebooks, colonialism, historical-materialism, Medium},
  abstract = {ABSTRACT Between December 1880 and June 1881, Marx’s research interests focused on a new discipline: anthropology. He began with the study of Ancient Society (1877), a work by the U.S. anthropologist Lewis Morgan. What struck Marx most was the way in which Morgan treated production and technological factors as preconditions of social progress, and he felt moved to assemble a compilation of a hundred densely packed pages of excerpts from this book. These make up the bulk of what are known as The Ethnological Notebooks. They also contain excerpts from other works: Java, or How to Manage a Colony (1861) by James Money (1818–1890), a lawyer and Indonesia expert; The Aryan Village in India and Ceylon (1880) by John Phear (1825–1905), president of the supreme court of Ceylon; and Lectures on the Early History of Institutions (1875) by the historian Henry Maine (1822–1888), amounting to a total of another hundred sheets. Marx’s comparative assessments of these authors are fundamental to have a clear idea of the main theoretical preoccupations of the “late Marx” and suggest an innovative reassessment of some of his key concepts.},
  abstract_source = {s2},
}

@article{jay2020postone,
  author = {Jay, Martin},
  title = {Moishe Postone and the Vicissitudes of Abstraction},
  journal = {Critical Historical Studies},
  year = {2020},
  volume = {7},
  number = {1},
  pages = {3--8},
  doi = {10.1086/708115},
  note = {
  CORE ARGUMENT: Jay reconstructs the central argument of Postone's
  Time, Labor, and Social Domination — that abstract labor and abstract
  time constitute the specific forms of social domination unique to
  capitalism — and situates Postone's project in relation to the
  Frankfurt School tradition. Jay explores the tension between Postone's
  critique of abstraction and the philosophical value of abstraction
  as an analytical tool.

  RELEVANCE: Provides an authoritative secondary account of Postone's
  significance for the interpretation of Marx's critical theory of
  capitalism and history, useful for synthesis agents needing to position
  Postone within the contemporary landscape.

  POSITION: Secondary literature on Postone; Frankfurt School context.
  },
  keywords = {Postone, abstract-labor, critical-theory, social-domination, Medium},
  abstract = {T he only task more difficult than writing a talk on the central role of abstraction in Moishe Postone’s remarkable oeuvre is trying to condense its argument into a mere 20 minutes, producing, as it were, an abstract of its essential points. My sole consolation is that any attempt to do so performatively exemplifies the impoverishment of human life caused by the process of abstraction that Moishe so powerfully lamented. A great deal has been written about his critique of that process—indeed, the literature on his work is no less robust today than it was when his magnum opus, Time, Labor, and Social Domination, was published a quarter century ago—and I do not want to squander my limited time doing what Moishe himself was so often forced to do: painstakingly rehearse the main argument of that book. Instead, I want to focus on the ways in which he conceptualized the antidote to what he saw as the twin tyrannies of abstract labor and abstract time and then finish with a few remarks defending the virtues of a certain version of abstraction, which I think Moishe would have shared. Still, a few quick points do have to bemade about his larger argument for those in the audience who do not have it at their fingertips. Moishe challenged what he disparagingly called “traditional Marxism” by rejecting the idea that a critique of capitalism can be made from the point of view of a transhistorical or ontological notion of unalienated labor, labor that is concrete rather than abstract. Nor can it be criticized from the point of view of production per se as opposed to inequitable distribution. Instead, it requires understanding that the duality of concrete and abstract labor is a function of the capitalist mode of production itself, which also generates the contrasting categories of value and wealth. Value is the objectification or reification of abstracted labor, in which the qualitative specificity of producing objects for use is transformed into the quantitative fungibility of commodified labor power},
  abstract_source = {s2},
}

@article{stedmanjones2017history,
  author = {Jones, Gareth Stedman},
  title = {History and Nature in Karl Marx: Marx's Debt to German Idealism},
  journal = {History Workshop Journal},
  year = {2017},
  volume = {83},
  number = {1},
  pages = {98--117},
  doi = {10.1093/hwj/dbx008},
  note = {
  CORE ARGUMENT: Stedman Jones argues that Marx's conception of
  history and nature remains deeply indebted to the German Idealist
  tradition — particularly Hegel and Schelling — rather than
  representing a clean materialist break from it. The dialectical
  account of humanity's self-realization through labor and the
  teleological framework of historical development both reflect
  idealist inheritance that Marx never fully dissolved.

  RELEVANCE: Provides a historically grounded challenge to readings
  (like Saito's or Foster's) that present Marx's materialism as
  sharply opposed to idealist philosophy of nature, and situates
  contemporary eco-Marxism in relation to Marx's intellectual
  formation — relevant to the broader interpretive arc of the project.

  POSITION: Intellectual-historical; critical of clean break
  between Marx and German Idealism.
  },
  keywords = {German-Idealism, historical-materialism, intellectual-history, nature, Medium, INCOMPLETE, no-abstract}
}

@article{shafer2025slavery,
  author = {Shafer, Matt},
  title = {Marx on Slavery and Capital in the American Civil War},
  journal = {Political Theory},
  year = {2025},
  volume = {53},
  number = {4},
  pages = {532--556},
  doi = {10.1177/00905917251350132},
  note = {
  CORE ARGUMENT: Shafer rereads Marx's journalism on the U.S. Civil
  War as a significant development in his historical materialism,
  arguing that Marx's analysis of the plantation economy and the agency
  of enslaved workers led him to a materialist but non-deterministic
  account of the interconnection between technological change,
  ecological dynamics, and political struggle. This complicates any
  reading of Capital-period Marx as a simple economic determinist.

  RELEVANCE: Represents the very recent (2025) edge of scholarship
  that uses underread primary sources to complicate stagist and
  determinist readings of Marx's theory of history — directly relevant
  to the project's interest in how contemporary scholarship has revised
  the understanding of what Marx's philosophy of history actually entails.

  POSITION: Anti-determinist reading; historical materialism and
  political agency.
  },
  keywords = {slavery, historical-materialism, political-theory, anti-determinism, Medium},
  abstract = {This article rereads Marx’s journalism on the US Civil War as a major development in his historical materialism and theory of capitalism. Against the view that Marx regarded American chattel slavery as a holdover of precapitalist social relations (and that he disregarded the significance of slavery in social history as a result), I find in his writings on the Civil War a complex analysis of the capitalist plantation and of the agency of enslaved laborers in the revolution against it. Contextualizing Marx’s wartime analysis within the longer trajectory of his work on the way to Capital, I situate his account of the American conflict within his wider attention to ecology and technology in the critique of political economy. Through his analysis of the environmental dynamics of plantation slavery and the political trajectory of the Civil War, Marx developed a materialist but non-deterministic account of the interconnection between technological change and political struggle; Marx’s wider account of capitalism and its history was reshaped by the lessons of Southern plantation capitalism and its military defeat.},
  abstract_source = {s2},
}
