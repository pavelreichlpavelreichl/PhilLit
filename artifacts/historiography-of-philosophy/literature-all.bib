@article{antognazza2015benefit,
  author = {Antognazza, Maria Rosa},
  title = {The Benefit to Philosophy of the Study of Its History},
  journal = {British Journal for the History of Philosophy},
  year = {2014},
  volume = {23},
  number = {1},
  pages = {161--184},
  doi = {10.1080/09608788.2014.974020},
  note = {
  CORE ARGUMENT: Antognazza argues that history of philosophy is both
  a kind of history and a kind of philosophy, and that deep engagement
  with the philosophical past produces distinctive philosophical
  benefits: it trains the mind to think outside current orthodoxies,
  exposes the contingency of current categories, and shows that
  "latest is not always best." Far from imprisoning philosophers in
  dead views, historical study has an innovative and subversive
  potential.

  RELEVANCE: This paper provides a nuanced philosophical defense of
  historicist practice without fully collapsing into either pole:
  Antognazza preserves normative philosophical engagement while insisting
  on historical rigor. It represents a "both/and" position useful for
  the hybrid/third-way section of the synthesis.

  POSITION: Hybrid -- philosophy and history are not in tension but
  mutually enriching.
  },
  keywords = {historiography-of-philosophy, methodology, hybrid, Antognazza, High},
  abstract = {This paper advances the view that the history of philosophy is both a kind of history and a kind of philosophy. Through a discussion of some examples from epistemology, metaphysics, and the historiography of philosophy, it explores the benefit to philosophy of a deep and broad engagement with its history. It comes to the conclusion that doing history of philosophy is a way to think outside the box of the current philosophical orthodoxies. Somewhat paradoxically, far from imprisoning its students in outdated and crystallized views, the history of philosophy trains the mind to think differently and alternatively about the fundamental problems of philosophy. It keeps us alert to the fact that latest is not always best, and that a genuinely new perspective often means embracing and developing an old insight. The upshot is that the study of the history of philosophy has an innovative and subversive potential, and that philosophy has a great deal to gain from a long, broad, and deep conversation with its history.},
  abstract_source = {openalex},
}

@book{laerkeSmithSchliesser2013philosophyHistory,
  editor = {Laerke, Mogens and Smith, Justin E. H. and Schliesser, Eric},
  title = {Philosophy and Its History: Aims and Methods in the Study of Early Modern Philosophy},
  year = {2013},
  publisher = {Oxford University Press},
  doi = {10.1093/acprof:oso/9780199857142.001.0001},
  note = {
  CORE ARGUMENT: This edited volume collects essays from prominent
  scholars of early modern philosophy who represent widely divergent
  methodological commitments, from strongly contextualist to strongly
  appropriationist. The editors' introduction frames the volume as an
  attempt to move beyond the binary by acknowledging a plurality of
  legitimate methods depending on scholarly goals. Topics addressed
  include the principle of charity, text reading, the role of
  historiography within history of philosophy, and the place of history
  of science.

  RELEVANCE: This is the immediate predecessor to the anchor volume
  (Smith, Schliesser, Laerke 2022) and provides essential context for
  understanding how the methodological debate evolved in the 2010s. It
  is explicitly cited in the research proposal's key sources.

  POSITION: Pluralist -- the volume encompasses the full spectrum of
  positions.
  },
  keywords = {historiography-of-philosophy, methodology, pluralism, edited-volume, High},
  abstract = {This volume collects contributions from leading scholars of early modern philosophy from a wide variety of philosophical and geographic backgrounds. The distinguished contributors offer very different, competing approaches to the history of philosophy.},
  abstract_source = {openalex},
}

@article{corkum2023philosophyPast,
  author = {Corkum, Phil},
  title = {Philosophy's past: Cognitive values and the history of philosophy},
  journal = {Philosophy and Phenomenological Research},
  year = {2023},
  volume = {108},
  number = {3},
  pages = {585--606},
  doi = {10.1111/phpr.12990},
  note = {
  CORE ARGUMENT: Corkum argues against recent authors who claim that
  the role of historical scholarship within philosophy is dispensable
  (because its contributions -- questioning assumptions, exposing
  vestiges, calibrating intuitions -- can be achieved by nonhistorical
  means). Drawing an analogy with scientific cognitive values, he
  argues that cognitive values like novelty and conservativeness can
  only be properly assessed with a historically informed evaluation;
  this role is neither replicable by nonhistorical methods nor
  contingent on the presence of questionable assumptions.

  RELEVANCE: This 2023 paper offers one of the most recent and
  philosophically sophisticated defenses of the indispensability of
  historical scholarship to philosophy, providing ammunition for the
  synthesis's treatment of the philosophical stakes of the debate.

  POSITION: Pro-history, but not strictly contextualist -- argues for
  the ineliminable cognitive role of history rather than for full
  contextual immersion.
  },
  keywords = {historiography-of-philosophy, methodology, cognitive-values, Corkum, High},
  abstract = {Abstract Recent authors hold that the role of historical scholarship within contemporary philosophical practice is to question current assumptions, to expose vestiges or to calibrate intuitions. On these views, historical scholarship is dispensable , since these roles can be achieved by nonhistorical methods. And the value of historical scholarship is contingent , since the need for the role depends on the presence of questionable assumptions, vestiges or comparable intuitions. In this paper I draw an analogy between scientific and philosophical practice, in order to float one role for historical scholarship that is nonreplicable and noncontingent. It has long been acknowledged that cognitive values – features of theories that facilitate understanding, such as ontological parsimony, ideological simplicity, computational ease and fecundity – play a key role within science. The role of some of these values within philosophy also has received attention but left understudied are the values of novelty and conservativeness. These values influence theory choice, the selection of methodology, the setting of research agenda, and the presentation of results; and are best assessed with a historically informed evaluation. This role for historical scholarship is not replicable by nonhistorical methods, and is not contingent on the presence of questionable assumptions, vestiges or comparable intuitions.},
  abstract_source = {openalex},
}

@article{hangai2023internalHistory,
  author = {Hangai, Attila},
  title = {Internal History of Philosophy},
  journal = {Filozofia},
  year = {2023},
  volume = {78},
  number = {10},
  pages = {848--864},
  doi = {10.31577/filozofia.2023.78.10.4},
  note = {
  CORE ARGUMENT: Hangai defends an "internal history of philosophy"
  that prioritizes philosophical reasons over cultural-contextual
  factors, following Frede and Mandelbaum. He argues that contextualism
  is either too permissive (allowing any cultural factor as relevant,
  obliterating interpretive correctness) or it collapses into complete
  historical explanation (dissolving history of philosophy into general
  history). The internal approach appeals to contextual factors in a
  principled, supplementary way rather than as primary determinants
  of meaning.

  RELEVANCE: This paper provides one of the most recent articulations
  of a principled anti-contextualist position that is not mere
  appropriationism; Hangai's Frede-based "internal history" is a
  third-way candidate distinct from both Garber's contextualism and
  Della Rocca's appropriationism.

  POSITION: Internal history of philosophy -- a sophisticated
  alternative to the appropriationism/contextualism binary.
  },
  keywords = {historiography-of-philosophy, internal-history, contextualism-critique, Hangai, Medium},
  abstract = {I defend an internal history of philosophy that prioritizes philosophical reasons over cultural factors. This approach contrasts with a broadly contextualist endeavor invoking cultural factors without clear ground. I argue that the latter path is either too permissive or leads to aiming at a complete historical account. Neither way is acceptable: the former obliterates the correctness of interpretation; the latter dissolves history of philosophy in general history and is practically impossible. Instead, the internal history I propose -based primarily on Michael Frede's and Maurice Mandelbaum's historiography -prioritizes philosophical reasoning and appeals to external contextual factors in a principled way when it is necessary to supplement philosophical considerations.},
  abstract_source = {openalex},
}

@article{blau2020meaningsUnderstandings,
  author = {Blau, Adrian},
  title = {Meanings and Understandings in the History of Ideas},
  journal = {Journal of the Philosophy of History},
  year = {2020},
  volume = {14},
  number = {2},
  pages = {232--256},
  doi = {10.1163/18722636-12341441},
  note = {
  CORE ARGUMENT: Blau proposes a fourfold framework of meaning and
  understanding in the history of political thought and intellectual
  history, identifying a type of meaning -- roughly, the philosophical
  or theoretical meaning of an argument -- that is systematically
  neglected by Skinnerian contextualism. He argues that previous
  frameworks (including Skinner's) have been blind to this type, which
  is precisely the type prioritized by philosophers rather than
  historians.

  RELEVANCE: Blau's paper directly addresses the Skinner--philosopher
  tension at the heart of this domain, arguing that Skinner's original
  1969 article conflated distinct senses of "meaning," a confusion
  that has structured four decades of debate. This is useful for the
  synthesis's treatment of the logical basis of the disagreement.

  POSITION: Critical development of Skinner -- moves toward a hybrid
  that takes seriously both historical and philosophical meaning.
  },
  keywords = {historiography-of-philosophy, meaning, Skinner-critique, Blau, Medium},
  abstract = {Abstract This paper presents a framework of four types of meaning and understanding in the history of political thought and intellectual history. Previous frameworks have overlooked a whole type of meaning – the type often prioritised by political theorists and philosophers. I call this “extended meaning.” Correcting a wrong turn in philosophy of language in the 1950s, I show how extended meaning has robust intellectual foundations, and I illustrate its value for textual interpreters. Even historians often need extended meaning, for example to help resolve ambiguous passages. So, the main types of meaning are not alternatives: scholars interested in one kind of meaning still need others. This paper thus celebrates both diversity and unity.},
  abstract_source = {openalex},
}

@article{lamb2009skinnerContextualism,
  author = {Lamb, Robert},
  title = {Quentin Skinner's revised historical contextualism: a critique},
  journal = {History of the Human Sciences},
  year = {2009},
  volume = {22},
  number = {3},
  pages = {51--73},
  doi = {10.1177/0952695109104423},
  note = {
  CORE ARGUMENT: Lamb argues that Skinner's revised contextualist
  position in Regarding Method (2002) fails to justify its central
  contention that past political texts cannot be read as contributions
  to perennial philosophical debates. He shows that Skinner's arguments
  against treating texts as answers to perennial questions are
  structurally similar to the errors Skinner himself identified in
  earlier methodological orthodoxies, and that treating texts as
  engaging with perennial questions is not only permissible but often
  illuminating.

  RELEVANCE: Lamb's critique is one of the most focused philosophical
  responses to mature Skinnerian contextualism, and is directly
  relevant to how the synthesis characterizes the strength of the
  contextualist case against reading past philosophy for its bearing
  on current questions.

  POSITION: Anti-contextualist critique from within the history of
  political thought.
  },
  keywords = {historiography-of-philosophy, Skinner-critique, contextualism, Lamb, Medium},
  abstract = {Since the late 1960s Quentin Skinner has defended a highly influential form of linguistic contextualism for the history of ideas, originally devised in opposition to established methodological orthodoxies like the `great text' tradition and a mainly Marxist epiphenomenalism. In 2002, he published Regarding Method, a collection of his revised methodological essays that provides a uniquely systematic expression of his contextualist philosophy of history. Skinner's most arresting theoretical contention in that work remains his well-known claim that past works of political theory cannot be read as contributions to `perennial' debates but must instead be understood as particularistic, ideological speech acts. In this article I argue that he fails to justify these claims and that there is actually nothing wrong at all with (where appropriate) treating past works of political theory as engaged in perennial philosophical debates. Not only do Skinner's arguments not support the form of contextualism he defends, their flaws are actually akin to those he identified in his critique of previous methodological orthodoxies.},
  abstract_source = {openalex},
}

@article{ferreiraDaSilva2022historian,
  author = {Silva, Gabriel Ferreira da},
  title = {The Historian of Philosophy as a ``Portraitmaler'': A Brentanian Look on the Contextualism-Appropriationism Debate},
  journal = {S{\'i}ntese: Revista de Filosofia},
  year = {2022},
  volume = {49},
  number = {155},
  pages = {559},
  doi = {10.20911/21769389v49n155p559/2022},
  note = {
  CORE ARGUMENT: Ferreira da Silva uses the Austrian philosophical
  tradition (Brentano, Mulligan) to approach the contextualism-
  appropriationism debate, arguing that Brentano's "Portraitmaler"
  conception of the historian of philosophy -- who must accurately
  portray the thought of a past figure -- yields a nuanced position
  that insists on getting things right without reducing the task to
  mere historical antiquarianism. This recovers a pre-analytic
  perspective on the debate that complicates both the Rorty-Bennett
  and the Skinner-Garber positions.

  RELEVANCE: This paper's use of Brentano provides an unusual
  standpoint for mapping the debate and introduces a "getting things
  right" constraint (related to Mercer's GTRC) from a different
  tradition, enriching the synthesis's treatment of hybrid positions.

  POSITION: Hybrid/third-way -- Brentanian internal history as an
  alternative to both poles.
  },
  keywords = {historiography-of-philosophy, Brentano, hybrid, Ferreira, Medium},
  abstract = {Abstract: In 2019, Christia Mercer has published a paper in which she does a reassessment of the 2015 debate between Garber and Della Rocca on what would be the correct interpretation of Spinoza. Following Mercer, the two philosophers instantiated two main positions regarding the concept and the methodology of doing history of philosophy, namely, contextualism and appropriationism. As Mercer puts it, it is pivoted around the acceptance or rejection of one single principle, i.e. the “Getting Things Right Constraint” (GTRC), which can be rendered as the clause that forbids the attribution of claims or ideas to historical figures without concern for whether or not they are ones the figures would recognize as their own. However, rather than be an undoubtful principle, it conceals a great number of tough questions about the very meaning of what one should understand by “getting things right”. Following what Mulligan names the “Austrian approach” to the history of philosophy, this paper aims to unfold some aspects of Brentano’s “philosophy of history of philosophy” to look for his contributions to a problem that was already present at the origins of contemporary philosophy. Keywords: Brentano. Contextualism. Appropriationism. History of Philosophy.},
  abstract_source = {openalex},
}

@article{laerke2019frenchHistoriographical,
  author = {L{\ae}rke, Mogens},
  title = {French historiographical Spinozism, 1893--2018. {Delbos}, {Gu{\'e}roult}, {Verni{\`e}re}, {Moreau}},
  journal = {British Journal for the History of Philosophy},
  year = {2019},
  volume = {28},
  number = {3},
  pages = {653--672},
  doi = {10.1080/09608788.2019.1636199},
  note = {
  CORE ARGUMENT: Laerke traces a distinctive methodological lineage in
  French Spinoza scholarship from Victor Delbos through Martial
  Gueroult and Paul Verniere to Pierre-Francois Moreau, focusing on
  a historiographical principle first articulated by Delbos. The paper
  characterises this tradition as "historiographical Spinozism" -- a
  form of scholarship that uses Spinoza's own philosophical method as
  a guide to interpreting Spinoza -- thereby illustrating how
  methodology and object of study can be fused.

  RELEVANCE: Laerke is one of the editors of the anchor volumes and a
  key advocate for hybrid or "collegial reading" approaches; this paper
  exemplifies a non-dogmatic methodological pluralism in practice and
  shows how the French tradition differs from both Cambridge
  contextualism and analytic appropriationism.

  POSITION: Historiographical pluralism -- illustrates a third
  tradition distinct from Anglophone appropriationism and Cambridge
  contextualism.
  },
  keywords = {historiography-of-philosophy, Laerke, French-tradition, Spinoza, Medium},
  abstract = {This paper explores a methodological lineage among French Spinoza scholars which can be traced back to texts written by Victor Delbos (1862–1916), which later branched out into two diametrically opposed orientations in the work by Martial Gueroult (1891–1976) and Paul Vernière (1916–1997), only to be reunited reflexively in the more recent work by Pierre-François Moreau (1948-). The aim is mostly to offer an original reconstruction of the way in which Delbos’ historical programme was inherited by subsequent Spinoza scholars. While retracing this lineage, my focus will be on a specific historiographical principle first formulated by Delbos. In the conclusion, however, I briefly turn to Spinoza himself, arguing how this reconstituted family of twentieth century French historians of philosophy can be characterized as a form of ‘Historiographical Spinozism’.},
  abstract_source = {openalex},
}

@book{sorelleRogers2005analyticPhilosophy,
  editor = {Sorell, Tom and Rogers, G. A. J.},
  title = {Analytic Philosophy and History of Philosophy},
  year = {2005},
  publisher = {Oxford University Press},
  doi = {10.1093/oso/9780199278992.001.0001},
  note = {
  CORE ARGUMENT: This edited collection brings together ten
  distinguished philosophers to explore the tension between the
  analytic philosophical tradition (oriented toward clarity, precision,
  and consistency with natural science) and historical engagement with
  philosophical texts. Contributors including Garber, Kenny, and Ayers
  argue for different versions of the relation; the volume's premise
  is that analytic philosophy's methods are "unhistorical" and even
  "anti-historical," making the combination with history of philosophy
  a genuine methodological challenge.

  RELEVANCE: The Sorell-Rogers volume is a direct precursor to the
  Laerke-Smith-Schliesser volumes and frames the debate specifically
  within the context of analytic philosophy's self-understanding,
  providing useful background for the synthesis's account of why the
  debate matters institutionally.

  POSITION: Diagnostic/pluralist -- documents the tension without
  resolving it.
  },
  keywords = {historiography-of-philosophy, analytic-philosophy, methodology, edited-volume, Medium},
  abstract = {Abstract Philosophy written in English is overwhelmingly analytic philosophy, and the techniques and predilections of analytic philosophy are not only unhistorical but anti-historical, and hostile to textual commentary. Analytic usually aspires to a very high degree of clarity and precision of formulation and argument, and it often seeks to be informed by, and consistent with, current natural science. In an earlier era, analytic philosophy aimed at agreement with ordinary linguistic intuitions or common sense beliefs, or both. All of these aspects of the subject sit uneasily with the use of historical texts for philosophical illumination. How, then, can substantial history of philosophy find a place in analytic philosophy? If history of philosophy includes the respectful, intelligent use of writings from the past to address problems that are being debated in the current philosophical journals, then history of philosophy may well belong to analytic philosophy. But if history of philosophy is more than this; if it is concerned with interpreting and reinterpreting a certain canon, or perhaps making a case for extending this canon, its connection with analytic philosophy is less clear. More obscure still is the connection between analytic philosophy and a kind of history of philosophy that is unapologetically antiquarian. This is the kind of history of philosophy that emphasises the status of a philosophical text as one document among others from a faraway intellectual world, and that tries to acquaint us with that world in order to produce understanding of the document. In this book, ten distinguished historians of philosophy, mostly trained in the analytic tradition, explore the tensions between, and the possibilities of reconciling, analytic philosophy and history of philosophy.},
  abstract_source = {openalex},
}

@article{shapiro2016revisitingCanon,
  author = {Shapiro, Lisa},
  title = {Revisiting the Early Modern Philosophical Canon},
  journal = {Journal of the American Philosophical Association},
  year = {2016},
  volume = {2},
  number = {3},
  pages = {365--383},
  doi = {10.1017/apa.2016.27},
  note = {
  CORE ARGUMENT: Shapiro argues that the early modern philosophical
  canon -- fixed largely by appropriationist scholarship that selected
  figures for their relevance to current debates -- has systematically
  excluded important figures, especially women, and that revisiting the
  canon requires reconsidering not just who is included but what
  purposes the canon serves. She connects methodological debates about
  appropriationism to questions of diversity and inclusivity in the
  discipline.

  RELEVANCE: Shapiro introduces a dimension of the appropriationism-
  contextualism debate not usually foregrounded: the political
  consequences of appropriationist canon formation. This enriches the
  synthesis by connecting methodological choices to scholarly diversity.

  POSITION: Contextualist/pluralist with feminist and canon-critical
  dimensions.
  },
  keywords = {historiography-of-philosophy, canon, Shapiro, early-modern, Medium},
  abstract = {ABSTRACT: I reflect critically on the early modern philosophical canon in light of the entrenchment and homogeneity of the lineup of seven core figures: Descartes, Spinoza, Leibniz, Locke, Berkeley, Hume, and Kant. After distinguishing three elements of a philosophical canon—a causal story, a set of core philosophical questions, and a set of distinctively philosophical works—I argue that recent efforts contextualizing the history of philosophy within the history of science subtly shift the central philosophical questions and allow for a greater range of figures to be philosophically central. However, the history of science is but one context in which to situate philosophical works. Looking at the historical context of seventeenth-century philosophy of mind, one that weaves together questions of consciousness, rationality, and education, does more than shift the central questions—it brings new ones to light. It also shows that a range of genres can be properly philosophical and seamlessly diversifies the central philosophers of the period.},
  abstract_source = {openalex},
}

@book{frede2021historiographyPhilosophy,
  author = {Frede, Michael},
  editor = {Ierodiakonou, Katerina},
  title = {The Historiography of Philosophy},
  year = {2021},
  publisher = {Oxford University Press},
  doi = {10.1093/oso/9780198840725.001.0001},
  note = {
  CORE ARGUMENT: This posthumously edited collection of Frede's
  lectures on the historiography of philosophy articulates what he
  calls "philosophical history of philosophy," which aims to understand
  past philosophers on their own terms while remaining responsive to
  philosophical questions. Frede's approach, developed across decades
  of work on ancient philosophy, insists that past philosophers were
  addressing genuine philosophical problems, not merely historical
  contingencies, but that recovering those problems requires careful
  historical contextualisation.

  RELEVANCE: Frede's model of "internal history of philosophy" is
  invoked by Hangai (2023) and others as a third-way position between
  pure appropriationism and pure contextualism; it represents the
  mature version of a position that has influenced both the Cambridge
  and analytic traditions.

  POSITION: Internal history of philosophy -- foundational text for
  third-way positions.
  },
  keywords = {historiography-of-philosophy, internal-history, Frede, foundational, Low},
  abstract = {This book presents the Nellie Wallace lectures which Michael Frede gave in Oxford in 1989–90. These lectures discuss how the history of philosophy has been studied and how it should be studied. There are three systematical approaches to the history of philosophy which run under the same heading ‘history of philosophy’ and deal with the same material, but they are distinct enterprises: philosophical doxography, philosophical history of philosophy, and historical history of philosophy. All three enterprises are perfectly legitimate, but the lectures give priority to the historical history of philosophy, since the other two ultimately have to rely on its findings. Thus, the lectures start by showing how the historical history of philosophy differs from the two philosophical studies of the history of philosophy. They then examine the historical discipline in more detail, and finally look into the consequences of its practice.},
  abstract_source = {openalex},
}

@misc{smithSchliesserLaerke2022methodology,
  author = {Smith, Justin E. H. and Schliesser, Eric and Laerke, Mogens},
  title = {The Methodology of the History of Philosophy},
  year = {2022},
  howpublished = {Oxford University Press},
  note = {
  CORE ARGUMENT: This volume, the most recent collaboration of the
  editors who produced the 2013 volume, extends the methodological
