@comment{
====================================================================
DOMAIN: Adjacent Distinctions and Sub-Debates in Historiography of Philosophy
SEARCH_DATE: 2026-06-01
PAPERS_FOUND: 17 total (High: 8, Medium: 7, Low: 2)
SEARCH_SOURCES: SEP, IEP, PhilPapers, OpenAlex, CORE, CrossRef
====================================================================

DOMAIN_OVERVIEW:
This domain covers the conceptual distinctions and sub-debates that
structure the broader dispute between appropriationism and
contextualism in the historiography of philosophy. Several overlapping
fault lines run through the field. First, the distinction between
"history of philosophy" (focused on philosophical arguments as
arguments) and "history of ideas" (focused on units of thought across
historical contexts, as theorized by Arthur O. Lovejoy) marks a
disciplinary boundary with methodological consequences: historians of
ideas treat texts as vehicles for tracing idea-units, while
philosophers tend to evaluate whether arguments are valid. Second, the
Cambridge School's insistence on linguistic context and authorial
intention (Skinner, Pocock, Dunn) introduced a third orientation --
intellectual history -- that differs from both by emphasizing illocutionary
acts and the political languages of historical speech. Third, analytic
and continental traditions have developed quite different
self-understandings of their relationship to their own histories:
analytic philosophers have historically been suspicious of historical
methods (though a "historical turn" in analytic philosophy has partly
changed this), while continental philosophers tend to see historical
engagement with past texts as philosophically constitutive, not
merely contextual. Fourth, hermeneutics (Gadamer, Ricoeur) offers a
philosophical theory of how understanding across temporal distance is
possible, with direct implications for what it means to interpret
historical texts charitably or critically. These sub-debates
collectively constrain and inform the appropriationism/contextualism
debate by raising the question: what kind of enterprise is the history
of philosophy, and for whom?

RELEVANCE_TO_PROJECT:
The key anchor volume (Laerke, Smith, Schliesser, OUP) presupposes
these distinctions and positions itself at their intersection; the
papers in this domain explain the intellectual terrain in which that
volume intervenes. Understanding the Cambridge School, the
analytic-continental divide in historiography, and hermeneutics is
essential for understanding why the appropriationism/contextualism
debate takes the shape it does and what is at stake in different
methodological choices.

NOTABLE_GAPS:
Lovejoy's own methodological writings from the 1930s-1950s are not
directly represented (Great Chain of Being 1936 is a book without a
findable DOI for the original monograph; only secondary literature is
included). The debate about feminist historiography of philosophy
(Alanen, Witt) and its methodological distinctives is underrepresented.
Two entries marked INCOMPLETE (no abstract obtainable via API): skinner1969meaning (Skinner 1969, History and Theory) and frede1988history (Frede 1988, Journal of Philosophy); both are included in the file but excluded from synthesis.

SYNTHESIS_GUIDANCE:
These papers should be read as a map of the meta-methodological
landscape within which the appropriationism/contextualism debate
operates; the synthesis writer should use them to situate that debate
within the broader field of intellectual history and hermeneutics
rather than treating it as an isolated intraphilosophical dispute.

KEY_POSITIONS:
- Cambridge School contextualism: 3 papers -- Skinner's speech-act approach
  to intellectual history as the dominant alternative to philosophical presentism
- Analytic-continental divide: 5 papers -- competing accounts of why analytic
  and continental philosophy parted ways and what this means for historiography
- Hermeneutics: 3 papers -- Gadamer- and Ricoeur-influenced accounts of
  interpretation across temporal distance
- History of ideas vs history of philosophy: 4 papers -- demarcating Lovejoy's
  method from both analytic historiography and Cambridge contextualism
- Analytic historiography's self-understanding: 3 papers -- the recent
  historical turn in analytic philosophy and its methodological implications
====================================================================
}

@book{skinner2002visions,
  author = {Skinner, Quentin},
  title = {Visions of Politics, Volume 1: Regarding Method},
  year = {2002},
  publisher = {Cambridge University Press},
  doi = {10.1017/cbo9780511790812},
  abstract = {The first of three volumes of essays by Quentin Skinner, one of the world's leading intellectual historians. This collection includes some of his most important philosophical and methodological statements written over the past four decades, each carefully revised for publication in this form. In a series of seminal essays Professor Skinner sets forth the intellectual principles that inform his work, engaging with critics who have challenged him from both analytic and hermeneutic perspectives.},
  note = {
  CORE ARGUMENT: Skinner defends a speech-act-theoretic methodology for intellectual history according to which the interpreter's primary task is to recover the illocutionary point of a historical utterance: what the author was doing in saying what they said, within the linguistic conventions available to them. This rules out anachronistic attribution of questions or doctrines not available to the historical agent, and equally rules out reading texts as contributions to perennial problems. The volume gathers essays from "Meaning and Understanding" (1969) through later refinements.

  RELEVANCE: This is the canonical methodological statement of Cambridge School contextualism as it applies to the history of political thought; its arguments directly target the kind of appropriationism that takes historical texts as contributions to timeless debates. The distinction between what Skinner calls "historical" and "philosophical" questions defines one horn of the appropriationism/contextualism divide.

  POSITION: Cambridge School contextualism; anti-appropriationist.
  },
  keywords = {Cambridge-School, contextualism, intellectual-history, methodology, High}
}

@article{skinner1969meaning,
  author = {Skinner, Quentin},
  title = {Meaning and Understanding in the History of Ideas},
  journal = {History and Theory},
  year = {1969},
  volume = {8},
  number = {1},
  pages = {3--53},
  doi = {10.2307/2504188},
  note = {
  CORE ARGUMENT: Skinner argues that the history of ideas has been systematically distorted by two types of mythology: the "mythology of doctrines" (finding in earlier thinkers answers to questions they never posed) and the "mythology of coherence" (constructing artificially consistent systems from fragmentary texts). The remedy is to reconstruct the linguistic context of a text and the conventions that made certain utterances possible and meaningful. Recovering authorial intention is not psychologism but a methodological constraint derived from speech-act theory.

  RELEVANCE: This article is arguably the founding document of Cambridge School contextualism in intellectual history and the most direct methodological challenge to presentist or appropriationist readings of historical philosophy. Any account of the appropriationism/contextualism debate must engage with Skinner's argument here.

  POSITION: Cambridge School contextualism; critique of perennialism and anachronism.
  },
  keywords = {Cambridge-School, contextualism, methodology, meaning, intellectual-history, High, INCOMPLETE, no-abstract}
}

@article{mandelbaum1965history,
  author = {Mandelbaum, Maurice},
  title = {The History of Ideas, Intellectual History, and the History of Philosophy},
  journal = {History and Theory},
  year = {1965},
  volume = {5},
  pages = {33--66},
  doi = {10.2307/2504118},
  note = {
  CORE ARGUMENT: Mandelbaum distinguishes three disciplinary enterprises that are often conflated: the history of ideas (concerned with the fate of particular ideas across epochs and domains, following Lovejoy), intellectual history (concerned with the thought of an era in its social and cultural context), and history of philosophy (concerned with philosophical arguments and their validity). Each enterprise involves different selection criteria, methods, and standards of success. The history of philosophy is not simply a subset of the history of ideas.

  RELEVANCE: This article provides the clearest classical taxonomy of the sub-fields and explains what is at stake in the choice among them. The appropriationism/contextualism debate presupposes, but rarely makes explicit, exactly these distinctions. Mandelbaum's analysis clarifies why historians and philosophers so often talk past each other about what the history of philosophy is for.

  POSITION: Analytical demarcation; neutral with respect to appropriationism vs. contextualism but essential for situating the debate.
  },
  keywords = {history-of-ideas, intellectual-history, history-of-philosophy, demarcation, High},
  abstract = {Those who are at present interested in methodological problems of historian of philosophy cannot fail to take note of existence of what has come to be called the history of ideas. The latter term has been used in a variety of senses, sometimes being equated with intellectual history generally.1 However, it is not in that wider sense that I wish to consider it. Instead, I shall in first instance confine my attention to problems which arise out of two important parallel movements, each of which may be regarded as an attempt to promote study of the history of ideas in a narrower and more technical sense: movement in United States of which A. 0. Lovejoy was originator and dominant spokesman, and movement inspired in Germany by Dilthey's work, and now represented by Erich Rothacker's Archiv fur Begriffsgeschichte. Because Lovejoy and his close collaborators have written at greater length concerning their methodological presuppositions than have those connected with Archiv, and also because these presuppositions seem to raise a greater variety of issues in a somewhat more acute form, it is with former group, rather than latter, that I shall here be concerned.2},
  abstract_source = {openalex},
}

@article{frede1988history,
  author = {Frede, Michael},
  title = {The History of Philosophy as a Discipline},
  journal = {Journal of Philosophy},
  year = {1988},
  volume = {85},
  number = {11},
  pages = {666--672},
  doi = {10.5840/jphil1988851114},
  note = {
  CORE ARGUMENT: Frede argues that the history of philosophy has its own disciplinary identity, neither reducible to general historical scholarship nor to systematic philosophy. He contends that doing justice to past philosophers requires both philosophical competence (to understand what is at stake in their arguments) and historical sensitivity (to appreciate what problems they faced and what resources were available to them). The history of philosophy thus occupies a sui generis position between history and philosophy.

  RELEVANCE: Frede's short essay articulates the position that the history of philosophy is distinct from both the history of ideas (contra Lovejoy) and from purely ahistorical philosophical appropriation. It is directly relevant to the question of whether there is a special disciplinary standpoint -- the "historian-philosopher" -- that neither pure historians nor pure philosophers occupy.

  POSITION: Hybrid disciplinary identity; neither pure contextualism nor pure appropriationism.
  },
  keywords = {history-of-philosophy, discipline, methodology, High, INCOMPLETE, no-abstract}
}

@article{catana2010lovejoy,
  author = {Catana, Leo},
  title = {Lovejoy's Readings of Bruno: Or How Nineteenth-century History of Philosophy was ``Transformed'' into the History of Ideas},
  journal = {Journal of the History of Ideas},
  year = {2010},
  volume = {71},
  number = {1},
  pages = {91--112},
  doi = {10.1353/jhi.0.0068},
  abstract = {Arthur O. Lovejoy made rather grand methodological statements about the nature of history of ideas in his Great Chain of Being (1936). These statements were, it is argued, rhetorical declarations, intended to produce the conviction in the minds of his readers that history of ideas was distinct from history of philosophy and thus deserved institutional independence; they were not adequate descriptions of his practice as a historian.},
  note = {
  CORE ARGUMENT: Catana argues that Lovejoy's methodological pronouncements in The Great Chain of Being were strategic rather than accurate descriptions of his actual practice. By tracing Lovejoy's engagement with Bruno, Catana shows that the "unit-idea" method was in practice much closer to nineteenth-century history of philosophy than Lovejoy claimed; the distinction between "history of ideas" and "history of philosophy" was partly motivated by Lovejoy's desire for institutional independence rather than genuine disciplinary difference.

  RELEVANCE: This article directly addresses the history of ideas / history of philosophy distinction from a historical and critical angle, showing that Lovejoy's own foundational distinction is less clean than presented. This complicates the neat taxonomy offered by Mandelbaum and creates space for the hybrid approaches defended by contemporary historians of philosophy.

  POSITION: Critical revision of Lovejoy; questioning the sharpness of the history-of-ideas/history-of-philosophy divide.
  },
  keywords = {Lovejoy, history-of-ideas, history-of-philosophy, Bruno, methodology, Medium}
}

@article{knight2012unit,
  author = {Knight, Carl},
  title = {Unit-Ideas Unleashed: A Reinterpretation and Reassessment of Lovejovian Methodology in the History of Ideas},
  journal = {Journal of the Philosophy of History},
  year = {2012},
  volume = {6},
  number = {2},
  pages = {195--217},
  doi = {10.1163/187226312x650746},
  abstract = {This article argues for an unconventional interpretation of Arthur O. Lovejoy's distinctive approach to method in the history of ideas. It is maintained that the value of the central concept of the `unit-idea' has been misunderstood by friends and foes alike. The commonality of unit-ideas at different times and places is often defined in terms of familial resemblance. But such an approach fails to explain the objective unity of the idea.},
  note = {
  CORE ARGUMENT: Knight defends a reinterpretation of Lovejoy's unit-idea method, arguing that critics have misunderstood the basis on which unit-ideas are identified across historical contexts. He proposes that unit-ideas are unified not by familial resemblance (which would be too loose) nor by strict identity (which would be too rigid) but by a more principled criterion. The article thus rehabilitates a modified Lovejovian approach as a viable alternative to both Cambridge contextualism and analytic appropriationism.

  RELEVANCE: Knight's defense of a refined unit-idea methodology provides a contemporary restatement of the "history of ideas" approach as a middle position between narrow contextualism (which resists cross-contextual comparison) and appropriationism (which ignores historical context). This directly populates the methodological space between the poles of the appropriationism/contextualism debate.

  POSITION: Neo-Lovejovian; revisionist defense of the history of ideas.
  },
  keywords = {Lovejoy, unit-ideas, methodology, history-of-ideas, Medium}
}

@article{beaney2016historiography,
  author = {Beaney, Michael},
  title = {Historiography, Philosophy of History and the Historical Turn in Analytic Philosophy},
  journal = {Journal of the Philosophy of History},
  year = {2016},
  volume = {10},
  number = {2},
  pages = {211--234},
  doi = {10.1163/18722636-12341321},
  abstract = {This article has three main interconnected aims. First, I illustrate the historiographical conceptions of three early analytic philosophers: Frege, Russell and Wittgenstein. Second, I consider some of the historiographical debates that have been generated by the recent historical turn in analytic philosophy, looking at the work of Scott Soames and Hans-Johann Glock, in particular. Third, I discuss Arthur Danto's Analytic Philosophy of History, published 50 years ago, and argue for a reinvigorated analytic philosophy of history.},
  note = {
  CORE ARGUMENT: Beaney traces how the early analytic philosophers (Frege, Russell, Wittgenstein) each held distinctive historiographical self-understandings -- typically dismissive of their own historical predecessors -- and shows how this shaped analytic philosophy's long-standing suspicion of historical inquiry. He then examines the "historical turn" in analytic philosophy exemplified by debates between Soames and Glock, arguing for a revitalized analytic philosophy of history that combines rigor with historical sensitivity.

  RELEVANCE: This article maps the internal debate within analytic philosophy about its relationship to its own history, directly illuminating what is at stake when analytic philosophers either appropriate or historicize earlier texts. The historical turn Beaney documents is what makes contemporary analytic appropriationism more historically informed than its predecessors.

  POSITION: Historical turn in analytic philosophy; argues for methodological middle ground.
  },
  keywords = {analytic-philosophy, historiography, historical-turn, Frege, Russell, Wittgenstein, High}
}

@article{harrelson2014inferentialist,
  author = {Harrelson, Kevin J.},
  title = {Inferentialist Philosophy of Language and the Historiography of Philosophy},
  journal = {British Journal for the History of Philosophy},
  year = {2014},
  volume = {22},
  number = {3},
  pages = {582--603},
  doi = {10.1080/09608788.2014.918022},
  abstract = {This article considers the implications of inferentialist philosophy of language for debates in the historiography of philosophy. My intention is to mediate and refine the polemics between contextualist historians and `analytic' or presentist historians. I claim that much of Robert Brandom's nuanced defence of presentism can be accepted and even adopted by contextualists, so that inferentialism turns out to support neither a straightforwardly presentist nor a straightforwardly contextualist approach.},
  note = {
  CORE ARGUMENT: Harrelson uses Brandom's inferentialist semantics to mediate the debate between contextualists and presentists in the historiography of philosophy, arguing that the inferentialist framework captures what is right in both: texts mean what they normatively commit their authors to, which is partly a matter of context and partly a matter of the inferential role of their claims. Neither pure context nor pure philosophical reconstruction is sufficient.

  RELEVANCE: This article offers a philosophy-of-language grounding for a synthetic position between appropriationism and contextualism, drawing on the very debates within analytic philosophy of language (Brandom vs. Quine/Davidson) that shape contemporary appropriationist arguments. It shows how disputes about linguistic meaning in philosophy of language map onto disputes about historical interpretation.

  POSITION: Inferentialist synthesis; mediating contextualism and presentism.
  },
  keywords = {inferentialism, Brandom, historiography-of-philosophy, contextualism, presentism, Medium}
}

@article{simons2001fault,
  author = {Simons, Peter},
  title = {Whose Fault? The Origins and Evitability of the Analytic--Continental Rift},
  journal = {International Journal of Philosophical Studies},
  year = {2001},
  volume = {9},
  number = {3},
  pages = {295--311},
  doi = {10.1080/09672550110058858},
  abstract = {This is a broad survey of the chronology of the rift between continental and analytic philosophy, starting in 1899. Whereas at that time there was no discernible divide, as the twentieth century progresses we can see a gradual parting of the ways in which philosophy was done, culminating in a period of maximum separation in 1945-68, followed by some convergence.},
  note = {
  CORE ARGUMENT: Simons traces the historical emergence of the analytic-continental rift from 1899 onward, arguing that the divide was not inevitable but resulted from a series of historical contingencies -- institutional, political, and intellectual. He identifies the period 1945-1968 as the period of maximum separation, followed by partial convergence. He assesses responsibility for the rift on both sides.

  RELEVANCE: Understanding the analytic-continental divide as historically contingent rather than philosophically principled is important for assessing whether the different historiographical self-understandings of the two traditions reflect genuine methodological differences or merely disciplinary sociology. This paper contextualizes the "analytic vs. continental" axis of the appropriationism/contextualism debate.

  POSITION: Historical genealogy of the divide; critical of both sides.
  },
  keywords = {analytic-continental, divide, history-of-philosophy, Medium}
}

@article{vrahimis2020pragmatism,
  author = {Vrahimis, Andreas},
  title = {Pragmatism and the History of the Analytic-Continental Divide},
  journal = {International Journal of Philosophical Studies},
  year = {2020},
  volume = {28},
  number = {4},
  pages = {541--554},
  doi = {10.1080/09672559.2020.1812974},
  abstract = {The history of what the title of Baghramian and Marchetti's book refers to as the `Great Divide' between Analytic and Continental philosophy has been the subject of much debate and controversy in recent years.},
  note = {
  CORE ARGUMENT: Vrahimis examines the role of pragmatism in debates about the analytic-continental divide, arguing that pragmatism complicates standard narratives because it shares features with both traditions. He traces debates about the historical origins and character of the divide, attending to the way that historiography of the divide itself shapes how philosophers in each tradition understand their own identity.

  RELEVANCE: This paper illustrates how the history of a disciplinary divide is itself contested, and how different historiographical narratives of the divide serve different philosophical interests -- a meta-level parallel to the appropriationism/contextualism debate about how to do the history of philosophy.

  POSITION: Historiography of the analytic-continental divide; emphasizes pragmatism's complicating role.
  },
  keywords = {analytic-continental, pragmatism, historiography, divide, Medium}
}

@article{shogimen2016elusiveness,
  author = {Shogimen, Takashi},
  title = {On the Elusiveness of Context},
  journal = {History and Theory},
  year = {2016},
  volume = {55},
  number = {2},
  pages = {233--252},
  doi = {10.1111/hith.10798},
  abstract = {How can we decide the pertinent context in which a given object of historical study should be examined? This question has long puzzled historians. In the field of intellectual history, the Cambridge contextual school represented by Quentin Skinner triggered a series of methodological debates about the relevant context for interpreting historical texts.},
  note = {
  CORE ARGUMENT: Shogimen argues that the concept of "context" in Cambridge School intellectual history is insufficiently determinate: there is no principled way to identify which context is the "relevant" one for a given historical text, because any text is embedded in multiple, often incompatible, contexts. The Cambridge School answer (linguistic context, illocutionary conventions) is one methodological choice, not the uniquely correct one.

  RELEVANCE: This is a sophisticated internal critique of Cambridge contextualism that clarifies its limits without endorsing appropriationism. It shows that the contextualist pole of the debate faces its own methodological under-determination problem, which is important for assessing whether a stable contextualist methodology is possible.

  POSITION: Internal critique of Cambridge contextualism; argues context is methodologically underdetermined.
  },
  keywords = {Cambridge-School, context, Skinner, intellectual-history, methodology, Medium}
}

@article{frazer2018ethics,
  author = {Frazer, Michael L.},
  title = {The Ethics of Interpretation in Political Theory and Intellectual History},
  journal = {The Review of Politics},
  year = {2018},
  volume = {81},
  number = {1},
  pages = {77--99},
  doi = {10.1017/s0034670518000967},
  abstract = {Scholars studying classic political texts face an important decision: Should these texts be read as artifacts of history or as sources for still-valid insights about politics today? Competing historical and ``presentist'' approaches to political thought do not have a methodological dispute---that is, a disagreement about the most effective scholarly means to an agreed-upon end. They instead have an ethical dispute about the ends of scholarship and the responsibilities scholars have towards their subjects.},
  note = {
  CORE ARGUMENT: Frazer reframes the debate between historical and presentist readings of classic texts as an ethical rather than methodological dispute: the question is not which approach better recovers meaning, but what kind of responsibility scholars have toward historical authors and toward contemporary audiences. He argues that neither approach is simply "correct" because they serve different and legitimate scholarly purposes.

  RELEVANCE: Frazer's reframing has direct implications for how to understand the appropriationism/contextualism debate: if the disagreement is ultimately ethical (about scholarly obligations), then purely methodological arguments for one side over the other beg the question. This is relevant to assessing the normative stakes of the debate in the anchor volume.

  POSITION: Ethical reframing of the historical/presentist divide; pluralist about legitimate approaches.
  },
  keywords = {ethics-of-interpretation, intellectual-history, contextualism, presentism, High}
}

@article{peden2019truth,
  author = {Peden, Knox},
  title = {Truth and Meaning in Historical Interpretation: A Davidsonian Approach},
  journal = {History and Theory},
  year = {2019},
  volume = {58},
  number = {3},
  pages = {327--341},
  doi = {10.1111/hith.12120},
  abstract = {This essay argues that Donald Davidson's work in philosophy sheds light on debates about truth, meaning, and context in historical interpretation. Drawing on distinctions between Davidson's project and that of his mentor, W. V. O. Quine, I aim to show that certain ambiguities that have arisen in the methodological reflections of Quentin Skinner and Frank Ankersmit can be resolved.},
  note = {
  CORE ARGUMENT: Peden applies Davidson's philosophy of language -- particularly his principle of charity and his externalist account of meaning -- to debates about historical interpretation, arguing that Davidson's framework dissolves certain ambiguities in Skinner's contextualism (about the relationship between meaning and intention) and Ankersmit's narrativism (about the relationship between historical description and truth).

  RELEVANCE: This article bridges analytic philosophy of language and the methodology of intellectual history, showing how debates within philosophy of language (Davidson vs. Quine) ramify into historiographical debates. This is relevant to understanding what analytic resources are available for mediating between appropriationism and contextualism.

  POSITION: Davidsonian philosophy of language applied to historiography; bridges analytic and Cambridge approaches.
  },
  keywords = {Davidson, hermeneutics, meaning, Skinner, Ankersmit, historiography, Medium}
}

@article{roth2016postnarrative,
  author = {Roth, Paul A.},
  title = {Back to the Future: Postnarrativist Historiography and Analytic Philosophy of History},
  journal = {History and Theory},
  year = {2016},
  volume = {55},
  number = {2},
  pages = {270--281},
  doi = {10.1111/hith.10800},
  abstract = {Jouni-Matti Kuukkanen has written an important book. It directly confronts a key theoretical dilemma that has shadowed debate in historiography for several decades: histories cannot be written without using some narrative structure or other, but epistemological evaluation cannot be applied to narratives qua narrative. Thus, if empirical inquiry takes the form of a history, then it cannot yield knowledge.},
  note = {
  CORE ARGUMENT: Roth critically examines postnarrativisism in the analytic philosophy of history, arguing that the attempt to evaluate historical accounts by non-narrative standards (e.g., by decomposing them into truth-evaluable sentences) fails to engage with what is distinctive about historical understanding. Narrative structure is not an accidental feature of histories but constitutive of how historical knowledge is organized and communicated.

  RELEVANCE: This article addresses the analytic philosophy of history and its relationship to narrative -- an issue that intersects with hermeneutics (Ricoeur's work on narrative) and with debates in intellectual history about how to organize historical accounts of philosophical development (diachronic vs. synchronic reading).

  POSITION: Analytic philosophy of history; critical of naive decompositionalism; supports attention to narrative structure.
  },
  keywords = {analytic-philosophy-of-history, narrative, postnarrativism, historiography, Medium}
}

@book{lapointe2023historiography,
  author = {Lapointe, Sandra and Reck, Erich H.},
  title = {Historiography and the Formation of Philosophical Canons},
  year = {2023},
  publisher = {Routledge},
  doi = {10.4324/9781003184294},
  abstract = {This book presents a series of case studies and reflections on the historiographical assumptions, methods, and approaches that shape the way in which philosophers construct their own past. The chapters in the volume advance discussion of the methods of historians of philosophy, while at the same time illustrating the various ways in which philosophical canons come into existence, debunking the myth of analytical philosophy's ahistoricism, and providing a deeper understanding of the roles historians of philosophy play in constructing philosophical traditions.},
  note = {
  CORE ARGUMENT: Lapointe and Reck argue, through case studies, that philosophical canons are historiographical constructions rather than natural kinds, and that analytic philosophy's self-image as ahistorical is a myth -- analytic philosophers have always engaged in canon-formation. The volume examines how different historiographical approaches (presentist, contextualist, hybrid) shape what counts as "the tradition" in different philosophical communities.

  RELEVANCE: This volume is directly relevant to the appropriationism/contextualism debate because it shows that both approaches have consequences for canon formation, and that choices about methodology in the history of philosophy are never politically or institutionally neutral. It also debunks the narrative that contextualism is a more "historical" approach -- analytic appropriationism also makes history, just differently.

  POSITION: Historiography of canon-formation; analytic tradition's historical turn.
  },
  keywords = {canon-formation, analytic-philosophy, historiography, High}
}

@article{beaney2018historiography2,
  author = {Mudrovcic, Maria Ines},
  title = {Time, History, and Philosophy of History},
  journal = {Journal of the Philosophy of History},
  year = {2014},
  volume = {8},
  number = {2},
  pages = {217--242},
  doi = {10.1163/18722636-12341272},
  note = {
  CORE ARGUMENT: Mudrovcic examines the relationship between conceptions of time and the methodology of history, arguing that different theories of historical time -- linear, cyclical, kairotic -- generate different conceptions of historical intelligibility and different standards for what counts as a successful historical explanation. The synchronic/diachronic distinction in historiography reflects deeper commitments about how time structures historical change.

  RELEVANCE: This article provides theoretical grounding for the synchronic/diachronic distinction that arises in historiography of philosophy: whether to read a philosophical text as a moment in a temporal development (diachronic) or as a self-contained system with its own internal logic (synchronic) reflects assumptions about historical time. This is directly relevant to assessing when appropriationist "rational reconstructions" are appropriate.

  POSITION: Philosophy of history; temporal ontology of historical explanation.
  },
  keywords = {synchronic, diachronic, philosophy-of-history, time, Low},
  abstract = {In this paper, I intend to show that different ways of describing, representing or thinking about human affairs presuppose different types of consciousness of temporality. This proposal is embedded in the fruitful concept ‘régimes d’historicités’, which was coined by F. Hartog. Within this context and in regard to historiography and the philosophy of history, I will try to show that these disciplines and concepts, coined by these fields of study, are only possible in a temporal order governed by the future. Within this context, I will examine historiography, understood as the discipline which makes sense of human past and other disciplines, including the analytical or narrativist philosophies of history, which have yielded concepts such as the ‘historical past’, ‘historical consciousnesses’ and ‘historical time’.},
  abstract_source = {openalex},
}

@article{diggins2006lovejoy,
  author = {Diggins, John P.},
  title = {Arthur O. Lovejoy and the Challenge of Intellectual History},
  journal = {Journal of the History of Ideas},
  year = {2006},
  volume = {67},
  number = {1},
  pages = {181--208},
  doi = {10.1353/jhi.2006.0003},
  note = {
  CORE ARGUMENT: Diggins examines Lovejoy's legacy as founder of intellectual history as a discipline, arguing that Lovejoy posed a challenge that remains unresolved: how to trace ideas across historical contexts without either collapsing into a history of individual thinkers (biography) or losing contact with specific historical agents and texts. The article traces how Lovejoy's successors in American intellectual history responded to and modified his methodology.

  RELEVANCE: This article provides intellectual-historical context for understanding why Lovejoy's "history of ideas" approach was institutionally and methodologically important, what it was reacting against (narrative philosophical history focused on great thinkers), and why it has been both influential and contested. The tension between tracing ideas and recovering agents' intentions is the same tension that structures the appropriationism/contextualism debate.

