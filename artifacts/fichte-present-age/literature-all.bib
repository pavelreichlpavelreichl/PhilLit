@article{chaput2025hegel,
    author = "Chaput, Emmanuel",
    title = "‘Die Weltgeschichte ist das Weltgericht’: Hegel's Early Critique of Fichte's Doctrine of Right (Jena 1801-1806)",
    journal = "History of Political Thought",
    year = "2025",
    volume = "46",
    number = "3",
    pages = "501--526",
    doi = "10.53765/20512988.46.3.501",
    note = "CORE ARGUMENT: Argues that Hegel's Jena critique of Fichte, often dismissed as unoriginal, has force when its empirical side is considered, i.e. his critique of Fichte's doctrine of right, and anticipates Hegel's later approach. RELEVANCE: Documents the Hegelian objection to Fichte's a priori construction of right and state over the same years as the Grundzuege (1801-1806); no direct discussion of the Grundzuege in the abstract. Language: English. POSITION: Hegelian critique of Fichtean transcendental politics.",
    keywords = "Hegel, Fichte, doctrine of right, critics, Medium",
    abstract = "In this paper, I present Hegel’s critique of Fichte’s political thought during the Jena period. Hegel’s general critique of Fichte has often been disregarded as unconvincing and unoriginal, but I argue that when one focuses on the specifically empirical aspects of abstract\_source = {s2}, Hegel’s critique, Fichte’s doctrine of right, one can actually see not only the validity of Hegel’s position, but its originality. I take it to be indicative of Hegel’s future approach to philosophy, and as such, as an important step in his intellectual development. Focusing on the specifically empirical dimension of Hegel’s critique could seem somewhat surprising since Fichte’s transcendental approach should be immune to such a non-transcendental critique. But I take Hegel’s point to be that insofar as Fichte commits to the ideal of a systematic philosophy which includes a doctrine of right, the empirical and historical should be understood as valid judicative instances for judging such a transcendental approach of right in order to avoid the accusation of formalism. In the end, I show how, according to Hegel, because of his transcendental presuppositions, Fichte can escape neither the accusation of formalism nor the judgment of history. This in turn points out the importance of Hegel’s critique as a manifestation of the early stages of what will soon be Hegel’s own philosophical position as presented in the Phenomenology of Spirit."
}

@article{kildyushov2022police,
    author = "Kildyushov, O. V.",
    title = "The police state as a symptom: German classical philosophy and modern biopolitics (Hegel vs Fichte)",
    journal = "RUDN Journal of Sociology",
    year = "2022",
    volume = "22",
    number = "3",
    pages = "503--517",
    doi = "10.22363/2313-2272-2022-22-3-503-517",
    note = "CORE ARGUMENT: Reconstructs the Hegel-Fichte discussion of police as an early modern form of biopolitical control and argues that the idealists' critique of policing is paradigmatic for present-day analysis of the sanitary-police state. RELEVANCE: Shows a contemporary reapplication of Fichte's state theory in a debate on state control; Grundzuege not specifically addressed. Language: English. POSITION: Biopolitical reading of the Hegel-Fichte dispute.",
    keywords = "Fichte, Hegel, police state, biopolitics, Low",
    abstract = "The article considers a little-known topic in the history of the social thought, which has regained relevance under the pandemic - the discussion between the outstanding philosophers of the German idealism on the conceptual interpretation of police as an earlymodern form of biopolitical control. In the introductory part, the author argues that the critique of the science and practice of policing by the classics of the German idealism is paradigmatic for the present-day study of the new/old functions and powers of the sanitary-police state concerning the modern civil society’s self-reflection. In the first part, the author describes the tension between the Enlightenment philosophy and the ‘science of policing’ developed by the Cameralists of the 17th-18th centuries, and emphasizes the significant intellectual contribution of the Enlightenment thinkers, primarily Kant’s legal doctrine, to the radical innovations in the political semantics at the turn of the 18th-19th centuries. Such innovations became the philosophical basis for the rule of law which questioned the discourse of the absolutist state control over its subjects’ welfare by means of police. In the second part, the article presents a brief reconstruction of Fichte’s attempts to combine the old Cameralist ideas with the new modern principles of individual freedoms at the end of the 18th-century era of the science of police - after Kant’s explicit criticism of the state care unauthorized from below. The third part of the article focuses on Hegel’s critique: in the history of the political thought he was often considered an apologist of the authoritarian Prussian state, but questioned the very possibility of the police-scientific idea of the total biopolitical control over social and economic activities of free modern-type individuals. The author reconstructs Hegel’s argumentation of the absurdity of the total sanitary-police regulation as suggested by Fichte, and insists on the relevance of these thinkers, concepts and thematic fields for reconsidering the failure of the Early-Modern biopolitical utopia under the current intersections of lockdowns and sovereignty.",
    abstract_source = "s2"
}

@article{cunha2017rousseau,
