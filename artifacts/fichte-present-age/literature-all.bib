@misc{james2017selfmastery,
    author = "James, David",
    title = "Self-mastery and universal history",
    year = "2016",
    volume = "43",
    note = "CORE ARGUMENT: Horkheimer and Adorno seem to reject universal history; using Kant's account, the article argues that features of that idea can be detected in the Dialectic of Enlightenment (rational self-mastery as a condition of a freer society) and that Adorno's preservation of contingency saves the possibility of progress. RELEVANCE: Joins the Kant-on-progress and Frankfurt School questions; shows how a Kantian universal history can be defended against Adorno, a model for assessing Fichte's more teleological history. Fichte and the Grundzuege are not named in the abstract. Language: English. POSITION: Kantian reconstruction of progress within Frankfurt School critique.",
    keywords = "James, universal history, Kant, Adorno, progress, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Horkheimer and Adorno make claims that imply a complete rejection of the idea of a universal history developed in classical German philosophy. Using Kant’s account of universal history, I argue that some features of the idea of a universal history can nevertheless be detected in the Dialectic of Enlightenment and some of Adorno’s remarks on freedom and history. This is done in connection with the kind of rational self-mastery that they associate with the story of Odysseus. Some claims made by Adorno in particular will be shown to imply that this self-mastery is a necessary condition of a better, freer society, especially in relation to this society’s material conditions. On the other hand, certain essential features of the idea of a universal history are clearly absent in virtue of the ultimate contingency of events and states of affairs that Adorno seeks to preserve. I show that the absence of these features and the preservation of contingency are, in fact, the means of saving the notion of the possibility of progress which informs the idea of a universal history.",
    abstract_source = "openalex"
}

@article{utteich2020grundzuege,
    author = "Utteich, Luciano Carlos",
    title = "Educación al revés de la letra en las Lecciones Sexta y Séptima de los Grundzüge (1806)",
    journal = "Cadernos de Filosofia Alemã: Crítica e Modernidade",
    year = "2020",
    volume = "25",
    number = "2",
    pages = "193--221",
    doi = "10.11606/issn.2318-9800.v25i2p193-221",
    note = "CORE ARGUMENT: Examines Lectures 6 and 7 of the Grundzuege on the interval between the third and fourth ages of humanity: the third age represents a false autonomy won by the letter (printing) against the spirit, whose true source is oral communication; Fichte prepares the necessary transition to the fourth age. RELEVANCE: Central, lecture-level treatment of the Grundzuege's cultural criticism (media, print, education), within a journal devoted to German philosophy as critique of modernity. Language: Spanish. POSITION: Reading of the Grundzuege as educational Kulturkritik.",
    keywords = "Fichte, Grundzuege, education, print, cultural critique, central, High",
    abstract = "Fichte abordó en las Lecciones Sexta y Séptima de Los Caracteres de la Edad Contemporánea [Die Grundzüge des gegenwärtigen Zeitalters, 1806] una importante cuestión relativa al intervalo entre dos períodos o edades, la tercera y la cuarta edad de la humanidad, en su relación de oposición y complementariedad. Para él había llegado el momento de preparar la necesaria transición de la tercera a la cuarta edad de la humanidad, ya que la tercera representaba una falsa autonomía lograda por la letra (por la imprenta) frente al espíritu, siendo éste la verdadera fuente de vivacidad en los asuntos humanos desde su marco inicial, la comunicación oral. En nuestro texto contextualizamos brevemente el tema de los criterios de lectura que presupone la verdadera ciencia de la razón como requisito que apunta a este momento previo en el que la propia letra (discurso escrito o impreso) se genera en la dimensión del espíritu, como la actividad verdaderamente viva que satisface todas las necesidades del pensamiento, ya sea filosófico o literario, en la sociedad.",
    abstract_source = "s2"
}

