@article{schwenzfeuer2020gelehrte,
    author = "Schwenzfeuer, Sebastian",
    title = "Über den Gelehrten als Erzieher der Menschheit. Fichte im Kontext der Bildungsdiskurse bei Kant und Schiller",
    journal = "Fichte Studien",
    year = "2020",
    volume = "48",
    note = "CORE ARGUMENT: Argues that in the Jena lectures on the scholar's vocation Fichte sees the realisation of humanity in a society based on division of labour as a place of reciprocal perfection, contrary to Schiller's 1795 criticism of division of labour as fragmentation, starting from the Kantian premise of the human being as a project. RELEVANCE: A direct comparison of Fichte's and Schiller's evaluation of social differentiation, useful for contrasting their diagnoses of the age; concerns the Jena lectures, not the Grundzuege. Language: German. POSITION: Fichte as a counterposition to Schiller's Kulturkritik.",
    keywords = "Fichte, Schiller, Kant, Bildung, division of labour, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "The paper deals with Fichte’s concept of education in his popular Jena Lectures Concerning the Scholar’s Vocation. There, Fichte thinks the scholar as the educator of mankind. The aim is to show that the concept of being human, as interpreted by practical philosophy, can, in Fichte’s viewpoint, only find its realization in a society based on division of labour, as a place of reciprocal perfection. His social theory is markedly contrary to Schiller’s critical evaluation of this division of labour as fragmentation and onesidedness of humanity in his Letters on the Aesthetic Education of Mankindpublished in 1795. Starting from the Kantian premise of human being as a project, that is as an object of practical philosophy and education, Fichte and Schiller both articulate its consequences in opposite directions: Fichte in the form of the scholar as the expression of a specialized education, Schiller in the form of the artist as the expression of an all-round and harmonic education.",
    abstract_source = "openalex"
}

