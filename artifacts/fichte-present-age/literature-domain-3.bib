@misc{reichl2021firstprinciples,
    author = "Reichl, Pavel",
    title = "The Role of First Principles in Fichte's Philosophy of History",
    year = "2021",
    doi = "10.1163/9789004459793\_015",
    note = "CORE ARGUMENT: Explores the role of the first principle in Fichte's philosophy of history and whether it resolves problems left by predecessors, asking how history can be grasped systematically for theoretical cognition. Reichl credits Fichte with an innovative resolution of the tension between Herder's pluralism and Kant's chiliasm, but judges that the first principle fails to put historiography on a firmer scientific footing (abstract as paraphrased from the PhilPortal record). Language: English. Engagement with Grundzuege: unverified. RELEVANCE: Squarely on the a priori vs. empirical question and positions Fichte between Kant and Herder; offers a critical verdict on the project's success. POSITION: Critical-systematic assessment; Fichte as mediator between Herder and Kant.",
    keywords = "Fichte, Herder, Kant, a priori history, English, chapter, High, METADATA\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc",
    abstract = "In this article, I explore the role of the first principle in Fichte’s philosophy of history and assess the extent to which its introduction is able to resolve problems in the philosophies of history of his predecessors. Particularly, I focus on Fichte’s response to the question of how history can be grasped in a systematic manner for the purposes of theoretical cognition. I argue that while Fichte is able to resolve the tension between Herder’s pluralism and Kant’s chiliasm in an innovative manner, the deployment of his first principle is ultimately unsuccessful in establishing historiography on a firmer scientific foundation.",
    abstract_source = "openalex"
}

@article{heinrichs2003mitte,
    author = "Heinrichs, Johannes",
    title = "Die Mitte der Zeit als Tiefpunkt einer Parabel",
    journal = "Fichte-Studien",
    year = "2003",
    volume = "23",
    doi = "10.5840/fichte20032370",
    note = "CORE ARGUMENT: Asks whether Fichte's Geschichtskonstruktion in the Grundzuege (1804/1806) has scientific-philosophical plausibility and coherence; treats the contested link between philosophy of history and philosophy of religion, esp. Fichte's interpretation of Christianity; adds a note on the diagnostic relevance for the present. Language: German. Engagement with Grundzuege: central. RELEVANCE: A direct test of the coherence of the five-epoch construction, with heavy textual evidence; relevant to the status of the actual historical claims (Christianity, middle epochs). POSITION: Critical-reconstructive reading of the Geschichtskonstruktion.",
    keywords = "Fichte, Grundzuege, Geschichtskonstruktion, Christianity, German, central, High, METADATA\_CLEANED: pages",
    abstract = "Hat Fichtes Geschichtskonstruktion in den „Grundzügen des gegenwärtigen Zeitalters“ (von 1804/1806) wissenschaftlich-philosophische Plausibilität und Kohärenz? Dies ist die Frage des ersten Hauptteils dieser Untersuchung (I). Dazu wird sich als notwendig erweisen, auf den kontroversen Zusammenhang von geschichtsphilosophischer und religionsphilosophischer Sichtweise, insbesondere auf Fichtes Deutung des Christentums, einzugehen (II). In einem dritten Teil soll wenigstens knapp auf die zeitdiagnostischen Aktualität dieser Geschichtskonstruktion gerade für unsere Gegenwart eingegangen werden (III). Da die Darlegungen in Teil I und II sich als unerwartet kontrovers herausstellten, wird trotz angezielter Knappheit erhöhter Wert auf ausführliche Textbelege gelegt.",
    abstract_source = "s2"
}

@misc{fusaro2016historical,
    author = "Fusaro, Diego",
    title = "Science of knowledge and historical experience",
    year = "2016",
    volume = "15",
    pages = "37--63",
    doi = "10.15633/ss.1767",
    note = "CORE ARGUMENT: Explores key passages of the Grundzuege (1806) on historical narrative and historiography: the specific status of Historie and the differences between the functions of the Wissenschaftslehrer and the Historiker, and the link between them (abstract). Language: English. Engagement with Grundzuege: central. RELEVANCE: Addresses the methodological opening lectures, i.e., how a priori philosophical construction and empirical historiography are divided and related. POSITION: Methodological reading of the Wissenschaftslehre-Historie relation.",
    keywords = "Fichte, Grundzuege, Historie, historiography, English, central, High, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "This paper sets out as its objective the exploration of some of the key passages and most relevant theoretical plexuses of the Grundzuge des gegenwartigen Zeitalters (1806) by Johann Gottlieb Fichte devoted to the theme of historical narrative and, more generally, of historiography. In particular, we will first of all aim to show the specific status of Historie. Secondly, we will try to outline the differences that Grundzuge establishes between the functions of Wissenschaftslehrer and those of Historiker, in an attempt to show, at the same time, the nexus linking the two and the activities they perform.",
    abstract_source = "s2"
}

