@misc{ries2018mythos,
    author = "Ries, Klaus",
    title = "Mythos Fichte: Die Reden an die deutsche Nation als universalistischer Appell",
    year = "2018",
    volume = "45",
    note = "CORE ARGUMENT: Reinterprets the Reden as universalist rather than nationalist, with nationalism subordinate to the world-historical concept Fichte developed in the Grundzuege (PhilPapers abstract). Language: German. Engagement: chapter-level (frames the Reden through the Grundzuege). RELEVANCE: Shows a modern revisionist argument that links the Reden to the Grundzuege; bears on whether the work was read apart from the Reden. POSITION: Revisionist anti-nationalist reading.",
    keywords = "Grundzuege, Reden, nationalism, revisionism, German, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article tries to undertake a new interpretation of the Reden an die deutsche Nation (1807/08) of Johann Gottlieb Fichte. The center of Fichte’s thinking is not nationalism but universalism. Fichte develops his universalistic concept in his essay Grundzüge des gegenwärtigen Zeitalters (1804/05) just before he delivered his Reden an die Deutsche Nation. His nationalism was merely a means for highlighting his universalistic and cosmopolitan project. His nationalism in the latter work only served to emphasize his universalism.",
    abstract_source = "openalex"
}

