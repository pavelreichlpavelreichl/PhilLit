    doi = "10.28937/978-3-7873-2604-4",
    note = "CORE ARGUMENT: Modern reading edition of the primary text (Meiner, Philosophische Bibliothek). PhilPapers also lists a 1956 Meiner Neudruck of the Medicus 1922 edition with Diemer's introduction. Language: German. Engagement: central (the text itself). RELEVANCE: Gives the textual basis for assessing 19th-century circulation: the 1806 first edition, I. H. Fichte's Saemmtliche Werke vol. 7 (Zur Politik, Moral und Philosophie der Geschichte, which per PhilPapers contains the Grundzuege), and 20th-century reprints. Needed to check what readers before 1900 could actually consult. POSITION: Primary text / edition.",
    keywords = "primary-text, edition, Grundzuege, German, Medium, METADATA\\_CLEANED: publisher, type:@book->@misc",
    abstract = "In diesen von ihm selbst zum Druck gegebenen Vorlesungen gibt Fichte eine »an ein größeres Publikum« gerichtete Darstellung seiner Staats- und Geschichtsphilosophie vor einem alles überlagernden religiösen Hintergrund. Religion besteht darin, »daß man all",
    abstract_source = "openalex"
}

