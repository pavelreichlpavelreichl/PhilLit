@article{bazzan2026summons,
    author = "Bazzan, Marco Rampazzo",
    title = "Summons and Counter-Summons: Machiavelli, Rhetoric, and Political Intervention in Fichte's Later Thought (1807--1813)",
    journal = "Open Philosophy",
    year = "2026",
    volume = "9",
    number = "1",
    doi = "10.1515/opphil-2025-0110",
    note = {CORE ARGUMENT: Argues that Fichte's rehabilitation of Machiavelli (essay of 1807, Vesta) reveals the core features of his political philosophy and its political character. Through the category of Aufforderung (summons) and a "rhetoric of summons" as structural principle of the Reden, Fichte's political writings during the Wars of Liberation (1807-1813) form a coherent project of ideological and political intervention, culminating in the figure of the Zwingherr. RELEVANCE: Recent treatment of the Machiavelli essay, Reden and Applied Philosophy lectures; helps frame the post-1806 political turn in relation to the Grundzuege. Engagement with Grundzuege: passing/outside period (starts 1807). Language: English. POSITION: Rhetorical-political reading of the late political writings.},
    keywords = "Fichte, Machiavelli, rhetoric, Reden, Medium",
    abstract = "Abstract This paper examines the profound impact of Machiavelli’s oeuvre on Fichte, focusing in particular on the writings and lectures that followed his 1807 essay published in the patriotic journal Vesta. It argues that Fichte’s rehabilitation of Machiavelli exceeds occasional or purely exegetical commentary and instead reveals the core features of his political philosophy, as well as the inherently political character of his philosophical praxis. The analysis is developed through the category of “summons” (Aufforderung), first introduced in Foundations of Natural Right (1796), and through the notion of “rhetoric of summons” as the basic structural principle of the Addresses to the German Nation. Originally conceived as a call issued by one subject to another, inviting the latter to actualize their free efficacy, the summons articulates an educational rather than a strictly juridical relation. Through the rhetoric of summons, Oesterreich and Traub identify the fundamental structure of the Addresses, insofar as it prepares the rhetorical constitution of a people within the sphere of political and popular public opinion. I contend that the concept and the rhetoric of summons are pivotal for understanding the rhetorical-political dimension of Fichte’s later works, including the essay On Machiavelli, the Addresses to the German Nation, and the Lectures on Applied Philosophy. These texts can be read as “counter-summonses” or “counter-interpellations” aimed at mobilizing their audience against the dominant governmental discourse of the time. In this way, Fichte’s political writings during the Wars of Liberation (1807–1813) emerge as a coherent project of ideological and political intervention, culminating in the figure of the Zwingherr.",
    abstract_source = "s2"
}

@misc{acosta2019nature,
    author = "Acosta, Emiliano",
    title = "Nature and perpetual peace in Kant and Fichte's cosmopolitanism",
    year = "2019",
    volume = "52",
    note = "CORE ARGUMENT: Compares the concept of nature in Kant's and Fichte's proposals for perpetual peace: Kant administers the unsociable inclinations as the motor of historical progress, whereas Fichte, departing from a different postulate, advocates their total repression. RELEVANCE: Systematic comparison for the cosmopolitanism and peace side of the state question; a companion 2018 conference paper by the same author surveys several forms of cosmopolitanism in Fichte. Engagement with Grundzuege: not verified. Language: English. POSITION: Kant-Fichte comparison of cosmopolitanism and peace.",
    keywords = "Fichte, Kant, cosmopolitanism, perpetual-peace, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This is a comparative study of the concept of nature in Kant and Fichte’s proposals for perpetual peace. I will argue that Kant and Fichte’s ideas of perpetual peace present two very different ways of dealing with nature: whereas Kant’s proposal consists of administrating the natural unsociable inclinations of human beings, departing from the assumption that the unsociable sociability of men is not only inherent to human nature but also the motor of the historical progress of humanity, Fichte, on the contrary, advocates for a total repression of these inclinations, departing from the postulate that the historical progress of humanity concerns exclusively the spiritual or intelligible dimension of human existence.",
    abstract_source = "s2"
}

