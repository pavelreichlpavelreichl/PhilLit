@article{rametta2026staatslehre,
    author = "Rametta, Gaetano",
    title = "“Wissenschaftslehre” and “Staatslehre” in Fichte's Late Works",
    journal = "Fichte Studien",
    year = "2026",
    volume = "54",
    doi = "10.1163/18795811-05401016",
    note = "CORE ARGUMENT: Analyses the structural unity of Wissenschaftslehre and Staatslehre in the late works: the multiplicity of WL expositions is an essential feature of its identity, grounded in the self-manifestation of the Absolute through consciousness, and philosophical Einsicht is the medium through which theory is transfigured into life and action; the Staatslehre introduces Christ as the absolute (abstract truncated). Language: English. Engagement with Grundzuege: not verified. RELEVANCE: Recent argument connecting speculative Absolute, Christ and political transformation, bearing on sacralization/secularization and on the dependence of the historical lectures on late metaphysics. POSITION: Unity of late WL and political-theological doctrine.",
    keywords = "late Fichte, Absolute, Christ, Staatslehre, English, passing, High, METADATA\_CLEANED: number, pages",
    abstract = "abstract\_source = {s2}, The paper analyzes the structural unity between Wissenschaftslehre and Staatslehre in Fichte’s late works, emphasizing their convergence in a philosophical project that integrates speculative insight and political transformation. The multiplicity of expositions of the Wissenschaftslehre is interpreted as an essential feature of its identity, grounded in the dynamic self-manifestation of the Absolute through consciousness. Philosophical insight ( Einsicht ) becomes the medium through which theory is transfigured into life and action. The Staatslehre introduces Christ as the absolute historical fact that enables a shift from a pre-modern political theology based on miracles and coercion to a post-Christian order grounded in freedom and rational self-determination. Sovereignty, traditionally legitimized by revelation or contract, is reconfigured as the unfolding of transcendental intelligence within a community. The dissolution of theological–political authority culminates in a constitutional model in which reason itself governs. In this framework, the Wissenschaftslehre emerges as both speculative doctrine and political constitution, replacing faith with self-conscious insight as the foundation of political legitimacy."
}

@article{schick2024widerspruch,
    author = "Schick, Stefan",
    title = {Widerspruch und Dialektik in der Sp{\"a}tphilosophie Fichtes},
    journal = "Fichte Studien",
    year = "2024",
    volume = "53",
    note = "CORE ARGUMENT: Reports a view in Fichte scholarship that the 1804 Wissenschaftslehre first presents contradiction as a productive principle of thought, in contrast to the Jena WL, since the Absolute is no longer identified with self-consciousness and is grasped in its incomprehensibility; examines this change in the position of contradiction (abstract partly seen). Language: German. Engagement with Grundzuege: none. RELEVANCE: Supplies one argument for a systematic break at 1804, relevant to whether the lectures' metaphysics depends on a late turn. POSITION: Discontinuity thesis (qualified).",
    keywords = "late Fichte, contradiction, Absolute, German, passing, Medium, METADATA\_CLEANED: number, pages, doi",
    abstract = "abstract\_source = {s2}, Nach einer in der Fichte-Forschung mehrfach vertretenen Ansicht stellt erstmals Fichtes Wissenschaftslehre von 1804 den Widerspruch als produktives Prinzip zur Bewegung des Denkens in aller Klarheit heraus. Anders als seine Jenaer Wissenschaftslehre affirmiere Fichtes Spätphilosophie den Widerspruch, da er das nicht mehr mit dem Selbstbewusstsein identifizierte Absolute im vollen Bewusstsein seiner Unbegreiflichkeit begreifen wolle. Die veränderte Stellung des Widerspruchs resultiere also aus Fichtes Versuch, das Denken in ein Verhältnis zum Absoluten als seiner unvordenklichen Voraussetzung zu setzen. Der Beitrag untersucht diese These von der veränderten, affirmativen Stellung des Widerspruchs in Fichtes Spätphilosophie. Dabei wird für folgende Position argumentiert: Logisch ändert sich der Status des Widerspruchs nicht. Der Widerspruch hat in Fichtes Spätphilosophie darüber hinaus immer noch den selben Grund wie in der Jenaer WL: nämlich den Bezug des Ich auf das Andere seiner selbst. Insofern dieses nun aber nicht mehr als durch das absolute Ich bedingte Setzung, sondern als absolute Voraussetzung eines nun seinerseits bedingt-unbedingten Ich verstanden wird, kann Fichte den Widerspruch in der Konzeption des Ich, der seine frühe Grundlage zu kontaminieren droht, auflösen."
}

