@article{jaenecke2023phaenomenologie,
    author = "Jaenecke, Jan Niklas",
    title = {Fichtes Darstellung der genetischen Ph{\"a}nomenologie in der Anweisung zum seligen Leben},
    journal = "Fichte Studien",
    year = "2023",
    volume = "52",
    note = "CORE ARGUMENT: Argues through text-immanent study of key passages (GA I/9) that the Anweisung offers an independent, self-contained summary of the main results of Fichte's late Wissenschaftslehre, especially its genetic phenomenology (Seins- und Daseinslehre, Bildlehre, Stufenlehre). Language: German. Engagement with Grundzuege: none verified. RELEVANCE: Supports the claim that the popular Anweisung carries the same metaphysics as the late WL, and thereby the dependence question for Absolute/Leben/Liebe. POSITION: Continuity between popular and scientific presentations.",
    keywords = "Anweisung zum seligen Leben, genetic phenomenology, German, passing, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "abstract\_source = {s2}, Das Ziel dieses Beitrages besteht in der Darstellung und Auslegung der wesentlichen Gedankenfiguren der Anweisung zum seligen Leben (besonders AzsL GA I/9, 85–90, 96–101, 104–106, 142–147, 165–169), die Fichte zur synoptischen Zusammenfassung der Ergebnisse seiner späten Wissenschaftslehre, insbesondere seiner genetischen Phänomenologie (Seins- und Daseinslehre, Bildlehre, Stufenlehre), nutzt. Dabei soll in einem ersten Schritt durch textimmanente Untersuchungen nachgewiesen werden, dass Fichte eine selbstständige und in sich geschlossene Zusammenfassung der Hauptergebnisse der späten Wissenschaftslehre zur Darstellung bringt, die sich nach dem Schema „Sein – Dasein – Begriff – Ich – Liebe“ vollzieht. Hauptthese ist dabei, dass die Anweisung darlegt, wie die Äußerung des Seins (Seins- und Daseinslehre) im Dasein (Bildlehre) an das Sein durch die Liebe (Stufenlehre) rückgebunden wird. Ausgehend von diesen Überlegungen soll in einem zweiten Schritt auf den Ort und auf die Rolle der Anweisung in der Systemarchitektonik der Philosophie Fichtes eingegangen werden. Durch die Bestimmung der Systemstelle der Anweisung kann gezeigt werden, dass die genetische Phänomenologie der späten Wissenschaftslehre in der Anweisung synoptisch zusammengefasst wird."
}

