    {
      "paperId": "5873bf20cb9051fe53e641713b7e17907276204d",
      "title": "Kantian ethics and African philosophy",
      "authors": [
        {
          "name": "M. Ajei",
          "authorId": "103319917"
        },
        {
          "name": "Katrin Flikschuh",
