    {
      "paperId": "948882c3e0ec062d6f9f374c8962da609a5d878a",
      "title": "Coloniality of Power and Coloniality of Gender: Sentipensar the Struggles of Indigenous Women in Abya Yala from Worlds in Relation",
      "authors": [
        {
          "name": "Carmen Cari\u00f1o",
          "authorId": "2191082215"
        },
        {
          "name": "Alejandro Montelongo Gonz\u00e1lez",
