    {
      "openalex_id": "W4281296279",
      "doi": "10.1017/s0922156521000716",
      "title": "Reception, context and canonicity: The demonization, normalization and eventual proliferation of G. W. F. Hegel in international relations",
      "authors": [
        {
          "name": "Se\u00e1n Molloy",
