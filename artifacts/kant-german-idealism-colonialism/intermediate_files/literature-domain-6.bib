@comment{
====================================================================
DOMAIN: Postcolonial and Decolonial Critiques of the German Idealist Canon
SEARCH_DATE: 2026-06-27
PAPERS_FOUND: 16 total (High: 9, Medium: 5, Low: 2)
SEARCH_SOURCES: SEP, IEP, PhilPapers, Semantic Scholar, OpenAlex, CrossRef
====================================================================

DOMAIN_OVERVIEW:
This domain encompasses the body of work from postcolonial theory, decolonial
philosophy, Africana philosophy, and critical philosophy of race that
interrogates how Kant, Hegel, and the Enlightenment canon are implicated in
the production and legitimation of European colonialism and racial hierarchy.
The central debate concerns whether Enlightenment universal reason is
structurally racialized---whether its claim to universality conceals or
constitutes a coloniality of knowledge---or whether it retains emancipatory
resources that can be appropriated by non-European subjects against colonial
domination.

Three major strands structure this domain. First, the critique of Kant's
racial anthropology: Eze's argument that Kant's theory of race is not
incidental but is integrated into his anthropology, empirical geography, and
philosophy of history; Mills's argument that the "Racial Contract" underlies
the social contract tradition, rendering liberal theory structurally white-
supremacist. Second, the critique of Hegelian teleology and recognition: the
charge that Hegel's philosophy of history excludes Africa from world-historical
development; the Fanonian rewriting of Hegelian recognition from the standpoint
of the colonized, showing that the master-slave dialectic does not operate as
Hegel claimed under conditions of racial slavery; Buck-Morss's argument that
Hegel's master-slave dialectic was in fact inspired by the Haitian Revolution.
Third, the decolonial critique of modernity/coloniality: Quijano's coloniality
of power, Mignolo's critique of Eurocentrism as a colonial matrix of knowledge,
and Dussel's transmodernity as a response to Hegel's Eurocentrism from Latin
American liberation philosophy. Wynter contributes a distinct argument that the
Western "Man" as overrepresentation of the human must be dismantled.

RELEVANCE_TO_PROJECT:
This domain provides the critical external framework against which the
Kant-colonialism debate must be assessed: whether defenses of Kant's universal
morality adequately address the structural racial logic Eze and Mills identify,
and whether Hegelian recognition theory can survive the Fanonian critique
without being fundamentally transformed. The decolonial tradition (Mignolo,
Dussel, Quijano) challenges the project of revising or rehabilitating
Enlightenment philosophy from within, insisting that epistemic decolonization
requires delinking from European modernity rather than merely correcting its
excesses.

NOTABLE_GAPS:
Wynter's full argument about the overrepresentation of Man is underrepresented
in philosophy literature (most citations are from cultural studies); Ngugi wa
Thiong'o's and Wiredu's critiques of European conceptual colonialism in
language and African philosophy are not well-covered by available philosophy
databases. Said's Orientalism (1978) was not findable with a DOI for a book
entry; the original Spivak "Can the Subaltern Speak?" (1988 book chapter in
Marxism and the Interpretation of Culture) was not directly indexable.

SYNTHESIS_GUIDANCE:
The key tension to foreground is between the immanent critique strategy (Mills,
Gordon, Bird-Pollan: using Kantian or Hegelian resources against colonialism)
and the decolonial break strategy (Mignolo, Wynter: the colonial matrix is
constitutive, requiring epistemic delinking). The Fanon-Hegel interface (Ng,
Faustino) shows this tension operating within a single thinker.

KEY_POSITIONS:
- Racial contract / critique of Kant: 3 papers (Mills, Eze, Allais)
- Decolonial modernity/coloniality: 3 papers (Quijano, Mignolo, Dussel)
- Fanon-Hegel recognition debate: 4 papers (Buck-Morss, Ng, Faustino, Bird-Pollan)
- Broader postcolonial/decolonial critique: 3 papers (Wynter, Allen, Bhambra)
- Contextual/historical: 3 papers (Eberl, Gordon, James+Knappik)
====================================================================
}

@book{eze1997race,
  author = {Eze, Emmanuel Chukwudi},
  title = {Race and the Enlightenment: A Reader},
  year = {1997},
  publisher = {Blackwell},
  note = {
  CORE ARGUMENT: This anthology collects primary Enlightenment texts on race
  by Kant, Hume, Hegel, and others, juxtaposed with analyses demonstrating
  that race was not a marginal concern but central to Enlightenment
  anthropology and its construction of human hierarchy. Eze's editorial
  framing establishes that Enlightenment claims to universal reason were
  accompanied by systematic racialized exclusions of non-European peoples
  from full rational subjecthood.

  RELEVANCE: The anthology established the foundational argument for the
  Kant-colonialism debate: Kant's racial writings are not a biographical
  embarrassment but integral to his empirical and anthropological project.
  This positions Eze as the starting point for subsequent debates about
  whether Kant's racism is separable from or entangled with his critical
  philosophy. It is the primary source collection that defines the domain.

  POSITION: Enlightenment universal reason is structurally racialized;
  critique must proceed from within the texts, not from their margins.
  },
  keywords = {Kant-race, Enlightenment-critique, Africana-philosophy, High},
  abstract = {This is a very important contribution for those who cannot read German and who wish to gain a purchase on the role of Kant in the highly contested domain of race theory and the less politicized but also contested domain of philosophy of biology. Not only does it provide key texts from Kant on the question of race, but it also supplements these with texts, previously not available in English, from four important German contemporaries of Kant. Jon Mikkelsen presents these texts in chronological order: Kant's first essay on race, in its two distinct versions of 1775 and 1777 (an unprecedented and very welcome contribution for those who are interested in close historical reading of Kant's development on these questions); E. A. W. Zimmermann's criticisms of Kant in the context of his own biogeographical study of the human population,Geographical History of Human Beings and the Universally Dispersed Quadrupeds(1778); Kant's "Determination of the Concept of a Human Race" (1785); Georg Forster's critical commentary on that essay, "Something More about the Human Races" (1786); Kant's rejoinder, "On the Use of Teleological Principles in Philosophy" (1788), of fundamental importance for the development of his thirdCritique; Christoph Meiners' "Of the Varieties and Deviate Forms of Negroes" (1790), an exemplary text from perhaps the most racist theorist of late eighteenth-century Germany; and, finally, an excerpt from Christoph Girtanner'sConcerning the Kantian Principle in Natural History(1796), the most thorough endeavor to apply Kant's approach to the emergent field of life science, associated with the work of Johann Friedrich Blumenbach in Göttingen. Mikkelsen's volume is supplemented with an extensive Chronology of developments in race theory, the slave trade, and the life sciences from 1619 to 1859.
  abstract_source = {ndpr},

The critical issue concerning this volume is its relation to the increasingly standard English translations of Kant's texts, theCambridge Edition of the Works of Immanuel Kant, in this case, the volumeAnthropology, History, and Education, edited by Günter Zöller and Robert Louden (Cambridge University Press, 2007). Both editions contain careful translations of Kant's texts on race. Each set of translations has its strengths and weaknesses. For general readability, perhaps the Cambridge Edition is superior, but Mikkelsen tends to retain more of the eighteenth-century flavor of Kant's language, as attested by the works from contemporaries. Each translation indulges in some terminological anachronism. The Cambridge Edition chooses to usephylumfor the GermanStamm. That sounds too much like a present taxonomical category for Kant's deliberately ordinary (eighteenth-century) language. But Mikkelsen translates asplateswhat the Cambridge Edition more sensibly renders asplateaus. Plates, once again, evokes too contemporary a geological framework. But the case for Mikkelsen's volume does not lie in translation quality but in conceptual orientation.

Both volumes reflect the very late attentiveness of Anglophone scholarship to Kant's texts on race and their relation to his overall corpus and concerns. More, this belatedness looms especially problematic in light of the explosive implications of these texts and others, now appearing in the Cambridge Edition, from Kant's lectures on physical geography and anthropology for the question of Kant'sracism. While the Cambridge Edition's general introduction acknowledges this context in about five pages and with one footnote reference to a proliferating secondary literature, a brevity perhaps justified by the much wider collection of texts comprising that volume, there is a much more extensive discussion of this heated present-day theoretical debate in the volume by Mikkelsen. His "Translator's Introduction" is a very careful essay in the historiography of recent work on Kant and race, recognizing the triggering intervention of Emmanuel Eze and then Tsenay Serequeberhan in the early 1990s, both reflecting a sharp post-colonialist critique of Eurocentrism. Mikkelsen then recounts the ensuing inquiry into these questions by Kant specialists, notably Mark Larrimore, Robert Bernasconi, Robert Louden, and Pauline Kleingeld, but with an exhaustive bibliography attached. His appraisals are thoughtful and persuasive, and they indicate that the question has not been definitively resolved. This will be decisive for the wider reception of his volume in communities of scholarship interested in contemporary issues of race, colonialism and cosmopolitanism and how Kant's work can be received in these domains.

There is a second theoretical context into which Mikkelsen situates his selected texts, namely the history of the life sciences in the eighteenth century. Kant's relation to this history is a matter that has only recently come under serious reconsideration, after a century of work that has privileged his concern with Newtonian physics. Mikkelsen gives a good account of the state of this emergent historiography, especially in relation to Kant, and he recognizes that that research is still in its very early stages. Since this is the field of my own research interest, I am very pleased to see Mikkelsen's attentiveness to this question and his suggestions for further inquiry. But it will also be here that I will raise some specialist's quibbles.

It is altogether salutary that Mikkelsen included texts from Kant's contemporaries and situated the whole volume in the context of the emergent discourse in life sciences of the eighteenth century. Nevertheless, by virtue of his selection, organization, and explicit interpretative interventions, Mikkelsen has not altogether inadvertently given his volume a spin that suggests that the whole discourse arosein response to Kant. This Kant-centered conception, while certainly understandable in a volume entitledKant and the Concept of Race, makes Kant appear to be the driving force in this field, whereas, in my view, he needs to be situated in a much wider course of developments that his specific interventions, to be sure, inflected but did not fundamentally direct. Thus, Mikkelsen might well have emphasized in his introduction, and even in his selection of texts, the more decisive figures in this emergent science. Buffon is of course central, and while Mikkelsen notes this, he does not raise in sufficient detail exactly what Kant took up from Buffon, why and when. The details of that reception, however, seem crucial to an appraisal of Kant's whole relation to the emergent life sciences. Similarly, path-breaking work by Caspar Friedrich Wolff and Johann Friedrich BlumenbachbeforeKant proved decisive for the German exploration of epigenesis, which Mikkelsen rightly singles out as crucial for Kant's views on the life sciences. Their textual inclusion, rather than brief mention in his introduction, might have relativized Kant's place in the discourse of the life sciences of his day. Of course, there are limits to what the volume could provide. That Mikkelsen includes an excerpt from the now forgotten, but at the time eminent, biogeographer Zimmermann is one of the most welcome features of his collection, though I do not believe Mikkelsen fully appreciates the importance of Zimmermann or the influence of his criticisms of Kant.

Even more important, in my view, is the question of Kant's rival, Johann Gottfried Herder, whose reception of Wolff and Blumenbach in hisIdeas for a Philosophical History of Mankind(1784) drew a two-part review from Kant, perhaps the most hostile and disparaging commentary he published on another scholar. Mikkelsen excluded these from his collection, but they in fact deserve a very prominent place in it if we are to understand how Kant came to his ultimate positions. Many of the texts from 1785 onward reflect Kant's explicit critique of Herder and the reactions to it in the wider community of German life science, but the absence of his reviews (to say nothing of texts from Herder himself) obscures this connection. To be sure, again, the volume could not include everything, but my suggestion is that this is not a dispensable element in the story Mikkelsen proposed to reconstruct. He explicitly addresses his omission of Herder and tries, in his introductions to the later texts and in his annotations, to take cognizance of the Herder connection. However, I find these disappointingly superficial regarding Herder. Moreover, there are specific textual passages in Kant's reviews of Herder that are essential for a grasp of the later texts by Kant and the others, and which Mikkelsen could easily have appended or cited more extensively in his annotations. In a word, I find this the most salient historical weakness in Mikkelsen's work.

By contrast, the inclusion of the text from Meiners and the discussion of this figure in the apparatus of the volume represent a very important contribution to Anglophone understanding of the language of race in late eighteenth-century Germany. This is, I suggest, the most cutting-edge element in Mikkelsen's volume, bespeaking his principal concern with race theory. The relation between Meiners and Kant on questions of race has become a matter of increasing scholarly interest, and the possibility of mutual influence has now been put forward as demanding serious consideration. Having a particularly odious exemplar of Meiners' racism in English will make this issue more conspicuous still. This is important, especially in a current context where Meiners is receiving more favorable attention as a cultural anthropologist, but without an adequate recognition of his oppressively racist baggage. For Kant specialists and even more for a general philosophical readership interested in questions of race and cosmopolitanism, Mikkelsen's volume is a very welcome contribution.},
}

@incollection{eze1996color,
  author = {Eze, Emmanuel Chukwudi},
  title = {The Color of Reason: The Idea of {`Race'} in {K}ant's Anthropology},
  booktitle = {Postcolonial African Philosophy: A Critical Reader},
  editor = {Eze, Emmanuel Chukwudi},
  year = {1996},
  publisher = {Blackwell},
  pages = {103--140},
  note = {
  CORE ARGUMENT: Eze argues that race is not peripheral to Kant's anthropology
  but constitutive: Kant's empirical geography and Anthropology from a Pragmatic
  Point of View produce a teleological hierarchy of races in which white
  Europeans alone are capable of rational self-governance and moral progress.
  This racial hierarchy contradicts the cosmopolitan universalism of Kant's
  critical philosophy, revealing an internal fracture.

  RELEVANCE: This is the key essay-length argument for the "Kant is racist"
  thesis that the broader Kant-colonialism literature responds to. It sets
  the terms for the debate about whether Kant's racism can be excised or
  is integral to his philosophy. Essential for understanding what the
  rehabilitative literature (Kleingeld, Wood, Lu-Adler) is arguing against.

  POSITION: Kant's racial anthropology is entangled with his critical
  philosophy in ways that require either rejection or fundamental revision.
  },
  keywords = {Kant-race, anthropology, critical-philosophy-race, High, INCOMPLETE, no-abstract}
}

@book{mills1997racial,
  author = {Mills, Charles W.},
  title = {The Racial Contract},
  year = {1997},
  publisher = {Cornell University Press},
  note = {
  CORE ARGUMENT: Mills argues that the social contract tradition, from Hobbes
  through Rawls, is undergirded by an unacknowledged "Racial Contract" that
  establishes white supremacy as the foundational political reality of modernity.
  This contract defines who counts as a full person and contractor, relegating
  non-whites to a sub-personal status, and produces an epistemology of
  "white ignorance" that naturalizes racial domination. The liberal tradition's
  claim to universal moral equality thus masks a racially differentiated
  political order.

  RELEVANCE: Mills's Racial Contract is the most influential argument that
  Enlightenment political philosophy, including Kant's cosmopolitanism and
  contractarian ethics, is structurally racist rather than incidentally so.
  It directly challenges whether Kantian universalism can be rehabilitated
  by excising the "bad" racial passages, since the problem is claimed to be
  architectural. It frames the entire debate about whether decolonization
  requires rejecting or revising Enlightenment liberalism.

  POSITION: Enlightenment universalism is a partial, racially exclusive
  contract masquerading as universal; the critique must be structural.
  },
  keywords = {racial-contract, Kant-liberalism, critical-philosophy-race, High},
  abstract = {This book[1]brings together nine papers by the political philosopher Samuel Freeman, seven of them previously published.Freeman edited theCollected Papers[2]of John Rawls, theCambridge Companion to Rawls[3]and Rawls's recently publishedLectures on the History of Political Philosophy[4].The subtitle of the volume under review, together with Freeman's editorial work, might suggest that the nine papers collected here are primarily devoted to explaining Rawls's thought.But Freeman insists they are not, or not exactly.He says:
  abstract_source = {ndpr},

A good deal of the discussion in these chapters is not directly interpretation or defense of Rawls, but rather involves extensions or applications of Rawls's positions. (JSC, p. 8)

This is why, he adds immediately, "rather than subtitling the book 'Essays on Rawls', I have used 'Essays on Rawlsian Political Philosophy'".

In fact, Freeman could have subtitled his book "EssaysinRawlsian Political Philosophy", since 'in' would better suit the lingering resonances of the French 'essai' from which the English 'essay' is derived.For the papers collected in this volume are really trials in or attempts to engage in Rawlsian political philosophy -- attempts, that is, to address a variety of philosophical problems and questions in a way that draws on what Rawls wrote and, as Freeman says, "shares the spirit of [Rawls's] position" (JSC, p. 8).

Freeman's papers range over some of the most important subjects in liberal political theory:the nature and varieties of contractarianism, the meaning of the priority of right, the idea of public reason, the problem of stability, the challenge of luck egalitarianism, the democratic character of judicial review, and the demands of international justice.In taking up these subjects, Freeman partakes of the Rawlsian spirit by drawing on and creatively elaborating Rawls's assumptions and arguments as he understands them, and by posing and dividing questions as he thinks Rawls would.

If Freeman can justifiably claim to have produced work on these subjects that is in "the spirit of [Rawls's] position" -- as I believe he can -- that is because he is so thoroughly acquainted with the letter of Rawls's texts.The papers in this volume areessaisin Rawlsian political philosophy, but they are most definitely not desultory forays into that field.Freeman seems to have read almost all of the classical philosophical sources on which Rawls drew, to have assimilated large stretches of contemporary and secondary literature, and to have thought deeply about every sentence Rawls ever wrote.

The result is an extraordinarily substantial set of papers.The shortest of them is 30 pages of small print with narrow margins.All nine are dense with arguments and exegesis.Taken together, the nine essays make for very demanding reading.Students who are looking for an introduction to Rawls would be well advised to start elsewhere.The readers who will benefit -- and benefit greatly -- are those with a serious interest in contemporary political philosophy, especially those who know Rawls's work and ask what a convinced and thoroughly informed Rawlsian would say about a number of debates and objections that enjoy some currency in the philosophical literature.

It is hard to exaggerate how important a contribution Freeman has made by answering that question.Rawls rarely addressed objections to his view, and rarely contended with the positions staked out by others in the debates of the day.Knowing how Rawls might have addressed objections, and knowing what he might have said about the positions of others, are very valuable.It seems unlikely we will ever see a more faithful and better informed set of replies and interventions than those that Freeman provides here.The blending of "interpretation or defense" with "extension[]" is so seamless in this book that there are generally good grounds for thinking that Rawls would have said what Freeman does say.5]},
}

@article{mills2005kant,
  author = {Mills, Charles W.},
  title = {Kant's {Untermenschen}},
  year = {2005},
  journal = {Race and Racism in Modern Philosophy},
  note = {
  CORE ARGUMENT: Mills argues in this essay (collected in Black Rights/White
  Wrongs) that Kant's racial hierarchy assigns non-white peoples to a sub-
  personal moral status---literally "Untermenschen"---thereby contradicting
  his own categorical imperative. This is not a marginal inconsistency but
  shows that Kant's moral philosophy was intended for a racially restricted
  community of persons, with the universalism functioning ideologically.

  RELEVANCE: This is Mills's most focused analysis of Kant specifically,
  developed after The Racial Contract. It directly enters the debate about
  Kant's racism and sets up Mills's later "Black Radical Kantianism" (which
  argues for appropriating Kantian resources against their author's racial
  views). The contrast between this essay and his later work is important
  for understanding the internal tensions within the critical race tradition
  on how to respond to Kant's racism.

  POSITION: Kant's racism is integral to his moral philosophy, not a
  separable anthropological error---but Kantian resources can still be
  appropriated for anti-racist purposes (later Mills).
  },
  keywords = {Kant-race, racial-contract, Mills, Medium, INCOMPLETE, no-abstract}
}

@article{quijano2000coloniality,
  author = {Quijano, An{\'i}bal},
  title = {Coloniality of Power and Eurocentrism in {L}atin {A}merica},
  journal = {International Sociology},
  year = {2000},
  volume = {15},
  number = {2},
  pages = {215--232},
  doi = {10.1177/0268580900015002005},
  note = {
  CORE ARGUMENT: Quijano introduces the concept of the "coloniality of power,"
  arguing that European colonialism did not merely exploit labor and land but
  produced a new global classification of populations by race that persists
  after formal decolonization. This racial classification structures the global
  division of labor and knowledge, constituting what Quijano calls the
  "colonial matrix of power." Eurocentrism---including the Enlightenment
  philosophy of history championed by Hegel---is the epistemological
  expression of this colonial power structure.

  RELEVANCE: Quijano's concept of coloniality of power is the foundational
  framework for decolonial theory (Mignolo, Dussel, Maldonado-Torres) and
  provides the structural-historical argument that Hegel's philosophy of
  history is not a universal account of human development but a Eurocentric
  narrative produced by and for colonial power. This connects directly to
  the critique of Hegel's exclusion of Africa from world history.

  POSITION: The modernity/coloniality nexus: modernity and coloniality
  are two sides of the same coin, not sequential stages.
  },
  keywords = {coloniality-of-power, Hegel-history, decolonial, High},
  abstract = {The globalization of the world is, in the first place, the culmination of a process that began with the constitution of America and world capitalism as a Euro-centered colonial/modern world power. One of the foundations of that pattern of power was the social classification of the world population upon the base of the idea of race, a mental construct that expresses colonial experience and that pervades the most important dimensions of world power, including its specific rationality: Eurocentrism. This article discusses some implications of that coloniality of power in Latin American history.},
  abstract_source = {openalex},
}

@book{mignolo2011darker,
  author = {Mignolo, Walter D.},
  title = {The Darker Side of {W}estern Modernity: {G}lobal Futures, Decolonial Options},
  year = {2011},
  publisher = {Duke University Press},
  doi = {10.1215/9780822394501},
  note = {
  CORE ARGUMENT: Mignolo develops the argument that Western modernity and
  coloniality are inseparable: the rhetoric of salvation, progress, and
  civilization that defines Enlightenment modernity (including Kant's
  cosmopolitanism and Hegel's philosophy of history) is always already the
  darker side of colonial expansion. Against the option of "critical theory"
  that attempts to reform modernity from within (Habermas, Honneth), Mignolo
  proposes "decoloniality" as epistemic delinking from the colonial matrix
  of power/knowledge---the refusal to accept Western epistemology as the
  universal framework.

  RELEVANCE: This is the major theoretical statement of the Mignolo/Quijano
  school that frames Enlightenment philosophy as constitutively colonial.
  It provides the strongest version of the thesis that Kant and Hegel cannot
  be rehabilitated from within because their universalism is the cognitive
  expression of colonialism. It defines the "decolonial option" that
  synthesis discussions must either engage with or explain why immanent
  critique is preferable.

  POSITION: Decolonization requires epistemic delinking from Enlightenment
  universalism, not its internal reform; "pluri-versality" replaces
  "uni-versality."
  },
  keywords = {modernity-coloniality, decolonial, Enlightenment-critique, High, INCOMPLETE, no-abstract}
}

@article{mignolo2009epistemic,
  author = {Mignolo, Walter D.},
  title = {Epistemic Disobedience, Independent Thought and Decolonial Freedom},
  journal = {Theory, Culture {\&} Society},
  year = {2009},
  volume = {26},
  pages = {159--181},
  doi = {10.1177/0263276409349275},
  note = {
  CORE ARGUMENT: Mignolo argues that decolonization requires "epistemic
  disobedience"---a refusal to accept the epistemic framework of Western
  modernity, including its assumptions about reason, universality, and the
  telos of human development. This disobedience is not mere relativism but
  a positive construction of "border thinking" from the colonial difference,
  drawing on knowledges suppressed by the Western canon including Kant's
  Enlightenment reason.

  RELEVANCE: This article provides Mignolo's most accessible formulation of
  what decolonial epistemology means in practice, and his explicit critique
  of Kantian reason as a colonially situated rather than universal epistemic
  framework. It directly addresses the question of how the Enlightenment
  legacy constrains emancipatory thought and what an alternative might look
  like.

  POSITION: "Border thinking" from the colonial difference as alternative
  to both Enlightenment universalism and cultural relativism.
  },
  keywords = {epistemic-disobedience, decolonial, Kant-epistemology, Medium},
  abstract = {Once upon a time scholars assumed that the knowing subject in the disciplines is transparent, disincorporated from the known and untouched by the geo-political configuration of the world in which people are racially ranked and regions are racially configured. From a detached and neutral point of observation (that Colombian philosopher Santiago Castro-Gómez describes as the hubris of the zero point ), the knowing subject maps the world and its problems, classifies people and projects into what is good for them. Today that assumption is no longer tenable, although there are still many believers. At stake is indeed the question of racism and epistemology. And once upon a time scholars assumed that if you ‘come’ from Latin America you have to ‘talk about’ Latin America; that in such a case you have to be a token of your culture. Such expectation will not arise if the author ‘comes’ from Germany, France, England or the US. As we know: the first world has knowledge, the third world has culture; Native Americans have wisdom, Anglo Americans have science. The need for political and epistemic de-linking here comes to the fore, as well as decolonializing and decolonial knowledges, necessary steps for imagining and building democratic, just, and nonimperial/colonial societies.},
  abstract_source = {openalex},
}

@article{dussel2012transmodernity,
  author = {Dussel, Enrique D.},
  title = {Transmodernity and Interculturality: An Interpretation from the Perspective of Philosophy of Liberation},
  journal = {TRANSMODERNITY: Journal of Peripheral Cultural Production of the Luso-Hispanic World},
  year = {2012},
  volume = {1},
  doi = {10.5070/t413012881},
  note = {
  CORE ARGUMENT: Dussel argues that "transmodernity" is not the rejection of
  modernity but its transformation from the perspective of those excluded by
  it: the colonized, enslaved, and dominated. Against Hegel's philosophy of
  history, which positions Latin America, Africa, and Asia as the prehistory
  of European modernity, Dussel argues that these civilizations have their
  own contributions to a genuinely universal world culture that requires
  intercultural dialogue rather than Eurocentric subsumption. Liberation
  philosophy does not merely repeat European critical theory but develops
  from an "exterior" position that Hegel's dialectic cannot accommodate.

  RELEVANCE: Dussel's Latin American liberation philosophy offers an
  alternative to both European critical theory and Mignolo's decolonial
  delinking: a reformed universalism built from dialogue with the excluded.
  This three-way tension (Habermasian reform, Mignolian delinking, Dussellian
  transmodernity) is essential for understanding the landscape of responses
  to Hegel's and Kant's Eurocentric teleologies.

  POSITION: Transmodernity as an intercultural alternative to Hegelian
  Eurocentrism that does not abandon universalism but transforms it.
  },
  keywords = {transmodernity, Hegel-history, liberation-philosophy, High},
  abstract = {Transmodernity and Interculturality: An Interpretation from the Perspective of Philosophy of Liberation},
  abstract_source = {openalex},
}

@article{wynter2003unsettling,
  author = {Wynter, Sylvia},
  title = {Unsettling the Coloniality of {B}eing/{P}ower/{T}ruth/{F}reedom: Towards the Human, After Man, Its Overrepresentation---An Argument},
  journal = {CR: The New Centennial Review},
  year = {2003},
  volume = {3},
  pages = {257--337},
  doi = {10.1353/NCR.2004.0015},
  note = {
  CORE ARGUMENT: Wynter argues that Western modernity produces a specific
  genre of "Man"---the liberal humanist subject descended from Kantian
  autonomous rationality---that represents itself as the universal human.
  This "overrepresentation" of Man excludes racialized Others from full
  human status and structures the colonial order epistemologically.
  Decolonization requires not merely political liberation but a new
  episteme, a new genre of the human beyond the Western Man figure.

  RELEVANCE: Wynter's argument that Kantian rational autonomy is an
  overrepresentation of one particular (European, male, bourgeois) genre
  of the human as the universal provides one of the deepest philosophical
  critiques of Enlightenment universalism. It connects Kant's anthropology
  directly to the colonial production of subjectivity and raises the
  question of what a genuinely universal concept of the human would require.

  POSITION: The Enlightenment concept of Man is a colonial genre that
  must be superseded rather than reformed from within.
  },
  keywords = {coloniality-of-being, Kant-anthropology, decolonial, High, INCOMPLETE, no-abstract}
}

@book{buckmorss2009hegel,
  author = {Buck-Morss, Susan},
  title = {Hegel, {H}aiti, and Universal History},
  year = {2009},
  publisher = {University of Pittsburgh Press},
  doi = {10.2307/j.ctt7zwbgz},
  note = {
  CORE ARGUMENT: Buck-Morss argues that Hegel's master-slave dialectic in
  the Phenomenology of Spirit was likely inspired by the Haitian Revolution
  (1791-1804), which Hegel was aware of through contemporary journals. If
  so, Hegel philosophically appropriated the world-historical content of
  black slave revolt while systematically excluding Haiti and Africa from
  his philosophy of history---a performative contradiction that reveals how
  his universal history suppresses its colonial conditions of production.

  RELEVANCE: This is the key text for the Hegelian reception in postcolonial
  thought: it provides historical grounds for reading Hegel's dialectic as
  not merely theoretically but historically entangled with slavery and
  colonial violence. It sets up the Fanonian critique (which Fanon develops
  philosophically) and the broader question of whether Hegel's recognition
