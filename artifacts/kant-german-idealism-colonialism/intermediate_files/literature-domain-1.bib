@incollection{bernasconi2011third,
  author    = {Bernasconi, Robert},
  title     = {Kant's Third Thoughts on Race},
  booktitle = {Reading Kant's Geography},
  year      = {2011},
  pages     = {291--318},
  publisher = {SUNY Press},
  doi       = {10.1515/9781438436067-017},
  note      = {
  CORE ARGUMENT: Bernasconi identifies what he calls Kant's "third thoughts"
  on race -- the modifications Kant introduced in his 1788 essay "On the Use
  of Teleological Principles in Philosophy" in response to Georg Forster's
  challenge. He argues that rather than abandoning his race theory, Kant here
  refines and deepens it by grounding racial taxonomy more firmly in teleological
  natural history. Against Kleingeld's developmental thesis, Bernasconi argues
