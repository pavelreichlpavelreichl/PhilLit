@comment{
====================================================================
DOMAIN: Kant's Universalism, Cosmopolitanism, and the Philosophy of
Right vs. Anti-Colonialism
SEARCH_DATE: 2026-06-27
PAPERS_FOUND: 16 total (High: 9, Medium: 5, Low: 2)
SEARCH_SOURCES: SEP, IEP, PhilPapers, Semantic Scholar, OpenAlex,
CrossRef (verification)
====================================================================

DOMAIN_OVERVIEW:
The tension between Kant's universalist moral theory and his racist
anthropological writings has generated one of the most productive
debates in contemporary Kant scholarship. Three interrelated problems
drive the literature: (1) whether Kant's cosmopolitan right and
explicit condemnations of colonial conquest in Toward Perpetual Peace
(1795) and the Metaphysics of Morals (1797) make him a genuine
anti-colonialist; (2) whether Kant abandoned racial hierarchy in the
1790s (the Kleingeld thesis), and if so whether this shift was
philosophically motivated; and (3) whether Kantian universalism is
ideologically complicit in colonialism even when explicitly critical
of it, because the universal subject it posits is covertly Eurocentric.

The dominant interpretive poles are: Kleingeld's developmental reading
(Kant moved from racial hierarchy to racial egalitarianism in tandem
with developing his legal-political philosophy, making his mature
position genuinely anti-colonialist); Bernasconi and Lu-Adler's
critical reading (Kant never fully extricated racism from his
philosophy, and the 1790s political writings remain embedded in a
Eurocentric framework shaped by his biological race theory); and
Valdez's alternative reading (Kant's anti-colonialism is grounded in
his just-war theory and republican right, not in racial revision).
Muthu's Enlightenment Against Empire situates Kant within a broader
eighteenth-century tradition of anti-imperial argument while
acknowledging that Kant's universalism differs importantly from Herder
and Diderot's cultural pluralism. Ripstein and Flikschuh analyse the
legal architecture of Kant's cosmopolitan right and the right of
hospitality in the Doctrine of Right. Hedrick, Marwah, and Gani argue
that race is not an external blemish on Kantian cosmopolitanism but
structurally embedded in the anthropological and teleological framework
that underwrites it.

RELEVANCE_TO_PROJECT:
This domain is central to the research project: it covers the
principal scholarly debate on how Kant's political universalism and
his racism relate to colonialism, including the contested thesis that
Kant revised his racial views, the legal architecture of cosmopolitan
right as a resource against colonial dispossession, and critiques
arguing that Kantian universalism is Eurocentric at its core.

NOTABLE_GAPS:
The specific question of how Kant's philosophy of history (teleology,
providential progress, unsociable sociability) structures his approach
to non-European peoples receives attention mainly as a side issue;
there is no comprehensive monograph dedicated exclusively to this
connection, though Muthu and Ypi both address it. Bernasconi's essays
on Kant's invention of race are scattered across edited volumes and
have not been verified with DOIs for individual chapters.

SYNTHESIS_GUIDANCE:
Organise around the three poles of interpretation (Kleingeld
developmental, Bernasconi-Lu-Adler critical, Valdez war-theory), then
bring in the structural critiques (Hedrick, Gani, Marwah) as a
separate challenge that cuts across the developmental vs. stable-racism
debate.

KEY_POSITIONS:
- Developmental/rehabilitative: 4 papers -- Kleingeld 2007, 2011, 2014;
  Muthu 2003 (nearby)
- Critical/non-rehabilitative: 5 papers -- Bernasconi, Lu-Adler 2023,
  Gani, Marwah, Storey
- Legal-architectonic: 3 papers -- Ripstein 2014, Niesen 2007,
  Meckstroth 2017
- Alternative grounding: 2 papers -- Valdez 2017, Hedrick 2008
====================================================================
}

@article{kleingeld2007second,
  author = {Kleingeld, Pauline},
  title = {Kant's Second Thoughts on Race},
  journal = {The Philosophical Quarterly},
  year = {2007},
  volume = {57},
  number = {229},
  pages = {573--592},
  doi = {10.1111/j.1467-9213.2007.498.x},
  note = {
  CORE ARGUMENT: Kleingeld argues that Kant's views on race underwent
  a genuine and philosophically motivated revision in the mid-1790s.
  In his writings of the 1780s Kant defended a racial hierarchy in
  which whites were superior; by the time he wrote Toward Perpetual
  Peace and the Metaphysics of Morals he had abandoned this hierarchy
  and adopted a more egalitarian account of peoples, a change Kleingeld
  traces to the internal demands of his developing moral and political
  philosophy. This article inaugurates the "developmental" interpretation
  and directly challenges the view that Kant's racism is a stable
  feature of his philosophy.

  RELEVANCE: This is the foundational text for the debate over whether
  Kant's mature anti-colonialism is coherent or undermined by his racism;
  every subsequent contribution either accepts, qualifies, or rejects the
  developmental thesis it advances. The project must situate all other
  work in this domain relative to it.

  POSITION: Developmentalist/rehabilitative reading of Kant on race
  and colonialism.
  },
  keywords = {Kant, race, cosmopolitanism, colonialism, developmentalism, High},
  abstract = {During the 1780s, as Kant was developing his universalistic moral theory, he published texts in which he defended the superiority of whites over non‐whites. Whether commentators see this as evidence of inconsistent universalism or of consistent inegalitarianism, they generally assume that Kant's position on race remained stable during the 1780s and 1790s. Against this standard view, I argue on the basis of his texts that Kant radically changed his mind. I examine his 1780s race theory and his hierarchical conception of the races, and subsequently address the question of the significance of these views, especially in the light of Kant's own ethical theory. I then show that during the 1790s Kant restricts the role of the concept of race, and drops his hierarchical account of the races in favour of a more genuinely egalitarian and cosmopolitan view.},
  abstract_source = {openalex},
}

@book{kleingeld2011cosmopolitanism,
  author = {Kleingeld, Pauline},
  title = {Kant and Cosmopolitanism: The Philosophical Ideal of World Citizenship},
  publisher = {Cambridge University Press},
  year = {2011},
  doi = {10.1017/cbo9781139015486},
  note = {
  CORE ARGUMENT: This monograph reconstructs Kant's cosmopolitanism
  across its moral, legal, and political dimensions, arguing that Kant's
  mature political philosophy is genuinely cosmopolitan in a philosophically
  robust sense. Two chapters directly address the relationship between
  cosmopolitan right, race, and colonialism, extending the developmental
  thesis of the 2007 article into a book-length treatment.

  RELEVANCE: Provides the most systematic treatment of Kleingeld's
  position and is the primary reference for the claim that Kant's
  anti-colonialism is grounded in a revised, egalitarian cosmopolitanism.
  The project needs this as the key statement of the rehabilitative view.

  POSITION: Developmentalist; the primary monograph defense of
  Kleingeld's interpretation.
  },
  keywords = {Kant, cosmopolitanism, race, colonialism, right-of-hospitality, High},
  abstract = {This is the first comprehensive account of Kant's cosmopolitanism, highlighting its moral, political, legal, economic, cultural and psychological aspects. Contrasting Kant's views with those of his German contemporaries and relating them to current debates, Pauline Kleingeld sheds new light on texts that have been hitherto neglected or underestimated. In clear and carefully argued discussions, she shows that Kant's philosophical cosmopolitanism underwent a radical transformation in the mid 1790s and that the resulting theory is philosophically stronger than is usually thought. Using the work of figures such as Fichte, Cloots, Forster, Hegewisch, Wieland and Novalis, Kleingeld analyses Kant's arguments regarding the relationship between cosmopolitanism and patriotism, the importance of states, the ideal of an international federation, cultural pluralism, race, global economic justice and the psychological feasibility of the cosmopolitan ideal. In doing so, she reveals a broad spectrum of positions in cosmopolitan theory that are relevant to current discussions of cosmopolitanism.},
  abstract_source = {openalex},
}

@incollection{kleingeld2014colonialism,
  author = {Kleingeld, Pauline},
  title = {Kant's Second Thoughts on Colonialism},
  booktitle = {Kant and Colonialism: Historical and Critical Perspectives},
  editor = {Flikschuh, Katrin and Ypi, Lea},
  publisher = {Oxford University Press},
  year = {2014},
  pages = {43--67},
  doi = {10.1093/acprof:oso/9780199669622.003.0003},
  note = {
  CORE ARGUMENT: Kleingeld argues that Kant's initial endorsement and
  subsequent criticism of colonialism are closely connected to his
  changing views on race: because racial hierarchy underwrote his
  earlier justification of European expansion, abandoning the hierarchy
  in the 1790s entailed abandoning that justification. He replaced it
  with a more egalitarian account of cosmopolitan right that condemns
  colonial appropriation.

  RELEVANCE: Directly addresses the Kleingeld thesis in its fullest
  developed form, applying it specifically to colonialism rather than
  race in general. It demonstrates the internal connection between
  racial revision and the legal condemnation of colonial conquest that
  the project must assess.

  POSITION: Developmentalist; the most explicit application of the
  thesis to the colonialism question.
  },
  keywords = {Kant, colonialism, race, cosmopolitanism, developmentalism, High},
  abstract = {Kant is widely regarded as a fierce critic of colonialism. In Toward Perpetual Peace and the Metaphysics of Morals, for example, he forcefully condemns European conduct in the colonies as a flagrant violation of the principles of right. His earlier views on colonialism have not yet received much detailed scrutiny, however. In this essay I argue that Kant actually endorsed and justified European colonialism until the early 1790s. I show that Kant’s initial endorsement and his subsequent criticism of colonialism are closely related to his changing views on race, because his endorsement of a racial hierarchy plays a crucial role in his justification of European colonialism. He gave up both in the mid 1790s while he was developing his legal and political philosophy, and he adopted a more egalitarian version of the cosmopolitan relationship among peoples.},
  abstract_source = {openalex},
}

@book{flikschuhypi2014kant,
  editor = {Flikschuh, Katrin and Ypi, Lea},
  title = {Kant and Colonialism: Historical and Critical Perspectives},
  publisher = {Oxford University Press},
  year = {2014},
  doi = {10.1093/acprof:oso/9780199669622.001.0001},
  note = {
  CORE ARGUMENT: This edited volume assembles historical and systematic
  essays examining Kant's relationship to colonialism from multiple
  angles: the legal architecture of cosmopolitan right, the significance
  of his philosophical history for colonial justification, and the
  adequacy of his anti-colonial arguments. Contributors include
  Kleingeld, Ripstein, Niesen, Ypi, and others, representing both
  rehabilitative and critical positions.

  RELEVANCE: The single most important volume for this domain; it
  effectively defines the state of the debate at the time of its
  publication and is the primary reference for the legal-architectonic
  and developmental strands of interpretation.

  POSITION: Multi-perspectival; the key scholarly collection on the topic.
  },
  keywords = {Kant, colonialism, cosmopolitanism, right-of-hospitality, anthology, High},
  abstract = {Abstract This book examines Kant’s controversial position on colonialism in the context of his wider cosmopolitan commitments. The book explores Kant’s maturing opposition to European conquest and colonization, and the implication of that opposition to his moral and political thinking more generally. The book offers no single overall position on the subject matter but draws instead on the distinctive disciplinary expertise of individual contributors. In consequence, a picture emerges of the considerable complexity of the issue, including Kant’s many-faceted response to it, from the role of race and trade relations in his early and late teleological thinking, his acknowledgement of permissible as against impermissible colonial settlements, his late position on land rights of non-state peoples, and his view of the relation between war and colonial conquest, to prospects for Kantian principles of restorative international law. The opening chapters situate Kant’s unstable general conception of colonialism in historical context; the closing chapter explores the abiding relevance of Kant’s growing anti-colonial stance to current cosmopolitan thinking.},
  abstract_source = {openalex},
}

@incollection{ripstein2014juridical,
  author = {Ripstein, Arthur},
  title = {Kant's Juridical Theory of Colonialism},
  booktitle = {Kant and Colonialism: Historical and Critical Perspectives},
  editor = {Flikschuh, Katrin and Ypi, Lea},
  publisher = {Oxford University Press},
  year = {2014},
  pages = {145--169},
  doi = {10.1093/acprof:oso/9780199669622.003.0007},
  note = {
  CORE ARGUMENT: Ripstein analyses Kant's condemnation of colonial
  appropriation through the lens of the Doctrine of Right's juridical
  framework, arguing that colonialism violates the a priori conditions
  of rightful external relations because it forcibly incorporates
  peoples into a legal order without their consent, thus undermining
  the very possibility of public right. The condemnation is derived
  from juridical principles, not from moral sentiment.

  RELEVANCE: Provides the most rigorous legal-philosophical account of
  why Kant's anti-colonialism has genuine normative teeth independent
  of racial questions, grounding it in the theory of right rather than
  in contingent historical revision. This is the key counterpoint to
  the view that Kant's condemnation is merely rhetorical.

  POSITION: Legal-architectonic; defends the philosophical seriousness
  of Kant's anti-colonialism on juridical grounds.
  },
  keywords = {Kant, colonialism, right, Doctrine-of-Right, juridical, High},
  abstract = {Abstract Kant’s objections to colonialism are cast in juridical terms, focusing on the ways in which it is contrary to requirements of right under his conception of international law. Colonial conquest is an illicit ground for going to war, and colonization is an illicit mode of conduct after a war, even if the war itself was fought on other grounds. This chapter explains Kant’s arguments for the following claims: (i) Acquiring territory or securing markets is never a legitimate ground for war. (ii) Conquest is wrongful, but colonization is a defective form of conquest, worse than simply incorporating the territory into the conquering nation. (iii) Although colonial rule is not itself rightful, it has its own internal standard of adequacy, which colonial powers historically failed to satisfy.},
  abstract_source = {openalex},
}

@article{niesen2007colonialism,
  author = {Niesen, Peter},
  title = {Colonialism and Hospitality},
  journal = {Journal of International Political Theory},
  year = {2007},
  volume = {3},
  number = {1},
  pages = {90--108},
  doi = {10.1177/1743453X0700300108},
  note = {
  CORE ARGUMENT: Niesen examines Kant's right of hospitality in Toward
  Perpetual Peace, arguing that it establishes a genuine normative
  constraint on colonial expansion by prohibiting the European powers
  from treating non-European territories as legally vacant. He
  distinguishes between the right to visit and the right to settle,
  showing that Kant explicitly denies settlers a right to appropriate
  land already occupied by indigenous peoples.

  RELEVANCE: Provides the most focused treatment of hospitality as an
  anti-colonial principle in Kant's cosmopolitan right; connects the
  Perpetual Peace text directly to questions about indigenous rights
  and colonial dispossession that the project must address.

  POSITION: Legal-architectonic; reads hospitality as a genuine
  constraint on colonialism.
  },
  keywords = {Kant, hospitality, cosmopolitan-right, colonialism, perpetual-peace, High},
  abstract = {For Kant, the contents of cosmopolitan law are to be ‘limited’ to non-citizens' subjective rights to hospitality. Although hospitality yields universal and far-reaching communicative rights, its limits may seem overly restrictive at first. I argue that this narrow focus is intended to fend off justifications for colonial occupation that could otherwise draw support from Kant's own doctrine of private law. Kantian hospitality is further limited in that it does not cover all forms of communicative exchange. As can be shown from his endorsement of China's and Japan's protectionist policies, Kant is not averse to limiting cosmopolitan citizens' commercial speech. In conclusion, I discuss rivalling interpretations of Kant's justification of hospitality. I argue that this justification cannot rest exclusively on the innate human right to freedom, but must draw on facts about the world as well.},
  abstract_source = {openalex},
}

@book{muthu2003enlightenment,
  author = {Muthu, Sankar},
  title = {Enlightenment Against Empire},
  publisher = {Princeton University Press},
  year = {2003},
  note = {
  CORE ARGUMENT: Muthu argues that a significant strand of late
  Enlightenment thought -- including Kant, Herder, and Diderot --
  was genuinely anti-imperialist, grounded in a recognition of human
  cultural agency and the value of diversity. In Kant's case, the
  anti-imperial argument derives from the normative requirements of
  cosmopolitan right and the moral status of rational agents as ends
  in themselves, rather than from cultural pluralism as in Herder and
  Diderot.

  RELEVANCE: Situates Kant's anti-colonialism within a broader
  Enlightenment context and identifies the philosophical resources
  that make Kantian anti-imperialism distinctive; important for
  assessing whether Kantian universalism is inherently Eurocentric or
  contains genuine anti-colonial resources.

  POSITION: Rehabilitative/contextualist; reads Kant as a genuine
  opponent of empire on universalist grounds.
  },
  keywords = {Kant, Enlightenment, anti-colonialism, cosmopolitanism, empire, High, INCOMPLETE, no-abstract}
}

@article{hedrick2008race,
  author = {Hedrick, Todd},
  title = {Race, Difference, and Anthropology in Kant's Cosmopolitanism},
  journal = {Journal of the History of Philosophy},
  year = {2008},
  volume = {46},
  number = {2},
  pages = {245--268},
  doi = {10.1353/hph.0.0001},
  note = {
  CORE ARGUMENT: Hedrick argues that Kant's anthropological writings
  on race are not merely incidental to his cosmopolitanism but
  structurally related to it: the cosmopolitan project of cultivating
  human talents toward rational self-governance presupposes the
  anthropological framework in which non-European peoples are
  positioned as less developed or capable of such cultivation. Race
  difference thus enters into the normative architecture of Kant's
  cosmopolitanism, not merely into incidental empirical remarks.

  RELEVANCE: Represents the structural-critique position that directly
  challenges the Kleingeld developmental thesis by showing that
  racism is embedded in the philosophical framework, not a separable
  inconsistency. Key for the project's assessment of whether Kantian
  universalism is Eurocentric at its foundation.

  POSITION: Structural critique; argues race is internal to
  Kantian cosmopolitanism, not external to it.
  },
  keywords = {Kant, race, anthropology, cosmopolitanism, structural-critique, High},
  abstract = {This paper explores the connections between Kant’s theory of hierarchical racial difference, on the one hand, and his cosmopolitanism and conceptions of moral and political progress, on the other. I argue that Kant’s racial biology plays an essential role in maintaining national-cultural differences, which he views as essential for the establishment of the cosmopolitan union. Unfortunately, not only are these views racist, they also complicate Kant’s ability to consistently think through the prospect of the human species’ moral progress. Thus, while in the abstract, Kant’s attempts to understand the prospects for moral and political progress as rooted in historical reality, and his insistence that such progress is necessarily connected to the persistence of cultural difference, is appealing, his own way of carrying this out is decidedly not, being so intimately connected to racial hierarchy as a basic source of difference.},
  abstract_source = {openalex},
}

@article{valdez2017notaboutrace,
  author = {Valdez, In\'{e}s},
  title = {It's Not about Race: Good Wars, Bad Wars, and the Origins of Kant's Anti-Colonialism},
  journal = {American Political Science Review},
  year = {2017},
  volume = {111},
  number = {4},
  pages = {819--834},
  doi = {10.1017/s0003055417000223},
  note = {
  CORE ARGUMENT: Valdez argues against the Kleingeld thesis that Kant's
  anti-colonialism is primarily explained by a revision of his racial
  views. Instead, she contends that Kant's condemnation of colonial
  wars derives from his theory of just war and republican right: wars
  for commercial expansion or territorial conquest violate republican
  principles because they are not authorised by citizens and undermine
  the conditions for perpetual peace. Race is not the pivot on which
  Kant's anti-colonialism turns.

  RELEVANCE: Provides an important alternative to the Kleingeld thesis
  and complicates the simple developmental narrative; the project must
  consider whether legal-republican grounds are more or less stable
  than revised racial egalitarianism as the basis of anti-colonialism.

  POSITION: Alternative grounding; anti-colonialism from just-war and
  republican theory, not from racial revision.
  },
  keywords = {Kant, anti-colonialism, just-war, republican-right, race, High},
  abstract = {This article offers a new interpretation of Kant's cosmopolitanism and his anti-colonialism in Toward Perpetual Peace . Kant's changing position has been the subject of extensive debates that have, however, not recognized the central place of colonialism in the political, economic, and military debates in Europe in Kant's writings. Based on historical evidence not previously considered alongside Perpetual Peace , I suggest that Kant's leading concern at the time of writing is the negative effect of European expansionism and intra-European rivalry over colonial possessions on the possibility of peace in Europe. Because of the lack of affinity between colonial conflict and his philosophy of history, Kant must adjust his concept of antagonism to distinguish between war between particular dyads, in particular spaces, and with particular non-state actors. I examine the implications of this argument for Kant's system of Right and conclude that his anti-colonialism co-exists with hierarchical views of race.},
  abstract_source = {openalex},
}

@book{luadler2023kant,
  author = {Lu-Adler, Huaping},
  title = {Kant, Race, and Racism: Views from Somewhere},
  publisher = {Oxford University Press},
  year = {2023},
  doi = {10.1093/oso/9780197685211.001.0001},
  note = {
  CORE ARGUMENT: Lu-Adler reconstructs Kant's racism as a systematic
  philosophical project, not a set of incidental prejudices. Drawing on
  Haslanger's ideology critique, she argues that Kant's race theory
  functioned as ideology -- shaping and legitimating racial domination
  through his role as educator and institutional philosopher -- and
  that his moral universalism did not prevent this because the universal
  subject of his ethics was covertly racialised. The book challenges both
  the Kleingeld developmental thesis and earlier dismissals of Kant's
  racism as philosophically marginal.

  RELEVANCE: The most recent and comprehensive critical monograph on
  Kant and race; it reframes the debate from individual consistency to
  structural ideology, offering a challenge to the project's question
  of whether universalism contains anti-colonial resources.

  POSITION: Critical/ideology-critique; argues Kant's racism is
  structurally embedded and not resolved by late revisions.
  },
  keywords = {Kant, race, racism, ideology, universalism, Lu-Adler, High},
  abstract = {Abstract Kant scholars have paid relatively little attention to his raciology. They assume that his racism, as personal prejudice, can be disentangled from his core philosophy. They also assume that racism contradicts his moral theory. This book challenges both assumptions. It shows how Kant’s raciology—divided into racialism and racism—is integral to his philosophical system as a whole. It also rejects the individualistic approach to Kant and racism. Instead, it uses the notion of racism as ideological formation to demonstrate how Kant, from his social location both as a prominent scholar and as a lifelong educator, participated in the formation of modern racist ideology. As a scholar, Kant developed a groundbreaking scientific theory of race from the standpoint of a philosophical investigator of nature or Naturforscher. As an educator, he transmitted denigrating depictions of the racialized others and imbued them with normative relevance. In both roles, he presented a worldview that excluded nonwhites from such goods as recognitional respect and candidacy for cultural and moral achievements. Some effects of this worldview are still palpable today. Scholars who research and teach Kant’s philosophy therefore have an unshakable burden to take part in the ongoing antiracist struggles, through their teaching practices as well as their scholarship. And they must do so in a color-conscious as opposed to colorblind way, with a pragmatic attention to nonideal social realities and a clear normative orientation toward substantial racial justice, equality, and inclusion.},
  abstract_source = {openalex},
}

@article{gani2017erasure,
  author = {Gani, Jasmine},
  title = {The Erasure of Race: Cosmopolitanism and the Illusion of Kantian Hospitality},
  journal = {Millennium: Journal of International Studies},
  year = {2017},
  volume = {45},
  number = {3},
  pages = {425--446},
  doi = {10.1177/0305829817714064},
  note = {
  CORE ARGUMENT: Gani argues that Kant's cosmopolitan hospitality
  systematically erases race as a morally relevant consideration:
  the universalism of hospitality is achieved by abstracting from
  the racial differences that Kant's own anthropological writings
  posit, producing a formal equality that conceals substantive racial
  hierarchy. The right of hospitality thus does not challenge colonial
  racism but reproduces it at a higher level of abstraction.

  RELEVANCE: Articulates the critical position that cosmopolitan
  universalism is not simply incomplete but actively conceals the
  racial hierarchy it presupposes; this challenges both the
  rehabilitative and the legal-architectonic readings and is
  important for assessing whether Kant's universalism is ideologically
  complicit in colonialism.

  POSITION: Structural critique; cosmopolitan hospitality as
  ideology that erases rather than confronts race.
  },
  keywords = {Kant, hospitality, race, cosmopolitanism, ideology, structural-critique, Medium},
  abstract = {This article explores three key arguments: Firstly, it seeks to demonstrate the contradictions and limits within Kantian hospitality, and its links to colonialism and practices of racialisation. The acclaimed universalism of Kant’s law of hospitality forecloses a discussion of its dualism, and erases the historical, racist context in which it was conceived. The prioritization of concept over conception allows Kant’s theory on race to be obscured from official discourse and framing of policies while it still courses through inherited perceptions and theories. Secondly, in making my case, I will be applying the notion of coloniality, coined by Aníbal Quijano and later developed by Walter Mignolo, to the existing but small body of critical discourse on Kant and race. Debates initiated on the peripheries of philosophy, law and anthropology in the 1990s have led the way in this regard. However, given the time that has elapsed, it is notable that their work has received little scrutiny in political theory and International Relations theory, and thus warrants renewed attention. I argue that the notion of coloniality provides a useful lens through which to do so, and a vehicle through which to apply those excavations to a contemporary context. Finally, the article explores the extent to which Kantian thought constitutes ‘modern’ cosmopolitanism, and draws attention to the inadvertently complicit role of second-generation cosmopolitans in the erasure of race from the study of Kant. The relationship between the collective erasure of race and racism in academia and European practice towards refugees and immigrants is briefly considered.},
  abstract_source = {openalex},
}

@article{marwah2022whiteprogress,
  author = {Marwah, Inder S.},
  title = {White Progress: Kant, Race and Teleology},
  journal = {Kantian Review},
  year = {2022},
  volume = {27},
  number = {4},
  pages = {615--634},
  doi = {10.1017/S1369415422000334},
  note = {
  CORE ARGUMENT: Marwah argues that Kant's teleological conception of
  natural history generates implicit constraints on the moral
  development of non-white races: because Kant's theory treats human
  development as teleologically ordered toward rational self-governance,
  and because he assigns different races different positions in this
  teleological scheme, non-white peoples are positioned as less capable
  of the moral progress that defines humanity's vocation. This
  teleological racism cannot be eliminated by revising explicit racial
  hierarchies while retaining the teleological framework.

  RELEVANCE: Extends the structural critique to Kant's philosophy of
  history, showing that teleological racism persists even if Kant
  abandoned explicit racial ranking; directly challenges the project's
  question about whether Kantian universalism contains genuine
  anti-colonial resources.

  POSITION: Structural critique via teleology; racism embedded in
  the philosophy of history, not only in explicit racial remarks.
  },
  keywords = {Kant, race, teleology, progress, philosophy-of-history, structural-critique, Medium},
  abstract = {Abstract This article examines how Kant’s conceptualizations of natural history and teleological judgement shape his understanding of human difference and race. I argue that the teleological framework encasing Kant’s racial theory implies constraints on the capacity of non-whites to make moral progress. While commentators tend to approach Kant’s racial theory in relation to his political theory, his late-life cosmopolitanism, and his treatments (or non-treatments) of colonialism, empire and slavery, the problem I focus on here is that race is itself only intelligible in relation to a teleological natural history limiting certain races’ capacities to engage in humanity’s moral vocation.},
  abstract_source = {s2},
}

@article{meckstroth2017hospitality,
  author = {Meckstroth, Christopher},
  title = {Hospitality, or Kant's Critique of Cosmopolitanism and Human Rights},
  journal = {Political Theory},
  year = {2017},
  volume = {46},
  number = {4},
  pages = {537--559},
  doi = {10.1177/0090591717719546},
  note = {
  CORE ARGUMENT: Meckstroth offers a revisionary reading of Kant's
  hospitality right, arguing that it is not an affirmation of
  cosmopolitan universalism but a critique of the pretension of
  universal right to resolve the problem of coexistence between
  different political communities. Hospitality sets limits on what
  any community may demand of another, not on what a universal order
  may impose. The paper thereby challenges both human rights
  universalism and colonial civilising-mission arguments.

  RELEVANCE: Complicates the standard reading of hospitality as a
  straightforwardly universalist resource, raising the question of
  whether Kant's cosmopolitan right is designed to constrain
  universalist imposition as much as to project it -- relevant to
  the debate about whether universalism is Eurocentric.

  POSITION: Critical/revisionary; reads hospitality as
  anti-universalist in a specific sense.
  },
  keywords = {Kant, hospitality, cosmopolitan-right, universalism, political-theory, Medium},
  abstract = {Kant’s theory of international politics and his right of hospitality are commonly associated with expansive projects of securing human rights or cosmopolitan governance beyond state borders. This article shows how this view misunderstands Kant’s criticism of the law of nations ( ius gentium) tradition as handed down into the eighteenth century as well as the logic of his radical alternative, which was designed to explain the conditions of possibility of global peace as a solution to the Hobbesian problem of a war of all against all in the state of nature. I resolve longstanding confusion over the meaning and justification of Kant’s right of “hospitality” by showing how it functions not as a freestanding positive claim demanding enforcement but as a way of ruling out specious justifications for war against those the traditional law of nations permitted one to label “enemies.” This poses important questions for contemporary theories of global justice.},
  abstract_source = {openalex},
}

@article{kleingeld2016compass,
  author = {Kleingeld, Pauline},
  title = {Kant's Moral and Political Cosmopolitanism},
  journal = {Philosophy Compass},
  year = {2016},
  volume = {11},
  number = {1},
  pages = {14--23},
  doi = {10.1111/PHC3.12298},
  note = {
  CORE ARGUMENT: This survey essay outlines the principal debates in
  Kant's cosmopolitanism scholarship -- the nature of his advocated
  international federation, the theory of cosmopolitan right, and his
  views on colonialism and race -- while situating Kleingeld's own
  developmental interpretation. It also examines the relationship
  between patriotism and cosmopolitanism in Kant's mature writings.

  RELEVANCE: Provides an efficient orientation to the field and to
  Kleingeld's positions across multiple sub-debates; useful for the
  project as a concise summary of the landscape.

  POSITION: Developmental/rehabilitative; survey article.
  },
  keywords = {Kant, cosmopolitanism, race, colonialism, survey, Medium},
  abstract = {Abstract In this essay, I first outline the contexts in which the idea of cosmopolitanism appears in Kant's moral and political philosophy. I then survey the three main debates regarding his political cosmopolitanism, namely, on the nature of the international federation he advocated, his theory of cosmopolitan right, and his views on colonialism and ‘race’, and I consider the relation between patriotism and cosmopolitanism in Kant's work. I subsequently discuss Kant's moral cosmopolitanism. Kant is widely held to be a defender of moral cosmopolitanism, but the terminology of world citizenship is in fact strikingly rare in Kant's writings on moral theory. I offer a two‐part explanation for why this is the case.},
  abstract_source = {openalex},
}

@article{valdez2022narrow,
  author = {Valdez, In\'{e}s},
  title = {Toward a Narrow Cosmopolitanism: Kant's Anthropology, Racialized Character and the Construction of Europe},
  journal = {Kantian Review},
  year = {2022},
  volume = {27},
  number = {4},
  pages = {593--613},
  doi = {10.1017/S1369415422000358},
  note = {
  CORE ARGUMENT: Valdez argues that Kant's anthropological writings
  construct a racialized European character as the exemplar of
  cosmopolitan political virtue, thereby limiting the effective scope
  of his cosmopolitanism to a European "us" even while formally
  extending moral equality to all rational beings. The cosmopolitanism
  is narrow in that the political agency required to instantiate it is
  reserved for those whose character has been shaped by European
  civilization.

  RELEVANCE: Builds on but goes beyond Valdez's 2017 just-war account
  by showing that the anthropological dimension produces a structurally
  narrow cosmopolitanism that undermines universalist pretensions;
  directly relevant to the Eurocentric-universalism critique.

  POSITION: Structural critique; anthropology limits cosmopolitanism
  to a racialized European subject.
  },
  keywords = {Kant, cosmopolitanism, anthropology, race, Europe, structural-critique, Medium},
  abstract = {Abstract This article explores the distinctions among European peoples’ character established in Kant’s anthropology and their connection with his politics. These aspects are neglected relative to the analysis of race between Europeans and non-Europeans, but Kant’s anthropological works portray the people of Mediterranean Europe as not capable of civilization because of the dominance of passion in their faculty of desire, which he ties to ‘Oriental’ influences in blood or government. Kant then superimposes this racialized anthropology over the historical geopolitics of Europe, obscuring the indebtedness of Northern European trade dominance to Mediterranean historical tactics and financial wealth. By relegating the Mediterranean to the margins and dismissing contentious commercial exchange in the region as mere violence spearheaded by North African corsairs, Kant gives us an elitist cosmopolitanism unable to cope with hierarchy and inequality, diminishing its potential for egalitarian global projects today.},
  abstract_source = {s2},
}

@incollection{bernasconi2022invented,
  author = {Bernasconi, Robert},
  title = {Who Invented the Concept of Race?},
  booktitle = {Theories of Race and Racism},
  publisher = {Routledge},
  year = {2022},
  pages = {39--57},
  doi = {10.4324/9781003276630-4},
  note = {
  CORE ARGUMENT: Bernasconi traces the modern scientific concept of
  race to Kant's physical geography lectures and essays of the 1770s
  and 1780s, arguing that Kant was the first thinker systematically to
  define race as a natural-hereditary kind with fixed traits. This makes
  Kant not merely a purveyor of received prejudices but an active
  theorist of race whose conceptual innovations shaped subsequent racist
  science.

  RELEVANCE: Grounds the critical reading of Kant's racism in its
  historical-conceptual significance rather than its inconsistency with
  universalism; establishes that the racism is philosophically constructive,
  not merely incidental, and thus cannot be deleted from the Kantian
  corpus without loss.

  POSITION: Critical; Kant as founding theorist of modern racism.
  },
  keywords = {Kant, race, concept-of-race, Bernasconi, physical-geography, Low},
  abstract = {Who invented the scientific concept of race? This question admits of a variety of answers depending on what one takes to be decisive about the concept and on whether one believes that what defines the moment in which a technical term is introduced is the first usage of the word in the required sense or the definition that secures its status and influence. It will quickly become clear that by “the inventor of the concept of race” I mean the one who gave the concept sufficient definition for subsequent users to believe that they were addressing something whose scientific status could at least be debated. The terms and basis of the definition might continue to be scrutinized, but, so long as the term was being used only loosely, it made no sense to contest the concept. The invention of the concept of race in this sense took place some time after the introduction of the broad division of peoples on the basis of color, nationality, and other inherited characteristics that could not be overcome subsequently, as religious differences could be overcome by conversion. 1 One need only think of the purity of blood statutes of fifteenth-century Spain that were used against the conversos, Jews who had converted to Christianity but who were still not accepted. Then there were the debates in sixteenth-century Spain when the opponents of Bartolome dé Las Casas justified the mistreatment of Native Americans on the grounds that they were not human. One can also look at the Atlantic trade in African slaves that began in the sixteenth century and was already a large operation in the seventeenth century. It was possible for the Spanish or the English to exploit Jews, Native Americans, and Africans, as Jews, Native Americans, and Africans, without having the concept of race, let alone being able to appeal to a rigorous system of racial classification. We have no difficulty identifying these as cases of racism, but they were not sustained by a scientific concept of race. However, the introduction of that concept lent an air of apparent legitimacy to these practices. By investing the concept of race with a scientific status, members of the academy certainly have in the past contributed to making racism more respectable and have even seemed to provide a basis for it, but the academy of itself is now virtually powerless to undo those effects. However, we can at least try to throw some light on that history.},
  abstract_source = {openalex},
}
