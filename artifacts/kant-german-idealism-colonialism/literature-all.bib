  title     = {{KANT'S SECOND THOUGHTS ON RACE}},
  journal   = {The Philosophical Quarterly},
  year      = {2007},
  volume    = {57},
  number    = {229},
  pages     = {573--592},
  doi       = {10.1111/j.1467-9213.2007.498.x},
  note      = {
  CORE ARGUMENT: Kleingeld argues that Kant's position on race was not stable
  across his career. While his published work in the 1780s defended white
  superiority over non-whites as part of his race theory, in the 1790s he
  progressively restricted the concept of race to natural science, dropped his
  hierarchical account of racial capacities, and moved toward a genuinely
  egalitarian and cosmopolitan view. The article carefully distinguishes between
  Kant's scientific race theory and his normative rankings, arguing that he
  retracted the latter.

  RELEVANCE: This article launched the dominant interpretive debate in the
  literature -- the "recantation thesis" -- and is indispensable for the project's
  treatment of whether Kant's later cosmopolitanism can be deployed against
  colonialism. It establishes the diachronic framework for reading Kant on race
  that subsequent scholars (Bernasconi, Lu-Adler, Mills, Smith) explicitly contest.

  POSITION: Developmental/recantation: Kant genuinely changed his mind about
  racial hierarchy in the 1790s in favour of moral egalitarianism.
  },
  keywords  = {Kant, race, recantation, cosmopolitanism, Kleingeld, High},
  abstract = {During the 1780s, as Kant was developing his universalistic moral theory, he published texts in which he defended the superiority of whites over non-whites. Whether commentators see this as evidence of inconsistent universalism or of consistent inegalitarianism, they generally assume that Kant's position on race remained stable during the 1780s and 1790s. Against this standard view, I argue on the basis of his texts that Kant radically changed his mind. I examine his 1780s race theory and his hierarchical conception of the races, and subsequently address the question of the significance of these views, especially in the light of Kant's own ethical theory. I then show that during the 1790s Kant restricts the role of the concept of race, and drops his hierarchical account of the races in favour of a more genuinely egalitarian and cosmopolitan view.},
  abstract_source = {openalex},
}

@article{allais2016racism,
  author    = {Allais, Lucy},
  title     = {Kant's Racism},
  journal   = {Philosophical Papers},
  year      = {2016},
  volume    = {45},
  number    = {1-2},
  pages     = {1--36},
  doi       = {10.1080/05568641.2016.1199170},
  note      = {
  CORE ARGUMENT: Against Mills's thesis that Kant's racism is best understood
  as a threshold notion of moral personhood (whereby some races are excluded
  from moral consideration), Allais argues that Kant cannot be made internally
  consistent on race at all. Rather than forcing consistency, she proposes that
  Kant's racism should be read as a philosophically illuminating case study of
  what racism is: the persistence of false, entrenched beliefs about groups
  that resist rational correction even when the agent holds universalist moral
  commitments.

  RELEVANCE: The article intervenes in the debate over how Kant's racism relates
  to his moral theory, with direct bearing on whether Kantian ethics can be
  "salvaged" for anti-colonial purposes. Its conceptual account of racism as
  ideologically entrenched false belief rather than formal exclusion from moral
  standing has implications for how we assess the relationship between Kant's
  race texts and his critical philosophy.

  POSITION: Continuity/critical: Kant's racism is incompatible with his
  universalism, but this reveals something about the nature of racism rather
  than a route to consistency.
  },
  keywords  = {Kant, racism, moral-theory, Mills, universalism, High},
  abstract = {After a long period of comparative neglect, in the last few decades growing numbers of philosophers have been paying attention to the startling contrast presented between Kant's universal moral theory, with its inspiring enlightenment ideas of human autonomy, equality and dignity and Kant's racism. Against Charles Mills, who argues that the way to make Kant consistent is by attributing to him a threshold notion of moral personhood, according to which some races do not qualify for consideration under the categorical imperative, I argue that Kant cannot be made consistent on race, and that rather than trying to make him so, we should use the example of Kant's racism to tell us something about the nature of racism. I argue that Kant's own moral philosophy and moral psychology in fact give some materials for thinking about his racism, and about racism.},
  abstract_source = {openalex},
}

@article{marwah2022white,
  author    = {Marwah, Inder S.},
  title     = {White Progress: {Kant}, Race and Teleology},
  journal   = {Kantian Review},
  year      = {2022},
  volume    = {27},
  number    = {4},
  pages     = {615--634},
  doi       = {10.1017/S1369415422000334},
  note      = {
  CORE ARGUMENT: Marwah argues that Kant's racial theory is only fully
  intelligible within his teleological natural history, and that this framework
  structurally constrains non-white peoples' capacity for moral progress. The
  teleological embedding of race means that even if Kant's political theory or
  late cosmopolitanism appear more egalitarian, the underlying natural-historical
  framework still assigns differential moral-developmental capacities along
  racial lines.

  RELEVANCE: Directly addresses the intersection of Kant's teleology (central
  to his third Critique) with race, showing that the philosophical architecture
  of the critical system itself encodes racial hierarchy. This is crucial for
  the project's concern with how colonialism is implicated in Kant's systematic
  philosophy, not just his empirical writings.

  POSITION: Continuity/critical: teleological natural history entrenches
  racial hierarchy in the philosophical system as a whole.
  },
  keywords  = {Kant, teleology, race, natural-history, progress, High},
  abstract = {Abstract This article examines how Kant's conceptualizations of natural history and teleological judgement shape his understanding of human difference and race. I argue that the teleological framework encasing Kant's racial theory implies constraints on the capacity of non-whites to make moral progress. While commentators tend to approach Kant's racial theory in relation to his political theory, his late-life cosmopolitanism, and his treatments (or non-treatments) of colonialism, empire and slavery, the problem I focus on here is that race is itself only intelligible in relation to a teleological natural history limiting certain races' capacities to engage in humanity's moral vocation.},
  abstract_source = {s2},
}

@article{luadler2022travel,
  author    = {Lu-Adler, Huaping},
  title     = {Kant's Use of Travel Reports in Theorizing about Race: A Case Study of How Testimony Features in Natural Philosophy},
  journal   = {Studies in History and Philosophy of Science},
  year      = {2022},
  volume    = {91},
  pages     = {10--19},
  doi       = {10.1016/j.shpsa.2021.10.020},
  note      = {
  CORE ARGUMENT: Lu-Adler examines Kant's methodology in the three race essays,
  showing that he operated as a Naturforscher (philosophical investigator of
  nature) who used travel reports as a form of testimony to be selected,
  interpreted, and organized by philosophical reason. This rationalist theory
  of testimony explains both Kant's selective use of travelers' accounts and
  his confidence in racially hierarchical empirical generalizations he never
  directly observed.

  RELEVANCE: Clarifies how Kant's race theory relates to his broader epistemology
  of natural philosophy, showing that the methodology of the race essays is
  continuous with (not deviant from) his philosophical practice. Relevant to
  the project's interest in how philosophical method enabled rather than
  constrained colonial epistemologies.

  POSITION: Philosophical anatomy: methodology of Kant's race theory
  within his broader natural philosophy.
  },
  keywords  = {Kant, race, natural-philosophy, testimony, travel-reports, High},
  abstract = {A testimony is somebody else's reported experience of what has happened. It is an indispensable source of knowledge. It only gives us historical cognition, however, which stands in a complex relation to rational or philosophical cognition: while the latter presupposes historical cognition as its matter, one needs the architectonic "eye of a philosopher" to select, interpret, and organize historical cognition. Kant develops this rationalist theory of testimony. He also practices it in his own work, especially while theorizing about race as a subject of natural philosophy. In three dedicated essays on this subject, he treats race from the standpoint of a philosophical investigator of nature (Naturforscher), who (as Kant puts it in the first Critique) learns from nature "like an appointed judge who compels witnesses to answer the questions he puts to them." This view underwrites Kant's use of travel reports (a type of testimony) in developing and defending his theory of race.},
  abstract_source = {s2},
}

@article{luadler2022slavery,
  author    = {Lu-Adler, Huaping},
  title     = {Kant and Slavery -- Or Why He Never Became a Racial Egalitarian},
  journal   = {Critical Philosophy of Race},
  year      = {2022},
  volume    = {10},
  number    = {2},
  pages     = {263--294},
  doi       = {10.5325/critphilrace.10.2.0263},
  note      = {
  CORE ARGUMENT: Lu-Adler challenges the view that Kant's late-career criticisms
  of certain forms of slavery constitute evidence of racial egalitarianism. She
  argues that Kant's belated condemnations of colonial slavery were framed in
  terms of rights of trade and contract rather than racial equality, and that
  his racial hierarchy remained structurally intact. The article distinguishes
  Kant's gradual moral evolution on specific practices from any repudiation of
  the racial framework underpinning those practices.

  RELEVANCE: Provides the most direct engagement with the intersection of Kant's
  views on slavery, race, and colonialism, arguing against Kleingeld's recantation
  thesis specifically in the domain of colonial slavery. Essential for the
  project's assessment of whether Kant's critical philosophy of right can ground
  anti-colonial conclusions.

  POSITION: Continuity/critical: Kant never abandoned racial hierarchy
  even in repudiating some colonial practices.
  },
  keywords  = {Kant, slavery, race, colonialism, High},
  abstract = {Abstract:According to an oft-repeated narrative, while Kant maintained racist views through the 1780s, he changed his mind in the 1790s. Pauline Kleingeld introduced this narrative based on passages from Kant's Metaphysics of Morals (1797) and "Toward Perpetual Peace" (1795). On her reading, Kant categorically condemned chattel slavery (and colonialism) in those texts, which meant that he became more racially egalitarian. But the passages involving slavery, once contextualized, either do not concern modern, race-based chattel slavery or at best suggest that Kant mentioned it as a cautionary tale for labor practices in Europe. Overall, Kant never explicitly considered chattel slavery as a moral problem to be addressed on its own. Rather, he treated it primarily in terms of its function in human history. If he ended up expressing some qualms about its practices, it was likely because they threatened to deepen intra-European conflicts and undermine the prospect of perpetual peace. The humanity of the enslaved "Negroes" was never part of the reasoning. This was not a casual oversight on Kant's part. It reflects the complexity of his philosophical system: everything he did or did not say about chattel slavery begins to make sense once we connect his philosophy of history and his depiction of "Negroes" as natural slaves.},
  abstract_source = {s2},
}

@article{mills2014redux,
  author    = {Mills, Charles W.},
  title     = {Kant and Race, Redux},
  journal   = {Graduate Faculty Philosophy Journal},
  year      = {2014},
  volume    = {35},
  number    = {1},
  pages     = {125--157},
  doi       = {10.5840/gfpj2014351/27},
  note      = {
  CORE ARGUMENT: Mills revisits his earlier arguments about Kant's racial
  subpersonhood thesis in response to Kleingeld's developmental challenge.
  He maintains that Kant's anthropological writings imply a hierarchical account
  of personhood under which Africans and others are not full moral persons
  deserving equal treatment under the categorical imperative. Mills defends
  reading Kant as a "sub-person theorist" and argues that Kleingeld's
  developmental account underestimates the extent and philosophical depth of
  Kant's racism.

  RELEVANCE: Mills is the key defender of the view that Kant's racism
  contaminates his moral theory at the level of its application -- that the
  categorical imperative was not intended to apply equally across races. This
  is essential for debates about whether Kant's ethics can be used to ground
  anti-colonial critique or whether it is structurally compromised.

  POSITION: Continuity/subpersonhood: Kant's racism implies racially
  differentiated moral personhood.
  },
  keywords  = {Kant, race, subpersonhood, categorical-imperative, continuity-thesis, High},
  abstract = {The article is a contribution to the literature on Kant's racism. It revisits and expands on Mills's earlier claims about Kant's "Untermenschen" (subpersons), in which non-white races are, to varying degrees, excluded from full moral consideration under the categorical imperative. The paper responds in detail to Kleingeld's recent "recantation" thesis about Kant's alleged change of mind on race in the 1790s, contending that her argument fails to establish the crucial distinction between Kant's race science and his racial hierarchy of moral persons.},
  abstract_source = {openalex},
}

@article{mosayebi2025metaphysics,
  author    = {Mosayebi, Reza},
  title     = {Kant's Metaphysics of Race, Its Distinctiveness, and Its Normativity},
  journal   = {Journal of Social Philosophy},
  year      = {2025},
  doi       = {10.1111/josp.12612},
  note      = {
  CORE ARGUMENT: Using the contemporary taxonomy of the metaphysics of race,
  Mosayebi argues that Kant's race theory occupies a distinctive metaphysical
  position he calls "race teleo-rationalism": unlike race essentialism or race
  naturalism, Kant's position grounds racial hierarchy in a priori teleological
  principles of reason rather than purely empirical facts. He argues that this
  metaphysical distinctiveness makes Kant's racism particularly significant: it
  shows that racism can be licensed by rational a priori principles.

  RELEVANCE: Connects Kant's race theory to contemporary metaphysics of race
  debates, clarifying what is philosophically novel about Kant's position. The
  claim that rational a priori principles can generate racism is directly
  relevant to assessing whether Kantian universalism provides any check against
  colonial ideology.

  POSITION: Philosophical anatomy: Kant's race theory constitutes "race
  teleo-rationalism," a distinct metaphysical position grounded in a priori
  teleological reason.
  },
  keywords  = {Kant, metaphysics-of-race, teleology, normativity, High},
  abstract = {Drawing on the contemporary taxonomy of the metaphysics of race, this paper shows that Kant's theory of race occupies a distinct metaphysical position on race. Second, it argues that Kant's metaphysics of race inherently produces racist claims. Contrasting Kant's race theory with other metaphysical positions on race allows us to both understand his theory and its racist aspects better, and to improve the map of metaphysical positions on race. Closer analysis of Kant's metaphysics of race reveals that, contrary to common belief, it is not race essentialism (traditional racialism), it is inaccurate to see it just as a variant of race naturalism, and both racial development and racial hierarchy in Kant's theory are more complex than they seem on most scholars' reading of him. Kant's metaphysics of race, which will be called race teleo-rationalism, shows that racism could be justified by "reason" and its a priori principles and assumptions.},
  abstract_source = {s2},
}

@article{kleingeld2024antiracism,
  author    = {Kleingeld, Pauline},
  title     = {Anti-Racism and {Kant} Scholarship: A Critical Notice of {\em Kant, Race, and Racism: Views from Somewhere}, by {Huaping Lu-Adler}},
  journal   = {Mind},
  year      = {2024},
  doi       = {10.1093/mind/fzae022},
  note      = {
  CORE ARGUMENT: Kleingeld offers a sustained critical engagement with Lu-Adler's
  2023 monograph, questioning the framework of "racism as ideological formation"
  and arguing that Lu-Adler overstates the integration of Kant's racism with his
  systematic philosophy. Kleingeld defends a version of the developmental reading,
  insisting that the diachronic evolution of Kant's views must be taken seriously
  and that the anti-racist implications of his mature cosmopolitan ethics are
  real, even if his earlier views were deeply problematic.

  RELEVANCE: This exchange between Kleingeld and Lu-Adler (2025 response) represents
  the current live front of the field's central debate. Essential for the project's
  synthesis of whether Kant's philosophy can be retrieved for anti-colonial
  purposes or must be seen as fundamentally complicit.

  POSITION: Developmental: defends a version of the recantation/evolution
  thesis against Lu-Adler's continuity reading.
  },
  keywords = {Kant, race, anti-racism, Lu-Adler, Kleingeld, High, INCOMPLETE, no-abstract}
}

@article{luadler2025response,
  author    = {Lu-Adler, Huaping},
  title     = {Kant, Racism, and the Demands of Antiracism: A Critical Response to {Pauline Kleingeld}'s ``{Critical Notice}''},
  journal   = {Critical Philosophy of Race},
  year      = {2025},
  volume    = {13},
  number    = {2},
  pages     = {183--217},
  doi       = {10.5325/critphilrace.13.2.0183},
  note      = {
  CORE ARGUMENT: Lu-Adler responds to Kleingeld's critical notice by clarifying
  and reinforcing her account of racism as ideological formation, explaining
  why Kant's belated criticisms of some slavery practices should not be read
  as rejection of colonial slavery as an institution, and offering methodological
  reflections on the relationship between Kant scholarship and anti-racist
  commitments. She argues that the demands of antiracism require a more
  thoroughgoing critique of Kant's philosophy than Kleingeld's developmental
  reading permits.

  RELEVANCE: The direct response in the Kleingeld-Lu-Adler debate, making the
  stakes of the developmental vs. continuity dispute explicit in relation to
  antiracism. Defines the most current state of the debate in this domain.

  POSITION: Continuity/critical: Kantian philosophy cannot be straightforwardly
  retrieved for antiracist purposes.
  },
  keywords  = {Kant, racism, antiracism, colonialism, slavery, High},
  abstract = {Abstract:This critical response clarifies the critique of the commonly held assumption that racism contradicts Kant's pure moral philosophy. This piece explains why Kant's belated criticisms of some practices of slavery should not be interpreted as a rejection of colonial slavery as an institution. It ends with a reflection on the relation between Kant's philosophy and antiracism.},
  abstract_source = {s2},
}

@incollection{bernasconi2011third,
  author    = {Bernasconi, Robert},
  title     = {Kant's Third Thoughts on Race},
  booktitle = {Reading Kant's Geography},
  year      = {2011},
  pages     = {291--318},
  publisher = {SUNY Press},
  doi       = {10.1515/9781438436067-017},
  note      = {
  CORE ARGUMENT: Bernasconi identifies what he calls Kant's "third thoughts"
  on race -- the modifications Kant introduced in his 1788 essay "On the Use
  of Teleological Principles in Philosophy" in response to Georg Forster's
  challenge. He argues that rather than abandoning his race theory, Kant here
  refines and deepens it by grounding racial taxonomy more firmly in teleological
  natural history. Against Kleingeld's developmental thesis, Bernasconi argues
  this represents continuation and elaboration rather than retreat.

  RELEVANCE: This paper is crucial for the developmental debate because it focuses
  on Kant's most philosophically sophisticated race text (the 1788 essay), showing
  that even Kant's last dedicated race writing does not retract his hierarchical
  views. The connection to physical geography is also directly relevant to the
  colonialism project.

  POSITION: Continuity: the 1788 essay deepens rather than revises Kant's
  racial hierarchy.
  },
  keywords = {Kant, race-essays, teleology, physical-geography, continuity-thesis, Medium, INCOMPLETE, no-abstract},
}

@misc{bernasconi2002unfamiliar,
  author       = {Bernasconi, Robert},
  title        = {Kant as an Unfamiliar Source of Racism},
  year         = {2002},
  howpublished = {In Julie Ward and Tommy Lott (eds.), \textit{Philosophers on Race: Critical Essays}. Oxford: Blackwell, pp.\ 145--166},
  doi          = {10.1002/9780470753514.ch8},
  note         = {
  CORE ARGUMENT: Bernasconi argues that Kant should be recognized as a major,
  though often overlooked, source of modern scientific racism. He traces how
  Kant's systematic theory of race -- his first in 1775 -- gave race a
  philosophical foundation it had previously lacked and shows that Kant's
  biological monogenism was paired with a normative hierarchism that ranked
  races in terms of capacity for civilization and moral development.

  RELEVANCE: This essay provides the historical and conceptual case for treating
  Kant as not merely a participant in existing racial discourse but as an active
  constructor of the modern scientific concept of race. It is foundational for
  the colonialism project's argument about Enlightenment philosophy's complicity
  with colonial racial ideology.

  POSITION: Continuity/constructivist: Kant helped invent the modern
  philosophical concept of race.
  },
  keywords = {Kant, race, Enlightenment, scientific-racism, history-of-race, High, INCOMPLETE, no-abstract},
}

@article{sandford2018naturalhistory,
  author    = {Sandford, Stella},
  title     = {Kant, Race, and Natural History},
  journal   = {Philosophy \& Social Criticism},
  year      = {2018},
  volume    = {44},
  number    = {9},
  pages     = {950--977},
  doi       = {10.1177/0191453718768358},
  note      = {
  CORE ARGUMENT: Sandford situates Kant's race theory within the broader
  tradition of eighteenth-century natural history, examining how his account
  of human races relates to his distinction between natural description
  (Naturbeschreibung) and natural history (Naturgeschichte) proper. She argues
  that Kant's insistence on race as a genuine natural-historical concept is part
  of his attempt to give teleological natural history scientific status, and that
  this scientific ambition is inseparable from the racial hierarchy the theory
  generates. She also traces how this problem feeds into the first and third
  Critiques.

  RELEVANCE: Provides intellectual-historical contextualization of Kant's race
  theory within the history of natural science, while demonstrating connections
  to the critical philosophy. Relevant to the project's concern with how
  philosophical and scientific frameworks enabled colonial epistemologies.

  POSITION: Philosophical anatomy: race theory as part of Kant's project
  for natural history as a scientific discipline, with implications for
  the critical system.
  },
  keywords  = {Kant, race, natural-history, natural-science, critique-of-judgment, Medium},
  abstract = {This article presents a new argument concerning the relation between Kant's theory of race and aspects of the critical philosophy. It argues that Kant's treatment of the problem of the systematic unity of nature and knowledge in the Critique of Pure Reason and the Critique of the Power of Judgment can be traced back a methodological problem in the natural history of the period. Kant's transformation of the methodological problem from natural history into a set of philosophical (and specifically epistemological) problems proceeds by way of the working out of his own problem in natural history -- the problem of the natural history of the human races -- and specifically the problem of the unity in diversity of the human species, in response to which he develops a theory of race. This theory of race is, further, the first developed model of the use of teleological judgment in Kant's work. The article thus argues that Kant's philosophical position on the systematic unity of nature and of knowledge in the first and third Critiques, and his account and defense of teleological judgment, are developed out of problems first articulated in his solution to the problem of the unity in diversity of the human species.},
  abstract_source = {s2},
}

@article{ferrini2023epigenesis,
  author    = {Ferrini, Cinzia},
  title     = {The Epigenesis of Germs and Dispositions in Logic and Life: {Kant}'s System of Pure Reason and His Concept of Race},
  journal   = {SATS},
  year      = {2023},
  volume    = {24},
  number    = {2},
  pages     = {111--128},
  doi       = {10.1515/sats-2023-0013},
  note      = {
  CORE ARGUMENT: Ferrini examines the philosophical connection between Kant's
  adoption of epigenesis as a model for his system of pure reason (in the
  Transcendental Deduction, B167) and his theory of race in the 1775/1777
  essays. She argues that the Kantian race theory provides the background
  context for assessing Blumenbach's later shift to epigenesis, and that the
  structural analogy between germs/predispositions in race and the a priori
  concepts in the first Critique is philosophically significant rather than
  merely metaphorical.

  RELEVANCE: One of the few studies that connects Kant's race theory to the
  first Critique itself, arguing that the same conceptual apparatus (germs,
  predispositions, epigenesis) functions in both natural philosophy and
  transcendental idealism. Relevant to assessing how deeply Kant's racial
  concepts penetrate his critical system.

  POSITION: Philosophical anatomy: structural connection between race
  theory and transcendental philosophy via the epigenesis model.
  },
  keywords  = {Kant, epigenesis, race, Critique-of-Pure-Reason, germs, Medium},
  abstract = {Abstract In the 1787 Transcendental Deduction of the Categories Kant indicates the only possible ways by which one can account for a necessary agreement of experience with the concepts of its objects (B166), using analogies between modes of explanation and biological theories about the origin of life. He endorses epigenesis as a model for his system of pure reason (B167). This paper examines various interpretive claims about the meaning of this theory of generation and its significance for Kant's philosophy (Section 1), showing that, after his Critical shift in perspective, in 1775/77 Kant already combined preformed elements and their purposively oriented formation by natural forces (Section 2). Contrary to the standard view, Kant's theory of race appears to constitute the background to assess Blumenbach's later (1799/1781) shift to epigenesis after supporting Haller's preformism (Section 3). In Section 4, I argue that the ground of affinity between epigenesis and formal idealism rests in tracing the first origin of these conformities: external a posteriori climate conditions and predisposed germs and dispositions within the generative power of the human body; and external a posteriori experience and spontaneous a priori concepts of its objects, within pure sensory intuiting and pure thinking.},
  abstract_source = {s2},
}

@article{cohen2006epigenesis,
  author    = {Cohen, Alix A.},
  title     = {Kant on Epigenesis, Monogenesis and Human Nature: The Biological Premises of Anthropology},
  journal   = {Studies in History and Philosophy of Science Part C: Studies in History and Philosophy of Biological and Biomedical Sciences},
  year      = {2006},
  volume    = {37},
  number    = {4},
  pages     = {675--693},
  doi       = {10.1016/j.shpsc.2006.09.005},
  note      = {
  CORE ARGUMENT: Cohen reconstructs the biological foundations of Kant's
  anthropology, focusing on his commitments to epigenesis and monogenesis (the
  common origin of all human races). She shows how these biological premises
  underpin Kant's account of race as fixed hereditary modifications of a common
  human stock, triggered by climate, and why Kant's biological framework implies
  the permanent heritability of racial characteristics.

  RELEVANCE: Understanding the biological premises of Kant's race theory is
  essential for assessing its internal coherence and its relationship to
  contemporary biology. Cohen's paper provides the background for understanding
  why Kant saw race as permanent and heritable, which in turn explains the
  strength of his racial hierarchism.

  POSITION: Philosophical anatomy/philological: reconstructs biological
  foundations of Kantian race theory.
  },
  keywords  = {Kant, epigenesis, monogenesis, biology, anthropology, Medium},
  abstract = {This paper examines Kant's views on epigenesis, monogenesis and human nature in the context of his anthropological writings. It argues that Kant's commitment to monogenesis (the view that all human beings descend from a single common ancestor) and to epigenesis (the view that organisms are not preformed but develop through an active formative power) are interconnected and play a crucial role in his account of human nature, and in particular in his theory of race.},
  abstract_source = {openalex},
}

@article{hedrick2008race,
  author = {Hedrick, Todd},
  title = {Race, Difference, and Anthropology in Kant's Cosmopolitanism},
  journal = {Journal of the History of Philosophy},
  year = {2008},
  volume = {46},
  number = {2},
  pages = {245--268},
  doi = {10.1353/hph.0.0001},
  note = {
  CORE ARGUMENT: Hedrick argues that Kant's anthropological writings
  on race are not merely incidental to his cosmopolitanism but
  structurally related to it: the cosmopolitan project of cultivating
  human talents toward rational self-governance presupposes the
  anthropological framework in which non-European peoples are
  positioned as less developed or capable of such cultivation. Race
  difference thus enters into the normative architecture of Kant's
  cosmopolitanism, not merely into incidental empirical remarks.

  RELEVANCE: Represents the structural-critique position that directly
  challenges the Kleingeld developmental thesis by showing that
  racism is embedded in the philosophical framework, not a separable
  inconsistency. Key for the project's assessment of whether Kantian
  universalism is Eurocentric at its foundation.

  POSITION: Structural critique; argues race is internal to
  Kantian cosmopolitanism, not external to it.
  },
  keywords = {Kant, race, anthropology, cosmopolitanism, structural-critique, High},
  abstract = {This paper explores the connections between Kant’s theory of hierarchical racial difference, on the one hand, and his cosmopolitanism and conceptions of moral and political progress, on the other. I argue that Kant’s racial biology plays an essential role in maintaining national-cultural differences, which he views as essential for the establishment of the cosmopolitan union. Unfortunately, not only are these views racist, they also complicate Kant’s ability to consistently think through the prospect of the human species’ moral progress. Thus, while in the abstract, Kant’s attempts to understand the prospects for moral and political progress as rooted in historical reality, and his insistence that such progress is necessarily connected to the persistence of cultural difference, is appealing, his own way of carrying this out is decidedly not, being so intimately connected to racial hierarchy as a basic source of difference.},
  abstract_source = {openalex},
}

@article{mosayebi2025racemixing,
  author    = {Mosayebi, Reza},
  title     = {Kant on Race Mixing, Subracial Variety, and Progressive Culture},
  journal   = {Critical Philosophy of Race},
  year      = {2025},
  volume    = {13},
  number    = {1},
  pages     = {53--74},
  doi       = {10.5325/critphilrace.13.1.0053},
  note      = {
  CORE ARGUMENT: Mosayebi draws attention to the underexplored category of
  "variety" (Varietaet) in Kant's race theory -- a sub-racial level restricted
  to the white race that provides the internal diversity necessary for cultural
  progress. He argues that Kant's opposition to race mixing is not merely a
  biologistic prejudice but is integral to his teleological account of cultural
  progress, which assigns the generative role in civilizational development
  exclusively to white sub-racial variety.

  RELEVANCE: Reveals a structural connection between Kant's race theory and his
  philosophy of culture and progress that has not been previously analyzed.
  Directly bears on the project's concern with how Kant's racial hierarchy is
  embedded in his philosophy of history and teleology.

  POSITION: Philosophical anatomy: structural role of race and variety
  in Kant's teleological account of cultural progress.
  },
  keywords  = {Kant, race-mixing, variety, culture, teleology, Medium},
  abstract = {Abstract:Critical scholarship of Kant's race theory has been mainly focused on his concept of race. This article draws attention to his peculiar conception of "variety" as a subracial category that, restricted to the White race, plays a significant role in providing a diversity that enables progress in culture. The question organizing the article is this: How, on Kant's account, given its defense of radical racial inequality and degradation by race mixing, can the human diversity needed for substantial cultural achievements come about? Analyzing Kant's opposition to race mixing, this article shows that its corollary is a teleological conception of the diversity within the White racial group (White diversity).},
  abstract_source = {s2},
}

@article{stubenrauchmateo2024teleology,
  author    = {Mart{\'i}nez Mateo, Marina and Stubenrauch, Heiko},
  title     = {Teleological Judgment between Racism and Its Critique: On the Status of Race in {Kant}'s Work},
  journal   = {Rivista di Estetica},
  year      = {2024},
  volume    = {87},
  pages     = {81--98},
  doi       = {10.4000/13tuo},
  note      = {
  CORE ARGUMENT: The authors argue that Kant's engagement with race can only
  be understood within his teleological theory, in which nature is interpreted
  as a purposive whole directed toward the realization of freedom. While
  acknowledging that teleology thus makes race a philosophically meaningful
  concept that extends beyond natural philosophy to deny non-white people the
  ability to participate in the actualization of reason, they argue for an
  alternative form of teleological judgment that can serve as a resource for
  criticizing rather than legitimizing racism.

  RELEVANCE: Examines the dual potential of Kant's teleological framework --
  as both the ground of racial hierarchy and a possible resource for critique --
  relevant to the project's interest in whether German Idealist resources can
  be retrieved for anti-colonial purposes.

  POSITION: Philosophical anatomy with reconstructive intent: teleology grounds
  race hierarchy but may be reconstructed to critique racism.
  },
  keywords  = {Kant, teleology, race, critique, reconstruction, Low},
  abstract = {Over the last three decades, considerable debate has surrounded Immanuel Kant's views on race. In this article, we propose to address the question of race philosophically, explicitly and systematically relating it to Kant's critical work. We show that Kant's engagement with race can only be fully comprehended within the context of his teleological theory, wherein he interprets nature as a purposive whole facilitating the realization of freedom. Since Kant understands this teleological theory as the completion of his critical work, it occupies a key position in his philosophy, turning race into a philosophically meaningful concept. We conclude by advocating for an alternative form of teleological judgment that can serve as a means to criticize racism, rather than legitimize it.},
  abstract_source = {s2},
}

@article{luadler2023geography,
  author    = {Lu-Adler, Huaping},
  title     = {Know Your Place, Know Your Calling: Geography, Race, and {Kant}'s ``{World-Citizen}''},
  journal   = {Studia Kantiana},
  year      = {2023},
  doi       = {10.5380/sk.v21i2.92101},
  note      = {
  CORE ARGUMENT: Lu-Adler traces Kant's use of his geography and anthropology
  courses to form students -- Occidental white men -- in the self-perception
  that they were naturally positioned by their geographic location on Earth to
  be uniquely obliged and entitled to act as agents of human progress. She shows
  that this pedagogical function was integral to Kant's vision of world-citizenship,
  tracing the connection through works from the 1750s to his mature theory of
  race, moral theory, pragmatic anthropology, and theory of education.

  RELEVANCE: Directly connects the Physical Geography corpus to Kant's political
  philosophy and educational writings, showing how race and geography were
  integrated into the formation of a colonial world-civic identity. Essential
  context for the project's domain on Kant's cosmopolitanism and colonialism.

  POSITION: Continuity/critical: race and geography are constitutive
  of Kant's practical project of world-citizenship formation.
  },
  keywords  = {Kant, geography, race, world-citizen, cosmopolitanism, education, Low},
  abstract = {Anthropology and physical geography were among Kant's most popular and longest running courses. He intended them to give his students the world-knowledge that they needed in order to be effective world-citizens. Much of this indoctrination amounted to teaching Occidental white men, Kant's default audience, to perceive themselves as uniquely entitled and obliged to work as agents of human progress on the assumption that they, thanks to their geographic location on Earth, were naturally formed as an exceptional race.},
  abstract_source = {s2},
}

@book{kleingeld2011cosmopolitanism,
  author = {Kleingeld, Pauline},
  title = {Kant and Cosmopolitanism: The Philosophical Ideal of World Citizenship},
  publisher = {Cambridge University Press},
  year = {2011},
  doi = {10.1017/cbo9781139015486},
  note = {
  CORE ARGUMENT: This monograph reconstructs Kant's cosmopolitanism
  across its moral, legal, and political dimensions, arguing that Kant's
  mature political philosophy is genuinely cosmopolitan in a philosophically
  robust sense. Two chapters directly address the relationship between
  cosmopolitan right, race, and colonialism, extending the developmental
  thesis of the 2007 article into a book-length treatment.

  RELEVANCE: Provides the most systematic treatment of Kleingeld's
  position and is the primary reference for the claim that Kant's
  anti-colonialism is grounded in a revised, egalitarian cosmopolitanism.
  The project needs this as the key statement of the rehabilitative view.

  POSITION: Developmentalist; the primary monograph defense of
  Kleingeld's interpretation.
  },
  keywords = {Kant, cosmopolitanism, race, colonialism, right-of-hospitality, High},
  abstract = {This is the first comprehensive account of Kant's cosmopolitanism, highlighting its moral, political, legal, economic, cultural and psychological aspects. Contrasting Kant's views with those of his German contemporaries and relating them to current debates, Pauline Kleingeld sheds new light on texts that have been hitherto neglected or underestimated. In clear and carefully argued discussions, she shows that Kant's philosophical cosmopolitanism underwent a radical transformation in the mid 1790s and that the resulting theory is philosophically stronger than is usually thought. Using the work of figures such as Fichte, Cloots, Forster, Hegewisch, Wieland and Novalis, Kleingeld analyses Kant's arguments regarding the relationship between cosmopolitanism and patriotism, the importance of states, the ideal of an international federation, cultural pluralism, race, global economic justice and the psychological feasibility of the cosmopolitan ideal. In doing so, she reveals a broad spectrum of positions in cosmopolitan theory that are relevant to current discussions of cosmopolitanism.},
  abstract_source = {openalex},
}

@incollection{kleingeld2014colonialism,
  author = {Kleingeld, Pauline},
  title = {Kant's Second Thoughts on Colonialism},
  booktitle = {Kant and Colonialism: Historical and Critical Perspectives},
  editor = {Flikschuh, Katrin and Ypi, Lea},
  publisher = {Oxford University Press},
  year = {2014},
  pages = {43--67},
  doi = {10.1093/acprof:oso/9780199669622.003.0003},
  note = {
  CORE ARGUMENT: Kleingeld argues that Kant's initial endorsement and
  subsequent criticism of colonialism are closely connected to his
  changing views on race: because racial hierarchy underwrote his
  earlier justification of European expansion, abandoning the hierarchy
  in the 1790s entailed abandoning that justification. He replaced it
  with a more egalitarian account of cosmopolitan right that condemns
  colonial appropriation.

  RELEVANCE: Directly addresses the Kleingeld thesis in its fullest
  developed form, applying it specifically to colonialism rather than
  race in general. It demonstrates the internal connection between
  racial revision and the legal condemnation of colonial conquest that
  the project must assess.

  POSITION: Developmentalist; the most explicit application of the
  thesis to the colonialism question.
  },
  keywords = {Kant, colonialism, race, cosmopolitanism, developmentalism, High},
  abstract = {Kant is widely regarded as a fierce critic of colonialism. In Toward Perpetual Peace and the Metaphysics of Morals, for example, he forcefully condemns European conduct in the colonies as a flagrant violation of the principles of right. His earlier views on colonialism have not yet received much detailed scrutiny, however. In this essay I argue that Kant actually endorsed and justified European colonialism until the early 1790s. I show that Kant’s initial endorsement and his subsequent criticism of colonialism are closely related to his changing views on race, because his endorsement of a racial hierarchy plays a crucial role in his justification of European colonialism. He gave up both in the mid 1790s while he was developing his legal and political philosophy, and he adopted a more egalitarian version of the cosmopolitan relationship among peoples.},
  abstract_source = {openalex},
}

@book{flikschuhypi2014kant,
  editor = {Flikschuh, Katrin and Ypi, Lea},
  title = {Kant and Colonialism: Historical and Critical Perspectives},
  publisher = {Oxford University Press},
  year = {2014},
  doi = {10.1093/acprof:oso/9780199669622.001.0001},
  note = {
  CORE ARGUMENT: This edited volume assembles historical and systematic
  essays examining Kant's relationship to colonialism from multiple
  angles: the legal architecture of cosmopolitan right, the significance
  of his philosophical history for colonial justification, and the
  adequacy of his anti-colonial arguments. Contributors include
  Kleingeld, Ripstein, Niesen, Ypi, and others, representing both
  rehabilitative and critical positions.

  RELEVANCE: The single most important volume for this domain; it
  effectively defines the state of the debate at the time of its
  publication and is the primary reference for the legal-architectonic
  and developmental strands of interpretation.

  POSITION: Multi-perspectival; the key scholarly collection on the topic.
  },
  keywords = {Kant, colonialism, cosmopolitanism, right-of-hospitality, anthology, High},
  abstract = {Abstract This book examines Kant’s controversial position on colonialism in the context of his wider cosmopolitan commitments. The book explores Kant’s maturing opposition to European conquest and colonization, and the implication of that opposition to his moral and political thinking more generally. The book offers no single overall position on the subject matter but draws instead on the distinctive disciplinary expertise of individual contributors. In consequence, a picture emerges of the considerable complexity of the issue, including Kant’s many-faceted response to it, from the role of race and trade relations in his early and late teleological thinking, his acknowledgement of permissible as against impermissible colonial settlements, his late position on land rights of non-state peoples, and his view of the relation between war and colonial conquest, to prospects for Kantian principles of restorative international law. The opening chapters situate Kant’s unstable general conception of colonialism in historical context; the closing chapter explores the abiding relevance of Kant’s growing anti-colonial stance to current cosmopolitan thinking.},
  abstract_source = {openalex},
}

@incollection{ripstein2014juridical,
  author = {Ripstein, Arthur},
  title = {Kant's Juridical Theory of Colonialism},
  booktitle = {Kant and Colonialism: Historical and Critical Perspectives},
  editor = {Flikschuh, Katrin and Ypi, Lea},
  publisher = {Oxford University Press},
  year = {2014},
  pages = {145--169},
  doi = {10.1093/acprof:oso/9780199669622.003.0007},
  note = {
  CORE ARGUMENT: Ripstein analyses Kant's condemnation of colonial
  appropriation through the lens of the Doctrine of Right's juridical
  framework, arguing that colonialism violates the a priori conditions
  of rightful external relations because it forcibly incorporates
  peoples into a legal order without their consent, thus undermining
  the very possibility of public right. The condemnation is derived
  from juridical principles, not from moral sentiment.

  RELEVANCE: Provides the most rigorous legal-philosophical account of
  why Kant's anti-colonialism has genuine normative teeth independent
  of racial questions, grounding it in the theory of right rather than
  in contingent historical revision. This is the key counterpoint to
  the view that Kant's condemnation is merely rhetorical.

  POSITION: Legal-architectonic; defends the philosophical seriousness
  of Kant's anti-colonialism on juridical grounds.
  },
  keywords = {Kant, colonialism, right, Doctrine-of-Right, juridical, High},
  abstract = {Abstract Kant’s objections to colonialism are cast in juridical terms, focusing on the ways in which it is contrary to requirements of right under his conception of international law. Colonial conquest is an illicit ground for going to war, and colonization is an illicit mode of conduct after a war, even if the war itself was fought on other grounds. This chapter explains Kant’s arguments for the following claims: (i) Acquiring territory or securing markets is never a legitimate ground for war. (ii) Conquest is wrongful, but colonization is a defective form of conquest, worse than simply incorporating the territory into the conquering nation. (iii) Although colonial rule is not itself rightful, it has its own internal standard of adequacy, which colonial powers historically failed to satisfy.},
  abstract_source = {openalex},
}

@article{niesen2007colonialism,
  author = {Niesen, Peter},
  title = {Colonialism and Hospitality},
  journal = {Journal of International Political Theory},
  year = {2007},
  volume = {3},
  number = {1},
  pages = {90--108},
  doi = {10.1177/1743453X0700300108},
  note = {
  CORE ARGUMENT: Niesen examines Kant's right of hospitality in Toward
  Perpetual Peace, arguing that it establishes a genuine normative
  constraint on colonial expansion by prohibiting the European powers
  from treating non-European territories as legally vacant. He
  distinguishes between the right to visit and the right to settle,
  showing that Kant explicitly denies settlers a right to appropriate
  land already occupied by indigenous peoples.

  RELEVANCE: Provides the most focused treatment of hospitality as an
  anti-colonial principle in Kant's cosmopolitan right; connects the
  Perpetual Peace text directly to questions about indigenous rights
  and colonial dispossession that the project must address.

  POSITION: Legal-architectonic; reads hospitality as a genuine
  constraint on colonialism.
  },
  keywords = {Kant, hospitality, cosmopolitan-right, colonialism, perpetual-peace, High},
  abstract = {For Kant, the contents of cosmopolitan law are to be ‘limited’ to non-citizens' subjective rights to hospitality. Although hospitality yields universal and far-reaching communicative rights, its limits may seem overly restrictive at first. I argue that this narrow focus is intended to fend off justifications for colonial occupation that could otherwise draw support from Kant's own doctrine of private law. Kantian hospitality is further limited in that it does not cover all forms of communicative exchange. As can be shown from his endorsement of China's and Japan's protectionist policies, Kant is not averse to limiting cosmopolitan citizens' commercial speech. In conclusion, I discuss rivalling interpretations of Kant's justification of hospitality. I argue that this justification cannot rest exclusively on the innate human right to freedom, but must draw on facts about the world as well.},
  abstract_source = {openalex},
}

@book{muthu2003enlightenment,
  author = {Muthu, Sankar},
  title = {Enlightenment Against Empire},
  publisher = {Princeton University Press},
  year = {2003},
  note = {
  CORE ARGUMENT: Muthu argues that a significant strand of late
  Enlightenment thought -- including Kant, Herder, and Diderot --
  was genuinely anti-imperialist, grounded in a recognition of human
  cultural agency and the value of diversity. In Kant's case, the
  anti-imperial argument derives from the normative requirements of
  cosmopolitan right and the moral status of rational agents as ends
  in themselves, rather than from cultural pluralism as in Herder and
  Diderot.

  RELEVANCE: Situates Kant's anti-colonialism within a broader
  Enlightenment context and identifies the philosophical resources
  that make Kantian anti-imperialism distinctive; important for
  assessing whether Kantian universalism is inherently Eurocentric or
  contains genuine anti-colonial resources.

  POSITION: Rehabilitative/contextualist; reads Kant as a genuine
  opponent of empire on universalist grounds.
  },
  keywords = {Kant, Enlightenment, anti-colonialism, cosmopolitanism, empire, High, INCOMPLETE, no-abstract}
}

@article{valdez2017notaboutrace,
  author = {Valdez, In\'{e}s},
  title = {It's Not about Race: Good Wars, Bad Wars, and the Origins of Kant's Anti-Colonialism},
  journal = {American Political Science Review},
  year = {2017},
  volume = {111},
  number = {4},
  pages = {819--834},
  doi = {10.1017/s0003055417000223},
  note = {
  CORE ARGUMENT: Valdez argues against the Kleingeld thesis that Kant's
  anti-colonialism is primarily explained by a revision of his racial
  views. Instead, she contends that Kant's condemnation of colonial
  wars derives from his theory of just war and republican right: wars
  for commercial expansion or territorial conquest violate republican
  principles because they are not authorised by citizens and undermine
  the conditions for perpetual peace. Race is not the pivot on which
  Kant's anti-colonialism turns.

  RELEVANCE: Provides an important alternative to the Kleingeld thesis
  and complicates the simple developmental narrative; the project must
  consider whether legal-republican grounds are more or less stable
  than revised racial egalitarianism as the basis of anti-colonialism.

  POSITION: Alternative grounding; anti-colonialism from just-war and
  republican theory, not from racial revision.
  },
  keywords = {Kant, anti-colonialism, just-war, republican-right, race, High},
  abstract = {This article offers a new interpretation of Kant's cosmopolitanism and his anti-colonialism in Toward Perpetual Peace . Kant's changing position has been the subject of extensive debates that have, however, not recognized the central place of colonialism in the political, economic, and military debates in Europe in Kant's writings. Based on historical evidence not previously considered alongside Perpetual Peace , I suggest that Kant's leading concern at the time of writing is the negative effect of European expansionism and intra-European rivalry over colonial possessions on the possibility of peace in Europe. Because of the lack of affinity between colonial conflict and his philosophy of history, Kant must adjust his concept of antagonism to distinguish between war between particular dyads, in particular spaces, and with particular non-state actors. I examine the implications of this argument for Kant's system of Right and conclude that his anti-colonialism co-exists with hierarchical views of race.},
  abstract_source = {openalex},
}

@article{gani2017erasure,
  author = {Gani, Jasmine},
  title = {The Erasure of Race: Cosmopolitanism and the Illusion of Kantian Hospitality},
  journal = {Millennium: Journal of International Studies},
  year = {2017},
  volume = {45},
  number = {3},
  pages = {425--446},
  doi = {10.1177/0305829817714064},
  note = {
  CORE ARGUMENT: Gani argues that Kant's cosmopolitan hospitality
  systematically erases race as a morally relevant consideration:
  the universalism of hospitality is achieved by abstracting from
  the racial differences that Kant's own anthropological writings
  posit, producing a formal equality that conceals substantive racial
  hierarchy. The right of hospitality thus does not challenge colonial
  racism but reproduces it at a higher level of abstraction.

  RELEVANCE: Articulates the critical position that cosmopolitan
  universalism is not simply incomplete but actively conceals the
  racial hierarchy it presupposes; this challenges both the
  rehabilitative and the legal-architectonic readings and is
  important for assessing whether Kant's universalism is ideologically
  complicit in colonialism.

  POSITION: Structural critique; cosmopolitan hospitality as
  ideology that erases rather than confronts race.
  },
  keywords = {Kant, hospitality, race, cosmopolitanism, ideology, structural-critique, Medium},
  abstract = {This article explores three key arguments: Firstly, it seeks to demonstrate the contradictions and limits within Kantian hospitality, and its links to colonialism and practices of racialisation. The acclaimed universalism of Kant’s law of hospitality forecloses a discussion of its dualism, and erases the historical, racist context in which it was conceived. The prioritization of concept over conception allows Kant’s theory on race to be obscured from official discourse and framing of policies while it still courses through inherited perceptions and theories. Secondly, in making my case, I will be applying the notion of coloniality, coined by Aníbal Quijano and later developed by Walter Mignolo, to the existing but small body of critical discourse on Kant and race. Debates initiated on the peripheries of philosophy, law and anthropology in the 1990s have led the way in this regard. However, given the time that has elapsed, it is notable that their work has received little scrutiny in political theory and International Relations theory, and thus warrants renewed attention. I argue that the notion of coloniality provides a useful lens through which to do so, and a vehicle through which to apply those excavations to a contemporary context. Finally, the article explores the extent to which Kantian thought constitutes ‘modern’ cosmopolitanism, and draws attention to the inadvertently complicit role of second-generation cosmopolitans in the erasure of race from the study of Kant. The relationship between the collective erasure of race and racism in academia and European practice towards refugees and immigrants is briefly considered.},
  abstract_source = {openalex},
}

@article{meckstroth2017hospitality,
  author = {Meckstroth, Christopher},
  title = {Hospitality, or Kant's Critique of Cosmopolitanism and Human Rights},
  journal = {Political Theory},
  year = {2017},
  volume = {46},
  number = {4},
  pages = {537--559},
  doi = {10.1177/0090591717719546},
  note = {
  CORE ARGUMENT: Meckstroth offers a revisionary reading of Kant's
  hospitality right, arguing that it is not an affirmation of
  cosmopolitan universalism but a critique of the pretension of
  universal right to resolve the problem of coexistence between
  different political communities. Hospitality sets limits on what
  any community may demand of another, not on what a universal order
  may impose. The paper thereby challenges both human rights
  universalism and colonial civilising-mission arguments.

  RELEVANCE: Complicates the standard reading of hospitality as a
  straightforwardly universalist resource, raising the question of
  whether Kant's cosmopolitan right is designed to constrain
  universalist imposition as much as to project it -- relevant to
  the debate about whether universalism is Eurocentric.

  POSITION: Critical/revisionary; reads hospitality as
  anti-universalist in a specific sense.
  },
  keywords = {Kant, hospitality, cosmopolitan-right, universalism, political-theory, Medium},
  abstract = {Kant’s theory of international politics and his right of hospitality are commonly associated with expansive projects of securing human rights or cosmopolitan governance beyond state borders. This article shows how this view misunderstands Kant’s criticism of the law of nations ( ius gentium) tradition as handed down into the eighteenth century as well as the logic of his radical alternative, which was designed to explain the conditions of possibility of global peace as a solution to the Hobbesian problem of a war of all against all in the state of nature. I resolve longstanding confusion over the meaning and justification of Kant’s right of “hospitality” by showing how it functions not as a freestanding positive claim demanding enforcement but as a way of ruling out specious justifications for war against those the traditional law of nations permitted one to label “enemies.” This poses important questions for contemporary theories of global justice.},
  abstract_source = {openalex},
}

@article{kleingeld2016compass,
  author = {Kleingeld, Pauline},
  title = {Kant's Moral and Political Cosmopolitanism},
  journal = {Philosophy Compass},
  year = {2016},
  volume = {11},
  number = {1},
  pages = {14--23},
  doi = {10.1111/PHC3.12298},
  note = {
  CORE ARGUMENT: This survey essay outlines the principal debates in
  Kant's cosmopolitanism scholarship -- the nature of his advocated
  international federation, the theory of cosmopolitan right, and his
  views on colonialism and race -- while situating Kleingeld's own
  developmental interpretation. It also examines the relationship
  between patriotism and cosmopolitanism in Kant's mature writings.

  RELEVANCE: Provides an efficient orientation to the field and to
  Kleingeld's positions across multiple sub-debates; useful for the
  project as a concise summary of the landscape.

  POSITION: Developmental/rehabilitative; survey article.
  },
  keywords = {Kant, cosmopolitanism, race, colonialism, survey, Medium},
  abstract = {Abstract In this essay, I first outline the contexts in which the idea of cosmopolitanism appears in Kant's moral and political philosophy. I then survey the three main debates regarding his political cosmopolitanism, namely, on the nature of the international federation he advocated, his theory of cosmopolitan right, and his views on colonialism and ‘race’, and I consider the relation between patriotism and cosmopolitanism in Kant's work. I subsequently discuss Kant's moral cosmopolitanism. Kant is widely held to be a defender of moral cosmopolitanism, but the terminology of world citizenship is in fact strikingly rare in Kant's writings on moral theory. I offer a two‐part explanation for why this is the case.},
  abstract_source = {openalex},
}

@article{valdez2022narrow,
  author = {Valdez, In\'{e}s},
  title = {Toward a Narrow Cosmopolitanism: Kant's Anthropology, Racialized Character and the Construction of Europe},
  journal = {Kantian Review},
  year = {2022},
  volume = {27},
  number = {4},
  pages = {593--613},
  doi = {10.1017/S1369415422000358},
  note = {
  CORE ARGUMENT: Valdez argues that Kant's anthropological writings
  construct a racialized European character as the exemplar of
  cosmopolitan political virtue, thereby limiting the effective scope
  of his cosmopolitanism to a European "us" even while formally
  extending moral equality to all rational beings. The cosmopolitanism
  is narrow in that the political agency required to instantiate it is
  reserved for those whose character has been shaped by European
  civilization.

  RELEVANCE: Builds on but goes beyond Valdez's 2017 just-war account
  by showing that the anthropological dimension produces a structurally
  narrow cosmopolitanism that undermines universalist pretensions;
  directly relevant to the Eurocentric-universalism critique.

  POSITION: Structural critique; anthropology limits cosmopolitanism
  to a racialized European subject.
  },
  keywords = {Kant, cosmopolitanism, anthropology, race, Europe, structural-critique, Medium},
  abstract = {Abstract This article explores the distinctions among European peoples’ character established in Kant’s anthropology and their connection with his politics. These aspects are neglected relative to the analysis of race between Europeans and non-Europeans, but Kant’s anthropological works portray the people of Mediterranean Europe as not capable of civilization because of the dominance of passion in their faculty of desire, which he ties to ‘Oriental’ influences in blood or government. Kant then superimposes this racialized anthropology over the historical geopolitics of Europe, obscuring the indebtedness of Northern European trade dominance to Mediterranean historical tactics and financial wealth. By relegating the Mediterranean to the margins and dismissing contentious commercial exchange in the region as mere violence spearheaded by North African corsairs, Kant gives us an elitist cosmopolitanism unable to cope with hierarchy and inequality, diminishing its potential for egalitarian global projects today.},
  abstract_source = {s2},
}

@incollection{bernasconi2022invented,
  author = {Bernasconi, Robert},
  title = {Who Invented the Concept of Race?},
  booktitle = {Theories of Race and Racism},
  publisher = {Routledge},
  year = {2022},
  pages = {39--57},
  doi = {10.4324/9781003276630-4},
  note = {
  CORE ARGUMENT: Bernasconi traces the modern scientific concept of
  race to Kant's physical geography lectures and essays of the 1770s
  and 1780s, arguing that Kant was the first thinker systematically to
  define race as a natural-hereditary kind with fixed traits. This makes
  Kant not merely a purveyor of received prejudices but an active
  theorist of race whose conceptual innovations shaped subsequent racist
  science.

  RELEVANCE: Grounds the critical reading of Kant's racism in its
  historical-conceptual significance rather than its inconsistency with
  universalism; establishes that the racism is philosophically constructive,
  not merely incidental, and thus cannot be deleted from the Kantian
  corpus without loss.

  POSITION: Critical; Kant as founding theorist of modern racism.
  },
  keywords = {Kant, race, concept-of-race, Bernasconi, physical-geography, Low},
  abstract = {Who invented the scientific concept of race? This question admits of a variety of answers depending on what one takes to be decisive about the concept and on whether one believes that what defines the moment in which a technical term is introduced is the first usage of the word in the required sense or the definition that secures its status and influence. It will quickly become clear that by “the inventor of the concept of race” I mean the one who gave the concept sufficient definition for subsequent users to believe that they were addressing something whose scientific status could at least be debated. The terms and basis of the definition might continue to be scrutinized, but, so long as the term was being used only loosely, it made no sense to contest the concept. The invention of the concept of race in this sense took place some time after the introduction of the broad division of peoples on the basis of color, nationality, and other inherited characteristics that could not be overcome subsequently, as religious differences could be overcome by conversion. 1 One need only think of the purity of blood statutes of fifteenth-century Spain that were used against the conversos, Jews who had converted to Christianity but who were still not accepted. Then there were the debates in sixteenth-century Spain when the opponents of Bartolome dé Las Casas justified the mistreatment of Native Americans on the grounds that they were not human. One can also look at the Atlantic trade in African slaves that began in the sixteenth century and was already a large operation in the seventeenth century. It was possible for the Spanish or the English to exploit Jews, Native Americans, and Africans, as Jews, Native Americans, and Africans, without having the concept of race, let alone being able to appeal to a rigorous system of racial classification. We have no difficulty identifying these as cases of racism, but they were not sustained by a scientific concept of race. However, the introduction of that concept lent an air of apparent legitimacy to these practices. By investing the concept of race with a scientific status, members of the academy certainly have in the past contributed to making racism more respectable and have even seemed to provide a basis for it, but the academy of itself is now virtually powerless to undo those effects. However, we can at least try to throw some light on that history.},
  abstract_source = {openalex},
}

@article{bernasconi2024egypt,
  author = {Bernasconi, Robert},
  title = {Hegel and {Egypt}'s {African} Element},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {1},
  pages = {6--22},
  doi = {10.1017/hgl.2024.2},
  note = {
  CORE ARGUMENT: Contrary to the widespread view that Hegel simply excluded Africa from world history, Bernasconi argues that the specifically African element of Egypt was structurally indispensable to Hegel's dialectical account of world history — Africa's depiction as sheer immersion in nature generated the contradiction that Spirit had to overcome in moving from Egypt through Persia to Greece. The racist caricature of Africans in the Lectures was therefore not a contingent prejudice that commentators can bracket: it did systematic philosophical work. Drawing on the new critical edition of the Lectures in the Gesammelte Werke, Bernasconi also offers a close analysis of how editors Gans and Karl Hegel differently shaped the received text, with consequences for how Africa and Egypt were understood in the tradition.

  RELEVANCE: This is the most textually and philosophically precise recent treatment of Hegel's Africa, directly bearing on whether Eurocentrism is structurally necessary to Hegel's dialectic (the central question for this domain). The editorial analysis shows that debates about Hegel's views must also be debates about the transmission of the Lectures.

  POSITION: Structural necessity view, strengthened by editorial-historical analysis.
  },
  keywords = {Hegel, Africa, world-history, structural-racism, lectures-text, High},
  abstract = {Abstract Contrary to the widespread view that Hegel excluded Africa from what he called world history proper, the specifically African element of Egypt was indispensable to his account of the pivotal dialectical moment that saw spirit's release from its immersion in nature. Hegel's racist caricature of Africans in the early part of the lectures was not gratuitous, something that commentators can leave to one side. It was integral to his dialectical account of world history because it served to generate the contradiction that saw the Persian Empire give way to Greece. This understanding is confirmed by the newly completed four-volume edition of Hegel's Lectures on the Philosophy of World History in the Gesammelte Werke. These new volumes also enable us to gain critical insight into how the editors of the first two published versions of the lectures, Eduard Gans and Karl Hegel, sought in their different ways to shape the reception of Hegel's lectures.},
  abstract_source = {s2},
}

@article{stone2020colonialism,
  author = {Stone, Alison},
  title = {Hegel and Colonialism},
  journal = {Hegel Bulletin},
  year = {2017},
  volume = {41},
  number = {2},
  pages = {247--270},
  doi = {10.1017/hgl.2017.17},
  note = {
  CORE ARGUMENT: Stone argues that colonialism is not an incidental topic in Hegel but is embedded in the structure of his philosophy of history and his account of property in the Philosophy of Right. Hegel endorses European colonial expansion as a necessary stage in Spirit's self-realization and provides philosophical justifications for the colonization of peoples deemed to lack adequate property relations and statehood. Stone distinguishes between colonialism as a contingent historical phenomenon and as a structurally legitimated moment in Hegel's normative theory.

  RELEVANCE: This is among the most-cited scholarly treatments of Hegel and colonialism, with 77 citations; it frames the key structural question — whether Hegel's endorsement of colonial expansion is separable from his philosophy — that is central to the broader project.

  POSITION: Structural necessity view, emphasizing the Philosophy of Right as well as the Lectures.
  },
  keywords = {Hegel, colonialism, philosophy-of-right, world-history, structural, High},
  abstract = {Abstract This article explores the implications of Hegel’s Philosophy of World History with respect to colonialism. For Hegel, freedom can be recognized and practised only in classical, Christian and modern Europe; therefore, the world’s other peoples can acquire freedom only if Europeans impose their civilization upon them. Although this imposition denies freedom to colonized peoples, this denial is legitimate for Hegel because it is the sole condition on which these peoples can gain freedom in the longer term. The article then considers whether Hegel’s basic account of freedom can be extricated from his Eurocentric and pro-colonialist interpretation of the course of history. The article argues that matters are more complicated because that interpretation has significant connections with Hegel’s conception of freedom as self-determination.},
  abstract_source = {openalex},
}

@article{stone2017eurocentrism,
  author = {Stone, Alison},
  title = {{II}---{Europe} and {Eurocentrism}},
  journal = {Aristotelian Society Supplementary Volume},
  year = {2017},
  volume = {91},
  number = {1},
  pages = {83--104},
  doi = {10.1093/arisup/akw017},
  note = {
  CORE ARGUMENT: Stone examines the philosophical structure of Eurocentrism as a normative claim rather than merely an empirical generalization, arguing that Hegel's philosophy of history makes Europe not merely the contingent site of Spirit's highest realization but the necessary telos toward which all world history is oriented. She considers whether any form of world-historical teleology can avoid Eurocentric implications or whether Eurocentrism is built into the very grammar of universal history.

  RELEVANCE: Addresses the meta-level question of whether Eurocentric world history is a correctable empirical error or a structural feature of teleological philosophy of history — a question that is central to the broader project's treatment of German Idealism and colonialism.

  POSITION: Critical of Hegel's Eurocentrism as structurally embedded in teleological metaphysics.
  },
  keywords = {Hegel, Eurocentrism, world-history, teleology, philosophy-of-history, High},
  abstract = {In this article I explore how philosophical thinking about God, reason, humanity and history has shaped ideas of Europe, focusing on Hegel. For Hegel, Europe is the civilization that, by way of Christianity, has advanced the spirit of freedom which originated in Greece. Hegel is a Eurocentrist whose work indicates how Eurocentrism as a broader discourse has shaped received conceptions of Europe. I then distinguish ‘external’ and ‘internal’ ways of approaching ideas of Europe and defend the former approach, on which Europe’s self-understanding is not a phenomenon purely internal to Europe, but has always been shaped by Europe’s relations with non-European cultures. I note Egypt’s influence on the ancient Greeks and the role of Europe’s colonization of America, and suggest that European civilization could be rejuvenated by more open acknowledgement of these relations with others.},
  abstract_source = {openalex},
}

@article{bernasconi2000racial,
  author = {Bernasconi, Robert},
  title = {With What Must the Philosophy of World History Begin? {On} the Racial Basis of {Hegel}'s Eurocentrism},
  journal = {Nineteenth-Century Contexts},
  year = {2000},
  volume = {22},
  number = {2},
  pages = {171--201},
  doi = {10.1080/08905490008583507},
  note = {
  CORE ARGUMENT: Bernasconi argues that Hegel's Eurocentrism in the Lectures on the Philosophy of World History is not a contingent prejudice but is grounded in a racial hierarchy that Hegel adapted from earlier anthropological thought. Specifically, Hegel's geography of Spirit requires a racial starting point: the peoples of Africa and the Americas must be characterized as incapable of Spirit's self-development in order for the teleological narrative of European freedom to get off the ground. This makes Hegel's racism foundational to his philosophy of history, not extraneous to it.

  RELEVANCE: This landmark article (47 citations) established the structural-racism interpretation of Hegel and has been the reference point for all subsequent debate. It also situates Hegel within a broader intellectual context of racial anthropology relevant to the project's treatment of Kant and German Idealism.

  POSITION: Structural necessity view; one of the founding documents of this critical line.
  },
  keywords = {Hegel, race, Eurocentrism, world-history, racial-basis, High},
  abstract = {(2000). With what must the philosophy of world history begin? On the racial basis of Hegel's eurocentrism. Nineteenth-Century Contexts: Vol. 22, Race and social theory, pp. 171-201.},
  abstract_source = {openalex},
}

@book{buckmorss2009haiti,
  author = {Buck-Morss, Susan},
  title = {Hegel, {Haiti}, and Universal History},
  year = {2009},
  publisher = {University of Pittsburgh Press},
  doi = {10.2307/j.ctt7zwbgz},
  note = {
  CORE ARGUMENT: Buck-Morss advances the provocative thesis that Hegel's master-slave dialectic in the Phenomenology of Spirit was directly informed by his reading of newspaper accounts of the Haitian Revolution, and that the subsequent tradition of Hegel scholarship has systematically suppressed this connection. She argues that Hegel's universal history was therefore already in conversation with the anti-colonial and anti-slavery movements of his day, but that the Eurocentrism of the philosophy of world history represents a betrayal of the universalist promise of the dialectic.

  RELEVANCE: With 450 citations, this is one of the most influential interventions in the field, connecting Hegel's philosophical categories to colonial history and raising questions about what kinds of historical experience his system can acknowledge and what it must exclude. It also models a historicist methodology relevant to how the broader project should approach German Idealism.

  POSITION: Neither simply pro- nor anti-Hegel; opens a third approach that reads Hegel's dialectic against the grain of his explicit philosophy of history.
  },
  keywords = {Hegel, Haiti, master-slave, universal-history, colonial, High},
  abstract = {Buck-Morss draws new connections between history, inequality, social conflict, and human emancipation through a fundamental reinterpretation of Hegel's master-slave dialectic. Historicizing the thought of Hegel and the actions taken in the Haitian Revolution, Buck-Morss examines the startling connections between the two and challenges us to widen the boundaries of our historical imagination},
  abstract_source = {openalex},
}

@article{jamesknappik2022metaphysics,
  author = {James, Daniel and Knappik, Franz},
  title = {Exploring the Metaphysics of {Hegel}'s Racism: The Teleology of the `{Concept}' and the Taxonomy of Races},
  journal = {Hegel Bulletin},
  year = {2022},
  volume = {44},
  number = {1},
  pages = {99--126},
  doi = {10.1017/hgl.2022.38},
  note = {
  CORE ARGUMENT: James and Knappik reconstruct Hegel's hierarchical theory of race from the critical edition of lecture transcripts and argue that Hegel's racism is appropriately so-called: it postulates innate mental deficits of some races, and it grounds this claim in Hegel's general metaphysics of classification through the teleological unfolding of the Concept. Hegel's racial taxonomy is thus not a brute empirical assertion but a metaphysical claim about the necessary stages through which humanity's superordinate kind is realized. The article addresses two attempts to save Hegelian philosophy from its racist commitments and finds them unsuccessful.

  RELEVANCE: This is the most systematic philosophical analysis of the internal metaphysical structure of Hegel's racism, directly addressing the structural necessity vs. contingency debate and supporting the former. Highly relevant to the broader project's question of whether racism is philosophically embedded in German Idealism.

  POSITION: Structural necessity view, grounded in Hegel's metaphysics of the Concept.
  },
  keywords = {Hegel, race, racism, metaphysics, concept, taxonomy, High},
  abstract = {Abstract This article interprets Hegel's hierarchical theory of race as an application of his general views about the metaphysics of classification and explanation. We begin by offering a reconstruction of Hegel's hierarchical theory of race based on the critical edition of relevant lecture transcripts: we argue that Hegel's position on race is appropriately classified as racist, that it postulates innate mental deficits of some races, and that it turns racism from an anthropological into a metaphysical doctrine by claiming that the division of humankind into races (at least in the Old World) is not a brute fact, but follows a ‘higher necessity’. We then summarize our interpretation of the relevant metaphysical background to this theory. On our reading, Hegel postulates an essentialist form of explanation that explains given kinds as stages in a teleological, non-temporal process through which the nature of a superordinate kind is realized. We argue that Hegel's views about a hierarchical and necessary division of humankind into races are an application of this model to the case of human diversity, motivated by explanatory considerations and subject to confirmation bias. By way of conclusion, we address two possible attempts to ‘save’ Hegelian philosophy from its racist baggage.},
  abstract_source = {s2},
}

@article{harrisjames2026debating,
  author = {Harris, Kimberly Ann and James, Daniel},
  title = {Debating {Hegel}'s Racism},
  journal = {Philosophy Compass},
  year = {2026},
  volume = {21},
  number = {1},
  doi = {10.1111/phc3.70072},
  note = {
  CORE ARGUMENT: Harris and James survey the contemporary debate over Hegel's views on race, distinguishing scholars who regard his racial remarks as incidental or environmentally based from those who argue they reflect a hierarchical racialism embedded in his metaphysics and methodology. They argue that Hegel's framework links natural and cultural traits to normative and political status in ways that shape key concepts such as Spirit, freedom, and historical development, and conclude that his philosophy exemplifies philosophical racism in a technically precise sense.

  RELEVANCE: As a 2026 overview article in Philosophy Compass, this provides an authoritative entry point into the state of the debate, making it useful for orienting readers to the domain. It also situates Hegel's racism alongside the broader literature on race and German Idealism that is central to the project.

  POSITION: Structural necessity view; aims to adjudicate the debate rather than simply survey it.
  },
  keywords = {Hegel, race, racism, philosophical-racism, debate, overview, High},
  abstract = {This article examines the debate over Hegel's views on race and their place within his philosophical system. While some scholars regard his racial remarks as incidental or environmentally based, others argue they reflect a hierarchical racialism embedded in his metaphysics and methodology. The article contends that Hegel's framework links natural and cultural traits to normative and political status, shaping key concepts such as spirit, freedom and historical development. It concludes that Hegel's philosophy exemplifies philosophical racism, raising important questions about the enduring influence of his ideas on conceptions of freedom, personhood and historical progress.},
  abstract_source = {s2},
}

@article{hoffheimer2001genocide,
  author = {Hoffheimer, Michael H.},
  title = {Hegel, Race, Genocide},
  journal = {The Southern Journal of Philosophy},
  year = {2001},
  volume = {39},
  number = {S1},
  pages = {35--62},
  doi = {10.1111/j.2041-6962.2001.tb01841.x},
  note = {
  CORE ARGUMENT: Hoffheimer examines Hegel's explicit endorsement of the extermination of indigenous peoples in the Americas and other "uncivilized" populations in several passages across his works, arguing that these statements are not aberrations but follow from the logic of Hegel's philosophy of world history, which treats peoples without "Spirit" as having no claims that can constrain historical progress. Hoffheimer connects this to the concept of genocide and asks what philosophical responsibility is entailed by a theory that can sanction it.

  RELEVANCE: This article brings into sharp focus the most extreme implications of Hegel's exclusion of non-European peoples from world history, and it is among the most cited treatments of Hegel's treatment of indigenous and colonized peoples (22 citations). Central to the project's treatment of German Idealism and its colonial entanglements.

  POSITION: Structural necessity view; extends the critique from race to genocide.
  },
  keywords = {Hegel, race, genocide, indigenous, world-history, colonialism, Medium, INCOMPLETE, no-abstract}
}

@article{purtschert2010spirit,
  author = {Purtschert, Patricia},
  title = {On the Limit of Spirit: {Hegel}'s Racism Revisited},
  journal = {Philosophy \& Social Criticism},
  year = {2010},
  volume = {36},
  number = {9},
  pages = {1039--1051},
  doi = {10.1177/0191453710379029},
  note = {
  CORE ARGUMENT: Purtschert revisits Hegel's racism through a focus on his concept of "limit" (Grenze) in the philosophy of Spirit, arguing that the racialized hierarchy in the Anthropology and the Lectures reflects a constitutive exclusion: certain peoples must be posited as "limit cases" of Spirit — not quite outside Spirit but not fully within it — so that Spirit's universality can be defined and maintained. This internal-to-Spirit role of racial otherness makes the racism structural rather than external.

  RELEVANCE: Offers a more technically Hegelian argument for the structural necessity view by connecting Hegel's racial exclusions to his general concept of limit, providing a philosophical bridge between the metaphysical arguments of James and Knappik and the historical arguments of Bernasconi.

  POSITION: Structural necessity view, worked through Hegelian categories.
  },
  keywords = {Hegel, race, spirit, limit, anthropology, structural, Medium},
  abstract = {In his speech at the University of Dakar in July 2007, the French president Nicolas Sarkozy referred to Africa as the continent that has not yet fully entered history. This article takes this obvious reference to Hegel as its starting point and examines the current significance of ‘Hegel’s Africa’. Through a close reading of The Philosophy of History and The Phenomenology of Spirit, it shows that Hegel’s remarks on Africa are by no means incidental. They constitute rem(a)inders of a modernity that is based on the construction of Africa as its own limit. The return of Hegel’s Africa, the article concludes, can thus not be restricted to a problem of the new European right. It is part of an understanding of modernity that remains haunted by the specters of racism.},
  abstract_source = {openalex},
}

@article{chu2018blackinfinity,
  author = {Chu, Andrea Long},
  title = {Black Infinity: Slavery and Freedom in {Hegel}'s {Africa}},
  journal = {The Journal of Speculative Philosophy},
  year = {2018},
  volume = {32},
  number = {3},
  pages = {414--425},
  doi = {10.5325/jspecphil.32.3.0414},
  note = {
  CORE ARGUMENT: Chu reads Hegel's depiction of Africa in the Lectures as governed by the category of "bad infinity" (schlechte Unendlichkeit) — Africa represents for Hegel an undifferentiated, unarticulcated totality that cannot generate the determinate negation required for Spirit's movement. Chu argues that this categorization performs a philosophical function: it renders African slavery philosophically invisible, since a people characterized by bad infinity cannot achieve the kind of negation through which freedom is won in the master-slave dialectic. The paper connects this to the invisibility of Black suffering in Hegel's universal history.

  RELEVANCE: Provides a close reading connecting Hegel's explicit Africa passages to the master-slave dialectic and the concept of bad infinity, filling an important gap in the literature on the structural articulation of Africa's exclusion.

  POSITION: Structural necessity view using a distinctive conceptual entry point.
  },
  keywords = {Hegel, Africa, slavery, bad-infinity, master-slave, Medium},
  abstract = {ABSTRACT Hegel's remarks on Africa in the Lectures on the Philosophy of World History are notorious among critics and defenders alike—in particular Hegel's claim that the Atlantic slave trade, while unjust, was superior to native African slavery and thus should be abolished only gradually. Joining an ongoing conversation in black studies interrogating freedom's status as a structuring desideratum of critical and political practice, I argue that for Hegel, the European enslavement of Africans was essentially an emancipatory project that would rescue the Negro from his impenetrability to world spirit and introduce him to the long dialectical march of world history. Specifically, I argue that Hegel's distinction between Atlantic and African slavery reprises his distinction between good and bad infinity in his Science of Logic. As the case of slavery illustrates, however, neither distinction holds. Hegel could imagine no freedom for the Negro except in the form of infinitely more slavery—the slave labor of the negative through which the Negro would (never) become free. In such a project, freedom remains forever on the dark side of a middle passage. These conclusions challenge us to consider what radical politics without a concept of freedom would look like.},
  abstract_source = {openalex},
}

@article{stibor2024whitefreedom,
  author = {Stibor, Leonie},
  title = {Hegel and White Freedom},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {2},
  pages = {210--236},
  doi = {10.1017/hgl.2024.36},
  note = {
  CORE ARGUMENT: Stibor argues that Hegel's idea of freedom is not the racially neutral "universal" that commentators have assumed but is structurally linked to white identity through the Western concept of property. Because Hegel conceptualizes freedom as appropriation — the positing of one's will in external things — and because this model of appropriation underwrites the colonial seizure of land from peoples deemed incapable of proper ownership, Hegel's normative ideal of freedom cannot be applied as an impartial critical criterion against his racist and colonial remarks. The idea of freedom is itself racialized.

  RELEVANCE: Extends the structural necessity view into the heart of Hegel's practical philosophy, arguing that even the emancipatory resources of Hegel's thought are entangled with white supremacy — a claim with direct implications for the broader project's question of whether German Idealism's universalism can be saved from its colonial entanglements.

  POSITION: Extends structural necessity view to Hegel's practical and normative philosophy.
  },
  keywords = {Hegel, freedom, property, whiteness, practical-philosophy, colonialism, Medium},
  abstract = {Abstract Hegel's Lectures on the Philosophy of History are notorious for their racist portrayal of Africa. Few scholars, however, have considered their racism to be significant for Hegel's practical philosophy. This is largely because colonialism and Black enslavement appear to conflict with the idea of universal freedom at the heart of Hegel's practical philosophy. In my paper, I argue against this view and defend the claim that Hegel's idea of freedom is linked to white identity. It therefore grounds his racist comments in the Philosophy of History rather than opposing them. In order to show that Hegel's idea of freedom is linked to white identity, I trace its connections with the Western idea of property. My suggestion is that Hegel conceptualizes freedom as appropriation, thereby linking freedom to property and white identity. I conclude that Hegel's idea of freedom is an idea of white freedom and thus not an ‘impartial criterion’ for social critique.},
  abstract_source = {s2},
}

@article{lima2024contra,
  author = {Lima, Erick},
  title = {Hegel \textit{contra} {Hegel}: Eurocentrism, Colonialism, and Progress},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {2},
  pages = {237--264},
  doi = {10.1017/hgl.2024.8},
  note = {
  CORE ARGUMENT: Lima investigates whether Hegel's own philosophical resources — especially the concept of Spirit and the "progress in the consciousness of freedom" — can be turned against the Eurocentric and colonialist contents of the Lectures. Following Adorno's immanent critique of Hegel, Lima argues that the experiential dimension of Spirit's progress can capture its regressive moments, and that the Philosophy of Right's treatment of colonization reveals a significant discrepancy with the Lectures' Eurocentrism. He also compares Hegel's account of colonization with Marx's "primitive accumulation" to assess Hegel's connection between imperialism and capitalist critique.

  RELEVANCE: Represents the most philosophically sophisticated recent attempt at immanent critique — using Hegel against Hegel — which is a major strategy in the literature and one that the broader project must assess. Relevant to whether and how German Idealism can be rehabilitated.

  POSITION: Attempts immanent critique; finds partial resources in Hegel against Hegel's own Eurocentrism.
  },
  keywords = {Hegel, Eurocentrism, colonialism, immanent-critique, philosophy-of-right, Medium},
  abstract = {Abstract This study aims to investigate whether some of the Eurocentric and colonialist contents of Hegel's thought are open to criticism with elements of his own philosophy. First, I intend to show that some of these contents can be organized around the connection between ‘spirit’ and ‘progress’. I then construct an interpretation of Hegel's notion of spirit, based upon which I discuss its possibly pro-colonialist tendencies, arguing that disconnected from the philosophy of history it establishes a connection of autonomy and critique crucial even for anti-colonialist thought. Furthermore, following Adorno's criticism of Hegel, I investigate the possibility of finding in the ‘progress in the consciousness of freedom’ an experiential dimension capable of capturing its regressive moments. This analysis then leads to a discussion of colonization in the reconstruction of capitalist society presented in the Philosophy of Right, which reveals an important discrepancy, so I argue, concerning the Eurocentrism of the Philosophy of History. Finally, I propose a comparison of Hegel's discussion of colonization with Marx's theory of ‘primitive accumulation’, and evaluate thereby the pertinence of Hegel's connection between imperialism and the critique of capitalism.},
  abstract_source = {s2},
}

@article{egid2024hatata,
  author = {Egid, Jonathan},
  title = {Hegel and the \textit{Hat{\"a}ta Z{\"a}r'a Ya{\textquoteleft}\v{e}qob}: {Africa} in the Philosophy of History and the History of Philosophy},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {46},
  number = {2},
  pages = {287--310},
  doi = {10.1017/hgl.2024.33},
  note = {
  CORE ARGUMENT: Egid traces an underexplored episode in the reception of Hegel's philosophy of history: the way in which the exclusion of Africa from the historiography of philosophy (shaped decisively by Hegel's account of history as the realization of freedom) influenced the Ethiopianist scholar Carlo Conti Rossini's denial that "rationalistic" philosophy could exist in Ethiopia. Through analysis of the Hatata Zar'a Ya'qob — a seventeenth-century Ethiopian philosophical text — Egid shows how Hegel's framework served as a cultural justification for political domination, linking the denial of philosophical capacity to the justification of imperial control.

  RELEVANCE: Provides a concrete case study in the downstream effects of Hegel's exclusion of Africa from world history, tracing how philosophical categories translated into justifications of European imperialism in the colonial era. Directly relevant to the project's interest in the legacy of German Idealism for colonialism.

  POSITION: Historical-reception approach; documents the material consequences of Hegel's philosophical exclusions.
  },
  keywords = {Hegel, Africa, historiography-of-philosophy, Ethiopia, colonialism, reception, Medium},
  abstract = {Abstract This article explores an episode in the reception of Hegel's philosophy of history and historiography of philosophy with reference to the question of the possibility of non-Western philosophy, in particular African philosophy. Section I briefly outlines the contents of the Hatäta Zär'a Ya‛ǝqob and the controversy over its authorship, focusing in particular on the argument of the Ethiopianist and scholar of Semitic languages Carlo Conti Rossini that ‘rationalistic’ philosophy was impossible in Ethiopia. In section II I suggest that a major component of the intellectual background to this notion of the impossibility of philosophy in Africa can be traced to Hegel's philosophy of history. To substantiate this claim I begin by providing an account of the broader historiographical shift between 1780 and 1830, in which Africa and Asia came to be excluded from the history of philosophy, and I suggest that Hegel's philosophy of history was decisive in this process. I examine how Hegel's account of history as the realization and actualization of freedom goes together with the development of cultural production culminating in philosophy, and how both of these processes (if they are really separate processes at all), can be mapped onto particular historical-geographical populations and cultures. I suggest that, even though this was not Hegel's intention, by the late nineteenth and early twentieth centuries this served as a cultural justification for political domination: those who are unfree are unfree because they are unthinking (unphilosophical), and those who are unthinking cannot be free. Finally in section III I connect this Hegelian conception to Conti Rossini's work, both his article on the Hatäta and as apologist for Italian imperialism. I conclude by reflecting on what this underexplored connection between Hegel and early twentieth-century theorists of culture might mean for attempts to construct global histories of philosophy.},
  abstract_source = {s2},
}

@article{goggin2024religion,
  author = {Goggin, W. Ezekiel},
  title = {Race and Colonialism in {Hegel}'s Philosophy of Religion},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {2},
  pages = {185--209},
  doi = {10.1017/hgl.2024.9},
  note = {
  CORE ARGUMENT: Goggin argues that race and coloniality shape Hegel's philosophy of religion from its inception, particularly through the concept of "fetishism" which Hegel uses to characterize African and other non-European religious practices. By reconstructing how the concept of the fetish does philosophical work in Hegel's attempts to critique and vindicate European modernity, Goggin shows that Hegel's intellectual project is racialized not only in the Lectures on World History but in his systematic philosophy of religion, providing resources for an alternative philosophical approach to the fetish concept.

  RELEVANCE: Extends the structural racism analysis beyond the Lectures to Hegel's philosophy of religion, which is less studied in this connection, strengthening the overall case for structural rather than contingent racism in Hegel's system.

  POSITION: Structural necessity view applied to philosophy of religion.
  },
  keywords = {Hegel, race, religion, fetishism, colonialism, Medium},
  abstract = {Abstract Scholars have paid limited attention to the crucial relationship between Hegel's racism, his support for colonialism and his views on religion. This essay offers a critical reconstruction of how race and coloniality shape the question of religion (and vice versa) throughout Hegel's attempts to critique and ultimately vindicate European modernity. Paying special attention to the seminal role of ‘fetishism’ in his works, I argue that Hegel's intellectual concerns are racialized from the inception of his project. I conclude by suggesting an alternative philosophical approach to the concept of the ‘fetish’ and ‘fetishism’ to resist Hegel's racist and pro-colonial tendencies.},
  abstract_source = {s2},
}

@article{jamesknappik2024intro,
  author = {James, Daniel and Knappik, Franz},
  title = {Introduction to Part 1 of the Themed Issue, `{Racism} and Colonialism in {Hegel}'s Philosophy': Rationale and Topics},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {1},
  pages = {1--5},
  doi = {10.1017/hgl.2024.14},
  note = {
  CORE ARGUMENT: James and Knappik introduce the 2024 Hegel Bulletin themed issue on racism and colonialism in Hegel, situating it within the broader context of philosophy's reckoning with its entanglement in colonial and racist ideologies. They outline the rationale for the themed issue, noting that while the colonial and racist dimensions of Western modernity have been legitimized by philosophical traditions since the sixteenth century, the specific role of Hegel's philosophy has been underexplored compared to, for example, Kant's racial anthropology.

  RELEVANCE: Provides an authoritative recent overview of the state of the field on Hegel, racism, and colonialism, and situates the scholarly project in relation to parallel work on Kant. The themed issue it introduces contains several of the most important recent articles in this domain.

  POSITION: Contextual/editorial; maps the field.
  },
  keywords = {Hegel, racism, colonialism, overview, themed-issue, Low},
  abstract = {It is increasingly realized today that Western modernity has not only promoted progressive ideals such as scientific thought, human rights and democratic political systems. Its history is also marked by a much darker side, one of brutal conquest, biological and cultural destruction, enslavement and exploitation of non-European peoples in the context of European colonialism. This dark side of Western modernity was legitimized by pro-colonial ideologies of property, war, civilization, progress and race. Such ideologies emerged in areas like jurisprudence and philosophy since the 16th century, often building on views from classical antiquity (Pagden 1995). They shaped academic paradigms such as ‘scientific racism’, colonial anthropology and Orientalism in the 19th and early 20th centuries, and in many ways continue to influence contemporary societies and their academic practices.},
  abstract_source = {s2},
}

@article{camara2005falsity,
  author = {Camara, Babacar},
  title = {The Falsity of {Hegel}'s Theses on {Africa}},
  journal = {Journal of Black Studies},
  year = {2005},
  volume = {36},
  number = {1},
  pages = {82--96},
  doi = {10.1177/0021934704268296},
  note = {
  CORE ARGUMENT: Camara critiques the empirical and philosophical foundations of Hegel's claims about Africa — that Africa has no history, no State, no religion in the proper sense — arguing that each of these theses is factually false and based on ignorance of African societies. He draws on historical and anthropological evidence to show that Hegel's account was a philosophical rationalization of ideological prejudice rather than an informed philosophical judgment, and that the Hegelian framework cannot be rehabilitated while retaining the Africa passages.

  RELEVANCE: Represents the African and Africana philosophical tradition's response to Hegel, providing the perspective that Hegel's claims are simply false and ideologically motivated. This empirical-historical approach complements the more internal philosophical critiques and is important for a comprehensive treatment.

  POSITION: Empirical refutation approach; does not engage with structural vs. contingency debate but rejects the foundation.
  },
  keywords = {Hegel, Africa, empirical-critique, falsity, Africana-philosophy, Low},
  abstract = {Many Black scholars reject G.W.F. Hegel, for his Philosophy of History ignominiously and grotesquely denigrates Africans. This article first discusses Negritude’s detournement of Hegel’s theses and, from an African point of view, refutes two Hegelian theses: slavery and the state in Africa. Hegel contradicts itself, and the very dialectic analytical method that excluded Africa from universal history also fully reinstates it.},
  abstract_source = {openalex},
}

@article{buckmorss2000hegel,
  author = {Buck-Morss, Susan},
  title = {Hegel and Haiti},
  journal = {Critical Inquiry},
  year = {2000},
  volume = {26},
  number = {4},
  pages = {821--865},
  doi = {10.1086/448993},
  note = {
  CORE ARGUMENT: Argues that Hegel composed the lordship-and-bondage section of
  the Phenomenology (1807) while reading accounts of the Haitian Revolution
  (1791-1804) in the journal Minerva, making actual New World slavery -- not a
  philosophical abstraction -- the historical ground of the master-slave
  dialectic. Buck-Morss contends that the dialectic's claim to universality is
  substantiated, not undermined, by this historical grounding: enslaved Haitians
  enacted the demand for freedom more concretely than any European revolutionary.

  RELEVANCE: This is the foundational text for the debate over Hegel and Haiti.
  Every subsequent paper in this domain either defends, refines, or contests
  Buck-Morss's historiographical thesis or her normative conclusions about
  Hegelian universalism. Essential for the literature review's treatment of
  whether German Idealism engages or erases colonial slavery.

  POSITION: Represents the "historicist rehabilitation" of Hegel's dialectic: by
  recovering Haiti as its historical referent, Buck-Morss attempts to show that
  Hegelian universalism was always already implicated in New World slavery, and
  that this implication should be acknowledged and built upon rather than
  suppressed.
  },
  keywords = {Hegel, Haiti, master-slave-dialectic, Buck-Morss, universalism, High, INCOMPLETE, no-abstract}
}

@article{ciccariellomaher2014worse,
  author = {Ciccariello-Maher, George},
  title = {{`So Much the Worse for the Whites': Dialectics of the Haitian Revolution}},
  journal = {Journal of French and Francophone Philosophy},
  year = {2014},
  volume = {22},
  number = {1},
  pages = {19--39},
  doi = {10.5195/jffp.2014.641},
  note = {
  CORE ARGUMENT: Accepts the Buck-Morss thesis that the Haitian Revolution
  informed the Phenomenology's dialectic but identifies a series of "ironic
  silences" in her account: she centers Toussaint L'Ouverture and neglects
  Jean-Jacques Dessalines, whose anti-identitarian violence was constitutive of
  the revolution's universality. Ciccariello-Maher argues, drawing on C.L.R.
  James's "The Black Jacobins," that the universal is not given in advance but
  forged through particular identitarian struggles -- and that Fanon's
  reformulation of the Hegelian dialectic (overlooked by Buck-Morss) is the
  corrective needed to think emancipation in "decolonized dialectical terms."

  RELEVANCE: This paper represents an important internal critique and extension
  of the Buck-Morss thesis that also bridges it to the Fanon literature. It is
  essential for showing that defenders of the Haiti-thesis do not form a
  monolithic camp.

  POSITION: "Decolonized dialectics" position: accepts historical grounding of
  the dialectic in Haiti but argues Buck-Morss's version is still too Hegelian --
  it needs to be radicalized via Fanon and Dessalines.
  },
  keywords = {Hegel, Haiti, Fanon, Ciccariello-Maher, dialectic, universalism, High},
  abstract = {This article sets out from an analysis of the pioneering work of Susan Buck-Morss to rethink, not only Hegel and Haiti, but broader questions surrounding dialectics and the universal brought to light by the Haitian Revolution. Reading through the lens of C.L.R. James’ The Black Jacobins , I seek to correct a series of ironic silences in her account, re-centering the importance of Toussaint’s successor, Jean-Jacques Dessalines, and underlining the dialectical importance of identitarian struggles in forging the universal. Finally, I offer Frantz Fanon’s reformulation of the Hegelian master-slave dialectic—overlooked in Buck-Morss’ account—as a corrective that allows us to truly rethink progress toward the universal in decolonized dialectical terms.},
  abstract_source = {s2},
}

@book{fischer2004modernity,
  author = {Fischer, Sibylle},
  title = {Modernity Disavowed: {Haiti} and the Cultures of Slavery in the Age of Revolution},
  publisher = {Duke University Press},
  year = {2004},
  doi = {10.1215/9780822385509},
  note = {
  CORE ARGUMENT: Argues that Caribbean colonial slavery was not peripheral but
  central to the formation of Western modernity, and that the Haitian Revolution
  was systematically disavowed -- erased from historical consciousness -- by both
  European and American intellectual culture. Fischer analyzes literary, legal, and
  philosophical texts to show how this disavowal operated, and argues that
  recovering Haiti means rethinking modernity as structured by this foundational
  forgetting.

  RELEVANCE: Provides the broader cultural-historical framework in which the
  Buck-Morss thesis is situated. Fischer's concept of "disavowal" -- the active
  suppression of the Haitian Revolution's significance -- is a key explanatory
  resource for understanding why Hegel's possible engagement with Haiti was itself
  suppressed in the canonical reception of the Phenomenology.

  POSITION: Cultural-historical postcolonial critique that extends beyond the
  specifically philosophical debate over Hegel to the broader question of why
  revolutionary Haiti was systematically excluded from Western modernity's
  self-understanding.
  },
  keywords = {Haiti, modernity, slavery, disavowal, Fischer, postcolonial, High},
  abstract = {On 1 January 1804, the revolutionary slaves of Saint Domingue established the first independent black state in the Americas and proclaimed their break with the French Republic. After more than a decade of protracted bloody battles, the only successful slave revolution in world history ended. The richest sugar colony of the New World was reduced to ashes, and of the troops Napoleon had sent with genocidal intent only very few made it back home. But while the bicentennial of the French Revolution in 1989 and quincentennial of the "discovery" of America in 1992 were lavishly celebrated with acts of State, monuments, conferences, and polemics, the Haitian Revolution's anniversary is bound to be passed over in silence in both the halls of power and metropolitan academies. Although few would doubt the profound effect the slave revolution had on the Western Hemisphere, there has until now been no extended study of it, and some describe Haiti as unrelated to any of the worlds' major civilizations. Modernity Disavowed tells a very different story: the Haitian Revolution is at the core of Western modernity in the Age of Revolution, and one of the reasons for subsequent denial or silencing is that Haiti forced the recognition of this fact on slaveholders and imperial powers. At a time when racial taxonomies were beginning to mutate into scientific racism and racist biology, the Haitian revolutionaries recognized the question of colour and race as a political one and placed claims of racial equality squarely on the agenda. Yet, as the cultural records of neighboring Cuba and the Dominican Republic show, the story of the Haitian Revolution has been framed in terms of barbarism unspeakable violence, outside civilization, outside politics, and beyond human language. From the time of the revolution onwards the story has been relegated to the margins of history; to rumors, oral histories confidential letters and secret trials. Focusing on Cuba, the Dominican Republic and Haiti itself in the context of the African Diaspora, Modernity Disavowed argues that we cannot even begin to understand Creole cultures in the Americas unless we understand how they took shape around various forms of denial of the Haitian Revolution.},
  abstract_source = {s2},
}

@article{fischer2010history,
  author = {Fischer, Sibylle},
  title = {History and Catastrophe},
  journal = {Small Axe: A Caribbean Journal of Criticism},
  year = {2010},
  volume = {14},
  number = {3},
  pages = {163--172},
  doi = {10.1215/07990537-2010-032},
  note = {
  CORE ARGUMENT: A critical response to Buck-Morss's "Hegel, Haiti, and Universal
  History" that raises historiographical and methodological concerns. Fischer
  acknowledges the importance of the Haiti thesis but questions whether connecting
  Hegel's dialectic to the Haitian Revolution actually serves the goal of centering
  Caribbean history, or whether it instead re-centers Hegel.

  RELEVANCE: This short response article represents an important corrective from
  within the postcolonial Caribbean studies tradition. It cautions against reading
  the significance of the Haitian Revolution primarily through the lens of what it
  means for European philosophy, raising the question of whether the Buck-Morss
  thesis is Haito-centric or Hegel-centric.

  POSITION: Critical complication of the Buck-Morss thesis from a Caribbean
  studies perspective, questioning the methodological priority given to Hegel
  over Haiti.
  },
  keywords = {Haiti, Hegel, Buck-Morss, Fischer, methodology, Caribbean, Medium},
  abstract = {Can we coherently conjugate high philosophy and slave insurgency under the heading of “universal history”? Is it possible to disentangle “universal history” from its roots in white supremacy and European imperial reason? Susan Buck-Morss' recent answer to that question, which was left somewhat unresolved in her seminal essay “Hegel and Haiti,” turns the Haitian Revolution and its half suppressed echo in Hegel's master-slave dialectic into an emblematic event. Universal ideas of liberty and liberation can only be glimpsed in singular moments of rupture, systemic break-down, and violence. The slave insurgency in Saint Domingue thus becomes a privileged moment in universal history. While I find Buck-Morss' reading of Hegel's master-slave dialectic in light of the Haitian Revolution more persuasive than many other recent attempts at thinking universality in relation to slave insurgency, I am troubled by the fact that Buck-Morss' anti-multiculturalist notion of universality is predicated on an epistemology of catastrophe and the violent stripping of the individual of cultural and social ties. If there is anything we can learn from the Western history of catastrophes, from Atlantic slavery to the Holocaust, it is that the nakedness and vulnerability of the victim is more likely to lead to fantastical cruelty than to the promotion of liberationist thought.},
  abstract_source = {openalex},
}

@article{jaarte2024colonial,
  author = {Jaarte, Miikka},
  title = {Colonial Slavery, the Lord-Bondsman Dialectic, and the {St Louis Hegelians}},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {1},
  pages = {43--64},
  doi = {10.1017/hgl.2024.3},
  note = {
  CORE ARGUMENT: Advances two connected theses: (1) contrary to progressive
  defenders of Hegel, the lord-bondsman dialectic cannot be easily separated from
  Hegel's pro-colonialism, because Hegel himself used the dialectic to argue that
  colonial slavery temporarily educated its victims; (2) this pro-colonial reading
  of the dialectic, ignored by contemporary commentators, was in fact recognized
  and embraced by the St Louis Hegelians, who used it as a qualified defense of
  pre-Civil War American slavery. Draws on work by Bernasconi and Stone to
  establish Hegel's racism and pro-colonialism as central, not peripheral.

  RELEVANCE: Directly challenges the progressive-appropriation of the lordship
  and-bondage section (including Buck-Morss) by showing that Hegel himself
  applied it in a pro-colonial direction. The paper is essential for the claim
  that the dialectic is not available for emancipatory re-use without significant
  transformation.

  POSITION: Pro-colonial Hegel thesis: the lord-bondsman dialectic is internally
  connected to Hegel's defense of colonial slavery, not opposed to it.
  },
  keywords = {Hegel, lordship-bondage, colonialism, slavery, St-Louis-Hegelians, Jaarte, High},
  abstract = {Abstract Hegel's lord-bondsman dialectic has been of especially great interest to progressive and radical Hegelians—broadly speaking, politically left-leaning interpreters of Hegel who object to certain social hierarchies and demand their abolition. They read Hegel as giving an account of how ‘lordship’ over others is an inherently unstable and unsatisfying social formation, even for its supposed beneficiaries. Marxists, feminists and post-colonial theorists have all found inspiration in Hegel's analysis of the lord and bondsman by applying it to concrete relations of oppression, such as capitalism, patriarchy, or racism. In contrast, recent scholarship on Hegel's views on race and colonialism has cast doubt on whether his systematic political philosophy and philosophy of history can be of similar use to progressives. Hegel was undeniably a Eurocentric thinker, but philosophers like Robert Bernasconi and Alison Stone have convincingly shown that he was also a racist and a defender of colonialism. Crucially, however, few of the scholars who write on Hegel's pro-colonialism have analysed this feature of Hegel's thought in connection with the lord-bondsman dialectic. In this article, I argue for two connected theses. First, I argue that contrary to the hopes of some progressive defenders of Hegel, we cannot easily separate the lord-bondsman dialectic from Hegel's pro-colonialism. This is because Hegel himself appealed to the lord-bondsman dialectic to argue that colonial slavery educated its victims, and could therefore be temporarily justified. Second, I argue that this pro-colonial reading of the dialectic, though largely ignored by contemporary interpreters, was in fact recognized and embraced by a group of Hegelians in North America known as the St Louis Hegelians. They used the lord-bondsman dialectic as a basis for a qualified defence of pre-Civil War American slavery.},
  abstract_source = {s2},
}

@article{ng2024fanon,
  author = {Ng, Karen},
  title = {Fanon and {Hegel} on the Recognition of Humanity},
  journal = {Hegel Bulletin},
  year = {2024},
  volume = {45},
  number = {3},
  pages = {571--597},
  doi = {10.1017/hgl.2024.25},
  note = {
  CORE ARGUMENT: Defends an interpretation of Fanon's theory of recognition as
  revolving around a basic right to demand human behaviour from the other. Argues
  that Fanon develops key Hegelian ideas by employing a "concretely universal"
  concept of humanity (drawing on both Hegel's concrete universal and Sartre's
  existential humanism) as a normative orientation for what he calls a "world of
  reciprocal recognitions" -- equated with the creation of a "human reality."
  Analyzes three passages from the Phenomenology that Fanon cites in Black Skin,
  White Masks to reconstruct his theory of recognition.

  RELEVANCE: One of the most recent and philosophically rigorous treatments of
  the Fanon-Hegel relation. It is directly relevant to the question of whether
  Hegel's recognition framework can be reconstructed to address colonial
  dehumanization, or whether Fanon requires a break from Hegel.

  POSITION: Reconstructive appropriation of Hegel through Fanon: argues that
  Fanon develops a non-essentialist, concretely universal theory of recognition
  that builds on Hegelian foundations while addressing their colonial limitations.
  },
  keywords = {Fanon, Hegel, recognition, humanity, Ng, postcolonial, High},
  abstract = {
  abstract_source = {s2},
 This paper defends an interpretation of Fanon's theory of recognition as revolving around his claim that we have a basic right to demand human behaviour from the other. Developing key Hegelian ideas in a novel direction, I argue that Fanon's theory of recognition employs a concretely universal concept of humanity as a normative orientation for establishing what he calls a ‘world of reciprocal recognitions’, which he equates with the creation of a ‘human reality’. In the first section, I take up the three passages from Hegel's Phenomenology of Spirit cited by Fanon in Black Skin, White Masks to outline three key features of Fanon's theory of recognition. In section two, I argue that there are three senses of ‘universal humanity’ operative in Fanon's work: a false universal, an abstract universal, and a concrete universal. Whereas the first two are critical, pejorative uses, the third provides the normative orientation for his account of recognition and social struggle. In the third section, I show how Fanon combines features of Hegel's concrete universal with features of Sartre's existential humanism in order to avoid an essentialist or ahistorical approach to human nature. Specifically, I argue that the ideas of self-transcendence and a universal human condition shed light on what Fanon refers to as the right of reciprocal recognition to demand human behaviour from the other, and our one human duty to not renounce our freedom.},
}

@article{badenhorst2022fanon,
  author = {Badenhorst, Daniel},
  title = {Fanon, {Hegel}, and the Problem of Reciprocity},
  journal = {Hegel Bulletin},
  year = {2022},
  volume = {44},
  number = {2},
  pages = {321--344},
  doi = {10.1017/hgl.2022.1},
  note = {
  CORE ARGUMENT: Contests the "shared-humanity" interpretation of Fanon's
  critique of Hegel's master-servant dialectic -- the view that Fanon objects to
  Hegel assuming that master and slave recognize each other as human. Drawing on
  Van Haute and a close reading of Kojeve, Badenhorst argues that Fanon's actual
  problem is with reciprocal struggle, not reciprocal humanity: the "French Negro"
  did not experience the cost and value of freedom through struggle in the way that
  Hegel's bondsman does, and the Kojeve-Sartre-Beauvoir commitments in Black Skin,
  White Masks illuminate this more precisely than the "ontological" reading.

  RELEVANCE: This paper clarifies the exact philosophical mechanism of Fanon's
  deviation from the Hegelian dialectic, which has implications for how the
  research project characterizes the relationship between recognition theory and
  the colonial condition.

  POSITION: Re-reading of Fanon's critique as targeting Hegel-via-Kojeve: the
  problem is not shared humanity but the absence of reciprocal struggle that the
  colonial situation forecloses.
  },
  keywords = {Fanon, Hegel, Kojeve, recognition, reciprocity, Badenhorst, Medium},
  abstract = {Abstract In this article I put forward an interpretation of what is at stake in Frantz Fanon's claim that there is a reciprocity at the basis of G. W. F Hegel's master-servant dialectic. I do this by staging a critique of the ‘shared-humanity’ interpretation of Fanon's claim. Fanon's problem, as this interpretation understands it, is that the master-servant dialectic describes a situation in which two human beings knowingly confront one another as such. Such a situation—because human-to-human confrontation is assumed—does not adequately describe a racially divided situation because of racism's dehumanizing force. Fanon's problem would thus be that Hegel assumed shared humanity. I contest this reading by claiming that Fanon's issue is not reciprocal humanity but reciprocal struggle. To get to this point requires demonstrating that the shared-humanity reading is implausible on a variety of grounds. Thanks to the work of Philippe Van Haute it can already be said that in Hegel's text no shared humanity takes place. But Van Haute nevertheless claims that the shared-humanity problem is present in Kojève. Thus, it first needs to be shown that Kojève's text disallows such a reading. With this result in hand, I move to show the textually unsupportable nature of a subset of the shared-humanity reading—the ‘ontological reading’—whose strategy of reading Fanon's Black Skin, White Masks obscures the Sartrean-Beauvoirian commitments which would in fact allow a more accurate reading of Fanon's claims about reciprocity in Hegel to be made. I then seek to show—with reference to these commitments and a broadly Kojèvean emphasis on the centrality of struggle in human subject-formation—that Fanon's comments about reciprocity take aim at the question of mutual struggle in Hegel and Kojève. ‘The French Negro’, Fanon argues, did not get to experience the cost and value of freedom, unlike Hegel's servant.},
  abstract_source = {s2},
}

@article{brown2024fanon,
  author = {Brown, Grant},
  title = {{Fanon}'s Postcolonial Critique of {Hegelian} Recognition and {Buck-Morss}' {Haiti} Thesis},
  journal = {Rhizomes: Cultural Studies in Emerging Knowledge},
  year = {2024},
  number = {40},
  doi = {10.20415/rhiz/040.e03},
  note = {
  CORE ARGUMENT: Interrogates the relationship between Hegel's master-slave
  dialectic and Fanon's critique and reformulation of it in Black Skin, White
  Masks, using the Buck-Morss Haiti thesis as a contextualizing framework.
  Concludes that, while Buck-Morss provides a compelling historical grounding for
  the dialectic, her insights cannot fully vindicate Hegel from Fanon's rebukes:
  the Phenomenology still requires supplementation with a concrete analysis of the
  actual conscious experiences of racialized and colonized subjects.

  RELEVANCE: Represents a recent synthesis of the Buck-Morss and Fanon debates,
  arguing for their mutual illumination while maintaining that Buck-Morss's
  historicist rehabilitation does not dissolve Fanon's philosophical critique.

  POSITION: Synthetic position that holds the Buck-Morss and Fanon strands
  together while refusing to reduce one to the other.
  },
  keywords = {Fanon, Buck-Morss, Hegel, recognition, colonialism, Brown, Medium},
  abstract = {This philosophical investigation interrogates the relationship between G.F.W. Hegel’s concept of the master-slave dialectic in The Phenomenology of Spirit and the critique and reformulation of it by Frantz Fanon in Black Skin, White Masks. As a means of contextualization and expansion of Hegel’s original textual account, I consider Susan Buck-Morss’ seminal defense through grounding the dialectic in Hegel’s possible historical knowledge of the Haitian Revolution. I conclude that despite a compelling picture, Buck-Morss’ insights are unable to fully vindicate Hegel from the rebukes of Fanon, and as a result, Hegel’s phenomenology necessitates a concrete analysis of the actual conscious experiences of the racialized and colonized subject in order to realize its aims.},
  abstract_source = {s2},
}

@article{bowman2023hegel,
  author = {Bowman, Jonathan},
  title = {{Hegel}'s Master-Slave Dialectic and the {Haiti} Revolt (1791--1804): Transatlantic Print Chronicles of Race in an Age of Colonial Market Exchange},
  journal = {Philosophy \& Social Criticism},
  year = {2023},
  volume = {51},
  number = {8},
  pages = {1209--1237},
  doi = {10.1177/01914537231211042},
  note = {
  CORE ARGUMENT: Contributes to the transdisciplinary effort to view the Haitian
  slave revolt as the historical inspiration for Hegel's master-slave dialectic,
  arguing that asymmetrical racial classification schemes in transatlantic print
  culture (through figures like Gregoire and Du Bois, and archival records of
  French, British, and American parliamentary proceedings) show that European
  literate publics were well aware of the coercive forms of commodified labor in
  Saint-Domingue. Argues that recovering Haiti's proper world-historical warrant
  as inspiration for the dialectic need not lead us to overlook Hegel's own
  complicity with colonial racial ontologies.

  RELEVANCE: A historiographically detailed treatment of the archival evidence
  for the Buck-Morss thesis, situating it within the material history of
  transatlantic print culture and racial classification. Useful for the research
  project's treatment of how philosophical texts encode their historical
  conditions.

  POSITION: Empirically supported version of the Buck-Morss thesis that also
  acknowledges Hegel's continuing colonial complicity.
  },
  keywords = {Hegel, Haiti, race, transatlantic, print-culture, Bowman, Medium},
  abstract = {This work contributes to recent transdisciplinary efforts to view the Haitian slave revolt (1791–1804) as the historical inspiration for Hegel’s master-slave dialectic. Reconstructions offered by contemporary postcolonial scholars argue that the Haitian revolt was chronicled in Minerva as Hegel raced to finish his Phenomenology. Benhabib recently recognized the Hegel-Haiti thesis as entailing the sort of inclusive dialogical learning process necessary to validate subaltern experiences. The thesis has also drawn its share of sceptical scrutiny as Badiou claims that it risks forcing an unnecessary moral dissymmetry, neglects objectionable features of enslavement and imposes a mismatch between apolitical subject and revolutionary. In reply, we appeal to the pioneering work of Tavares to show that the asymmetrical construction of classification schemes for persons of mixed-racial statuses accords with decades of documented literary exchanges between Hegel and Gregoire. We then turn to the work of James on the role of mixed-race merchants in the testimonial accounts of late 18th century French historians to show that European literate publics were well aware of the extremely coercive forms of commodified labour found in Saint-Domingue. We then invoke the archival work of Du Bois on French, British and American parliamentary proceedings that show the provisional colonial identities ascribed to Caribbean subjects did not hinder their self-conscious exercise of political agency. Viewing Hegel in terms of the historiographic records of the racial ontologies of early modern transatlantic literary exchanges helps explain how he adapted these tropes concerning mixed-race subjects in a manner that better explains many of the anomalous features of the dialectic. However, conferring the Haitian revolution its proper world-historical warrant as inspiration for his infamous master-slave dialectic need not lead us to overlook Hegel’s complicity with many of the epistemic and ontological flaws of colonial tropes held in early modern transatlantic print.},
  abstract_source = {s2},
}

@article{monahan2006recognition,
  author = {Monahan, Michael J.},
  title = {Recognition Beyond Struggle: On a Liberatory Account of {Hegelian} Recognition},
  journal = {Social Theory and Practice},
  year = {2006},
  volume = {32},
  number = {3},
  pages = {389--414},
  doi = {10.5840/soctheorpract200632318},
  note = {
  CORE ARGUMENT: Argues for a "liberatory" reconstruction of Hegelian recognition
  that moves beyond the agonistic master-slave model. Monahan contends that the
  struggle-based account of recognition in the Phenomenology should not be taken
  as Hegel's final word, and that the more mature social theory of the Philosophy
  of Right contains resources for a non-agonistic account of mutual recognition
  that can ground anti-racist politics. Engages with Fanon and critical race
  theory as interlocutors.

  RELEVANCE: Represents the attempt to reconstruct Hegelian recognition theory
  for liberatory purposes in dialogue with the postcolonial critique. Its argument
  that "recognition beyond struggle" is available within Hegel's system stands in
  tension with Badenhorst's and Jaarte's more skeptical readings.

  POSITION: Reconstructive liberatory Hegelianism that argues for a non-agonistic
  account of mutual recognition as the core of Hegel's contribution to anti-racist
  politics.
  },
  keywords = {Hegel, recognition, liberation, Monahan, critical-race-theory, Medium, INCOMPLETE, no-abstract}
}

@article{heller2020hegel,
  author = {Heller, Henry},
  title = {Hegel, {Haiti} and Revolution: The Post-Colonial Moment},
  journal = {Third World Quarterly},
  year = {2020},
  volume = {41},
  number = {8},
  pages = {1442--1461},
  doi = {10.1080/01436597.2020.1763168},
  note = {
  CORE ARGUMENT: Argues that Buck-Morss's claim that the master-slave dialogue
  encodes the Haitian Revolution is contested by Marxists who see it as expressing
  European class conflict. While agreeing with Buck-Morss that the Haitian
  Revolution critically affirmed the principle of universal freedom and pushed the
  French Revolution in a radical direction, Heller argues that Hegel's Eurocentrism
  and racism prevent his text from adequately affirming this universality. The
  alternative to Buck-Morss is not a refined Hegelianism but a Marxist historical-
  materialist analysis of the revolution's global significance.

  RELEVANCE: Represents the Marxist critique of the postcolonial rehabilitation
  of Hegel, arguing that the Buck-Morss thesis imports unnecessary idealist
  baggage when Marxist analysis provides a better account of the Haitian
  Revolution's universal significance.

  POSITION: Marxist-materialist critique of the Buck-Morss thesis: accepts the
  Haitian Revolution's universal significance but rejects Hegel (and postcolonial
  theory) as the appropriate framework for understanding it.
  },
  keywords = {Hegel, Haiti, Marxism, Buck-Morss, Heller, historical-materialism, Medium},
  abstract = {Abstract Susan Buck-Morss’s argument that the Haitian Revolution embodied the most universal aspect of the French Revolution, namely the quest for universal freedom, relies on the supposed references to Haiti in the master–slave dialogue in Hegel’s Phenomenology of Spirit. The revolution’s lodgement at the core of this foundational text of Enlightenment universalism is, for her, about as convincing a demonstration as one can have of the universal significance of the Haitian Revolution. Marxists have opposed her venture, and demonstrated their hostility to post-colonial thinking, principally by claiming that the master–slave is an expression of European class conflict. This paper agrees with Buck-Morss that the Haitian Revolution critically affirmed the principle of universal freedom and, indeed, pushed the revolution in France and Europe in a radical direction. A better affirmation of the universal significance of the Haitian Revolution than the thoughts of Hegel is possible. The latter do not actually provide such affirmation, because racism, Eurocentrism and a hostility to political radicalism are fundamental aspects of Hegel’s thought. The alternative affirmation can be found in Marxist analysis. This paper outlines such an analysis, and concludes that post-colonialism of Buck-Morss’s sort is no substitute for the perspective provided by historical materialism.},
  abstract_source = {s2},
}

@article{basevich2022antiracist,
  author = {Basevich, Elvira},
  title = {What Is an Anti-Racist Philosophy of Race and History?},
  journal = {Critical Philosophy of Race},
  year = {2022},
  volume = {10},
  number = {1},
  pages = {71--89},
  doi = {10.5325/critphilrace.10.1.0071},
  note = {
  CORE ARGUMENT: Examines what an anti-racist philosophy of race and history would
  require, taking Kant, Hegel, and Du Bois as case studies. Argues that both Kant
  and Hegel developed philosophies of history structured by racial hierarchy, and
  that Du Bois's critical appropriation and transformation of Hegelian themes
  (especially the phenomenology of double consciousness) offers a model for
  constructing an anti-racist philosophy of history from the ruins of its racist
  precursors.

  RELEVANCE: Bridges the Hegel-race literature with Du Bois studies and critical
  philosophy of race. By including Kant and Hegel alongside Du Bois, it connects
  Domain 4's Hegel-slavery debates to the broader project on Kant and German
  Idealism and colonialism.

  POSITION: Reconstructive anti-racist appropriation: treats Kant and Hegel as
  providing negative examples that Du Bois's philosophy of history critically
  transforms into an anti-racist alternative.
  },
  keywords = {Hegel, Kant, Du-Bois, race, history, anti-racism, Basevich, Medium},
  abstract = {Abstract:In this article, I defend the pragmatic relevance of race in history. Kant and Hegel's racist development thesis assumes that nonwhite, non-European racial groups are defective practical agents. In response, philosophers have opted to drop race from a theory of history and progress. They posit that denying its pragmatic relevance amounts to anti-racist egalitarianism. I dub this tactic "colorblind cosmopolitanism" and offer grounds for its rejection. Following Du Bois, I ascribe, instead, a pragmatic role to race in history. Namely, Du Bois argues that race is an "instrument of progress" that advances emancipatory struggle. He appeals to the writing of history—or historiography—to cultivate group consciousness of historical memory in order to (1) strengthen intragroup bonds among the racially oppressed, especially black Americans, and (2) create intergroup bonds that reconstruct the republic on the basis of universal ideals. I detail Du Bois's defense of the black struggle for freedom in the wake of the U.S. Civil War to provide a concrete illustration of "spirit" in American history.},
  abstract_source = {s2},
}

@book{pinkard1994hegel,
  author = {Pinkard, Terry},
  title = {{Hegel}'s {Phenomenology}: The Sociality of Reason},
  publisher = {Cambridge University Press},
  year = {1994},
  doi = {10.1017/cbo9781316036433},
  note = {
  CORE ARGUMENT: Offers a systematic reading of the Phenomenology of Spirit that
  interprets the "sociality of reason" as the central claim of the work: for
  Hegel, self-consciousness is always already social, and the conditions for
  knowledge and action are constituted through social recognition rather than by
  an isolated Cartesian subject. The lordship-and-bondage section is read as
  illustrating the inadequacy of non-mutual recognition and the need for genuinely
  reciprocal social structures.

  RELEVANCE: Provides the canonical non-racialized reading of the master-slave
  dialectic against which postcolonial critics (Buck-Morss, Fanon, Bernasconi)
  position themselves. Useful for the literature review's presentation of what
  the Hegelian tradition took the section to be about before the intervention of
  postcolonial philosophy.

  POSITION: Mainstream Hegel scholarship: reads the master-slave dialectic as a
  philosophical argument about the social constitution of self-consciousness, with
  no reference to actual slavery.
  },
  keywords = {Hegel, Phenomenology, recognition, sociality, Pinkard, mainstream, Low},
  abstract = {The Phenomenology of Spirit is both one of Hegel's most widely read books and one of his most obscure. The book is the most detailed commentary on Hegel's work available. It develops an independent philosophical account of the general theory of knowledge, culture, and history presented in the Phenomenology. In a clear and straightforward style, Terry Pinkard reconstructs Hegel's theoretical philosophy and shows its connection to ethical and political theory. He sets the work in a historical context and shows the contemporary relevance of Hegel's thought for European and Anglo-American philosophers. The principal audience for the book is teachers and students of philosophy, but the great interest in Hegel's work and the clarity of Pinkard's exposition ensure that historians of ideas, political scientists, and literary theorists will also read it.},
  abstract_source = {openalex},
}

@book{pippin2010hegel,
  author = {Pippin, Robert B.},
  title = {Hegel on Self-Consciousness: Desire and Death in the {Phenomenology of Spirit}},
  publisher = {Princeton University Press},
  year = {2010},
  doi = {10.1515/9781400836949},
  note = {
  CORE ARGUMENT: Argues that the master-slave section of the Phenomenology is not
  primarily about social conflict or political struggle but about the structure of
  desire, the role of the life-and-death struggle in establishing self-consciousness,
  and the conditions under which genuine self-knowledge becomes possible. Pippin
  offers a "neo-Kantian" reading of Hegel that emphasizes the epistemological
  dimensions of the section over its social-political implications.

  RELEVANCE: Represents the mainstream analytic Hegel scholarship that reads the
  lordship-and-bondage section in purely philosophical terms, bracketing its
  historical connection to actual slavery. Understanding this reading is essential
  for the research project's assessment of why the Buck-Morss and Fanon
  interventions appeared as disruptions to a settled scholarly consensus.

  POSITION: Neo-Kantian analytic reading that treats the master-slave dialectic
  as primarily epistemological and structural, not historical-political.
  },
  keywords = {Hegel, Phenomenology, desire, self-consciousness, Pippin, analytic, Low},
  abstract = {In the most influential chapter of his most important philosophical work, the Phenomenology of Spirit , Hegel makes the central and disarming assertions that "self-consciousness is desire itself" and that it attains its "satisfaction" only in another self-consciousness. Hegel on Self-Consciousness presents a groundbreaking new interpretation of these revolutionary claims, tracing their roots to Kant's philosophy and demonstrating their continued relevance for contemporary thought. As Robert Pippin shows, Hegel argues that we must understand Kant's account of the self-conscious nature of consciousness as a claim in practical philosophy, and that therefore we need radically different views of human sentience, the conditions of our knowledge of the world, and the social nature of subjectivity and normativity. Pippin explains why this chapter of Hegel's Phenomenology should be seen as the basis of much later continental philosophy and the Marxist, neo-Marxist, and critical-theory traditions. He also contrasts his own interpretation of Hegel's assertions with influential interpretations of the chapter put forward by philosophers John McDowell and Robert Brandom.},
  abstract_source = {openalex},
}

@book{noyes2015herder,
  author = {Noyes, John K.},
  title = {Herder: Aesthetics against Imperialism},
  year = {2015},
  publisher = {University of Toronto Press},
  address = {Toronto},
  doi = {10.3138/9781442622975},
  note = {
  CORE ARGUMENT: Noyes argues that Herder's anti-rationalist epistemology -- his rejection of universal conceptions of truth, knowledge, and justice -- constitutes the first sustained attempt to establish an epistemological (not merely moral) foundation for anti-imperialism. By refusing to grant any culture, including Enlightenment Europe, a monopoly on truth, Herder undermined the very epistemological claims that justified colonial domination.

  RELEVANCE: Directly bears on the question of whether Herder represents a genuine counter-current to the colonial implications of Enlightenment universalism. Noyes extends the argument beyond Muthu by focusing on the aesthetic and epistemological dimensions of Herder's anti-imperialism, connecting it to postcolonial theory (Chakrabarty, Spivak). Central for the section on Herder in this research project.

  POSITION: Strong anti-imperialist reading of Herder's aesthetics; connects Herder to postcolonial theory.
  },
  keywords = {Herder, aesthetics, anti-imperialism, postcolonial, epistemology, High},
  abstract = {Among his generation of intellectuals, the eighteenth-century German philosopher Johann Gottfried Herder is recognized both for his innovative philosophy of language and history and for his passionate criticism of racism, colonialism, and imperialism. A student of Immanuel Kant, Herder challenged the idea that anyone – even the philosophers of the Enlightenment – could have a monopoly on truth.In Herder: Aesthetics against Imperialism, John K. Noyes plumbs the connections between Herder’s anti-imperialism, often acknowledged but rarely explored in depth, and his epistemological investigations. Noyes argues that Herder’s anti-rationalist epistemology, his rejection of universal conceptions of truth, knowledge, and justice, constitutes the first attempt to establish not just a moral but an epistemological foundation for anti-imperialism. Engaging with the work of postcolonial theorists such Dipesh Chakrabarty and Gayatri Spivak, this book is a valuable reassessment of Enlightenment anti-imperialism that demonstrates Herder’s continuing relevance to postcolonial studies today},
  abstract_source = {openalex},
}

@book{sikka2011herder,
  author = {Sikka, Sonia},
  title = {Herder on Humanity and Cultural Difference: Enlightened Relativism},
  year = {2011},
  publisher = {Cambridge University Press},
  address = {Cambridge},
  doi = {10.1017/cbo9780511783012},
  note = {
  CORE ARGUMENT: Sikka argues that Herder is best understood as a "qualified relativist" who combined a commitment to a common human nature with recognition of culture's role in shaping and differentiating that nature. Against simple relativist or universalist readings, Sikka shows that Herder's position is internally complex: he rejects racial hierarchy and Eurocentric teleology, but retains normative criteria for transcultural judgment that complicate pure cultural relativism.

  RELEVANCE: Essential for the research project because it resists both hagiographic anti-colonial readings of Herder (Muthu, Noyes) and dismissive ones. Sikka situates Herder's views on race within his anthropology, metaphysics, and ethics, showing that his qualified relativism opens space for anti-colonial critique without fully escaping Enlightenment universalism's ambiguities.

  POSITION: Nuanced, internally qualified reading of Herder's relativism; neither pure anti-imperialist nor complicit with colonialism.
  },
  keywords = {Herder, relativism, human-nature, cultural-difference, anthropology, High},
  abstract = {Herder is often criticized for having embraced cultural relativism, but there has been little philosophical discussion of what he actually wrote about the nature of the human species and its differentiation through culture. This book focuses on Herder's idea of culture, seeking to situate his social and political theses within the context of his anthropology, metaphysics, epistemology, ethics, theory of language and philosophy of history. It argues for a view of Herder as a qualified relativist, who combined the conception of a common human nature with a belief in the importance of culture in developing and shaping that nature. Especially highlighted are Herder's understanding of the relativity of virtue and happiness, and his belief in the impossibility of constructing a single best society. The book will appeal to a wide range of readers interested both in Herder and in Enlightenment culture more generally.},
  abstract_source = {openalex},
}

@book{barnard2003herder,
  author = {Barnard, F. M.},
  title = {Herder on Nationality, Humanity, and History},
  year = {2003},
  publisher = {McGill-Queen's University Press},
  address = {Montreal},
  doi = {10.1515/9780773570917},
  note = {
  CORE ARGUMENT: Barnard demonstrates that Herder, despite his foundational role in theorizing nationality and cultural particularity, was explicitly aware of the dangers of ethnic fanaticism and opposed what we now call globalization. The core of Herder's nationalism lies in embedding human creativity in communal language while insisting on each culture's incommensurable distinctiveness within a broader humanity.

  RELEVANCE: Provides the canonical scholarly account of Herder's nationalism and its relationship to universalism, showing that Herder's nationalism was not protofascist but rather grounded in cultural pluralism. The book helps situate the question of whether Herder's emphasis on Volk and language anticipates the nationalist exclusions of Fichte's Addresses, or represents a fundamentally different logic.

  POSITION: Liberal-pluralist reading of Herder; distinguishes his nationalism from later ethnic nationalism.
  },
  keywords = {Herder, nationalism, humanity, cultural-pluralism, history, Medium},
  abstract = {The core of J.G. Herder's philosophy of nationalism lies in the conviction that human creativity must be embedded in the particular culture of a communal language. While he acknowledged that this cultural particular must be integrated into a more universal humanity, he insisted that each culture should preserve its incommensurable distinctiveness. He also called for a new method of enquiry regarding history, one that demands empathetic sensitivity toward the uniquely individual while realizing that there are few gains without losses.},
  abstract_source = {openalex},
}

@book{piirimae2023herder,
  author = {Piirim{\"a}e, Eva},
  title = {Herder and Enlightenment Politics},
  year = {2023},
  publisher = {Cambridge University Press},
  address = {Cambridge},
  note = {
  CORE ARGUMENT: Piirimae reconstructs Herder's engagement with Rousseau, Montesquieu, Kant, and other contemporaries to show that Herder was deeply interested in the reform of modern European societies. She argues that Herder developed a distinctive understanding of human self-determination, natural sociability, and modern patriotism, and envisioned Europe as a commercially and culturally interconnected community of peoples rather than an imperial system.

  RELEVANCE: The most recent comprehensive study of Herder's political thought, providing essential context for evaluating Herder's anti-colonialism within his broader social and political vision. Piirimae's reconstruction of Herder's dialogue with Kant is directly relevant to the research project's concern with the Kant-Herder controversy. Published 2023.

  POSITION: Contextual-historical reading that situates Herder's anti-colonialism within his positive political program.
  },
  keywords = {Herder, Enlightenment, political-thought, anti-colonialism, Kant, High, INCOMPLETE, no-abstract}
}

@article{niekerk2025herder,
  author = {Niekerk, Carl},
  title = {Herder's Concept of Culture},
  journal = {Monatshefte},
  year = {2025},
  volume = {117},
  number = {1},
  pages = {88--108},
  doi = {10.3368/m.117.1.88},
  note = {
  CORE ARGUMENT: Niekerk traces the chronological development of Herder's concept of "culture," its Latin origins, links to theories of climate and geography, and its critical function in attacking Eurocentrism and colonialism. He asks how successful Herder is in avoiding the very cultural hierarchies he intends to criticize, arguing that the normative dimensions of the concept partially undercut his own anti-colonial intentions.

  RELEVANCE: This 2025 article provides the most recent critical assessment of whether Herder's anti-Eurocentrism is philosophically consistent or internally contradicted. The question of whether Herder's culture concept escapes hierarchical thinking is directly relevant to the project's central question about how German Enlightenment thinkers are implicated with colonialism even when they explicitly criticize it.

  POSITION: Critical reading that identifies internal tensions in Herder's anti-colonial project.
  },
  keywords = {Herder, culture, Eurocentrism, colonialism, anthropology, Medium},
  abstract = {This article presents a critical examination of the concept of “culture” in the writings of Johann Gottfried Herder. Herder’s use of the term “culture” participates in a broader pan-European rethinking of the term as part of the emerging discipline of anthropology. In a first step, the paper offers a chronological reconstruction of Herder’s use of the concept, its Latin origins, and its links to theories of climate and geography. As a second step, the essay examines the critical intentions underlying Herder’s theory of “culture,” in particular as part of a conceptual framework in his critiques of Eurocentrism and colonialism. Especially the normative dimensions of the concept are analyzed, and the question is asked how successful Herder is in avoiding the hierarchies he intends to criticize. Finally, the paper discusses the relevance of Herder’s theory of “culture” in the context of various anthropological approaches since the 1970s that have attempted to use “culture” as a critical tool in the analysis of contemporary globalization.},
  abstract_source = {s2},
}

@article{gray2012kant,
  author = {Gray, Sally Hatch},
  title = {Kant's Race Theory, {Forster}'s Counter, and the Metaphysics of Color},
  journal = {The Eighteenth Century},
  year = {2012},
  volume = {53},
  number = {4},
  pages = {393--412},
  doi = {10.1353/ecy.2012.0032},
  note = {
  CORE ARGUMENT: Gray analyzes the 1786-1788 controversy between Kant and Georg Forster over the metaphysical status of skin color as a racial characteristic. Kant treats color as a fixed hereditary marker of distinct races grounded in pre-formed germs; Forster's polygenist counter holds that skin color's meaning depends on local environments and cannot be extracted from lived cultural contexts. Gray argues the dispute turns on incompatible metaphysics of color.

  RELEVANCE: The Forster-Kant controversy is a crucial case study for the project because it shows how race theory in the Enlightenment was actively contested, and how Kant's racial taxonomy was philosophically vulnerable even by eighteenth-century standards. The metaphysical dimension Gray highlights shows that the debate was not merely empirical but tied to deep commitments about natural teleology.

  POSITION: Reconstructs the Forster-Kant dispute as a metaphysical controversy over the nature of racial characteristics.
  },
  keywords = {Forster, Kant, race-theory, skin-color, metaphysics, eighteenth-century, High},
  abstract = {This article argues for an understanding of Kant's race theory as an integral part of his idea of nature and of humans in nature as presented in his Critique of the Power of Judgment (Kritik der Urteilskraft, 1790). It places an examination of Kant and Forster's debate over race, which was ignited in 1785 upon the publication of Kant's second essay on race, "Definition of a Concept of a Human Race" ("Bestimmung des Begriffs einer Menschenrace"), in the context of an illumination of the connections between aesthetics and anthropology in Kant's Observations on the Feeling of the Beautiful and Sublime (Beobachtungen über das Gefühl des Schönen und Erhabenen, 1764) and Forster's Voyage round the World (Reise um die Welt 1777). Forster responded to Kant's new "race" classifications, which were based essentially on skin color, with "Still More about the Human Races" ("Noch etwas über Menschenraßen," 1786). This article shows that Kant then developed his scientific theory and his idea of a teleological nature as presented in his Critique of the Power of Judgment, at least in part, in order to provide a unifying theoretical basis for his race theory so that it could withstand the scrutiny of an empirical scientific method based on deductive logic, such as that advanced by Forster. While Forster's strict empiricism, perspectivism, and rejection of "race" as a scientific classification reflect an underlying, distinctly modern, concept of the natural world, Kant's nature, as presented in his third Critique, reveals a metaphysically-based structure supporting a universal cosmopolitanism, but veils a particular European perspective that allows a damaging global authority on difference.},
  abstract_source = {openalex},
}

@article{mensch2025kant,
  author = {Mensch, Jennifer},
  title = {Kant and {Forster} on the Unity of Mankind},
  journal = {Annals of Science},
  year = {2025},
  pages = {1--23},
  doi = {10.1080/00033790.2025.2584331},
  note = {
  CORE ARGUMENT: Mensch widens the frame of the Forster-Kant race controversy by bringing Kant's Physical Geography lectures into conversation with Forster's travel writings from Cook's second voyage. She shows that the two thinkers share more common ground as ethnographers than usually recognized, while their genuine divergences on monogenesis and racial hierarchy reflect deeper commitments to empiricism (Forster) versus rational teleology (Kant).

  RELEVANCE: The most recent scholarly treatment (2025) of the Forster-Kant controversy, which is central to Domain 5's focus. Mensch's inclusion of Forster's other 1780s writings broadens the picture beyond the formal academic debate, showing Forster as a naturalist-traveler whose anti-hierarchical anthropology emerges from direct encounter with Pacific peoples.

  POSITION: Comparative-contextualist reading that enriches the Forster-Kant debate with new archival and contextual material.
  },
  keywords = {Forster, Kant, race, unity-of-mankind, anthropology, natural-history, High},
  abstract = {In 1786 Georg Forster published a widely read critique of Immanuel Kant's theory of race. Since then, the dispute between Forster and Kant on the unity of mankind has been widely discussed in light of both Forster's essay and Kant's decision to write a lengthy response to Forster in 1788. In this discussion I widen the frame for considering the two positions by focusing on Kant's lectures on Physical Geography. In these notes Kant emerges as an ethnographer asking many of the same questions posed by Forster himself, a man who had become famous since his time spent onboard James Cook's second voyage to the South Pacific (1772-1775). Placing Kant's ethnography in closer conversation with Forster reveals the many similarities (and some well-known differences) between the two. By including some of Forster's other writings from the 1780s in an assessment of their debate, moreover, a much fuller picture can be had regarding natural historical investigations into the unity and difference of mankind at the time.},
  abstract_source = {s2},
}

@article{vangorkom2022stoll,
  author = {Van Gorkom, Joris},
  title = {Johann Gottlieb {Stoll} and {Forster}'s Challenge to {Kant}},
  journal = {Critical Philosophy of Race},
  year = {2022},
  volume = {10},
  number = {2},
  pages = {295--311},
  doi = {10.5325/critphilrace.10.2.0295},
  note = {
  CORE ARGUMENT: Van Gorkom recovers the largely forgotten figure of Johann Gottlieb Stoll, who in response to Forster's 1786 challenge to Kant went further than both by explicitly condemning slavery and the slave trade on grounds of human dignity, and by arguing that racial mixing proves the unity of the species and is not contrary to nature. Stoll presented an even more radical challenge to Kant than Forster did.

  RELEVANCE: Illuminates how the Forster-Kant controversy generated further anti-racist positions in the Enlightenment context. Stoll's defense of racial mixing and condemnation of slavery shows that abolitionist positions were available within the German Enlightenment conversation about race, making Kant's silence on these matters more culpable rather than simply uninformed.

  POSITION: Critical philosophy of race perspective; uses the Forster-Kant controversy to expand the cast of anti-racist voices in the German Enlightenment.
  },
  keywords = {Forster, Kant, Stoll, race, slavery, monogenesis, eighteenth-century, Medium},
  abstract = {Abstract:When in 1786 Georg Forster criticized Immanuel Kant’s racial theory, he famously challenged him to oppose slavery. Although Kant declined to take up this challenge, the discussion between Forster and Kant was the impetus for Johann Gottlieb Stoll to present his views on the matter. In his defense of monogenesis Stoll did what Kant had failed to do, namely, explicitly criticize oppressive institutions like the slave trade and slavery with a demand to respect the dignity and humanity of every human being, independent of their physiological traits. Although his work has been ignored ever since its publication, he offered an even greater challenge to Kant than Forster. He defended the idea that so-called race mixing not only proved the unity of the human species but was also not contrary to nature. Not only did he distance himself from Kant but also from Forster. He challenged his readers to consider the ability of non-Whites to be an example for Whites.},
  abstract_source = {s2},
}

@article{vangorkom2024metzger,
  author = {Van Gorkom, Joris},
  title = {Johann Daniel {Metzger} and {Kant}'s So-Called Human Races},
  journal = {Journal for Eighteenth-Century Studies},
  year = {2024},
  doi = {10.1111/1754-0208.12946},
  note = {
  CORE ARGUMENT: Van Gorkom recovers the contributions of Johann Daniel Metzger to the 1780s race debate -- contributions listed by Blumenbach but completely ignored by subsequent scholarship. Metzger offered an early critical engagement with Kant's concept of race that broadens our understanding of eighteenth-century debates beyond the dominant Herder-Forster-Kant triangle.

  RELEVANCE: Expands the Kant-Herder-Forster race controversy to include Metzger, showing that the debate was richer and more contested than usually presented. Relevant to the project's concern with how widely contested Kant's race theory was among his contemporaries, and how many alternative positions existed within the German Enlightenment.

  POSITION: Historical recovery of under-studied participants in the Kant race debate.
  },
  keywords = {Metzger, Kant, race, Blumenbach, eighteenth-century, natural-history, Medium},
  abstract = {Around 1788, Johann Friedrich Blumenbach compiled a list of notable contributions to the discussion on Kant's concept of race. This list included references to Kant's second and third essays on race, Georg Forster's 1786 response, and two essays by Johann Daniel Metzger. Blumenbach's compilation stands in stark contrast to contemporary discussions of Kant's racial theories. Despite the increasing interest in this subject, Metzger's critiques are still largely unnoticed. To gain a more comprehensive understanding of eighteenth‐century discussions on race, it is crucial to broaden our perspective beyond the viewpoints of Johann Gottfried Herder and Forster and include Metzger's contributions. In this article, I aim to elucidate (the context surrounding) Metzger's endeavours to engage with Kant's concept of race.},
  abstract_source = {s2},
}

@article{abizadeh2005fichte,
  author = {Abizadeh, Arash},
  title = {Was {Fichte} an Ethnic Nationalist? On Cultural Nationalism and Its Double},
  journal = {History of Political Thought},
  year = {2005},
  volume = {26},
  number = {2},
  pages = {334--359},
  note = {
  CORE ARGUMENT: Abizadeh argues that while the dominant French interpretation reads Fichte's Addresses to the German Nation as a non-ethnic cultural nationalism, this misses the text's "crypto-ethnic" character. Fichte's nationalism, though not based on biological race, smuggles in ethno-cultural exclusion through the criterion of "original" versus "dead" languages, effectively naturalizing national community through language while excluding non-German-speakers.

  RELEVANCE: Directly addresses the question of whether Fichte's nationalism entails exclusion and, implicitly, racially inflected hierarchy. The "crypto-ethnic" concept is crucial for situating Fichte within the project's concern about how German Idealism normalized national and racial exclusions without always making them explicit. The article is the standard critical reference on Fichte's nationalism.

  POSITION: Critical reading that identifies ethnic-nationalist implications in Fichte's ostensibly cultural nationalism.
  },
  keywords = {Fichte, nationalism, ethnicity, language, exclusion, High, INCOMPLETE, no-abstract}
}

@article{dwivedi2022hypophysics,
  author = {Dwivedi, Divya},
  title = {The Hypophysics of Philosophical Nationalism},
  journal = {Eco-ethica},
  year = {2022},
  volume = {10},
  pages = {43--60},
  doi = {10.5840/ecoethica202342652},
  note = {
  CORE ARGUMENT: Dwivedi argues that Fichte's nationalism in the Addresses constitutes a specific form of racism she calls "hypophysics" -- a consecration of nature as value in which language, community, and race flow from a single "spiritual-natural law." This hypophysical logic is distinct from conventional naturalism or biologism, and from Heidegger's onto-theo-logic, yet it underwrites racial exclusion through the spiritual-natural unity of an "original" Volk.

  RELEVANCE: Offers the sharpest critical diagnosis of how Fichte's nationalism generates racial thinking without explicit racial biology. The concept of "hypophysics" is a productive analytical tool for the project's engagement with how German Idealism normalized exclusion. The article also poses the question of whether philosophy as such can exist without hypophysics and its attendant racisms.

  POSITION: Radical critique identifying a structural racism in Fichte's philosophical nationalism.
  },
  keywords = {Fichte, nationalism, race, language, hypophysics, philosophy, Medium},
  abstract = {Is there a philosophical nationalism? Reading Fichte’s Addresses to the German Nation and its use by the Nazis, Derrida concluded that all nationalisms are philosophical and onto-theological as they are posited beyond race, biology, and nature. However, Fichte’s text reveals a specific form of racism that insists on biology and nature. Fichte’s racism is a species of “hypophysics,” a consecration of nature as value. His theory of language is simultaneously biological and spiritual, these two aspects flowing from a single geistige Naturgesetz (spiritual-natural-law) and determining the hypophysical unity of language, community and “philosophy” (as he defined it). The logic of such a hypophysics is misrecognized and left unaddressed in the conventional categories of “naturalism” and “biologism.” Further, hypophysical-logic is not onto-theo-logic (in Heidegger’s definition). This imposes new questions for the history and future of philosophy: how does hypophysics enter philosophy; can there be philosophy without hypophysics and its attendant racisms?},
  abstract_source = {s2},
}

@incollection{bernasconi2020invented,
  author = {Bernasconi, Robert},
  title = {Who Invented the Concept of Race?},
  booktitle = {Theories of Race and Racism},
  year = {2020},
  pages = {83--103},
  publisher = {Routledge},
  doi = {10.4324/9781003060802-7},
  note = {
  CORE ARGUMENT: Bernasconi argues that Kant invented the modern concept of race as a technical biological-philosophical category in his 1775 and 1785 essays, establishing race as a hereditary, fixed characteristic serving the teleological purposes of natural history. Against Herder, who treated human diversity as cultural and environmental rather than racial, Kant insisted on a strict racial classification that made biological race a permanent, inherited characteristic for the first time.

  RELEVANCE: The claim that Kant invented race directly implicates Herder as Kant's main opponent on this question -- Herder's rejection of fixed racial categories becomes part of the evidence that Kant's race concept was a philosophical innovation rather than a neutral description of nature. This chapter is foundational for the project because it sets the terms for understanding what was at stake in the Kant-Herder controversy.

  POSITION: Critical philosophy of race; attributes the invention of modern race concept to Kant rather than to any biological naturalist.
  },
  keywords = {Bernasconi, Kant, Herder, race, invention, natural-history, High},
  abstract = {WHO Invented the Concept of Race? This question admits of a variety of answers depending on what one takes to be decisive about the concept and on whether one believes that what defines the moment in which a technical term is introduced is the first usage of the word in the required sense or the definition that secures its status and influence. The terms and basis of the definition might continue to be scrutinized, but, so long as the term was being used only loosely, it made no sense to contest the concept. The invention of the concept of race in this sense took place some time after the introduction of the broad division of peoples on the basis of color, nationality, and other inherited characteristics that could not be overcome subsequently, as religious differences could be overcome by conversion. A word should also be said about Blumenbach’s claim to being the originator of the anthropological concept of race.},
  abstract_source = {openalex},
}

@article{leontiev2023schiller,
  author = {Leontiev, Kim},
  title = {Schiller on Aesthetic Education as Radical Ethical-Political Remedy},
  journal = {British Journal of Aesthetics},
  year = {2023},
  doi = {10.1093/aesthj/ayad003},
  note = {
  CORE ARGUMENT: Leontiev examines Schiller's Letters on the Aesthetic Education of Man as a response to the perceived failures of Kantian ethics and Enlightenment republicanism. Schiller diagnoses "savage" and "barbarian" states of the human as failures of aesthetic balance -- the savage dominated by sense, the barbarian by abstract reason -- and proposes aesthetic experience as the remedy for political fragmentation. The political dimension of this aesthetic anthropology receives systematic analysis.

  RELEVANCE: For the project, the article is relevant because Schiller's "savage/barbarian" typology maps onto contemporary colonial categories and implicitly hierarchizes non-European peoples (especially Pacific Islanders and indigenous Americans) as aesthetically deficient. Leontiev's focus on the political remedy dimension helps connect Schiller's aesthetic anthropology to questions of colonial paternalism and civilizational hierarchy.

  POSITION: Sympathetic but analytically rigorous treatment of Schiller's aesthetico-political project, relevant to its colonial implications.
  },
  keywords = {Schiller, aesthetic-education, savage, barbarian, politics, Kant, Medium},
  abstract = {
  abstract_source = {s2},
 This paper examines the iconic conception of aesthetic education in the work of Friedrich Schiller, with the aim of elucidating Schiller’s unique innovation of this notion in understanding i) the relationship between aesthetic and ethical value and ii) the transformative possibilities within a collective, social dimension of aesthetic experience. The paper provides an overview of the Kantian origins of Schiller’s aesthetic programme (Section 1). It then considers Schiller’s critique of the perceived failings of the Kantian and Enlightenment republican models of ethical value and political emancipation (Section 2) before turning to his positive alternative aesthetic programme (Section 3). The paper concludes (Section 4) with some evaluation and reflection on Schiller’s original contributions.},
}

@article{kyslan2024kant,
  author = {Kyslan, Peter},
  title = {Kant, {Herder} and Anthropology},
  journal = {Folia Philosophica},
  year = {2024},
  doi = {10.31261/fp.18341},
  note = {
  CORE ARGUMENT: Kyslan systematically compares Kant's transcendentalist universalism with Herder's cultural relativism in their contributions to anthropology. He shows that Kant's "universal perspective" on culture enabled anthropological concepts but was compromised by his race theory and gender views; Herder's cultural relativism, by contrast, established the dignity of different cultures but raised problems for cross-cultural normative judgment.

  RELEVANCE: Provides a balanced comparative account of the Kant-Herder anthropological controversy suitable as an orientation for the project. The article's focus on the evolution of Kant's race views and Herder's opposition to Enlightenment universalism maps directly onto the domain's key questions. Recent (2024) and philosophically precise.

  POSITION: Comparative-systematic treatment; neither simply pro-Kant nor pro-Herder.
  },
  keywords = {Kant, Herder, anthropology, race, cultural-relativism, universalism, Medium},
  abstract = {This study explores the philosophical contributions of Immanuel Kant and Johann Gottfried Herder to the field of cultural anthropology. It examines Kant’s idealism and transcendentalism, which provided a universal perspective on culture and influenced various anthropological concepts. The research addresses the criticisms of Kant’s views on race and gender, highlighting the evolution of his thoughts in response to emerging scientific disciplines. Additionally, the study delves into Herder’s role in shaping modern cultural studies, emphasizing his opposition to Enlightenment universalism and his introduction of cultural relativism. Herder’s ideas on the uniqueness and dignity of different cultures are analyzed, illustrating their impact on the development of cultural anthropology. The paper concludes with the discussion of the ongoing relevance of Kant’s and Herder’s philosophies in contemporary anthropological discourse.},
  abstract_source = {s2},
}

@book{eze1997race,
  author = {Eze, Emmanuel Chukwudi},
  title = {Race and the Enlightenment: A Reader},
  year = {1997},
  publisher = {Blackwell},
  note = {
  CORE ARGUMENT: This anthology collects primary Enlightenment texts on race
  by Kant, Hume, Hegel, and others, juxtaposed with analyses demonstrating
  that race was not a marginal concern but central to Enlightenment
  anthropology and its construction of human hierarchy. Eze's editorial
  framing establishes that Enlightenment claims to universal reason were
  accompanied by systematic racialized exclusions of non-European peoples
  from full rational subjecthood.

  RELEVANCE: The anthology established the foundational argument for the
  Kant-colonialism debate: Kant's racial writings are not a biographical
  embarrassment but integral to his empirical and anthropological project.
  This positions Eze as the starting point for subsequent debates about
  whether Kant's racism is separable from or entangled with his critical
  philosophy. It is the primary source collection that defines the domain.

  POSITION: Enlightenment universal reason is structurally racialized;
  critique must proceed from within the texts, not from their margins.
  },
  keywords = {Kant-race, Enlightenment-critique, Africana-philosophy, High},
  abstract = {This is a very important contribution for those who cannot read German and who wish to gain a purchase on the role of Kant in the highly contested domain of race theory and the less politicized but also contested domain of philosophy of biology. Not only does it provide key texts from Kant on the question of race, but it also supplements these with texts, previously not available in English, from four important German contemporaries of Kant. Jon Mikkelsen presents these texts in chronological order: Kant's first essay on race, in its two distinct versions of 1775 and 1777 (an unprecedented and very welcome contribution for those who are interested in close historical reading of Kant's development on these questions); E. A. W. Zimmermann's criticisms of Kant in the context of his own biogeographical study of the human population,Geographical History of Human Beings and the Universally Dispersed Quadrupeds(1778); Kant's "Determination of the Concept of a Human Race" (1785); Georg Forster's critical commentary on that essay, "Something More about the Human Races" (1786); Kant's rejoinder, "On the Use of Teleological Principles in Philosophy" (1788), of fundamental importance for the development of his thirdCritique; Christoph Meiners' "Of the Varieties and Deviate Forms of Negroes" (1790), an exemplary text from perhaps the most racist theorist of late eighteenth-century Germany; and, finally, an excerpt from Christoph Girtanner'sConcerning the Kantian Principle in Natural History(1796), the most thorough endeavor to apply Kant's approach to the emergent field of life science, associated with the work of Johann Friedrich Blumenbach in Göttingen. Mikkelsen's volume is supplemented with an extensive Chronology of developments in race theory, the slave trade, and the life sciences from 1619 to 1859.
  abstract_source = {ndpr},

The critical issue concerning this volume is its relation to the increasingly standard English translations of Kant's texts, theCambridge Edition of the Works of Immanuel Kant, in this case, the volumeAnthropology, History, and Education, edited by Günter Zöller and Robert Louden (Cambridge University Press, 2007). Both editions contain careful translations of Kant's texts on race. Each set of translations has its strengths and weaknesses. For general readability, perhaps the Cambridge Edition is superior, but Mikkelsen tends to retain more of the eighteenth-century flavor of Kant's language, as attested by the works from contemporaries. Each translation indulges in some terminological anachronism. The Cambridge Edition chooses to usephylumfor the GermanStamm. That sounds too much like a present taxonomical category for Kant's deliberately ordinary (eighteenth-century) language. But Mikkelsen translates asplateswhat the Cambridge Edition more sensibly renders asplateaus. Plates, once again, evokes too contemporary a geological framework. But the case for Mikkelsen's volume does not lie in translation quality but in conceptual orientation.

Both volumes reflect the very late attentiveness of Anglophone scholarship to Kant's texts on race and their relation to his overall corpus and concerns. More, this belatedness looms especially problematic in light of the explosive implications of these texts and others, now appearing in the Cambridge Edition, from Kant's lectures on physical geography and anthropology for the question of Kant'sracism. While the Cambridge Edition's general introduction acknowledges this context in about five pages and with one footnote reference to a proliferating secondary literature, a brevity perhaps justified by the much wider collection of texts comprising that volume, there is a much more extensive discussion of this heated present-day theoretical debate in the volume by Mikkelsen. His "Translator's Introduction" is a very careful essay in the historiography of recent work on Kant and race, recognizing the triggering intervention of Emmanuel Eze and then Tsenay Serequeberhan in the early 1990s, both reflecting a sharp post-colonialist critique of Eurocentrism. Mikkelsen then recounts the ensuing inquiry into these questions by Kant specialists, notably Mark Larrimore, Robert Bernasconi, Robert Louden, and Pauline Kleingeld, but with an exhaustive bibliography attached. His appraisals are thoughtful and persuasive, and they indicate that the question has not been definitively resolved. This will be decisive for the wider reception of his volume in communities of scholarship interested in contemporary issues of race, colonialism and cosmopolitanism and how Kant's work can be received in these domains.

There is a second theoretical context into which Mikkelsen situates his selected texts, namely the history of the life sciences in the eighteenth century. Kant's relation to this history is a matter that has only recently come under serious reconsideration, after a century of work that has privileged his concern with Newtonian physics. Mikkelsen gives a good account of the state of this emergent historiography, especially in relation to Kant, and he recognizes that that research is still in its very early stages. Since this is the field of my own research interest, I am very pleased to see Mikkelsen's attentiveness to this question and his suggestions for further inquiry. But it will also be here that I will raise some specialist's quibbles.

It is altogether salutary that Mikkelsen included texts from Kant's contemporaries and situated the whole volume in the context of the emergent discourse in life sciences of the eighteenth century. Nevertheless, by virtue of his selection, organization, and explicit interpretative interventions, Mikkelsen has not altogether inadvertently given his volume a spin that suggests that the whole discourse arosein response to Kant. This Kant-centered conception, while certainly understandable in a volume entitledKant and the Concept of Race, makes Kant appear to be the driving force in this field, whereas, in my view, he needs to be situated in a much wider course of developments that his specific interventions, to be sure, inflected but did not fundamentally direct. Thus, Mikkelsen might well have emphasized in his introduction, and even in his selection of texts, the more decisive figures in this emergent science. Buffon is of course central, and while Mikkelsen notes this, he does not raise in sufficient detail exactly what Kant took up from Buffon, why and when. The details of that reception, however, seem crucial to an appraisal of Kant's whole relation to the emergent life sciences. Similarly, path-breaking work by Caspar Friedrich Wolff and Johann Friedrich BlumenbachbeforeKant proved decisive for the German exploration of epigenesis, which Mikkelsen rightly singles out as crucial for Kant's views on the life sciences. Their textual inclusion, rather than brief mention in his introduction, might have relativized Kant's place in the discourse of the life sciences of his day. Of course, there are limits to what the volume could provide. That Mikkelsen includes an excerpt from the now forgotten, but at the time eminent, biogeographer Zimmermann is one of the most welcome features of his collection, though I do not believe Mikkelsen fully appreciates the importance of Zimmermann or the influence of his criticisms of Kant.

Even more important, in my view, is the question of Kant's rival, Johann Gottfried Herder, whose reception of Wolff and Blumenbach in hisIdeas for a Philosophical History of Mankind(1784) drew a two-part review from Kant, perhaps the most hostile and disparaging commentary he published on another scholar. Mikkelsen excluded these from his collection, but they in fact deserve a very prominent place in it if we are to understand how Kant came to his ultimate positions. Many of the texts from 1785 onward reflect Kant's explicit critique of Herder and the reactions to it in the wider community of German life science, but the absence of his reviews (to say nothing of texts from Herder himself) obscures this connection. To be sure, again, the volume could not include everything, but my suggestion is that this is not a dispensable element in the story Mikkelsen proposed to reconstruct. He explicitly addresses his omission of Herder and tries, in his introductions to the later texts and in his annotations, to take cognizance of the Herder connection. However, I find these disappointingly superficial regarding Herder. Moreover, there are specific textual passages in Kant's reviews of Herder that are essential for a grasp of the later texts by Kant and the others, and which Mikkelsen could easily have appended or cited more extensively in his annotations. In a word, I find this the most salient historical weakness in Mikkelsen's work.

By contrast, the inclusion of the text from Meiners and the discussion of this figure in the apparatus of the volume represent a very important contribution to Anglophone understanding of the language of race in late eighteenth-century Germany. This is, I suggest, the most cutting-edge element in Mikkelsen's volume, bespeaking his principal concern with race theory. The relation between Meiners and Kant on questions of race has become a matter of increasing scholarly interest, and the possibility of mutual influence has now been put forward as demanding serious consideration. Having a particularly odious exemplar of Meiners' racism in English will make this issue more conspicuous still. This is important, especially in a current context where Meiners is receiving more favorable attention as a cultural anthropologist, but without an adequate recognition of his oppressively racist baggage. For Kant specialists and even more for a general philosophical readership interested in questions of race and cosmopolitanism, Mikkelsen's volume is a very welcome contribution.},
}

@incollection{eze1996color,
  author = {Eze, Emmanuel Chukwudi},
  title = {The Color of Reason: The Idea of {`Race'} in {K}ant's Anthropology},
  booktitle = {Postcolonial African Philosophy: A Critical Reader},
  editor = {Eze, Emmanuel Chukwudi},
  year = {1996},
  publisher = {Blackwell},
  pages = {103--140},
  note = {
  CORE ARGUMENT: Eze argues that race is not peripheral to Kant's anthropology
  but constitutive: Kant's empirical geography and Anthropology from a Pragmatic
  Point of View produce a teleological hierarchy of races in which white
  Europeans alone are capable of rational self-governance and moral progress.
  This racial hierarchy contradicts the cosmopolitan universalism of Kant's
  critical philosophy, revealing an internal fracture.

  RELEVANCE: This is the key essay-length argument for the "Kant is racist"
  thesis that the broader Kant-colonialism literature responds to. It sets
  the terms for the debate about whether Kant's racism can be excised or
  is integral to his philosophy. Essential for understanding what the
  rehabilitative literature (Kleingeld, Wood, Lu-Adler) is arguing against.

  POSITION: Kant's racial anthropology is entangled with his critical
  philosophy in ways that require either rejection or fundamental revision.
  },
  keywords = {Kant-race, anthropology, critical-philosophy-race, High, INCOMPLETE, no-abstract}
}

@book{mills1997racial,
  author = {Mills, Charles W.},
  title = {The Racial Contract},
  year = {1997},
  publisher = {Cornell University Press},
  note = {
  CORE ARGUMENT: Mills argues that the social contract tradition, from Hobbes
  through Rawls, is undergirded by an unacknowledged "Racial Contract" that
  establishes white supremacy as the foundational political reality of modernity.
  This contract defines who counts as a full person and contractor, relegating
  non-whites to a sub-personal status, and produces an epistemology of
  "white ignorance" that naturalizes racial domination. The liberal tradition's
  claim to universal moral equality thus masks a racially differentiated
  political order.

  RELEVANCE: Mills's Racial Contract is the most influential argument that
  Enlightenment political philosophy, including Kant's cosmopolitanism and
  contractarian ethics, is structurally racist rather than incidentally so.
  It directly challenges whether Kantian universalism can be rehabilitated
  by excising the "bad" racial passages, since the problem is claimed to be
  architectural. It frames the entire debate about whether decolonization
  requires rejecting or revising Enlightenment liberalism.

  POSITION: Enlightenment universalism is a partial, racially exclusive
  contract masquerading as universal; the critique must be structural.
  },
  keywords = {racial-contract, Kant-liberalism, critical-philosophy-race, High},
  abstract = {This book[1]brings together nine papers by the political philosopher Samuel Freeman, seven of them previously published.Freeman edited theCollected Papers[2]of John Rawls, theCambridge Companion to Rawls[3]and Rawls's recently publishedLectures on the History of Political Philosophy[4].The subtitle of the volume under review, together with Freeman's editorial work, might suggest that the nine papers collected here are primarily devoted to explaining Rawls's thought.But Freeman insists they are not, or not exactly.He says:
  abstract_source = {ndpr},

A good deal of the discussion in these chapters is not directly interpretation or defense of Rawls, but rather involves extensions or applications of Rawls's positions. (JSC, p. 8)

This is why, he adds immediately, "rather than subtitling the book 'Essays on Rawls', I have used 'Essays on Rawlsian Political Philosophy'".

In fact, Freeman could have subtitled his book "EssaysinRawlsian Political Philosophy", since 'in' would better suit the lingering resonances of the French 'essai' from which the English 'essay' is derived.For the papers collected in this volume are really trials in or attempts to engage in Rawlsian political philosophy -- attempts, that is, to address a variety of philosophical problems and questions in a way that draws on what Rawls wrote and, as Freeman says, "shares the spirit of [Rawls's] position" (JSC, p. 8).

Freeman's papers range over some of the most important subjects in liberal political theory:the nature and varieties of contractarianism, the meaning of the priority of right, the idea of public reason, the problem of stability, the challenge of luck egalitarianism, the democratic character of judicial review, and the demands of international justice.In taking up these subjects, Freeman partakes of the Rawlsian spirit by drawing on and creatively elaborating Rawls's assumptions and arguments as he understands them, and by posing and dividing questions as he thinks Rawls would.

If Freeman can justifiably claim to have produced work on these subjects that is in "the spirit of [Rawls's] position" -- as I believe he can -- that is because he is so thoroughly acquainted with the letter of Rawls's texts.The papers in this volume areessaisin Rawlsian political philosophy, but they are most definitely not desultory forays into that field.Freeman seems to have read almost all of the classical philosophical sources on which Rawls drew, to have assimilated large stretches of contemporary and secondary literature, and to have thought deeply about every sentence Rawls ever wrote.

The result is an extraordinarily substantial set of papers.The shortest of them is 30 pages of small print with narrow margins.All nine are dense with arguments and exegesis.Taken together, the nine essays make for very demanding reading.Students who are looking for an introduction to Rawls would be well advised to start elsewhere.The readers who will benefit -- and benefit greatly -- are those with a serious interest in contemporary political philosophy, especially those who know Rawls's work and ask what a convinced and thoroughly informed Rawlsian would say about a number of debates and objections that enjoy some currency in the philosophical literature.

It is hard to exaggerate how important a contribution Freeman has made by answering that question.Rawls rarely addressed objections to his view, and rarely contended with the positions staked out by others in the debates of the day.Knowing how Rawls might have addressed objections, and knowing what he might have said about the positions of others, are very valuable.It seems unlikely we will ever see a more faithful and better informed set of replies and interventions than those that Freeman provides here.The blending of "interpretation or defense" with "extension[]" is so seamless in this book that there are generally good grounds for thinking that Rawls would have said what Freeman does say.5]},
}

@article{mills2005kant,
  author = {Mills, Charles W.},
  title = {Kant's {Untermenschen}},
  year = {2005},
  journal = {Race and Racism in Modern Philosophy},
  note = {
  CORE ARGUMENT: Mills argues in this essay (collected in Black Rights/White
  Wrongs) that Kant's racial hierarchy assigns non-white peoples to a sub-
  personal moral status---literally "Untermenschen"---thereby contradicting
  his own categorical imperative. This is not a marginal inconsistency but
  shows that Kant's moral philosophy was intended for a racially restricted
  community of persons, with the universalism functioning ideologically.

  RELEVANCE: This is Mills's most focused analysis of Kant specifically,
  developed after The Racial Contract. It directly enters the debate about
  Kant's racism and sets up Mills's later "Black Radical Kantianism" (which
  argues for appropriating Kantian resources against their author's racial
  views). The contrast between this essay and his later work is important
  for understanding the internal tensions within the critical race tradition
  on how to respond to Kant's racism.

  POSITION: Kant's racism is integral to his moral philosophy, not a
  separable anthropological error---but Kantian resources can still be
  appropriated for anti-racist purposes (later Mills).
  },
  keywords = {Kant-race, racial-contract, Mills, Medium, INCOMPLETE, no-abstract}
}

@article{quijano2000coloniality,
  author = {Quijano, An{\'i}bal},
  title = {Coloniality of Power and Eurocentrism in {L}atin {A}merica},
  journal = {International Sociology},
  year = {2000},
  volume = {15},
  number = {2},
  pages = {215--232},
  doi = {10.1177/0268580900015002005},
  note = {
  CORE ARGUMENT: Quijano introduces the concept of the "coloniality of power,"
  arguing that European colonialism did not merely exploit labor and land but
  produced a new global classification of populations by race that persists
  after formal decolonization. This racial classification structures the global
  division of labor and knowledge, constituting what Quijano calls the
  "colonial matrix of power." Eurocentrism---including the Enlightenment
  philosophy of history championed by Hegel---is the epistemological
  expression of this colonial power structure.

  RELEVANCE: Quijano's concept of coloniality of power is the foundational
  framework for decolonial theory (Mignolo, Dussel, Maldonado-Torres) and
  provides the structural-historical argument that Hegel's philosophy of
  history is not a universal account of human development but a Eurocentric
  narrative produced by and for colonial power. This connects directly to
  the critique of Hegel's exclusion of Africa from world history.

  POSITION: The modernity/coloniality nexus: modernity and coloniality
  are two sides of the same coin, not sequential stages.
  },
  keywords = {coloniality-of-power, Hegel-history, decolonial, High},
  abstract = {The globalization of the world is, in the first place, the culmination of a process that began with the constitution of America and world capitalism as a Euro-centered colonial/modern world power. One of the foundations of that pattern of power was the social classification of the world population upon the base of the idea of race, a mental construct that expresses colonial experience and that pervades the most important dimensions of world power, including its specific rationality: Eurocentrism. This article discusses some implications of that coloniality of power in Latin American history.},
  abstract_source = {openalex},
}

@book{mignolo2011darker,
  author = {Mignolo, Walter D.},
  title = {The Darker Side of {W}estern Modernity: {G}lobal Futures, Decolonial Options},
  year = {2011},
  publisher = {Duke University Press},
  doi = {10.1215/9780822394501},
  note = {
  CORE ARGUMENT: Mignolo develops the argument that Western modernity and
  coloniality are inseparable: the rhetoric of salvation, progress, and
  civilization that defines Enlightenment modernity (including Kant's
  cosmopolitanism and Hegel's philosophy of history) is always already the
  darker side of colonial expansion. Against the option of "critical theory"
  that attempts to reform modernity from within (Habermas, Honneth), Mignolo
  proposes "decoloniality" as epistemic delinking from the colonial matrix
  of power/knowledge---the refusal to accept Western epistemology as the
  universal framework.

  RELEVANCE: This is the major theoretical statement of the Mignolo/Quijano
  school that frames Enlightenment philosophy as constitutively colonial.
  It provides the strongest version of the thesis that Kant and Hegel cannot
  be rehabilitated from within because their universalism is the cognitive
  expression of colonialism. It defines the "decolonial option" that
  synthesis discussions must either engage with or explain why immanent
  critique is preferable.

  POSITION: Decolonization requires epistemic delinking from Enlightenment
  universalism, not its internal reform; "pluri-versality" replaces
  "uni-versality."
  },
  keywords = {modernity-coloniality, decolonial, Enlightenment-critique, High, INCOMPLETE, no-abstract}
}

@article{mignolo2009epistemic,
  author = {Mignolo, Walter D.},
  title = {Epistemic Disobedience, Independent Thought and Decolonial Freedom},
  journal = {Theory, Culture {\&} Society},
  year = {2009},
  volume = {26},
  pages = {159--181},
  doi = {10.1177/0263276409349275},
  note = {
  CORE ARGUMENT: Mignolo argues that decolonization requires "epistemic
  disobedience"---a refusal to accept the epistemic framework of Western
  modernity, including its assumptions about reason, universality, and the
  telos of human development. This disobedience is not mere relativism but
  a positive construction of "border thinking" from the colonial difference,
  drawing on knowledges suppressed by the Western canon including Kant's
  Enlightenment reason.

  RELEVANCE: This article provides Mignolo's most accessible formulation of
  what decolonial epistemology means in practice, and his explicit critique
  of Kantian reason as a colonially situated rather than universal epistemic
  framework. It directly addresses the question of how the Enlightenment
  legacy constrains emancipatory thought and what an alternative might look
  like.

  POSITION: "Border thinking" from the colonial difference as alternative
  to both Enlightenment universalism and cultural relativism.
  },
  keywords = {epistemic-disobedience, decolonial, Kant-epistemology, Medium},
  abstract = {Once upon a time scholars assumed that the knowing subject in the disciplines is transparent, disincorporated from the known and untouched by the geo-political configuration of the world in which people are racially ranked and regions are racially configured. From a detached and neutral point of observation (that Colombian philosopher Santiago Castro-Gómez describes as the hubris of the zero point ), the knowing subject maps the world and its problems, classifies people and projects into what is good for them. Today that assumption is no longer tenable, although there are still many believers. At stake is indeed the question of racism and epistemology. And once upon a time scholars assumed that if you ‘come’ from Latin America you have to ‘talk about’ Latin America; that in such a case you have to be a token of your culture. Such expectation will not arise if the author ‘comes’ from Germany, France, England or the US. As we know: the first world has knowledge, the third world has culture; Native Americans have wisdom, Anglo Americans have science. The need for political and epistemic de-linking here comes to the fore, as well as decolonializing and decolonial knowledges, necessary steps for imagining and building democratic, just, and nonimperial/colonial societies.},
  abstract_source = {openalex},
}

@article{dussel2012transmodernity,
  author = {Dussel, Enrique D.},
  title = {Transmodernity and Interculturality: An Interpretation from the Perspective of Philosophy of Liberation},
  journal = {TRANSMODERNITY: Journal of Peripheral Cultural Production of the Luso-Hispanic World},
  year = {2012},
  volume = {1},
  doi = {10.5070/t413012881},
  note = {
  CORE ARGUMENT: Dussel argues that "transmodernity" is not the rejection of
  modernity but its transformation from the perspective of those excluded by
  it: the colonized, enslaved, and dominated. Against Hegel's philosophy of
  history, which positions Latin America, Africa, and Asia as the prehistory
  of European modernity, Dussel argues that these civilizations have their
  own contributions to a genuinely universal world culture that requires
  intercultural dialogue rather than Eurocentric subsumption. Liberation
  philosophy does not merely repeat European critical theory but develops
  from an "exterior" position that Hegel's dialectic cannot accommodate.

  RELEVANCE: Dussel's Latin American liberation philosophy offers an
  alternative to both European critical theory and Mignolo's decolonial
  delinking: a reformed universalism built from dialogue with the excluded.
  This three-way tension (Habermasian reform, Mignolian delinking, Dussellian
  transmodernity) is essential for understanding the landscape of responses
  to Hegel's and Kant's Eurocentric teleologies.

  POSITION: Transmodernity as an intercultural alternative to Hegelian
  Eurocentrism that does not abandon universalism but transforms it.
  },
  keywords = {transmodernity, Hegel-history, liberation-philosophy, High},
  abstract = {Transmodernity and Interculturality: An Interpretation from the Perspective of Philosophy of Liberation},
  abstract_source = {openalex},
}

@article{wynter2003unsettling,
  author = {Wynter, Sylvia},
  title = {Unsettling the Coloniality of {B}eing/{P}ower/{T}ruth/{F}reedom: Towards the Human, After Man, Its Overrepresentation---An Argument},
  journal = {CR: The New Centennial Review},
  year = {2003},
  volume = {3},
  pages = {257--337},
  doi = {10.1353/NCR.2004.0015},
  note = {
  CORE ARGUMENT: Wynter argues that Western modernity produces a specific
  genre of "Man"---the liberal humanist subject descended from Kantian
  autonomous rationality---that represents itself as the universal human.
  This "overrepresentation" of Man excludes racialized Others from full
  human status and structures the colonial order epistemologically.
  Decolonization requires not merely political liberation but a new
  episteme, a new genre of the human beyond the Western Man figure.

  RELEVANCE: Wynter's argument that Kantian rational autonomy is an
  overrepresentation of one particular (European, male, bourgeois) genre
  of the human as the universal provides one of the deepest philosophical
  critiques of Enlightenment universalism. It connects Kant's anthropology
  directly to the colonial production of subjectivity and raises the
  question of what a genuinely universal concept of the human would require.

  POSITION: The Enlightenment concept of Man is a colonial genre that
  must be superseded rather than reformed from within.
  },
  keywords = {coloniality-of-being, Kant-anthropology, decolonial, High, INCOMPLETE, no-abstract}
}

@article{faustino2021fanon,
  author = {Faustino, Deivison},
  title = {Frantz {F}anon and the Creolization of {H}egel: Colonialism, the Interdiction of Dialectics and Emancipation},
  journal = {The CLR James Journal},
  year = {2021},
  volume = {27},
  pages = {189--212},
  doi = {10.5840/clrjames2021121489},
  note = {
  CORE ARGUMENT: Faustino argues that Fanon's engagement with Hegel constitutes
  a "creolization" of the dialectic: Fanon takes the Hegelian framework and
  transforms it from the standpoint of the colonized, showing that colonialism
  "interdicts" the normal operation of the dialectic---the colonized cannot
