  abstract_source = {s2},
}

@article{birdpollan2012fanon,
  author = {Bird-Pollan, Stefan},
  title = {Fanon: Colonialism and the Critical Ideals of {G}erman {I}dealism},
  journal = {Critical Horizons},
  year = {2012},
  volume = {13},
  pages = {377--399},
  doi = {10.1558/crit.v13i3.377},
  note = {
  CORE ARGUMENT: Bird-Pollan argues that Fanon can be productively situated
  within the tradition of German Idealism: Fanon inherits from Kant and
  especially Hegel the conception of agency as something to be achieved
  through struggle rather than given as a natural endowment. This makes
  Fanon's project not a repudiation of German Idealism but its radicalization
  from the position of the colonized, revealing what idealist agency looks
  like when universal claims are taken seriously in colonial conditions.

  RELEVANCE: This article represents the "immanent critique" approach to
  Fanon and German Idealism, arguing that Fanon uses idealist resources
  against idealism's failure to include the colonized. It directly addresses
  the question of whether German Idealism provides resources for anti-colonial
  thought or whether it must be rejected wholesale---the central methodological
  question of Domain 6.

  POSITION: Fanon radicalizes German Idealism rather than rejecting it,
  showing what Kantian-Hegelian agency requires when extended to colonized
  subjects.
  },
  keywords = {Fanon, German-idealism, Hegel-Kant, Medium},
  abstract = {Abstract I argue that Franz Fanon can usefully be situated in the tradition of German Idealism in the sense that he takes from Kant and especially Hegel the conception of agency as something to be achieved through struggle for the ideal of humanity as self-determining. Fanon sees the suffering cased by colonial rule in Africa and elsewhere as deriving from the systematic deprivation of agency by the colonial power. Using the work of Hegel, Fanon seeks to reconstruct the emancipatory project of the black man in close analogy to Hegel’s master-slave dialectic. The violence which Fanon sees as unavoidable in such a struggle is not violence for the sake of violence but, following Hegel, the violence that constitutes the subject in the first place.},
  abstract_source = {s2},
}

@article{allen2016end,
  author = {Allen, Amy},
  title = {The End of Progress: Decolonizing the Normative Foundations of Critical Theory},
  year = {2016},
  publisher = {Columbia University Press},
  doi = {10.7312/alle17324},
  note = {
  CORE ARGUMENT: Allen argues that Frankfurt School critical theory is
  committed to a philosophy of historical progress---derived from the Kantian-
  Hegelian tradition---that is entangled with coloniality and Eurocentrism.
  Against this, she proposes a "metanormative contextualism" that retains
  critical theory's emancipatory aims while abandoning its progressivist
  historiography. The book engages Quijano, Mignolo, and postcolonial theory
  to articulate what a decolonized critical theory would look like.

  RELEVANCE: Allen's book is the most sustained philosophical attempt to
  think through the implications of postcolonial critique for the Kantian-
  Hegelian tradition within critical theory. It directly addresses the
  question of whether the normative foundations of Enlightenment philosophy
  can survive decolonization, and her "metanormative contextualism" answer
  is a major position in current debates.

  POSITION: Critical theory's progressivist foundations must be abandoned
  while its emancipatory aims can be preserved through metanormative
  contextualism.
  },
  keywords = {critical-theory, progress, decolonial, Enlightenment, Medium, INCOMPLETE, no-abstract}
}

