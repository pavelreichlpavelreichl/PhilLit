}

@book{james2025hegel,
  author = {James, Daniel and Knappik, Franz},
  title = {Hegel and Colonialism},
  year = {2025},
  publisher = {Cambridge University Press},
  doi = {10.1017/9781009587143},
  note = {
  CORE ARGUMENT: This Cambridge Element offers the first systematic study of
  Hegel's explicit views on colonialism scattered throughout his mature works,
  arguing that Hegel legitimizes colonialism in the Americas, African slavery,
  and British rule in India through a systematic account rooted in his core
  philosophy. James and Knappik show that Hegel's racial domination narrative
  is underwritten by his conceptions of freedom, personhood, and the lordship-
  bondage dialectic, situating these within his engagement with abolitionism
  and Scottish stadial theory. They also examine the anti-colonial
  appropriations of Hegel by C.L.R. James and Angela Davis.

  RELEVANCE: This is the most comprehensive recent work specifically on
  Hegel and colonialism, making it essential for Domain 6. It provides
  systematic textual evidence for Hegel's pro-colonial views while also
  documenting how the Hegelian tradition was appropriated for anti-colonial
  purposes, directly relevant to the Fanon-Hegel debates.

  POSITION: Hegel's core philosophy is entangled with colonialism but his
  concepts were also transformed for anti-colonial ends, creating a complex
  and contested legacy.
  },
  keywords = {Hegel-colonialism, recognition, anti-colonial, High},
  abstract = {This Element offers the first comprehensive study of Hegel's views on European colonialism.In surprisingly detailed discussions scattered throughout much of his mature oeuvre, Hegel offers assessments that legitimise colonialism in the Americas, the enslavement of Africans, and British rule in India.The Element reconstructs these discussions as being held together by a systematic account of colonialism as racial domination, underpinned by central elements of his philosophy and situated within long-overlooked contexts, including Hegel's engagement with British abolitionism and Scottish four-stages theories of social development.Challenging prevailing approaches in scholarship, James and Knappik show that Hegel's accounts of issues like freedom, personhood, and the dialectic of lordship and bondage are deeply entangled with his disturbing views on colonialism, slavery, and race.Lastly, they address Hegel's ambivalent legacy, examining how British idealists and others adopted his pro-colonial ideas, while thinkers like C.L.R. James and Angela Davis transformed Hegel for anti-colonial purposes.},
  abstract_source = {openalex},
}

@article{kleingeld2019dealing,
  author    = {Kleingeld, Pauline},
  title     = {On Dealing with Kant's Sexism and Racism},
  journal   = {SGIR Review},
  year      = {2019},
  volume    = {2},
  number    = {2},
  pages     = {3--22},
  note      = {
  CORE ARGUMENT: Kleingeld addresses the methodological question of how we ought to engage with Kant's sexist and racist commitments in philosophical practice: in teaching, scholarship, and the use of Kantian resources. She argues that the inconsistency between Kant's universalism and his racism demands acknowledgment and correction rather than either dismissal of the racism as peripheral or rejection of the entire Kantian framework.

  RELEVANCE: Provides an explicit methodological response to the question of "what follows" from Kant's racism: neither wholesale rejection nor uncritical use, but an engagement that recognizes the internal contradiction and works to resolve it using Kantian resources. This is directly relevant to the normative meta-philosophical question addressed in this domain.

  POSITION: Separability-adjacent but reform-oriented; Kant's racism is inconsistent with his universalism and should be corrected from within.
  },
  keywords = {Kant, racism, methodology, pedagogy, reform, High, INCOMPLETE, no-abstract}
}

@article{ramsauer2023philosophical,
  author    = {Ramsauer, Laurenz},
  title     = {Kant's Racism as a Philosophical Problem},
  journal   = {Pacific Philosophical Quarterly},
  year      = {2023},
  volume    = {104},
  number    = {4},
  pages     = {791--815},
  doi       = {10.1111/papq.12444},
  abstract  = {Immanuel Kant was possibly both the most influential racist and the most influential moral philosopher of modern, Western thought. So far, authors have either interpreted Kant as an "inconsistent egalitarian" or as a "consistent inegalitarian." On the former view, Kant failed to draw the necessary conclusions about persons from his own moral philosophy; on the latter view, Kant did not consider non-White people as persons at all. However, both standard interpretations face significant textual difficulties; instead, Ramsauer argues that Kant's moral egalitarianism is so thin as to remain almost entirely useless as an antidote to racism.},
  note      = {
  CORE ARGUMENT: Ramsauer challenges both the inconsistent-egalitarian (Kleingeld) and the consistent-inegalitarian (Mills) interpretations, arguing that Kant's formal moral egalitarianism is too thin to provide any real antidote to his racism. Even if Kant's racism is "inconsistent" with his universalism in some logical sense, the universalism provides no practical or philosophical resources for opposing racism.

  RELEVANCE: Directly intervenes in the separability-entanglement debate by arguing that the separability thesis, even if technically correct about logical inconsistency, is insufficient for the normative purposes that motivate it. Relevant for assessing what the moral universalism can actually do in response to Kant's racism.

  POSITION: Skeptical of both dominant frameworks; holds that Kantian universalism lacks the resources to counter Kant's racism even if the two are formally inconsistent.
  },
  keywords  = {Kant, racism, philosophical-problem, separability, egalitarianism, High}
}

@article{mcnulty2025race,
  author    = {McNulty, Michael Bennett},
  title     = {Race, Culture, and the Horizons of Agency: Kant's Racism, Systematically Understood},
  journal   = {Journal of the American Philosophical Association},
  year      = {2025},
  volume    = {11},
  number    = {2},
  pages     = {393--412},
  doi       = {10.1017/apa.2024.22},
  abstract  = {In order to address the role of Kant's account of "culture" in his racism and provide additional support to Charles Mills' "Untermensch (subhuman) interpretation" of Kant's views on race, this article situates Kant's comments on "racialized cultures" within his teleological account of human history. In his system, "culture" refers to the possession of developed capacities to achieve the ends that one sets for oneself. Kant sees achievement of culture as part of the development of human beings into members of a socialized, moral kingdom. Given his understanding of culture, McNulty argues that Kant's remarks on the cultural limitations of persons of color commit him to the further claims that Indigenous Americans and Black people are incapable of setting their own ends and that these deficiencies are hereditary and permanent.},
  note      = {
  CORE ARGUMENT: McNulty argues that Kant's racism is not merely a peripheral prejudice but is connected to his systematic teleological account of human history and culture. By showing that Kant's concept of "culture" is the hinge connecting his teleology to his racial hierarchy, McNulty provides textual support for Mills' "Untermensch interpretation" -- Kant effectively excludes non-white peoples from moral personhood within his own system.

  RELEVANCE: Advances the entanglement position by identifying a specific systematic mechanism -- the teleological concept of culture -- through which racism is integrated into Kant's philosophy. Provides the strongest recent argument for the consistent-inegalitarian reading against Kleingeld's separability thesis.

  POSITION: Entanglement view supporting Mills' Untermensch interpretation; racism is built into Kant's teleological system.
  },
  keywords  = {Kant, racism, teleology, culture, entanglement, Mills, High}
}

@article{bernasconi2024slavery,
  author    = {Bernasconi, Robert},
  title     = {Slavery's Absence from Histories of Moral and Political Philosophy},
  journal   = {The Southern Journal of Philosophy},
  year      = {2024},
  volume    = {62},
  number    = {S1},
  pages     = {54--67},
  doi       = {10.1111/sjp.12578},
  abstract  = {At a time when many institutions of higher learning are reflecting on their past complicity with chattel slavery, philosophy as an academic discipline has been largely silent about its own complicity. Questions surrounding the legitimacy and practice of slavery were a regular part of moral philosophy courses at universities from the sixteenth century until its abolition. However, the discussions of slavery found in the dominant textbooks tended to be deeply conservative judged even by the standards of those times. This partly explains why after emancipation the many moral questions posed by slavery are barely mentioned in survey histories of ethics or of political philosophy today.},
  note      = {
  CORE ARGUMENT: Bernasconi argues that academic philosophy has been complicit in its own silence about slavery -- moral philosophy textbooks from the period of chattel slavery were conservative, and post-abolition survey histories of ethics have largely erased that history. This silence is not incidental but reflects structural features of how the discipline defines its subject matter and canonical figures.

  RELEVANCE: Extends the entanglement critique from Kant specifically to the discipline of academic philosophy more broadly: the canon-formation problem is not limited to Kant but characterizes the institution. Provides the methodological basis for a critical historiography of philosophy attentive to its own complicity with domination.

  POSITION: Critical historiography of philosophy; the discipline's silence about slavery is itself a form of ideological complicity that requires active redress.
  },
  keywords  = {slavery, canon, historiography, complicity, philosophy, High}
}

@book{park2013africa,
  author    = {Park, Peter},
  title     = {Africa, Asia, and the History of Philosophy: Racism in the Formation of the Philosophical Canon, 1780--1830},
  publisher = {State University of New York Press},
  year      = {2013},
  doi       = {10.1353/book22395},
  note      = {
  CORE ARGUMENT: Park argues that the exclusion of African and Asian philosophy from the European philosophical canon in the period 1780--1830 was not a neutral scholarly development but was driven by racial Eurocentrism. Figures including Kant and his follower Christoph Meiners were instrumental in constructing a "Whites only" philosophical canon by identifying philosophy with European rational culture and excluding non-European traditions as mythology or mere proto-philosophy.

  RELEVANCE: This is the foundational work for the canon-critique position; it demonstrates that the formation of the philosophical canon was itself a racially motivated act and not a neutral scholarly process. Any discussion of decolonizing philosophy or of the complicity of the discipline with racism must engage with Park's argument.

  POSITION: Canon-critique; racism structured the very formation of the philosophical discipline and its curriculum.
  },
  keywords = {canon, racism, historiography, Kant, Eurocentrism, High},
  abstract = {In 2019, Jürgen Habermas published with Suhrkamp Press his 1700-plus pageAuch eine Geschichte der Philosophie. The work appeared in two volumes, subtitled: (1)The Occidental Constellation of Faith and Knowledgeand (2)Rational Freedom: Traces of Discourses on Faith and Reason. In the English language,Also a History of Philosophy(AHP), masterfully translated by Ciarin Cronin, is published by Polity Press in three volumes: (1)The Project of Genealogy of Postmetaphysical Thinking(2022); (2)The Occidental Constellation of Faith and Knowledge(2024); and (3)Rational Freedom. Traces of the Discourse on Faith and Knowledge(2025).
  abstract_source = {ndpr},

The review that follows focuses on Volume III of the English translation. First, I provide an overview of some of the work’s more important claims. Then I pose some questions, principally about the work’s systematic philosophic claims but also, briefly, about its status as a history of philosophy.

As the title indicates, the work is a history of philosophy, one that traces the relationship of faith and reason as it played out historically, primarily in Western thought. As the title also implies, however, the work is more than just a history of philosophy, distinctive though that itself is. It is also and perhaps most significantly a defense of the notion of postmetaphysical reason, which has been a central focus of Habermas’s work for the past thirty years or so. AHP is distinctive, however, in that it presents that defense via a genealogical reconstruction of the evolution of philosophical thought.

Central to this “genealogy of postmetaphysical thinking” is an effort to redeem and recast for contemporary thought crucial insights and assumptions introduced to human civilization during what, following Karl Jaspers, Habermas calls the Axial Age. Occurring in the period between 800 and 200 BCE, the Axial Age reflected the ascendance of the major world religions, including Confucianism, Taoism, Hinduism, Buddhism, and Judaism, as well as classical Greek philosophy. Common to all these movements was an affirmation of principles and values central to the subsequent development principally of Western thought and culture. Among others, these included the idea of objective validity, the principle of the worth and equality of all individuals, a commitment to the welfare of humankind, and an expectation that human affairs be governed by binding norms and impartial standards of justice and morality.

Over 1700 pages, Habermas presents the ensuing interplay of faith and reason as a historical “learning process”, in which the principles and values bequeathed to humanity by the Axial Age are further clarified while gradually purged of the metaphysical and theological detritus that has impeded their proper articulation. Resulting from this process of learning are core elements of Habermas’s idea of postmetaphysical thinking. At issue, in particular, is a notion of rationality committed to norms of objective validity, impartial truth, human equality and historical progress, where those norms are deemed to express, not an absolute authority to which humans are vertically related, but the immanent, horizontally directed, open-ended and fallibilistically conceived practices through which historically situated and “communicatively socialized” individuals shape and reshape the conditions of their shared existence.

Volume III is itself distinctive, as here the genealogy first details the historical emergence of postmetaphysical thinking. Habermas’s focus is on Hume and Kant, each of whom advances a philosophy that rejects the metaphysical assumptions that had accompanied the preceding discourse on faith and knowledge. They do so in diverse ways, however. Hume does so by dismissing or “deconstructing” the religious-theological legacy, while Kant reappropriates or “reconstructs” it. Habermas’s preference is decidedly for the Kantian option.

Indeed, the task of Volume III, as its subtitle indicates, is to clarify for postmetaphysical thinking the concept of “rational freedom” (vernünftige Freiheit) initially elaborated by Kant. That Habermas nonetheless focuses on Hume is attributable not only to the fact that Kant develops his position in response to that of Hume but also that the latter underwrites the scientistic naturalism that today has spawned the self-regulating social systems against which, in the text, he seeks to “encourage” the idea of rational freedom.

Habermas understands rational freedom specifically in terms of Kant’s idea of practical self-legislation. He dubs this idea “one of the few major innovations in the history philosophy” (262), yet presents it, consistent with the effort to discern “traces of the discourse on faith and knowledge”, as rearticulating assumptions that have long informed religious traditions. Thus, while a comprehensive understanding of moral obligation was historically construed in terms of divinely ordained commands, Kant’s understanding of it appeals to universal duties that are humanly self-imposed. Similarly, while Kant continues to espouse the notion, central also to religions, that thought might provide human beings with holistic world orientation, he does so, not by seeking to integrate individuals into a preexisting order of being, but by referencing a world order reflective of the constitutive activity of human beings themselves.},
}

@article{basevich2020reckoning,
  author    = {Basevich, Elvira},
  title     = {Reckoning With Kant on Race},
  journal   = {The Philosophical Forum},
  year      = {2020},
  volume    = {51},
  number    = {3},
  pages     = {221--245},
  doi       = {10.1111/phil.12263},
  abstract  = {This essay develops Kant's theory of reform to theorize racial justice reform. Basevich assesses the function of Kant's philosophy of race as part of his nonideal theory of justice and shows that it defends a racist pragmatic anthropology. She argues for an alternative Kantian nonideal theory of justice that demonstrates how legislative reason actualizes practical freedom, expanding Kant's model of public reason to advance racial justice reform under conditions of partial compliance in a profoundly nonideal republic.},
  note      = {
  CORE ARGUMENT: Basevich develops a reconstructive Kantianism: rather than simply accepting or rejecting Kant's racial views, she extracts Kantian resources for theorizing racial justice reform. Her "nonideal theory of justice" builds on the ideal of civic equality and interracial civic fellowship, correcting the racist pragmatic anthropology that distorted Kant's own application of his principles.

  RELEVANCE: Exemplifies the reconstructive appropriation response to Kant's racism -- using Kantian tools against Kant's own commitments. Directly addresses the meta-philosophical question of "what follows" from Kant's racism.

  POSITION: Reconstructive appropriation; Kantian resources can be used to develop a theory of racial justice reform even if Kant himself failed to do so.
  },
  keywords  = {Kant, racial-justice, reconstruction, nonideal-theory, appropriation, Medium}
}

@article{larrimore2008antinomies,
  author    = {Larrimore, Mark},
  title     = {Antinomies of Race: Diversity and Destiny in Kant},
  journal   = {Patterns of Prejudice},
  year      = {2008},
  volume    = {42},
  number    = {4-5},
  pages     = {341--363},
  doi       = {10.1080/00313220802377313},
  note      = {
  CORE ARGUMENT: Larrimore identifies structural "antinomies" in Kant's treatment of race -- tensions between Kant's teleological commitments to human unity and the fixity required by his biological theory of race; between the moral universalism that should apply to all rational beings and the cultural hierarchy that ranks races developmentally. These antinomies are not external inconsistencies but arise from within the logic of Kant's system.

  RELEVANCE: Provides a philosophically sophisticated alternative to both the simple inconsistency reading (Kleingeld) and the full entanglement reading (Bernasconi): Kant's racism generates internal tensions that are symptomatic of deeper structural problems in his teleological framework. Useful for the entanglement debate without requiring the stronger claim that racism is simply built in.

  POSITION: Structural-antinomy reading; racism generates genuine internal tensions within Kant's systematic philosophy that cannot be resolved by treating it as a mere anomaly.
  },
  keywords  = {Kant, race, antinomies, teleology, diversity, Medium},
  abstract = {ABSTRACT Larrimore's essay reads Kant's pioneering work in the theory of race in the context of his thought as a whole. Kant wrote on race for most of his career; at different stages of his thinking, race assured meaning in human diversity, confirmed the value of a practical-reason-informed understanding of human destiny, and provided a model for the ‘pragmatic’ knowledge of what ‘man can and should make of himself’. ‘Race’ was invented in 1775 as an advertisement for the new disciplines of geography and anthropology that Kant inaugurated and promoted throughout his career. Giving new meaning to a foreign (French) term associated with animal husbandry, Kant presented the (supposedly) exceptionlessly hereditary traits of race as the first fruit of a truly scientific ‘natural history’ of humanity. His concerns were not merely classificatory; his four-race schema, modeled on the temperaments, allowed a special status for Whites as at once a race and the transcendence of race (Kant invented ‘whiteness’ as well as ‘race’). The notion of ‘race’ was refined in essays Kant published in the 1780s, in the same journal as his celebrated essays on Enlightenment and the philosophy of history. It was given a new status, rather than displaced, by the critical turn. Granted a sanction ‘similar’ to the postulates of pure practical reason, its empirical verification would confirm Kant's whole critical system. Kant's theory of race came into its own in the 1790s, gaining wide acceptance. He relied on familiarity with it (and its lingering association with animal husbandry) in explaining the larger project of the ‘pragmatic anthropology’ without which he thought human progress impossible. Understanding how the concept of race contributed to Kant's more familiar and still appealing intellectual and practical concerns, we gain a better sense of its fateful and enduring attractiveness in subsequent eras.},
  abstract_source = {openalex},
}

@article{smith2025historiography,
  author    = {Smith, Daniel J.},
  title     = {Kant's Racism and the Historiography of Philosophy},
  journal   = {Critical Philosophy of Race},
  year      = {2025},
  volume    = {13},
  number    = {2},
  pages     = {303--333},
  doi       = {10.5325/critphilrace.13.2.0303},
  abstract  = {This article reads chapter 6 of Huaping Lu-Adler's Kant, Race, and Racism as a contribution to the contemporary debate about racism and the philosophical canon that began with Peter Park's Africa, Asia, and the History of Philosophy. Lu-Adler adds to Park's narrative a detailed analysis of the link between racism and the historiography of philosophy in Kant's own work, not just in his followers. The second part raises two problems for Lu-Adler's account, relating to the methodology and the role of pre-Kantian historian of philosophy Jacob Brucker, and Lu-Adler's account of Kant as an educator who contributed to racist ideology.},
  note      = {
  CORE ARGUMENT: Smith situates Lu-Adler's argument about Kant's role in racist historiography of philosophy in relation to Park's foundational canon-critique, showing that Lu-Adler strengthens Park's case by identifying Kant's own contribution to racially structured historiography of philosophy -- not just Meiners and later followers. Smith also raises methodological questions about the role of Brucker and the limits of Lu-Adler's educator argument.

  RELEVANCE: Connects the entanglement debate (domain 7) to the canon-formation argument (Park) and shows how the two lines of argument reinforce each other. Important for the meta-philosophical synthesis of the domain.

  POSITION: Sympathetic to entanglement but raises methodological concerns about specific claims in Lu-Adler's account.
  },
  keywords  = {Kant, racism, historiography, canon, Lu-Adler, Park, Medium}
}

@article{decarie2024bernasconi,
  author    = {D\'{e}carie-Daigneault, Benjamin},
  title     = {Robert Bernasconi and the Challenges of a Critical Philosophy of Race: (Un)learning to Read and Teach the History of Moral Philosophy},
  journal   = {Philosophy \& Social Criticism},
  year      = {2024},
  volume    = {51},
  number    = {2},
  pages     = {324--343},
  doi       = {10.1177/01914537241284546},
  abstract  = {This essay extracts from Bernasconi's writings an implicit methodology that can be broken down into three main moves: (1) a historiographical work, akin to Michel Foucault's "archaeological" method, aimed at uncovering the material conditions that allowed for the emergence of philosophical ideas of the past, (2) a dialectical work aimed at interpreting this collection of historical data through the critical lens of race, and (3) a pedagogical work aimed at transforming the practice of academic philosophy in light of the critique.},
  note      = {
  CORE ARGUMENT: Decarie-Daigneault reconstructs Bernasconi's implicit methodology as a three-part program: archaeological uncovering of material conditions, dialectical interpretation through the lens of race, and pedagogical transformation of philosophical practice. The result is not a rejection of the canonical tradition but a fundamental reorientation in how we approach it.

  RELEVANCE: Provides the clearest systematic account of what Bernasconi's entanglement methodology actually requires in practice -- as opposed to just in principle. Relevant for thinking about what critical engagement with Kant's racism demands of scholars and teachers.

  POSITION: Systematic reconstruction of the entanglement methodology as program for reform of philosophical pedagogy and scholarship.
  },
  keywords  = {Bernasconi, methodology, canon, pedagogy, critical-philosophy-of-race, Medium}
}

@article{strickland2023racism,
  author    = {Strickland, Lloyd and Wang, Jia},
  title     = {Racism and Eurocentrism in Histories of Philosophy},
  journal   = {Open Journal of Philosophy},
  year      = {2023},
  volume    = {13},
  number    = {01},
  pages     = {76--96},
  doi       = {10.4236/ojpp.2023.131005},
  abstract  = {This paper examines the fortunes of non-European philosophies in histories of philosophy written by European and American philosophers from the 17th century to the present day. It charts the shift from inclusive histories of philosophy to exclusive histories at the end of the 18th century, arguing this shift was motivated by racial Eurocentrism, which cast a long shadow over histories of philosophy written during the 19th and 20th centuries.},
  note      = {
  CORE ARGUMENT: Strickland and Wang trace the historical shift from inclusive histories of philosophy (which included African and Asian traditions) to the exclusively Eurocentric history of philosophy that became dominant after 1780, arguing this shift was driven by racist ideology rather than scholarly judgment. They also examine recent attempts to produce more inclusive histories.

  RELEVANCE: Provides historical evidence for Park's thesis with a longer time horizon, and documents both the racist turn and contemporary corrective efforts. Relevant for the canon-critique dimension of this domain.

  POSITION: Canon-critique and historical documentation of the racist exclusion of non-European philosophies from the Western canon.
  },
  keywords  = {canon, racism, Eurocentrism, historiography, non-European, Medium}
}

@article{govedarica2024critical,
  author    = {Govedarica, Jelena and Smajevi\'{c} Rolji\'{c}, Milica},
  title     = {A Critical Assessment of the Kleingeld--Bernasconi Debate on Kant's Racism},
  journal   = {Con-Textos Kantianos. International Journal of Philosophy},
  year      = {2024},
  number    = {20},
  pages     = {73--86},
  doi       = {10.5209/kant.95619},
  abstract  = {This paper offers a critical evaluation of the arguments that Kleingeld and Bernasconi used to support their claims regarding the idea that Kant held racist beliefs. Firstly, we criticize the views on which they agree, aiming to emphasize our understanding of Kant's thoughts on race. Secondly, we assess the significance of Kant's draft for Towards Perpetual Peace when considering the debate.},
  note      = {
  CORE ARGUMENT: Govedarica and Smajević Roljić critically assess the main arguments advanced by both Kleingeld and Bernasconi, identifying weaknesses in each and questioning the premises shared by both parties. They pay particular attention to the evidential weight of the draft for Perpetual Peace, central to Kleingeld's developmental argument.

  RELEVANCE: Provides the most direct recent survey of the Kleingeld-Bernasconi debate from a critical distance, useful as a secondary mapping of the debate's key claims and methodological commitments. Relevant for any synthesis of the separability-entanglement literature.

  POSITION: Critical of both dominant positions; seeks a more nuanced account of Kant's views on race that neither condemns nor excuses.
  },
  keywords  = {Kleingeld, Bernasconi, Kant, racism, debate, methodology, Medium}
}

@article{graness2018canon,
  author    = {Graness, Anke},
  title     = {Questions of Canon Formation in Philosophy: The History of Philosophy in Africa},
  journal   = {Phronimon},
  year      = {2018},
  volume    = {16},
  number    = {2},
  pages     = {78--96},
  doi       = {10.25159/2413-3086/3819},
  abstract  = {The history of philosophy is not just an academic discipline, but considered to be a philosophical activity itself. It has been instrumental in shaping our understanding of philosophy, our philosophical canon and curricula. The history of philosophy in Africa is still a young discipline, although philosophical thinking can be traced back until ancient Egypt. Facing the problem of exclusion and inferiorisation of traditions of thought and philosophy in Africa, the discipline requires a project of "conceptual decolonisation".},
  note      = {
  CORE ARGUMENT: Graness argues that the exclusion of African philosophical traditions from the global canon reflects historically sedimented racist assumptions that require active "conceptual decolonisation." The history of philosophy in Africa is a young discipline precisely because the canon-forming processes of the 18th and 19th centuries excluded it, and remedying this requires not just adding African names but rethinking the methodological assumptions of the discipline.

  RELEVANCE: Connects the canon-critique debate to the African philosophical tradition and the project of decolonization, extending Park's argument to show what constructive alternatives might look like. Relevant for the question of what follows from recognition of racist canon formation.

  POSITION: Canon-critique from a decolonial perspective; remedying exclusion requires methodological as well as substantive reform.
  },
  keywords  = {canon, decolonization, Africa, philosophy, historiography, Low}
}

@article{huseyinzadegan2025observations,
  author    = {Huseyinzadegan, Dilek},
  title     = {Observations on \textit{Kant, Race, and Racism}},
  journal   = {Critical Philosophy of Race},
  year      = {2025},
  volume    = {13},
  number    = {2},
  pages     = {242--252},
  doi       = {10.5325/critphilrace.13.2.0242},
  abstract  = {Huaping Lu-Adler's new book Kant, Race, and Racism: Views from Somewhere confronts the issues of race and racism in Kant's philosophy directly. In the legacy of Charles Mills, Lu-Adler brings these issues from the margins to the mainstream of philosophical scholarship. This article offers observations on defining racism in relation to Kantian philosophy, how much we have yet to uncover, and on methodology.},
  note      = {
  CORE ARGUMENT: Huseyinzadegan engages with Lu-Adler's book as continuing Charles Mills' project of bringing race from the margins to the center of Kant scholarship, and raises methodological questions about how to define racism in relation to Kantian philosophy and about the scope of what remains to be uncovered.

  RELEVANCE: Part of the 2025 symposium on Lu-Adler's book; raises methodological questions about definition and scope that are relevant to the meta-philosophical dimension of this domain.

  POSITION: Sympathetic to entanglement; raises questions about methodological standards for attributing racism to a philosophical system.
  },
  keywords  = {Kant, racism, methodology, Lu-Adler, Mills, Low}
}

