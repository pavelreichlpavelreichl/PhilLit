  POSITION: Herder as a philosophically serious critic of Kantian rationalism
  whose naturalism anticipates later historicist and Romantic responses.
  },
  keywords = {Kant critique, German philosophy, historicism, rationalism, High},
  abstract = {Thanks to Beiser, we can newly appreciate the influence of Kant's critics on the development of his philosophy. Beiser brings the controversies, and the personalities who engaged in them, to life and tells a story that has uncanny parallels with the debates of the present.},
  abstract_source = {openalex},
}

@article{lestition2007countering,
  author = {Lestition, Steven O.},
  title = {Countering, Transposing, or Negating the Enlightenment? A Response to Robert Norton},
  journal = {Journal of the History of Ideas},
  year = {2007},
  volume = {68},
  number = {4},
  pages = {659--681},
  doi = {10.1353/jhi.2007.0034},
  note = {
  CORE ARGUMENT: Lestition responds to Norton's critique by defending a
  modified version of the Counter-Enlightenment concept, arguing that while
  Norton correctly identifies weaknesses in Berlin's formulation, there are
  nonetheless genuine patterns of opposition to Enlightenment commitments
  among certain German thinkers including Herder. The debate turns on what
  minimal content the Counter-Enlightenment concept requires.

  RELEVANCE: Forms part of the Norton-Lestition exchange that defines the
  current state of the debate over Herder's relationship to the Enlightenment.
  Together with Norton's article, this piece frames the methodological stakes
  of characterizing Herder's critical stance.

  POSITION: Defends a qualified Counter-Enlightenment concept against Norton's
  wholesale rejection; acknowledges complexity of Herder's position.
  },
  keywords = {Counter-Enlightenment, Norton, Enlightenment, Herder, Medium},
  abstract = {This essay is a response to Robert Norton's "The Myth of the Counter-Enlightenment". Norton's essay raises two issues. Is Isaiah Berlin's interpretation of Hamann and Herder based on one-sided and faulty scholarship, naively putting itself in the service of an anti-liberal myth about those figures originated by early twentieth-century German ideologues? A second issue flows from the first: if Berlin was mistaken in his reading of the work of Hamann and Herder, mistaking what they contributed to the Enlightenment, is Berlin's very notion of a Counter-Enlightenment a fiction-a myth? Thorough analysis of those issues would require several essays. Instead, I try to sketch an alternative reading of Berlin's style of doing intellectual history, while highlighting the limitations of Norton's critique.},
  abstract_source = {openalex},
}

@incollection{zuckert2014organisms,
