}

@article{norton2007myth,
  author = {Norton, Robert Edward},
  title = {The Myth of the Counter-Enlightenment},
  journal = {Journal of the History of Ideas},
  year = {2007},
  volume = {68},
  number = {4},
  pages = {635--658},
  doi = {10.1353/jhi.2007.0040},
  note = {
  CORE ARGUMENT: Norton argues that the concept of the "Counter-Enlightenment"
  as used by Isaiah Berlin and others is a historiographical invention without
  adequate basis in the primary sources. The alleged Counter-Enlightenment
  thinkers -- Hamann, Herder, and others -- did not share a unified opposition
  to the Enlightenment but had diverse and complex relationships to its themes
  and commitments. Norton contends that the label distorts understanding of
  these thinkers by forcing them into an anachronistic polemical framework.

  RELEVANCE: Directly challenges Berlin's framing of Herder as a
  Counter-Enlightenment figure, which is one of the key questions of the
  domain. Norton's critique has provoked a methodological debate about how
  to characterize Herder's relationship to the Aufklarung.

  POSITION: Denies the coherence of the Counter-Enlightenment as a historical
  category; Herder must be understood on his own terms rather than as Berlin's
  anti-Enlightenment foil.
  },
  keywords = {Counter-Enlightenment, Berlin, historiography, myth, Medium},
  abstract = {Use of the word "Counter-Enlightenment" has become increasingly frequent in scholarly and journalistic writing. The word was almost certainly invented by the late Sir Isaiah Berlin, and it is owing to his enormous prestige and on-going influence that it has gained its current familiarity. In Berlin's view, two of the most important sources of the supposed Counter-Enlightenment are J. G. Hamann and J. G. Herder. But as I show, Berlin's numerous accounts of their thought are profoundly flawed and reflect not Herder's or Hamann's own thought, but rather that of late nineteenth- and early twentieth-century German historians, who wished to legitimate their own anti-democratic, and hence anti-Enlightenment, ideology through the construction of a false historical genealogy.},
  abstract_source = {openalex},
}

@article{lestition2007countering,
  author = {Lestition, Steven O.},
  title = {Countering, Transposing, or Negating the Enlightenment? A Response to Robert Norton},
  journal = {Journal of the History of Ideas},
  year = {2007},
  volume = {68},
  number = {4},
  pages = {659--681},
  doi = {10.1353/jhi.2007.0034},
  note = {
  CORE ARGUMENT: Lestition responds to Norton's critique by defending a
  modified version of the Counter-Enlightenment concept, arguing that while
  Norton correctly identifies weaknesses in Berlin's formulation, there are
  nonetheless genuine patterns of opposition to Enlightenment commitments
  among certain German thinkers including Herder. The debate turns on what
  minimal content the Counter-Enlightenment concept requires.

  RELEVANCE: Forms part of the Norton-Lestition exchange that defines the
  current state of the debate over Herder's relationship to the Enlightenment.
  Together with Norton's article, this piece frames the methodological stakes
  of characterizing Herder's critical stance.

  POSITION: Defends a qualified Counter-Enlightenment concept against Norton's
  wholesale rejection; acknowledges complexity of Herder's position.
  },
  keywords = {Counter-Enlightenment, Norton, Enlightenment, Herder, Medium},
  abstract = {This essay is a response to Robert Norton's "The Myth of the Counter-Enlightenment". Norton's essay raises two issues. Is Isaiah Berlin's interpretation of Hamann and Herder based on one-sided and faulty scholarship, naively putting itself in the service of an anti-liberal myth about those figures originated by early twentieth-century German ideologues? A second issue flows from the first: if Berlin was mistaken in his reading of the work of Hamann and Herder, mistaking what they contributed to the Enlightenment, is Berlin's very notion of a Counter-Enlightenment a fiction-a myth? Thorough analysis of those issues would require several essays. Instead, I try to sketch an alternative reading of Berlin's style of doing intellectual history, while highlighting the limitations of Norton's critique.},
  abstract_source = {openalex},
}

@article{piirimae2015berlin,
  author = {Piirimäe, Eva},
  title = {Berlin, Herder, and the Counter-Enlightenment},
  journal = {Eighteenth-Century Studies},
  year = {2015},
  volume = {49},
  number = {1},
  pages = {71--76},
  doi = {10.1353/ecs.2015.0042},
  note = {
  CORE ARGUMENT: Piirimae argues that Berlin's reading of Herder as a
  Counter-Enlightenment thinker is based on selective evidence and misrepresents
  Herder's actual political and historical thought. Berlin overemphasizes
  Herder's cultural particularism and nationalism while underplaying his
  cosmopolitan commitments, his critique of colonialism, and his positive
  engagement with Enlightenment ideals of Humanitat and progress through
  diversity.

  RELEVANCE: One of the most focused recent assessments of the Berlin-Herder
  interpretive question, drawing on Piirimae's broader work on Herder's
  political thought. Directly addresses the question of whether Berlin's
  Counter-Enlightenment reading is defensible.

  POSITION: Herder is misread by Berlin; his Enlightenment commitments and
  cosmopolitan outlook are obscured by the Counter-Enlightenment framing.
  },
  keywords = {Berlin, Counter-Enlightenment, Herder, revisionism, Medium},
  abstract = {This short essay discusses the usefulness and contemporary relevance of the notion of the Counter-Enlightenment, taking as its starting point Isaiah Berlin’s broader politico-intellectual concerns and interests in popularizing this term (the foundations of liberalism, moral relativism/pluralism, the origins and varieties of nationalism). It argues that all these issues are still relevant today, but that we are better off exploring them without this highly problematic category. Not only does it posit an illegitimate divide between French and German moral and political thought in the eighteenth century, but it also proves deeply misleading about the ideas of individual authors such as Johann Gottfried Herder.},
  abstract_source = {openalex},
}

@article{yack2012significance,
  author = {Yack, Bernard},
  title = {The Significance of Isaiah Berlin's Counter-Enlightenment},
  journal = {European Journal of Political Theory},
  year = {2012},
  volume = {12},
  number = {1},
  pages = {49--60},
  doi = {10.1177/1474885112463649},
  note = {
  CORE ARGUMENT: Yack argues that Berlin's Counter-Enlightenment thesis is
  significant not primarily as accurate intellectual history but as a political
  intervention: Berlin was using the Counter-Enlightenment thinkers, including
  Herder, to develop resources for value pluralism against both liberal
  universalism and totalitarian nationalism. The historical interpretation is
  shaped by this normative agenda, which explains both its insights and its
  distortions.

  RELEVANCE: Explains why Berlin's reading of Herder has been so influential
  and contested, contextualizing the debate within Berlin's broader political
  philosophy of value pluralism. This helps assess what is at stake in the
  "Counter-Enlightenment or reformer" question for the project's purposes.

  POSITION: Berlin's Counter-Enlightenment concept is a political as much as
  a historical thesis; its value lies in the resources it offers for pluralism.
  },
  keywords = {Berlin, Counter-Enlightenment, value pluralism, political philosophy, Medium},
  abstract = {This paper takes a close look at Berlin’s claim that the emergence of Counter-Enlightenment pluralism marks a momentous historical watershed. It concludes that Berlin is right to draw our attention to the importance of this event, but that he seriously misinterprets its significance. He has good reason, in particular, to treat Herder as ‘the most formidable adversary of the French philosophes and their German disciples’, but not because Herder put a stop to the ancient creed of monism on which they relied. For Berlin’s monistic interpretation of the French Enlightenment, I shall show, badly misrepresents that intellectual movement and its impact on the world. The great significance of Herder’s pluralist critique of the Enlightenment lies, instead, in the way in which it rehabilitates prejudice as a source of human virtue and creativity, a critique that directly attacks the core mission of the philosophes: to remove the obstacles to the gathering, preservation and dissemination of useful knowledge.},
  abstract_source = {openalex},
}

@article{james2022situating,
  author = {James, David},
  title = {Situating the Enlightenment in Herder's Philosophy of History},
  journal = {Journal of the Philosophy of History},
  year = {2022},
  volume = {16},
  number = {2},
  pages = {247--270},
  doi = {10.1163/18722636-12341480},
  note = {
  CORE ARGUMENT: James argues that Herder's philosophy of history does not
  simply reject the Enlightenment but situates it as one historical epoch
  among others, subject to the same contextual and genetic analysis he applies
  to all cultural formations. This meta-historical stance allows Herder to
  criticize Enlightenment excesses (abstraction, universalism, linear progress)
  while acknowledging the legitimate aspirations of the Enlightenment project.

  RELEVANCE: Directly addresses how Herder's critique of Enlightenment
  philosophy of history works philosophically -- not as wholesale rejection
  but as historicization. This is relevant to characterizing what precisely
  Herder objects to in Voltaire's and Kant's approaches to history.

  POSITION: Herder's relationship to Enlightenment is dialectical: he
  historicizes it rather than simply negating it.
  },
  keywords = {Herder, Enlightenment, philosophy of history, historicization, Medium},
  abstract = {Although Herder is critical of the Enlightenment, I show that his philosophy of history commits him to the claim that the age and culture shaped by the Enlightenment in some way makes a distinctive contribution to the development of humanity. Yet this contribution cannot make this age and culture superior to earlier ones, for this would violate Herder’s commitment to the principle that each age and culture ought to be accorded an equal status because of the equal value of its contribution to the full development of humanity. I argue that an abstract way of thinking and a hostility to prejudice are integral elements of Herder’s attempt to situate the Enlightenment in his philosophy of history, despite how he otherwise criticizes the Enlightenment for its abstract thinking and its hostility to prejudice.},
  abstract_source = {s2},
}

@article{nassar2015analogy,
  author = {Nassar, Dalia},
  title = {Analogy, Natural History and the Philosophy of Nature: Kant, Herder and the Organisation of Nature},
  journal = {Journal of the Philosophy of History},
  year = {2015},
  volume = {9},
  number = {2},
  pages = {240--257},
  doi = {10.1163/18722636-12341302},
  note = {
  CORE ARGUMENT: Nassar examines how Herder and Kant deploy analogical
  reasoning differently in their accounts of organic nature and history.
  Herder uses analogy to establish a continuum between organic wholes and
  historical cultures, arguing for a naturalistic teleology that is built
  into the fabric of things, while Kant insists that teleological judgments
  are merely regulative. This divergence is central to understanding Kant's
  critique of the Ideen's methodology.

  RELEVANCE: Provides a precise philosophical account of the methodological
  disagreement between Herder and Kant over teleology that underlies Kant's
  reviews of the Ideen. Essential for understanding what is at stake in the
  controversy over natural history and philosophy of nature.

  POSITION: The Kant-Herder dispute over teleology is fundamentally about
  the status of analogical reasoning in natural and historical inquiry.
  },
  keywords = {teleology, analogy, natural history, Kant, Herder, Ideen, High},
  abstract = {In 1785 Kant published a series of critical reviews of Johann Gottfried Herder’s Ideas for a Philosophy of the History of Humanity (1784–1785), in which he not only challenges Herder’s conception of nature but also, and more importantly, his methodology. Kant’s complaint is that by relying on analogy, Herder draws deeply mistaken conclusions that overlook fundamental differences between human and nonhuman beings. But was Kant’s critique of Herder entirely fair? And how does it compare to Kant’s own use of analogy? My claim is that Herder’s use of analogy posed a fundamental methodological challenge to Kant, a challenge he sought to meet in the years following the reviews. In so doing, however, Kant found himself in the untenable situation of, on the one hand, granting analogy greater significance, and, on the other, severely restricting its use. By tracing the shifts in Kant’s thought through the lens of analogy, I aim to show that Kant’s transformed understanding of analogy reveals a fundamental tension between his a priori “metaphysics of nature” and empirical science, a tension that fundamentally shaped the philosophies of nature after Kant.},
  abstract_source = {openalex},
}

@incollection{zuckert2014organisms,
  author = {Zuckert, Rachel E.},
  title = {Organisms and Metaphysics: Kant's First Herder Review},
  booktitle = {Kant's Theory of Biology},
  year = {2014},
  pages = {61--78},
  publisher = {DE GRUYTER},
  doi = {10.1515/9783110225792.61},
  note = {
  CORE ARGUMENT: Zuckert provides a close reading of Kant's first review of
  the Ideen (1785), arguing that Kant's objections focus specifically on
  Herder's metaphysical commitment to a constitutive (rather than merely
  regulative) teleology in organic nature. Kant charges that Herder illegitimately
  hypostasizes what should remain a heuristic analogy between organisms and
  souls, a charge that reveals the deep metaphysical gap between their positions
  on organic life and its relationship to history.

  RELEVANCE: This is the most philosophically detailed analysis of the specific
  content of Kant's first Ideen review, which is the primary text for
  understanding the Kant-Herder controversy. It directly addresses what is
  at stake in the dispute over teleology.

  POSITION: Kant's critique of Herder turns on the constitutive/regulative
  distinction in teleological judgment; Herder's position is philosophically
  distinctive but metaphysically unguarded by Kantian standards.
  },
  keywords = {Kant, Herder review, Ideen, teleology, organisms, metaphysics, High, INCOMPLETE, no-abstract}
}

@article{denby2005herder,
  author = {Denby, David},
  title = {Herder: Culture, Anthropology and the Enlightenment},
  journal = {History of the Human Sciences},
  year = {2005},
  volume = {18},
  number = {1},
  pages = {55--76},
  doi = {10.1177/0952695105051126},
  note = {
  CORE ARGUMENT: Denby argues that Herder should be understood as a reformer
  of Enlightenment anthropology rather than its opponent. Herder's critique
  of abstract universalism and his concept of cultural individuality are
  developed within a recognizably Enlightenment framework of empirical inquiry
  into human nature; he extends the Enlightenment project of natural history
  to human cultures rather than abandoning it. Denby also examines Herder's
  complex relationship to the emerging discourse of race.

  RELEVANCE: Addresses directly the question of whether Herder is a
  Counter-Enlightenment figure, arguing against Berlin's reading and connecting
  Herder's cultural philosophy to the anthropological strand of Enlightenment
  thought. The analysis of Herder's transformation of Enlightenment categories
  is relevant to understanding the Ideen.

  POSITION: Herder as Enlightenment reformer who extends rather than rejects
  the anthropological project; the Counter-Enlightenment label is misleading.
  },
  keywords = {anthropology, Enlightenment, culture, Herder, Counter-Enlightenment, Medium},
  abstract = {The anthropological sensibility has often been seen as growing out of opposition to Enlightenment universalism. Johann Gottfried Herder (1744-1803) is often cited as an ancestor of modern cultural relativism, in which cultures exist in the plural. This article argues that Herder’s anthropology, and anthropology generally, are more closely related to Enlightenment thought than is generally considered. Herder certainly attacks Enlightenment abstraction, the arrogance of its Eurocentric historical teleology, and argues the case for a proto-hermeneutical approach which emphasizes embeddedness, horizon, the usefulness of prejudice. His suspicion of the ideology of progress and of associated theories of stadial development leads to a critique of cosmopolitanism and, particularly, of colonialism. But a comparison with a central Enlightenment figure like the natural historian Buffon (1708-88) reveals shared anthropological assumptions: human beings are characterized by the flexibility of their relationship to their environment, and by their ability to transmit and receive social knowledge. Herder’s critique of progress is thus an unstable one: culture [ Kultur ] as the process through which humanity develops can also be called Enlightenment [ Aufklärung ]. Herder’s definition of culture is much closer to a unitary Enlightenment model of civilization than is frequently suggested. Herder’s relativism is thus open to question: he holds on to certain universal criteria for transcultural judgements. This reassessment of Herder’s place in Enlightenment anthropology raises questions of contemporary relevance regarding cultural relativism on the one hand, and modernization and globalization on the other.},
  abstract_source = {openalex},
}

@incollection{lifschitz2016meinecke,
  author = {Lifschitz, Avi},
  title = {Between Friedrich Meinecke and Ernst Cassirer: Isaiah Berlin's Bifurcated Enlightenment},
  booktitle = {Isaiah Berlin and the Enlightenment},
  year = {2016},
  pages = {51--66},
  publisher = {Oxford University Press},
  doi = {10.1093/acprof:oso/9780198783930.003.0004},
  note = {
  CORE ARGUMENT: Lifschitz traces Berlin's Counter-Enlightenment concept to
  its structural debt to Friedrich Meinecke's Die Entstehung des Historismus,
  which also contrasted a "Western" rationalist tradition with German
  Romanticism and historicism. Berlin's bifurcated picture of the Enlightenment
  and its German critics, including Herder, is shown to derive conceptual
  scaffolding from Meinecke while combining it with Cassirer's more positive
  account of Enlightenment reason.

  RELEVANCE: Illuminates the genealogy of the Berlin thesis about Herder and
  the Counter-Enlightenment, showing it is not a purely historical judgment
  but inherits a German philosophical tradition of contrasting French rationalism
  with German historicism. This background helps explain why the Berlin
  framework has been so contested.

  POSITION: Berlin's Counter-Enlightenment concept has an intellectual genealogy
  in German historicist thought that compromises its historical reliability.
  },
  keywords = {Berlin, Meinecke, Counter-Enlightenment, intellectual history, historiography, Low},
  abstract = {Abstract This chapter explores the hitherto neglected influence of Friedrich Meinecke on Isaiah Berlin’s distinction between a mostly French Enlightenment and its alleged rivals in Germany. Highlighting the structural and terminological similarities between Berlin’s account of the Counter-Enlightenment and Meinecke’s description of the precursors of historicism, it also provides as yet unpublished evidence from Berlin’s correspondence to this effect. Berlin’s endorsement of Meinecke’s dichotomy between Enlightenment and pre-historicism is situated against his distaste for attempts to reveal cross-currents and common themes in eighteenth-century thought. This aversion to the study of transnational links in the Enlightenment is manifest in Berlin’s hostile reaction to Ernst Cassirer’s work on the topic.},
  abstract_source = {openalex},
}
