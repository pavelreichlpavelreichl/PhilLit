@article{forster2002herder,
  author = {Forster, Michael N.},
  title = {Herder's Philosophy of Language, Interpretation, and Translation: Three Fundamental Principles},
  journal = {Review of Metaphysics},
  year = {2002},
  volume = {56},
  number = {2},
  pages = {323--356},
  note = {
  CORE ARGUMENT: Forster identifies three principles that distinguish
  Herder's contribution to the philosophy of language and
  interpretation: (1) that thought is essentially dependent on and
  bounded by language; (2) that languages differ deeply in their
  conceptual contents, not merely their sounds; and (3) that
  understanding an alien language or culture requires a special act of
  imaginative immersion — what Forster calls a "genetic" approach —
  rather than mere translation into one's own conceptual scheme. The
  article also explains the philosophical genealogy of these principles
  from Herder's encounter with Hamann and the pre-critical Kant.

  RELEVANCE: This article is the concentrated statement of Forster's
  interpretive thesis about Herder, and the most widely cited
  single paper on Herder's hermeneutics; any engagement with the
  Forster-Gjesdal debate must work through this piece. It directly
  addresses the relation between Herder's philosophy of language and
  his method of historical interpretation.

  POSITION: Foundational statement of Forster's systematic reading of
  Herder as founder of modern hermeneutics and philosophy of language.
  },
  keywords = {philosophy-of-language, hermeneutics, Einfühlung, High, INCOMPLETE, no-abstract}
}

