@article{zammito2010herder,
  author = {Zammito, John H. and Menges, Karl and Menze, Ernest A.},
  title = {Johann Gottfried Herder Revisited: The Revolution in Scholarship in the Last Quarter Century},
  journal = {Journal of the History of Ideas},
  year = {2010},
  volume = {71},
  number = {4},
  pages = {661--684},
  doi = {10.1353/jhi.2010.0006},
  note = {
  CORE ARGUMENT: The authors survey the major transformations in Herder
  scholarship since the 1980s, arguing that the revival has corrected
  two persistent misreadings: the charge of irrationalism (propagated
  by Berlin's influential but flawed account) and the charge of
  proto-nationalist racism. The essay emphasizes two newly foregrounded
  aspects of Herder: his contribution to the emergent human sciences
  (including hermeneutics) and the continuity of his project with
  Enlightenment universalism rather than its repudiation.

  RELEVANCE: This review essay serves as an essential orientation to
  the state of Herder scholarship and helps the project situate its
  treatment of hermeneutics and historical understanding within the
  broader debate about Herder's intellectual legacy. Particularly
  important for understanding how the "Enlightenment Herder" versus
  "counter-Enlightenment Herder" debate shapes interpretations of
  Einfühlung.

  POSITION: Revisionist position: Herder as Enlightenment thinker,
  correcting Berlin's counter-Enlightenment reading.
  },
  keywords = {Herder-reception, historiography, human-sciences, Medium},
  abstract = {A veritable tidal shift in Herder scholarship has taken place over the last quarter century, primarily but not exclusively in German. This review essay seeks to evoke the richness and vitality of this revival with the hope of persuading American academics that some ill-founded opinions still circulating concerning Herder's "irrationalism" and chauvinistic, even racist nationalism, and his philosophical naivety and literary effrontery, might at last be put to rest. The recent revival has brough sharply to the fore two crucial aspects of Herder. First, there is the contribution of Herder's thought to the emergent cultural and social sciences. Second, for Herder the "science of man" was also a natural science: the division between the humanities and the natural sciences that has been such a hallmark of the age from Kant until very recently did not exist for Herder.},
  abstract_source = {openalex},
}

@incollection{wildschut2020analogy,
  author = {Wildschut, Niels},
  title = {Analogy, Empathy, Incommensurability: Herder's Conception of Historical Understanding},
  booktitle = {Herder on Empathy and Sympathy},
  year = {2020},
  publisher = {Brill},
  pages = {158--182},
  doi = {10.1163/9789004426870_008},
  note = {
  CORE ARGUMENT: Wildschut examines how Herder uses analogy and
  Einfühlung as complementary strategies for overcoming the
  incommensurability between historical epochs; analogy provides
  structural bridges across cultural difference while Einfühlung
  supplies the imaginative-affective dimension needed to grasp an
  epoch's inner self-understanding. The chapter argues that these two
  strategies are not in tension but together constitute Herder's
  methodologically distinctive approach to historical understanding.

  RELEVANCE: This is one of the most focused recent analyses of
  Herder's actual methodology of historical understanding, directly
  addressing the question of what Einfühlung does as an epistemic
  tool and how it handles the incommensurability that follows from
  Herder's claim that each epoch carries its standard within itself.

  POSITION: Analytical reconstruction of Herder's methodology of
  historical understanding, sympathetic to Forster's framework but
  more focused on specific epistemic mechanisms.
  },
  keywords = {Einfühlung, historical-understanding, incommensurability, High},
  abstract = {This chapter considers the function of analogical understanding in Herder’s early psychology and philosophy of history. First, it explains how Herder understood analogy to be an integral aspect of human cognition and sympathy. Second, it discusses how analogical understanding is applied in historical enquiry, by looking at both the theory and praxis of Herder’s historiography. In this way, it determines both the scope and correct use of analogies in Herder’s historical writings. Furthermore, the paper sheds light on how Herder was able to account for the workings of prejudice and encounter the ethnocentric tendencies of Enlightenment philosophy of history. As a starting-point of historical understanding, analogical understanding has the function of opening up to enquiry a plurality of possible sets of analogies. By relying on experiences they are already familiar with, human beings are able to feel their way into different ways of life. Herder thus stresses the human ability to recognise oneself in different shapes. Furthermore, Herder states that human beings can project themselves into different human forms because of the malleability of human nature. As a consequence, the role of incommensurability in Herder’s philosophy is confined to providing a critical tool for delegitimising ethnocentric interpretations of historical and cultural others.},
  abstract_source = {openalex},
}

@article{reichert2023herder,
  author = {Reichert, Roey},
  title = {Herder and the Limits of Einf{\"u}hlung},
  journal = {International Journal of Philosophical Studies},
  year = {2023},
  volume = {31},
  number = {2},
  pages = {232--241},
  doi = {10.1080/09672559.2023.2250182},
  note = {
  CORE ARGUMENT: Reichert argues that Waldow's reconstruction of
  Herder's Einfühlung as "affective immersion" is broadly correct
  and aligns Herder with the Enlightenment rather than
  counter-Enlightenment tradition, but identifies three limits that
  Waldow does not address: (1) unlimited Einfühlung risks relativism
  and incoherence; (2) it can be reductive, eliminating rather than
  preserving difference; and (3) it is speculative and lacks an
  external truth criterion. The paper thus situates Herder's method
  within a critical epistemological debate rather than as a
  straightforward alternative to Enlightenment abstraction.

  RELEVANCE: Directly addresses the epistemological status of
  Einfühlung and the risks it runs as a method of historical
  understanding — the precise questions that any treatment of Herder's
  hermeneutics must confront. The critique is relevant to assessing
  whether Herder's claim that each epoch carries its standard within
  itself can be maintained without relativistic collapse.

  POSITION: Critical-epistemological position: Einfühlung has
  methodological virtues but also unremarked limits that need to be
  addressed.
  },
  keywords = {Einfühlung, epistemology, relativism, High},
  abstract = {ABSTRACT The fifth chapter of Experience Embodied is devoted to Herder’s theory of cognition and the epistemic merits of the capacity for ‘sympathy’, or ‘empathy’ – what Herder calls Einfühlung, and which Waldow renders more accurately as ‘affective immersion’. I situate Waldow’s reading of Herder as a member of the epistemological tradition within the debate on Herder’s relationship to the Enlightenment. Waldow’s reading, I contend, is congruent with the view of Herder as an Enlightenment, rather than anti-Enlightenment, figure. I focus on what Waldow calls ‘the problem of the conceivability of difference’ (Waldow 2020, 185) and how she charts Herder’s proposed method of Einfühlung and the need for ‘affective immersion’ to address this problem. However, I also identify three potential problems, which Waldow does not address, that can arise when Einfühlung is taken too far: the first is that it may lead to relativism, and thus to incoherence; the second is reductionism, which can eliminate, rather than draw attention to, difference – thereby achieving the opposite goal; while the third is that relying solely on Einfühlung as a method can lead us into error, as it is speculative and lacks an external truth criterion.},
  abstract_source = {s2},
}

@incollection{piirimaeeintro2020,
  author = {Piirimäe, Eva},
  title = {Introduction: Herder's Concepts of Empathy and Sympathy},
  booktitle = {Herder on Empathy and Sympathy},
  year = {2020},
  publisher = {Brill},
  pages = {1--33},
  doi = {10.1163/9789004426870_002},
  note = {
  CORE ARGUMENT: Piirimäe's introduction to the collected volume
  demonstrates that Einfühlung and Sympathie are not marginal
  rhetorical devices in Herder but permeate his entire philosophy,
  from aesthetics and poetics through historiography to his account
  of moral education. She distinguishes Herder's use of these
  concepts from later (especially phenomenological) uses and situates
  them within the tradition of mid-eighteenth-century moral philosophy
  (Hutcheson, Hume, Smith) as transformed by Herder's expressivist
  philosophy of language.

  RELEVANCE: Provides the conceptual map for understanding Einfühlung
  across Herder's oeuvre, which is necessary for assessing how it
  functions in his hermeneutics and philosophy of history specifically.
  The volume it introduces is the major recent collection on this topic.

  POSITION: Comprehensive survey of Einfühlung and Sympathie as
  pervasive categories across Herder's philosophy.
  },
  keywords = {Einfühlung, sympathy, moral-philosophy, High},
  abstract = {The Introduction outlines the central themes of the volume and discusses some of the different perspectives from which Herder’s ideas about empathy and sympathy can be approached. It sketches the historical provenance and limitations of viewing his ideas through the analytical lens of German historicism and seeks to embed the findings of the current volume in contemporary Herder scholarship. It also discusses, and invites further research about, Herder’s relationship to the ancient Stoic and early modern ideas about universal sympathy, oikeiôsis, and natural sociability. Finally, the Introduction provides an overview of the individual contributions and concludes by highlighting the contemporary relevance of Herder’s thinking about empathy and sympathy.},
  abstract_source = {openalex},
}

@article{solanki2022listening,
  author = {Solanki, Tanvi},
  title = {Listening to Difference: J.G. Herder's Aural Theory of Cultural Diversity in the Treatise on the Origin of Language (1772)},
  journal = {History of European Ideas},
  year = {2022},
  volume = {48},
  number = {7},
  pages = {930--947},
  doi = {10.1080/01916599.2022.2064603},
  note = {
  CORE ARGUMENT: Solanki argues that Herder's Treatise on the Origin
  of Language develops an "aural theory of cultural diversity" — a
  model in which listening attentively to the sounds and phonological
  structures of diverse languages discloses genuine cultural
  difference that Eurocentric visual and scriptural paradigms
  systematically suppress. The article uses Herder's critical readings
  of colonial travelogues to show that his philosophy of language is
  grounded in concrete attention to embodied, situated listening
  practices rather than abstract linguistic universalism.

  RELEVANCE: This article offers an unusual but productive reading of
  the Treatise, connecting Herder's philosophy of language directly
  to the methodological problem of understanding cultural difference
  — the same problem that his Einfühlung addresses in the context of
  historical understanding. It also shows the Treatise's engagement
  with colonial encounter, broadening the context for interpreting
  Herder's cultural particularism.

  POSITION: Postcolonial-inflected reading of Herder's language
  philosophy as grounded in embodied, attentive listening to cultural
  difference.
  },
  keywords = {philosophy-of-language, cultural-diversity, Treatise-on-Language, Medium},
  abstract = {ABSTRACT In this article, I develop the concept and practice of ‘listening to difference,’ examining J.G. Herder’s aural theory of cultural diversity as primarily worked out in the ‘Treatise on the Origin of Language’ (1772). I examine the sources Herder critiqued to outline his aural theory of linguistic and cultural difference, which have thus far only been summarily mentioned if at all in scholarship despite the prominence of the ‘Treatise’ in intellectual history and philosophy. These sources comprise the travelogues of seventeenth- and early eighteenth-century French scientists, mathematicians, diplomats, and Jesuit missionaries who described the inadequacy of Romanized orthography to accurately transcribe the sounds and pronunciations of the indigenous peoples they encountered throughout the Americas, Thailand, and China. Herder’s critical readings of travelogues showcased the unintended failures and interruptions in European colonial practices of listening. I argue that it was the French travellers’ failure to erase difference, to transform it into identity or, in other words, into a universalist monolingualism, which produced a consciousness of cultural and linguistic difference, even if repressed. The sounds of the spoken indigenous languages exposed the limits of the paradigms of Catholic and European linguistic classification. Instead, the exemplary technologies for preserving difference in scriptural and listening practices were for Herder the Hebrew alphabet and the oral transmission of poetry in ancient and Indigenous cultures. Listening to difference, as I define it, involves an openness to listening to the voices and sounds of the othered by listeners who recognize their distinct situated, embodied positionalities. It offers alternate possibilities to conceive of human diversity as continually in formation and not as a static or progressive hierarchy.},
  abstract_source = {s2},
}

@article{castro2025forgotten,
  author = {Castro, Paulo Alexandre e},
  title = {The Forgotten View of the Origin of Language: The Legacy of Herder's Philosophy},
  journal = {Conatus},
  year = {2025},
  volume = {10},
  number = {1},
  pages = {73--85},
  doi = {10.12681/cjp.37087},
  note = {
  CORE ARGUMENT: Castro reconstructs Herder's four natural laws of
  language in the Treatise and argues that the Treatise anticipates
  key themes in contemporary philosophy of mind and language — in
  particular, the constitutive role of reflection (Besonnenheit) and
  the priority of audition — while remaining neglected in current
  discussions that prefer later German idealist accounts. The article
  urges a recovery of Herder's naturalistic-anthropological approach
  to the emergence of language as a distinctive philosophical
  contribution.

  RELEVANCE: Provides a recent exposition of the philosophical content
  of the Treatise on the Origin of Language, the text that grounds
  Herder's account of the dependence of thought and understanding on
  linguistic-cultural particularity; useful for the project's section
  on how the Treatise supports Herder's hermeneutical methodology.

  POSITION: Herder as anticipating contemporary naturalistic philosophy
  of mind and language; recovery of the Treatise as a neglected
  contribution.
  },
  keywords = {Treatise-on-Language, philosophy-of-mind, naturalism, Medium},
  abstract = {The question about the origin of language marked modernity with approaches that still echo in contemporary thinkers. This is the case with Herder’s Treatise on the Origin of Language. The question with which Herder opens the essay is significant and expresses well the fundamental problem that marked the philosophical intentions of the 18th century, namely: “Were human beings, left to their natural abilities, able to invent language for themselves?” Forgetting for a moment the implicit reference to God that continued to mark historically the philosophical narratives, it is important to focus the question on the appearance of language. In this sense, the philosopher’s essay is not limited to hypotheses about the emergence of language, or rather, about the founding characteristics of language, but it consolidates it in the anthropological, sociological and even biological horizon from which it allows the understanding of human nature and condition. The enunciation of the four natural laws and the narrative of justification that the philosopher elaborates on reveals a strong potential to understand the phenomenon of language and the human mind. This essay seeks, first, to explain Herder’s theses; second, based on this explanation, see in what sense his approach allows us to understand the phenomenon of the origin and formation of language; and finally, to understand the scope of his work with regard to language and mind, that is, to seek to determine its legacy in contemporary philosophy, namely with regard to the understanding of the human mind. Regarding the latter, it is important to mention two essential points to understand the importance of Herder’s thought for the understanding of the human mind: the mention of reflection as an inner thought and hearing as a fundamental characteristic for the development of language. It is all these questions that this essay seeks to address.},
  abstract_source = {s2},
}

@article{forster2005schleiermacher,
  author = {Forster, Michael N.},
  title = {Schleiermacher's Hermeneutics: Some Problems and Solutions},
  journal = {The Harvard Review of Philosophy},
  year = {2005},
  volume = {13},
  number = {1},
  pages = {100--122},
  doi = {10.5840/harvardreview20051315},
  note = {
  CORE ARGUMENT: Forster examines several central features of
  Schleiermacher's hermeneutics — including the hermeneutic circle,
  the psychological method, and the role of divination — and argues
  that Schleiermacher significantly advanced the theory of
  interpretation he inherited from Herder while also introducing some
  philosophical difficulties (especially around the psychological
  method's reliance on direct introspective access to an author's
  mental states) that later hermeneutic theory has struggled to resolve.

  RELEVANCE: Directly relevant to the project's treatment of Herder's
  place in the hermeneutic tradition, since it shows exactly which
  features of Herderian hermeneutics Schleiermacher preserved,
  transformed, and which problems he introduced — thus mapping the
  transition from Herder to the canonical figure most often cited as
  the "founder" of modern hermeneutics.

  POSITION: Comparative analysis: Schleiermacher as indebted to
  Herder but also as introducing problematic innovations.
  },
  keywords = {Schleiermacher, hermeneutics, historical-reception, Medium, INCOMPLETE, no-abstract}
}

@article{stueber2012understanding,
  author = {Stueber, Karsten R.},
  title = {Understanding Versus Explanation? How to Think about the Distinction between the Human and the Natural Sciences},
  journal = {Inquiry},
  year = {2012},
  volume = {55},
  number = {1},
  pages = {17--32},
  doi = {10.1080/0020174x.2012.643621},
  note = {
  CORE ARGUMENT: Stueber reconstructs the methodological debate about
  Verstehen (understanding) as the distinctive method of the human
  sciences, tracing it from Droysen and Dilthey through to contemporary
  philosophy of mind and action. He argues that the debate cannot be
  settled by appeal to empathy or simulation alone, since understanding
  other agents requires both imaginative re-enactment and the application
  of rational interpretive norms — a position that calls for a more
  nuanced account than either strict Verstehen advocates or their
  naturalist critics typically provide.

  RELEVANCE: Provides the systematic philosophical context for
  assessing Herder's Einfühlung within the broader tradition of
  debate about understanding in the human sciences; useful for the
  project's discussion of how Herder's methodology anticipates and
  differs from later Diltheyan and post-Diltheyan accounts of
  Verstehen. Helps locate Herder's contribution within the
  Erklären/Verstehen distinction.

  POSITION: Analytical philosophy of social science perspective on
  the Verstehen tradition, situating Herder upstream of Dilthey.
  },
  keywords = {Verstehen, human-sciences, Dilthey, Low},
  abstract = {Abstract This essay will argue systematically and from a historical perspective that there is something to be said for the traditional claim that the human and natural sciences are distinct epistemic practices. Yet, in light of recent developments in contemporary philosophy of science, one has to be rather careful in utilizing the distinction between understanding and explanation for this purpose. One can only recognize the epistemic distinctiveness of the human sciences by recognizing the epistemic centrality of reenactive empathy for our understanding of rational agency, that is, by emphasizing the psychological component in the concept of understanding that nineteenth-century philosophers like Droysen, in contrast to twentieth-century hermeneutic philosophers, still acknowledged. In addition, the essay will show in detail that merely pointing to the fact that narratives have a cognitive function in the domain of the human sciences, as is common among philosophers of history, does not provide us with a sufficient demarcation criterion for distinguishing between the human and natural sciences. Notes 1. For various aspects of the historical debate about the distinction between understanding and explanation see the essays in Feest (Citation2010). 2. For a succinct summary of the empiricist critique of the concept of understanding, see also Abel (Citation1948). 3. For an early exception to the general low regard of understanding in analytic philosophy of science, see Friedman (Citation1974). 4. To be fair, Mink seems at times a bit ambiguous about the claim of whether or not the configurational mode of comprehension is unique to the human sciences or whether it can also be found in some natural sciences like biology (see Mink, Citation1998, p. 130). 5. In contrast, David Velleman (Citation2003) suggests that the essence of a narrative lies in its ability to initiate and resolve structured cadences of emotions in the audience. Narrative understanding is achieved by our ability to relate the events in the story to a "familiar pattern of how things feel". I tend to agree with Carroll (Citation2007) that reference to such emotional cadences only allows us only to distinguish between interesting or boring narratives (see also Currie, 2010, Ch. 2). Nevertheless, it is an interesting question why it is that those narratives that resonate with us emotionally seem to be particularly interesting to us, why it is that we find those stories particularly important to write down or important to share with others. I suspect that narratives resonate emotionally with us for two reasons: First, it has to do with the fact that narratives invite us to take up the perspectives of the agents depicted in the narrative. Second, they resonate because they depict the actions of others in a morally salient manner activating our own moral judgment and moral emotions. Unfortunately, I do not have the space to address this important question here. It will have to wait for another occasion. 6. For a discussion of MacIntyre's view see also the insightful remarks by Uebel (this issue & forthcoming). 7. This should however not be understood as implying that I adopt a non-causal account of reasons. Au contraire, I continue to conceive of reasons as causes. See my forthcoming "Explaining human agency: Reasons, causes, and the first person perspective". 8. We thus experience a case of imaginative resistance. For a more detailed analysis of this phenomenon see Stueber (Citation2011). 9. The argument that I have outlined here does have obvious applications for a defense of simulation theory against objections by so-called narrativist positions in the theory of mind. For a brief outline of that position, see particularly Gallagher and Hutto (Citation2008). I have concentrated here on the topic of narratives as it has been discussed mainly in the philosophy of history, but not only for reasons of space. I also find that philosophers of history have been more specific about how exactly they conceive of the nature of narratives and their epistemic functions. I have directly addressed the narrativist challenge in contemporary theory of mind in Stueber, in press a & b. 10. Among twentieth-century philosophers of history, R. G. Collingwood and his follower William Dray constitute the exception in this respect. For my interpretation of Collingwood see Stueber (Citation2002). 11. This article has benefitted from discussions at the conference on Current Topics in the Philosophy of Human Sciences (TU Berlin, 2010), the meeting of the Society for the Philosophy of History at the APA Pacific Division conference (San Francisco, 2010) and the conference of the MacIntyre Society (Providence College, 2011). I also would like to thank Uljana Feest for her helpful comments on the penultimate draft.},
  abstract_source = {openalex},
}
