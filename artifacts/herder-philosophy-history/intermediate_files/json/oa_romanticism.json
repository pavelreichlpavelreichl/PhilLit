    {
      "openalex_id": "W4405676867",
      "doi": "10.17132/2377-231x.1281",
      "title": "Secular Formations of Sacred Music: Schleiermacher, Romanticism, and Devotional Media in Germany",
      "authors": [
        {
          "name": "Desmond Sheehan",
          "openalex_id": "A5075532771",
