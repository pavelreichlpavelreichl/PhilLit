    {
      "openalex_id": "W4256068122",
      "doi": "10.18574/nyu/9780814741153.001.0001",
      "title": "The Net Effect",
      "authors": [
        {
          "name": "Thomas Streeter",
          "openalex_id": "A5005141021",
