    {
      "openalex_id": "W2411679421",
      "doi": "10.17161/ygas.v37i.19067",
      "title": "German Intellectual History and American Romanticism: Spirit, Nature Philosophy, and the Occult",
      "authors": [
        {
          "name": "Patrick Labriola",
          "openalex_id": "A5017354529",
          "institutions": [
