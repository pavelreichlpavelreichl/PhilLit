    {
      "openalex_id": "W1932287049",
      "doi": "10.1007/s10739-015-9410-y",
      "title": "Suppressing Synonymy with a Homonym: The Emergence of the Nomenclatural Type Concept in Nineteenth Century Natural History",
      "authors": [
        {
          "name": "Joeri Witteveen",
          "openalex_id": "A5040526481",
