@misc{gregor1988kants,
    author = "Gregor, Mary",
    title = "Kant's Theory of Property",
    year = "1988",
    note = {CORE ARGUMENT: Gregor works through Kant's derivation of property from the postulate of practical reason with regard to external objects, tracing how Kant moves from "intelligible" (as opposed to merely physical) possession to the claim that a rightful property regime is possible only under a general, omnilateral will rather than through any individual's unilateral act of taking. RELEVANCE: SEP's own "Property and Contract Right" section names this "a classic exposition of Kant's position," making it the natural reference point against which later revisionist readings (Westphal, Hasan, Messina) define themselves. It anchors the domain's core interpretive problem: how a one-sided act of acquisition can generate a duty binding on everyone else. POSITION: Sympathetic reconstruction of Kant's own derivation of property from practical reason, rather than a critique of it.},
    keywords = "property, postulate-of-practical-reason, unilateral-will, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy," section 5 (Property and Contract Right): "The main text of the Doctrine of Right begins with a discussion of property, showing the importance of this right for the implementation of the innate right to freedom. (A classic exposition of Kant's position is Gregor 1988.)"}
}

@misc{shell1978kants,
    author = "Shell, Susan Meld",
    title = "Kant's Theory of Property",
    year = "1978",
    note = "CORE ARGUMENT: An early and much-discussed reading of Kant's property doctrine that provoked a direct published exchange (Riley's response, and Shell's rejoinder, both in the same journal within a year), establishing property, rather than the categorical imperative alone, as an independent locus of dispute in Kant's political philosophy. RELEVANCE: Represents the opening of the modern English-language secondary literature on Kantian property theory that Gregor, Baynes, and later authors continue to engage; useful for tracing how the field's terms of debate (unilateral will, the postulate, provisional possession) were first set. POSITION: Foundational, historically formative reading of Kant's property doctrine, distinct from but complementary to Gregor's later treatment.",
    keywords = "property, history-of-scholarship, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "DESCENDANT OF SCOTSMEN OF the sort who were to set up trade in America, Kant might have been a New World merchant. Instead, Kant's ancestors chose to settle in the busy Prussian port of Konigsberg. From this spot Kant never ventured, but from it he could claim to be a citizen of the world. Konigsberg provided Kant a singularly cosmopolitan perch from which to see past his semi-feudal surroundings to revolutionary political and philosophic developments beyond. Kant is reported especially to have enjoyed the company of Kbnigsberg's thriving merchants, who, bringing news of the latest developments abroad, must have had special praise for the new economic thought then gaining prominence in Scotland and France. Kant's own writings reveal his early and enthusiastic familiarity with Adam Smith and the Physiocrats long before they were read widely in Germany. A self-proclaimed world trader in ideas, Kant was no businessman. Forced to support himself and a host of relatives on the precarious stipend of a Privatdozent, he was also no stranger to the pangs of financial instability. Although the economic ferment of Konigsberg did not enrich Kant materially, it may well have contributed to the economic model which (as few critics have noted) informs his early philosophic enterprise. Kant began his academic career as a philosopher of nature. Schooled in the rationalism of Leibniz and Wolff which dominated the Prussian",
    abstract_source = "openalex"
}

@misc{baynes1989kant,
    author = "Baynes, Kenneth",
    title = "Kant on Property Rights and the Social Contract",
    year = "1989",
    note = "CORE ARGUMENT: Baynes argues that Kant's consent to the social contract is grounded not in rational self-interest, prudence, or a natural right to self-preservation and absolute property, but in a moral obligation to institutionalize -- and thereby render peremptory -- property rights that in the state of nature possess only provisional status. He traces Kant's own earlier commitment to a labor theory of property and explains the basis for its subsequent rejection in the Rechtslehre. RELEVANCE: Directly addresses the key question of how Kant's account diverges from Locke's labor-mixing theory, situating Kant's alternative within (and against) the broader social-contract tradition rather than treating property as a self-standing topic. POSITION: Interprets Kantian property as constituting a genuine alternative to Lockean natural-rights theory within contract theory, rather than a deficient variant of it.",
    keywords = "property, social-contract, Locke-comparison, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Journal Article Kant on Property Rights and the Social Contract Get access Kenneth Baynes Kenneth Baynes State University of New York Stony Brook Search for other works by this author on: Oxford Academic PubMed Google Scholar The Monist, Volume 72, Issue 3, 1 July 1989, Pages 433–453, https://doi.org/10.5840/monist198972319 Published: 09 December 2014",
    abstract_source = "openalex"
}

@misc{hodgson2010property,
    author = "Hodgson, Louis-Philippe",
    title = "Kant on Property Rights and the State",
    year = "2010",
    note = {CORE ARGUMENT: Hodgson reconstructs the central claim of Kant's political philosophy that rational agents sharing a territory can justifiably be forced to live under a state, i.e., that they have a duty of right to leave the state of nature. He argues that this cannot be established by showing merely that the state promotes security or prosperity; Kant must instead show that human beings living side by side actually need a state in order to be free at all. RELEVANCE: Supplies a rigorous statement of exactly the "obligation of right, not merely prudence" argument the domain's key questions ask about, and does so by tying it specifically to property rather than to political authority in general. POSITION: Defends the necessity-of-the-state argument as a freedom-based (not merely welfare-based) claim, aligning with Varden's non-voluntarist reading while focusing specifically on property.},
    keywords = "property, state-of-nature, civil-condition, duty-to-exit, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The central claim of Kant's political philosophy is that rational agents sharing a territory can justifiably be forced to live under a state; they have, in Kant's words, aduty of rightto leave the state of nature. Perhaps something along these lines is entailed by any theory of state legitimacy, but the point raises special difficulties for Kant. He believes that rational agents have aright to freedom; that is, he believes that a rational agent's external freedom - her ability to set and pursue ends for herself without being subject to the choices of others - can justifiably be restricted only for the sake of external freedom itself. To establish that human beings can be forced to join a civil condition, it will therefore not do to show that the state promotes security, prosperity or any other such value: Kant has to show that human beings living side by side need a state to befree.",
    abstract_source = "openalex"
}

@misc{hasan2018provisionality,
    author = "Hasan, Rafeeq",
    title = "The provisionality of property rights in Kant's Doctrine of Right",
    year = "2018",
    abstract = "I criticize two ways of interpreting Kant's claim that property rights are merely 'provisional' in the state of nature. Weak provisionality holds that in the state of nature agents can make rightful claims to property. What is lacking is the institutional context necessary to render their claims secure. By contrast, strong provisionality holds that making property claims in the state of nature wrongs others. I argue for a third view, anticipatory provisionality, according to which state of nature property claims do not wrong others, but anticipate a condition in which the authority to make such claims can no longer be unilaterally determined.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Hasan rejects both standard readings of provisional right -- "weak" provisionality (claims are rightful but insecure) and "strong" provisionality (state-of-nature claims wrong others) -- in favor of "anticipatory provisionality": state-of-nature property claims do not wrong anyone, but they anticipate a future condition in which the authority to make such claims can no longer be fixed unilaterally. RELEVANCE: Reframes the domain's central puzzle (how can a unilateral act bind others?) by relocating the wrong-making feature from the act of acquisition itself to the unilateral character of its authority, offering a distinct middle path between the "state of nature is unjust" and "state of nature is merely insecure" readings. POSITION: A third, mediating position in the weak/strong provisionality debate that has become a standard reference point in subsequent literature (Messina, Tomassini).},
    keywords = "property, provisional-right, state-of-nature, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{messina2019provisionality,
    author = "Messina, J. P.",
    title = "Kant's Provisionality Thesis",
    year = "2019",
    abstract = "I argue that Kant's mature political philosophy entails the provisionality thesis. The provisionality thesis asserts that in a world like ours, populated with beings sufficiently like us, acquired rights (rights to external objects of choice, including property, sovereignty and territory) are necessarily provisional. I motivate the standard view, which restricts the notion of provisional right to the state of nature and the transition from the state of nature to the civil condition. I then provide two textual arguments against it. I conclude by reflecting on the normative implications of the provisionality thesis, arguing that they are more modest than has been formerly appreciated.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Against the "standard view" that confines provisional right to the state of nature and the moment of transition into civil society, Messina argues textually that all acquired rights (property, sovereignty, territory) remain provisional even within a civil condition, given beings "sufficiently like us." He then argues the normative implications of this broader provisionality thesis are more modest than commonly assumed. RELEVANCE: Extends the domain's central debate about provisional versus peremptory right beyond the state-of-nature transition itself, bearing on how permanently "concluded" property and sovereignty actually are once a state exists. POSITION: A revisionist expansion of provisionality against the "standard," transition-limited reading shared by much of the field.},
    keywords = "property, provisional-right, peremptory-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{messina2020postulate,
    author = "Messina, J. P.",
    title = "The postulate of private right and Kant's semi-historical principles of property",
    year = "2020",
    abstract = "Whereas several commentators have held that Kant's argument for the postulate of private right fails insofar as it begs the question, I argue here that this criticism misses the mark. Critics have erroneously supposed that the postulate is designed to secure a right to a system of private property. In fact, Kant's ambitions were more modest: to show that someone (be it an individual, a community, or a state) must be capable of enjoying dominion over external objects of choice. Understood this way, Kant's argument does not beg the question. Rather, it establishes clearly that freedom requires human dominion over objects, a fact that not all parties to debates over property have recognized. In response to the objection that my interpretation leaves Kant's account problematically indeterminate, I argue that the question of what system of property is justified cannot be settled from the armchair, independently of the history of acquisition.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Messina defends Kant's postulate of private right against the charge of question-begging by arguing that it aims only to establish that some agent (individual, community, or state) must be able to exercise dominion over external objects -- not to secure any particular system of private property. What system of property is actually justified, he argues, cannot be settled a priori and depends on the history of acquisition. RELEVANCE: Bears directly on the "deduction of property from practical reason" question at the center of this domain, and complicates simple readings of the postulate as directly generating individual private ownership. POSITION: A defensive, modest-reading reconstruction of the postulate against both Westphal-style usufruct critics and readers who take the postulate to beg the question in favor of private property.},
    keywords = "property, postulate-of-practical-reason, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{tomassini2023property,
    author = "Tomassini, Fiorella",
    title = "Property and the Will: Kant and Achenwall on Ownership Rights",
    year = "2023",
    abstract = "Abstract This article examines Kant's theory of property through a comparative analysis of Gottfried Achenwall's justification of ownership rights. I argue that at the core of Achenwall's and Kant's understanding of ownership rights lies the idea that rights are to be acquired through a juridical act (factum iuridicum, rechtlichen Act) of the will. However, while Achenwall thinks of this act as emerging from a private will, Kant holds that rights and obligations can only be brought about by an act of the general will. By contrasting these two views, I aim to illuminate one of the main features of Kant's theory of property, namely, that ownership rights are only possible in a rightfully constituted state. I conclude with a suggestion regarding Kant's view of the notion of 'provisional' possession in the state of nature.",
    abstract_source = "semantic\_scholar",
    note = "CORE ARGUMENT: Comparing Kant to his acknowledged source Gottfried Achenwall, Tomassini shows both thinkers ground ownership in a juridical act of will, but Achenwall locates that act in the private will of the acquirer while Kant insists it must be an act of the general (omnilateral) will -- which is only possible within a rightfully constituted state. RELEVANCE: Illuminates the historical-textual source of Kant's unilateral/ omnilateral will distinction by tracing it against the natural-law textbook (Achenwall's Ius Naturae) Kant lectured from, giving the domain's central conceptual contrast a concrete comparative anchor. POSITION: A source-critical, comparative reading that reinforces the mainstream view that Kantian ownership is only possible in a civil condition, while enriching it with Achenwall's alternative.",
    keywords = "property, Achenwall, general-will, provisional-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{slenzok2025duty,
    author = "Slenzok, Norbert and Trzcionka, Patryk",
    title = "Kant and the Duty to Stay in the State of Nature",
    year = "2025",
    abstract = "The paper tackles the question as to whether Kant has successfully substantiated his claim that there exists a moral and juridical duty to leave the state of nature. Our thesis is that he has not. In the first step, it is demonstrated that Kant's concept of provisional ownership is a logical impossibility. Thus, property rights themselves cannot generate the duty to submit to the state. The only way to argue for the duty to exit statelessness that the Kantian is left with is therefore to conceive of that duty as implied directly by the right to freedom. Yet, one may plausibly argue that at the conceptual level, public law runs afoul of Kant's notion of freedom to a greater degree than private law does. Therefore, in virtue of the innate right to freedom, a prima facie duty arises to stay in the state of nature.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Slenzok and Trzcionka contend that Kant fails to substantiate the duty to leave the state of nature. They first argue that "provisional ownership" is a logical impossibility, so property itself cannot generate the duty to submit to a state; then, turning to the innate right to freedom as the only remaining ground for the duty, they argue public law in fact constrains freedom more than private law does -- yielding, if anything, a prima facie duty to stay in the state of nature. RELEVANCE: Directly inverts the domain's near-consensus reading (shared by Hodgson, Varden, and Hasan) that leaving the state of nature is an obligation of right rather than mere prudence, making it essential for presenting the debate as genuinely contested rather than settled. POSITION: A dissenting, critical position against the mainstream "duty to exit" reading; the most recent and most direct challenge to that consensus found in this search.},
    keywords = "state-of-nature, duty-to-exit, provisional-right, dissenting, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{varden2008nonvoluntarist,
    author = "Varden, Helga",
    title = "Kant's Non-Voluntarist Conception of Political Obligations: Why Justice is Impossible in the State of Nature",
    year = "2008",
    note = {CORE ARGUMENT: Varden argues that Kant's grounds for political obligation are non-voluntarist: individuals are bound to enter and support the civil condition not because they consent (actually or hypothetically) but because justice -- meaning enforceable, reciprocally binding rights -- is conceptually impossible outside a shared, omnilateral legal authority. The state of nature is accordingly not unjust in the sense of violating rights, but simply devoid of the conditions under which rights and wrongs can be settled at all. RELEVANCE: Provides the domain's clearest and most frequently cited articulation of the claim, named explicitly in the search strategy, that the state of nature is "devoid of justice" rather than unjust, and that the transition to a civil condition is required by right rather than prudence. POSITION: The canonical non-voluntarist reading of Kantian political obligation, standing against both Hobbesian/Lockean consent-based readings and purely prudential readings of why one must leave the state of nature.},
    keywords = "state-of-nature, civil-condition, political-obligation, non-voluntarist, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In this paper, I present and defend Kant's non-voluntarist conception of political obligations. I argue that civil society is not primarily a prudential requirement for justice; it is not merely a necessary evil or a moral response to combat our corrupting nature or our tendency to act viciously, thoughtlessly or in a biased manner. Rather, civil society is constitutive of rightful relations among persons because only in civil society can we interact in ways reconcilable with each person's innate right to freedom. Civil society is the means through which we can rightfully interact even on the ideal assumption that no one ever succumbs to immoral temptation. Kant's account, therefore, provides ideal reasons to support the claim that voluntarism cannot be the liberal ideal of political obligations.",
    abstract_source = "openalex"
}

@misc{varden2010nonabsolutist,
    author = "Varden, Helga",
    title = {Kant's Non-Absolutist Conception of Political Legitimacy -- How Public Right 'Concludes' Private Right in the "Doctrine of Right"},
    year = "2010",
    note = {CORE ARGUMENT: Varden argues that public right does not merely supplement or protect an already-complete system of private right; rather, it "concludes" private right, meaning private rights remain indeterminate and incomplete claims until a public, omnilateral authority renders them determinate and enforceable. Political legitimacy is accordingly non-absolutist: it is conditioned on the state's actually performing this concluding function. RELEVANCE: Gives the clearest available statement of the private-right/ public-right architecture that structures the whole of this domain, directly matching the search strategy's expected coverage of "how the private right/public right distinction" works in the Doctrine of Right. POSITION: A structural, architectural reading of the Rechtslehre in which private and public right are conceptually interdependent rather than sequential or merely instrumental.},
    keywords = "private-right, public-right, civil-condition, architecture, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Contrary to the received view, I argue that Kant, in the “Doctrine of Right”, outlines a third, republican alternative to absolutist and voluntarist conceptions of political legitimacy. According to this republican alternative, a state must meet certain institutional requirements before political obligations arise. An important result of this interpretation is not only that there are institutional restraints on a legitimate state's use of coercion, but also that the rights of the state (‘public right’) are not in principle reducible to the rights of individuals (‘private right’). Thus, for Kant, political obligations are intimately linked to the existence of a certain kind of republican institutional framework.",
    abstract_source = "openalex"
}

@misc{varden2024leaving,
    author = "Varden, Helga",
    title = "Leaving the State of Nature. Strengths and Limits of Kant's Transformation of the Social Contract Tradition",
    year = "2024",
    note = {CORE ARGUMENT: Revisiting the "duty to exit" thesis she first defended in 2008, Varden here explicitly assesses both the strengths and the limits of Kant's transformation of social-contract theory in grounding the obligatory transition out of the state of nature, engaging more recent objections to the standard non-voluntarist reading. RELEVANCE: A recent (2024), self-critical restatement of the central "obligation of right, not prudence" argument that the key questions ask about, useful for showing how the debate has developed since Varden's original 2008 article and Hodgson's 2010 piece. POSITION: A qualified defense-with-revisions of the non-voluntarist "duty to exit" position, situated to respond to newer critiques such as Slenzok and Trzcionka (2025).},
    keywords = "state-of-nature, civil-condition, social-contract, duty-to-exit, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "I first outline how Kant’s ideal account of rightful external freedom transforms the social contract tradition as found in the works of Hobbes, Locke, and Rousseau, before proposing a way to see Kant’s two-layered non-ideal theory as complementing his ideal theory of rightful freedom. This enables us to envision a conception of rightful external freedom and of rightful human freedom in particular societies. These arguments also show us the importance of realizing that the four possible political conditions for Kant – anarchy, barbarism, despotism, and republic – are ideas of reason, which means that they are never perfectly realized. Hence, historical societies are not either in the state of nature or in civil society, and in historical republics, there are pockets of injustice or pockets devoid of justice that can only be captured by means of one of the three political ideas that are not constitutive of the republican legal-political framework.",
    abstract_source = "openalex"
}

@misc{ripstein2004authority,
    author = "Ripstein, Arthur",
    title = "Authority and Coercion",
    year = "2004",
    note = {CORE ARGUMENT: Ripstein's article-length statement (predating and later expanded into the "Three Defects in the State of Nature" and "Public Right" chapters of Force and Freedom) of the thesis that public, institutional authority is a necessary condition of each person's freedom, not merely a practical remedy for the inconveniences or insecurities of statelessness. As reviewers of the subsequent book put it, the argument turns on showing that the state of nature has defects that only legal and political institutions -- not better individual behavior -- can resolve. RELEVANCE: Supplies the influential, freedom-based (rather than security-based) version of the argument that a civil condition is required by right, complementing Varden's and Hodgson's independently argued versions of the same conclusion and giving the domain's "obligation of right, not prudence" theme its most widely cited advocate. POSITION: A freedom-as-independence-based argument for the necessity of public authority, foundational for Ripstein's later, more systematic treatment in Force and Freedom (already catalogued in Domain 1) and extensively discussed and contested by Valentini, Sangiovanni, and Ebels-Duggan in subsequent critical literature.},
    keywords = "authority, coercion, state-of-nature, civil-condition, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{ebelsduggan2012kants,
    author = "Ebels-Duggan, Kyla",
    title = "Kant's Political Philosophy",
    year = "2012",
    note = "CORE ARGUMENT: A survey article situating Kant's political theory within the social-contract tradition while marking its central departure from Hobbes and Locke: for Kant we have not merely a pragmatic reason but an obligation to exit the state of nature and found a state. The second half surveys points of live controversy, including how the innate right to freedom is supposed to support the postulate permitting acquisition of property and other private rights. RELEVANCE: Functions as a compact overview connecting the domain's property/acquisition material back to the innate right to freedom discussed in Domain 1, and explicitly frames the postulate-of-property question as one of the field's open controversies rather than a settled matter. POSITION: A synoptic overview rather than an original interpretive intervention, useful for orienting readers among the domain's competing positions.",
    keywords = "overview, state-of-nature, property, postulate, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{angell2019property,
    author = "Angell, Kim",
    title = "Property and Territorial Rights in Political Philosophy",
    year = "2019",
    howpublished = "Oxford Research Encyclopedia of Politics",
    abstract = "To have property rights over X is to have rights to determine, in some respect, what shall happen to X, for example a piece of land. To have territorial rights is to have rights to make, enforce, and adjudicate the law within a geographical area. Property and territorial rights thus seem closely related, and philosophical accounts reveal various interesting connections between these bundles of rights -- both in their nature and justification. A significant division, which we find in both old and new accounts -- of property as well as territory -- originates in the diverging political philosophies of John Locke and Immanuel Kant. Lockean accounts regard property and territorial rights as natural. People may acquire both without the prior existence of an adjudicating political authority. Kantian accounts, however, regard property rights as pure legal conventions. Non-existent outside civil society, they must be fully constructed by a state with territorial (jurisdictional) rights. Further divisions exist within Lockean and Kantian theories, and all the most prominent theories -- of property as well as territorial rights -- face significant unresolved philosophical challenges.",
    abstract_source = "semantic\_scholar",
    note = "CORE ARGUMENT: Angell's reference-work overview frames the Locke/Kant divide in political philosophy of property precisely along the axis this domain investigates: Lockean accounts treat property and territorial rights as natural and acquirable prior to political authority, while Kantian accounts treat property rights as pure legal conventions, non-existent outside civil society and requiring full construction by a territorially jurisdictional state. RELEVANCE: Offers a concise, explicitly comparative statement of exactly the Locke-versus-Kant contrast the domain's first key question asks about, and extends it usefully to territorial rights, a topic adjacent to but not covered elsewhere in this domain's selections. POSITION: A neutral, comparative reference overview rather than an advocacy piece for either the Lockean or Kantian camp.",
    keywords = "property, territorial-rights, Locke-comparison, overview, Medium, METADATA\_CLEANED: doi"
}

@misc{westphal1997kant,
    author = "Westphal, Kenneth R.",
    title = "Do Kant's Principles Justify Property or Usufruct?",
    year = "1997",
    note = {CORE ARGUMENT: Westphal argues, against the mainstream reading (including Gregor's), that Kant's postulate of practical reason regarding external objects supports only a right to use objects -- a form of usufruct -- rather than a full right of property in the strict, exclusive sense. RELEVANCE: Cited directly in SEP's "Property and Contract Right" section as a counterpoint immediately following the presentation of Kant's postulate, making it essential for representing the domain's minority but scholarly serious dissent from the standard "Kant justifies full property" reading. POSITION: A critical, minority position holding that Kant's argument is weaker than usually assumed -- justifying use-rights rather than ownership -- against Gregor, Hodgson, and the mainstream reading.},
    keywords = "property, usufruct, postulate-of-practical-reason, dissenting, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy," section 5 (Property and Contract Right), immediately after the exposition of the postulate of practical reason regarding external objects: "Westphal 1997 argues that Kant's claim supports only a right to use, not a right of property."}
}

@misc{wilson2004marriage,
    author = "Wilson, Donald",
    title = "Kant and the Marriage Right",
    year = "2004",
    note = {CORE ARGUMENT: Wilson examines how Kant's provision of a distinctive "marriage right" -- part of the third category of private right, the "right to a person akin to a right to a thing" -- initially seems difficult to reconcile with the general concern to secure external freedom of action that grounds the sole innate right and the rest of private right. RELEVANCE: Directly addresses how domestic right (marriage) fits within the architecture of private right, the third key question of this domain, by treating the tension between Kant's marriage doctrine and his own freedom-based foundations as a genuine interpretive problem rather than an embarrassing aside. POSITION: A close, sympathetic-but-critical reading that takes the marriage right seriously as systematic political philosophy rather than dismissing it as an idiosyncratic lapse.},
    keywords = "domestic-right, marriage, private-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract: The provision of a marriage right is a distinctive aspect of Kant's political philosophy and seems, initially, difficult to reconcile with the general concern with ensuring external freedom of action apparent in the universal principle of Right and the sole innate right said to follow from this principle. I claim that this provision can be regarded as consistent with this general focus and that Kant's treatment of issue suggests an interesting secular argument for the institution of marriage.",
    abstract_source = "openalex"
}

@misc{varden2012kantian,
    author = "Varden, Helga",
    title = "A Kantian Critique of the Care Tradition: Family Law and Systemic Justice",
    year = "2012",
    note = "CORE ARGUMENT: Varden develops a Kantian account of family law grounded in systemic (public) justice rather than in an ethics of care, arguing that household and family relations -- like property and contract -- require public, enforceable legal structures rather than being left to private moral sentiment alone. RELEVANCE: Extends the domain's private-right/public-right architecture (which Varden herself mapped in her 2010 article) specifically to domestic right and family law, directly engaging the key question of how household relations fit within the private right/civil condition framework. POSITION: A Kantian, systemic-justice-based critique of care-ethics approaches to family law, continuous with her broader non-voluntarist, civil-condition-centered reading of Kant's political philosophy.",
    keywords = "domestic-right, family-law, private-right, public-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Liberal theories of justice have been rightly criticized for two things by care theorists. First, they have failed to deal with private care relations’ inherent (inter)dependency, asymmetry and particularity. Second, they have been shown unable properly to address the asymmetry and dependency constitutive of care workers’ and care-receivers’ systemic conditions. I apply Kant’s theory of right to show that current care theories unfortunately reproduce similar problems because they also argue on the assumption that good care requires only virtuous private individuals. Giving up this assumption enables us to solve the problems regarding both private care relations and systemic injustice.",
    abstract_source = "openalex"
}

@misc{pascoe2024kantian,
    author = "Pascoe, Jordan",
    title = "A Kantian Theory of Employment, or How Domestic Right Structures Contemporary Work: A Reply to Williams",
    year = "2024",
    abstract = "This article shows how Kant's framework of domestic right can be understood as a model for modern employment law, a suggestion made by Garrath Williams in a commentary on Kant's Theory of Labour. I begin by exploring how Kant's historical context informed his account of labor relations and argue that he made three key innovations: the theorization of domestic right, the linkage of work and political standing, and the development of contract right to make sense of the material dependency and formal equality of 'free' contract workers. This account of contract-based work, however, sketches a dangerous 'fantasy' of free contract that we see echoed in contemporary defenses of the gig economy. I show that this argument is central to understanding Kant's evolving conception of the relationship between labor and citizenship, but I defend the claim that modern employment resembles domestic right more closely than contract right, by attending to both the formal structures of modern employment law and the lived experiences of professional employment in the digital age. Finally, I explore how drawing on the domestic model for understanding modern employment can help us to see the limits of both Kantian and contemporary accounts of the public good, by highlighting the ways that public law is deployed to formalize asymmetrical relations of dependence, to check their capacity for exploitation and domination.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Pascoe argues that modern employment relations resemble Kant's domestic right (the household relation of master and servant) more closely than his contract right, since domestic right's formal, hierarchical structure better captures the material dependency underlying supposedly "free" contract-based work than contract right's formal equality does. RELEVANCE: Directly shows how the third category of Kant's private right -- "right to a person akin to a right to a thing," which also covers marriage and parent-child relations -- continues to do interpretive work in contemporary Kantian scholarship, illuminating the domain's third key question about how domestic right, contract, and household relations fit together within private right. POSITION: A contemporary, labor-theoretic application of Kant's domestic right/contract right distinction, responding directly to and building on Williams's (2024) commentary.},
    keywords = "domestic-right, contract-right, labor, private-right, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{williams2024employment,
    author = "Williams, Garrath",
    title = "Employment, status, hierarchy: on Jordan Pascoe, Kant's Theory of Labour",
    year = "2024",
    note = "CORE ARGUMENT: Responding to Pascoe's Kant's Theory of Labour, Williams argues that her typology of paid work (drawn from Kant's categories of private right) underplays the tension between employment relations and Kantian innate equality, in part because it does not accommodate professional work and in part because it ignores the distinctively hierarchical legal form of employment -- which, he argues, brings employment closer to domestic right than to contract right. RELEVANCE: Forms a paired exchange with Pascoe (2024) that stages, in miniature, the domain's broader question of how domestic right and contract right are to be distinguished and applied, showing the distinction remains contested even among sympathetic Kantian interpreters. POSITION: A friendly-amendment critique of Pascoe's application of domestic right to employment, sharing her general framework while disputing its scope.",
    keywords = "domestic-right, contract-right, labor, private-right, Low, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article responds to Jordan Pascoe’s Kant’s Theory of Labour, with its twin focus on labour and intersecting forms of injustice. I open with some admiring remarks as to why her focus proves so fruitful and insightful. In the following sections, I offer a friendly amendment to Pascoe’s account, focussing on paid work in democratic states. Like Pascoe, I believe that employment relations stand in basic tension with Kantian innate equality. However, I also believe that her account underplays this tension. To make this case, I offer two reservations about the typology of paid work which Pascoe draws from Kant’s work. First, this typology does not accommodate professional work, although Kant considers this in several places. Second, it ignores the distinctive legal form of employment, which is hierarchical. This brings employment closer to Kant’s account of domestic right than to his account of contract. Assuming that employment hierarchies are essential to organising people’s social contributions, I suggest this hierarchy requires formal counterbalancing measures. From an intersectional perspective, such measures are especially important, as labour organisers everywhere have shown.",
    abstract_source = "s2"
}
