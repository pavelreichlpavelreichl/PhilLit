@misc{kant2006perpetualpeace,
    author = "Kant, Immanuel",
    editor = "Kleingeld, Pauline",
    title = "Toward Perpetual Peace and Other Writings on Politics, Peace, and History",
    year = "2006",
    address = "New Haven",
    note = {CORE ARGUMENT: Standard English-language collection of Kant's key writings on history and international politics, translated by David L. Colclasure, including "Idea for a Universal History with a Cosmopolitan Aim," "Conjectural Beginning of Human History," "Toward Perpetual Peace," excerpts from the Doctrine of Right, and Part 2 of "The Contest of the Faculties," with accompanying essays by Jeremy Waldron, Michael W. Doyle, and Allen W. Wood. RELEVANCE: Provides the primary-source basis for this entire domain; the texts collected here are the direct object of every secondary-literature debate catalogued in this bibliography (regulative vs. constitutive teleology, unsocial sociability, the guarantee of peace). POSITION: Primary source edition, not itself a position in the scholarly debate.},
    keywords = "primary-source, philosophy-of-history, cosmopolitanism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{yovel1980kant,
    author = "Yovel, Yirmiyahu",
    title = "Kant and the Philosophy of History",
    year = "1980",
    address = "Princeton",
    note = {CORE ARGUMENT: Argues that a "history of reason" is genuine and central to Kant's system, not a peripheral or merely popular appendage to the critical philosophy; traces how Kant's practical philosophy shifts toward treating the synthesis of morality and nature -- the highest good -- as an object of duty realized progressively in history. RELEVANCE: The foundational book-length treatment establishing that Kant's philosophy of history deserves systematic philosophical (not just exegetical) treatment; subsequent debates over the regulative vs. constitutive status of historical teleology (Kleingeld, Ypi, Allison) take Yovel's study as a reference point. POSITION: Robust reading -- treats the "history of reason" as doing substantive systematic work connecting theoretical, practical, and historical philosophy, rather than as a mere regulative heuristic.},
    keywords = "philosophy-of-history, teleology, highest-good, foundational, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{kleingeld2001nature,
    author = "Kleingeld, Pauline",
    title = "Nature or Providence? On the Theoretical and Moral Importance of Kant's Philosophy of History",
    year = "2001",
    number = "2",
    note = {CORE ARGUMENT: Clarifies and explains Kant's fluctuating use of the terms "Nature" and "Providence" in the historical essays, arguing that this terminological variation is symptomatic of a deeper and underappreciated fact: Kant's philosophy of history performs a function in both his theoretical and his practical philosophy simultaneously, not merely one or the other. RELEVANCE: Directly addresses whether Kant's historical teleology is a theoretical (quasi-metaphysical) claim or a practically oriented regulative device by showing the two functions are intertwined rather than exclusive -- reframing the standard either/or question posed in this domain's key questions. POSITION: Integrative reading that resists collapsing the theoretical/practical distinction cleanly onto the constitutive/regulative debate.},
    keywords = "philosophy-of-history, providence, regulative-idea, teleology, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Soulevant la question de la relation entre nature et providence dans la philosophie de l'histoire kantienne, l'A. montre que la preference de Kant pour le terme de providence dans «L'idee d'une histoire universelle» correspond au passage de la question theorique de l'ordre dans l'histoire a ne approche morale de l'histoire fondee sur le principe teleologique.",
    abstract_source = "openalex"
}

@misc{kleingeld2008historiography,
    author = "Kleingeld, Pauline",
    title = "Kant on Historiography and the Use of Regulative Ideas",
    year = "2008",
    number = "4",
    note = {CORE ARGUMENT: Examines Kant's methodological remarks in "Idea for a Universal History" against the background of the Critique of Pure Reason's account of regulative ideas, arguing that Kant's methodological approach -- treating history as a whole under a regulative idea that is grand in scope but epistemically modest and fallibilistic -- remains fruitful, even though the specific teleological model of history Kant builds on this method (nature's plan for humanity) cannot simply be appropriated today. RELEVANCE: The clearest direct answer in the literature to this domain's first key question: it explicitly distinguishes Kant's regulative methodology (defensible) from his substantive historical-teleological content (not defensible as such), giving a synthesis writer a sharp analytical tool for separating these two levels. POSITION: Regulative/deflationary reading -- historiographical regulative ideas are epistemically modest heuristics, not metaphysical or empirical claims about how history must unfold.},
    keywords = "regulative-idea, historiography, teleology, critical-epistemology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{oneill2008historical,
    author = "O'Neill, Onora",
    title = "Historical Trends and Human Futures",
    year = "2008",
    number = "4",
    note = {CORE ARGUMENT: Argues that Kant's "Idea for a Universal History" differs in deep ways from standard Enlightenment views of human history: although Kant agrees with contemporaries that unsocial sociability can drive human progress, he insists that we know too little about the actual trends of history to offer either a metaphysical defence or an empirical vindication of humanity's perfectibility or the inevitability of progress. On O'Neill's reading, Kant treats human progress as a practical assumption -- an Idea of Reason -- rather than a theoretical claim. RELEVANCE: Directly supports the regulative reading of this domain's first key question and explicitly connects the epistemic modesty of Kant's historical claims to the status of Ideas of Reason from the first Critique, providing a bridge to the critical-epistemology question (key question 3). POSITION: Regulative/deflationary reading -- progress is a practical assumption licensed by reason, not a theoretical or empirical thesis.},
    keywords = "regulative-idea, philosophy-of-history, progress, critical-epistemology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{honneth2007irreducibility,
    author = "Honneth, Axel",
    title = "The Irreducibility of Progress: Kant's Account of the Relationship between Morality and History",
    year = "2007",
    volume = "8",
    number = "1",
    note = {CORE ARGUMENT: Distinguishes "system-conforming" from "system-bursting" (unorthodox) versions of Kant's historical progress thesis, arguing that only the system-bursting version -- which treats history as a conflict-ridden, illusion-free learning process rather than a smooth teleological unfolding -- can confer contemporary philosophical meaning on Kant's philosophy of history. RELEVANCE: Offers a normatively engaged (rather than purely exegetical) reading of unsocial sociability's role in Kant's account of historical learning, useful for connecting this domain's mechanism question (unsocial sociability) to broader questions about what, if anything, remains defensible in Kant's progress thesis today. POSITION: Critical/revisionist reading that salvages a "system-bursting" version of Kantian progress against more harmonistic, providential readings.},
    keywords = "progress, unsocial-sociability, critical-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = {In the last thirty years of his life Kant was preoccupied with the question of whether or not the "signs of progress" could be elicited from the vale of tears of the historical process. In what follows I am interested in the question of what kind of meaning Kant's historico-philosophical hypothesis of progress can have for us today. In order to provide an answer to this question, I make a distinction between system-conforming and system-bursting, or unorthodox, versions of historical progress. This distinction is made in order to show that only system-bursting versions of progress can prompt us to confer contemporary meaning on Kant's philosophy of history as a learning process that is conflict ridden and without illusions.},
    abstract_source = "openalex"
}

@article{ypi2010natura,
    author = "Ypi, Lea",
    title = "Natura Daedala Rerum? On the Justification of Historical Progress in Kant's Guarantee of Perpetual Peace",
    journal = "Kantian Review",
    year = "2010",
    number = "2",
    note = {CORE ARGUMENT: Analyses the teleological argument justifying historical progress in the "Guarantee" section of "Toward Perpetual Peace," examining the controversies produced by Kant's claim that nature's teleology supports a providential development of humanity toward moral progress and a cosmopolitan political constitution, and assesses whether this argument can be justified on Kant's own critical terms. RELEVANCE: A central paper for this domain's second and third key questions -- it directly interrogates how nature's "guarantee" is supposed to underwrite both the emergence of states and eventual peace among them, and whether that guarantee is compatible with the moral agency Kant elsewhere insists is required for genuine progress. POSITION: Critically probes the coherence of the providential/guarantee argument, siding with a qualified regulative reading over a robust metaphysical one.},
    keywords = "guarantee-of-peace, teleology, unsocial-sociability, perpetual-peace, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = "This article analyses the teleological argument justifying historical progress in Kant's Guarantee of Perpetual Peace. It starts by examining the controversies produced by Kant's claim that the teleology of nature supports the idea of a providential development of humanity towards moral progress and the possibility of achieving a cosmopolitan political constitution. It further illustrates how Kant's teleological argument in Perpetual Peace needs to be assessed with reference to two systematically relevant issues: first, the problem of coordination linked to the necessity of realizing the ‘highest good’ as a historical end of practical reason, and secondly the problem of continuity posed by the temporal limitation of all individual efforts to cultivate moral dispositions. To illustrate the implications of both issues for the teleological argument in Perpetual Peace , the article draws attention to some important developments in Kant's analysis of teleology following the Critique of Judgment .",
    abstract_source = "openalex"
}

@book{ertl2020guarantee,
    author = "Ertl, Wolfgang",
    title = "The Guarantee of Perpetual Peace",
    year = "2020",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    note = {CORE ARGUMENT: Examines the "first addendum" of Kant's "Toward Perpetual Peace," addressing three questions about Kant's guarantee thesis: how the guarantor powers (nature, providence) interrelate; how there can be a guarantee of peace without undermining human freedom; and why there is a guarantee at all. Argues that Kant's conception of an interplay between human and divine rational agency, encompassing nature, is crucial: we are morally warranted in believing that the world's author intended the supreme (moral) good to accompany the natural order, and perpetual peace is the historical condition that enables the highest good's realization. RELEVANCE: The most sustained recent book-length treatment of nature's "guarantee" of peace and its relation to moral agency and hope -- directly targets this domain's fourth key question about the relation between nature's guarantee and moral agency/hope. POSITION: Robust reading that takes providence and the guarantee to be doing genuine argumentative work compatible with (rather than opposed to) Kantian freedom.},
    keywords = "guarantee-of-peace, providence, perpetual-peace, moral-agency, hope, High, METADATA\_CLEANED: doi",
    abstract = "This Element addresses three questions about Kant's guarantee thesis by examining the 'first addendum' of his Philosophical Sketch: how the guarantor powers interrelate, how there can be a guarantee without undermining freedom and why there is a guarantee in the first place. Kant's conception of an interplay of human and divine rational agency encompassing nature is crucial: on moral grounds, we are warranted to believe the 'world author' knew that if he were to bring about the world, the 'supreme' good would come about too. Perpetual peace is the condition that enables the supreme good to be realized in history.",
    abstract_source = "openalex"
}

@misc{flikschuh2007reason,
    author = "Flikschuh, Katrin",
    editor = "Bird, Graham",
    title = "Reason and Nature: Kant's Teleological Argument in Perpetual Peace",
    year = "2007",
    note = {CORE ARGUMENT: Organized around three questions -- Kant's practical political teleology, the relation between the demands of practical reason and "nature's will," and perpetual peace as the end of right -- the chapter examines how Kant's teleological argument in "Toward Perpetual Peace" is meant to function alongside, rather than substitute for, the demands of practical reason. RELEVANCE: A concise, widely cited overview essay directly addressing this domain's core methodological question of how nature's teleological "guarantee" relates to the practical-reason-based demands of right and morality that otherwise ground Kant's political philosophy. POSITION: Treats Kant's teleological argument as subordinate to and constrained by practical reason, favoring a regulative-practical rather than constitutive-metaphysical reading.},
    keywords = "teleology, perpetual-peace, practical-reason, regulative-idea, High, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "This chapter contains sections titled: I. Kant's Practical Political Teleology II. Demands of Practical Reason and Nature's Will III. Perpetual Peace as the End of Right",
    abstract_source = "openalex"
}

@misc{allison2009teleology,
    author = "Allison, Henry E.",
    editor = "Rorty, Am\'{e}lie Oksenberg and Schmidt, James",
    title = "Teleology and History in Kant: The Critical Foundations of Kant's Philosophy of History",
    year = "2009",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Situates the "Idea for a Universal History" within the broader architecture of Kant's critical philosophy, examining how the essay's teleological framework is grounded in -- and constrained by -- the critical epistemology developed elsewhere in Kant's system, rather than treating the historical essay as an ad hoc or pre-critical excursion. RELEVANCE: By a leading Kant scholar, this chapter most directly addresses this domain's third key question (the relationship between historical teleology and critical epistemology), arguing for continuity between the "Idea" essay's teleological method and Kant's broader critical framework. POSITION: Robust/integrative reading that ties the philosophy of history closely to the critical foundations of Kant's system, resisting treatment of the historical essays as merely occasional or popular writings.},
    keywords = "teleology, critical-epistemology, philosophy-of-history, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Although the title of Kant's essay Idea for Universal History with a Cosmopolitan Aim indicates its central theme, it reveals little or nothing about its underlying methodology and its connection with the emerging critical philosophy. Indeed, as far as the title is concerned, the only hint of a connection with the latter is provided by the inclusion of the term “Idea.” This is a technical term for Kant referring to concepts of reason, which, as distinct from concepts of the understanding, whose legitimate use is restricted to possible experience, involve the thought of an absolute totality or completeness that can never be met with in a possible experience and is, therefore, “transcendent” with respect to the latter. In the first Critique , Kant's appealed to the Platonic republic and a constitution that provides for “the greatest human freedom according to laws that permit the freedom of each to exist together with that of others ” as examples of such ideas (A 316/B 372–3); but his focus was on the “transcendental Ideas” (the soul, the world, and God), which arise from extending certain concepts of the understanding to the “unconditioned,” thereby producing the thought of a complete systematic unity. While illusory, in the sense that no real object corresponds to them, these Ideas nonetheless play an essential regulative role in guiding the understanding in its endemic search for unity in experience.",
    abstract_source = "openalex"
}

@misc{schneewind2009good,
    author = "Schneewind, J. B.",
    editor = "Rorty, Am\'{e}lie Oksenberg and Schmidt, James",
    title = "Good Out of Evil: Kant and the Idea of Unsocial Sociability",
    year = "2009",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Examines how Kant's notion of unsocial sociability is meant to explain the emergence of civil society and cultural development as the unintended by-product of antagonistic, self-interested, and vain human dispositions -- "good out of evil" -- situating this account within the broader tradition of unintended-consequences arguments (e.g., Adam Smith's invisible hand) while asking what is distinctively Kantian about it. RELEVANCE: A focused, book-length-collection treatment of exactly the mechanism named in this domain's second key question -- how unsocial sociability is supposed to justify both the emergence of the state and, by extension, eventual peace among states. POSITION: Explicates unsocial sociability as a naturalistic mechanism operating independently of moral motivation, while asking how much explanatory weight it can bear.},
    keywords = "unsocial-sociability, state-formation, philosophy-of-history, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "There is nothing so unsociable and so sociable as man: the one by his vice, the other by his nature. – Montaigne In the first three Propositions of his Idea for a Universal History with a Cosmopolitan Aim ( Idea ), Kant tells us that nature intends all natural human capacities to be developed to their fullest in the species, though not in the individual. Moreover humans are meant to provide, by their own efforts, whatever they enjoy of happiness and perfection (8:18–20). In the Fourth Proposition Kant lays out the means nature employs to bring about this result. It is what he calls the “unsocial sociability” ( ungesellige Geselligkeit ) of men. We have, he says, a “propensity to enter into society.” But we also have a “thoroughgoing resistance” to this tendency so that we are always liable to isolate ourselves and tear society apart (8:20). This seems an unfortunate combination of basic character traits, but Kant does not find it so. On the contrary, he sees in it the goad needed to make us overcome our natural laziness. We do not want to live solitary lives. But we find in ourselves a strong desire to have everything go as we want it to. We know we would resist this desire coming from others, so we expect the others with whom we want to live to resist our desire. The resistance stirs us to try to overcome it.",
    abstract_source = "openalex"
}

@misc{ferguson2015unsocial,
    author = "Ferguson, Michaele",
    editor = "Ellis, Elisabeth",
    title = "Unsocial Sociability: Perpetual Antagonism in Kant's Political Thought",
    year = "2015",
    note = "CORE ARGUMENT: Argues that unsocial sociability names a condition of perpetual antagonism that persists throughout Kant's political thought rather than being merely a developmental mechanism that is superseded once civil and cosmopolitan institutions are established -- antagonism remains a permanent structural feature of Kantian politics, not simply a spur that progress eventually leaves behind. RELEVANCE: Directly engages this domain's second key question by examining whether unsocial sociability's work is confined to explaining state formation or whether it continues to operate (and needs to be managed) even within and among established republican states striving for peace. POSITION: Reads unsocial sociability as a persistent structural feature of Kantian politics rather than a mechanism that is fully overcome by institutional progress.",
    keywords = "unsocial-sociability, state-formation, perpetual-peace, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{goldman2010antinomy,
    author = "Goldman, Avery",
    title = "An Antinomy of Political Judgment: Kant, Arendt, and the Role of Purposiveness in Reflective Judgment",
    year = "2010",
    number = "3",
    note = "CORE ARGUMENT: Examines the role of purposiveness in Kant's account of reflective judgment from the third Critique and its bearing on political judgment, engaging with Hannah Arendt's influential appropriation of Kant's aesthetic and teleological judgment for a theory of political judgment. RELEVANCE: Directly addresses this domain's third key question by tracing how the reflective, non-determining judgment central to the third Critique's account of purposiveness might ground -- or generate an antinomy within -- properly political forms of judgment, including judgments about historical progress. POSITION: Identifies a structural antinomy in extending third-Critique purposiveness to political judgment, engaging critically with the Arendtian reception of Kant.",
    keywords = "reflective-judgment, purposiveness, third-critique, political-judgment, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@book{ostaric2023critique,
    author = "Ostaric, Lara",
    title = "The Critique of Judgment and the Unity of Kant's Critical System",
    year = "2023",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Argues that Kant's Critique of Judgment is properly understood as completing his critical system: both aesthetic and teleological judgment indirectly exhibit the final end of reason -- the Ideas of the highest good and the postulates -- as if obtaining in nature. Relates this unifying reading to under-explored connections between Kant's aesthetics/teleology and his philosophy of history, philosophy of religion, and conception of autonomy. RELEVANCE: The most comprehensive recent monograph connecting the third Critique's reflective judgment directly to Kant's philosophy of history (including a dedicated chapter, per subsequent author-response literature, titled "Kant's Teleological Philosophy of History"), making it central to this domain's third key question. POSITION: Strongly integrative reading treating teleological judgment about history as continuous with -- rather than a departure from -- the systematic architecture unifying Kant's three Critiques.},
    keywords = "third-critique, teleology, reflective-judgment, critical-epistemology, philosophy-of-history, High, METADATA\_CLEANED: doi",
    abstract = "In this book, Lara Ostaric argues that Kant's seminal Critique of Judgment is properly understood as completing his Critical system. The two seemingly disparate halves of the text are unified under this larger project insofar as both aesthetic and teleological judgment indirectly exhibit the final end of reason, the Ideas of the highest good and the postulates, as if obtaining in nature. She relates Kant's discussion of aesthetic and teleological judgment to important yet under-explored concepts in his philosophy, and helps the reader to recognize the relevance of his aesthetics and teleology for our understanding of fine arts and genius, the possibility of pure judgments of ugliness, Kant's philosophy of history, his philosophy of religion, and his conception of autonomy. Ostaric's novel and thoroughly integrative presentation of Kant's system will be of interest not only to Kant scholars but also to those working in religious studies, art history, political theory, and intellectual history.",
    abstract_source = "s2"
}

@misc{formosa2014politics,
    editor = "Formosa, Paul and Goldman, Avery and Patrone, Tatiana",
    title = "Politics and Teleology in Kant",
    year = "2014",
    address = "Cardiff",
    note = "CORE ARGUMENT: Edited collection of essays examining the intersection of Kant's political philosophy and his account of teleology, bringing together scholars working on the third Critique, the philosophy of history, and Kant's theory of right to ask how teleological judgment informs and constrains Kantian political theorizing. RELEVANCE: A dedicated multi-author volume on precisely the intersection targeted by this domain (politics and teleology), useful to a synthesis writer as a single reference point for the range of positions on how teleological judgment bears on Kant's political thought. POSITION: Edited collection spanning multiple positions rather than advancing a single thesis.",
    keywords = "teleology, political-philosophy, third-critique, edited-volume, Medium, METADATA\_CLEANED: publisher, type:@book->@misc",
    abstract = "The fourteen essays in this volume, by leading scholars in the field, explore the relationship between teleology and politics in Kant’s corpus. Among the topics discussed are Kant’s normative political theory and legal philosophy; his cosmopolitanism and views on international relations; his theory of history; his theory of natural teleology; and the broader relationship between morality, history, nature, and politics. Politics and Teleology in Kant will be of interest to a wide audience, including Kant scholars; scholars and students working in moral and political philosophy, the philosophy of history, and political theory and political science; legal scholars; and international relations theorists.",
    abstract_source = "core"
}

@misc{zuckert2021loneliness,
    author = "Zuckert, Rachel",
    editor = "Wilford, Paul T. and Stoner, Samuel A.",
    title = "Loneliness and Ambiguity in Kant's Philosophy of History",
    year = "2021",
    note = {CORE ARGUMENT: Kant's most famous accounts of historical progress, driven by unsocial sociability, aim to address a Rousseauean concern about the evils brought about by "civilization." Kant sketches how the very impediments to sociability might bring about morally desirable ends over the course of history and later be redirected in less problematic ways (e.g., as trade competition). But Zuckert argues this account generates a new problem for the morally committed individual: loneliness -- since on Kant's account, history is driven by unsocial sociability, not by moral agency, the virtuous agent is structurally isolated from the very historical process that is supposed to vindicate her hopes. RELEVANCE: Directly addresses this domain's fourth key question by showing a tension between nature's guarantee (mediated through unsocial sociability) and individual moral agency -- the mechanism that supposedly justifies hope in progress does not operate through, and may even estrange, the moral agent's own virtuous action. POSITION: Critical reading that identifies an underappreciated psychological and moral cost (loneliness) in Kant's naturalistic account of historical progress.},
    keywords = "unsocial-sociability, moral-agency, hope, philosophy-of-history, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@article{cureton2018reasonable,
    author = "Cureton, Adam",
    title = "Reasonable Hope in Kant's Ethics",
    journal = "Kantian Review",
    year = "2018",
    volume = "23",
    number = "2",
    note = {CORE ARGUMENT: The most apparent obstacles to a just, enlightened, and peaceful social world are also, on Kant's view, nature's way of compelling us to realize those very ends: selfishness, rivalry, vanity, and self-conceit, along with the social inequalities they produce, drive human beings to perfect their talents, develop culture, approach enlightenment, and -- through the strife caused by unsocial sociability -- move toward justice, political equality, and the highest good. Cureton asks what to make of arguments that rely on such empirical assumptions and dubious claims about natural teleology while sitting uncomfortably with core commitments of Kant's ethics, and argues that they reveal an important insight about what a virtuous person may reasonably hope for. RELEVANCE: Reframes this domain's fourth key question (nature's guarantee and moral agency/hope) as a question in moral psychology: what can a Kantian agent, committed to virtue but reliant on nature's teleological "guarantee," coherently and reasonably hope for? POSITION: Reconstructive reading that salvages the moral-psychological core of Kant's hope-in-progress argument while acknowledging the dubiousness of its empirical and teleological premises.},
    keywords = "hope, unsocial-sociability, moral-agency, highest-good, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract The most apparent obstacles to a just, enlightened and peaceful social world are also, according to Kant, nature’s way of compelling us to realize those and other morally good ends. Echoing Adam Smith’s idea of the ‘invisible hand’, Kant thinks that selfishness, rivalry, quarrelsomeness, vanity, jealousy and self-conceit, along with the oppressive social inequalities they tend to produce, drive us to perfect our talents, develop culture, approach enlightenment and, through the strife and instability caused by our unsocial sociability, push us towards justice, political equality and the highest good. What are we to make of these arguments, which seem to rely on questionable empirical assumptions, invoke dubious claims about natural teleology and sit uncomfortably with fundamental aspects of Kant’s ethical framework? I suggest that the arguments reveal one of Kant’s deep and important insights about the moral life by partially describing what a good and virtuous person reasonably hopes for.",
    abstract_source = "openalex"
}

@misc{papish2024kants,
    author = "Papish, Laura",
    title = "Kant's Revised Account of Hope in Human Progress",
    year = "2024",
    number = "4",
    note = {CORE ARGUMENT: Kant remained committed throughout his life to the idea that we can justifiably hope humankind is progressing, but there are important changes in how he conceptualized this hope. Maps two underappreciated shifts in Kant's thinking between his final statement on the topic, the 1797 essay "An Old Question Raised Again," and his earlier accounts of hope in progress in the "Common Saying" essay and "Toward Perpetual Peace," and argues that the later account remedies problems present in the pre-1797 discussions. RELEVANCE: Shows that Kant's own position on the guarantee/hope relationship (this domain's fourth key question) was not static but developed, complicating any synthesis that treats "Kant's view" of historical hope as a single fixed doctrine across his career. POSITION: Developmental reading emphasizing a late revision in Kant's account of rational hope for progress.},
    keywords = "hope, progress, moral-agency, development-of-kants-thought, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Kant remained throughout his life committed to the idea that we can justifiably hope humankind is progressing. But there are important changes in how he conceptualized this hope. This paper maps out two underappreciated shifts in Kant's thinking between his final word on the subject, in his 1797 An Old Question Raised Again, and his accounts of hope in progress in earlier texts, including the Common Saying essay and Toward Perpetual Peace. The paper also shows that this new account remedies some problems with his pre-1797 discussions.",
    abstract_source = "s2"
}

@book{lenczewska2025kant,
    author = "Lenczewska, Olga",
    title = "Kant on the History and Development of Practical Reason",
    year = "2025",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Focuses on Kant's history of human reason -- his teleological vision of the past development of human rational capacities from their very emergence to Kant's own "age of Enlightenment." Connects Kant's speculative account of the very beginning of rationality, largely neglected in the scholarship, to his well-known theory of humankind's future progress, and argues that "Conjectural Beginning of Human History" is not tangential to Kant's critical philosophy but illuminates and complements it. RELEVANCE: The most sustained recent treatment specifically of "Conjectural Beginning of Human History," directly filling out this domain's focus on that text and connecting it to the "Idea for a Universal History" essay's forward-looking teleology. POSITION: Integrative reading arguing for continuity between Kant's speculative account of reason's origins and his critical philosophy, rather than treating "Conjectural Beginning" as a minor or merely literary exercise.},
    keywords = "conjectural-history, practical-reason, teleology, origins-of-reason, High, INCOMPLETE, no-abstract"
}

@misc{huseyinzadegan2019kants,
    author = "Huseyinzadegan, Dilek",
    title = "Kant's Nonideal Theory of Politics",
