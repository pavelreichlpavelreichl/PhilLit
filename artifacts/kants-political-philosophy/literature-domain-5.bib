@misc{byrd1989kants,
    author = "Byrd, B. Sharon",
    title = "Kant's Theory of Punishment: Deterrence in Its Threat, Retribution in Its Execution",
    year = "1989",
    note = {CORE ARGUMENT: Byrd argues against the traditional reading of Kant as a pure retributivist, showing that Kant's theory assigns deterrence a legitimate role in the threat of punishment (its general, legislative function, addressed to would-be offenders) while reserving strict retribution for the execution of punishment on the convicted individual. This threat/execution distinction lets Kant's theory accommodate both the principle of equality and a rationale grounded in securing citizens' freedom. RELEVANCE: This is the pivotal paper that reoriented the entire secondary literature on Kant's theory of punishment away from a purely retributivist reading toward "mixed theory" interpretations; nearly every subsequent paper in this domain positions itself relative to Byrd's threat/execution distinction. POSITION: Founding statement of the mixed (hybrid) theory reading of Kant on punishment.},
    keywords = "kant, punishment, retributivism, mixed-theory, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy" section 7 (Punishment): "Kant was long considered to be an exemplar of the retributivist theory of punishment until Byrd (1989) showed the role of deterrence in his theory (see Shell 1997 for a defense of retributivism)."},
    abstract = "This DOI is not currently attached to any metadata records. DOIs can’t actually ever be deleted (they’re persistent), but sometimes our members create DOIs in error. We do have a process to approximate deletion which we follow only in rare cases where the DOI has been genuinely created in error, and most crucially, if the DOI has never been published anywhere online or in print and never otherwise distributed to or communicated with anyone (authors, readers, reviewers, etc.",
    abstract_source = "openalex"
}

@misc{hill2000kant,
    author = "Hill, Thomas E.",
    title = "Kant on Punishment: A Coherent Mix of Deterrence and Retribution?",
    year = "2000",
    note = "CORE ARGUMENT: Hill defends the coherence of reading Kant as holding a mixed theory that combines deterrent and retributive elements, arguing that apparent tensions in Kant's texts dissolve once one separates the question of who may be punished (guilt as a necessary condition) from the question of why the state punishes at all (which can invoke social utility). RELEVANCE: Provides a systematic defense of the mixed-theory reading against charges of incoherence, complementing Byrd's textual case with a more explicitly philosophical reconstruction of how retribution and deterrence can jointly justify legal (as opposed to moral) punishment. POSITION: Mixed-theory defense, responding to objections that Kant's threat/execution distinction is unstable.",
    keywords = "kant, punishment, retributivism, mixed-theory, deterrence, High, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "Abstract Although Kant is often regarded an extreme retributivist regarding judicial punishment, the need to deter crime also plays a significant role in his theory of criminal law. Kant's special way of combining deterrence and retribution, however, must be distinguished from others that are less plausible. Kant thought that criminal punishments should be designed to match the victim's empirically discernible losses in degree and kind, except when this would be impossible or degrading; for courts cannot measure the ultimate moral desert of criminals. Arguably, Kant's justification of the practice of punishment is not deeply retributive, but punishment is also not a mere disincentive in a ‘price’ system of social control. For better or worse, punishment tends to convey a public message of moral disapproval of the criminal conduct; and, though this de facto expressive function is not for Kant, the purpose or justification of punishment, it may help explain his concern for making the severity of punishments proportional to the gravity of crimes and his refusal to allow exceptions for merely pragmatic reasons.",
    abstract_source = "openalex"
}

@misc{merle2000kantian,
    author = "Merle, Jean-Christophe",
    title = "A Kantian Critique of Kant's Theory of Punishment",
    year = "2000",
    volume = "19",
    note = {CORE ARGUMENT: Merle argues that both the traditional pure-retributivist reading and Byrd's mixed-theory reading of Kant are "literally right" as textual interpretations but that Kant's theory of punishment, so construed, is inconsistent with his own concept of law (Recht). Merle proposes instead that a genuinely Kantian justification of punishment should appeal to special deterrence and rehabilitation rather than retribution or general deterrence. RELEVANCE: Offers an internal ("Kantian") critique of Kant's own theory, useful for distinguishing exegetical questions (what did Kant argue?) from normative ones (what should a Kantian argue?) — a distinction central to any treatment of Kant's penal theory's contemporary relevance. POSITION: Internal critique: accepts elements of both pure-retributivist and mixed readings but argues Kant's actual view is self-undermining relative to his own legal theory.},
    keywords = "kant, punishment, retributivism, internal-critique, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "In contrast to the traditional view of Kant as apure retributivist, the recent interpretations ofKant's theory of punishment (for instance Byrd's)propose a mixed theory of retributivism and generalprevention. Although both elements are literallyright, I try to show the shortcomings of each. I thenargue that Kant's theory of punishment is notconsistent with his own concept of law. Thus I proposeanother justification for punishment: specialdeterrence and rehabilitation. Kant's critique ofutilitarianism does not affect this alternative, whichmoreover has textual support in Kant and is fullyconsistent with his concept of law.",
    abstract_source = "s2"
}

@misc{shell1997kant,
    author = "Shell, Susan Meld",
    title = "Kant on Punishment",
    year = "1997",
    volume = "1",
    note = {CORE ARGUMENT: Shell defends a retributivist reading of Kant's theory of punishment against revisionist "mixed theory" interpretations, arguing that Kant's insistence on the principle of equality and the jus talionis as sole measures of legitimate punishment expresses a considered commitment to retribution rather than an inconsistency to be explained away by appeal to deterrence. RELEVANCE: Serves as the primary counterweight to Byrd's mixed-theory reading in the literature; essential for representing the pure-retributivist side of the central interpretive dispute in this domain. POSITION: Defense of pure (or near-pure) retributivism against the Byrd-style mixed-theory consensus.},
    keywords = "kant, punishment, retributivism, pure-retributivism, High, METADATA\\_CLEANED: journal, pages, doi, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy" section 7 (Punishment) as the counterpoint to Byrd: "...until Byrd (1989) showed the role of deterrence in his theory (see Shell 1997 for a defense of retributivism)."},
    abstract = "Unlike that of most liberal thinkers, Kant's theory of punishment is unabashedly retributive. For classical liberals punishment is justified only by the harms it can prevent, not by any allegedly intrinsic good served by making the guilty suffer. Here Hobbes' blunt insistence that the aim of punishment ‘is not a revenge, but terror’ is prototypical in substance, if not in style. Hobbes, Locke, Mill, Bentham and Beccaria, for all their differences, agree that punishment must look to future good rather than to avenging past wrongs. This attitude on the part of classic liberalism toward retribution is not surprising, given its association with the kind of theocratic politics liberalism arose to combat.",
    abstract_source = "openalex"
}

@misc{yost2010kants,
    author = "Yost, Benjamin S.",
    title = "Kant's Justification of the Death Penalty Reconsidered",
    year = "2010",
    note = "CORE ARGUMENT: Yost reconsiders Kant's argument for capital punishment, focusing on Kant's reply to Beccaria's social-contract objection (that no one would consent in advance to their own execution). Yost examines whether Kant's distinction between the rational, contracting self and the empirical, criminal self can bear the justificatory weight Kant places on it, and where the argument fails on its own terms. RELEVANCE: Directly addresses the research project's focus on problems Kant's defense of capital punishment raises for contemporary Kantian penal theory, engaging closely with the social-contract dimension of the island/last-murderer argument. POSITION: Critical reconstruction of Kant's capital-punishment argument, sympathetic to retributivist premises but skeptical of Kant's specific social-contract defense.",
    keywords = "kant, capital-punishment, jus-talionis, social-contract, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "It is hard to know what to think about Kant's ‘passionate sermons’ on capital punishment. Kant clearly feels that it is one of the most important punishments in the state's arsenal. But his vehement insistence on the necessity of execution strikes many readers as philosophically suspect. Critics argue that Kant's embrace of the death penalty is incompatible with, or at least not required by, the fundamental tenets of his moral and legal philosophy (Schwarzschild 1985; Merle 2000; Potter 2002; Hill 2003). These arguments typically employ one of two strategies. The first is to deny that execution is required by retribution in even a prima facie sense; arguments along this line typically question the coherence of Kant's doctrine of the ius talionis (Sarver 1997). The second is to show that there are inviolable moral principles that render the death penalty illegitimate; this criticism typically appeals to the value of human dignity or the right to life (Radin 1980; Pugsley 1981; Schwarzschild 1985; Merle 2000; Potter 2002). There is a third strategy that could be used to criticize Kant, although it is not aimed at him specifcally. This strategy invokes legal principles of fairness or due process. It asserts that, regardless of capital punishment's moral appropriateness or legitimacy, capital punishment is unjust due to the fallibility of legal actors and institutions (Nathanson 2001). Someone adopting the third strategy might claim that, while Kant's justifcation may be acceptable in principle, it fails to justify the death penalty in the world we live in.",
    abstract_source = "openalex"
}

@misc{potter2002kant,
    author = "Potter, Nelson T.",
    title = "Kant and Capital Punishment Today",
    year = "2002",
    note = "CORE ARGUMENT: Potter examines whether Kant's retributivist justification of capital punishment can be extended to, or must be revised for, contemporary penal contexts, addressing objections concerning fallibility of judicial systems, proportionality, and the empirical conditions under which Kant's jus talionis argument was formulated. RELEVANCE: Bridges historical exegesis and contemporary application, directly relevant to the key question of what problems Kant's capital-punishment defense raises for present-day Kantian penal theory. POSITION: Sympathetic-but-critical retributivist engagement, testing the contemporary applicability of Kant's capital punishment argument.",
    keywords = "kant, capital-punishment, retributivism, contemporary-application, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{clark2004nonretributive,
    author = "Clark, Michael",
    title = "A Non-Retributive Kantian Approach to Punishment",
    year = "2004",
    note = {CORE ARGUMENT: Clark argues that a more coherent Kantian theory of punishment can be developed that abandons retribution altogether: he contends that hypothetical rational contractors would have no good reason to endorse a retributively-distributed system of punishment, even granting Kant's own premises about autonomy and the jus talionis. RELEVANCE: Represents the strongest departure from retributivist readings within the literature, useful for showing the outer boundary of how far "Kantian" commitments can be pushed away from Kant's own retributivist text. POSITION: Revisionist non-retributive Kantianism, rejecting the ius talionis constraint that both pure-retributivist and mixed-theory readings retain.},
    keywords = "kant, punishment, non-retributivism, revisionist, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Traditionally Kant's theory of punishment has been seen as wholly retributive. Recent Kantian scholarship has interpreted the theory as more moderately retributive: punishment is deterrent in aim, and retributive only in so far as the amount and type of penalty is to be determined by retributive considerations (the ius talionis). But it is arguable that a more coherent Kantian theory of punishment can be developed which makes no appeal to retribution at all: hypothetical contractors would have no good reason to endorse punishment distributed retributively. This position is first sketched behind Rawls's neo‐Kantian ‘veil of ignorance’, and it is suggested that the same theory will emerge from Scanlon's more relaxed neo‐Kantian position.",
    abstract_source = "openalex"
}

@misc{brooks2005kantian,
    author = "Brooks, Thom",
    title = "Kantian Punishment and Retributivism: A Reply to Clark",
    year = "2005",
    note = "CORE ARGUMENT: Brooks responds to Clark's non-retributive Kantian proposal, defending the view that Kant's theory of punishment endorses retribution for transgressions of the moral law while allowing consequentialist considerations for violations of positive law, and arguing that Clark's hypothetical-contractor argument fails to displace this dual structure. RELEVANCE: Extends the mixed-theory tradition by directly engaging Clark's revisionist critique, illustrating the ongoing, unsettled character of the debate over how much of Kant's retributivism survives contemporary scrutiny. POSITION: Mixed-theory defense (moral-law retribution plus positive-law consequentialism), responding directly to non-retributive revisionism.",
    keywords = "kant, punishment, retributivism, mixed-theory, reply, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Michael Clark defends ‘A Non-Retributive Kantian Approach to Punishment’. This defence takes the following form. Traditional interpretations of Kant’s theory of punishment mistakenly find it retributivist. Clark argues that Kant primarily endorses deterrent punishments instead. A Kantian framework of justice need not then entail that retributivist punishments are preferable to deterrent punishments. Clark then claims that the Kantian framework used by John Rawls helps us develop a nonretributivist theory of punishment. Scanlon’s Kantian framework is alleged to support non-retributivist punishments as well. I will argue that both Kant’s and Rawls’s theories of punishment are retributivist to some extent. It may then be slightly misleading to say that by following the views of Kant and Rawls in particular we can develop a non-retributivist theory of punishment. This matter is further complicated by the fact Clark nowhere addresses Rawls’s views on punishment: Rawls endorses a mixed theory combining retributive and utilitarian features. Only Scanlon defends the use of non-retributivist punishments.",
    abstract_source = "openalex"
}

@misc{brooks2003kants,
    author = "Brooks, Thom",
    title = "Kant's Theory of Punishment",
    year = "2003",
    note = {CORE ARGUMENT: Brooks argues against the widespread view that Kant's theory of punishment is straightforwardly retributivist, proposing instead that Kant discusses punishment from genuinely distinct standpoints: retribution governs transgressions of the moral law, while consequentialist considerations govern violations of positive law. He contends this dual reading resolves apparent inconsistencies and unifies Kant's scattered remarks on punishment. RELEVANCE: Offers a distinct unifying interpretive framework (moral-law/positive-law distinction) that differs from Byrd's threat/execution distinction, giving the domain a second major axis along which "mixed theory" readings can be organized. POSITION: Mixed-theory reading organized around the moral-law/positive-law distinction, presented as more coherent and unified than prior interpretations.},
    keywords = "kant, punishment, retributivism, mixed-theory, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The most widespread interpretation amongst contemporary theorists of Kant's theory of punishment is that it is retributivist. On the contrary, I will argue there are very different senses in which Kant discusses punishment. He endorses retribution for moral law transgressions and consequentialist considerations for positive law violations. When these standpoints are taken into consideration, Kant's theory of punishment is more coherent and unified than previously thought. This reading uncovers a new problem in Kant's theory of punishment. By assuming a potential offender's intentional disposition as Kant does without knowing it for certain, we further exacerbate the opportunity for misdiagnosis – although the assumption of individual criminal culpability may be all we can reasonably be expected to use. While this difficulty is not lost on Kant, it continues to remain with us today, making Kant's theory of punishment far more relevant than previously thought.",
    abstract_source = "openalex"
}

@misc{tunick1996kant,
    author = "Tunick, Mark",
    title = "Is Kant a Retributivist?",
    year = "1996",
    note = {CORE ARGUMENT: Tunick argues that Kant rejects consequentialism for moral actions but treats law and morality as distinct domains: in the sphere of positive law, an action (including a punitive law) can be justified by appeal to the good it produces. On this basis Kant's theory of legal punishment is, for Tunick, not straightforwardly deontological or retributivist despite Kant's reputation as the paradigmatic retributivist. RELEVANCE: Directly engages the research question of whether Kant's retributivism is purely deontological or admits consequentialist elements, using the raft/life-boat and absurd-law examples (parallel to the island passage) to argue that legal punishment in Kant is governed by considerations of deterrence and the avoidance of "absurd" (non-deterring) laws. POSITION: Revisionist reading denying that Kant's theory of legal punishment is deontological/retributivist in the usual sense, emphasizing the moral/legal distinction.},
    keywords = "kant, punishment, retributivism, moral-legal-distinction, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: volume, number, pages, METADATA\_CLEANED: journal, type:@article->@misc"
}

@misc{corlett2001making,
    author = "Corlett, J. Angelo",
    title = "Making Sense of Retributivism",
    year = "2001",
    note = "CORE ARGUMENT: Corlett examines the conceptual foundations of retributivism as a general theory of punishment, addressing what desert consists in and how it grounds the state's authority to inflict suffering, engaging critically with Kantian and non-Kantian retributivist positions to construct a more defensible version of the theory. RELEVANCE: Provides the broader retributivist framework (desert, proportionality, the state's authority to punish) within which Kant's specific version can be situated and evaluated, complementing the more narrowly exegetical papers in this domain. POSITION: General retributivist theory-construction, using Kant as a key reference point rather than as the exclusive object of analysis.",
    keywords = "retributivism, desert, kant, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This paper explicates and challenges John Rawl's argument concerning a rule-utilitarian theory of punishment. In so doing, it argues in favour of a retributivist theory of punishment, one that seeks to justify, not only particular forms of punishment, but the institution of punishment itself. Some crucial objections to retributivism are then considered: one regarding the adverse effects of punishment on the innocent, another concerning proportional punishment, a third pertaining to vengeance and retribution, a Marxian concern with retributive punishment, and a concern with the concept of desert. Each objection is deflected in order to ward-off what seem to be the most serious criticisms of a retributivist view of punishment and to clarify the depth of the retributivist position.",
    abstract_source = "openalex"
}

@misc{corlett2001foundations,
    author = "Corlett, J. Angelo",
    title = "Foundations of a Kantian Retributivism",
    series = "Library of Ethics and Applied Philosophy",
    year = "2001",
    note = "CORE ARGUMENT: Corlett constructs a Kantian retributivism grounded in the value of autonomous rational agency, arguing that the appropriate response to a wrongdoer's free choice to violate the rights of others is a proportionate, desert-based penalty, and that this reading can be defended against standard objections to retributivist theories of punishment. RELEVANCE: Offers a constructive, systematizing Kantian retributivism distinct from the primarily exegetical Byrd/Shell/Merle debate, useful for showing how autonomy-based readings of Kant's ethics more broadly (relevant to other domains in this review) extend into his penal theory. POSITION: Constructive Kantian retributivism grounded in autonomy and desert.",
    keywords = "kant, retributivism, autonomy, desert, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{holtman1997toward,
    author = "Holtman, Sarah Williams",
    title = "Toward Social Reform: Kant's Penal Theory Reinterpreted",
    year = "1997",
    note = "CORE ARGUMENT: Holtman reinterprets Kant's penal theory through the lens of civic respect and social reform rather than strict retribution, arguing that Kant's account can be read as compatible with, and even supportive of, penal institutions oriented toward the moral and social standing of offenders as fellow citizens, softening the harshness typically attributed to Kant's retributivism. RELEVANCE: Provides the domain's clearest dignity/civic-respect-based reading, directly relevant to the research question about dignity-based interpretations of Kant's penal theory as an alternative to strict jus talionis readings. POSITION: Reformist, dignity/civic-respect-based reinterpretation of Kant's retributivism.",
    keywords = "kant, punishment, dignity, civic-respect, social-reform, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Here I set the stage for developing a Kantian account of punishment attuned to social and economic injustice and to the need for prison reform. I argue that we cannot appreciate Kant's own discussion of punishment unless we read it in light of the theory of justice of which it is a part and the fundamental commitments of that theory to freedom, autonomy and equality. As important, we cannot properly evaluate Kant's advocacy of the law of retribution unless we recognize his theory of justice as an ideal theory. Once we understand both Kant's larger account of justice and its relationship to his less basic commitments, we discover grounds to accept that larger theory, but reject components like the law of retribution with their basis in empirical conclusions we may not share with Kant. We also open the way to develop an account of punishment responsive to social circumstances.",
    abstract_source = "openalex"
}

@misc{pickering2020against,
    author = "Pickering, Mark",
    title = "Against the Hybrid Interpretation of Kant's Theory of Punishment",
    year = "2020",
    note = "CORE ARGUMENT: Pickering argues against the now-dominant hybrid (mixed-theory) interpretation of Kant's penal philosophy, most influentially associated with Byrd, contending that the textual evidence does not support attributing to Kant a systematic combination of consequentialist and retributivist elements, and defending a reading closer to pure retributivism. RELEVANCE: As a recent, direct challenge to the Byrd-initiated consensus, this paper is essential for representing the current state of the interpretive debate and for cautioning against treating the mixed-theory reading as settled. POSITION: Contemporary defense of pure retributivism against the hybrid/mixed-theory interpretive tradition initiated by Byrd.",
    keywords = "kant, punishment, retributivism, pure-retributivism, hybrid-theory, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In Kants Werk Metaphysik der Sitten, Metaphysische Anfangsgründe der Rechtslehre scheint es so zu sein, dass er zum Strafrecht sowohl retributivistische als auch konsequentialistische Positionen bezieht. In den letzten Jahrzehnten, haben einige Forscher/innen dafür plädiert, dass Kants Theorie des Strafrechts daher ein Hybrid aus Konsequentialismus und Retributivismus sei. B. Sharon Byrds Auslegung ist die einflussreichste Version dieser Ansicht. Ich argumentiere demgegenüber dafür, dass die textlichen Beweise für die konsequentialistische Seite einer hybriden Auslegung nur schwach sind und dass Beweise für eine retributivistische Seite einer hybriden Auslegung nicht vorhanden sind. Es gibt sogar Textstellen, die dieser Auslegung widersprechen. Ich schließe daraus, dass die hybride Auslegung aufgegeben werden sollte.",
    abstract_source = "s2"
}

@article{vilhauer2023five,
    author = "Vilhauer, Benjamin",
    title = "Five Perspectives on Holding Wrongdoers Responsible in Kant",
    journal = "British Journal for the History of Philosophy",
    year = "2023",
    volume = "32",
    note = {CORE ARGUMENT: Vilhauer surveys five distinct perspectives within Kant's philosophy on the appropriate quantity of retribution owed to wrongdoers, distinguishing theoretical from practical standpoints and ranging from "theoretical zero" retribution to "practical infinity" (the standpoint of God and conscience) to "practical equality" (the standpoint of public law punishment), showing that Kant's texts support multiple, not fully reconciled, positions on how much wrongdoers deserve to suffer. RELEVANCE: Offers a fine-grained taxonomy that reframes the pure-retributivist/mixed-theory debate as a question of which of several genuinely Kantian standpoints on retribution should govern legal punishment, directly bearing on how the "island" passage's demand for strict equality relates to Kant's ethics more broadly. POSITION: Interpretive pluralism: Kant holds multiple, standpoint-relative views on the quantity of deserved retribution rather than a single unified theory.},
    keywords = "kant, punishment, retribution, responsibility, standpoints, High, METADATA\\_CLEANED: number, pages, doi",
    abstract = "ABSTRACT The first part of this paper surveys five perspectives in Kant’s philosophy on the quantity of retribution to be inflicted on wrongdoers, ordered by two dimensions of difference – whether they are theoretical or practical perspectives, and the quantity of retribution they prescribe: (1) theoretical zero, the perspective of theoretical philosophy; (2) practical infinity, the perspective of God and conscience; (3) practical equality, the perspective of punishment in public law; (4) practical degrees, the perspective we adopt in private relations to others and (5) practical zero, a perspective I argue is entailed by Kant’s doctrine of strict right, which is his justification of coercing compliance with public law. Kant acknowledges 1–4 but not 5. The second part draws on Kant’s account of the burden of proof in criminal law to argue that Kant is wrong to adopt 3 in responding to criminals, and that we ought to adopt 5 instead.",
    abstract_source = "s2"
}

@misc{vilhauer2017kants,
    author = "Vilhauer, Benjamin",
    editor = "Altman, Matthew C.",
    title = "Kant's Mature Theory of Punishment, and a First Critique Ideal Abolitionist Alternative",
    year = "2017",
    note = {CORE ARGUMENT: Vilhauer presents an interpretation of Kant's mature account of punishment as strongly committed to retributivism, then sketches a non-retributive "ideal abolitionist" alternative grounded in a version of original-position deliberation in which principles of punishment are chosen under the assumption that one is as likely to end up punished as protected by the institution. Vilhauer argues this alternative better fits the spirit of Kant's first-Critique remarks on imputation than his own mature retributivist conclusions do. RELEVANCE: Directly addresses the research question about problems Kant's retributivism raises for contemporary Kantian penal theory, offering a constructive abolitionist alternative built from within Kantian resources rather than simply criticizing Kant's conclusions externally. POSITION: Reconstructive/critical: affirms Kant's mature theory is genuinely retributivist, but argues resources internal to Kant's broader philosophy support a non-retributive, abolitionist alternative.},
    keywords = "kant, punishment, abolitionism, imputation, contemporary-kantian-theory, High, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "This chapter has two parts, the first of which is exegesis and exposition, and the second where Vilhauer offer a reconstructive Kantian theory of punishment based on the notion of choosing the principles of punishment in the Rawlsian original position. He argues that we can get a distinctively Kantian theory if we focus on the idea of a Kantian social contract for punishment. Kantians ought to accept that we would rationally consent to universalizable principles of punishment. If we think Rawls is right that original position deliberation gives us a helpful model of how to identify universalizable principles, then we can get Kantian principles of punishment by choosing them in the original position.",
    abstract_source = "openalex"
}

@misc{ataner2006kant,
    author = "Ataner, Attila",
    title = "Kant on Capital Punishment and Suicide",
    year = "2006",
    note = "CORE ARGUMENT: Ataner examines the parallels and tensions between Kant's arguments against suicide (grounded in the duty to preserve one's rational nature) and his defense of capital punishment (which requires the state to end a rational agent's life), asking whether Kant's broader commitments regarding the value of rational life are consistent with endorsing state-imposed death as the uniquely proportionate punishment for murder. RELEVANCE: Connects the capital-punishment debate to Kant's account of the dignity and value of rational agency more broadly, illuminating a tension the research project's dignity-based readings of Kant's penal theory must address. POSITION: Critical examination of internal consistency between Kant's ethics of self-preservation and his penal theory's endorsement of capital punishment.",
    keywords = "kant, capital-punishment, dignity, suicide, consistency, Medium, METADATA\\_CLEANED: journal, volume, number, doi, type:@article->@misc",
    abstract = "In the Metaphysics of Morals Kant clearly, and indeed ardently, upholds the state's right to impose the death penalty in accordance with the law of retribution ( ius talionis ). The “principle of equality” as between crime and punishment demands that those who wrongfully kill another should be put to death, for, in having inflicted such an evil upon another, the murderer has effectively killed himself. Kant is quite emphatic on this point: those who have committed murder “must die ”. Here, he argues, “there is no substitute that will satisfy justice”, for there “is no similarity between life, however wretched it may be, and death, hence no likeness between the crime and the retribution unless death is judicially carried out upon the wrongdoer […]”. The ius talionis is, for Kant, the basic principle and measure in accordance with which criminal justice functions. Since the ius talionis entails a strict equality between crime and punishment, Kant's insistence that only the death penalty serves as the appropriate response to murder (or to any other equally egregious crime) is fairly straightforward.",
    abstract_source = "openalex"
}

@misc{merle2009german,
    author = "Merle, Jean-Christophe",
    title = "German Idealism and the Concept of Punishment",
    year = "2009",
    note = "CORE ARGUMENT: Merle provides a comparative study of the theories of punishment developed within German Idealism, examining Kant's retributivism alongside Fichte's and Hegel's penal theories, and tracing continuities and departures across the tradition regarding the justification of state coercion and the relationship between right, morality, and punishment. RELEVANCE: Situates Kant's specific arguments about punishment within the broader German Idealist tradition, providing comparative context useful for assessing what is distinctively Kantian (as opposed to broadly Idealist) about the retributivist justification of punishment. POSITION: Comparative historical study across Kant, Fichte, and Hegel on punishment, building on Merle's own earlier internal critique of Kant (Merle 2000).",
    keywords = "kant, hegel, fichte, german-idealism, punishment, comparative, Low, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Against the background of early modernism - a period that justified punishment by general deterrence - Kant is usually thought to represent a radical turn towards retributivism. For Kant, and later for Fichte and Hegel, a just punishment respects the humanity inherent in the criminal, and serves no external ends - it is instituted only because the criminal deserves it. In this original study, Jean-Christophe Merle uses close analysis of texts to show that these philosophers did not in fact hold a retributivist position, or even a mixed position; instead he traces in their work the gradual emergence of views in favour of deterrence and resocialisation. He also examines Nietzsche's view that morality rests on the rejection of retribution. His final chapter offers a challenge to the retributivist position, and a defence of resocialisation, in the context of current legal theory and practice concerning the punishment of crimes against humanity.",
    abstract_source = "openalex"
}
