@misc{korsgaard1997taking,
    author = "Korsgaard, Christine M.",
    editor = "Reath, Andrews and Herman, Barbara and Korsgaard, Christine M.",
    title = "Taking the Law into Our Own Hands: Kant on the Right to Revolution",
    year = "1997",
    note = "CORE ARGUMENT: Korsgaard argues that Kant's own moral premises -- particularly the publicity requirement and the impermissibility of adopting maxims that could not be willed as universal law -- do not straightforwardly entail the blanket prohibition on resistance that Kant officially defends, and that a Kantian case can be constructed for a conditional, morally constrained right to resist a sufficiently unjust sovereign. RELEVANCE: This is the paper that reopened the contemporary debate over whether Kant's anti-revolutionary doctrine is truly derivable from his own principles of Right, directly addressing the project's central puzzle about the gap between Kant's juridical prohibition and his moral commitments; it is the primary target of Flikschuh's 2008 rebuttal. POSITION: Revisionist reading -- Kant's texts contain resources for a qualified permission to resist that Kant himself did not draw out.",
    sep_context = {SEP "Kant's Social and Political Philosophy" (section 6, "Rebellion and Revolution") cites this paper as the paradigm attempt to use independent moral judgment to justify revolution against Kant's own stated view, noting that Flikschuh 2008 responds to it directly.},
    keywords = "resistance, revolution, revisionist-reading, High, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "If we place ourselves at the end of this tremendous process, where the tree at last brings forth fruit, where society and the morality of custom at last reveal what they have simply been the means to: then we discover that the ripest fruit is the sovereign individual , like only to himself, liberated again from the morality of custom, autonomous and supramoral. Nietzsche Taking the Law into Our Own Hands Morality is unconditional and overriding. Its demands are uncompromising and its claims take priority over all others. Yet we can all think of situations in which, for reasons that seem to us honorable, unselfish, or conscientious, we would do things which morality seems to forbid. I want to ask how we can account for this fact. There are two attempts to deal with the problem which, for obvious reasons, I will call skepticism and dogmatism. The skeptic denies that morality is unconditional and overriding. The dogmatist insists that it is, and argues that either the actions in question are not wrong, or, if they are, a good person just won't do them. Some skeptics and dogmatists are merely trying to domesticate the phenomena. The skeptic may have pretensions to being worldly and realistic, laughing at the ponderous claims of moralists. The dogmatist may simply be a moralistic prig. But there are serious and attractive versions of both views. The skeptic may think, as Bernard Williams does, that a life in which moral considerations can always override love and the cherished projects of a lifetime is not recognizably human.",
    abstract_source = "openalex"
}

@misc{flikschuh2008reason,
    author = "Flikschuh, Katrin",
    title = "Reason, Right, and Revolution: Kant and Locke",
    year = "2008",
    note = "CORE ARGUMENT: Flikschuh contrasts Kant's and Locke's grounds for political obligation, arguing that Locke's resistance right rests on a voluntarist, rights-protective conception of political authority grounded in individual consent and self-preservation, whereas Kant's prohibition follows from a non-voluntarist conception on which rightful authority is constituted by the very possibility of reciprocal, universal external freedom rather than by antecedent individual rights the state exists to protect. RELEVANCE: Directly supplies the Locke/Kant contrast the project seeks, showing that the disagreement over resistance is not a superficial policy difference but tracks a deeper divergence in how each thinker grounds political authority itself. POSITION: Strict-prohibition reading defended via structural contrast with Locke, rather than by appeal to sovereignty concepts alone.",
    keywords = "resistance, Locke-comparison, political-obligation, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{flikschuh2008sidestepping,
    author = "Flikschuh, Katrin",
    title = "Sidestepping Morality: Korsgaard on Kant's No-right to Revolution",
    year = "2008",
    note = {CORE ARGUMENT: Flikschuh argues that Korsgaard's revisionist reading illicitly imports independent moral judgment into a domain -- Right -- that Kant deliberately insulates from direct moral adjudication; on Flikschuh's reconstruction, the no-right-to-revolution thesis is not a moral failure to be corrected but a structural feature of Kant's separation of Right from ethics, so that Korsgaard's proposed "correction" in fact sidesteps rather than engages Kant's actual argument. RELEVANCE: Provides the direct rebuttal to Korsgaard 1997 named in the key questions, and clarifies why appeals to inner morality or radical evil cannot simply be imported into the doctrine of Right to license resistance without collapsing Kant's right/ethics distinction. POSITION: Strict-prohibition reading defended against revisionist attempts to ground resistance rights in independent moral judgment.},
    sep_context = {SEP "Kant's Social and Political Philosophy" (section 6) cites this paper as the direct response to Korsgaard 1997's revisionist argument for a right to revolution.},
    keywords = "resistance, revolution, Korsgaard-debate, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, pages, type:@article->@misc"
}

@misc{waldron1996kants,
    author = "Waldron, Jeremy",
    title = "Kant's Legal Positivism",
    year = "1996",
    note = {CORE ARGUMENT: Waldron reads Kant's insistence on obedience to positive law, even unjust law, as a form of legal positivism: the authority of law derives not from its moral content but from its being the actual, effective embodiment of a public, general will capable of resolving disputes, so that any existing legal order is preferable, as a matter of Right, to the state of nature or to contested claims about which party -- sovereign or people -- truly embodies sovereignty. RELEVANCE: Supplies the "Universal Principle of Right" derivation of the anti-resistance stance that the project's first key question asks about, framing the prohibition as flowing from the concept of law and sovereignty rather than from any independent moral endorsement of existing regimes. POSITION: Strict-prohibition / legal-positivist reading -- the embodiment of law, not its justice, grounds the duty of obedience.},
    sep_context = {SEP "Kant's Social and Political Philosophy" (section 6) cites this paper as offering "a related legal positivist interpretation" of Kant's claim that any state embodies the general legislative will better than no state at all.},
    keywords = "resistance, legal-positivism, sovereignty, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "[H]owever well disposed and law-abiding men might be, ... individual men, peoples, and states can never be secure against violence from one another, since each has its own right to do what seems right and good to it and not to be dependent upon another's opinion about this. So, unless it wants to renounce any concepts of Right, the first thing it has to resolve upon is the principle that it must leave the state of nature, in which each follows its own judgment, unite itself with all others (with which it cannot avoid interacting), subject itself to a public lawful external coercion, and so enter into a condition in which what is to be recognized as belonging to it is determined by law .... IMMANUEL KANT'",
    abstract_source = "openalex"
}

@misc{maliks2013kant,
    author = "Maliks, Reidar",
    title = "Kant, the State, and Revolution",
    year = "2013",
    note = {CORE ARGUMENT: Maliks argues that although no right of resistance or revolution exists within a Kantian state, an extremely tyrannical regime can fail to qualify as a "state" at all in the relevant juridical sense, so that citizens retain a moral responsibility to judge whether a given regime meets the threshold conditions of rightful authority -- a position Maliks presents as compatible with, rather than a departure from, Kantian authority. RELEVANCE: Offers a textually grounded middle path between strict-prohibition and revisionist readings, directly addressing the key question about resources in Kant's texts for qualified resistance without abandoning the core anti-revolutionary architecture. POSITION: Qualified/conditional reading -- resistance remains prohibited within a genuine state, but the concept of "state" itself has a threshold below which the prohibition does not apply.},
    keywords = "resistance, tyranny, sovereignty, state-concept, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This paper argues that, although no resistance or revolution is permitted in the Kantian state, very tyrannical regimes must not be obeyed because they do not qualify as states. The essay shows how a state ceases to be a state, argues that persons have a moral responsibility to judge about it and defends the compatibility of this with Kantian authority. The reconstructed Kantian view has implications for how we conceive authority and obligation. It calls for a morally demanding definition of the state and asserts that the primary personal responsibility is not to evaluate the morality of every single law but to evaluate the moral standing of the polity.",
    abstract_source = "openalex"
}

@misc{maliks2022kant,
    author = "Maliks, Reidar",
    title = "Kant and the French Revolution",
    year = "2022",
    note = "CORE ARGUMENT: Through a contextual study of the French Revolution's two central phases -- the 1789 transfer of sovereignty to the people via the Estates-General and the 1792-93 trial and execution of the monarch -- Maliks argues that Kant judged the first phase to manifest popular sovereignty in lawful ways while treating the second as a perversion of that same principle, using this distinction to explain both Kant's enthusiasm and his continued rejection of a right of revolution. RELEVANCE: Provides the detailed historical mechanism behind the project's second key question, showing exactly how Kant's shifting real-time judgments about specific revolutionary events track his abstract doctrine rather than contradicting it. POSITION: Contextual-historical reading -- the apparent tension dissolves once Kant's fine-grained distinctions between lawful transfer of sovereignty and lawless popular action are reconstructed.",
    keywords = "French-Revolution, historical-context, sovereignty, High, METADATA\\_CLEANED: publisher, type:@book->@misc, METADATA\_CLEANED: doi",
    abstract = "To Kant, the French revolution's central events were the transfer of sovereignty to the people in 1789 and the trial and execution of the monarch in 1792-1793. Through a contextual study, this Element argues that while both events manifested the principle of popular sovereignty, the first did so in lawful ways, whereas the latter was a perversion of the principle. Kant was convinced that historical examples can help us understand political philosophy, and this Element seeks to show this in practice.",
    abstract_source = "s2"
}

@misc{beck1971kant,
    author = "Beck, Lewis W.",
    title = "Kant and the Right of Revolution",
    year = "1971",
    volume = "32",
    note = "CORE ARGUMENT: Beck offers an early systematic reconstruction of Kant's rejection of a right of revolution, situating it within Kant's broader theory of Right and arguing that the prohibition is a considered consequence of Kant's account of sovereignty and public law rather than a mere political expedient or personal timidity. RELEVANCE: Establishes the terms of the modern scholarly debate on this topic that later revisionist readings (Korsgaard, Arntzen) react against, providing the review's account of the doctrine's initial reception in Kant scholarship. POSITION: Strict-prohibition reading, presented as the considered consequence of Kant's systematic theory of Right.",
    keywords = "resistance, revolution, foundational-reading, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{hill2017questions,
    author = "Hill, Thomas E.",
    title = "Questions About Kant's Opposition to Revolution",
    year = "2017",
    note = "CORE ARGUMENT: Hill poses a series of critical questions about the coherence and scope of Kant's opposition to revolution, probing whether the arguments Kant gives (from the concept of sovereignty, from the social contract as an idea of reason, and from the dangers of anarchy) are individually sufficient or jointly consistent, without fully endorsing either a strict or a revisionist reading. RELEVANCE: Functions as a critical stock-taking of the standard arguments for Kant's prohibition, useful for the review's assessment of whether the doctrine is genuinely derivable from the Universal Principle of Right or rests on additional, more contestable premises. POSITION: Critical/exploratory -- interrogates rather than defends a single interpretive camp, cataloguing open questions in the strict-prohibition literature.",
    keywords = "resistance, revolution, critical-survey, Medium, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = {Immanuel Kant is well known for taking a hard, inflexible line on certain particular moral issues, such as lying and revolution. Kant was optimistic about revolutions as forces for moral progress that we might otherwise never achieve. He was known as a supporter of the French Revolution, reportedly referred to as “the old Jacobin". The prima facie problem is how Kant can reconcile his Hobbesian claim that revolution is always contrary to justice with his anti-Hobbesian conviction that there are universal standards of justice that apply to sovereign authorities. Kant argues that trying to incorporate an alleged right to revolution into a constitution for a legal system would be incoherent because it would purport to be a legal authority to destroy the very source of legal authority. Kant’s formula of humanity as an end in itself seems to provide presumptive grounds for questioning an absolute prohibition on revolution.},
    abstract_source = "openalex"
}

@misc{arntzen1996kant,
    author = "Arntzen, Sven",
    title = "Kant on Duty to Oneself and Resistance to Political Authority",
    year = "1996",
    note = "CORE ARGUMENT: Arntzen examines Kant's conceptual argument that a subject's right to resist supreme political power is self-contradictory (it would make the subject simultaneously sovereign and subject), and probes whether duties to oneself -- particularly the duty to preserve one's own moral integrity and dignity -- might nonetheless generate space for justified non-compliance short of a juridical right to rebel. RELEVANCE: Directly engages the key question about textual resources (here, duties to oneself rather than provisional right or radical evil) for a qualified permission to resist, offering an alternative route to the one Korsgaard later takes via publicity and universalizability. POSITION: Qualified reading -- the conceptual argument against a right to resist is sound as far as it goes, but duties to oneself may support limited non-compliance that falls short of resistance proper.",
    keywords = "resistance, duties-to-self, political-authority, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Kant on Duty to Oneself and Resistance to Political Authority SVEN ARNTZEN in ms DOCTRI\textasciitilde tE OF Law and related writings? Kant denies the subject's right to resist political authority in the strongest terms. His argumentation to support this denial is conceptual in character. The denial of a right of resistance follows from the relevant legal concepts of civil society, of the people as subject , of the head of state as the supreme power in civil society, as having only rights but no duties that he may be coerced to fulfill, and of a right as an authorization to use coercion. Civil society is the coexistence of persons as subject to a central authority, a supreme power, which is not itself subject to some other coercive authority. For the people as subject (or a member thereof) to have a right to resist the supreme power in civil society would be for it to have an authorization to use coercion to restrain that power, which would not, then, be the supreme power. In other words, a people's right to resist the supreme power would imply that the power is both supreme and not ' By Kant's Doctrineof Law I mean his Die metaphysischeAnfangsgriindederRechtslehre,the first part ofD/e MetaphysikderSitten, hereafter MdS (trans. Mary Gregor, TheMetaphysicsofMorals[New York: Cambridge University Press, 1991]). The other available translation of the DoctrineofLaw is by John Ladd, and is rendered as The MetaphysicalElementsofJustice (Indianapolis: The BobbsMerrill Company, a965). I will refer to the second part of MdS, DiemetaphysischeAnfangsgriindeder Tugendlehre,as the Doctrineof Virtue. The other main sources I will use are: "Uber den Gemeinspruch: Das mag in der Theorie richtig sein, taugt aber nicht fiir die Praxis," hereafter T\\&P (trans. Ted Humphrey, "On the Proverb: 'This May Be True in Theory, but It Does Not Apply in Practice'," in I. Kant, Perpetual Peaceand OtherEssays[Indianapolis: Hackett Publishing Co., 1983]); Grundlegungzur Metaphysik der S/tten, hereafter GMS (trans. James w. Ellington, Groundingfor theMetaphysicsofMorals [Indianapolis : Hackett Publishing Co., x983]); KritikderpraktischenVernunft, hereafter KpV (trans. L. W. Beck, CritiqueofPracticalReason [Indianapolis: The Bobbs-Merrill Company, Inc., 1965]). Page references for Kant's works are given in parentheses in the text by volume and page (e.g., V 34) of the Academy Edition: KantsgesammelteSchriflen(Berlin, 19lo- ). I have used available English translations when quoting from Kant's works. In some cases I have made modifications that I find appropriate. Where official translations are not available, the translations from Kantian sources are mine. [409] 41o JOURNAL OF THE HISTORY OF PHILOSOPHY 34:3 JULY 1996 supreme, and that the people is both subject and not subject to political authority . Thus, according to Kant, the notion of a people's right of resistance, or the statement that the people has such a right, involves a contradiction (VI 3182o ). \textasciitilde\ Furthermore, Kant argued that the formation (and preservation) of civil society is necessary, according to practical reason (VI 255-56, 3o7). It follows that the subject has a duty--a duty he may be coerced to fulfill--to obey political authority, even in the case of "what is declared to be an unbearable abuse of supreme authority" (VI 32o) or where the head of state exercises the oppressive power of a tyrant (VIII 382). These and similar assertions by Kant seem to be at odds with his view that civil society preserves, or at least ought to preserve, the freedom and equality of persons. By denying a right of resistance even where civil society fails short of the ideal civil society, he maintains that one has a duty to act according to a will which is not one's own and thereby seems to betray the person's autonomy and dignity that he has so strongly asserted in GMS and KpV.s Because of such tension, many commentators on this aspect of Kant's philosophy of law share the view that his denial of a right of resistance must be limited in scope. However, there is no general agreement concerning the conditions under which the subject may disobey or somehow resist political authority for Kant. According to Werner Haensel in his classical study on Kant's theory of resistance, Kant's conceptual argumentation can only...},
    abstract_source = "openalex"
}

@misc{golob2021kant,
    author = "Golob, Sacha",
    title = "Kant on revolution as a sign of moral progress",
    year = "2021",
    note = {CORE ARGUMENT: Golob analyzes Kant's claim, in "The Contest of Faculties," that the enthusiastic reaction of spectators to the French Revolution serves as a historical sign (signum rememorativum, demonstrativum, prognostikon) of humanity's moral progress, arguing that this claim is compatible with -- and indeed depends on -- the revolution itself being wrong and impermissible as an act of resistance. RELEVANCE: Clarifies the precise logical structure of Kant's "welcome for the outcome, prohibition on the act" position that the project's framing highlights, showing that the spectator's enthusiasm rather than the revolutionary act itself is what does the evidential work for moral progress. POSITION: Reconciliationist reading -- shows how moral endorsement of revolution's historical significance and juridical condemnation of revolutionary action are not merely compatible but structurally linked in Kant's philosophy of history.},
    keywords = "revolution, moral-progress, philosophy-of-history, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This paper addresses a central aspect of Kant's theory of moral progress and its links to both political violence and pedagogy. Kant claims in the Conflict of the Faculties that the reaction to the French Revolution demonstrates that the ‘human race has always progressed and will further progress toward the better’. It thus constitutes a ‘historical sign’, justifying belief in moral development. This paper argues for three points. First, I contend that these claims have been widely misunderstood: in particular, most commentators are guilty of projecting Hegelian arguments onto Kant. Second, I advance a new reading of Kant's account of the ‘historical sign’ focusing on the epistemic status of the spectator and the role of ‘enthusiasm’. One consequence is that the case for progress is fundamentally different from that in Kant's other writings. Third, I show how these results inform Kant's stance on education and the possibility of what he calls ‘popular enlightenment’. Ironically, the details of Kant's argument may seem to support pessimism rather than any celebration of human progress: the appeal to education is crucial in making that final leap.",
    abstract_source = "openalex"
}

@misc{lore2021supreme,
    author = "Lo Re, Stefano",
    title = "Supreme Power: A Neglected Source of Tension in Kant's Views on Political Resistance",
    year = "2021",
    note = {CORE ARGUMENT: Lo Re identifies an underexplored tension in Kant's account of "supreme power" (oberste Gewalt) itself, arguing that Kant's own characterizations of what makes a power supreme are not fully consistent and that this instability, rather than being a mere exegetical curiosity, bears directly on how far the prohibition on resistance can be pressed in edge cases. RELEVANCE: Adds a further textual pressure point to the debate over consistency in Kant's anti-revolutionary doctrine, complementing Korsgaard's and Arntzen's arguments by locating tension in the concept of sovereign power rather than in duties to oneself or publicity. POSITION: Critical/diagnostic -- identifies a structural tension internal to Kant's concept of supreme power rather than proposing a resolution.},
    keywords = "resistance, sovereignty, supreme-power, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{surprenant2005reconciliation,
    author = "Surprenant, Chris W.",
    title = "A Reconciliation of Kant's Views on Revolution",
    year = "2005",
    volume = "32",
    note = "CORE ARGUMENT: Surprenant argues that Kant's apparently conflicting statements on revolution can be reconciled by distinguishing cases in which an individual is under an independent moral obligation to revolt from the general juridical prohibition on a collective right of resistance, so that Kant's texts permit individual moral exceptions without conceding any general political right to rebel. RELEVANCE: Offers a further reconciliation strategy for the project's central consistency puzzle, distinct from Korsgaard's publicity-based revisionism and from Maliks's threshold-state approach, by locating the qualification at the level of individual moral obligation rather than collective political right. POSITION: Reconciliationist reading -- resolves the tension by separating individual moral obligation from collective political right rather than by revising either side of Kant's doctrine.",
    keywords = "resistance, revolution, reconciliation, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{ypi2014revolution,
    author = "Ypi, Lea",
    title = "On Revolution in Kant and Marx",
    year = "2014",
    note = "CORE ARGUMENT: Ypi compares Kant's and Marx's theories of revolution, arguing that despite Kant's juridical prohibition and Marx's endorsement of revolutionary praxis, both thinkers share a structurally similar commitment to revolution as playing an indispensable role within a philosophy of history oriented toward the progressive realization of freedom, differing chiefly in whether that role licenses individual revolutionary agency. RELEVANCE: Extends the project's comparative dimension beyond the Kant/Locke contrast to a Kant/Marx contrast, illuminating how Kant's view of revolution as historically necessary yet individually impermissible occupies a distinctive position between liberal contractarian and later revolutionary traditions. POSITION: Comparative reading -- situates Kant's prohibition within a shared philosophy-of-history framework that also generates Marx's very different conclusions about revolutionary agency.",
    keywords = "revolution, Marx-comparison, philosophy-of-history, Medium, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc, METADATA\_CLEANED: volume",
    abstract = "This essay compares the thoughts of Kant and Marx on revolution. It focuses in particular on two issues: the contribution of revolutionary enthusiasm to the cause of emancipatory political agents and its educative role in illustrating the possibility of progress for future generations. In both cases, it is argued, the defence of revolution is offered in the context of illustrating the possibility of moral progress for the species, even if not for individual human beings, and brings out the centrality of collective agency in moving toward universal moral goals. Discussing the implications of these points is of significant historical interest: it allows us to defend an interpretation of Kant’s political thought which is sensitive to the material conditions of historical development and to rescue Marx from an amoral reading of his philosophy of history. Reflecting on the role and preconditions of transformative collective agency is also of normative interest: it allows us to better evaluate the significance of political events that, firstly, re-shape the boundaries of political feasibility and, secondly, play a crucial educative role in motivating future progressive initiatives.",
    abstract_source = "openalex"
}

@misc{cronin2003kants,
    author = "Cronin, Ciaran",
    title = "Kant's Politics of Enlightenment",
    year = "2003",
    note = {CORE ARGUMENT: Cronin reconstructs Kant's account of the public, non-coercive use of reason -- the "freedom of the pen" -- as the institutional substitute Kant offers in place of a right of resistance, arguing that this freedom is meant to do real political work (correcting sovereign error and driving gradual reform) despite imposing no enforceable constraint on the sovereign. RELEVANCE: Directly examines the "right to complain but not to resist" doctrine named in the project's domain focus, clarifying how Kant expects public criticism alone to substitute functionally for a resistance right. POSITION: Strict-prohibition-compatible reading -- freedom of the pen is a genuine, if non-coercive, mechanism of political correction that makes the prohibition on resistance more palatable without conceding any right to disobey.},
    keywords = "freedom-of-the-pen, public-reason, enlightenment, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{curtiswendlandt2012no,
    author = "Curtis-Wendlandt, Lisa",
    title = "No Right to Resist? Elise Reimarus's Freedom as a Kantian Response to the Problem of Violent Revolt",
    year = "2012",
    note = {CORE ARGUMENT: Curtis-Wendlandt examines the largely neglected Enlightenment intellectual Elise Reimarus, a correspondent of Kant, whose dialogue "Freedom" develops a broadly Kantian rejection of a general right to violent resistance while proposing, like Kant, non-violent alternatives rooted in freedom of public expression and moral enlightenment as the appropriate response to political injustice. RELEVANCE: Recovers a contemporaneous interlocutor who worked out a position structurally parallel to Kant's "complain but do not resist" doctrine, broadening the project's account of the intellectual context in which Kant's anti-revolutionary stance was formed and debated. POSITION: Contextual/historical reading -- situates Kant's rejection of a resistance right within a wider circle of German Enlightenment thought rather than treating it as a solitary position.},
    keywords = "resistance, Reimarus, historical-context, Low, METADATA\\_CLEANED: number, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "One of the greatest woman intellectuals of eighteenth‐century Germany is Elise Reimarus, whose contribution to Enlightenment political theory is rarely acknowledged today. Unlike other social contract theorists, Reimarus rejects a people's right to violent resistance or revolution in her philosophical dialogue Freedom (1791). Exploring the arguments in Freedom, this paper observes a number of similarities in the political thought of Elise Reimarus and Immanuel Kant. Both, I suggest, reject violence as an illegitimate response to perceived political injustice in a way that opposes Locke's strong voluntarism and the absolutism of Hobbes. First, they emphasize the need to maintain the legal state as a precondition for the possibility of external right. Second, they share an optimistic view of the inherently “just” nature of the tripartite republican state. And finally, Reimarus and Kant both outline an alternative, nonviolent response to political injustice that consists in the freedom of public expression and a discourse on the moral enlightenment of man.",
    abstract_source = "openalex"
}

@misc{azeri2009kants,
    author = "Azeri, Siyaves",
    title = "Kant's Rejection of the Right of Revolution",
    year = "2009",
    note = "CORE ARGUMENT: Azeri surveys Kant's grounds for rejecting a right of revolution and situates this rejection within broader tensions between Kant's transcendental idealism and his engagement with the political realities of his time, arguing that the rejection reflects deeper features of Kant's conception of autonomy and the limits of practical reason in the political domain. RELEVANCE: Provides an additional, more critical vantage point on the derivability of the anti-revolutionary stance from Kant's broader philosophical system, complementing the more text-internal reconstructions offered by Beck, Waldron, and Maliks. POSITION: Critical reading -- treats the rejection of a right of revolution as symptomatic of broader strains between Kant's idealist commitments and his political theory.",
    keywords = "resistance, revolution, critical-reading, Low, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, number, type:@article->@misc, METADATA\_CLEANED: volume, pages"
}
