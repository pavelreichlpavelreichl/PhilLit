@misc{rauscher2007kant,
    author = "Rauscher, Frederick",
    title = "Kant's Social and Political Philosophy",
    year = "2007",
    howpublished = "\url{https://plato.stanford.edu/entries/kant-social-political/}",
    note = {CORE ARGUMENT: Surveys Kant's political philosophy as grounded in the innate right to freedom ("independence from being constrained by another's choice," 6:237) and the duty to enter a civil condition to realize and secure that freedom; situates the "original contract" as a non-historical idea of reason that constrains legislation and explains how the sovereign may coerce entry into the civil state without empirical consent; surveys the independence-thesis debate (Wood 2002 and Willaschek 1997/2009 vs. Guyer 2002 and Nance 2012) over whether Right is derived from or independent of the categorical imperative. RELEVANCE: Provides the authoritative reference map for this entire domain, identifying the primary textual loci (6:230, 6:237, 8:297) and the principal interpretive camps (Ripstein's formalism, Caranti's humanity-based reading, Byrd/Hruschka's natural-law contextualism) that structure the secondary literature collected here. POSITION: Reference/overview article rather than an original contribution to any single debate; synthesizes rather than adjudicates.},
    keywords = "innate-right, original-contract, Rechtslehre, SEP, Medium, INCOMPLETE, no-abstract"
}

@misc{faggion2015remarks,
    author = "Faggion, Andrea",
    title = {Remarks on "the Only Original Right Belonging to Every Man by Virtue of His Humanity"},
    year = "2015",
    abstract = {Kant compares a merely empirical doctrine of right to the wooden head in Phaedru's fable, i. e. a head that has no brain (MS AA 06: 229). An a priori right may be acquired or innate. According to Kant, there is only one innate right (MS AA 06: 237). That only one innate right is freedom. In that context, freedom means "independence from being constrained by another's choice" (MS AA 06: 237). As a moral right, such a right implies reciprocity. This being so, it is a right to be held "insofar as it can coexist with the freedom of every other in accordance with a universal law" (MS AA 06: 237). The reason why it is an innate right is that it is a "right belonging to every man by virtue of his humanity" (MS AA 06: 237). This paper aims to clarify a few issues regarding our innate right to freedom. To start with, we need a deeper understanding of the meaning of freedom as independence from being constrained by another's choice. I will claim that such an independence should be understood as absence from fraud and violence. Following, it is in order to analyze the condition according to which freedom is a right: coexistence with the freedom of every other in accord with a universal law. I will claim that such a condition does not imply political authority. Finally, we have to handle the connection between the innate right to freedom and our humanity. I will claim that the innate right to freedom cannot be disconnected from the second formula of the categorical imperative.},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Offers a close textual reading of Kant's single sentence defining the innate right (6:237), arguing that "independence from being constrained by another's choice" should be read specifically as freedom from fraud and violence, that the universal-law coexistence condition does not by itself imply or require political authority, and that the innate right's status as a right of "humanity" ties it necessarily to the Formula of Humanity in the Groundwork. RELEVANCE: Directly targets this domain's key question about the content of the innate right and its connection (or non-connection) to the categorical imperative, offering a textually conservative counterpoint to more formalist (Ripstein) and more contractualist (Sangiovanni) reconstructions. POSITION: Textual/exegetical; ties the innate right closely to the Formula of Humanity, implicitly resisting strict independence-thesis readings.},
    keywords = "innate-right, humanity, categorical-imperative, High, METADATA\_CLEANED: journal, volume, number, doi, type:@article->@misc"
}

@misc{hodgson2010kant,
    author = "Hodgson, Louis-Philippe",
    title = "Kant on the Right to Freedom: A Defense",
    year = "2010",
    note = {CORE ARGUMENT: Defends Kant's claim that there is only one innate right — the right to freedom understood as independence from others' choice — against the objection that such a purely formal right cannot generate the substantive system of rights (property, contract, status) Kant derives from it; argues that the content of the right to freedom, properly understood, does the work critics think it cannot do. RELEVANCE: A direct, sustained analytic defense of the innate right's foundational role, engaging the same question that motivates Sangiovanni's (2012) and Flikschuh's (2021) critical treatments included in this domain; useful as the "defense" pole against which those critiques are best read. POSITION: Defends the sufficiency of the freedom-based grounding of the Rechtslehre against skeptical challenges, aligning broadly with Ripstein's project though argued independently.},
    keywords = "innate-right, freedom, independence, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{sangiovanni2012can,
    author = "Sangiovanni, Andrea",
    title = "Can the Innate Right to Freedom Alone Ground a System of Public and Private Rights?",
    year = "2012",
    note = "CORE ARGUMENT: Argues, against Ripstein's Force and Freedom, that the innate right to freedom alone is insufficient to ground the full architecture of public and private right that Kant erects on it; contends that additional normative premises (beyond formal independence from others' choice) are needed to license the specific institutional structures Kant derives. RELEVANCE: A sustained, article-length challenge to the freedom-only grounding strategy that Ripstein (2009) and Hodgson (2010) both rely on, making it central to this domain's key question about what work the innate right can and cannot do on its own. POSITION: Critical of the sufficiency of Ripstein's formal-freedom grounding; argues for the need for supplementary normative resources within a broadly Kantian framework.",
    keywords = "innate-right, Ripstein, critique, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract The state regulates the way in which social power is exercised. It sometimes permits, enables, constrains, forbids how we may touch others, make offers, draw up contracts, use, alter, possess and destroy things that matter to people, manipulate, induce weakness of the will, coerce, engage in physical force, persuade, selectively divulge information, lie, enchant, coax, convince, … In each of these cases, we (sometimes unintentionally) get others to act in ways that serve our interests. Which such exercises of power should the state forbid? Which should it permit? An intuitively appealing way to answer this question is, with Ripstein and Kant, to point to the role of freedom: exercises of social power can be legitimately prohibited when (and only when) they restrict people's freedom. But this raises a further question: How do we identify when such exercises of power make people unfree in the relevant sense? Ripstein, in defending Kant, draws a crucial distinction between actions that subject others’ wills to our choices (and which it would therefore be presumptively legitimate for the state to forbid) and actions that merely affect the contexts in which others act (and which it would therefore be presumptively illegitimate for the state to forbid). I query that distinction, and argue that the idea of independence cannot bear, on its own, the weight it is expected to bear within the Kantian framework.",
    abstract_source = "openalex"
}

@misc{flikschuh2021innate,
    author = "Flikschuh, Katrin",
    title = "Innate right in Kant—A critical reading",
    year = "2021",
    note = {CORE ARGUMENT: Revisits Kant's doctrine of the innate right to freedom with a critical eye, examining internal tensions in how the "sole innate right" is meant to function as the foundation of the entire system of right and questioning whether standard formalist readings (including her own earlier work) adequately capture Kant's intentions. RELEVANCE: Represents a self-critical reassessment by one of the field's leading interpreters (author of Kant and Modern Political Philosophy, also in this bibliography), offering a mature, recent counterpoint to the earlier formalist consensus and directly engaging this domain's core question about the content and limits of the innate right. POSITION: Critical revision of formalist readings of the innate right, including qualification of positions associated with Ripstein and with the author's own earlier work.},
    keywords = "innate-right, critique, freedom, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "A now influential reading of Kant's statement of innate right in the Doctrine of Right interprets it as affirming a basic right of each to freedom of choice and action. This reading treats the innate right as foundational to Kant's entire philosophy of right—all other rights are said to be derived from the innate right. I call this the ‘free choice’ reading of innate right; while it enjoys considerable intuitive appeal, it is contestable on textual and systematic grounds. I show that the free choice reading (a) conflates Kantian external freedom with liberal negative freedom and (b) that its foundationalist assumptions about innate right conflict with Kant's critical method of justification. I go on to offer an alternative interpretation of innate right as conditionally affirming subjects' capacity for legal accountability, the real possibility of which depends on that of acquired right. Far from supplying the basis of acquired right, the possibility of innate right thus depends on that of acquired right. I close with some remarks on the merits of reading Kant's innate right critically and hence, counter-intuitively.",
    abstract_source = "s2"
}

@misc{falduto2024achenwalls,
    author = "Falduto, Antonino",
    title = {Achenwall's iura connata and Kant's "Only One Innate Right:" On Kant's (Partial) Departure from Natural Law Theory},
    year = "2024",
    note = {CORE ARGUMENT: Traces how Kant's doctrine of the "sole innate right" of freedom develops out of and departs from Gottfried Achenwall's natural-law concept of iura connata (multiple innate rights); argues Kant's position evolves from an early, more absolutist reading of innate rights as alienable (following Achenwall) toward a liberal conception of inalienable human rights (Menschenrechte). RELEVANCE: Directly addresses this domain's key question about how Kant's contractualism and rights-theory differ from and depart from the earlier natural law tradition (of which Achenwall, Kant's lecture-course textbook author, is the most proximate source), complementing Byrd \& Hruschka's natural-law contextualism. POSITION: Genealogical/historical; situates the innate right within and against eighteenth-century German natural jurisprudence rather than within contemporary analytic debates.},
    keywords = "innate-right, natural-law, Achenwall, history-of-philosophy, Medium, no-abstract, INCOMPLETE, METADATA\_CLEANED: booktitle, publisher, type:@incollection->@misc"
}

@misc{ripstein2009force,
    author = "Ripstein, Arthur",
    title = "Force and Freedom",
    year = "2009",
    sep_context = {Cited in 'kant-social-political' (SEP), section 2 "Freedom as the Basis of the State": "A recent influential interpretation of Kant (Ripstein 2009) prioritizes this concept of freedom as being one's own master as a formal relation of independence from domination by others." Also cited in the preamble as work that "looks more directly at Kant's legal or political philosophy apart from" connections to Kant's broader critical/moral philosophy.},
    note = {CORE ARGUMENT: Reconstructs Kant's Doctrine of Right as a systematic, freestanding legal-political philosophy centered on the innate right to freedom understood as independence from being subject to another's choice ("being one's own master"); argues that rightful coercion is not a departure from freedom but its condition, since hindering a hindrance to freedom (wrongful force) leaves overall freedom undiminished; develops the Universal Principle of Right as a formal, non- consequentialist standard for adjudicating conflicts of choice. RELEVANCE: The central book-length treatment organizing this domain's key question about rightful/"innocent" coercion and about the relation between the innate right and the state; its formalist reading of freedom-as-independence is the primary target of both defenses (Hodgson) and critiques (Sangiovanni, Flikschuh) collected here. POSITION: Formalist, freedom-as-non-domination reading of the innate right; treats the Doctrine of Right as methodologically independent of, though compatible with, Kant's ethics.},
    keywords = "innate-right, coercion, freedom, Ripstein, formalism, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Ripstein gives a comprehensive yet accessible account of Kant’s political philosophy. In addition to providing a clear and coherent statement of the most misunderstood of Kant’s ideas, Ripstein also shows that Kant’s views remain conceptually powerful and morally appealing today.",
    abstract_source = "openalex"
}

@misc{byrdhruschka2009kants,
    author = "Byrd, B. Sharon and Hruschka, Joachim",
    title = "Kant's Doctrine of Right",
    year = "2009",
    sep_context = {Cited in 'kant-social-political' (SEP) preamble: "Secondary work on Kant connects him with both the natural law and the social contract traditions (see Byrd and Hruschka 2010 and Williams 2003, respectively)."},
    note = "CORE ARGUMENT: A comprehensive section-by-section philosophical and philological commentary on the Doctrine of Right, situating Kant's arguments within the German natural-law tradition (Achenwall, Baumgarten, Feyerabend lecture notes) and reconstructing the logical structure of Kant's derivations of the innate right, the postulate of practical reason, and the transition to the civil condition. RELEVANCE: The standard reference commentary for this domain; supplies the detailed textual scaffolding (including translation and terminological choices) presupposed by nearly every other entry in this bibliography, and is the primary source for reading Kant's rights-theory as continuous with rather than a rupture from the natural law tradition (complementing Falduto 2024). POSITION: Natural-law contextualist; reads the Rechtslehre as continuous with eighteenth-century German natural jurisprudence rather than as a standalone application of the categorical imperative.",
    keywords = "Rechtslehre, natural-law, commentary, Byrd-Hruschka, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Published in 1797, the Doctrine of Right is Kant's most significant contribution to legal and political philosophy. As the first part of the Metaphysics of Morals, it deals with the legal rights which persons have or can acquire, and aims at providing the grounding for lasting international peace through the idea of the juridical state (Rechtsstaat). This commentary analyzes Kant's system of individual rights, starting from the original innate right to external freedom, and ending with the right to own property and to have contractual and family claims. Clear and to the point, it guides readers through the most difficult passages of the Doctrine, explaining Kant's terminology, method and ideas in the light of his intellectual environment. One of the very few commentaries on the Doctrine of Right available in English, this book will be essential for anyone with a strong interest in Kant's moral and political philosophy.",
    abstract_source = "openalex"
}

@misc{flikschuh2000kant,
    author = "Flikschuh, Katrin",
    title = "Kant and Modern Political Philosophy",
    year = "2000",
    sep_context = {Cited in 'kant-social-political' (SEP) preamble as work that "applies Kant's position to contemporary issues or within contemporary debates" and cited in section 5 in connection with reading Kant's social contract and property doctrines as ideas of reason.},
    note = {CORE ARGUMENT: Argues that Kant's political philosophy must be read through the lens of his metaphysics of freedom, treating central Kantian concepts — the social contract, property acquisition, the state — as "ideas of reason" (regulative concepts with no direct empirical correlate) rather than as empirical political claims; uses this reading to connect Kant's political philosophy to, and to distinguish it from, contemporary liberal political theory (e.g., Rawls, Nozick). RELEVANCE: Foundational for this domain's key question about what work the "idea of reason" framing does in Kant's contractualism, distinguishing his approach from the empirical/hypothetical social contracts of Hobbes, Locke, and Rawls; the companion chapter "The metaphysics of freedom as an idea of reason" treats the original contract and innate right together as expressions of the same methodological point. POSITION: Reads Kant's political concepts as regulative "ideas of reason," emphasizing methodological continuity between the first Critique's use of ideas and the Doctrine of Right's foundational concepts.},
    keywords = "original-contract, idea-of-reason, Flikschuh, High, no-abstract, INCOMPLETE, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{willaschek2009right,
    author = "Willaschek, Marcus",
    title = "Right and Coercion: Can Kant's Conception of Right be Derived from his Moral Theory?",
    year = "2009",
    sep_context = {Discussed in 'kant-social-political' (SEP), section 1 "The Place of Political Philosophy within Kant's Philosophical System": "Wood (2002) and Willasheck (1997, 2009) argue that the Doctrine of Right stands on its own without being derived directly from the categorical imperative and is thus independent of Kant's ethics. Guyer (2002) and Nance (2012) offer direct replies that defend the integration of right into the broader ethical system." (SEP spells the name "Willasheck".)},
    note = {CORE ARGUMENT: Argues that Kant's Universal Principle of Right — and specifically the authorization it gives for rightful coercion — cannot be straightforwardly derived from the categorical imperative as formulated in the Groundwork; contends the Doctrine of Right requires independent argumentative resources (the "independence thesis"), most importantly the innate right to freedom itself rather than the moral law as such. RELEVANCE: The founding statement of the "independence thesis" that organizes much of this domain's debate about the relation between the Universal Principle of Right and Kant's broader ethical architecture; published back-to-back with Seel's direct reply in the same journal issue. POSITION: Independence thesis — Right is methodologically independent of, though compatible with, the categorical imperative; coercion-authorization requires distinctively juridical (not directly ethical) grounds.},
    keywords = "independence-thesis, coercion, categorical-imperative, Willaschek, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Recently, there has been some discussion about the relationship between Kant’s conception of right (the sphere of juridical rights and duties) and his moral theory (with the Categorical Imperative as its fundamental norm). In section 1, I briefly survey some recent contributions to this debate and distinguish between two different questions. First, does Kant’s moral theory (as developed in the Groundwork and the Critique of Practical Reason) imply, or validate, a Kantian conception of right (as developed in the first part of the Metaphysics of Morals, the Doctrine of Right)? In other words, is the Categorical Imperative sufficient to show that the fundamental principles of right are normatively valid? Second, does Kant’s conception of right presuppose his moral theory? In other words, is the Categorical Imperative necessary to show that the basic principles of right are normatively valid? In this paper, I will be primarily concerned with defending a negative answer to the first of these questions. In section 2, I will discuss Paul Guyer’s attempt to vindicate a positive answer to the same question. In section 3, reasons will be given why any attempt to derive Kant’s conception of right from the Categorical Imperative must fail because of the analytic connection between right and coercion.",
    abstract_source = "openalex"
}

@misc{seel2009how,
    author = "Seel, Gerhard",
    title = "How Does Kant Justify the Universal Objective Validity of the Law of Right?",
    year = "2009",
    note = "CORE ARGUMENT: Responds directly to Willaschek's companion article in the same issue, arguing that Kant does, and must, ground the universal objective validity of the Universal Principle of Right in the categorical imperative if that principle is to have the unconditional, a priori normative force Kant claims for it; resists the independence thesis on textual and systematic grounds. RELEVANCE: The direct rejoinder to Willaschek (2009) that, together with Baiasu (2016) and Tomassini (2023), maps the full spectrum of positions in this domain's central methodological debate about the derivation of the Universal Principle of Right. POSITION: Integrationist — the Universal Principle of Right's validity depends on, and is ultimately derived from, the categorical imperative.",
    keywords = "independence-thesis, categorical-imperative, universal-principle-of-right, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Since more than 50 years Kant scholars debate the question whether the Law of Right as introduced in the Metaphysics of Morals by Kant can be justified by the Categorical Imperative. On the one hand we have those who think that Kant’s theory of right depends from the Categorical Imperative, on the other hand we find a growing group of scholars who deny this. However, the debate has been flawed by confusion and misunderstanding of the crucial terms and principles. Therefore, my first task will be to clarify these terms and principles by introducing distinctions that have been neglected too often. After this I try to show a) that the Law of Right can in fact be justified by using the testing method the Categorical Imperative prescribes and b) that there is no other way to justify it. Doing this I criticize in detail the new arguments adherents of the independence thesis have recently put forward.",
    abstract_source = "openalex"
}

@misc{tomassini2023right,
    author = "Tomassini, Fiorella",
    title = "Right, Morals and the Categorical Imperative",
    year = "2023",
    abstract = "In this paper I examine the relationship between the principle of right and the principle of morals [Sitten] in Kant's Metaphysics of Morals. My interpretation denies that the principle of right is derived from the categorical imperative, but neither does it adhere to the independence thesis. I present a third way of understanding the relationship between the law of right and the universal law of morals: the latter is needed in order to formulate the former, but it is not sufficient. The principle of right is obtained by applying the categorical imperative to the concept of right. I highlight the discussion on the subject within the late eighteenth-century German natural law tradition and similar arguments found in Achenwall.",
    abstract_source = "s2",
    note = "CORE ARGUMENT: Stakes out a third position between strict derivation and strict independence: the principle of right is neither directly derived from the categorical imperative alone nor wholly independent of it, but arises from applying the categorical imperative to the specific concept of right; situates this reading against the backdrop of the German natural law tradition and Achenwall's arguments. RELEVANCE: The most recent contribution to the independence-thesis debate in this domain, explicitly triangulating between Willaschek's and Seel's positions and drawing on the same Achenwallian natural-law context as Falduto (2024). POSITION: Intermediate/qualified — rejects both strict derivation and strict independence; the categorical imperative is necessary but not sufficient to generate the principle of right.",
    keywords = "independence-thesis, categorical-imperative, Achenwall, universal-principle-of-right, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{pallikkathayil2010deriving,
    author = "Pallikkathayil, Japa",
    title = "Deriving Morality from Politics: Rethinking the Formula of Humanity",
    year = "2010",
    note = "CORE ARGUMENT: Reverses the usual direction of the independence-thesis debate by arguing that certain requirements of political morality — specifically, the wrongness of certain forms of coercion — can help explain and refine the content of the Formula of Humanity, rather than treating the Doctrine of Right as simply an application of an independently specified moral principle; develops an account of when coercion treats persons merely as means. RELEVANCE: Central to this domain's key question about how rightful coercion is justified without collapsing the right/might or is/ought distinction; approaches the independence-thesis debate from the opposite direction to Willaschek, Seel, and Baiasu, making the political (rather than the moral) doctrine explanatorily primary in certain respects. POSITION: Inverts the standard direction of derivation — political/juridical considerations about coercion inform and constrain the content of Kant's moral theory (the Formula of Humanity), rather than the reverse.",
    keywords = "coercion, independence-thesis, formula-of-humanity, Pallikkathayil, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Kant's Formula of Humanity famously forbids treating others merely as a means. It is unclear, however, what exactly treating someone merely as a means comes to. This essay argues against an interpretation of this idea advanced by Christine Korsgaard and Onora O'Neill. The essay then develops a new interpretation that suggests an important connection between the Formula of Humanity and Kant's political philosophy: the content of many of our moral duties depends on the results of political philosophy and, indeed, on the results of actual political decision making.",
    abstract_source = "openalex"
}

@misc{baiasu2016rights,
    author = "Baiasu, Sorin",
    title = "Right's Complex Relation to Ethics in Kant: The Limits of Independentism",
    year = "2016",
    abstract = {The recent literature on the relation in Kant between duties of right and duties of virtue is dominated by a debate on whether duties of right can be derived from duties of virtue. According to one important argument, there is a tension or even a paradox in Kant between various claims concerning juridical norms, a paradox which can best be solved by assuming an "Independentist" position, that is, the view that the Universal Principle of Right is independent from the Categorical Imperative and, h},
    abstract_source = "core",
    note = {CORE ARGUMENT: Surveys the recent debate over whether duties of right are derived from duties of virtue, focused on the "Independentist" solution to an apparent paradox in Kant's claims about juridical norms; argues that Independentism, while capturing something correct about Right's distinctive normativity, cannot fully capture the complex relation between right and ethics and must be qualified. RELEVANCE: Provides a critical survey and partial rebuttal of the independence thesis that complements Willaschek's founding statement, Seel's direct reply, and Tomassini's more recent intermediate position, rounding out this domain's coverage of the central methodological debate. POSITION: Qualified critique of Independentism — right's relation to ethics is more complex than either strict derivation or strict independence allows.},
    keywords = "independence-thesis, categorical-imperative, Baiasu, High, METADATA\_CLEANED: journal, volume, number, doi, type:@article->@misc"
}

@misc{hruschka2004permissive,
    author = "Hruschka, Joachim",
    title = "The Permissive Law of Practical Reason in Kant's Metaphysics of Morals",
    year = "2004",
    abstract = {The permissive law of practical reason (Erlaubnisgesetz der praktischen Vernunft) plays a decisive role in the Doctrine of Justice. Here, Kant refers to it by name exactly three times. Each of these references appears in the section entitled "Private Law on the External Mine and Yours in General." Kant first and most exhaustively deals with the permissive law in §2 "Postulate of Practical Reason with Regard to Rights," where the postulate itself is called a "permissive law (lex permissiva) of practical reason." Kant refers to this law a second time in §16. There he speaks of the original acquisition of land "in light of determining the limits of possible rightful possession." This determination needs and also gains, as Kant states, "the},
    abstract_source = "s2",
    note = {CORE ARGUMENT: Reconstructs the technical role of the "permissive law of practical reason" (lex permissiva) as it functions in Kant's Postulate of Practical Reason with Regard to [External] Objects of Choice (§2 of the Doctrine of Right), tracing its three explicit occurrences in the text and clarifying how it licenses provisional external possession prior to the civil condition without already presupposing rightful acquisition. RELEVANCE: The most direct treatment in this bibliography of this domain's key focus on "the postulate of practical reason with regard to external objects," written by the co-author of the standard Doctrine of Right commentary. POSITION: Close textual/doctrinal reconstruction; treats the permissive law as a distinct and indispensable argumentative device rather than as a mere corollary of the innate right to freedom.},
    keywords = "postulate-of-practical-reason, permissive-law, external-objects, Hruschka, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{durao2024como,
    author = "Barbieri Durão, Aylton",
    title = "Como são possíveis juízos jurídicos sintéticos a priori?",
    year = "2024",
    abstract = "Transcendental Freedom is the foundation of practical freedom which, in turn, is the foundation of moral philosophy, which consists in the determination of the maxims of choice by the moral law arising from the will and the neutralizationof sensitive inclinations. But freedom is divided into internal freedom of choice, when will determine the matter of choice, establishing ends that are also duties, which makes the supreme principle of the doctrine of virtue a maxim of ends and, therefore, a synthetic a priori judgment; and freedom in the external use of choice, which determines the form of the choice, which allows the choice to exist according to any ends, as long as the action occurs only in accordance with duty, but not from duty, which makes the principle of right possible. After trying to formulate the principle of right as a synthetic a priori judgment in the form of a categorical imperative, Kant abandons this project and states that the principle of right is an analytical judgment because it can be deduced directly from freedom through the principle of contradiction, a since, in the right, the ends of the action can be any. However, if the right is deduced from an analytical judgment, it cannot belong to critical philosophy, as it is necessary to show that metaphysics is composed of a priori synthetic judgments, therefore, there must be another principle from which the majority of juridical duties are deduced as synthetic a priori judgments. Therefore, Kant introduced the unified will of the people, as an a priori synthetic judgment capable of showing how empirical possession, authorized by the juridical postulate of practical reason, in the state of nature, can be transformed into merely juridical possession, as an intelligible possession, without detaining the object, in the civil status, expanding practical reason beyond simple freedom, which explains how synthetic a priori juridicaljudgments are possible.",
    abstract_source = "s2",
    note = "CORE ARGUMENT: Traces Kant's own shifting position on whether the principle of right is an analytic or a synthetic a priori judgment: Kant first attempts to formulate it as synthetic a priori (deriving it from the categorical imperative), then treats it as merely analytic (deducible from the concept of freedom by the principle of contradiction alone) — a move the author argues is incompatible with situating the Doctrine of Right within critical philosophy — before ultimately introducing the united will of the people as the synthetic a priori judgment that transforms empirical into properly juridical (intelligible) possession. RELEVANCE: Directly answers this domain's key question about the relation between the Universal Principle of Right and the analytic/synthetic structure of the Rechtslehre, connecting that methodological question to the original contract (the united/general will) as the resolving synthetic a priori judgment. POSITION: Developmental/textual — treats the analytic/synthetic status of the principle of right as an unresolved tension within Kant's text that is only settled by appeal to the general will, rather than as a fixed doctrine.",
    keywords = "universal-principle-of-right, analytic-synthetic, original-contract, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{pinheirowalla2014human,
    author = "Pinheiro Walla, Alice",
    title = "Human Nature and the Right to Coerce in Kant's Doctrine of Right",
    year = "2014",
    note = {CORE ARGUMENT: Argues that Kant's justification of rightful coercion is not purely formal but draws on empirical assumptions about human nature — in particular, the ineliminable possibility that others will not respect one's rights absent coercive enforcement — to explain why the mere existence of other rational agents in space necessitates a coercively-backed civil condition. RELEVANCE: Engages this domain's key question about how "innocent" coercion is justified by identifying an empirical (anthropological) dimension to Kant's argument that pure formalist readings (e.g., Ripstein's) tend to downplay or exclude. POSITION: Argues for a partly empirical, human-nature-involving reading of the necessity of coercive right, in tension with strictly formal/a priori reconstructions of the doctrine.},
    keywords = "coercion, human-nature, Rechtslehre, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract : This paper explores the alleged role of a conception of human nature for Kant’s justification of the duty to leave the state of nature and the related right to coerce others to enter the civil condition in the Doctrine of Right (1797). I criticise the interpretation put forward by Byrd and Hruschka, according to which Kant’s postulate of public right is a preventive measure based on a “presumption of badness” of human beings. Although this reading seems to be supported by § 42 of the Doctrine of Right , I shall argue that the paragraph neither offers a justification of why we have a duty to leave the state of nature, nor explains why individuals are allowed to coerce others to do so. I offer an alternative interpretation of § 42 by focusing on the difference between formal and material violations of right and argue that the rationale behind the postulate of public right is the idea that remaining in the state of nature is a formal violation of the concept of right. It is therefore not prudential reason that authorizes us to coerce others to enter the lawful condition.",
    abstract_source = "openalex"
}

@misc{mckean2019kant,
    author = "McKean, Benjamin L.",
    title = "Kant, coercion, and the legitimation of inequality",
    year = "2019",
    abstract = "ABSTRACT Immanuel Kant's political philosophy has enjoyed renewed attention as an egalitarian alternative to contemporary inequality since it seems to uncompromisingly reassert the primacy of the state over the economy, enabling it to defend the modern welfare state against encroaching neoliberal markets. However, I argue that, when understood as a free-standing approach to politics, Kant's doctrine of right shares essential features with the prevailing theories that legitimate really existing economic inequality. Like Friedrich Hayek and Milton Friedman, Kant understands the state's function as essentially coercive and, in justifying state coercion, he adopts a narrow conception of political freedom that formally preserves the right to choose while denying that the range of choices one actually has can be a matter of justice. As a result, Kant cannot identify various forms of social pressure as potential injustices even as he recognizes their power to create and sustain troubling inequalities. For both Kant and the neoliberals, the result is that economic relations almost never count as unjust forms of coercion, no matter how unequal they are. Views that identify coercion as the trigger for duties of justice are thus particularly ill-suited to orient us to contemporary inequality.",
    abstract_source = "s2",
    note = "CORE ARGUMENT: Challenges the recent use of Kant's doctrine of right as an egalitarian resource against neoliberalism, arguing that Kant's narrow, purely formal conception of coercion — modeled on interference with choice rather than on substantive freedom — structurally resembles Hayekian and Friedmanite justifications of market inequality, since it cannot recognize social and economic pressure as unjust coercion regardless of how severe the resulting inequality. RELEVANCE: Offers a politically critical vantage on this domain's key question about how rightful coercion is justified, showing that the formal, choice-based account of coercion central to Ripstein's and related readings has significant costs when applied to contemporary economic inequality. POSITION: Critical of the formal/choice-based conception of coercion underlying mainstream Kantian right theory; reads it as structurally continuous with neoliberal justifications of inequality rather than as a resource against them.",
    keywords = "coercion, inequality, critique, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{krasnoff2018more,
    author = "Krasnoff, Larry",
    title = "More than Consent: Kant on the Function of the Social Contract",
    year = "2018",
    note = {CORE ARGUMENT: Argues that Kant's "original contract" does more argumentative work than merely tracking hypothetical consent: it functions as a normative test requiring the sovereign to legislate only as a united people could give its consent, in principled abstraction from any actual or even hypothetical empirical preferences, thereby distinguishing Kant's use of the social contract device from both Hobbesian and Lockean consent-based justifications. RELEVANCE: Directly addresses this domain's key question of how Kant's contractualism differs from Hobbes's and Locke's and what work the "idea of reason" framing does, focusing specifically on the function (rather than merely the non-historicity) of the original contract as a constraint on legislation. POSITION: Reads the original contract as doing more than securing consent — as a substantive normative constraint on legislative content, going beyond both Flikschuh's "idea of reason" framing and simple hypothetical-consent readings.},
    keywords = "original-contract, social-contract, Hobbes, Locke, Medium, no-abstract, INCOMPLETE, METADATA\_CLEANED: journal, volume, pages, type:@article->@misc"
}

@misc{gregor1988kants,
    author = "Gregor, Mary",
    title = "Kant's Theory of Property",
    year = "1988",
    note = {CORE ARGUMENT: Gregor works through Kant's derivation of property from the postulate of practical reason with regard to external objects, tracing how Kant moves from "intelligible" (as opposed to merely physical) possession to the claim that a rightful property regime is possible only under a general, omnilateral will rather than through any individual's unilateral act of taking. RELEVANCE: SEP's own "Property and Contract Right" section names this "a classic exposition of Kant's position," making it the natural reference point against which later revisionist readings (Westphal, Hasan, Messina) define themselves. It anchors the domain's core interpretive problem: how a one-sided act of acquisition can generate a duty binding on everyone else. POSITION: Sympathetic reconstruction of Kant's own derivation of property from practical reason, rather than a critique of it.},
    keywords = "property, postulate-of-practical-reason, unilateral-will, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy," section 5 (Property and Contract Right): "The main text of the Doctrine of Right begins with a discussion of property, showing the importance of this right for the implementation of the innate right to freedom. (A classic exposition of Kant's position is Gregor 1988.)"}
}

@misc{shell1978kants,
    author = "Shell, Susan Meld",
    title = "Kant's Theory of Property",
    year = "1978",
    note = "CORE ARGUMENT: An early and much-discussed reading of Kant's property doctrine that provoked a direct published exchange (Riley's response, and Shell's rejoinder, both in the same journal within a year), establishing property, rather than the categorical imperative alone, as an independent locus of dispute in Kant's political philosophy. RELEVANCE: Represents the opening of the modern English-language secondary literature on Kantian property theory that Gregor, Baynes, and later authors continue to engage; useful for tracing how the field's terms of debate (unilateral will, the postulate, provisional possession) were first set. POSITION: Foundational, historically formative reading of Kant's property doctrine, distinct from but complementary to Gregor's later treatment.",
    keywords = "property, history-of-scholarship, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "DESCENDANT OF SCOTSMEN OF the sort who were to set up trade in America, Kant might have been a New World merchant. Instead, Kant's ancestors chose to settle in the busy Prussian port of Konigsberg. From this spot Kant never ventured, but from it he could claim to be a citizen of the world. Konigsberg provided Kant a singularly cosmopolitan perch from which to see past his semi-feudal surroundings to revolutionary political and philosophic developments beyond. Kant is reported especially to have enjoyed the company of Kbnigsberg's thriving merchants, who, bringing news of the latest developments abroad, must have had special praise for the new economic thought then gaining prominence in Scotland and France. Kant's own writings reveal his early and enthusiastic familiarity with Adam Smith and the Physiocrats long before they were read widely in Germany. A self-proclaimed world trader in ideas, Kant was no businessman. Forced to support himself and a host of relatives on the precarious stipend of a Privatdozent, he was also no stranger to the pangs of financial instability. Although the economic ferment of Konigsberg did not enrich Kant materially, it may well have contributed to the economic model which (as few critics have noted) informs his early philosophic enterprise. Kant began his academic career as a philosopher of nature. Schooled in the rationalism of Leibniz and Wolff which dominated the Prussian",
    abstract_source = "openalex"
}

@misc{baynes1989kant,
    author = "Baynes, Kenneth",
    title = "Kant on Property Rights and the Social Contract",
    year = "1989",
    note = "CORE ARGUMENT: Baynes argues that Kant's consent to the social contract is grounded not in rational self-interest, prudence, or a natural right to self-preservation and absolute property, but in a moral obligation to institutionalize -- and thereby render peremptory -- property rights that in the state of nature possess only provisional status. He traces Kant's own earlier commitment to a labor theory of property and explains the basis for its subsequent rejection in the Rechtslehre. RELEVANCE: Directly addresses the key question of how Kant's account diverges from Locke's labor-mixing theory, situating Kant's alternative within (and against) the broader social-contract tradition rather than treating property as a self-standing topic. POSITION: Interprets Kantian property as constituting a genuine alternative to Lockean natural-rights theory within contract theory, rather than a deficient variant of it.",
    keywords = "property, social-contract, Locke-comparison, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Journal Article Kant on Property Rights and the Social Contract Get access Kenneth Baynes Kenneth Baynes State University of New York Stony Brook Search for other works by this author on: Oxford Academic PubMed Google Scholar The Monist, Volume 72, Issue 3, 1 July 1989, Pages 433–453, https://doi.org/10.5840/monist198972319 Published: 09 December 2014",
    abstract_source = "openalex"
}

@misc{hodgson2010property,
    author = "Hodgson, Louis-Philippe",
    title = "Kant on Property Rights and the State",
    year = "2010",
    note = {CORE ARGUMENT: Hodgson reconstructs the central claim of Kant's political philosophy that rational agents sharing a territory can justifiably be forced to live under a state, i.e., that they have a duty of right to leave the state of nature. He argues that this cannot be established by showing merely that the state promotes security or prosperity; Kant must instead show that human beings living side by side actually need a state in order to be free at all. RELEVANCE: Supplies a rigorous statement of exactly the "obligation of right, not merely prudence" argument the domain's key questions ask about, and does so by tying it specifically to property rather than to political authority in general. POSITION: Defends the necessity-of-the-state argument as a freedom-based (not merely welfare-based) claim, aligning with Varden's non-voluntarist reading while focusing specifically on property.},
    keywords = "property, state-of-nature, civil-condition, duty-to-exit, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The central claim of Kant's political philosophy is that rational agents sharing a territory can justifiably be forced to live under a state; they have, in Kant's words, aduty of rightto leave the state of nature. Perhaps something along these lines is entailed by any theory of state legitimacy, but the point raises special difficulties for Kant. He believes that rational agents have aright to freedom; that is, he believes that a rational agent's external freedom - her ability to set and pursue ends for herself without being subject to the choices of others - can justifiably be restricted only for the sake of external freedom itself. To establish that human beings can be forced to join a civil condition, it will therefore not do to show that the state promotes security, prosperity or any other such value: Kant has to show that human beings living side by side need a state to befree.",
    abstract_source = "openalex"
}

@misc{hasan2018provisionality,
    author = "Hasan, Rafeeq",
    title = "The provisionality of property rights in Kant's Doctrine of Right",
    year = "2018",
    abstract = "I criticize two ways of interpreting Kant's claim that property rights are merely 'provisional' in the state of nature. Weak provisionality holds that in the state of nature agents can make rightful claims to property. What is lacking is the institutional context necessary to render their claims secure. By contrast, strong provisionality holds that making property claims in the state of nature wrongs others. I argue for a third view, anticipatory provisionality, according to which state of nature property claims do not wrong others, but anticipate a condition in which the authority to make such claims can no longer be unilaterally determined.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Hasan rejects both standard readings of provisional right -- "weak" provisionality (claims are rightful but insecure) and "strong" provisionality (state-of-nature claims wrong others) -- in favor of "anticipatory provisionality": state-of-nature property claims do not wrong anyone, but they anticipate a future condition in which the authority to make such claims can no longer be fixed unilaterally. RELEVANCE: Reframes the domain's central puzzle (how can a unilateral act bind others?) by relocating the wrong-making feature from the act of acquisition itself to the unilateral character of its authority, offering a distinct middle path between the "state of nature is unjust" and "state of nature is merely insecure" readings. POSITION: A third, mediating position in the weak/strong provisionality debate that has become a standard reference point in subsequent literature (Messina, Tomassini).},
    keywords = "property, provisional-right, state-of-nature, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{messina2019provisionality,
    author = "Messina, J. P.",
    title = "Kant's Provisionality Thesis",
    year = "2019",
    abstract = "I argue that Kant's mature political philosophy entails the provisionality thesis. The provisionality thesis asserts that in a world like ours, populated with beings sufficiently like us, acquired rights (rights to external objects of choice, including property, sovereignty and territory) are necessarily provisional. I motivate the standard view, which restricts the notion of provisional right to the state of nature and the transition from the state of nature to the civil condition. I then provide two textual arguments against it. I conclude by reflecting on the normative implications of the provisionality thesis, arguing that they are more modest than has been formerly appreciated.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Against the "standard view" that confines provisional right to the state of nature and the moment of transition into civil society, Messina argues textually that all acquired rights (property, sovereignty, territory) remain provisional even within a civil condition, given beings "sufficiently like us." He then argues the normative implications of this broader provisionality thesis are more modest than commonly assumed. RELEVANCE: Extends the domain's central debate about provisional versus peremptory right beyond the state-of-nature transition itself, bearing on how permanently "concluded" property and sovereignty actually are once a state exists. POSITION: A revisionist expansion of provisionality against the "standard," transition-limited reading shared by much of the field.},
    keywords = "property, provisional-right, peremptory-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{messina2020postulate,
    author = "Messina, J. P.",
    title = "The postulate of private right and Kant's semi-historical principles of property",
    year = "2020",
    abstract = "Whereas several commentators have held that Kant's argument for the postulate of private right fails insofar as it begs the question, I argue here that this criticism misses the mark. Critics have erroneously supposed that the postulate is designed to secure a right to a system of private property. In fact, Kant's ambitions were more modest: to show that someone (be it an individual, a community, or a state) must be capable of enjoying dominion over external objects of choice. Understood this way, Kant's argument does not beg the question. Rather, it establishes clearly that freedom requires human dominion over objects, a fact that not all parties to debates over property have recognized. In response to the objection that my interpretation leaves Kant's account problematically indeterminate, I argue that the question of what system of property is justified cannot be settled from the armchair, independently of the history of acquisition.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Messina defends Kant's postulate of private right against the charge of question-begging by arguing that it aims only to establish that some agent (individual, community, or state) must be able to exercise dominion over external objects -- not to secure any particular system of private property. What system of property is actually justified, he argues, cannot be settled a priori and depends on the history of acquisition. RELEVANCE: Bears directly on the "deduction of property from practical reason" question at the center of this domain, and complicates simple readings of the postulate as directly generating individual private ownership. POSITION: A defensive, modest-reading reconstruction of the postulate against both Westphal-style usufruct critics and readers who take the postulate to beg the question in favor of private property.},
    keywords = "property, postulate-of-practical-reason, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{tomassini2023property,
    author = "Tomassini, Fiorella",
    title = "Property and the Will: Kant and Achenwall on Ownership Rights",
    year = "2023",
    abstract = "Abstract This article examines Kant's theory of property through a comparative analysis of Gottfried Achenwall's justification of ownership rights. I argue that at the core of Achenwall's and Kant's understanding of ownership rights lies the idea that rights are to be acquired through a juridical act (factum iuridicum, rechtlichen Act) of the will. However, while Achenwall thinks of this act as emerging from a private will, Kant holds that rights and obligations can only be brought about by an act of the general will. By contrasting these two views, I aim to illuminate one of the main features of Kant's theory of property, namely, that ownership rights are only possible in a rightfully constituted state. I conclude with a suggestion regarding Kant's view of the notion of 'provisional' possession in the state of nature.",
    abstract_source = "semantic\_scholar",
    note = "CORE ARGUMENT: Comparing Kant to his acknowledged source Gottfried Achenwall, Tomassini shows both thinkers ground ownership in a juridical act of will, but Achenwall locates that act in the private will of the acquirer while Kant insists it must be an act of the general (omnilateral) will -- which is only possible within a rightfully constituted state. RELEVANCE: Illuminates the historical-textual source of Kant's unilateral/ omnilateral will distinction by tracing it against the natural-law textbook (Achenwall's Ius Naturae) Kant lectured from, giving the domain's central conceptual contrast a concrete comparative anchor. POSITION: A source-critical, comparative reading that reinforces the mainstream view that Kantian ownership is only possible in a civil condition, while enriching it with Achenwall's alternative.",
    keywords = "property, Achenwall, general-will, provisional-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{slenzok2025duty,
    author = "Slenzok, Norbert and Trzcionka, Patryk",
    title = "Kant and the Duty to Stay in the State of Nature",
    year = "2025",
    abstract = "The paper tackles the question as to whether Kant has successfully substantiated his claim that there exists a moral and juridical duty to leave the state of nature. Our thesis is that he has not. In the first step, it is demonstrated that Kant's concept of provisional ownership is a logical impossibility. Thus, property rights themselves cannot generate the duty to submit to the state. The only way to argue for the duty to exit statelessness that the Kantian is left with is therefore to conceive of that duty as implied directly by the right to freedom. Yet, one may plausibly argue that at the conceptual level, public law runs afoul of Kant's notion of freedom to a greater degree than private law does. Therefore, in virtue of the innate right to freedom, a prima facie duty arises to stay in the state of nature.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Slenzok and Trzcionka contend that Kant fails to substantiate the duty to leave the state of nature. They first argue that "provisional ownership" is a logical impossibility, so property itself cannot generate the duty to submit to a state; then, turning to the innate right to freedom as the only remaining ground for the duty, they argue public law in fact constrains freedom more than private law does -- yielding, if anything, a prima facie duty to stay in the state of nature. RELEVANCE: Directly inverts the domain's near-consensus reading (shared by Hodgson, Varden, and Hasan) that leaving the state of nature is an obligation of right rather than mere prudence, making it essential for presenting the debate as genuinely contested rather than settled. POSITION: A dissenting, critical position against the mainstream "duty to exit" reading; the most recent and most direct challenge to that consensus found in this search.},
    keywords = "state-of-nature, duty-to-exit, provisional-right, dissenting, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{varden2008nonvoluntarist,
    author = "Varden, Helga",
    title = "Kant's Non-Voluntarist Conception of Political Obligations: Why Justice is Impossible in the State of Nature",
    year = "2008",
    note = {CORE ARGUMENT: Varden argues that Kant's grounds for political obligation are non-voluntarist: individuals are bound to enter and support the civil condition not because they consent (actually or hypothetically) but because justice -- meaning enforceable, reciprocally binding rights -- is conceptually impossible outside a shared, omnilateral legal authority. The state of nature is accordingly not unjust in the sense of violating rights, but simply devoid of the conditions under which rights and wrongs can be settled at all. RELEVANCE: Provides the domain's clearest and most frequently cited articulation of the claim, named explicitly in the search strategy, that the state of nature is "devoid of justice" rather than unjust, and that the transition to a civil condition is required by right rather than prudence. POSITION: The canonical non-voluntarist reading of Kantian political obligation, standing against both Hobbesian/Lockean consent-based readings and purely prudential readings of why one must leave the state of nature.},
    keywords = "state-of-nature, civil-condition, political-obligation, non-voluntarist, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In this paper, I present and defend Kant's non-voluntarist conception of political obligations. I argue that civil society is not primarily a prudential requirement for justice; it is not merely a necessary evil or a moral response to combat our corrupting nature or our tendency to act viciously, thoughtlessly or in a biased manner. Rather, civil society is constitutive of rightful relations among persons because only in civil society can we interact in ways reconcilable with each person's innate right to freedom. Civil society is the means through which we can rightfully interact even on the ideal assumption that no one ever succumbs to immoral temptation. Kant's account, therefore, provides ideal reasons to support the claim that voluntarism cannot be the liberal ideal of political obligations.",
    abstract_source = "openalex"
}

@misc{varden2010nonabsolutist,
    author = "Varden, Helga",
    title = {Kant's Non-Absolutist Conception of Political Legitimacy -- How Public Right 'Concludes' Private Right in the "Doctrine of Right"},
    year = "2010",
    note = {CORE ARGUMENT: Varden argues that public right does not merely supplement or protect an already-complete system of private right; rather, it "concludes" private right, meaning private rights remain indeterminate and incomplete claims until a public, omnilateral authority renders them determinate and enforceable. Political legitimacy is accordingly non-absolutist: it is conditioned on the state's actually performing this concluding function. RELEVANCE: Gives the clearest available statement of the private-right/ public-right architecture that structures the whole of this domain, directly matching the search strategy's expected coverage of "how the private right/public right distinction" works in the Doctrine of Right. POSITION: A structural, architectural reading of the Rechtslehre in which private and public right are conceptually interdependent rather than sequential or merely instrumental.},
    keywords = "private-right, public-right, civil-condition, architecture, High, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Contrary to the received view, I argue that Kant, in the “Doctrine of Right”, outlines a third, republican alternative to absolutist and voluntarist conceptions of political legitimacy. According to this republican alternative, a state must meet certain institutional requirements before political obligations arise. An important result of this interpretation is not only that there are institutional restraints on a legitimate state's use of coercion, but also that the rights of the state (‘public right’) are not in principle reducible to the rights of individuals (‘private right’). Thus, for Kant, political obligations are intimately linked to the existence of a certain kind of republican institutional framework.",
    abstract_source = "openalex"
}

@misc{varden2024leaving,
    author = "Varden, Helga",
    title = "Leaving the State of Nature. Strengths and Limits of Kant's Transformation of the Social Contract Tradition",
    year = "2024",
    note = {CORE ARGUMENT: Revisiting the "duty to exit" thesis she first defended in 2008, Varden here explicitly assesses both the strengths and the limits of Kant's transformation of social-contract theory in grounding the obligatory transition out of the state of nature, engaging more recent objections to the standard non-voluntarist reading. RELEVANCE: A recent (2024), self-critical restatement of the central "obligation of right, not prudence" argument that the key questions ask about, useful for showing how the debate has developed since Varden's original 2008 article and Hodgson's 2010 piece. POSITION: A qualified defense-with-revisions of the non-voluntarist "duty to exit" position, situated to respond to newer critiques such as Slenzok and Trzcionka (2025).},
    keywords = "state-of-nature, civil-condition, social-contract, duty-to-exit, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "I first outline how Kant’s ideal account of rightful external freedom transforms the social contract tradition as found in the works of Hobbes, Locke, and Rousseau, before proposing a way to see Kant’s two-layered non-ideal theory as complementing his ideal theory of rightful freedom. This enables us to envision a conception of rightful external freedom and of rightful human freedom in particular societies. These arguments also show us the importance of realizing that the four possible political conditions for Kant – anarchy, barbarism, despotism, and republic – are ideas of reason, which means that they are never perfectly realized. Hence, historical societies are not either in the state of nature or in civil society, and in historical republics, there are pockets of injustice or pockets devoid of justice that can only be captured by means of one of the three political ideas that are not constitutive of the republican legal-political framework.",
    abstract_source = "openalex"
}

@misc{ripstein2004authority,
    author = "Ripstein, Arthur",
    title = "Authority and Coercion",
    year = "2004",
    note = {CORE ARGUMENT: Ripstein's article-length statement (predating and later expanded into the "Three Defects in the State of Nature" and "Public Right" chapters of Force and Freedom) of the thesis that public, institutional authority is a necessary condition of each person's freedom, not merely a practical remedy for the inconveniences or insecurities of statelessness. As reviewers of the subsequent book put it, the argument turns on showing that the state of nature has defects that only legal and political institutions -- not better individual behavior -- can resolve. RELEVANCE: Supplies the influential, freedom-based (rather than security-based) version of the argument that a civil condition is required by right, complementing Varden's and Hodgson's independently argued versions of the same conclusion and giving the domain's "obligation of right, not prudence" theme its most widely cited advocate. POSITION: A freedom-as-independence-based argument for the necessity of public authority, foundational for Ripstein's later, more systematic treatment in Force and Freedom (already catalogued in Domain 1) and extensively discussed and contested by Valentini, Sangiovanni, and Ebels-Duggan in subsequent critical literature.},
    keywords = "authority, coercion, state-of-nature, civil-condition, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{ebelsduggan2012kants,
    author = "Ebels-Duggan, Kyla",
    title = "Kant's Political Philosophy",
    year = "2012",
    note = "CORE ARGUMENT: A survey article situating Kant's political theory within the social-contract tradition while marking its central departure from Hobbes and Locke: for Kant we have not merely a pragmatic reason but an obligation to exit the state of nature and found a state. The second half surveys points of live controversy, including how the innate right to freedom is supposed to support the postulate permitting acquisition of property and other private rights. RELEVANCE: Functions as a compact overview connecting the domain's property/acquisition material back to the innate right to freedom discussed in Domain 1, and explicitly frames the postulate-of-property question as one of the field's open controversies rather than a settled matter. POSITION: A synoptic overview rather than an original interpretive intervention, useful for orienting readers among the domain's competing positions.",
    keywords = "overview, state-of-nature, property, postulate, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{angell2019property,
    author = "Angell, Kim",
    title = "Property and Territorial Rights in Political Philosophy",
    year = "2019",
    howpublished = "Oxford Research Encyclopedia of Politics",
    abstract = "To have property rights over X is to have rights to determine, in some respect, what shall happen to X, for example a piece of land. To have territorial rights is to have rights to make, enforce, and adjudicate the law within a geographical area. Property and territorial rights thus seem closely related, and philosophical accounts reveal various interesting connections between these bundles of rights -- both in their nature and justification. A significant division, which we find in both old and new accounts -- of property as well as territory -- originates in the diverging political philosophies of John Locke and Immanuel Kant. Lockean accounts regard property and territorial rights as natural. People may acquire both without the prior existence of an adjudicating political authority. Kantian accounts, however, regard property rights as pure legal conventions. Non-existent outside civil society, they must be fully constructed by a state with territorial (jurisdictional) rights. Further divisions exist within Lockean and Kantian theories, and all the most prominent theories -- of property as well as territorial rights -- face significant unresolved philosophical challenges.",
    abstract_source = "semantic\_scholar",
    note = "CORE ARGUMENT: Angell's reference-work overview frames the Locke/Kant divide in political philosophy of property precisely along the axis this domain investigates: Lockean accounts treat property and territorial rights as natural and acquirable prior to political authority, while Kantian accounts treat property rights as pure legal conventions, non-existent outside civil society and requiring full construction by a territorially jurisdictional state. RELEVANCE: Offers a concise, explicitly comparative statement of exactly the Locke-versus-Kant contrast the domain's first key question asks about, and extends it usefully to territorial rights, a topic adjacent to but not covered elsewhere in this domain's selections. POSITION: A neutral, comparative reference overview rather than an advocacy piece for either the Lockean or Kantian camp.",
    keywords = "property, territorial-rights, Locke-comparison, overview, Medium, METADATA\_CLEANED: doi"
}

@misc{westphal1997kant,
    author = "Westphal, Kenneth R.",
    title = "Do Kant's Principles Justify Property or Usufruct?",
    year = "1997",
    note = {CORE ARGUMENT: Westphal argues, against the mainstream reading (including Gregor's), that Kant's postulate of practical reason regarding external objects supports only a right to use objects -- a form of usufruct -- rather than a full right of property in the strict, exclusive sense. RELEVANCE: Cited directly in SEP's "Property and Contract Right" section as a counterpoint immediately following the presentation of Kant's postulate, making it essential for representing the domain's minority but scholarly serious dissent from the standard "Kant justifies full property" reading. POSITION: A critical, minority position holding that Kant's argument is weaker than usually assumed -- justifying use-rights rather than ownership -- against Gregor, Hodgson, and the mainstream reading.},
    keywords = "property, usufruct, postulate-of-practical-reason, dissenting, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy," section 5 (Property and Contract Right), immediately after the exposition of the postulate of practical reason regarding external objects: "Westphal 1997 argues that Kant's claim supports only a right to use, not a right of property."}
}

@misc{wilson2004marriage,
    author = "Wilson, Donald",
    title = "Kant and the Marriage Right",
    year = "2004",
    note = {CORE ARGUMENT: Wilson examines how Kant's provision of a distinctive "marriage right" -- part of the third category of private right, the "right to a person akin to a right to a thing" -- initially seems difficult to reconcile with the general concern to secure external freedom of action that grounds the sole innate right and the rest of private right. RELEVANCE: Directly addresses how domestic right (marriage) fits within the architecture of private right, the third key question of this domain, by treating the tension between Kant's marriage doctrine and his own freedom-based foundations as a genuine interpretive problem rather than an embarrassing aside. POSITION: A close, sympathetic-but-critical reading that takes the marriage right seriously as systematic political philosophy rather than dismissing it as an idiosyncratic lapse.},
    keywords = "domestic-right, marriage, private-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract: The provision of a marriage right is a distinctive aspect of Kant's political philosophy and seems, initially, difficult to reconcile with the general concern with ensuring external freedom of action apparent in the universal principle of Right and the sole innate right said to follow from this principle. I claim that this provision can be regarded as consistent with this general focus and that Kant's treatment of issue suggests an interesting secular argument for the institution of marriage.",
    abstract_source = "openalex"
}

@misc{varden2012kantian,
    author = "Varden, Helga",
    title = "A Kantian Critique of the Care Tradition: Family Law and Systemic Justice",
    year = "2012",
    note = "CORE ARGUMENT: Varden develops a Kantian account of family law grounded in systemic (public) justice rather than in an ethics of care, arguing that household and family relations -- like property and contract -- require public, enforceable legal structures rather than being left to private moral sentiment alone. RELEVANCE: Extends the domain's private-right/public-right architecture (which Varden herself mapped in her 2010 article) specifically to domestic right and family law, directly engaging the key question of how household relations fit within the private right/civil condition framework. POSITION: A Kantian, systemic-justice-based critique of care-ethics approaches to family law, continuous with her broader non-voluntarist, civil-condition-centered reading of Kant's political philosophy.",
    keywords = "domestic-right, family-law, private-right, public-right, Medium, METADATA\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Liberal theories of justice have been rightly criticized for two things by care theorists. First, they have failed to deal with private care relations’ inherent (inter)dependency, asymmetry and particularity. Second, they have been shown unable properly to address the asymmetry and dependency constitutive of care workers’ and care-receivers’ systemic conditions. I apply Kant’s theory of right to show that current care theories unfortunately reproduce similar problems because they also argue on the assumption that good care requires only virtuous private individuals. Giving up this assumption enables us to solve the problems regarding both private care relations and systemic injustice.",
    abstract_source = "openalex"
}

@misc{pascoe2024kantian,
    author = "Pascoe, Jordan",
    title = "A Kantian Theory of Employment, or How Domestic Right Structures Contemporary Work: A Reply to Williams",
    year = "2024",
    abstract = "This article shows how Kant's framework of domestic right can be understood as a model for modern employment law, a suggestion made by Garrath Williams in a commentary on Kant's Theory of Labour. I begin by exploring how Kant's historical context informed his account of labor relations and argue that he made three key innovations: the theorization of domestic right, the linkage of work and political standing, and the development of contract right to make sense of the material dependency and formal equality of 'free' contract workers. This account of contract-based work, however, sketches a dangerous 'fantasy' of free contract that we see echoed in contemporary defenses of the gig economy. I show that this argument is central to understanding Kant's evolving conception of the relationship between labor and citizenship, but I defend the claim that modern employment resembles domestic right more closely than contract right, by attending to both the formal structures of modern employment law and the lived experiences of professional employment in the digital age. Finally, I explore how drawing on the domestic model for understanding modern employment can help us to see the limits of both Kantian and contemporary accounts of the public good, by highlighting the ways that public law is deployed to formalize asymmetrical relations of dependence, to check their capacity for exploitation and domination.",
    abstract_source = "semantic\_scholar",
    note = {CORE ARGUMENT: Pascoe argues that modern employment relations resemble Kant's domestic right (the household relation of master and servant) more closely than his contract right, since domestic right's formal, hierarchical structure better captures the material dependency underlying supposedly "free" contract-based work than contract right's formal equality does. RELEVANCE: Directly shows how the third category of Kant's private right -- "right to a person akin to a right to a thing," which also covers marriage and parent-child relations -- continues to do interpretive work in contemporary Kantian scholarship, illuminating the domain's third key question about how domestic right, contract, and household relations fit together within private right. POSITION: A contemporary, labor-theoretic application of Kant's domestic right/contract right distinction, responding directly to and building on Williams's (2024) commentary.},
    keywords = "domestic-right, contract-right, labor, private-right, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{williams2024employment,
    author = "Williams, Garrath",
    title = "Employment, status, hierarchy: on Jordan Pascoe, Kant's Theory of Labour",
    year = "2024",
    note = "CORE ARGUMENT: Responding to Pascoe's Kant's Theory of Labour, Williams argues that her typology of paid work (drawn from Kant's categories of private right) underplays the tension between employment relations and Kantian innate equality, in part because it does not accommodate professional work and in part because it ignores the distinctively hierarchical legal form of employment -- which, he argues, brings employment closer to domestic right than to contract right. RELEVANCE: Forms a paired exchange with Pascoe (2024) that stages, in miniature, the domain's broader question of how domestic right and contract right are to be distinguished and applied, showing the distinction remains contested even among sympathetic Kantian interpreters. POSITION: A friendly-amendment critique of Pascoe's application of domestic right to employment, sharing her general framework while disputing its scope.",
    keywords = "domestic-right, contract-right, labor, private-right, Low, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article responds to Jordan Pascoe’s Kant’s Theory of Labour, with its twin focus on labour and intersecting forms of injustice. I open with some admiring remarks as to why her focus proves so fruitful and insightful. In the following sections, I offer a friendly amendment to Pascoe’s account, focussing on paid work in democratic states. Like Pascoe, I believe that employment relations stand in basic tension with Kantian innate equality. However, I also believe that her account underplays this tension. To make this case, I offer two reservations about the typology of paid work which Pascoe draws from Kant’s work. First, this typology does not accommodate professional work, although Kant considers this in several places. Second, it ignores the distinctive legal form of employment, which is hierarchical. This brings employment closer to Kant’s account of domestic right than to his account of contract. Assuming that employment hierarchies are essential to organising people’s social contributions, I suggest this hierarchy requires formal counterbalancing measures. From an intersectional perspective, such measures are especially important, as labour organisers everywhere have shown.",
    abstract_source = "s2"
}

@misc{caranti2023why,
    author = "Caranti, Luigi",
    title = "Why does Kant Think that Democracy is Necessarily Despotic?",
    year = "2023",
    note = {CORE ARGUMENT: Against the standard defusing move that Kant's hostility to democracy targets only direct democracy, Caranti argues that Kant's remark that the republican constitution must not be "confused with the democratic one" tells against democracy more broadly, including representative forms closer to contemporary ones. The article reconstructs what Kant actually takes to be objectionable in democratic rule -- the fusion of legislative and executive will in "the people" -- rather than the size or directness of the electorate. RELEVANCE: Directly frames the key question of whether Kant is a proto-democrat: Caranti's answer is a qualified no, since the objection to democracy is structural (fusion of powers) rather than merely about scale or directness of participation. POSITION: Anti-democratic-republicanism reading; the despotism worry attaches to any regime, however elected, in which the same body legislates and executes.},
    keywords = "republicanism, democracy, despotism, separation-of-powers, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Kant's criticism of democracy has been traditionally defused with the consideration that Kant's aversion is not to democracy per se, but to direct democracy. However, what Kant says -- 'to prevent the republican constitution from being confused with the democratic one, as commonly happens' (ZeF, 8: 351) -- appears to count not only against direct democracy, but also against conceptions of democracy closer to the ones we are accustomed to. By offering a new account of what Kant sees as the real problem of democracy (direct or not), the article unpacks a lesson about the limits of democracy that has gone largely unnoticed among political theorists and Kant specialists.",
    abstract_source = "s2"
}

@misc{harel2022kantian,
    author = "Harel, Alon",
    title = "The Kantian case against democracy",
    year = "2022",
    note = "CORE ARGUMENT: Responding to Chiara Cordelli's Kantian defense of democratic legitimacy, Harel argues the relationship between Kantian legitimacy and democratic decision-making is contingent rather than necessary: democratic authorization is neither necessary nor sufficient for legitimate governance on Kantian grounds, and may sometimes be detrimental to it. RELEVANCE: A direct contribution to the contemporary debate (with Cordelli, Stilz, Caranti) over whether Kantian premises entail a duty to democratic rule; supplies the skeptical pole against readings that treat Kant as a proto-democrat. POSITION: Skeptical/anti-necessitarian view of the Kant-democracy connection, in explicit dialogue with Cordelli's Kantian democratic legitimacy thesis.",
    keywords = "democracy, legitimacy, republicanism, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "ABSTRACT Contrary to what Cordelli argues, the relationship between Kantian legitimacy and democratic decision-making is contingent rather than necessary. This paper counters the connection between Kantian legitimacy and democracy in three ways: by arguing that democratic authorization is (i) not necessary, (ii) not sufficient, and indeed may be (iii) detrimental to, legitimate governance.",
    abstract_source = "s2"
}

@misc{hanisch2016kant,
    author = "Hanisch, Christoph",
    title = "Kant on Democracy",
    year = "2016",
    note = "CORE ARGUMENT: Hanisch offers a systematic reconstruction of Kant's tripartite classification of sovereignty (autocracy/aristocracy/democracy) crossed with government (republican/despotic), examining why Kant singles out democracy as especially prone to despotism and what, if anything, redeems representative arrangements. RELEVANCE: Provides a detailed textual and systematic treatment of the exact typology (forms of sovereignty x forms of government) that this domain's key questions turn on, complementing the more polemical Caranti/Harel exchange. POSITION: Reconstructive/exegetical treatment situating Kant's anti-democratic remarks within his broader systematic distinction between sovereignty and government, while arguing Kant's own premises (the innate right of humanity) actually support democratic procedures as non-optional.",
    keywords = "democracy, republicanism, forms-of-government, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Abstract: The first part of this paper analyzes Kant's remarks on state forms. It is true that Kant uses the term "democracy" in a pre-modern sense, denoting a radical form of despotic sovereignty that is incompatible with representative government and the separation of powers. In addition, he makes clear that it is only in non-ideal conditions that the provisional standards of republican legitimacy are less stringent than those that apply in ideal circumstances. These qualifications notwithstanding, the first part concludes that Kant fails to consider a satisfying conception of democratic sovereignty. In the remainder of this paper, I first develop this criticism in terms of the neglect of procedural (in contrast to substantive) criteria of republican legitimacy in Kant: a public norm's normative status is determined, partly but necessarily, by the procedures that led to its enactment. Second, I show that the multifarious aspects of the one innate right of humanity (independence, equality, the duty of rightful honor, etc.) provide sufficient grounds for identifying democratic procedures as non-optional features of a Kantian republic.},
    abstract_source = "openalex"
}

@misc{shell2025representation,
    author = "Shell, Susan",
    title = "Representation and Democracy in the Metaphysics of Morals: Kant's Late Answer to the `Problem' of Sovereignty",
    year = "2025",
    note = {CORE ARGUMENT: Shell argues that Kant's mature position (Metaphysics of Morals, 1797) marks a shift from the hypothetical consent of his works from the mid-1780s toward favoring the people's actual consent to the laws, and that reading the text as a practical historical intervention (not only a theoretical treatise) yields an internally coherent argument for a peculiar, "organic" form of representative democracy. RELEVANCE: Offers the strongest textual case among the papers surveyed here for treating Kant as a proto-democrat, directly engaging the first key question; stands in tension with Caranti's and Harel's readings. POSITION: Developmental/proto-democratic reading -- Kant's late Rechtslehre evolves toward endorsing a peculiar form of representative democracy.},
    keywords = "representation, democracy, sovereignty, popular-sovereignty, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract A rightful condition, according to Kant, requires both a law to limit the freedom of each and a ruler to enforce that limit, a ruler who cannot himself be subject to the law's enforcement without ceasing to perform his primary function. Kant placed his hopes, circa 1784, in a future ruler who combined worldly experience, a 'correct conception' of a possible constitution, and, above all, the good will to accept it. Subsequent historical events, along with the 'completion' in 1790 of Kant's own critical system, suggested a new basis for confidence in civil progress no longer ultimately dependent on the 'good will' of rulers, while also making new demands on citizens themselves. I share the view of many others that Kant came to prefer the people's actual consent to the laws over the merely hypothetical consent that he endorsed in the works of the mid-1780s. My reading of the Metaphysics of Morals Part One differs in treating the work not only as a theoretical treatise but also, and necessarily, a practical intervention in historical time. The resulting reading yields an internally coherent argument favouring representative democracy of a peculiar kind -- one whose 'organic' character has not been fully appreciated.",
    abstract_source = "s2"
}

@misc{marey2018ideal,
    author = "Marey, Macarena",
    title = "The Ideal Character of the General Will and Popular Sovereignty in Kant",
    year = "2018",
    note = {CORE ARGUMENT: Marey argues Kant distances himself from Hobbesian and Rousseauian foundations of sovereignty through two theses: the ideality of the general will (it is a rational idea, not an empirical fact) and the apriority of the justification of popular sovereignty. Sovereignty is grounded, on this reading, in an a priori unified "omnilateral will" rather than any actual collective decision procedure. RELEVANCE: Clarifies the conceptual machinery -- the idea of an "omnilateral will" -- that underlies Kant's claim that "sovereignty belongs solely to the united will of the people" while simultaneously resisting direct popular participation in law-making, bearing on both the republicanism/democracy question and popular sovereignty. POSITION: Reconstructs popular sovereignty as an a priori regulative idea rather than an empirical/procedural doctrine, distinguishing Kant from both Hobbes and Rousseau.},
    keywords = "popular-sovereignty, general-will, republicanism, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract In this paper, I examine Kant's reception of and solution to the problem of the unity of the political will. I propose that Kant distances himself from the modern paradigmatic foundations of sovereignty principally with his theses of the ideality of the general will (section II) and of the apriority of the justification of popular sovereignty (section III). My interpretative hypothesis is that Kant solves the problem by grounding sovereignty in a conceptual element which is new in the history of political philosophy, i.e. the a priori unified omnilateral will. In section IV, I explain why my reading of the ideality of the general will can respond to seemingly plausible objections arising from Kant's own texts and how it works in the face of concrete political states of affairs.",
    abstract_source = "s2"
}

@misc{guyer2012hobbes,
    author = "Guyer, Paul",
    title = "``Hobbes Is of the Opposite Opinion'' Kant and Hobbes on the Three Authorities in the State",
    year = "2012",
    note = "CORE ARGUMENT: Guyer contrasts Kant's insistence on the necessary separateness of legislative, executive, and judicial authority within the state with Hobbes's unitary conception of sovereignty, tracing how Kant departs from Hobbes precisely on the question of whether divided authority is compatible with, or is required by, secure lawful freedom. RELEVANCE: Central source for the second key question: whether separation of powers is a normative requirement of Right and not merely an institutional convenience, examined through direct comparison with Kant's primary interlocutor on sovereignty, Hobbes. POSITION: Separation-of-powers-as-normatively-required reading, developed via systematic contrast with Hobbesian unitary sovereignty.",
    keywords = "separation-of-powers, Hobbes, sovereignty, Rechtsstaat, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Like Hobbes and unlike Locke, Kant denied the possibility of a right to rebellion. But unlike Hobbes, Kant did not argue for a unitary head of state in whom legislative, judicial, and executive powers are inseparable, and thus did not believe that the executive power in a state to whom must be conceded a monopoly of coercion also defines all rights in the state. Instead, Kant insisted upon the necessary division of authority in a state into a separate legislature, executive, and judiciary, and thus, while rejecting the idea that a people could ever rightfully overthrow their entire constitution or government, he could and did hold that a people represented by a parliament have genuine rights against the executive power within their state even though that executive power properly has a monopoly on the coercive enforcement of the parliament's laws.",
    abstract_source = "openalex"
}

@misc{weinrib2019principles,
    author = "Weinrib, Jacob",
    title = "The Principles of Constitutional Reform",
    year = "2019",
    note = "CORE ARGUMENT: Responding to the erosion of democratic and constitutionalist commitments in legal orders worldwide, Weinrib argues that leading political and constitutional theories are indifferent to the emergence, maintenance, and refinement of liberal democratic constitutional orders, and draws on Kant's constitutional theory to explain why realizing such governance is a public duty and receding from it a public wrong. RELEVANCE: Develops the normative stakes of the Rechtsstaat ideal for contemporary constitutional theory, treating Kant's account of divided, lawful authority as underwriting an affirmative duty of constitutional maintenance and reform rather than a static institutional blueprint. POSITION: Kantian constitutionalist reading that treats the Rechtsstaat as generating ongoing public duties of constitutional maintenance and reform, not merely a one-off founding achievement.",
    keywords = "Rechtsstaat, constitutionalism, rule-of-law, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract In legal orders around the world, commitments to democracy, liberalism and constitutionalism are increasingly eroding. Although political and constitutional theorists often lament this trend, they invariably adopt frameworks that are indifferent to these commitments. My aims in this article are both critical and constructive. As a critical matter, I will expose the indifference of the leading political and constitutional theories to the emergence, maintenance and refinement of liberal democratic constitutional orders. As a constructive matter, I will draw on Immanuel Kant's constitutional theory to explain why realizing such a form of governance is a public duty and why receding from it is a public wrong.",
    abstract_source = "s2"
}

@misc{weinrib2008kant,
    author = "Weinrib, Jacob",
    title = "Kant on Citizenship and Universal Independence",
    year = "2008",
    note = {CORE ARGUMENT: Weinrib examines Kant's account of citizenship as grounded in the "independence" (Selbstandigkeit) that qualifies a person for active civic status, arguing that Kant's active/passive citizenship distinction sits in tension with the very idea of universal independence it is meant to secure, since property-based independence for some citizens can enable domination of others. RELEVANCE: A foundational treatment (49 citations per Semantic Scholar) of the independence criterion underlying the active/passive citizenship distinction, providing the conceptual baseline against which later papers (Vrousalis, Moran, Davies, Widmer) test and revise the reading. POSITION: Internal-tension reading: the independence criterion that justifies active citizenship can itself generate relations of domination that violate the universal independence Kant's theory is meant to guarantee.},
    keywords = "citizenship, active-passive-citizens, independence, domination, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, type:@article->@misc, METADATA\_CLEANED: volume"
}

@misc{vrousalis2022interdependent,
    author = "Vrousalis, Nicholas",
    title = "Interdependent Independence: Civil Self-Sufficiency and Productive Community in Kant's Theory of Citizenship",
    year = "2022",
    note = {CORE ARGUMENT: Vrousalis argues that Kant's triptych of citizenship -- freedom, equality, and civil self-sufficiency (Selbstandigkeit) -- is best read as "interdependent independence": the independent possession and use of citizens' interdependent rightful (productive) powers within a republic of independent commodity producers. This reading, he argues, consistently explains (without endorsing) Kant's disenfranchisement of women, wage laborers, and landless farmers. RELEVANCE: Offers a structural, economically-inflected account of why Kant excludes certain classes from active citizenship, positioned as an alternative to purely republican, libertarian, or proprietarian interpretations of the Kantian state -- directly bearing on how troubling and how systematic the passive-citizen exclusion is. POSITION: "Interdependent independence" reading of civil self-sufficiency, explicitly contrasted with republican non-domination and libertarian/proprietarian interpretations.},
    keywords = "citizenship, active-passive-citizens, self-sufficiency, domination, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc, METADATA\_CLEANED: volume",
    abstract = "Abstract Kant's theory of citizenship replaces the French revolutionary triptych of liberty, equality and fraternity with freedom (Freiheit), equality (Gleichheit) and civil self-sufficiency (Selbstandigkeit). The interpretative question is what the third attribute adds to the first two: what does self-sufficiency add to free consent by juridical equals? This article argues that Selbstandigkeit adds the idea of interdependent independence: the independent possession and use of citizens' interdependent rightful powers. Kant thinks of the modern state as an organism whose members are agents possessed of rightful (productive) powers, whose interdependent mode of exercise independently of unilateral permission matters for right. The empirical form of that ideal, according to Kant, is a republic of independent commodity producers. I will show that this reading of Selbstandigkeit can consistently explain Kant's disenfranchisement of women, wage labourers and landless farmers; that it offers a robust alternative to influential republican, libertarian and proprietarian interpretations of the Kantian state; and that it can buttress an original account of community as productive interdependence.",
    abstract_source = "s2"
}

@misc{moran2021kant,
    author = "Moran, Kate A.",
    title = "Kant on Traveling Blacksmiths and Passive Citizenship",
    year = "2021",
    note = "CORE ARGUMENT: Moran focuses on one puzzling subset of Kant's passive-citizen examples -- traveling blacksmiths, barbers, and day laborers -- to test whether Kant's stated rationale (political and economic self-sufficiency) actually accounts for his classifications. She argues that in at least some cases Kant's concerns about dependence are pragmatic rather than genuinely political. RELEVANCE: A close, example-driven interrogation of whether the active/passive citizenship line is principled or ad hoc, directly addressing how well commentators can reconcile Kant's specific exclusions with his stated egalitarian rationale. POSITION: Qualifying/deflationary reading: some of Kant's passive-citizenship exclusions track pragmatic concerns about itinerancy rather than a consistent political principle of dependence.",
    keywords = "citizenship, active-passive-citizens, suffrage, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Kant makes and elaborates upon a distinction between active citizenship and passive citizenship. Active citizens enjoy the right to vote and rights of political participation generally. Passive citizens do not, though they still enjoy the protection of the law as citizens. Kant's examples have left commentators puzzling over how these distinctions follow from his stated rationale or justification for active citizenship, namely, that active citizens possess a kind of political and economic self-sufficiency. This essay focuses on one subset passive citizenry -- that of traveling blacksmiths, barbers, and day laborers in order to examine Kant's distinctions. I argue that these examples show that Kant's concerns regarding dependence are, at least in some cases, pragmatic rather than political.",
    abstract_source = "s2"
}

@misc{davies2023kant,
    author = "Davies, Luke",
    title = "Kant on Civil Self-Sufficiency",
    year = "2023",
    note = "CORE ARGUMENT: Davies argues that Kant attributes civil self-sufficiency to those not under the authority of any private individual for their survival -- a reading focused on relations of authority rather than economic relations alone, which he argues is more textually grounded than the dominant economic reading. On this view, Kant's active/passive distinction responds to a concern about eliminating corruption in public lawgiving. RELEVANCE: Provides a rival account to Vrousalis's and Weinrib's readings of the independence criterion, shifting the explanatory burden from economic dependence to relations of private authority, with direct implications for how principled (or not) the passive-citizen exclusion is. POSITION: Authority-relational reading of civil self-sufficiency, contrasted with dominant economic-dependence readings; frames the active/passive distinction as anti-corruption rather than purely economic.",
    keywords = "citizenship, active-passive-citizens, self-sufficiency, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Kant distinguishes between 'active' and 'passive' citizens and holds that only the former are civilly self-sufficient and possess rights of political participation. Such rights are important, since for Kant state institutions are a necessary condition for individual freedom. Thus, only active citizens are entitled to contribute to a necessary condition for the freedom of each. I argue that Kant attributes civil self-sufficiency to those who are not under the authority of any private individual for their survival. This reading is more textually grounded than the dominant reading, which understands civil self-sufficiency in terms of economic relations alone. I further argue that Kant was interested in relations of authority because he was concerned to eliminate certain forms of corruption. This indicates that Kant's contested distinction between active and passive citizens was a response to a key problem of any account of public lawgiving.",
    abstract_source = "s2"
}

@misc{widmer2025kants,
    author = "Widmer, Elisabeth Theresia",
    title = "Kant's Republican Account of Citizenship",
    year = "2025",
    note = "CORE ARGUMENT: Widmer argues that, without dismissing the sexist and classist prejudices embedded in Kant's active/passive dichotomy, Kant introduces the distinction with the republican aim of securing a state governed by non-arbitrary laws; on her reading this explains Kant's concern with the civic character of citizens and their capacity to contest domination, aligning him with contemporary neo-republicanism more closely than is usually acknowledged. RELEVANCE: Directly engages the third key question by neither excusing nor simply condemning the passive-citizen exclusion, instead arguing that its underlying republican rationale (securing non-arbitrary law) is continuous with, though its application falls short of, contemporary neo-republican commitments to non-domination. POSITION: Neo-republican rational-reconstruction: the aim behind the active/passive distinction is defensible non-domination theory even though the historical application is not.",
    keywords = "citizenship, active-passive-citizens, republicanism, neo-republicanism, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Kant's political philosophy has experienced a recent revival, largely due to influential interpretations that frame his concept of right as a republican account of "non-domination." One of the major challenges in reconstructing Kant's concept of law within neo-republican terms is his notion of citizenship. While neo-republicans have made substantial efforts to distance themselves from the traditional view that restricted voting rights to mainstream white men, Kant's distinction between "active" and "passive" citizens still echoes this conventional line of thought. Without dismissing the prevalence of the sexist and classist prejudices inherent in Kant's active/passive dichotomy, this paper argues that Kant introduces this distinction with the republican aim of securing a state governed by non-arbitrary laws. I contend that this aim explains Kant's concern with the civic character of citizens and their ability to contest structures of domination -- a line of argument that aligns him more closely with contemporary neo-republicanism.},
    abstract_source = "s2"
}

@misc{messina2021kant,
    author = "Messina, J. P.",
    title = "Kant against Legal Paternalism: A Conditional Defense",
    year = "2021",
    note = {CORE ARGUMENT: Messina offers a conditional defense of reading Kant as opposed to legal paternalism, addressing how far the "no one can compel me to be happy in his own way" commitment extends as a constraint on legitimate state action, and under what conditions (if any) ostensibly paternalistic legal measures remain compatible with it. RELEVANCE: Directly addresses the paternalism strand of the key questions, testing the scope and limits of Kant's anti-paternalism as a principle of Right rather than treating it as an unqualified slogan. POSITION: Conditional/qualified anti-paternalist reading: Kant's opposition to paternalism is real but does not straightforwardly rule out all state measures that might appear paternalistic.},
    keywords = "paternalism, happiness, autonomy, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{rosen1993kants,
    author = "Rosen, Allen D.",
    title = "Kant's Theory of Justice",
    year = "1993",
    address = "Ithaca",
    note = "CORE ARGUMENT: Rosen's study examines the basic elements of Kant's theory of justice and the principles determining the functions and responsibilities of the just state, focusing on the relation among justice, political authority, and individual liberty -- including Kant's rejection of paternalistic justifications for state power and his account of the limits within which coercive law-making may be justified. RELEVANCE: A foundational monograph-length treatment (cited in the SEP bibliography on Kant's social and political philosophy) bearing directly on the paternalism question and on how Kant's account of political authority is meant to remain compatible with individual liberty despite extensive state coercive power. POSITION: Liberal reconstruction of Kant's theory of justice emphasizing the compatibility of extensive coercive state authority with individual liberty and anti-paternalism.",
    keywords = "paternalism, justice, political-authority, liberty, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@misc{maliks2015kants,
    author = "Maliks, Reidar",
    title = "Kant's Politics in Context",
    year = "2015",
    address = "New York",
    note = {CORE ARGUMENT: Maliks situates Kant's political philosophy within the immediate context of debates among his contemporaries and students (the "Kantian school" of the 1790s) over republicanism, citizenship, and the right of resistance, showing how Kant's own positions were formed in dialogue with, and sometimes in reaction against, more radical democratic readings of his principles advanced by figures like Erhard and Bergk. RELEVANCE: Supplies essential historical context for assessing whether Kant's republicanism is best read as proto-democratic or not, since Kant's own most immediate followers pushed his principles toward more egalitarian and democratic conclusions than Kant himself accepted. POSITION: Contextualist/historical reading emphasizing the gap between Kant's official positions and the more radical-democratic readings of Kantian principles advanced by his own students.},
    keywords = "republicanism, historical-context, citizenship, democracy, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@misc{ellis2005kants,
    author = "Ellis, Elizabeth",
    title = "Kant's Politics: Provisional Theory for an Uncertain World",
    year = "2005",
    address = "New Haven",
    note = {CORE ARGUMENT: Ellis argues that Kant's political philosophy is best understood as a "provisional" theory -- one that offers principled but revisable guidance for political action under conditions of uncertainty, rather than a static blueprint for an ideal constitutional order, reframing debates over Kant's conservatism about revolution and reform. RELEVANCE: Bears on how the republican ideal and the separation of powers function normatively: as regulative standards guiding gradual institutional reform rather than as a fixed, once-and-for-all achieved constitutional form, which reframes the proto-democrat question in terms of an evolving rather than static Kantian republicanism. POSITION: "Provisionalist" reading of Kant's political philosophy as action-guiding under non-ideal conditions rather than as a static ideal theory.},
    keywords = "republicanism, provisional-right, political-reform, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@unpublished{westphal2015republicanism,
    author = "Westphal, Kenneth R.",
    title = "Republicanism, Despotism, And Obedience To The State: The Inadequacy Of Kant's Division Of Powers",
    year = "2015",
    howpublished = "\url{https://philpapers.org/rec/WESRDA-3}",
    note = {CORE ARGUMENT: Westphal argues that Kant's doctrine of the division of governmental powers and his doctrine of absolute obedience to the state are incompatible: Kant's defense of unconditional obedience undermines his own separation-of-powers theory. Westphal contends a constitutional court is crucial to a genuine republic, that Kant's account of divided powers was theoretically behind his own times, and that Kant's account conflates separation of powers with a system of checks and balances. RELEVANCE: Provides the sharpest internal critique available of whether separation of powers can really function as a normative safeguard against despotism given Kant's simultaneous insistence on absolute obedience and rejection of a right of resistance -- directly addressing the second key question. POSITION: Internal-inconsistency critique: Kant's absolute-obedience doctrine is incompatible with, and undermines, his own division-of-powers theory. NOTE ON STATUS: Listed on PhilPapers without a separate published journal or book venue; treated here as a manuscript. Distinct from Westphal's related, formally published 2017 book chapter "Kant on the State, Law, and Obedience to Authority in the Alleged `Anti-Revolutionary' Writings" (in Kant and Law, Routledge), which was not itself found via the search scripts used here and so is not separately cited.},
    keywords = "separation-of-powers, obedience, despotism, republicanism, Medium, INCOMPLETE, no-abstract"
}

@misc{gregory2023does,
    author = "Gregory, Mike",
    title = "Does the Kantian state dominate?: Freedom and majoritarian rule",
    year = "2023",
    note = {CORE ARGUMENT: Gregory responds to critics of the "Kantian-Republican" thesis of freedom as non-domination who argue that domination by the state is unavoidable. He separates this into the problem of state domination (the state's coercive powers necessarily dominate citizens) and the problem of majority domination (the people can form dominating majorities against individual citizens), and assesses whether the Kantian state can avoid both. RELEVANCE: Engages contemporary neo-republican appropriations of Kant (paralleling Widmer's and Vrousalis's papers) to ask whether majoritarian democratic rule -- as opposed to Kant's preferred representative republicanism -- is compatible with freedom as non-domination, bearing on the republicanism/democracy debate. POSITION: Defends a qualified compatibilist position on whether the Kantian state can avoid both state and majority domination, in dialogue with neo-republican critics.},
    keywords = "domination, republicanism, democracy, neo-republicanism, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Abstract Recently, scholars have criticized what they call the "Kantian-Republican" thesis of freedom as non-domination. The main complaint is that domination is unavoidable. This concern can be separated into the problem of state domination, which suggests that the state's intervening powers necessarily dominate its citizens, and the problem of majority domination, which suggests that the People necessarily dominate individual citizen as a result of the potential to form dominating majorities.},
    abstract_source = "openalex"
}

@misc{korsgaard1997taking,
    author = "Korsgaard, Christine M.",
    editor = "Reath, Andrews and Herman, Barbara and Korsgaard, Christine M.",
    title = "Taking the Law into Our Own Hands: Kant on the Right to Revolution",
    year = "1997",
    note = "CORE ARGUMENT: Korsgaard argues that Kant's own moral premises -- particularly the publicity requirement and the impermissibility of adopting maxims that could not be willed as universal law -- do not straightforwardly entail the blanket prohibition on resistance that Kant officially defends, and that a Kantian case can be constructed for a conditional, morally constrained right to resist a sufficiently unjust sovereign. RELEVANCE: This is the paper that reopened the contemporary debate over whether Kant's anti-revolutionary doctrine is truly derivable from his own principles of Right, directly addressing the project's central puzzle about the gap between Kant's juridical prohibition and his moral commitments; it is the primary target of Flikschuh's 2008 rebuttal. POSITION: Revisionist reading -- Kant's texts contain resources for a qualified permission to resist that Kant himself did not draw out.",
    sep_context = {SEP "Kant's Social and Political Philosophy" (section 6, "Rebellion and Revolution") cites this paper as the paradigm attempt to use independent moral judgment to justify revolution against Kant's own stated view, noting that Flikschuh 2008 responds to it directly.},
    keywords = "resistance, revolution, revisionist-reading, High, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "If we place ourselves at the end of this tremendous process, where the tree at last brings forth fruit, where society and the morality of custom at last reveal what they have simply been the means to: then we discover that the ripest fruit is the sovereign individual , like only to himself, liberated again from the morality of custom, autonomous and supramoral. Nietzsche Taking the Law into Our Own Hands Morality is unconditional and overriding. Its demands are uncompromising and its claims take priority over all others. Yet we can all think of situations in which, for reasons that seem to us honorable, unselfish, or conscientious, we would do things which morality seems to forbid. I want to ask how we can account for this fact. There are two attempts to deal with the problem which, for obvious reasons, I will call skepticism and dogmatism. The skeptic denies that morality is unconditional and overriding. The dogmatist insists that it is, and argues that either the actions in question are not wrong, or, if they are, a good person just won't do them. Some skeptics and dogmatists are merely trying to domesticate the phenomena. The skeptic may have pretensions to being worldly and realistic, laughing at the ponderous claims of moralists. The dogmatist may simply be a moralistic prig. But there are serious and attractive versions of both views. The skeptic may think, as Bernard Williams does, that a life in which moral considerations can always override love and the cherished projects of a lifetime is not recognizably human.",
    abstract_source = "openalex"
}

@misc{flikschuh2008reason,
    author = "Flikschuh, Katrin",
    title = "Reason, Right, and Revolution: Kant and Locke",
    year = "2008",
    note = "CORE ARGUMENT: Flikschuh contrasts Kant's and Locke's grounds for political obligation, arguing that Locke's resistance right rests on a voluntarist, rights-protective conception of political authority grounded in individual consent and self-preservation, whereas Kant's prohibition follows from a non-voluntarist conception on which rightful authority is constituted by the very possibility of reciprocal, universal external freedom rather than by antecedent individual rights the state exists to protect. RELEVANCE: Directly supplies the Locke/Kant contrast the project seeks, showing that the disagreement over resistance is not a superficial policy difference but tracks a deeper divergence in how each thinker grounds political authority itself. POSITION: Strict-prohibition reading defended via structural contrast with Locke, rather than by appeal to sovereignty concepts alone.",
    keywords = "resistance, Locke-comparison, political-obligation, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{flikschuh2008sidestepping,
    author = "Flikschuh, Katrin",
    title = "Sidestepping Morality: Korsgaard on Kant's No-right to Revolution",
    year = "2008",
    note = {CORE ARGUMENT: Flikschuh argues that Korsgaard's revisionist reading illicitly imports independent moral judgment into a domain -- Right -- that Kant deliberately insulates from direct moral adjudication; on Flikschuh's reconstruction, the no-right-to-revolution thesis is not a moral failure to be corrected but a structural feature of Kant's separation of Right from ethics, so that Korsgaard's proposed "correction" in fact sidesteps rather than engages Kant's actual argument. RELEVANCE: Provides the direct rebuttal to Korsgaard 1997 named in the key questions, and clarifies why appeals to inner morality or radical evil cannot simply be imported into the doctrine of Right to license resistance without collapsing Kant's right/ethics distinction. POSITION: Strict-prohibition reading defended against revisionist attempts to ground resistance rights in independent moral judgment.},
    sep_context = {SEP "Kant's Social and Political Philosophy" (section 6) cites this paper as the direct response to Korsgaard 1997's revisionist argument for a right to revolution.},
    keywords = "resistance, revolution, Korsgaard-debate, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, pages, type:@article->@misc"
}

@misc{waldron1996kants,
    author = "Waldron, Jeremy",
    title = "Kant's Legal Positivism",
    year = "1996",
    note = {CORE ARGUMENT: Waldron reads Kant's insistence on obedience to positive law, even unjust law, as a form of legal positivism: the authority of law derives not from its moral content but from its being the actual, effective embodiment of a public, general will capable of resolving disputes, so that any existing legal order is preferable, as a matter of Right, to the state of nature or to contested claims about which party -- sovereign or people -- truly embodies sovereignty. RELEVANCE: Supplies the "Universal Principle of Right" derivation of the anti-resistance stance that the project's first key question asks about, framing the prohibition as flowing from the concept of law and sovereignty rather than from any independent moral endorsement of existing regimes. POSITION: Strict-prohibition / legal-positivist reading -- the embodiment of law, not its justice, grounds the duty of obedience.},
    sep_context = {SEP "Kant's Social and Political Philosophy" (section 6) cites this paper as offering "a related legal positivist interpretation" of Kant's claim that any state embodies the general legislative will better than no state at all.},
    keywords = "resistance, legal-positivism, sovereignty, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "[H]owever well disposed and law-abiding men might be, ... individual men, peoples, and states can never be secure against violence from one another, since each has its own right to do what seems right and good to it and not to be dependent upon another's opinion about this. So, unless it wants to renounce any concepts of Right, the first thing it has to resolve upon is the principle that it must leave the state of nature, in which each follows its own judgment, unite itself with all others (with which it cannot avoid interacting), subject itself to a public lawful external coercion, and so enter into a condition in which what is to be recognized as belonging to it is determined by law .... IMMANUEL KANT'",
    abstract_source = "openalex"
}

@misc{maliks2013kant,
    author = "Maliks, Reidar",
    title = "Kant, the State, and Revolution",
    year = "2013",
    note = {CORE ARGUMENT: Maliks argues that although no right of resistance or revolution exists within a Kantian state, an extremely tyrannical regime can fail to qualify as a "state" at all in the relevant juridical sense, so that citizens retain a moral responsibility to judge whether a given regime meets the threshold conditions of rightful authority -- a position Maliks presents as compatible with, rather than a departure from, Kantian authority. RELEVANCE: Offers a textually grounded middle path between strict-prohibition and revisionist readings, directly addressing the key question about resources in Kant's texts for qualified resistance without abandoning the core anti-revolutionary architecture. POSITION: Qualified/conditional reading -- resistance remains prohibited within a genuine state, but the concept of "state" itself has a threshold below which the prohibition does not apply.},
    keywords = "resistance, tyranny, sovereignty, state-concept, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract This paper argues that, although no resistance or revolution is permitted in the Kantian state, very tyrannical regimes must not be obeyed because they do not qualify as states. The essay shows how a state ceases to be a state, argues that persons have a moral responsibility to judge about it and defends the compatibility of this with Kantian authority. The reconstructed Kantian view has implications for how we conceive authority and obligation. It calls for a morally demanding definition of the state and asserts that the primary personal responsibility is not to evaluate the morality of every single law but to evaluate the moral standing of the polity.",
    abstract_source = "openalex"
}

@misc{maliks2022kant,
    author = "Maliks, Reidar",
    title = "Kant and the French Revolution",
    year = "2022",
    note = "CORE ARGUMENT: Through a contextual study of the French Revolution's two central phases -- the 1789 transfer of sovereignty to the people via the Estates-General and the 1792-93 trial and execution of the monarch -- Maliks argues that Kant judged the first phase to manifest popular sovereignty in lawful ways while treating the second as a perversion of that same principle, using this distinction to explain both Kant's enthusiasm and his continued rejection of a right of revolution. RELEVANCE: Provides the detailed historical mechanism behind the project's second key question, showing exactly how Kant's shifting real-time judgments about specific revolutionary events track his abstract doctrine rather than contradicting it. POSITION: Contextual-historical reading -- the apparent tension dissolves once Kant's fine-grained distinctions between lawful transfer of sovereignty and lawless popular action are reconstructed.",
    keywords = "French-Revolution, historical-context, sovereignty, High, METADATA\\_CLEANED: publisher, type:@book->@misc, METADATA\_CLEANED: doi",
    abstract = "To Kant, the French revolution's central events were the transfer of sovereignty to the people in 1789 and the trial and execution of the monarch in 1792-1793. Through a contextual study, this Element argues that while both events manifested the principle of popular sovereignty, the first did so in lawful ways, whereas the latter was a perversion of the principle. Kant was convinced that historical examples can help us understand political philosophy, and this Element seeks to show this in practice.",
    abstract_source = "s2"
}

@misc{beck1971kant,
    author = "Beck, Lewis W.",
    title = "Kant and the Right of Revolution",
    year = "1971",
    volume = "32",
    note = "CORE ARGUMENT: Beck offers an early systematic reconstruction of Kant's rejection of a right of revolution, situating it within Kant's broader theory of Right and arguing that the prohibition is a considered consequence of Kant's account of sovereignty and public law rather than a mere political expedient or personal timidity. RELEVANCE: Establishes the terms of the modern scholarly debate on this topic that later revisionist readings (Korsgaard, Arntzen) react against, providing the review's account of the doctrine's initial reception in Kant scholarship. POSITION: Strict-prohibition reading, presented as the considered consequence of Kant's systematic theory of Right.",
    keywords = "resistance, revolution, foundational-reading, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{hill2017questions,
    author = "Hill, Thomas E.",
    title = "Questions About Kant's Opposition to Revolution",
    year = "2017",
    note = "CORE ARGUMENT: Hill poses a series of critical questions about the coherence and scope of Kant's opposition to revolution, probing whether the arguments Kant gives (from the concept of sovereignty, from the social contract as an idea of reason, and from the dangers of anarchy) are individually sufficient or jointly consistent, without fully endorsing either a strict or a revisionist reading. RELEVANCE: Functions as a critical stock-taking of the standard arguments for Kant's prohibition, useful for the review's assessment of whether the doctrine is genuinely derivable from the Universal Principle of Right or rests on additional, more contestable premises. POSITION: Critical/exploratory -- interrogates rather than defends a single interpretive camp, cataloguing open questions in the strict-prohibition literature.",
    keywords = "resistance, revolution, critical-survey, Medium, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = {Immanuel Kant is well known for taking a hard, inflexible line on certain particular moral issues, such as lying and revolution. Kant was optimistic about revolutions as forces for moral progress that we might otherwise never achieve. He was known as a supporter of the French Revolution, reportedly referred to as “the old Jacobin". The prima facie problem is how Kant can reconcile his Hobbesian claim that revolution is always contrary to justice with his anti-Hobbesian conviction that there are universal standards of justice that apply to sovereign authorities. Kant argues that trying to incorporate an alleged right to revolution into a constitution for a legal system would be incoherent because it would purport to be a legal authority to destroy the very source of legal authority. Kant’s formula of humanity as an end in itself seems to provide presumptive grounds for questioning an absolute prohibition on revolution.},
    abstract_source = "openalex"
}

@misc{arntzen1996kant,
    author = "Arntzen, Sven",
    title = "Kant on Duty to Oneself and Resistance to Political Authority",
    year = "1996",
    note = "CORE ARGUMENT: Arntzen examines Kant's conceptual argument that a subject's right to resist supreme political power is self-contradictory (it would make the subject simultaneously sovereign and subject), and probes whether duties to oneself -- particularly the duty to preserve one's own moral integrity and dignity -- might nonetheless generate space for justified non-compliance short of a juridical right to rebel. RELEVANCE: Directly engages the key question about textual resources (here, duties to oneself rather than provisional right or radical evil) for a qualified permission to resist, offering an alternative route to the one Korsgaard later takes via publicity and universalizability. POSITION: Qualified reading -- the conceptual argument against a right to resist is sound as far as it goes, but duties to oneself may support limited non-compliance that falls short of resistance proper.",
    keywords = "resistance, duties-to-self, political-authority, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Kant on Duty to Oneself and Resistance to Political Authority SVEN ARNTZEN in ms DOCTRI\textasciitilde tE OF Law and related writings? Kant denies the subject's right to resist political authority in the strongest terms. His argumentation to support this denial is conceptual in character. The denial of a right of resistance follows from the relevant legal concepts of civil society, of the people as subject , of the head of state as the supreme power in civil society, as having only rights but no duties that he may be coerced to fulfill, and of a right as an authorization to use coercion. Civil society is the coexistence of persons as subject to a central authority, a supreme power, which is not itself subject to some other coercive authority. For the people as subject (or a member thereof) to have a right to resist the supreme power in civil society would be for it to have an authorization to use coercion to restrain that power, which would not, then, be the supreme power. In other words, a people's right to resist the supreme power would imply that the power is both supreme and not ' By Kant's Doctrineof Law I mean his Die metaphysischeAnfangsgriindederRechtslehre,the first part ofD/e MetaphysikderSitten, hereafter MdS (trans. Mary Gregor, TheMetaphysicsofMorals[New York: Cambridge University Press, 1991]). The other available translation of the DoctrineofLaw is by John Ladd, and is rendered as The MetaphysicalElementsofJustice (Indianapolis: The BobbsMerrill Company, a965). I will refer to the second part of MdS, DiemetaphysischeAnfangsgriindeder Tugendlehre,as the Doctrineof Virtue. The other main sources I will use are: "Uber den Gemeinspruch: Das mag in der Theorie richtig sein, taugt aber nicht fiir die Praxis," hereafter T\\&P (trans. Ted Humphrey, "On the Proverb: 'This May Be True in Theory, but It Does Not Apply in Practice'," in I. Kant, Perpetual Peaceand OtherEssays[Indianapolis: Hackett Publishing Co., 1983]); Grundlegungzur Metaphysik der S/tten, hereafter GMS (trans. James w. Ellington, Groundingfor theMetaphysicsofMorals [Indianapolis : Hackett Publishing Co., x983]); KritikderpraktischenVernunft, hereafter KpV (trans. L. W. Beck, CritiqueofPracticalReason [Indianapolis: The Bobbs-Merrill Company, Inc., 1965]). Page references for Kant's works are given in parentheses in the text by volume and page (e.g., V 34) of the Academy Edition: KantsgesammelteSchriflen(Berlin, 19lo- ). I have used available English translations when quoting from Kant's works. In some cases I have made modifications that I find appropriate. Where official translations are not available, the translations from Kantian sources are mine. [409] 41o JOURNAL OF THE HISTORY OF PHILOSOPHY 34:3 JULY 1996 supreme, and that the people is both subject and not subject to political authority . Thus, according to Kant, the notion of a people's right of resistance, or the statement that the people has such a right, involves a contradiction (VI 3182o ). \textasciitilde\ Furthermore, Kant argued that the formation (and preservation) of civil society is necessary, according to practical reason (VI 255-56, 3o7). It follows that the subject has a duty--a duty he may be coerced to fulfill--to obey political authority, even in the case of "what is declared to be an unbearable abuse of supreme authority" (VI 32o) or where the head of state exercises the oppressive power of a tyrant (VIII 382). These and similar assertions by Kant seem to be at odds with his view that civil society preserves, or at least ought to preserve, the freedom and equality of persons. By denying a right of resistance even where civil society fails short of the ideal civil society, he maintains that one has a duty to act according to a will which is not one's own and thereby seems to betray the person's autonomy and dignity that he has so strongly asserted in GMS and KpV.s Because of such tension, many commentators on this aspect of Kant's philosophy of law share the view that his denial of a right of resistance must be limited in scope. However, there is no general agreement concerning the conditions under which the subject may disobey or somehow resist political authority for Kant. According to Werner Haensel in his classical study on Kant's theory of resistance, Kant's conceptual argumentation can only...},
    abstract_source = "openalex"
}

@misc{golob2021kant,
    author = "Golob, Sacha",
    title = "Kant on revolution as a sign of moral progress",
    year = "2021",
    note = {CORE ARGUMENT: Golob analyzes Kant's claim, in "The Contest of Faculties," that the enthusiastic reaction of spectators to the French Revolution serves as a historical sign (signum rememorativum, demonstrativum, prognostikon) of humanity's moral progress, arguing that this claim is compatible with -- and indeed depends on -- the revolution itself being wrong and impermissible as an act of resistance. RELEVANCE: Clarifies the precise logical structure of Kant's "welcome for the outcome, prohibition on the act" position that the project's framing highlights, showing that the spectator's enthusiasm rather than the revolutionary act itself is what does the evidential work for moral progress. POSITION: Reconciliationist reading -- shows how moral endorsement of revolution's historical significance and juridical condemnation of revolutionary action are not merely compatible but structurally linked in Kant's philosophy of history.},
    keywords = "revolution, moral-progress, philosophy-of-history, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This paper addresses a central aspect of Kant's theory of moral progress and its links to both political violence and pedagogy. Kant claims in the Conflict of the Faculties that the reaction to the French Revolution demonstrates that the ‘human race has always progressed and will further progress toward the better’. It thus constitutes a ‘historical sign’, justifying belief in moral development. This paper argues for three points. First, I contend that these claims have been widely misunderstood: in particular, most commentators are guilty of projecting Hegelian arguments onto Kant. Second, I advance a new reading of Kant's account of the ‘historical sign’ focusing on the epistemic status of the spectator and the role of ‘enthusiasm’. One consequence is that the case for progress is fundamentally different from that in Kant's other writings. Third, I show how these results inform Kant's stance on education and the possibility of what he calls ‘popular enlightenment’. Ironically, the details of Kant's argument may seem to support pessimism rather than any celebration of human progress: the appeal to education is crucial in making that final leap.",
    abstract_source = "openalex"
}

@misc{lore2021supreme,
    author = "Lo Re, Stefano",
    title = "Supreme Power: A Neglected Source of Tension in Kant's Views on Political Resistance",
    year = "2021",
    note = {CORE ARGUMENT: Lo Re identifies an underexplored tension in Kant's account of "supreme power" (oberste Gewalt) itself, arguing that Kant's own characterizations of what makes a power supreme are not fully consistent and that this instability, rather than being a mere exegetical curiosity, bears directly on how far the prohibition on resistance can be pressed in edge cases. RELEVANCE: Adds a further textual pressure point to the debate over consistency in Kant's anti-revolutionary doctrine, complementing Korsgaard's and Arntzen's arguments by locating tension in the concept of sovereign power rather than in duties to oneself or publicity. POSITION: Critical/diagnostic -- identifies a structural tension internal to Kant's concept of supreme power rather than proposing a resolution.},
    keywords = "resistance, sovereignty, supreme-power, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{surprenant2005reconciliation,
    author = "Surprenant, Chris W.",
    title = "A Reconciliation of Kant's Views on Revolution",
    year = "2005",
    volume = "32",
    note = "CORE ARGUMENT: Surprenant argues that Kant's apparently conflicting statements on revolution can be reconciled by distinguishing cases in which an individual is under an independent moral obligation to revolt from the general juridical prohibition on a collective right of resistance, so that Kant's texts permit individual moral exceptions without conceding any general political right to rebel. RELEVANCE: Offers a further reconciliation strategy for the project's central consistency puzzle, distinct from Korsgaard's publicity-based revisionism and from Maliks's threshold-state approach, by locating the qualification at the level of individual moral obligation rather than collective political right. POSITION: Reconciliationist reading -- resolves the tension by separating individual moral obligation from collective political right rather than by revising either side of Kant's doctrine.",
    keywords = "resistance, revolution, reconciliation, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{ypi2014revolution,
    author = "Ypi, Lea",
    title = "On Revolution in Kant and Marx",
    year = "2014",
    note = "CORE ARGUMENT: Ypi compares Kant's and Marx's theories of revolution, arguing that despite Kant's juridical prohibition and Marx's endorsement of revolutionary praxis, both thinkers share a structurally similar commitment to revolution as playing an indispensable role within a philosophy of history oriented toward the progressive realization of freedom, differing chiefly in whether that role licenses individual revolutionary agency. RELEVANCE: Extends the project's comparative dimension beyond the Kant/Locke contrast to a Kant/Marx contrast, illuminating how Kant's view of revolution as historically necessary yet individually impermissible occupies a distinctive position between liberal contractarian and later revolutionary traditions. POSITION: Comparative reading -- situates Kant's prohibition within a shared philosophy-of-history framework that also generates Marx's very different conclusions about revolutionary agency.",
    keywords = "revolution, Marx-comparison, philosophy-of-history, Medium, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc, METADATA\_CLEANED: volume",
    abstract = "This essay compares the thoughts of Kant and Marx on revolution. It focuses in particular on two issues: the contribution of revolutionary enthusiasm to the cause of emancipatory political agents and its educative role in illustrating the possibility of progress for future generations. In both cases, it is argued, the defence of revolution is offered in the context of illustrating the possibility of moral progress for the species, even if not for individual human beings, and brings out the centrality of collective agency in moving toward universal moral goals. Discussing the implications of these points is of significant historical interest: it allows us to defend an interpretation of Kant’s political thought which is sensitive to the material conditions of historical development and to rescue Marx from an amoral reading of his philosophy of history. Reflecting on the role and preconditions of transformative collective agency is also of normative interest: it allows us to better evaluate the significance of political events that, firstly, re-shape the boundaries of political feasibility and, secondly, play a crucial educative role in motivating future progressive initiatives.",
    abstract_source = "openalex"
}

@misc{cronin2003kants,
    author = "Cronin, Ciaran",
    title = "Kant's Politics of Enlightenment",
    year = "2003",
    note = {CORE ARGUMENT: Cronin reconstructs Kant's account of the public, non-coercive use of reason -- the "freedom of the pen" -- as the institutional substitute Kant offers in place of a right of resistance, arguing that this freedom is meant to do real political work (correcting sovereign error and driving gradual reform) despite imposing no enforceable constraint on the sovereign. RELEVANCE: Directly examines the "right to complain but not to resist" doctrine named in the project's domain focus, clarifying how Kant expects public criticism alone to substitute functionally for a resistance right. POSITION: Strict-prohibition-compatible reading -- freedom of the pen is a genuine, if non-coercive, mechanism of political correction that makes the prohibition on resistance more palatable without conceding any right to disobey.},
    keywords = "freedom-of-the-pen, public-reason, enlightenment, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{curtiswendlandt2012no,
    author = "Curtis-Wendlandt, Lisa",
    title = "No Right to Resist? Elise Reimarus's Freedom as a Kantian Response to the Problem of Violent Revolt",
    year = "2012",
    note = {CORE ARGUMENT: Curtis-Wendlandt examines the largely neglected Enlightenment intellectual Elise Reimarus, a correspondent of Kant, whose dialogue "Freedom" develops a broadly Kantian rejection of a general right to violent resistance while proposing, like Kant, non-violent alternatives rooted in freedom of public expression and moral enlightenment as the appropriate response to political injustice. RELEVANCE: Recovers a contemporaneous interlocutor who worked out a position structurally parallel to Kant's "complain but do not resist" doctrine, broadening the project's account of the intellectual context in which Kant's anti-revolutionary stance was formed and debated. POSITION: Contextual/historical reading -- situates Kant's rejection of a resistance right within a wider circle of German Enlightenment thought rather than treating it as a solitary position.},
    keywords = "resistance, Reimarus, historical-context, Low, METADATA\\_CLEANED: number, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "One of the greatest woman intellectuals of eighteenth‐century Germany is Elise Reimarus, whose contribution to Enlightenment political theory is rarely acknowledged today. Unlike other social contract theorists, Reimarus rejects a people's right to violent resistance or revolution in her philosophical dialogue Freedom (1791). Exploring the arguments in Freedom, this paper observes a number of similarities in the political thought of Elise Reimarus and Immanuel Kant. Both, I suggest, reject violence as an illegitimate response to perceived political injustice in a way that opposes Locke's strong voluntarism and the absolutism of Hobbes. First, they emphasize the need to maintain the legal state as a precondition for the possibility of external right. Second, they share an optimistic view of the inherently “just” nature of the tripartite republican state. And finally, Reimarus and Kant both outline an alternative, nonviolent response to political injustice that consists in the freedom of public expression and a discourse on the moral enlightenment of man.",
    abstract_source = "openalex"
}

@misc{azeri2009kants,
    author = "Azeri, Siyaves",
    title = "Kant's Rejection of the Right of Revolution",
    year = "2009",
    note = "CORE ARGUMENT: Azeri surveys Kant's grounds for rejecting a right of revolution and situates this rejection within broader tensions between Kant's transcendental idealism and his engagement with the political realities of his time, arguing that the rejection reflects deeper features of Kant's conception of autonomy and the limits of practical reason in the political domain. RELEVANCE: Provides an additional, more critical vantage point on the derivability of the anti-revolutionary stance from Kant's broader philosophical system, complementing the more text-internal reconstructions offered by Beck, Waldron, and Maliks. POSITION: Critical reading -- treats the rejection of a right of revolution as symptomatic of broader strains between Kant's idealist commitments and his political theory.",
    keywords = "resistance, revolution, critical-reading, Low, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, number, type:@article->@misc, METADATA\_CLEANED: volume, pages"
}

@misc{byrd1989kants,
    author = "Byrd, B. Sharon",
    title = "Kant's Theory of Punishment: Deterrence in Its Threat, Retribution in Its Execution",
    year = "1989",
    note = {CORE ARGUMENT: Byrd argues against the traditional reading of Kant as a pure retributivist, showing that Kant's theory assigns deterrence a legitimate role in the threat of punishment (its general, legislative function, addressed to would-be offenders) while reserving strict retribution for the execution of punishment on the convicted individual. This threat/execution distinction lets Kant's theory accommodate both the principle of equality and a rationale grounded in securing citizens' freedom. RELEVANCE: This is the pivotal paper that reoriented the entire secondary literature on Kant's theory of punishment away from a purely retributivist reading toward "mixed theory" interpretations; nearly every subsequent paper in this domain positions itself relative to Byrd's threat/execution distinction. POSITION: Founding statement of the mixed (hybrid) theory reading of Kant on punishment.},
    keywords = "kant, punishment, retributivism, mixed-theory, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy" section 7 (Punishment): "Kant was long considered to be an exemplar of the retributivist theory of punishment until Byrd (1989) showed the role of deterrence in his theory (see Shell 1997 for a defense of retributivism)."},
    abstract = "This DOI is not currently attached to any metadata records. DOIs can’t actually ever be deleted (they’re persistent), but sometimes our members create DOIs in error. We do have a process to approximate deletion which we follow only in rare cases where the DOI has been genuinely created in error, and most crucially, if the DOI has never been published anywhere online or in print and never otherwise distributed to or communicated with anyone (authors, readers, reviewers, etc.",
    abstract_source = "openalex"
}

@misc{hill2000kant,
    author = "Hill, Thomas E.",
    title = "Kant on Punishment: A Coherent Mix of Deterrence and Retribution?",
    year = "2000",
    note = "CORE ARGUMENT: Hill defends the coherence of reading Kant as holding a mixed theory that combines deterrent and retributive elements, arguing that apparent tensions in Kant's texts dissolve once one separates the question of who may be punished (guilt as a necessary condition) from the question of why the state punishes at all (which can invoke social utility). RELEVANCE: Provides a systematic defense of the mixed-theory reading against charges of incoherence, complementing Byrd's textual case with a more explicitly philosophical reconstruction of how retribution and deterrence can jointly justify legal (as opposed to moral) punishment. POSITION: Mixed-theory defense, responding to objections that Kant's threat/execution distinction is unstable.",
    keywords = "kant, punishment, retributivism, mixed-theory, deterrence, High, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "Abstract Although Kant is often regarded an extreme retributivist regarding judicial punishment, the need to deter crime also plays a significant role in his theory of criminal law. Kant's special way of combining deterrence and retribution, however, must be distinguished from others that are less plausible. Kant thought that criminal punishments should be designed to match the victim's empirically discernible losses in degree and kind, except when this would be impossible or degrading; for courts cannot measure the ultimate moral desert of criminals. Arguably, Kant's justification of the practice of punishment is not deeply retributive, but punishment is also not a mere disincentive in a ‘price’ system of social control. For better or worse, punishment tends to convey a public message of moral disapproval of the criminal conduct; and, though this de facto expressive function is not for Kant, the purpose or justification of punishment, it may help explain his concern for making the severity of punishments proportional to the gravity of crimes and his refusal to allow exceptions for merely pragmatic reasons.",
    abstract_source = "openalex"
}

@misc{merle2000kantian,
    author = "Merle, Jean-Christophe",
    title = "A Kantian Critique of Kant's Theory of Punishment",
    year = "2000",
    volume = "19",
    note = {CORE ARGUMENT: Merle argues that both the traditional pure-retributivist reading and Byrd's mixed-theory reading of Kant are "literally right" as textual interpretations but that Kant's theory of punishment, so construed, is inconsistent with his own concept of law (Recht). Merle proposes instead that a genuinely Kantian justification of punishment should appeal to special deterrence and rehabilitation rather than retribution or general deterrence. RELEVANCE: Offers an internal ("Kantian") critique of Kant's own theory, useful for distinguishing exegetical questions (what did Kant argue?) from normative ones (what should a Kantian argue?) — a distinction central to any treatment of Kant's penal theory's contemporary relevance. POSITION: Internal critique: accepts elements of both pure-retributivist and mixed readings but argues Kant's actual view is self-undermining relative to his own legal theory.},
    keywords = "kant, punishment, retributivism, internal-critique, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "In contrast to the traditional view of Kant as apure retributivist, the recent interpretations ofKant's theory of punishment (for instance Byrd's)propose a mixed theory of retributivism and generalprevention. Although both elements are literallyright, I try to show the shortcomings of each. I thenargue that Kant's theory of punishment is notconsistent with his own concept of law. Thus I proposeanother justification for punishment: specialdeterrence and rehabilitation. Kant's critique ofutilitarianism does not affect this alternative, whichmoreover has textual support in Kant and is fullyconsistent with his concept of law.",
    abstract_source = "s2"
}

@misc{shell1997kant,
    author = "Shell, Susan Meld",
    title = "Kant on Punishment",
    year = "1997",
    volume = "1",
    note = {CORE ARGUMENT: Shell defends a retributivist reading of Kant's theory of punishment against revisionist "mixed theory" interpretations, arguing that Kant's insistence on the principle of equality and the jus talionis as sole measures of legitimate punishment expresses a considered commitment to retribution rather than an inconsistency to be explained away by appeal to deterrence. RELEVANCE: Serves as the primary counterweight to Byrd's mixed-theory reading in the literature; essential for representing the pure-retributivist side of the central interpretive dispute in this domain. POSITION: Defense of pure (or near-pure) retributivism against the Byrd-style mixed-theory consensus.},
    keywords = "kant, punishment, retributivism, pure-retributivism, High, METADATA\\_CLEANED: journal, pages, doi, type:@article->@misc",
    sep_context = {Cited in SEP "Kant's Social and Political Philosophy" section 7 (Punishment) as the counterpoint to Byrd: "...until Byrd (1989) showed the role of deterrence in his theory (see Shell 1997 for a defense of retributivism)."},
    abstract = "Unlike that of most liberal thinkers, Kant's theory of punishment is unabashedly retributive. For classical liberals punishment is justified only by the harms it can prevent, not by any allegedly intrinsic good served by making the guilty suffer. Here Hobbes' blunt insistence that the aim of punishment ‘is not a revenge, but terror’ is prototypical in substance, if not in style. Hobbes, Locke, Mill, Bentham and Beccaria, for all their differences, agree that punishment must look to future good rather than to avenging past wrongs. This attitude on the part of classic liberalism toward retribution is not surprising, given its association with the kind of theocratic politics liberalism arose to combat.",
    abstract_source = "openalex"
}

@misc{yost2010kants,
    author = "Yost, Benjamin S.",
    title = "Kant's Justification of the Death Penalty Reconsidered",
    year = "2010",
    note = "CORE ARGUMENT: Yost reconsiders Kant's argument for capital punishment, focusing on Kant's reply to Beccaria's social-contract objection (that no one would consent in advance to their own execution). Yost examines whether Kant's distinction between the rational, contracting self and the empirical, criminal self can bear the justificatory weight Kant places on it, and where the argument fails on its own terms. RELEVANCE: Directly addresses the research project's focus on problems Kant's defense of capital punishment raises for contemporary Kantian penal theory, engaging closely with the social-contract dimension of the island/last-murderer argument. POSITION: Critical reconstruction of Kant's capital-punishment argument, sympathetic to retributivist premises but skeptical of Kant's specific social-contract defense.",
    keywords = "kant, capital-punishment, jus-talionis, social-contract, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "It is hard to know what to think about Kant's ‘passionate sermons’ on capital punishment. Kant clearly feels that it is one of the most important punishments in the state's arsenal. But his vehement insistence on the necessity of execution strikes many readers as philosophically suspect. Critics argue that Kant's embrace of the death penalty is incompatible with, or at least not required by, the fundamental tenets of his moral and legal philosophy (Schwarzschild 1985; Merle 2000; Potter 2002; Hill 2003). These arguments typically employ one of two strategies. The first is to deny that execution is required by retribution in even a prima facie sense; arguments along this line typically question the coherence of Kant's doctrine of the ius talionis (Sarver 1997). The second is to show that there are inviolable moral principles that render the death penalty illegitimate; this criticism typically appeals to the value of human dignity or the right to life (Radin 1980; Pugsley 1981; Schwarzschild 1985; Merle 2000; Potter 2002). There is a third strategy that could be used to criticize Kant, although it is not aimed at him specifcally. This strategy invokes legal principles of fairness or due process. It asserts that, regardless of capital punishment's moral appropriateness or legitimacy, capital punishment is unjust due to the fallibility of legal actors and institutions (Nathanson 2001). Someone adopting the third strategy might claim that, while Kant's justifcation may be acceptable in principle, it fails to justify the death penalty in the world we live in.",
    abstract_source = "openalex"
}

@misc{potter2002kant,
    author = "Potter, Nelson T.",
    title = "Kant and Capital Punishment Today",
    year = "2002",
    note = "CORE ARGUMENT: Potter examines whether Kant's retributivist justification of capital punishment can be extended to, or must be revised for, contemporary penal contexts, addressing objections concerning fallibility of judicial systems, proportionality, and the empirical conditions under which Kant's jus talionis argument was formulated. RELEVANCE: Bridges historical exegesis and contemporary application, directly relevant to the key question of what problems Kant's capital-punishment defense raises for present-day Kantian penal theory. POSITION: Sympathetic-but-critical retributivist engagement, testing the contemporary applicability of Kant's capital punishment argument.",
    keywords = "kant, capital-punishment, retributivism, contemporary-application, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc"
}

@misc{clark2004nonretributive,
    author = "Clark, Michael",
    title = "A Non-Retributive Kantian Approach to Punishment",
    year = "2004",
    note = {CORE ARGUMENT: Clark argues that a more coherent Kantian theory of punishment can be developed that abandons retribution altogether: he contends that hypothetical rational contractors would have no good reason to endorse a retributively-distributed system of punishment, even granting Kant's own premises about autonomy and the jus talionis. RELEVANCE: Represents the strongest departure from retributivist readings within the literature, useful for showing the outer boundary of how far "Kantian" commitments can be pushed away from Kant's own retributivist text. POSITION: Revisionist non-retributive Kantianism, rejecting the ius talionis constraint that both pure-retributivist and mixed-theory readings retain.},
    keywords = "kant, punishment, non-retributivism, revisionist, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Abstract Traditionally Kant's theory of punishment has been seen as wholly retributive. Recent Kantian scholarship has interpreted the theory as more moderately retributive: punishment is deterrent in aim, and retributive only in so far as the amount and type of penalty is to be determined by retributive considerations (the ius talionis). But it is arguable that a more coherent Kantian theory of punishment can be developed which makes no appeal to retribution at all: hypothetical contractors would have no good reason to endorse punishment distributed retributively. This position is first sketched behind Rawls's neo‐Kantian ‘veil of ignorance’, and it is suggested that the same theory will emerge from Scanlon's more relaxed neo‐Kantian position.",
    abstract_source = "openalex"
}

@misc{brooks2005kantian,
    author = "Brooks, Thom",
    title = "Kantian Punishment and Retributivism: A Reply to Clark",
    year = "2005",
    note = "CORE ARGUMENT: Brooks responds to Clark's non-retributive Kantian proposal, defending the view that Kant's theory of punishment endorses retribution for transgressions of the moral law while allowing consequentialist considerations for violations of positive law, and arguing that Clark's hypothetical-contractor argument fails to displace this dual structure. RELEVANCE: Extends the mixed-theory tradition by directly engaging Clark's revisionist critique, illustrating the ongoing, unsettled character of the debate over how much of Kant's retributivism survives contemporary scrutiny. POSITION: Mixed-theory defense (moral-law retribution plus positive-law consequentialism), responding directly to non-retributive revisionism.",
    keywords = "kant, punishment, retributivism, mixed-theory, reply, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Michael Clark defends ‘A Non-Retributive Kantian Approach to Punishment’. This defence takes the following form. Traditional interpretations of Kant’s theory of punishment mistakenly find it retributivist. Clark argues that Kant primarily endorses deterrent punishments instead. A Kantian framework of justice need not then entail that retributivist punishments are preferable to deterrent punishments. Clark then claims that the Kantian framework used by John Rawls helps us develop a nonretributivist theory of punishment. Scanlon’s Kantian framework is alleged to support non-retributivist punishments as well. I will argue that both Kant’s and Rawls’s theories of punishment are retributivist to some extent. It may then be slightly misleading to say that by following the views of Kant and Rawls in particular we can develop a non-retributivist theory of punishment. This matter is further complicated by the fact Clark nowhere addresses Rawls’s views on punishment: Rawls endorses a mixed theory combining retributive and utilitarian features. Only Scanlon defends the use of non-retributivist punishments.",
    abstract_source = "openalex"
}

@misc{brooks2003kants,
    author = "Brooks, Thom",
    title = "Kant's Theory of Punishment",
    year = "2003",
    note = {CORE ARGUMENT: Brooks argues against the widespread view that Kant's theory of punishment is straightforwardly retributivist, proposing instead that Kant discusses punishment from genuinely distinct standpoints: retribution governs transgressions of the moral law, while consequentialist considerations govern violations of positive law. He contends this dual reading resolves apparent inconsistencies and unifies Kant's scattered remarks on punishment. RELEVANCE: Offers a distinct unifying interpretive framework (moral-law/positive-law distinction) that differs from Byrd's threat/execution distinction, giving the domain a second major axis along which "mixed theory" readings can be organized. POSITION: Mixed-theory reading organized around the moral-law/positive-law distinction, presented as more coherent and unified than prior interpretations.},
    keywords = "kant, punishment, retributivism, mixed-theory, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "The most widespread interpretation amongst contemporary theorists of Kant's theory of punishment is that it is retributivist. On the contrary, I will argue there are very different senses in which Kant discusses punishment. He endorses retribution for moral law transgressions and consequentialist considerations for positive law violations. When these standpoints are taken into consideration, Kant's theory of punishment is more coherent and unified than previously thought. This reading uncovers a new problem in Kant's theory of punishment. By assuming a potential offender's intentional disposition as Kant does without knowing it for certain, we further exacerbate the opportunity for misdiagnosis – although the assumption of individual criminal culpability may be all we can reasonably be expected to use. While this difficulty is not lost on Kant, it continues to remain with us today, making Kant's theory of punishment far more relevant than previously thought.",
    abstract_source = "openalex"
}

@misc{tunick1996kant,
    author = "Tunick, Mark",
    title = "Is Kant a Retributivist?",
    year = "1996",
    note = {CORE ARGUMENT: Tunick argues that Kant rejects consequentialism for moral actions but treats law and morality as distinct domains: in the sphere of positive law, an action (including a punitive law) can be justified by appeal to the good it produces. On this basis Kant's theory of legal punishment is, for Tunick, not straightforwardly deontological or retributivist despite Kant's reputation as the paradigmatic retributivist. RELEVANCE: Directly engages the research question of whether Kant's retributivism is purely deontological or admits consequentialist elements, using the raft/life-boat and absurd-law examples (parallel to the island passage) to argue that legal punishment in Kant is governed by considerations of deterrence and the avoidance of "absurd" (non-deterring) laws. POSITION: Revisionist reading denying that Kant's theory of legal punishment is deontological/retributivist in the usual sense, emphasizing the moral/legal distinction.},
    keywords = "kant, punishment, retributivism, moral-legal-distinction, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: volume, number, pages, METADATA\_CLEANED: journal, type:@article->@misc"
}

@misc{corlett2001making,
    author = "Corlett, J. Angelo",
    title = "Making Sense of Retributivism",
    year = "2001",
    note = "CORE ARGUMENT: Corlett examines the conceptual foundations of retributivism as a general theory of punishment, addressing what desert consists in and how it grounds the state's authority to inflict suffering, engaging critically with Kantian and non-Kantian retributivist positions to construct a more defensible version of the theory. RELEVANCE: Provides the broader retributivist framework (desert, proportionality, the state's authority to punish) within which Kant's specific version can be situated and evaluated, complementing the more narrowly exegetical papers in this domain. POSITION: General retributivist theory-construction, using Kant as a key reference point rather than as the exclusive object of analysis.",
    keywords = "retributivism, desert, kant, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This paper explicates and challenges John Rawl's argument concerning a rule-utilitarian theory of punishment. In so doing, it argues in favour of a retributivist theory of punishment, one that seeks to justify, not only particular forms of punishment, but the institution of punishment itself. Some crucial objections to retributivism are then considered: one regarding the adverse effects of punishment on the innocent, another concerning proportional punishment, a third pertaining to vengeance and retribution, a Marxian concern with retributive punishment, and a concern with the concept of desert. Each objection is deflected in order to ward-off what seem to be the most serious criticisms of a retributivist view of punishment and to clarify the depth of the retributivist position.",
    abstract_source = "openalex"
}

@misc{corlett2001foundations,
    author = "Corlett, J. Angelo",
    title = "Foundations of a Kantian Retributivism",
    series = "Library of Ethics and Applied Philosophy",
    year = "2001",
    note = "CORE ARGUMENT: Corlett constructs a Kantian retributivism grounded in the value of autonomous rational agency, arguing that the appropriate response to a wrongdoer's free choice to violate the rights of others is a proportionate, desert-based penalty, and that this reading can be defended against standard objections to retributivist theories of punishment. RELEVANCE: Offers a constructive, systematizing Kantian retributivism distinct from the primarily exegetical Byrd/Shell/Merle debate, useful for showing how autonomy-based readings of Kant's ethics more broadly (relevant to other domains in this review) extend into his penal theory. POSITION: Constructive Kantian retributivism grounded in autonomy and desert.",
    keywords = "kant, retributivism, autonomy, desert, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@misc{holtman1997toward,
    author = "Holtman, Sarah Williams",
    title = "Toward Social Reform: Kant's Penal Theory Reinterpreted",
    year = "1997",
    note = "CORE ARGUMENT: Holtman reinterprets Kant's penal theory through the lens of civic respect and social reform rather than strict retribution, arguing that Kant's account can be read as compatible with, and even supportive of, penal institutions oriented toward the moral and social standing of offenders as fellow citizens, softening the harshness typically attributed to Kant's retributivism. RELEVANCE: Provides the domain's clearest dignity/civic-respect-based reading, directly relevant to the research question about dignity-based interpretations of Kant's penal theory as an alternative to strict jus talionis readings. POSITION: Reformist, dignity/civic-respect-based reinterpretation of Kant's retributivism.",
    keywords = "kant, punishment, dignity, civic-respect, social-reform, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "Here I set the stage for developing a Kantian account of punishment attuned to social and economic injustice and to the need for prison reform. I argue that we cannot appreciate Kant's own discussion of punishment unless we read it in light of the theory of justice of which it is a part and the fundamental commitments of that theory to freedom, autonomy and equality. As important, we cannot properly evaluate Kant's advocacy of the law of retribution unless we recognize his theory of justice as an ideal theory. Once we understand both Kant's larger account of justice and its relationship to his less basic commitments, we discover grounds to accept that larger theory, but reject components like the law of retribution with their basis in empirical conclusions we may not share with Kant. We also open the way to develop an account of punishment responsive to social circumstances.",
    abstract_source = "openalex"
}

@misc{pickering2020against,
    author = "Pickering, Mark",
    title = "Against the Hybrid Interpretation of Kant's Theory of Punishment",
    year = "2020",
    note = "CORE ARGUMENT: Pickering argues against the now-dominant hybrid (mixed-theory) interpretation of Kant's penal philosophy, most influentially associated with Byrd, contending that the textual evidence does not support attributing to Kant a systematic combination of consequentialist and retributivist elements, and defending a reading closer to pure retributivism. RELEVANCE: As a recent, direct challenge to the Byrd-initiated consensus, this paper is essential for representing the current state of the interpretive debate and for cautioning against treating the mixed-theory reading as settled. POSITION: Contemporary defense of pure retributivism against the hybrid/mixed-theory interpretive tradition initiated by Byrd.",
    keywords = "kant, punishment, retributivism, pure-retributivism, hybrid-theory, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "In Kants Werk Metaphysik der Sitten, Metaphysische Anfangsgründe der Rechtslehre scheint es so zu sein, dass er zum Strafrecht sowohl retributivistische als auch konsequentialistische Positionen bezieht. In den letzten Jahrzehnten, haben einige Forscher/innen dafür plädiert, dass Kants Theorie des Strafrechts daher ein Hybrid aus Konsequentialismus und Retributivismus sei. B. Sharon Byrds Auslegung ist die einflussreichste Version dieser Ansicht. Ich argumentiere demgegenüber dafür, dass die textlichen Beweise für die konsequentialistische Seite einer hybriden Auslegung nur schwach sind und dass Beweise für eine retributivistische Seite einer hybriden Auslegung nicht vorhanden sind. Es gibt sogar Textstellen, die dieser Auslegung widersprechen. Ich schließe daraus, dass die hybride Auslegung aufgegeben werden sollte.",
    abstract_source = "s2"
}

@article{vilhauer2023five,
    author = "Vilhauer, Benjamin",
    title = "Five Perspectives on Holding Wrongdoers Responsible in Kant",
    journal = "British Journal for the History of Philosophy",
    year = "2023",
    volume = "32",
    note = {CORE ARGUMENT: Vilhauer surveys five distinct perspectives within Kant's philosophy on the appropriate quantity of retribution owed to wrongdoers, distinguishing theoretical from practical standpoints and ranging from "theoretical zero" retribution to "practical infinity" (the standpoint of God and conscience) to "practical equality" (the standpoint of public law punishment), showing that Kant's texts support multiple, not fully reconciled, positions on how much wrongdoers deserve to suffer. RELEVANCE: Offers a fine-grained taxonomy that reframes the pure-retributivist/mixed-theory debate as a question of which of several genuinely Kantian standpoints on retribution should govern legal punishment, directly bearing on how the "island" passage's demand for strict equality relates to Kant's ethics more broadly. POSITION: Interpretive pluralism: Kant holds multiple, standpoint-relative views on the quantity of deserved retribution rather than a single unified theory.},
    keywords = "kant, punishment, retribution, responsibility, standpoints, High, METADATA\\_CLEANED: number, pages, doi",
    abstract = "ABSTRACT The first part of this paper surveys five perspectives in Kant’s philosophy on the quantity of retribution to be inflicted on wrongdoers, ordered by two dimensions of difference – whether they are theoretical or practical perspectives, and the quantity of retribution they prescribe: (1) theoretical zero, the perspective of theoretical philosophy; (2) practical infinity, the perspective of God and conscience; (3) practical equality, the perspective of punishment in public law; (4) practical degrees, the perspective we adopt in private relations to others and (5) practical zero, a perspective I argue is entailed by Kant’s doctrine of strict right, which is his justification of coercing compliance with public law. Kant acknowledges 1–4 but not 5. The second part draws on Kant’s account of the burden of proof in criminal law to argue that Kant is wrong to adopt 3 in responding to criminals, and that we ought to adopt 5 instead.",
    abstract_source = "s2"
}

@misc{vilhauer2017kants,
    author = "Vilhauer, Benjamin",
    editor = "Altman, Matthew C.",
    title = "Kant's Mature Theory of Punishment, and a First Critique Ideal Abolitionist Alternative",
    year = "2017",
    note = {CORE ARGUMENT: Vilhauer presents an interpretation of Kant's mature account of punishment as strongly committed to retributivism, then sketches a non-retributive "ideal abolitionist" alternative grounded in a version of original-position deliberation in which principles of punishment are chosen under the assumption that one is as likely to end up punished as protected by the institution. Vilhauer argues this alternative better fits the spirit of Kant's first-Critique remarks on imputation than his own mature retributivist conclusions do. RELEVANCE: Directly addresses the research question about problems Kant's retributivism raises for contemporary Kantian penal theory, offering a constructive abolitionist alternative built from within Kantian resources rather than simply criticizing Kant's conclusions externally. POSITION: Reconstructive/critical: affirms Kant's mature theory is genuinely retributivist, but argues resources internal to Kant's broader philosophy support a non-retributive, abolitionist alternative.},
    keywords = "kant, punishment, abolitionism, imputation, contemporary-kantian-theory, High, METADATA\\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc",
    abstract = "This chapter has two parts, the first of which is exegesis and exposition, and the second where Vilhauer offer a reconstructive Kantian theory of punishment based on the notion of choosing the principles of punishment in the Rawlsian original position. He argues that we can get a distinctively Kantian theory if we focus on the idea of a Kantian social contract for punishment. Kantians ought to accept that we would rationally consent to universalizable principles of punishment. If we think Rawls is right that original position deliberation gives us a helpful model of how to identify universalizable principles, then we can get Kantian principles of punishment by choosing them in the original position.",
    abstract_source = "openalex"
}

@misc{ataner2006kant,
    author = "Ataner, Attila",
    title = "Kant on Capital Punishment and Suicide",
    year = "2006",
    note = "CORE ARGUMENT: Ataner examines the parallels and tensions between Kant's arguments against suicide (grounded in the duty to preserve one's rational nature) and his defense of capital punishment (which requires the state to end a rational agent's life), asking whether Kant's broader commitments regarding the value of rational life are consistent with endorsing state-imposed death as the uniquely proportionate punishment for murder. RELEVANCE: Connects the capital-punishment debate to Kant's account of the dignity and value of rational agency more broadly, illuminating a tension the research project's dignity-based readings of Kant's penal theory must address. POSITION: Critical examination of internal consistency between Kant's ethics of self-preservation and his penal theory's endorsement of capital punishment.",
    keywords = "kant, capital-punishment, dignity, suicide, consistency, Medium, METADATA\\_CLEANED: journal, volume, number, doi, type:@article->@misc",
    abstract = "In the Metaphysics of Morals Kant clearly, and indeed ardently, upholds the state's right to impose the death penalty in accordance with the law of retribution ( ius talionis ). The “principle of equality” as between crime and punishment demands that those who wrongfully kill another should be put to death, for, in having inflicted such an evil upon another, the murderer has effectively killed himself. Kant is quite emphatic on this point: those who have committed murder “must die ”. Here, he argues, “there is no substitute that will satisfy justice”, for there “is no similarity between life, however wretched it may be, and death, hence no likeness between the crime and the retribution unless death is judicially carried out upon the wrongdoer […]”. The ius talionis is, for Kant, the basic principle and measure in accordance with which criminal justice functions. Since the ius talionis entails a strict equality between crime and punishment, Kant's insistence that only the death penalty serves as the appropriate response to murder (or to any other equally egregious crime) is fairly straightforward.",
    abstract_source = "openalex"
}

@misc{merle2009german,
    author = "Merle, Jean-Christophe",
    title = "German Idealism and the Concept of Punishment",
    year = "2009",
    note = "CORE ARGUMENT: Merle provides a comparative study of the theories of punishment developed within German Idealism, examining Kant's retributivism alongside Fichte's and Hegel's penal theories, and tracing continuities and departures across the tradition regarding the justification of state coercion and the relationship between right, morality, and punishment. RELEVANCE: Situates Kant's specific arguments about punishment within the broader German Idealist tradition, providing comparative context useful for assessing what is distinctively Kantian (as opposed to broadly Idealist) about the retributivist justification of punishment. POSITION: Comparative historical study across Kant, Fichte, and Hegel on punishment, building on Merle's own earlier internal critique of Kant (Merle 2000).",
    keywords = "kant, hegel, fichte, german-idealism, punishment, comparative, Low, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Against the background of early modernism - a period that justified punishment by general deterrence - Kant is usually thought to represent a radical turn towards retributivism. For Kant, and later for Fichte and Hegel, a just punishment respects the humanity inherent in the criminal, and serves no external ends - it is instituted only because the criminal deserves it. In this original study, Jean-Christophe Merle uses close analysis of texts to show that these philosophers did not in fact hold a retributivist position, or even a mixed position; instead he traces in their work the gradual emergence of views in favour of deterrence and resocialisation. He also examines Nietzsche's view that morality rests on the rejection of retribution. His final chapter offers a challenge to the retributivist position, and a defence of resocialisation, in the context of current legal theory and practice concerning the punishment of crimes against humanity.",
    abstract_source = "openalex"
}

@misc{kleingeld2004approaching,
    author = "Kleingeld, Pauline",
    title = "Approaching Perpetual Peace: Kant's Defence of a League of States and his Ideal of a World Federation",
    year = "2004",
    note = {CORE ARGUMENT: Kleingeld argues that Kant advocates a non-coercive league of states in his mature political writings not because he rejects the ideal of a coercive world federation, but because he judges a world republic practically unrealizable and holds that a voluntary league can nonetheless approximate its function. She reconstructs the textual evidence across "Toward Perpetual Peace" and the "Doctrine of Right" to show Kant's reasons for this "negative surrogate" strategy differ from the reasons usually attributed to him. RELEVANCE: This is the primary scholarly reference point for the project's question of why Kant rejects a world state in favor of a federation, and for assessing whether that position is stable -- Kleingeld's answer is that it is a deliberate second-best, not a rejection of the world-republic ideal. POSITION: Defends the "league as negative surrogate for the world republic" reading, later elaborated in Kleingeld 2012 and contested by Caranti 2022.},
    keywords = "league-vs-world-state, foedus-pacificum, international-right, High, METADATA\\_CLEANED: number, pages, doi, METADATA\_CLEANED: journal, volume, type:@article->@misc",
    abstract = "References are to Kants Gesammelte Schriften, edited under the auspices of the Royal Prussian Academy of Sciences (Berlin: Walter de Gruyter, 1902–). References to the Critique of Pure Reason will list the page numbers of the A and B editions. Translations are my own. Abbreviations: C1=Critique of Pure Reason; IUH=Idea for a Universal History from a Cosmopolitan Point of View; MM=Metaphysics of Morals; PP=Perpetual Peace; Rel=Religion within the Limits of Reason Alone; TP=On the Common Saying: This May Be True in Theory But It Does Not Apply in Practice.",
    abstract_source = "openalex"
}

@misc{kleingeld2014kants,
    author = "Kleingeld, Pauline",
    title = "Kant's Second Thoughts on Colonialism",
    year = "2014",
    note = {CORE ARGUMENT: Kleingeld argues that Kant's forceful condemnations of European colonialism in "Toward Perpetual Peace" and the "Metaphysics of Morals" mark a substantive change of mind, closely tied to a parallel revision in his views on race: the endorsement of a racial hierarchy that had underwritten his earlier acceptance of colonial practice was dropped in the 1790s in favor of a more genuinely egalitarian and cosmopolitan position. RELEVANCE: Directly addresses how cosmopolitan right constrains Kant's remarks on colonial practice, and supplies the textual basis (a documented change of mind) for assessing whether Kant's anti-colonial stance is continuous with or a rupture from his earlier writings. POSITION: Represents the "developmental" reading of Kant on race and colonialism, against readings (e.g., in the same volume) that stress continuity of racial hierarchy into the late writings.},
    keywords = "colonialism, race, cosmopolitan-right, High, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "Kant is widely regarded as a fierce critic of colonialism. In Toward Perpetual Peace and the Metaphysics of Morals, for example, he forcefully condemns European conduct in the colonies as a flagrant violation of the principles of right. His earlier views on colonialism have not yet received much detailed scrutiny, however. This essay argues that Kant actually endorsed and justified European colonialism until the early 1790s. The chapter shows that Kant's initial endorsement and his subsequent criticism of colonialism are closely related to his changing views on race, because his endorsement of a racial hierarchy plays a crucial role in his justification of European colonialism. He gave up both in the mid 1790s while he was developing his legal and political philosophy, and he adopted a more egalitarian version of the cosmopolitan relationship among peoples.",
    abstract_source = "openalex"
}

@misc{kleingeld2012kant,
    author = "Kleingeld, Pauline",
    title = "Kant and Cosmopolitanism: The Philosophical Ideal of World Citizenship",
    year = "2012",
    address = "New York",
    note = {CORE ARGUMENT: Kleingeld provides a comprehensive reconstruction of Kant's cosmopolitanism by situating it against contemporary German interlocutors (Fichte, Cloots, Forster, Hegewisch, Wieland, Novalis), covering the relationship between cosmopolitanism and patriotism, the international federation, global hospitality, race and cultural pluralism, and global economic justice. She argues that Kant's philosophical cosmopolitanism underwent a substantial transformation in the mid-1790s and that the resulting mature theory is philosophically more defensible than commonly assumed. RELEVANCE: The most systematic secondary treatment of Kant's cosmopolitanism available, and the primary reference for every strand of this domain -- the federation debate, the theory of hospitality, and the question of race and colonialism are each given a dedicated chapter. POSITION: Comparative-historical reconstruction that grounds the "developmental" reading of Kant's cosmopolitanism (a shift toward greater consistency and egalitarianism in the 1790s) defended in Kleingeld's related articles. SEP\\_CONTEXT: The SEP entry "Kant's Social and Political Philosophy" cites Kleingeld 2012 for the claim (alongside Kleingeld 2025) that Kant reformed his racial views late in his career, and separately cites it (with Corradetti 2020 and Huber 2022) as elaborating aspects of Kant's cosmopolitanism "beyond narrow limits" of the hospitality right; the preamble groups it among works that have driven increased recent attention to Kant's international and cosmopolitan law (alongside Cavallar 2015, Ripstein 2021, Flikschuh and Ypi 2014, and Vaha 2021).},
    keywords = "cosmopolitan-right, world-citizenship, race, federation, High, METADATA\\_CLEANED: publisher, type:@book->@misc",
    abstract = {Pauline Kleingeld's volume examines Kant's shifting attitude toward "cosmopolitanism," with particular emphasis on his settled or final views, which on her account fully emerge only in the 1790s. Each chapter juxtaposes Kant's evolving position with that of a less well-known contemporary author whose opinions approach those typically (but wrongly) associated with Kant himself: Wieland on moral cosmopolitanism and patriotism; Cloots on global peace and the world-republic ideal; a chapter on cosmopolitan right covering humanitarian right and refugee policy; a chapter on race tracing the decline of Kant's earlier racial hierarchy; and a chapter on commerce contrasting Kant with the economic thought of Dietrich Hermann Hegewisch. Kleingeld's central claim is that Kant's ultimate positions on these issues are considerably more subtle and internally coherent than current opinion generally allows, and that the key to his approach to world-republicanism lies in the necessarily voluntary character of any nation-state's submission to an international union.},
    abstract_source = "ndpr"
}

@misc{flikschuhypi2014kant,
    editor = "Flikschuh, Katrin and Ypi, Lea",
    title = "Kant and Colonialism: Historical and Critical Perspectives",
    year = "2014",
    note = {CORE ARGUMENT: This edited volume brings together historians and normative theorists to place Kant's scattered remarks on colonialism in their historical context, examine the internal tensions colonialism produces within his critical philosophy and theory of right, and assess the contemporary relevance of these reflections for debates on global justice and reparative obligations. Contributions range across whether Kant is best read as an apologist for or a critic of European colonial practice. RELEVANCE: The central reference collection for the project's question of how cosmopolitan right relates to and constrains Kant's remarks on colonialism; its introduction explicitly frames the "apologist or critic" debate that structures the secondary literature. POSITION: Not a single position but the primary venue in which the developmental (Kleingeld), continuity/critical (e.g., Bernasconi-influenced), and rights-superseding (Stilz, Waligore) readings of Kant on colonialism are juxtaposed.},
    keywords = "colonialism, race, cosmopolitan-right, edited-volume, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "This book examines Kant's controversial position on colonialism in the context of his wider cosmopolitan commitments. The book explores Kant's maturing opposition to European conquest and colonization, and the implication of that opposition to his moral and political thinking more generally. The book offers no single overall position on the subject matter but draws instead on the distinctive disciplinary expertise of individual contributors. In consequence, a picture emerges of the considerable complexity of the issue, including Kant's many-faceted response to it, from the role of race and trade relations in his early and late teleological thinking, his acknowledgement of permissible as against impermissible colonial settlements, his late position on land rights of non-state peoples, and his view of the relation between war and colonial conquest, to prospects for Kantian principles of restorative international law. The opening chapters situate Kant's unstable general conception of colonialism in historical context; the closing chapter explores the abiding relevance of Kant's growing anti-colonial stance to current cosmopolitan thinking.",
    abstract_source = "openalex"
}

@misc{benhabib2004hospitality,
    author = "Benhabib, Seyla",
    title = "On Hospitality: Rereading Kant's Cosmopolitan Right",
    year = "2004",
    note = {CORE ARGUMENT: Benhabib rereads Kant's cosmopolitan right of hospitality as a resource -- but also as an insufficiently developed one -- for thinking through the normative status of migrants, refugees, and resident aliens in the contemporary state system. She argues that Kant's own restriction of the right to a mere right to temporary sojourn, rather than to membership, leaves a normative gap between the "rights of man" and the "rights of the citizen" that contemporary theorists of cosmopolitanism must address through what she calls "democratic iterations." RELEVANCE: The key text for the project's question of how the right of hospitality has been mobilized in contemporary debates on migration and refugees; supplies both a sympathetic reconstruction of Kant's limits and a normative argument for going beyond them. POSITION: Represents a critical-cosmopolitan appropriation of Kant that pushes past the narrow right to visit toward stronger claims for migrants, in dialogue with (and partial departure from) Kant's own textual restrictions.},
    keywords = "hospitality, migration, cosmopolitan-right, High, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = {This chapter begins with an analysis of Kant's understanding of cosmopolitan right. Kant's discussion focuses on moral and legal relations which hold among individuals across bounded communities, and thereby demarcates a novel domain situated between the law of specific polities on the one hand and customary international law on the other. As Katrin Flikschuh puts it, Kant recognizes three distinct though related levels of rightful relation: the "Right of a State" specifies relations of Right between persons within a state; the "Right of Nations" pertains to relations of Right between states; and "the Right for all nations" or "cosmopolitan Right" concerns relations of Right between persons and foreign states. The normative dilemmas of political membership are localized within this third sphere of jus cosmopoliticum. Written in 1795, upon the signing of the Treaty of Basel by Prussia and revolutionary France, Kant's essay on "Perpetual Peace" formulates three "definitive articles for perpetual peace among states": that the civil constitution of every state shall be republican; that the law of nations shall be founded on a federation of free states; and that the law of world citizenship shall be limited to conditions of universal hospitality.},
    abstract_source = "openalex"
}

@misc{doyle1986liberalism,
    author = "Doyle, Michael W.",
    title = "Liberalism and World Politics",
    year = "1986",
    note = {CORE ARGUMENT: Doyle argues that Kant's three "definitive articles" in "Toward Perpetual Peace" (republican constitutions, a pacific union, and cosmopolitan right) explain a genuine empirical pattern: liberal states have historically almost never gone to war with one another, even as they have been as war-prone as other states in relations with non-liberal states. He treats Kant's essay as offering a causal, not merely normative, theory of interstate peace. RELEVANCE: The founding statement of the "democratic peace" research program that subsequent international-relations scholarship (and critiques of it, e.g., Simpson 2018) trace back to Kant's definitive articles; essential background for assessing the institutional afterlife of Kant's federation and republicanism requirements. POSITION: Establishes the canonical liberal-institutionalist reading of Kant as a proto-democratic-peace theorist, later qualified and criticized within Kant scholarship for conflating Kant's normative argument with an empirical regularity.},
    keywords = "democratic-peace, republicanism, international-right, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Building on a growing literature in international political science, I reexamine the traditional liberal claim that governments founded on a respect for individual liberty exercise "restraint" and "peaceful intentions" in their foreign policy. I look at three distinct theoretical traditions of liberalism, attributable to three theorists: Schumpeter, a democratic capitalist whose explanation of liberal pacifism we often invoke; Machiavelli, a classical republican whose glory is an imperialism we often practice; and Kant, a liberal republican whose theory of internationalism best accounts for what we are. Despite the contradictions of liberal pacifism and liberal imperialism, I find, with Kant and other democratic republicans, that liberalism does leave a coherent legacy on foreign affairs. Liberal states are different. They are indeed peaceful. They are also prone to make war. Liberal states have created a separate peace, as Kant argued they would, and have also discovered liberal reasons for aggression, as he feared they might. I conclude by arguing that the differences among liberal pacifism, liberal imperialism, and Kant's internationalism are not arbitrary. They are rooted in differing conceptions of the citizen and the state.},
    abstract_source = "openalex"
}

@misc{teson1992kantian,
    author = "Tes\'{o}n, Fernando R.",
    title = "The Kantian Theory of International Law",
    year = "1992",
    note = "CORE ARGUMENT: Tesón develops a Kantian theory of international law centered on the moral primacy of individual autonomy and republican governance, arguing that legitimate international law and intervention doctrine should track the internal legitimacy of states rather than treating state sovereignty as an independent moral value. He uses Kant's linkage between republican constitutions and international peace to ground a liberal account of when international law may permissibly constrain or override sovereignty claims. RELEVANCE: A widely cited legal-theoretic application of Kant's international right that connects the republicanism requirement of the definitive articles to contemporary debates on humanitarian intervention and the legitimacy of international law, complementing the more historically oriented literature. POSITION: A liberal-cosmopolitan legal theory that reads Kant as licensing a more interventionist, individual-rights-centered international law than Kant's own text straightforwardly supports -- a reading contested by scholars emphasizing Kant's insistence on non-interference (the fifth preliminary article).",
    keywords = "international-law, republicanism, sovereignty, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = "This Article defends the view, first developed by Immanuel Kant, that international law and domestic justice are fundamentally connected.",
    abstract_source = "openalex"
}

@misc{ganesh2018wirtbarkeit,
    author = "Ganesh, Aravind",
    title = "Wirtbarkeit: Cosmopolitan Right and Innkeeping",
    year = "2018",
    note = {CORE ARGUMENT: Ganesh argues that Kant's bracketed use of "Wirtbarkeit" (innkeeping) alongside "Gastfreundschaft" (hospitality) in "Toward Perpetual Peace" is not incidental but tracks a real analogy with the private law of innkeeping found in the Digest of Justinian, where hospitality for innkeepers is a strict legal obligation rather than a matter of philanthropy. He uses this analogy to explain and defend cosmopolitan right as derivable solely from the innate right to freedom, rather than from acquired facts such as land distribution or historical injustice. RELEVANCE: Provides the most precise account available of what the right of hospitality entails as a matter of legal obligation (a limited right to offer commerce and temporary presence, not a right to settle), directly answering the project's second guiding question. POSITION: A textually grounded, doctrinally focused reading that resists expansive contemporary appropriations of cosmopolitan right (e.g., toward migration or refugee rights) by tying its content tightly to Kant's innate-right framework.},
    keywords = "hospitality, cosmopolitan-right, innate-right, High, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {After defining Cosmopolitan Right as being limited to the conditions of "hospitality," Kant includes "Wirtbarkeit" in brackets, a word that connotes innkeeping. Moreover, significant similarities obtain between the relevant passages of the Perpetual Peace and those of the Digest of Justinian on the obligations of ships' masters, innkeepers, and stable keepers. Unlike for ordinary householders, hospitality for innkeepers is a legal obligation, not a matter of philanthropy: they have traditionally been deemed public officials with limited discretion to refuse travelers, and as fiduciaries of their guests strictly liable for losses to their property. This article attempts to explain Kant's concept of Cosmopolitan Right by analogy to the private law of innkeeping, and ultimately engages in the central philosophical debate about Cosmopolitan Right by accounting for Cosmopolitan Right solely from the "innate" right to freedom, rather than from "acquired" facts such as land or resource distributions or historical injustices.},
    abstract_source = "openalex"
}

@misc{valdez2011perpetual,
    author = "Valdez, In\'{e}s",
    title = "Perpetual What? Injury, Sovereignty and a Cosmopolitan View of Immigration",
    year = "2011",
    note = {CORE ARGUMENT: Valdez argues that Kant's cosmopolitan right, properly understood in light of his account of the wrongfulness of colonial injury and the original common possession of the earth, supports a more robust cosmopolitan view of immigration than the standard "right to visit, not to settle" reading allows, once the historical injuries inflicted by sovereign states on migrants and colonized peoples are taken into account. RELEVANCE: Directly engages the project's second guiding question by arguing for an expansive, historically sensitive appropriation of cosmopolitan right in immigration debates, in tension with narrower doctrinal readings such as Ganesh's. POSITION: A revisionist-cosmopolitan reading that links immigration ethics to reparative concerns about historical injury, contesting minimalist interpretations of Kantian hospitality.},
    keywords = "migration, hospitality, cosmopolitan-right, colonialism, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {Can Kantian cosmopolitanism contribute to normative approaches to immigration? Kant developed the universal right to hospitality in the context of late eighteenth-century colonialism. He claimed that non-European countries had a sovereign right over their territory and the conditions of foreigners' visits. This sovereign prerogative limited visitors' right to hospitality. The interconnected and complementary system of right he devised is influential today, but this article argues that maintaining the complementarity of the three realms involves reconsidering its application to contemporary immigration. It situates Kant's Perpetual Peace within the context of debates about conquest and colonialism and argues that Kant's strict conception of sovereignty is justified by his concern in maintaining a realm of sovereignty that is complementary with cosmopolitanism and his prioritization of mutual agreements in each of the realms, particularly in a context of international power asymmetry. In Kant's time, European powers appropriated cosmopolitan discourses to defend their right to visit other countries and it was necessary to strengthen non-Europeans' sovereign claims. The strength and hostility of the visitors made limited hospitality and strong sovereignty act in tandem to keep away conquerors, expanding cosmopolitanism. Today, individuals from poor countries migrate to wealthier ones where they are subject to a sovereign authority that excludes them. Sovereignty and cosmopolitanism no longer work complementarily, but rather strengthen powerful state actors vis-\`{a}-vis non-citizens subject to unilateral rule. Maintaining the pre-eminence of the right to freedom, the article suggests that only through the creation of "cosmopolitan spaces" of politics can we reproduce today the complementarity that Kant envisioned.},
    abstract_source = "openalex"
}

@misc{simpson2018making,
    author = "Simpson, Sid",
    title = "Making Liberal Use of Kant? Democratic Peace Theory and Perpetual Peace",
    year = "2018",
    note = {CORE ARGUMENT: Simpson argues that contemporary democratic peace theory has substituted commerce and trade for Kant's third prescription -- an ethos of universal hospitality -- thereby producing tensions between the empirical democratic-peace research program and the normative structure of "Toward Perpetual Peace." He traces why this substitution occurred and proposes reformulating the relationship between peace, democracy, and commerce closer to Kant's original triad. RELEVANCE: A direct critique of the Doyle-inspired appropriation of Kant, useful for assessing the stability and fidelity of the "democratic peace" tradition to Kant's actual definitive articles, particularly the often-neglected third article on cosmopolitan right. POSITION: A revisionist critique from within international-relations theory, arguing that democratic peace theory has drifted from and partially misrepresents Kant's cosmopolitan-right-inclusive vision of peace.},
    keywords = "democratic-peace, hospitality, foedus-pacificum, Medium, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc, METADATA\_CLEANED: volume",
    abstract = "The work of Immanuel Kant has been foundational in modern democratic peace theory. His essay Toward Perpetual Peace gives three prescriptions for attaining peace between democracies: republican institutions, a pacific union between states, and an ethos of universal hospitality. Contemporary democratic peace theory, however, has warped the Kantian framework from which it draws inspiration: the third prescription has been gradually substituted for commerce and trade. I argue that this change in emphasis produces tensions between Perpetual Peace and the body of democratic peace theory literature it spawned. Moreover, I contend that a look back at Kant's essay sheds light on why this transformation occurred. Finally, I use this new look back at Perpetual Peace to reformulate the relationship between peace, democracy, and commerce so as to offer a new perspective on the democratic peace theory/capitalist peace theory debate.",
    abstract_source = "s2"
}

@misc{stonesweetryan2018perpetual,
    author = "Sweet, Alec Stone and Ryan, Clare",
    title = "Perpetual Peace and the Cosmopolitan Constitution",
    year = "2018",
    note = {CORE ARGUMENT: Stone Sweet and Ryan argue that the six preliminary and three definitive articles of "Toward Perpetual Peace" map onto the massive transformation of European institutions that produced a modern "cosmopolitan legal order" -- the authors read Kant as prioritizing the achievement of a "Rightful condition" among states and persons over the narrower political-science focus on the absence of war among liberal states, and develop a Kantian-congruent account of constitutional justice at both domestic and transnational levels. RELEVANCE: Provides a sustained argument for treating the European Convention on Human Rights and associated institutions as an approximation of Kant's cosmopolitan constitution, directly relevant to contemporary debates about whether cosmopolitan right has been institutionally realized. POSITION: An institutionalist-legal reading that treats Kant's cosmopolitan constitution as a regulative ideal partially realized in existing transnational legal orders, complementing Wolthuis's (2025) more skeptical assessment of EU law as cosmopolitan right.},
    keywords = "cosmopolitan-constitution, international-right, European-Union, Medium, METADATA\\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc",
    abstract = "In Toward Perpetual Peace among States (1795), Kant outlined a blueprint for achieving peace and Right on the basis of six preliminary and three definitive articles, which are stated in the form of a treaty or constitution. In Europe, the definitive articles map onto a massive transformation of institutions that combined to enable the CLO to emerge. Political scientists have focused on Kant's explanation of the absence of war among liberal states. Yet Kant himself prioritized a broader goal: the achievement of a Rightful condition among states and persons. In his essay, Kant argued forcefully to his conclusion that all state officials bear a moral duty to work to achieve a Rightful condition, while telling us little about how to proceed in practice. In subsequent chapters, the authors develop a Kantian-congruent account of a modern system of constitutional justice at both the domestic and transnational levels.",
    abstract_source = "s2"
}

@misc{wolthuis2025eu,
    author = "Wolthuis, Bertjan",
    title = "Is EU Law Positive Cosmopolitan Right \`{a} la Kant?",
    year = "2025",
    note = {CORE ARGUMENT: Wolthuis argues that EU law is not positive cosmopolitan right in Kant's technical sense, because cosmopolitan right is strictly limited to the right of travelers to be treated peacefully by foreign states (Gastrecht acquired only by treaty), whereas EU law grants member-state nationals the much stronger status of guests with rights of residence and integration -- EU treaties are "wohlt\"{a}tige Vertr\"{a}ge" that exceed Kant's minimal requirement of peace. RELEVANCE: Offers a precise, contemporary test case for the project's second guiding question, showing exactly where a leading real-world candidate for institutionalized cosmopolitan right (EU free movement) diverges from Kant's own narrow definition of hospitality. POSITION: A conservative, text-based reading of cosmopolitan right that resists assimilating expansive contemporary legal integration projects to Kant's category, in contrast with the more expansive readings of Valdez and Benhabib.},
    keywords = "hospitality, European-Union, cosmopolitan-right, Medium, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {The question raised in this article is whether EU law is positive cosmopolitan right in Kant's sense. If it is, it could be viewed as a contribution to Kant's project of "perpetual peace." The conclusion of this article is that EU law is not positive cosmopolitan right. The main reason is that cosmopolitan right is limited to the right of travellers to be treated peacefully by foreign states. EU law accomplishes much more than that. EU member states have agreed by treaty to host each other's nationals, who thereby have attained the status of guests in foreign EU member states. The implication of this is that EU law qualifies as hospitality right or "Gastrecht," as Kant calls it (AK 8:358), which is a right that can be acquired by treaty, whereas cosmopolitan right -- which specifies the innate right of human beings and states to be on Earth -- is limited to the conditions of hospitality, as Kant writes in Zum ewigen Frieden. This means that the European Union fulfils much more than a requirement of peace as understood by Kant. Its treaties are "wohlt\"{a}tiger Vertr\"{a}ge" (AK 8:358), fulfilling requirements of integration between the participating states and their nationals.},
    abstract_source = "s2"
}

@misc{milstein2017perpetual,
    author = "Milstein, Brian",
    title = "Perpetual Peace and Cosmopolitical Method",
    year = "2017",
    note = {CORE ARGUMENT: Milstein argues that Kant's concept of "commercium" -- the thoroughgoing interaction of human beings who share the earth in common -- discloses a more critical, historically reflexive perspective on world history than is visible if one focuses only on the prescriptive recommendations of "Toward Perpetual Peace." He distinguishes this descriptive-critical level of Kant's cosmopolitanism from the normative level and argues it can be developed into a more open-ended, reflexive conception of cosmopolitan thinking. RELEVANCE: Complicates a purely normative reading of cosmopolitan right by recovering its grounding in Kant's philosophy of history and the idea of original common possession of the earth, which is directly relevant to debates (e.g., Valdez, Waligore) about how far cosmopolitan right can be extended. POSITION: A critical-theoretic reading (in the tradition of Habermasian appropriations of Kant) that treats cosmopolitanism as a "problematic" to be continually reworked rather than a fixed doctrine exhausted by the three definitive articles.},
    keywords = "cosmopolitan-right, commercium, philosophy-of-history, Low, METADATA\\_CLEANED: journal, volume, number, pages, doi, type:@article->@misc",
    abstract = {This article explores the bases of Kant's cosmopolitanism in his more systematic writings on freedom, judgment, and community. My argument is that, if we peer beneath his more explicitly normative prescriptions for achieving "perpetual peace," we find the tools not just of a cosmopolitan vision but what we might call a "cosmopolitical method." While many assume Kant's political thought descends directly from his moral philosophy, a look back at relevant passages in the first Critique reveals an alternative reading that points toward his theory of reflective judgment, which combines practical freedom with judgments based on theoretical concepts. Of particular importance is Kant's conception of community as commercium, through which Kant discerns all matters of right to concern the way free actors are constrained to share the earth in common. These considerations allow for a broader way of thinking about Kantian cosmopolitanism, one that is responsive to the reflective judgment of world citizens as they encounter new challenges.},
    abstract_source = "openalex"
}

@misc{caranti2022kantian,
    author = "Caranti, Luigi",
    title = "The Kantian Federation",
    year = "2022",
    note = {CORE ARGUMENT: Caranti argues that the non-coercive league of states, rather than a coercive world republic, is Kant's considered and philosophically defensible position, not merely a provisional "negative surrogate." He locates the core of the debate in the tension between two desiderata that any theory of international peace must satisfy: an institution with genuine coercive power to secure peace, and the avoidance of excessive erosion of state sovereignty, arguing that national sovereignty is indissolubly linked to states' full autonomy regarding the use of military power. RELEVANCE: The primary contemporary counterweight to Kleingeld's reading and thus essential for assessing whether Kant's preference for a federation over a world state is philosophically stable; directly targets the project's first guiding question. POSITION: Defends the "league as Kant's genuine, non-provisional position" reading against the Kleingeld/Byrd-and-Hruschka view that Kant's rational ideal remains the coercive world republic.},
    keywords = "league-vs-world-state, foedus-pacificum, sovereignty, High, METADATA\\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "This Element introduces the reader to Kant's theory of peace and to its place in the broader context of the critical philosophy. It also delves into one aspect of the model that has generated much debate among interpreters, given Kant's changing thoughts on the matter. This aspect relates to the nature and powers of the international federation. Defending the idea that national sovereignty is indissolubly linked to states' full autonomy regarding the use of military power, this Element offers an interpretation and defense of the Kantian federation that, in many regards, departs from the mainstream reading. Special emphasis is placed on the problematic coexistence of two conflicting theoretical desiderata: on the one hand, the necessity of establishing an international institution with coercive powers for securing peace; on the other hand, the necessity of avoiding the risk of an excessive erosion of states' sovereignty.",
    abstract_source = "s2"
}

@misc{cavallar2020kant,
    author = "Cavallar, Georg",
    title = "Kant and the Theory and Practice of International Right",
    year = "2020",
    edition = "2nd",
    note = {CORE ARGUMENT: Cavallar offers a comprehensive study of Kant's theory of international right, situating it within the broader natural-law and ius gentium tradition and examining how Kant's normative proposals in "Toward Perpetual Peace" and the "Doctrine of Right" relate to the practical politics of his own era, including the conduct of contemporary European states such as Prussia. RELEVANCE: A standard comprehensive reference for Kant's international right as a whole, useful for triangulating the league-versus-world-state debate against the historical context in which Kant wrote and against rival systematic treatments such as Höffe's. POSITION: A historically embedded systematic reading that treats Kant's international right as continuous with, rather than a radical break from, the earlier natural-law tradition of Grotius, Pufendorf, and Vattel. SEP\\_CONTEXT: The SEP entry "Kant's Social and Political Philosophy" groups this book (alongside Ripstein 2021, Kleingeld 2012, Flikschuh and Ypi 2014, and Vaha 2021) as part of the body of work responsible for the recent surge of scholarly attention to Kant's international and cosmopolitan law.},
    keywords = "international-right, ius-gentium, league-vs-world-state, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{hoffe2006kants,
    author = {H\"{o}ffe, Otfried},
    title = "Kant's Cosmopolitan Theory of Law and Peace",
    year = "2006",
    address = "New York",
    note = {CORE ARGUMENT: H\"{o}ffe provides a systematic, section-by-section commentary on "Toward Perpetual Peace," reconstructing Kant's argument that a world of republican states bound together in a pacific federation, and individuals possessing a limited cosmopolitan right of hospitality, together constitute the "highest political good." He situates this argument within Kant's broader theory of right and defends its continued relevance for contemporary international law, ultimately arguing (against most other commentators) that Kant is best read as endorsing a minimal, subsidiary world republic rather than a mere federation as the only institution capable of achieving a truly lasting, global peace. RELEVANCE: One of the most systematic and widely cited commentaries on "Toward Perpetual Peace" as a whole, giving sustained attention to the preliminary articles, the definitive articles, and the doctrine of cosmopolitan right, and thus a natural anchor text for all three of the project's guiding questions. POSITION: A reconstructive commentary that defends the coherence of Kant's threefold system of public right and, unusually, argues for the "maximalist" (world-republic) rather than "minimalist" (federation) reading of Kant's institutional proposal, in direct tension with both Kleingeld's negative-surrogate reading and Caranti's league-as-genuine-position reading. SEP\\_CONTEXT: The SEP entry "Kant's Social and Political Philosophy" cites H\"{o}ffe 2002 and 2006 (alongside Flikschuh 2000, Caranti 2017, and Ellis 2008) as work that applies Kant's political philosophy to contemporary issues and debates.},
    keywords = "international-right, foedus-pacificum, cosmopolitan-right, High, METADATA\\_CLEANED: publisher, type:@book->@misc",
    abstract = {Kant's place in modern philosophy is largely assured by his critical works, which taken together constitute the systematic development of his transcendental philosophy. By contrast, his political writings mostly take the form of essays and often seem unsystematic and best understood in relation to events of his time. While Kant's Perpetual Peace has had enormous influence historically, it is in crucial respects a large departure from his previous views on cosmopolitanism and difficult to square with many of his writings. In this book, Otfried H\"{o}ffe makes the case that Perpetual Peace in fact provides a systematic political philosophy from a cosmopolitan point of view, in which Kant "elevates peace to a fundamental concept of philosophy." This cosmopolitanism is based on a comprehensive conception of law and right, and takes up the great political innovations of the modern era, a republic based upon legally guaranteed human rights. Far from being a proponent of a second-best solution to the problem of a global order in the form of a confederation of republican states, H\"{o}ffe argues that Kant is best thought of as defending "a federal, subsidiary world republic" as the only means to achieving a lasting or perpetual peace that is truly global, permanent, and unconditional. The book connects "the right to right" -- the right of every legal subject to be reckoned with as a legal person and integrated into the community of persons living under a legal form -- to a comprehensive theory of global public right encompassing the right of a state, the right of nations, and cosmopolitan right, and argues that only a minimal world state, rather than an ever-expanding federation, can institutionalize this right to right on a truly global scale.},
    abstract_source = "ndpr"
}

@misc{muthu2003enlightenment,
    author = "Muthu, Sankar",
    title = "Enlightenment against Empire",
    year = "2003",
    note = {CORE ARGUMENT: Muthu argues that Diderot, Kant, and Herder each developed, on independent grounds, a philosophical anti-imperialism rooted in an understanding of human beings as inherently cultural agents whose diversity of ways of life is not evidence of inferiority but an expression of the same rational agency that grounds moral status. Chapter five, "Kant's Anti-imperialism: Cultural Agency and Cosmopolitan Right," argues that Kant's mature cosmopolitan right, precisely because it is limited to a right to offer commerce rather than a right of conquest or settlement, functions as a systematic philosophical constraint on European imperial practice. RELEVANCE: Situates Kant's anti-colonial cosmopolitan right within a broader current of Enlightenment political thought, complicating any narrative that treats Enlightenment universalism as straightforwardly complicit with empire, and offering an alternative frame to Kleingeld's developmental account -- Muthu treats Kant's mature anti-imperialism as flowing from cultural-agency commitments already present in his critical philosophy. POSITION: Reconstructs an Enlightenment anti-imperialist tradition in which Kant's cosmopolitan right is a considered philosophical achievement rather than either an inconsistency or a late correction, in partial contrast with Kleingeld's emphasis on a documented change of mind.},
    keywords = "colonialism, cosmopolitan-right, cultural-agency, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@misc{waligore2023remedying,
    author = "Waligore, Timothy",
    title = "Remedying Cosmopolitan Wrongs: Indigenous Peoples, Kant, and Historical Injustice",
    year = "2023",
    note = "CORE ARGUMENT: Waligore argues that Kant limits cosmopolitan right to a universal right of hospitality that condemns European imperial practices toward indigenous peoples while permitting only a right to visit foreign countries for the purpose of offering commerce, and contends that attempts by contemporary theorists (e.g., Jeremy Waldron) to expand and update this juridical category in the name of remedying historical injustice would blunt or erase Kant's own anti-colonial doctrine rather than extend it. RELEVANCE: Provides the project's clearest statement of the tension between narrow, doctrinally faithful readings of hospitality and contemporary attempts to mobilize cosmopolitan right for reparative or historical-injustice claims involving indigenous peoples, complementing Valdez's more expansive reading. POSITION: A textually conservative defense of Kant's narrow hospitality right, arguing that its very narrowness is what makes it anti-colonial, against expansive contemporary appropriations that would convert it into a broader remedial right.",
    keywords = "colonialism, hospitality, indigenous-peoples, historical-injustice, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{kant2006perpetualpeace,
    author = "Kant, Immanuel",
    editor = "Kleingeld, Pauline",
    title = "Toward Perpetual Peace and Other Writings on Politics, Peace, and History",
    year = "2006",
    address = "New Haven",
    note = {CORE ARGUMENT: Standard English-language collection of Kant's key writings on history and international politics, translated by David L. Colclasure, including "Idea for a Universal History with a Cosmopolitan Aim," "Conjectural Beginning of Human History," "Toward Perpetual Peace," excerpts from the Doctrine of Right, and Part 2 of "The Contest of the Faculties," with accompanying essays by Jeremy Waldron, Michael W. Doyle, and Allen W. Wood. RELEVANCE: Provides the primary-source basis for this entire domain; the texts collected here are the direct object of every secondary-literature debate catalogued in this bibliography (regulative vs. constitutive teleology, unsocial sociability, the guarantee of peace). POSITION: Primary source edition, not itself a position in the scholarly debate.},
    keywords = "primary-source, philosophy-of-history, cosmopolitanism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{yovel1980kant,
    author = "Yovel, Yirmiyahu",
    title = "Kant and the Philosophy of History",
    year = "1980",
    address = "Princeton",
    note = {CORE ARGUMENT: Argues that a "history of reason" is genuine and central to Kant's system, not a peripheral or merely popular appendage to the critical philosophy; traces how Kant's practical philosophy shifts toward treating the synthesis of morality and nature -- the highest good -- as an object of duty realized progressively in history. RELEVANCE: The foundational book-length treatment establishing that Kant's philosophy of history deserves systematic philosophical (not just exegetical) treatment; subsequent debates over the regulative vs. constitutive status of historical teleology (Kleingeld, Ypi, Allison) take Yovel's study as a reference point. POSITION: Robust reading -- treats the "history of reason" as doing substantive systematic work connecting theoretical, practical, and historical philosophy, rather than as a mere regulative heuristic.},
    keywords = "philosophy-of-history, teleology, highest-good, foundational, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{kleingeld2001nature,
    author = "Kleingeld, Pauline",
    title = "Nature or Providence? On the Theoretical and Moral Importance of Kant's Philosophy of History",
    year = "2001",
    number = "2",
    note = {CORE ARGUMENT: Clarifies and explains Kant's fluctuating use of the terms "Nature" and "Providence" in the historical essays, arguing that this terminological variation is symptomatic of a deeper and underappreciated fact: Kant's philosophy of history performs a function in both his theoretical and his practical philosophy simultaneously, not merely one or the other. RELEVANCE: Directly addresses whether Kant's historical teleology is a theoretical (quasi-metaphysical) claim or a practically oriented regulative device by showing the two functions are intertwined rather than exclusive -- reframing the standard either/or question posed in this domain's key questions. POSITION: Integrative reading that resists collapsing the theoretical/practical distinction cleanly onto the constitutive/regulative debate.},
    keywords = "philosophy-of-history, providence, regulative-idea, teleology, High, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Soulevant la question de la relation entre nature et providence dans la philosophie de l'histoire kantienne, l'A. montre que la preference de Kant pour le terme de providence dans «L'idee d'une histoire universelle» correspond au passage de la question theorique de l'ordre dans l'histoire a ne approche morale de l'histoire fondee sur le principe teleologique.",
    abstract_source = "openalex"
}

@misc{kleingeld2008historiography,
    author = "Kleingeld, Pauline",
    title = "Kant on Historiography and the Use of Regulative Ideas",
    year = "2008",
    number = "4",
    note = {CORE ARGUMENT: Examines Kant's methodological remarks in "Idea for a Universal History" against the background of the Critique of Pure Reason's account of regulative ideas, arguing that Kant's methodological approach -- treating history as a whole under a regulative idea that is grand in scope but epistemically modest and fallibilistic -- remains fruitful, even though the specific teleological model of history Kant builds on this method (nature's plan for humanity) cannot simply be appropriated today. RELEVANCE: The clearest direct answer in the literature to this domain's first key question: it explicitly distinguishes Kant's regulative methodology (defensible) from his substantive historical-teleological content (not defensible as such), giving a synthesis writer a sharp analytical tool for separating these two levels. POSITION: Regulative/deflationary reading -- historiographical regulative ideas are epistemically modest heuristics, not metaphysical or empirical claims about how history must unfold.},
    keywords = "regulative-idea, historiography, teleology, critical-epistemology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{oneill2008historical,
    author = "O'Neill, Onora",
    title = "Historical Trends and Human Futures",
    year = "2008",
    number = "4",
    note = {CORE ARGUMENT: Argues that Kant's "Idea for a Universal History" differs in deep ways from standard Enlightenment views of human history: although Kant agrees with contemporaries that unsocial sociability can drive human progress, he insists that we know too little about the actual trends of history to offer either a metaphysical defence or an empirical vindication of humanity's perfectibility or the inevitability of progress. On O'Neill's reading, Kant treats human progress as a practical assumption -- an Idea of Reason -- rather than a theoretical claim. RELEVANCE: Directly supports the regulative reading of this domain's first key question and explicitly connects the epistemic modesty of Kant's historical claims to the status of Ideas of Reason from the first Critique, providing a bridge to the critical-epistemology question (key question 3). POSITION: Regulative/deflationary reading -- progress is a practical assumption licensed by reason, not a theoretical or empirical thesis.},
    keywords = "regulative-idea, philosophy-of-history, progress, critical-epistemology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{honneth2007irreducibility,
    author = "Honneth, Axel",
    title = "The Irreducibility of Progress: Kant's Account of the Relationship between Morality and History",
    year = "2007",
    volume = "8",
    number = "1",
    note = {CORE ARGUMENT: Distinguishes "system-conforming" from "system-bursting" (unorthodox) versions of Kant's historical progress thesis, arguing that only the system-bursting version -- which treats history as a conflict-ridden, illusion-free learning process rather than a smooth teleological unfolding -- can confer contemporary philosophical meaning on Kant's philosophy of history. RELEVANCE: Offers a normatively engaged (rather than purely exegetical) reading of unsocial sociability's role in Kant's account of historical learning, useful for connecting this domain's mechanism question (unsocial sociability) to broader questions about what, if anything, remains defensible in Kant's progress thesis today. POSITION: Critical/revisionist reading that salvages a "system-bursting" version of Kantian progress against more harmonistic, providential readings.},
    keywords = "progress, unsocial-sociability, critical-theory, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = {In the last thirty years of his life Kant was preoccupied with the question of whether or not the "signs of progress" could be elicited from the vale of tears of the historical process. In what follows I am interested in the question of what kind of meaning Kant's historico-philosophical hypothesis of progress can have for us today. In order to provide an answer to this question, I make a distinction between system-conforming and system-bursting, or unorthodox, versions of historical progress. This distinction is made in order to show that only system-bursting versions of progress can prompt us to confer contemporary meaning on Kant's philosophy of history as a learning process that is conflict ridden and without illusions.},
    abstract_source = "openalex"
}

@article{ypi2010natura,
    author = "Ypi, Lea",
    title = "Natura Daedala Rerum? On the Justification of Historical Progress in Kant's Guarantee of Perpetual Peace",
    journal = "Kantian Review",
    year = "2010",
    number = "2",
    note = {CORE ARGUMENT: Analyses the teleological argument justifying historical progress in the "Guarantee" section of "Toward Perpetual Peace," examining the controversies produced by Kant's claim that nature's teleology supports a providential development of humanity toward moral progress and a cosmopolitan political constitution, and assesses whether this argument can be justified on Kant's own critical terms. RELEVANCE: A central paper for this domain's second and third key questions -- it directly interrogates how nature's "guarantee" is supposed to underwrite both the emergence of states and eventual peace among them, and whether that guarantee is compatible with the moral agency Kant elsewhere insists is required for genuine progress. POSITION: Critically probes the coherence of the providential/guarantee argument, siding with a qualified regulative reading over a robust metaphysical one.},
    keywords = "guarantee-of-peace, teleology, unsocial-sociability, perpetual-peace, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = "This article analyses the teleological argument justifying historical progress in Kant's Guarantee of Perpetual Peace. It starts by examining the controversies produced by Kant's claim that the teleology of nature supports the idea of a providential development of humanity towards moral progress and the possibility of achieving a cosmopolitan political constitution. It further illustrates how Kant's teleological argument in Perpetual Peace needs to be assessed with reference to two systematically relevant issues: first, the problem of coordination linked to the necessity of realizing the ‘highest good’ as a historical end of practical reason, and secondly the problem of continuity posed by the temporal limitation of all individual efforts to cultivate moral dispositions. To illustrate the implications of both issues for the teleological argument in Perpetual Peace , the article draws attention to some important developments in Kant's analysis of teleology following the Critique of Judgment .",
    abstract_source = "openalex"
}

@book{ertl2020guarantee,
    author = "Ertl, Wolfgang",
    title = "The Guarantee of Perpetual Peace",
    year = "2020",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    note = {CORE ARGUMENT: Examines the "first addendum" of Kant's "Toward Perpetual Peace," addressing three questions about Kant's guarantee thesis: how the guarantor powers (nature, providence) interrelate; how there can be a guarantee of peace without undermining human freedom; and why there is a guarantee at all. Argues that Kant's conception of an interplay between human and divine rational agency, encompassing nature, is crucial: we are morally warranted in believing that the world's author intended the supreme (moral) good to accompany the natural order, and perpetual peace is the historical condition that enables the highest good's realization. RELEVANCE: The most sustained recent book-length treatment of nature's "guarantee" of peace and its relation to moral agency and hope -- directly targets this domain's fourth key question about the relation between nature's guarantee and moral agency/hope. POSITION: Robust reading that takes providence and the guarantee to be doing genuine argumentative work compatible with (rather than opposed to) Kantian freedom.},
    keywords = "guarantee-of-peace, providence, perpetual-peace, moral-agency, hope, High, METADATA\_CLEANED: doi",
    abstract = "This Element addresses three questions about Kant's guarantee thesis by examining the 'first addendum' of his Philosophical Sketch: how the guarantor powers interrelate, how there can be a guarantee without undermining freedom and why there is a guarantee in the first place. Kant's conception of an interplay of human and divine rational agency encompassing nature is crucial: on moral grounds, we are warranted to believe the 'world author' knew that if he were to bring about the world, the 'supreme' good would come about too. Perpetual peace is the condition that enables the supreme good to be realized in history.",
    abstract_source = "openalex"
}

@misc{flikschuh2007reason,
    author = "Flikschuh, Katrin",
    editor = "Bird, Graham",
    title = "Reason and Nature: Kant's Teleological Argument in Perpetual Peace",
    year = "2007",
    note = {CORE ARGUMENT: Organized around three questions -- Kant's practical political teleology, the relation between the demands of practical reason and "nature's will," and perpetual peace as the end of right -- the chapter examines how Kant's teleological argument in "Toward Perpetual Peace" is meant to function alongside, rather than substitute for, the demands of practical reason. RELEVANCE: A concise, widely cited overview essay directly addressing this domain's core methodological question of how nature's teleological "guarantee" relates to the practical-reason-based demands of right and morality that otherwise ground Kant's political philosophy. POSITION: Treats Kant's teleological argument as subordinate to and constrained by practical reason, favoring a regulative-practical rather than constitutive-metaphysical reading.},
    keywords = "teleology, perpetual-peace, practical-reason, regulative-idea, High, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc",
    abstract = "This chapter contains sections titled: I. Kant's Practical Political Teleology II. Demands of Practical Reason and Nature's Will III. Perpetual Peace as the End of Right",
    abstract_source = "openalex"
}

@misc{allison2009teleology,
    author = "Allison, Henry E.",
    editor = "Rorty, Am\'{e}lie Oksenberg and Schmidt, James",
    title = "Teleology and History in Kant: The Critical Foundations of Kant's Philosophy of History",
    year = "2009",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Situates the "Idea for a Universal History" within the broader architecture of Kant's critical philosophy, examining how the essay's teleological framework is grounded in -- and constrained by -- the critical epistemology developed elsewhere in Kant's system, rather than treating the historical essay as an ad hoc or pre-critical excursion. RELEVANCE: By a leading Kant scholar, this chapter most directly addresses this domain's third key question (the relationship between historical teleology and critical epistemology), arguing for continuity between the "Idea" essay's teleological method and Kant's broader critical framework. POSITION: Robust/integrative reading that ties the philosophy of history closely to the critical foundations of Kant's system, resisting treatment of the historical essays as merely occasional or popular writings.},
    keywords = "teleology, critical-epistemology, philosophy-of-history, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "Although the title of Kant's essay Idea for Universal History with a Cosmopolitan Aim indicates its central theme, it reveals little or nothing about its underlying methodology and its connection with the emerging critical philosophy. Indeed, as far as the title is concerned, the only hint of a connection with the latter is provided by the inclusion of the term “Idea.” This is a technical term for Kant referring to concepts of reason, which, as distinct from concepts of the understanding, whose legitimate use is restricted to possible experience, involve the thought of an absolute totality or completeness that can never be met with in a possible experience and is, therefore, “transcendent” with respect to the latter. In the first Critique , Kant's appealed to the Platonic republic and a constitution that provides for “the greatest human freedom according to laws that permit the freedom of each to exist together with that of others ” as examples of such ideas (A 316/B 372–3); but his focus was on the “transcendental Ideas” (the soul, the world, and God), which arise from extending certain concepts of the understanding to the “unconditioned,” thereby producing the thought of a complete systematic unity. While illusory, in the sense that no real object corresponds to them, these Ideas nonetheless play an essential regulative role in guiding the understanding in its endemic search for unity in experience.",
    abstract_source = "openalex"
}

@misc{schneewind2009good,
    author = "Schneewind, J. B.",
    editor = "Rorty, Am\'{e}lie Oksenberg and Schmidt, James",
    title = "Good Out of Evil: Kant and the Idea of Unsocial Sociability",
    year = "2009",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Examines how Kant's notion of unsocial sociability is meant to explain the emergence of civil society and cultural development as the unintended by-product of antagonistic, self-interested, and vain human dispositions -- "good out of evil" -- situating this account within the broader tradition of unintended-consequences arguments (e.g., Adam Smith's invisible hand) while asking what is distinctively Kantian about it. RELEVANCE: A focused, book-length-collection treatment of exactly the mechanism named in this domain's second key question -- how unsocial sociability is supposed to justify both the emergence of the state and, by extension, eventual peace among states. POSITION: Explicates unsocial sociability as a naturalistic mechanism operating independently of moral motivation, while asking how much explanatory weight it can bear.},
    keywords = "unsocial-sociability, state-formation, philosophy-of-history, High, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "There is nothing so unsociable and so sociable as man: the one by his vice, the other by his nature. – Montaigne In the first three Propositions of his Idea for a Universal History with a Cosmopolitan Aim ( Idea ), Kant tells us that nature intends all natural human capacities to be developed to their fullest in the species, though not in the individual. Moreover humans are meant to provide, by their own efforts, whatever they enjoy of happiness and perfection (8:18–20). In the Fourth Proposition Kant lays out the means nature employs to bring about this result. It is what he calls the “unsocial sociability” ( ungesellige Geselligkeit ) of men. We have, he says, a “propensity to enter into society.” But we also have a “thoroughgoing resistance” to this tendency so that we are always liable to isolate ourselves and tear society apart (8:20). This seems an unfortunate combination of basic character traits, but Kant does not find it so. On the contrary, he sees in it the goad needed to make us overcome our natural laziness. We do not want to live solitary lives. But we find in ourselves a strong desire to have everything go as we want it to. We know we would resist this desire coming from others, so we expect the others with whom we want to live to resist our desire. The resistance stirs us to try to overcome it.",
    abstract_source = "openalex"
}

@misc{ferguson2015unsocial,
    author = "Ferguson, Michaele",
    editor = "Ellis, Elisabeth",
    title = "Unsocial Sociability: Perpetual Antagonism in Kant's Political Thought",
    year = "2015",
    note = "CORE ARGUMENT: Argues that unsocial sociability names a condition of perpetual antagonism that persists throughout Kant's political thought rather than being merely a developmental mechanism that is superseded once civil and cosmopolitan institutions are established -- antagonism remains a permanent structural feature of Kantian politics, not simply a spur that progress eventually leaves behind. RELEVANCE: Directly engages this domain's second key question by examining whether unsocial sociability's work is confined to explaining state formation or whether it continues to operate (and needs to be managed) even within and among established republican states striving for peace. POSITION: Reads unsocial sociability as a persistent structural feature of Kantian politics rather than a mechanism that is fully overcome by institutional progress.",
    keywords = "unsocial-sociability, state-formation, perpetual-peace, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@misc{goldman2010antinomy,
    author = "Goldman, Avery",
    title = "An Antinomy of Political Judgment: Kant, Arendt, and the Role of Purposiveness in Reflective Judgment",
    year = "2010",
    number = "3",
    note = "CORE ARGUMENT: Examines the role of purposiveness in Kant's account of reflective judgment from the third Critique and its bearing on political judgment, engaging with Hannah Arendt's influential appropriation of Kant's aesthetic and teleological judgment for a theory of political judgment. RELEVANCE: Directly addresses this domain's third key question by tracing how the reflective, non-determining judgment central to the third Critique's account of purposiveness might ground -- or generate an antinomy within -- properly political forms of judgment, including judgments about historical progress. POSITION: Identifies a structural antinomy in extending third-Critique purposiveness to political judgment, engaging critically with the Arendtian reception of Kant.",
    keywords = "reflective-judgment, purposiveness, third-critique, political-judgment, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@book{ostaric2023critique,
    author = "Ostaric, Lara",
    title = "The Critique of Judgment and the Unity of Kant's Critical System",
    year = "2023",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Argues that Kant's Critique of Judgment is properly understood as completing his critical system: both aesthetic and teleological judgment indirectly exhibit the final end of reason -- the Ideas of the highest good and the postulates -- as if obtaining in nature. Relates this unifying reading to under-explored connections between Kant's aesthetics/teleology and his philosophy of history, philosophy of religion, and conception of autonomy. RELEVANCE: The most comprehensive recent monograph connecting the third Critique's reflective judgment directly to Kant's philosophy of history (including a dedicated chapter, per subsequent author-response literature, titled "Kant's Teleological Philosophy of History"), making it central to this domain's third key question. POSITION: Strongly integrative reading treating teleological judgment about history as continuous with -- rather than a departure from -- the systematic architecture unifying Kant's three Critiques.},
    keywords = "third-critique, teleology, reflective-judgment, critical-epistemology, philosophy-of-history, High, METADATA\_CLEANED: doi",
    abstract = "In this book, Lara Ostaric argues that Kant's seminal Critique of Judgment is properly understood as completing his Critical system. The two seemingly disparate halves of the text are unified under this larger project insofar as both aesthetic and teleological judgment indirectly exhibit the final end of reason, the Ideas of the highest good and the postulates, as if obtaining in nature. She relates Kant's discussion of aesthetic and teleological judgment to important yet under-explored concepts in his philosophy, and helps the reader to recognize the relevance of his aesthetics and teleology for our understanding of fine arts and genius, the possibility of pure judgments of ugliness, Kant's philosophy of history, his philosophy of religion, and his conception of autonomy. Ostaric's novel and thoroughly integrative presentation of Kant's system will be of interest not only to Kant scholars but also to those working in religious studies, art history, political theory, and intellectual history.",
    abstract_source = "s2"
}

@misc{formosa2014politics,
    editor = "Formosa, Paul and Goldman, Avery and Patrone, Tatiana",
    title = "Politics and Teleology in Kant",
    year = "2014",
    address = "Cardiff",
    note = "CORE ARGUMENT: Edited collection of essays examining the intersection of Kant's political philosophy and his account of teleology, bringing together scholars working on the third Critique, the philosophy of history, and Kant's theory of right to ask how teleological judgment informs and constrains Kantian political theorizing. RELEVANCE: A dedicated multi-author volume on precisely the intersection targeted by this domain (politics and teleology), useful to a synthesis writer as a single reference point for the range of positions on how teleological judgment bears on Kant's political thought. POSITION: Edited collection spanning multiple positions rather than advancing a single thesis.",
    keywords = "teleology, political-philosophy, third-critique, edited-volume, Medium, METADATA\_CLEANED: publisher, type:@book->@misc",
    abstract = "The fourteen essays in this volume, by leading scholars in the field, explore the relationship between teleology and politics in Kant’s corpus. Among the topics discussed are Kant’s normative political theory and legal philosophy; his cosmopolitanism and views on international relations; his theory of history; his theory of natural teleology; and the broader relationship between morality, history, nature, and politics. Politics and Teleology in Kant will be of interest to a wide audience, including Kant scholars; scholars and students working in moral and political philosophy, the philosophy of history, and political theory and political science; legal scholars; and international relations theorists.",
    abstract_source = "core"
}

@misc{zuckert2021loneliness,
    author = "Zuckert, Rachel",
    editor = "Wilford, Paul T. and Stoner, Samuel A.",
    title = "Loneliness and Ambiguity in Kant's Philosophy of History",
    year = "2021",
    note = {CORE ARGUMENT: Kant's most famous accounts of historical progress, driven by unsocial sociability, aim to address a Rousseauean concern about the evils brought about by "civilization." Kant sketches how the very impediments to sociability might bring about morally desirable ends over the course of history and later be redirected in less problematic ways (e.g., as trade competition). But Zuckert argues this account generates a new problem for the morally committed individual: loneliness -- since on Kant's account, history is driven by unsocial sociability, not by moral agency, the virtuous agent is structurally isolated from the very historical process that is supposed to vindicate her hopes. RELEVANCE: Directly addresses this domain's fourth key question by showing a tension between nature's guarantee (mediated through unsocial sociability) and individual moral agency -- the mechanism that supposedly justifies hope in progress does not operate through, and may even estrange, the moral agent's own virtuous action. POSITION: Critical reading that identifies an underappreciated psychological and moral cost (loneliness) in Kant's naturalistic account of historical progress.},
    keywords = "unsocial-sociability, moral-agency, hope, philosophy-of-history, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, publisher, doi, type:@incollection->@misc"
}

@article{cureton2018reasonable,
    author = "Cureton, Adam",
    title = "Reasonable Hope in Kant's Ethics",
    journal = "Kantian Review",
    year = "2018",
    volume = "23",
    number = "2",
    note = {CORE ARGUMENT: The most apparent obstacles to a just, enlightened, and peaceful social world are also, on Kant's view, nature's way of compelling us to realize those very ends: selfishness, rivalry, vanity, and self-conceit, along with the social inequalities they produce, drive human beings to perfect their talents, develop culture, approach enlightenment, and -- through the strife caused by unsocial sociability -- move toward justice, political equality, and the highest good. Cureton asks what to make of arguments that rely on such empirical assumptions and dubious claims about natural teleology while sitting uncomfortably with core commitments of Kant's ethics, and argues that they reveal an important insight about what a virtuous person may reasonably hope for. RELEVANCE: Reframes this domain's fourth key question (nature's guarantee and moral agency/hope) as a question in moral psychology: what can a Kantian agent, committed to virtue but reliant on nature's teleological "guarantee," coherently and reasonably hope for? POSITION: Reconstructive reading that salvages the moral-psychological core of Kant's hope-in-progress argument while acknowledging the dubiousness of its empirical and teleological premises.},
    keywords = "hope, unsocial-sociability, moral-agency, highest-good, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract The most apparent obstacles to a just, enlightened and peaceful social world are also, according to Kant, nature’s way of compelling us to realize those and other morally good ends. Echoing Adam Smith’s idea of the ‘invisible hand’, Kant thinks that selfishness, rivalry, quarrelsomeness, vanity, jealousy and self-conceit, along with the oppressive social inequalities they tend to produce, drive us to perfect our talents, develop culture, approach enlightenment and, through the strife and instability caused by our unsocial sociability, push us towards justice, political equality and the highest good. What are we to make of these arguments, which seem to rely on questionable empirical assumptions, invoke dubious claims about natural teleology and sit uncomfortably with fundamental aspects of Kant’s ethical framework? I suggest that the arguments reveal one of Kant’s deep and important insights about the moral life by partially describing what a good and virtuous person reasonably hopes for.",
    abstract_source = "openalex"
}

@misc{papish2024kants,
    author = "Papish, Laura",
    title = "Kant's Revised Account of Hope in Human Progress",
    year = "2024",
    number = "4",
    note = {CORE ARGUMENT: Kant remained committed throughout his life to the idea that we can justifiably hope humankind is progressing, but there are important changes in how he conceptualized this hope. Maps two underappreciated shifts in Kant's thinking between his final statement on the topic, the 1797 essay "An Old Question Raised Again," and his earlier accounts of hope in progress in the "Common Saying" essay and "Toward Perpetual Peace," and argues that the later account remedies problems present in the pre-1797 discussions. RELEVANCE: Shows that Kant's own position on the guarantee/hope relationship (this domain's fourth key question) was not static but developed, complicating any synthesis that treats "Kant's view" of historical hope as a single fixed doctrine across his career. POSITION: Developmental reading emphasizing a late revision in Kant's account of rational hope for progress.},
    keywords = "hope, progress, moral-agency, development-of-kants-thought, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = "Kant remained throughout his life committed to the idea that we can justifiably hope humankind is progressing. But there are important changes in how he conceptualized this hope. This paper maps out two underappreciated shifts in Kant's thinking between his final word on the subject, in his 1797 An Old Question Raised Again, and his accounts of hope in progress in earlier texts, including the Common Saying essay and Toward Perpetual Peace. The paper also shows that this new account remedies some problems with his pre-1797 discussions.",
    abstract_source = "s2"
}

@book{lenczewska2025kant,
    author = "Lenczewska, Olga",
    title = "Kant on the History and Development of Practical Reason",
    year = "2025",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Focuses on Kant's history of human reason -- his teleological vision of the past development of human rational capacities from their very emergence to Kant's own "age of Enlightenment." Connects Kant's speculative account of the very beginning of rationality, largely neglected in the scholarship, to his well-known theory of humankind's future progress, and argues that "Conjectural Beginning of Human History" is not tangential to Kant's critical philosophy but illuminates and complements it. RELEVANCE: The most sustained recent treatment specifically of "Conjectural Beginning of Human History," directly filling out this domain's focus on that text and connecting it to the "Idea for a Universal History" essay's forward-looking teleology. POSITION: Integrative reading arguing for continuity between Kant's speculative account of reason's origins and his critical philosophy, rather than treating "Conjectural Beginning" as a minor or merely literary exercise.},
    keywords = "conjectural-history, practical-reason, teleology, origins-of-reason, High, INCOMPLETE, no-abstract"
}

@misc{huseyinzadegan2019kants,
    author = "Huseyinzadegan, Dilek",
    title = "Kant's Nonideal Theory of Politics",
    year = "2019",
    address = "Evanston, IL",
    note = {CORE ARGUMENT: Argues that Kant's political theory is not solely an ideal theory of right [Recht] that deduces political goals a priori, but simultaneously a "nonideal theory" concerned with the contingent variables of politics -- politically salient features of history, culture, and geography. This nonideal layer, rooted in the philosophy of nature and history, mobilizes the hypothetical use of reason guided by the regulative, teleological principle of purposiveness [Zweckm\"{a}ssigkeit], rather than the deductive universal claims characteristic of Kant's ideal moral philosophy. RELEVANCE: Directly connects this domain's methodological question (regulative vs. constitutive status of historical teleology) to the broader structure of Kant's political theory, arguing that the "Idea for a Universal History," "Conjectural Beginning," and "Perpetual Peace" together constitute a distinct, regulative-teleological "nonideal" layer of Kantian politics. POSITION: Regulative reading that reframes the entire philosophy-of-history corpus as a coherent "nonideal theory" operating via hypothetical/regulative rather than constitutive reason.},
    keywords = "regulative-idea, teleology, nonideal-theory, purposiveness, third-critique, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "In the past few decades, important scholarship has criticized the common caricature of Kant as an overly abstract philosopher interested only in idealized a priori claims. Against this received image, scholars have pointed to the hundreds of pages that Kant devoted to the empirical world in all its non-ideal imperfection, arguing that these, too, are philosophically insightful texts worth taking seriously. This scholarship has mostly focused on Kant’s anthropology, but it has also explored his writings on education, religion, art, and history. Kant’s Nonideal Theory of Politics extends this general approach into Kant’s political theory, which Huseyinzadegan shows is not just a theory of right [Recht] that aims to deduce political goals a priori, but is at the same time a ‘nonideal theory’ concerned with ‘the contingent variables of politics’ (4). After the ‘first part’ of Kant’s politics, an ideal theory telling us what its ultimate normative goals should be, there is a ‘second part’ (4), which addresses ‘politically salient features of history, culture, and geography’ (13). Kant’s Nonideal Theory of Politics is an exploration of this under-appreciated and generally under-theorised layer of Kant’s political theory. It is essential that these two ‘guiding threads’ not be confused, as Huseyinzadegan thinks they often are. In fact, they constitute ‘two types of theoretical endeavor’ (3), having different aims and methods, and which operate according to distinct logics. Where the well-known ideal theory of Recht makes the kind of deductive universal claims familiar to readers of Kant’s moral philosophy, its nonideal part, which has its roots in the philosophy of nature and the philosophy of history, mobilizes instead the hypothetical use of reason guided by the principle of purposiveness [Zweckmässigkeit]. This aspect of Kant’s politics is not about justifying normative claims supposed to hold for any time or place, but instead concerns those domains where strict a priority cannot be reached. Kant famously understands history, nature, and culture in progressive and developmental terms, but this means that he needs a conceptual apparatus which does not abstract away from space and time if he is to have anything concrete to say about them. The model for this regulative, teleological form of theorizing comes primarily from his third Critique.",
    abstract_source = "s2"
}

@misc{zhang2017unethical,
    author = "Zhang, Jenna",
    title = "Unethical Laws and Lawless Ethics: Right and Virtue in Kant's Rechtslehre",
    year = "2017",
    number = "2",
    abstract = "In this paper, I examine the relation between law and morality within the context of Kant's late work The Metaphysics of Morals. I argue that Kant's conception of the law is based on a fundamental distinction between Right and Virtue, which respectively correspond to his legal-political theory and moral philosophy. My analysis is two part: in the first part, I examine the relationship between the Doctrines of Right and Virtue within the Kantian architectonic; in the second, I evaluate two cases of adjudication in the Rechtslehre that exemplify the distinction between law and morality explicated in the preceding section. I begin by showing that Kant's legal and moral philosophies are normatively distinct, insofar as Right and Virtue belong to incommensurable realms of freedom and necessity. From this distinction, I derive Kant's conception of the legal state as principally concerned with external freedoms and the preservation of the lawful condition itself. The second part of this paper analyzes Kant's views on two cases of criminal justice, revealing his prioritization of the political over independent ethical considerations in juridical decision-making. Here, the conceptual barrier between law and morality serves as a caveat against facile recourses to Kantian ethics as means of legitimizing juridico-political decisions.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: Argues that Right and Virtue belong to "incommensurable realms of freedom and necessity" within the Kantian architectonic, so that the legal state is principally concerned with external freedom and the preservation of the lawful condition as such, independently of ethical considerations; illustrates this through two cases of Kantian criminal adjudication that show law's priority over independent ethical reasoning in juridical decision-making. RELEVANCE: Provides a textually grounded, case-based argument for treating Right as normatively distinct from Virtue, directly bearing on this domain's question of whether political obligation reduces to a moral duty derived from the Categorical Imperative — Zhang's answer is a qualified no. POSITION: Independence-leaning; treats Right and Virtue as belonging to distinct normative realms, though the paper's warning against "facile recourse to Kantian ethics" to legitimate legal decisions is narrower than Willaschek's architectonic claim.},
    keywords = "right-virtue-relation, independence-thesis, coercion, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@article{guyer2016twofold,
    author = "Guyer, Paul",
    title = "The Twofold Morality of Recht: Once More Unto the Breach",
    journal = "Kant-Studien",
    year = "2016",
    number = "1",
    sep_context = {Cited alongside "Guyer 2000" in SEP's "Kant's Moral Philosophy" (kant-moral), section 10 "Autonomy": Guyer's interpretive strategy is glossed as seeing "an argument for freedom as an end in itself," in contrast to the humanity-based strategies of Korsgaard (1996) and Wood (1999).},
    note = {CORE ARGUMENT: A direct response, signaled by the title's dueling metaphor, to Willaschek's and related independence-thesis arguments that the Doctrine of Right cannot be derived from Kant's moral theory; reasserts (in line with Guyer's broader freedom-centered reading of Kant, cf. Guyer 2000 below) that juridical duties of Right retain a moral character grounded in the value of freedom, against readings that sever Right from the Categorical Imperative. RELEVANCE: Supplies the derivation-side rejoinder to the independence-thesis papers collected in domain 1 (especially Willaschek 2009 and Seel 2009), giving this domain's key debate its most direct dependence-side proponent alongside Guyer's monograph. POSITION: Dependence/derivation view — Right retains a "twofold morality," grounded ultimately in the same freedom-based value that grounds ethics.},
    keywords = "independence-thesis, derivation-thesis, Guyer, autonomy, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, doi"
}

@misc{willaschek2017why,
    author = "Willaschek, Marcus",
    title = "Why the Doctrine of Right does not belong in the Metaphysics of Morals",
    publisher = "Routledge",
    year = "2017",
    note = {CORE ARGUMENT: Argues that Kant's system of duties in the Metaphysics of Morals is neither consistent nor complete, because duties of Right and duties of Virtue, contrary to Kant's own official architectonic claim, do not jointly exhaust the domain of moral duty; shows that Kant combines two incompatible views — an "official" view on which Right is part of morality (implying that the authorization to coerce could be morally justified) and an underlying practice on which no such moral justification of coercion is actually available, rendering the "official" view inadequate. RELEVANCE: Extends the independence thesis beyond the 2009 "Right and Coercion" article (domain 1) into a stronger architectonic claim about where the Doctrine of Right belongs within Kant's system, sharpening the stakes of the debate for how the entire Metaphysics of Morals should be read. POSITION: Independence thesis, strong version — the Doctrine of Right does not merely stand apart from ethics but is architectonically misplaced within the Metaphysics of Morals as Kant conceived it.},
    keywords = "independence-thesis, Willaschek, architectonic, coercion, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{kleingeld2018moral,
    author = "Kleingeld, Pauline",
    title = "Moral Autonomy as Political Analogy: Self-Legislation in Kant's 'Groundwork' and the 'Feyerabend Lectures on Natural Law'",
    publisher = "Cambridge University Press",
    year = "2018",
    note = {CORE ARGUMENT: Argues that the political theory Kant defended while writing the Groundwork illuminates the well-known difficulties in his account of moral autonomy; shows that Kant's two-tiered structure of political legislation in the Feyerabend Lectures on Natural Law parallels his distinction between two levels of moral legislation, explaining why Kant could regard "autonomy" as an apt expression of the principle of morality in the mid-1780s. RELEVANCE: Reverses the usual direction of derivation debates (which ask whether Right derives from ethics) by showing that Kant's early political theory of legislation is the model on which his moral concept of autonomy was analogically built, directly bearing on how autonomy and external freedom relate historically and conceptually. POSITION: Historical/genetic; neither straightforwardly independence nor derivation, but argues political self-legislation is the conceptual template for moral self-legislation.},
    keywords = "autonomy, self-legislation, political-analogy, Kleingeld, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{kleingeldwillaschek2019autonomy,
    author = "Kleingeld, Pauline and Willaschek, Marcus",
    title = "Autonomy Without Paradox: Kant, Self-Legislation and the Moral Law",
    year = "2019",
    volume = "19",
    note = {CORE ARGUMENT: Addresses the "paradox of autonomy" — the worry that if the moral law is self-legislated, agents seem free to legislate any law whatever, undermining the law's necessity and universality — by arguing that Kant's conception of self-legislation as legislation of and for all rational beings as such dissolves the apparent paradox without requiring the moral law to be given independently of the will. RELEVANCE: Directly addresses one of this domain's key questions (how autonomy as self-legislation relates to freedom and lawful necessity) and thereby indirectly supports derivation-friendly readings of Right, since if self-legislation is not paradoxical, there is less pressure to treat Right's Universal Principle as needing a separate, non-autonomous foundation. POSITION: Defends the coherence of the standard self-legislation conception of autonomy against a leading objection, without directly adjudicating the independence-thesis debate.},
    keywords = "autonomy, self-legislation, paradox, Kleingeld, Willaschek, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{edwards2017autonomy,
    author = "Edwards, Jeffrey",
    title = "Autonomy, Moral Worth, and Right: Kant on Obligatory Ends, Respect for Law, and Original Acquisition",
    year = "2017",
    note = {CORE ARGUMENT: Examines the ramifications of Kant's late account of practical reason's obligatory ends together with what the book characterizes as a "revolutionary implication" of Kant's theory of original property acquisition, connecting the ethical concepts of autonomy, moral worth, and respect for law to the juridical doctrine of Right via the shared problem of obligatory ends. RELEVANCE: Offers a book-length attempt to trace continuity between Kant's ethical vocabulary (autonomy, moral worth, respect for law) and the Doctrine of Right's account of acquisition, providing material for assessing whether foundational ethical concepts do real explanatory work within Right or merely share terminology with it. POSITION: Broadly derivation-friendly in orientation, tracing conceptual continuity between ethical and juridical vocabulary, though developed through original acquisition rather than through the independence-thesis debate directly.},
    keywords = "autonomy, right, property, obligatory-ends, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{faggion2018remarks,
    author = "Faggion, Andrea",
    title = "Remarks on Kant's Argument for Political Authority",
    year = "2018",
    note = "CORE ARGUMENT: A short critical engagement with Kant's argument that rational agents are obligated to submit to, or establish, political authority as a condition of realizing their innate right to freedom (the standard reading, per Ebels-Duggan's SEP-adjacent formulation, being that since we can secure everyone's right to freedom only within a state, we are obligated to enter or support one). RELEVANCE: Directly engages this domain's question of whether political obligation is itself a moral duty, complementing the author's other contribution (Faggion 2015, domain 1) on the innate right, by turning from the content of that right to the argument for why it obligates entry into a civil condition. POSITION: Critical engagement with the standard argument for political authority; does not straightforwardly defend either an independence or a derivation reading.",
    keywords = "political-obligation, political-authority, Faggion, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@article{besch2008constructing,
    author = "Besch, Thomas M.",
    title = "Constructing Practical Reason: O'Neill on the Grounds of Kantian Constructivism",
    journal = "The Journal of Value Inquiry",
    year = "2008",
    number = "1",
    note = {CORE ARGUMENT: Addresses O'Neill's view that her version of the Categorical Imperative — the requirement of "followability" (RF) — marks the supreme principle of practical reason, and takes issue with her claim that RF commits us to Kantian constructivism; probes whether O'Neill's constructivist grounding strategy for practical reason actually secures the authority she claims for it. RELEVANCE: A sustained critical engagement with the constructivist alternative (O'Neill 1990, 2015, both in this domain) to independence/derivation framings of the ethics-Right relation, testing whether "followability" can do the foundational work O'Neill assigns it across both ethical and political domains. POSITION: Critical of O'Neill's constructivism; questions whether her followability requirement grounds, rather than merely expresses, Kantian practical reason.},
    keywords = "constructivism, O'Neill, followability, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, pages, doi"
}

@book{oneill2015constructing,
    author = "O'Neill, Onora",
    title = "Constructing Authorities: Reason, Politics and Interpretation in Kant's Philosophy",
    publisher = "Cambridge University Press",
    year = "2015",
    note = "CORE ARGUMENT: Challenges the claim that Kant's critique of reason collapses into a dogmatic argument from authority by showing that Kant held the authority of reason must be constructed, not assumed, and that this is achieved by ensuring that anything offered as a reason can in principle be followed by others, including those who disagree; argues this constructivist view of reasoning is the key to Kant's claims about knowledge, ethics, and politics alike, including his accounts of autonomy, the social contract, and cosmopolitan justice. RELEVANCE: The clearest statement of the view that ethics and politics in Kant share a single constructivist method rather than standing in a derivation or independence relation, making it central to this domain's question of whether Kant's political philosophy is a distinct branch of practical philosophy or an application of a single, unified method of reasoning. POSITION: Constructivist — treats the authority of reason across ethics, politics, knowledge, and interpretation as uniformly constructed via the followability requirement, cutting across the independence/derivation dichotomy.",
    keywords = "constructivism, politics, O'Neill, authority, followability, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@book{oneill1990constructions,
    author = "O'Neill, Onora",
    title = "Constructions of Reason: Explorations of Kant's Practical Philosophy",
    publisher = "Cambridge University Press",
    year = "1990",
    note = {CORE ARGUMENT: Reconsiders Kant's conceptions of philosophical method, reason, freedom, autonomy, and action before turning to interpretation of the Categorical Imperative, and closes by emphasizing differences between Kant's ethics and later "Kantian" ethics, including the work of Rawls and other contemporary liberal political philosophers. RELEVANCE: The foundational statement of O'Neill's constructivist reading of Kant's practical philosophy, providing the methodological baseline against which her later Constructing Authorities (2015) and critical responses (Besch 2008, Watkins and Fitzpatrick 2002) should be read; its closing contrast with Rawlsian "Kantian" liberalism is directly relevant to how far Kant's own political philosophy tracks contemporary Kantian-liberal political theory. POSITION: Foundational constructivist reading; treats autonomy, freedom, and the Categorical Imperative as products of a shared constructive method rather than as ethical premises from which Right is derived.},
    keywords = "constructivism, autonomy, freedom, O'Neill, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@book{guyer2000kant,
    author = "Guyer, Paul",
    title = "Kant on Freedom, Law, and Happiness",
    publisher = "Cambridge University Press",
    year = "2000",
    sep_context = {Cited in SEP's "Kant's Moral Philosophy" (kant-moral), section 10 "Autonomy": glossed as offering "an argument for freedom as an end in itself," contrasted with the humanity-based strategies "favored by Korsgaard (1996) and Wood (1999)" for grounding the Categorical Imperative.},
    note = {CORE ARGUMENT: Radically revises the traditional interpretation of Kant's moral and political philosophy around the value of freedom rather than the value of humanity or rational nature as such, arguing that Kant's mature position amounts to a coherent liberalism capable of guiding contemporary moral and political debates. RELEVANCE: The principal monograph statement of the freedom-centered ("Guyer") position in the debate over how to ground the Categorical Imperative (cf. Guyer 2016 above), providing the systematic backing for Guyer's contributions to the independence-thesis literature and situating that debate within a broader interpretation of Kant's ethics and politics as a unified liberal philosophy of freedom. POSITION: Freedom-as-end-in-itself grounding of the Categorical Imperative; treats Kant's moral and political philosophy as expressions of a single coherent liberalism, favoring a derivation-friendly reading of Right's relation to ethics.},
    keywords = "autonomy, freedom, liberalism, Guyer, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@misc{wood1999kants,
    author = "Wood, Allen W.",
    title = "Kant's Ethical Thought",
    year = "1999",
    sep_context = {Cited repeatedly in SEP's "Kant's Moral Philosophy" (kant-moral): in section 10 "Autonomy," Wood (1999) is grouped with Korsgaard (1996) as favoring the strategy of grounding the Categorical Imperative in the argument that humanity is an end in itself, "by contrast" with Guyer's freedom-based strategy; in section 15 "Metaethics," Wood (1999) is cited (with Ameriks 2003, Langton 2007, Kain 2004) as interpreting Kant as "a robust moral realist" on which rational nature has objective, agent-neutral, intrinsic value; in section 9, Wood (1999, 2007) is cited as doubting whether the Humanity Formula alone can capture all the duties Kant claims to derive from it.},
    note = "CORE ARGUMENT: Develops a systematic interpretation of Kant's ethics centered on the value of humanity/rational nature as an objective end in itself, reading Kant as a moral realist for whom the Categorical Imperative specifies how agents with this special status must be treated, in contrast to freedom-centered (Guyer) or purely proceduralist readings. RELEVANCE: One of the two principal monograph interpretations (with Guyer 2000) against which SEP situates the independence-thesis and autonomy debates; its humanity-based, realist grounding of the Categorical Imperative offers a distinct basis from which to ask whether the Universal Principle of Right can or cannot be derived. POSITION: Humanity-based moral realism; grounds the Categorical Imperative in the objective value of rational nature, aligning with derivation-friendly readings insofar as Right, too, concerns the treatment owed to rational agents as ends in themselves. No publisher metadata available from any queried API (S2, CrossRef, CORE); included with minimal fields per the no-fabrication rule.",
    keywords = "autonomy, humanity, moral-realism, Wood, High, no-publisher-found, INCOMPLETE, no-abstract"
}

@article{horn2016kants,
    author = "Horn, Christoph",
    title = "Kant's Political Philosophy as a Theory of Non-Ideal Normativity",
    journal = "Kant-Studien",
    year = "2016",
    number = "1",
    note = {CORE ARGUMENT: Proposes reading Kant's political philosophy as a distinct theory of "non-ideal normativity," addressed to the conditions of actual, imperfect political life (coercion, the state of nature, existing institutions) rather than as a direct extension of the ideal, unconditional normativity of the moral law; published in the same Kant-Studien issue as Guyer's "Twofold Morality of Recht," making the two papers direct interlocutors in the same debate. RELEVANCE: Offers a third way of framing this domain's central question — neither straightforward derivation nor strict independence, but a difference in normative register (ideal vs. non-ideal) between ethics and politics — that reframes what is at stake in reading Right as continuous or discontinuous with the Categorical Imperative. POSITION: Neither independence nor derivation in the usual sense; argues Kant's political philosophy constitutes a non-ideal normative theory distinct in kind, though not necessarily in ultimate source, from his ideal ethics.},
    keywords = "political-philosophy, non-ideal-theory, Horn, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, doi"
}

@misc{tarasenkostruc2019kantian,
    author = "Tarasenko-Struc, Aleksy",
    title = "Kantian constructivism and the authority of others",
    year = "2019",
    volume = "28",
    number = "1",
    note = "CORE ARGUMENT: Argues that Christine Korsgaard's Kantian constructivism cannot accommodate genuine obligations to others: because Korsgaard holds that all obligation is grounded in an agent's obligating herself, she is committed to the view that obligations to others are ultimately grounded in corresponding obligations to oneself, which the paper argues rests on an objectionably egocentric conception of authority on which others possess authority over us only because we grant it to them. RELEVANCE: Directly bears on this domain's question of whether political obligation is a moral duty on Kantian-constructivist grounds, since a constructivism that cannot secure genuine other-regarding obligation faces particular difficulty explaining obligations to fellow citizens or to the state; complements the domain's other engagements with O'Neill's constructivism (Besch 2008, Watkins and Fitzpatrick 2002) by targeting Korsgaard's version specifically. POSITION: Critical of Korsgaardian constructivism; argues its self-legislation model yields an egocentric account of authority ill-suited to grounding obligations, including political ones, to others.",
    keywords = "constructivism, Korsgaard, authority, obligation, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{schadow2013recht,
    author = "Schadow, Steffi",
    title = "Recht und Ethik in Kants Metaphysik der Sitten (MS 6:218–221 und TL 6:390 f.)",
    year = "2013",
    pages = "85--112",
    note = "CORE ARGUMENT: A close commentary on two specific passages of the Metaphysics of Morals (the general introduction at 6:218–221 and the transition passage at TL 6:390f.) in which Kant himself characterizes the relation between Recht (Right) and Ethik (Ethics/Virtue), examining how Kant's own architectonic remarks bear on the systematic unity of the two doctrines. RELEVANCE: A textually focused German-language companion to the English-language independence-thesis debate (Willaschek, Guyer, Zhang, in this domain and domain 1), grounding the abstract dispute over derivation versus independence in Kant's own explicit statements about the Recht/Ethik distinction at the specific loci scholars most often cite. POSITION: Exegetical; clarifies rather than adjudicates the derivation/independence dispute by close reading of Kant's own architectonic self-description.",
    keywords = "right-virtue-relation, architectonic, textual-commentary, German-scholarship, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc"
}

@misc{whelan2021realizing,
    author = "Whelan, Robert Patrick",
    title = "Realizing Freedom as Non-domination: Political Obligation in Kant's Doctrine of Right",
    year = "2021",
    volume = "28",
    number = "1",
    note = {CORE ARGUMENT: Develops an account of Kantian political obligation building on the non-domination reading of the innate right to freedom (the Ripstein-influenced view that freedom means being "one's own master," independent from domination by others), arguing that political obligation should be understood as required for realizing, rather than merely constraining, this freedom as non-domination. RELEVANCE: Directly addresses this domain's key question of whether political obligation is a moral duty by working through the non-domination framework (shared with Ripstein 2009 and the independence-thesis literature in domain 1) rather than through direct appeal to the Categorical Imperative, showing how a broadly independence-friendly reading of Right can still generate a robust account of political obligation. POSITION: Independence-friendly, non-domination account of political obligation, developed as an extension of the Ripsteinian formalist tradition rather than of the derivation view.},
    keywords = "political-obligation, non-domination, Ripstein, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@article{watkinsfitzpatrick2002oneill,
    author = "Watkins, Eric and Fitzpatrick, William",
    title = "O'Neill and Korsgaard on the Construction of Normativity",
    journal = "The Journal of Value Inquiry",
    year = "2002",
    volume = "36",
    number = "2-3",
    note = "CORE ARGUMENT: A comparative critical examination of O'Neill's and Korsgaard's constructivist accounts of how practical normativity is generated within a broadly Kantian framework, assessing whether either author's constructivist strategy succeeds in explaining the authority of moral (and, on O'Neill's extension, political) requirements without covertly presupposing the very normativity it aims to construct. RELEVANCE: Provides a comparative frame for the two constructivist figures most relevant to this domain (O'Neill's Constructions of Reason and Constructing Authorities, above; Korsgaard's self-legislation model, criticized by Tarasenko-Struc, above), helping to distinguish what is shared versus distinctive in their respective extensions of Kantian constructivism from ethics toward politics. POSITION: Critical assessment of both O'Neill's and Korsgaard's constructivist projects; does not itself defend either author's grounding strategy.",
    keywords = "constructivism, O'Neill, Korsgaard, normativity, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages, doi"
}

@misc{beinerbooth1993kant,
    editor = "Beiner, Ronald and Booth, William James",
    title = "Kant and Political Philosophy: The Contemporary Legacy",
    year = "1993",
    address = "New Haven",
    note = {CORE ARGUMENT: An edited collection that helped establish Kant's political writings as a subject of sustained study in Anglophone political theory in their own right, rather than as a mere appendix to the Critical philosophy; the volume's essays collectively stake out the range of interpretive positions — liberal-republican, communitarian-critical, and skeptical — that structure subsequent reception debates. RELEVANCE: Functions as the reception-historical anchor for this domain's first controversy (liberal vs. authoritarian readings), since its contributors first framed the question of what a coherent "contemporary legacy" of Kant's politics would look like, a framing later works (Riley, Franceschet, Hutchings) explicitly build on or react against. POSITION: Pluralistic; does not defend a single reading but collects essays spanning the liberal-republican and more skeptical/critical positions on Kant's political legacy.},
    keywords = "reception, liberal-republican-reading, Beiner, Booth, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{riley1983kants,
    author = "Riley, Patrick",
    title = "Kant's Political Philosophy",
    year = "1983",
    address = "Totowa, N.J.",
    note = "CORE ARGUMENT: One of the first book-length Anglophone studies to argue that Kant's political philosophy, centered on the social contract and the innate right to freedom, forms a systematic and internally coherent theory rather than a set of occasional remarks subordinate to the ethics; situates Kant within, and as a critical departure from, the natural-law and social-contract tradition running through Hobbes, Locke, and Rousseau. RELEVANCE: Represents the founding text of the liberal-republican recovery of Kant's politics that this domain's reception debate takes as its starting point, and against which subsequent readings emphasizing authoritarian or anti-resistance elements (covered in domain 4) are implicitly positioned. POSITION: Liberal-republican; treats Kant's political philosophy as a systematic contribution to, and advance upon, the social-contract tradition.",
    keywords = "reception, liberal-republican-reading, social-contract, Riley, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{franceschet2002kant,
    author = "Franceschet, Antonio",
    title = "Kant and Liberal Internationalism: Sovereignty, Justice and Global Reform",
    year = "2002",
    doi = "10.1007/978-1-137-07853-7",
    note = {CORE ARGUMENT: Argues that close examination of Kant's political writings reveals him to be simultaneously "a conservative partisan of the international status quo of sovereign states" and the inspiration for radical, global reform of democracy and universal rights, and traces how this tension has structured the evolution of liberal internationalism from Kant's own era to post-Cold War policy debates. RELEVANCE: Directly names and analyzes the ambivalence at the heart of this domain's liberal/authoritarian reception debate, showing that the tension is not merely a matter of rival interpretations imposed from outside but is arguably present within Kant's own texts on sovereignty and international right. POSITION: Diagnoses rather than resolves the liberal/conservative tension, treating Kant's legacy as constitutively double-sided.},
    keywords = "reception, liberal-internationalism, sovereignty, cosmopolitanism, Franceschet, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{hutchings1996kant,
    author = "Hutchings, Kimberly",
    title = "Kant, Critique and Politics",
    year = "1996",
    publisher = "Routledge",
    address = "London",
    note = {CORE ARGUMENT: Reevaluates the significance of Kant's critical method for contemporary political theory by tracing its afterlife in the work of Habermas, Arendt, Lyotard, and Foucault, arguing that a shared Kantian heritage of "critique" underlies theorists usually classified as modernist versus postmodernist, and that this heritage constitutes critique as a complex, ambiguous political practice rather than a neutral method. RELEVANCE: Shows that the liberal/authoritarian reception dispute has a parallel in a modernist/postmodernist reception dispute over Kant's critical method itself, and supplies this domain's most direct treatment of how Arendt's and Habermas's appropriations of Kant (covered individually elsewhere in this domain) relate to one another as instances of a common but contested Kantian inheritance. POSITION: Reconstructive-critical; argues the Kantian heritage in contemporary political theory is ambiguous and contested rather than settled by either liberal or radical appropriations.},
    keywords = "reception, critique, Habermas, Arendt, Foucault, Hutchings, Medium, INCOMPLETE, no-abstract"
}

@misc{schott1997feminist,
    editor = "Schott, Robin May",
    title = "Feminist Interpretations of Immanuel Kant",
    year = "1997",
    address = "University Park, PA",
    note = "CORE ARGUMENT: An edited collection establishing Kant as a focal point for feminist debate over the Enlightenment legacy, because his corpus contains both explicit statements disparaging women's rational and civil capacities and a theoretical framework (autonomy, universal moral law) that some contributors argue can be reconstructed for feminist ends; essays range from readings that find gender hierarchy inscribed in the structure of Kant's ethics and aesthetics to readings that see his account of rational autonomy as a resource for women's emancipation. RELEVANCE: Establishes the terms of this domain's feminist-critical reception controversy and supplies the reference point against which later, more targeted responses (e.g., Mikkola's consistency defense) are framed; directly informs how domain 1's account of the innate right to freedom should be read against Kant's own exclusion of women from full civil personality. POSITION: Pluralistic; the volume itself takes no single position, spanning sympathetic reconstruction and structural critique of Kant's gendered philosophy.",
    keywords = "feminist-critique, women, reception, Schott, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{mikkola2011kant,
    author = "Mikkola, Mari",
    title = "Kant on Moral Agency and Women's Nature",
    journal = "Kantian Review",
    year = "2011",
    volume = "16",
    number = "1",
    pages = "89--111",
    doi = "10.1017/s1369415410000014",
    note = {CORE ARGUMENT: Argues against the severe feminist critique of Kant's moral project — based on his apparently dim view of women as innately morally deficient — by showing that, on closer examination, Kant's considered view of women's moral agency is more complex and less damning than the standard feminist reading attributes to him, thereby undercutting the justification for treating Kant's remarks on women as fatally undermining his ethical universalism. RELEVANCE: Represents the "consistency defense" wing of the feminist reception debate that this domain tracks, responding directly to critiques anthologized in Schott's collection and paralleling the analogous defense move made by Kleingeld and Fleischacker in the race debate. POSITION: Defensive/reconciliationist; holds that Kant's remarks on women, properly interpreted, do not undermine the moral-political universalism of his core theory.},
    keywords = "feminist-critique, women, moral-agency, Mikkola, Medium, INCOMPLETE, no-abstract"
}

@misc{mills2017kants,
    author = "Mills, Charles W.",
    title = "Kant's Untermenschen",
    year = "2005",
    pages = "91--112",
    doi = "10.1093/acprof:oso/9780190245412.003.0006",
    note = {CORE ARGUMENT: Originally published in 2005 (in Andrew Valls's edited collection Race and Racism in Modern Philosophy) and reprinted here in Mills's own essay collection; argues that Kant's raciology is not a detachable personal prejudice but implies a threshold conception of full moral personhood, on which nonwhite "races" — Untermenschen — fail to qualify for the complete standing that Kant's official moral theory would seem to guarantee universally, so that taking Kant's racial views seriously requires a radical rethinking of standard narratives about the history and content of his moral and political philosophy. RELEVANCE: Supplies this domain's most forceful "structural" version of the race-critical reception debate, directly opposed to readings (Kleingeld, Fleischacker) that treat Kant's racism as a superseded early-career view; frames the stakes for how domain 1's universalist reading of the innate right to freedom should be qualified. POSITION: Structural/incompatibilist — Kant's racial hierarchy is not severable from, but constitutive of, how his official universalist moral personhood actually operated in practice.},
    keywords = "race-critique, moral-personhood, Mills, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, year:2017->2005, type:@incollection->@misc"
}

@misc{luadler2023kant,
    author = "Lu-Adler, Huaping",
    title = "Kant, Race, and Racism: Views from Somewhere",
    year = "2023",
    doi = "10.1093/oso/9780197685211.001.0001",
    note = {CORE ARGUMENT: Reframes the Kant-and-race debate by arguing that Kant scholars have paid relatively little critical attention to his raciology, typically assuming it can be disentangled from his core philosophy or that racism straightforwardly contradicts his other commitments; develops instead an account of Kant's racism as an ideological formation, showing how Kant, from his social position as both a leading scholar and a lifelong educator, actively participated in constructing a "scientific" theory of race that was continuous with, not incidental to, his broader philosophical project. RELEVANCE: Provides the most comprehensive recent synthesis of the race-critical reception literature surveyed in this domain, explicitly engaging Mills, Bernasconi, and Kleingeld, and gives the domain's most developed methodological argument that the historiography of Kant's racism cannot be conducted from a supposedly neutral standpoint. POSITION: Structural/ideological-formation view, aligned with but methodologically distinct from Mills; treats Kant's racism as continuous with his standing as philosophical authority rather than as a severable personal failing.},
    keywords = "race-critique, ideology, historiography, Lu-Adler, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{kleingeld2007kants,
    author = "Kleingeld, Pauline",
    title = "Kant's Second Thoughts on Race",
    journal = "The Philosophical Quarterly",
    year = "2007",
    volume = "57",
    number = "229",
    pages = "573--592",
    doi = "10.1111/j.1467-9213.2007.498.x",
    note = {CORE ARGUMENT: Challenges the standard assumption, shared by both critics and defenders of Kant, that his position on race remained stable throughout the 1780s and 1790s; argues instead that in his mature political and cosmopolitan writings of the 1790s Kant revised or abandoned the explicit racial hierarchies defended in his 1780s essays on physical geography and anthropology, so that his "second thoughts" bring his views on race into closer alignment with the moral-political universalism of works covered in domains 6 and 7. RELEVANCE: Supplies this domain's central "developmental" response to the structural race-critical readings (Mills, Lu-Adler), and its philological evidence is a recurring reference point across nearly all subsequent Kant-and-race scholarship, including Fleischacker's synthesis below. POSITION: Developmental/reconciliationist — Kant's considered, mature political universalism supersedes and is inconsistent with his earlier racial hierarchy, rather than being structurally compromised by it.},
    keywords = "race-critique, historical-development, Kleingeld, High, INCOMPLETE, no-abstract"
}

@article{fleischacker2023once,
    author = "Fleischacker, Samuel",
    title = "Once More unto the Breach: Kant and Race",
    journal = "The Southern Journal of Philosophy",
    year = "2023",
    volume = "61",
    number = "1",
    pages = "3--28",
    doi = "10.1111/sjp.12498",
    note = "CORE ARGUMENT: Reframes three decades of debate over Kant's racist texts and support for slavery by systematically reviewing the responses proposed by Mills, Bernasconi, and Kleingeld, arguing for a way of holding together the acknowledgment of Kant's genuine racism with a qualified defense of the moral-political theory against the claim that racism is structurally load-bearing within it. RELEVANCE: Functions as this domain's synthesis-oriented entry point into the race-critical reception debate, explicitly mapping the positions (Mills's structural critique vs. Kleingeld's developmental defense) that this domain otherwise represents through separate primary contributions. POSITION: Mediating; dedicated to Mills but seeks a middle path between Mills's structural critique and Kleingeld's developmental defense.",
    keywords = "race-critique, synthesis, Fleischacker, Medium, INCOMPLETE, no-abstract"
}

@article{basevich2022promise,
    author = "Basevich, Elvira",
    title = "The Promise and Limit of Kant's Theory of Justice: On Race, Gender and the Structural Domination of Labourers",
    journal = "Kantian Review",
    year = "2022",
    volume = "27",
    number = "4",
    pages = "541--555",
    doi = "10.1017/s1369415422000292",
    abstract = "This article applies Charles W. Mills' notion of the domination contract to develop a Kantian theory of justice. The concept of domination underlying the domination contract is best understood as structural domination, which unjustifiably authorizes institutions and labour practices to weaken vulnerable groups' public standing as free, equal and independent citizens. Though Kant's theory of justice captures why structural domination of any kind contradicts the requirements of justice, it neglects to condemn exploitive gender- and race-based labour relations. Because the ideal of civic equality must position all persons as co-legislators of the terms of political rule, the state must dismantle exploitive race- and gender-based labour relations for all persons to command political power as civic equals.",
    abstract_source = "s2",
    note = "CORE ARGUMENT: Extends the race-critical reception debate in an explicitly intersectional direction, arguing that the category of moral personhood central to Mills's critique of Kant is necessary but insufficient on its own for a robust reparative political critique, because it does not by itself capture the structural domination of racialized and gendered labor; situates this limitation within Kant's own theory of justice rather than treating it as an external imposition. RELEVANCE: Bridges this domain's feminist-critical and race-critical reception controversies, showing how the two lines of critique converge on Kant's account of civil personhood and economic dependence (connecting to the passive-citizenship material covered in domain 3). POSITION: Intersectional-critical; builds on but goes beyond Mills's moral-personhood framework to foreground structural economic domination.",
    keywords = "race-critique, feminist-critique, intersectionality, labor, Basevich, Medium"
}

@article{pogge1988kants,
    author = "Pogge, Thomas W.",
    title = "Kant's Theory of Justice",
    journal = "Kant-Studien",
    year = "1988",
    volume = "79",
    number = "1-4",
    pages = "407--433",
    doi = "10.1515/kant.1988.79.1-4.407",
    note = "CORE ARGUMENT: An early and influential attempt to reconstruct Kant's political philosophy as a systematic theory of justice organized around the relation between individual freedom and the coercive state, following the tradition of classical liberalism and reading Kant's theory of Right through categories drawn from Rawlsian justice theory; the essay became a key reference point for how Anglophone political philosophy subsequently approached Kant's Doctrine of Right. RELEVANCE: Directly bears on this domain's key question of how faithful Rawlsian appropriations of Kant are to Kant's own Doctrine of Right, since Pogge's own reconstruction already imports Rawlsian categories into the interpretation of Kant, making the essay itself a primary document in, rather than merely a commentary on, the appropriation debate. POSITION: Rawlsian-influenced systematic reconstruction; reads Kant's theory of justice as continuous with, and illuminated by, Rawlsian categories.",
    keywords = "Rawls-Kant, theory-of-justice, Pogge, reception, High, INCOMPLETE, no-abstract"
}

@article{mccarthy1994kantian,
    author = "McCarthy, Thomas",
    title = "Kantian Constructivism and Reconstructivism: Rawls and Habermas in Dialogue",
    journal = "Ethics",
    year = "1994",
    volume = "105",
    number = "1",
    pages = "44--63",
    doi = "10.1086/293678",
    note = {CORE ARGUMENT: Stages a direct comparison between Rawls's "Kantian constructivism" (from the 1980 Dewey Lectures and Political Liberalism) and Habermas's discourse-theoretic "reconstructivism," arguing that although both claim a Kantian lineage, they diverge on the status of practical reason, the role of the original position versus discourse ethics' idealized dialogue, and the resulting conceptions of political legitimacy. RELEVANCE: Gives this domain's most direct treatment of key question 3 (fidelity of Kantian constructivism to Kant's own Doctrine of Right) by showing that even among self-described Kantians, "Kantian constructivism" names at least two substantially different appropriations of Kant's practical philosophy. POSITION: Comparative-critical; does not simply endorse either appropriation but clarifies where Rawls's and Habermas's rival constructivisms diverge from one another and, implicitly, from Kant.},
    keywords = "Rawls-Kant, Habermas-Kant, constructivism, McCarthy, High, INCOMPLETE, no-abstract"
}

@article{mertens2002perpetual,
    author = "Mertens, Thomas",
    title = "From 'Perpetual Peace' to 'The Law of Peoples': Kant, Habermas and Rawls on International Relations",
    journal = "Kantian Review",
    year = "2002",
    volume = "6",
    pages = "60--84",
    doi = "10.1017/s1369415400001606",
    note = "CORE ARGUMENT: Investigates how much of Kant's proposal in Toward Perpetual Peace survives in Habermas's and Rawls's own accounts of international relations, reconstructing Kant's essay in the vocabulary each later thinker uses and tracing where Habermas's cosmopolitan discourse theory and Rawls's Law of Peoples depart from Kant's original scheme (e.g., on the status of a world republic versus a voluntary league of states). RELEVANCE: Extends this domain's Rawls/Habermas appropriation debate specifically into the international-right material covered in domain 6, showing that the appropriation question is not confined to domestic Doctrine-of-Right issues but extends to cosmopolitan and international right as well. POSITION: Comparative-critical; treats both Habermas and Rawls as substantially, but incompletely, faithful appropriators of Kant's peace proposal.",
    keywords = "Rawls-Kant, Habermas-Kant, perpetual-peace, law-of-peoples, Mertens, Medium, INCOMPLETE, no-abstract"
}

@book{arendt1982lectures,
    author = "Arendt, Hannah",
    editor = "Beiner, Ronald",
    title = "Lectures on Kant's Political Philosophy",
    year = "1982",
    publisher = "University of Chicago Press",
    doi = "10.7208/chicago/9780226231785.001.0001",
    note = {CORE ARGUMENT: Posthumously published lecture notes, edited with an interpretive essay by Ronald Beiner, in which Arendt argues that Kant's "unwritten" political philosophy is to be found not in the Doctrine of Right but in the Critique of the Power of Judgment, reconstructing reflective judgment, taste, and the sensus communis as the basis for a properly political, plurality-oriented mode of thinking distinct from both Kant's moral philosophy and his explicit political writings. RELEVANCE: Represents the single most influential and idiosyncratic appropriation of Kant in twentieth-century political theory, redirecting attention from the Doctrine of Right (the focus of domains 1-5) to the third Critique as the resource for political theory; essential reference point for this domain's account of Kant's reception by Arendt and, through her, a distinct branch of contemporary Kantian political theory (Beiner, Nedelsky, Benhabib). POSITION: Judgment-centered reconstruction; locates Kant's most valuable contribution to political philosophy outside the texts (Doctrine of Right, Perpetual Peace) that dominate mainstream Kant political-philosophy scholarship.},
    keywords = "Arendt, judgment, sensus-communis, reception, High, INCOMPLETE, no-abstract"
}

@book{stilz2009liberal,
    author = "Stilz, Anna",
    title = "Liberal Loyalty: Freedom, Obligation, and the State",
    year = "2009",
    publisher = "Princeton University Press",
    doi = "10.1515/9781400830701",
    note = {CORE ARGUMENT: Drawing on Kant, Rousseau, and Habermas, argues against both cosmopolitan views (on which particular political loyalty is incompatible with universal liberal principles) and communitarian/nationalist views (on which shared culture or ethnicity grounds obligation); defends instead a distinctively liberal account on which citizens owe civic obligations to a sufficiently just state because constitutionally enshrined principles of justice, realized and guaranteed within that particular state, are themselves the ground of obedience and democratic solidarity. RELEVANCE: Exemplifies how contemporary liberal and cosmopolitan political theory continues to draw selectively on Kant's account of the rightful condition and political obligation (covered in domains 1-2) to address questions — territorial statehood, civic loyalty — that Kant's own texts address only partially, illustrating the "contemporary Kantian political theory" strand of this domain's reception story. POSITION: Kantian-liberal statism; grounds political obligation in the justice of one's particular state's constitutional order rather than in cosmopolitan or nationalist principles.},
    keywords = "Kantian-liberalism, political-obligation, citizenship, Stilz, Medium, INCOMPLETE, no-abstract"
}

@article{budde2007rawls,
    author = "Budde, Kerstin",
    title = "Rawls on Kant",
    journal = "European Journal of Political Theory",
    year = "2007",
    volume = "6",
    number = "3",
    pages = "339--358",
    doi = "10.1177/1474885107077321",
    note = {CORE ARGUMENT: Poses directly the question of fidelity at stake in this domain's third reception controversy — "is Rawls a Kantian or Kant a Rawlsian?" — by examining how Rawls's own presentation of Kant, especially in the Dewey Lectures and Lectures on the History of Moral Philosophy, selectively emphasizes and reconstructs elements of Kant's ethics in ways that serve Rawls's constructivist project, rather than offering a historically neutral reading of Kant. RELEVANCE: Directly targets key question 3 of this domain (how faithful Rawlsian constructivism is to Kant's own texts and what Rawls selectively appropriated), making it one of the most load-bearing entries for that question alongside Pogge, McCarthy, and Mertens. POSITION: Critical of any simple identification between Rawls's constructivism and Kant's own moral-political philosophy; treats Rawls's Kant as a selective, purpose-built reconstruction.},
    keywords = "Rawls-Kant, constructivism, appropriation, Budde, Medium, INCOMPLETE, no-abstract"
}

