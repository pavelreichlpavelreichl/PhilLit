@misc{zhang2017unethical,
    author = "Zhang, Jenna",
    title = "Unethical Laws and Lawless Ethics: Right and Virtue in Kant's Rechtslehre",
    year = "2017",
    number = "2",
    abstract = "In this paper, I examine the relation between law and morality within the context of Kant's late work The Metaphysics of Morals. I argue that Kant's conception of the law is based on a fundamental distinction between Right and Virtue, which respectively correspond to his legal-political theory and moral philosophy. My analysis is two part: in the first part, I examine the relationship between the Doctrines of Right and Virtue within the Kantian architectonic; in the second, I evaluate two cases of adjudication in the Rechtslehre that exemplify the distinction between law and morality explicated in the preceding section. I begin by showing that Kant's legal and moral philosophies are normatively distinct, insofar as Right and Virtue belong to incommensurable realms of freedom and necessity. From this distinction, I derive Kant's conception of the legal state as principally concerned with external freedoms and the preservation of the lawful condition itself. The second part of this paper analyzes Kant's views on two cases of criminal justice, revealing his prioritization of the political over independent ethical considerations in juridical decision-making. Here, the conceptual barrier between law and morality serves as a caveat against facile recourses to Kantian ethics as means of legitimizing juridico-political decisions.",
    abstract_source = "s2",
    note = {CORE ARGUMENT: Argues that Right and Virtue belong to "incommensurable realms of freedom and necessity" within the Kantian architectonic, so that the legal state is principally concerned with external freedom and the preservation of the lawful condition as such, independently of ethical considerations; illustrates this through two cases of Kantian criminal adjudication that show law's priority over independent ethical reasoning in juridical decision-making. RELEVANCE: Provides a textually grounded, case-based argument for treating Right as normatively distinct from Virtue, directly bearing on this domain's question of whether political obligation reduces to a moral duty derived from the Categorical Imperative — Zhang's answer is a qualified no. POSITION: Independence-leaning; treats Right and Virtue as belonging to distinct normative realms, though the paper's warning against "facile recourse to Kantian ethics" to legitimate legal decisions is narrower than Willaschek's architectonic claim.},
    keywords = "right-virtue-relation, independence-thesis, coercion, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@article{guyer2016twofold,
    author = "Guyer, Paul",
    title = "The Twofold Morality of Recht: Once More Unto the Breach",
    journal = "Kant-Studien",
    year = "2016",
    number = "1",
    sep_context = {Cited alongside "Guyer 2000" in SEP's "Kant's Moral Philosophy" (kant-moral), section 10 "Autonomy": Guyer's interpretive strategy is glossed as seeing "an argument for freedom as an end in itself," in contrast to the humanity-based strategies of Korsgaard (1996) and Wood (1999).},
    note = {CORE ARGUMENT: A direct response, signaled by the title's dueling metaphor, to Willaschek's and related independence-thesis arguments that the Doctrine of Right cannot be derived from Kant's moral theory; reasserts (in line with Guyer's broader freedom-centered reading of Kant, cf. Guyer 2000 below) that juridical duties of Right retain a moral character grounded in the value of freedom, against readings that sever Right from the Categorical Imperative. RELEVANCE: Supplies the derivation-side rejoinder to the independence-thesis papers collected in domain 1 (especially Willaschek 2009 and Seel 2009), giving this domain's key debate its most direct dependence-side proponent alongside Guyer's monograph. POSITION: Dependence/derivation view — Right retains a "twofold morality," grounded ultimately in the same freedom-based value that grounds ethics.},
    keywords = "independence-thesis, derivation-thesis, Guyer, autonomy, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, doi"
}

@misc{willaschek2017why,
    author = "Willaschek, Marcus",
    title = "Why the Doctrine of Right does not belong in the Metaphysics of Morals",
    publisher = "Routledge",
    year = "2017",
    note = {CORE ARGUMENT: Argues that Kant's system of duties in the Metaphysics of Morals is neither consistent nor complete, because duties of Right and duties of Virtue, contrary to Kant's own official architectonic claim, do not jointly exhaust the domain of moral duty; shows that Kant combines two incompatible views — an "official" view on which Right is part of morality (implying that the authorization to coerce could be morally justified) and an underlying practice on which no such moral justification of coercion is actually available, rendering the "official" view inadequate. RELEVANCE: Extends the independence thesis beyond the 2009 "Right and Coercion" article (domain 1) into a stronger architectonic claim about where the Doctrine of Right belongs within Kant's system, sharpening the stakes of the debate for how the entire Metaphysics of Morals should be read. POSITION: Independence thesis, strong version — the Doctrine of Right does not merely stand apart from ethics but is architectonically misplaced within the Metaphysics of Morals as Kant conceived it.},
    keywords = "independence-thesis, Willaschek, architectonic, coercion, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{kleingeld2018moral,
    author = "Kleingeld, Pauline",
    title = "Moral Autonomy as Political Analogy: Self-Legislation in Kant's 'Groundwork' and the 'Feyerabend Lectures on Natural Law'",
    publisher = "Cambridge University Press",
    year = "2018",
    note = {CORE ARGUMENT: Argues that the political theory Kant defended while writing the Groundwork illuminates the well-known difficulties in his account of moral autonomy; shows that Kant's two-tiered structure of political legislation in the Feyerabend Lectures on Natural Law parallels his distinction between two levels of moral legislation, explaining why Kant could regard "autonomy" as an apt expression of the principle of morality in the mid-1780s. RELEVANCE: Reverses the usual direction of derivation debates (which ask whether Right derives from ethics) by showing that Kant's early political theory of legislation is the model on which his moral concept of autonomy was analogically built, directly bearing on how autonomy and external freedom relate historically and conceptually. POSITION: Historical/genetic; neither straightforwardly independence nor derivation, but argues political self-legislation is the conceptual template for moral self-legislation.},
    keywords = "autonomy, self-legislation, political-analogy, Kleingeld, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{kleingeldwillaschek2019autonomy,
    author = "Kleingeld, Pauline and Willaschek, Marcus",
    title = "Autonomy Without Paradox: Kant, Self-Legislation and the Moral Law",
    year = "2019",
    volume = "19",
    note = {CORE ARGUMENT: Addresses the "paradox of autonomy" — the worry that if the moral law is self-legislated, agents seem free to legislate any law whatever, undermining the law's necessity and universality — by arguing that Kant's conception of self-legislation as legislation of and for all rational beings as such dissolves the apparent paradox without requiring the moral law to be given independently of the will. RELEVANCE: Directly addresses one of this domain's key questions (how autonomy as self-legislation relates to freedom and lawful necessity) and thereby indirectly supports derivation-friendly readings of Right, since if self-legislation is not paradoxical, there is less pressure to treat Right's Universal Principle as needing a separate, non-autonomous foundation. POSITION: Defends the coherence of the standard self-legislation conception of autonomy against a leading objection, without directly adjudicating the independence-thesis debate.},
    keywords = "autonomy, self-legislation, paradox, Kleingeld, Willaschek, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{edwards2017autonomy,
    author = "Edwards, Jeffrey",
    title = "Autonomy, Moral Worth, and Right: Kant on Obligatory Ends, Respect for Law, and Original Acquisition",
    year = "2017",
    note = {CORE ARGUMENT: Examines the ramifications of Kant's late account of practical reason's obligatory ends together with what the book characterizes as a "revolutionary implication" of Kant's theory of original property acquisition, connecting the ethical concepts of autonomy, moral worth, and respect for law to the juridical doctrine of Right via the shared problem of obligatory ends. RELEVANCE: Offers a book-length attempt to trace continuity between Kant's ethical vocabulary (autonomy, moral worth, respect for law) and the Doctrine of Right's account of acquisition, providing material for assessing whether foundational ethical concepts do real explanatory work within Right or merely share terminology with it. POSITION: Broadly derivation-friendly in orientation, tracing conceptual continuity between ethical and juridical vocabulary, though developed through original acquisition rather than through the independence-thesis debate directly.},
    keywords = "autonomy, right, property, obligatory-ends, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@misc{faggion2018remarks,
    author = "Faggion, Andrea",
    title = "Remarks on Kant's Argument for Political Authority",
    year = "2018",
    note = "CORE ARGUMENT: A short critical engagement with Kant's argument that rational agents are obligated to submit to, or establish, political authority as a condition of realizing their innate right to freedom (the standard reading, per Ebels-Duggan's SEP-adjacent formulation, being that since we can secure everyone's right to freedom only within a state, we are obligated to enter or support one). RELEVANCE: Directly engages this domain's question of whether political obligation is itself a moral duty, complementing the author's other contribution (Faggion 2015, domain 1) on the innate right, by turning from the content of that right to the argument for why it obligates entry into a civil condition. POSITION: Critical engagement with the standard argument for political authority; does not straightforwardly defend either an independence or a derivation reading.",
    keywords = "political-obligation, political-authority, Faggion, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, doi, type:@incollection->@misc"
}

@article{besch2008constructing,
    author = "Besch, Thomas M.",
    title = "Constructing Practical Reason: O'Neill on the Grounds of Kantian Constructivism",
    journal = "The Journal of Value Inquiry",
    year = "2008",
    number = "1",
    note = {CORE ARGUMENT: Addresses O'Neill's view that her version of the Categorical Imperative — the requirement of "followability" (RF) — marks the supreme principle of practical reason, and takes issue with her claim that RF commits us to Kantian constructivism; probes whether O'Neill's constructivist grounding strategy for practical reason actually secures the authority she claims for it. RELEVANCE: A sustained critical engagement with the constructivist alternative (O'Neill 1990, 2015, both in this domain) to independence/derivation framings of the ethics-Right relation, testing whether "followability" can do the foundational work O'Neill assigns it across both ethical and political domains. POSITION: Critical of O'Neill's constructivism; questions whether her followability requirement grounds, rather than merely expresses, Kantian practical reason.},
    keywords = "constructivism, O'Neill, followability, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, pages, doi"
}

@book{oneill2015constructing,
    author = "O'Neill, Onora",
    title = "Constructing Authorities: Reason, Politics and Interpretation in Kant's Philosophy",
    publisher = "Cambridge University Press",
    year = "2015",
    note = "CORE ARGUMENT: Challenges the claim that Kant's critique of reason collapses into a dogmatic argument from authority by showing that Kant held the authority of reason must be constructed, not assumed, and that this is achieved by ensuring that anything offered as a reason can in principle be followed by others, including those who disagree; argues this constructivist view of reasoning is the key to Kant's claims about knowledge, ethics, and politics alike, including his accounts of autonomy, the social contract, and cosmopolitan justice. RELEVANCE: The clearest statement of the view that ethics and politics in Kant share a single constructivist method rather than standing in a derivation or independence relation, making it central to this domain's question of whether Kant's political philosophy is a distinct branch of practical philosophy or an application of a single, unified method of reasoning. POSITION: Constructivist — treats the authority of reason across ethics, politics, knowledge, and interpretation as uniformly constructed via the followability requirement, cutting across the independence/derivation dichotomy.",
    keywords = "constructivism, politics, O'Neill, authority, followability, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@book{oneill1990constructions,
    author = "O'Neill, Onora",
    title = "Constructions of Reason: Explorations of Kant's Practical Philosophy",
    publisher = "Cambridge University Press",
    year = "1990",
    note = {CORE ARGUMENT: Reconsiders Kant's conceptions of philosophical method, reason, freedom, autonomy, and action before turning to interpretation of the Categorical Imperative, and closes by emphasizing differences between Kant's ethics and later "Kantian" ethics, including the work of Rawls and other contemporary liberal political philosophers. RELEVANCE: The foundational statement of O'Neill's constructivist reading of Kant's practical philosophy, providing the methodological baseline against which her later Constructing Authorities (2015) and critical responses (Besch 2008, Watkins and Fitzpatrick 2002) should be read; its closing contrast with Rawlsian "Kantian" liberalism is directly relevant to how far Kant's own political philosophy tracks contemporary Kantian-liberal political theory. POSITION: Foundational constructivist reading; treats autonomy, freedom, and the Categorical Imperative as products of a shared constructive method rather than as ethical premises from which Right is derived.},
    keywords = "constructivism, autonomy, freedom, O'Neill, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@book{guyer2000kant,
    author = "Guyer, Paul",
    title = "Kant on Freedom, Law, and Happiness",
    publisher = "Cambridge University Press",
    year = "2000",
    sep_context = {Cited in SEP's "Kant's Moral Philosophy" (kant-moral), section 10 "Autonomy": glossed as offering "an argument for freedom as an end in itself," contrasted with the humanity-based strategies "favored by Korsgaard (1996) and Wood (1999)" for grounding the Categorical Imperative.},
    note = {CORE ARGUMENT: Radically revises the traditional interpretation of Kant's moral and political philosophy around the value of freedom rather than the value of humanity or rational nature as such, arguing that Kant's mature position amounts to a coherent liberalism capable of guiding contemporary moral and political debates. RELEVANCE: The principal monograph statement of the freedom-centered ("Guyer") position in the debate over how to ground the Categorical Imperative (cf. Guyer 2016 above), providing the systematic backing for Guyer's contributions to the independence-thesis literature and situating that debate within a broader interpretation of Kant's ethics and politics as a unified liberal philosophy of freedom. POSITION: Freedom-as-end-in-itself grounding of the Categorical Imperative; treats Kant's moral and political philosophy as expressions of a single coherent liberalism, favoring a derivation-friendly reading of Right's relation to ethics.},
    keywords = "autonomy, freedom, liberalism, Guyer, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@misc{wood1999kants,
    author = "Wood, Allen W.",
    title = "Kant's Ethical Thought",
    year = "1999",
    sep_context = {Cited repeatedly in SEP's "Kant's Moral Philosophy" (kant-moral): in section 10 "Autonomy," Wood (1999) is grouped with Korsgaard (1996) as favoring the strategy of grounding the Categorical Imperative in the argument that humanity is an end in itself, "by contrast" with Guyer's freedom-based strategy; in section 15 "Metaethics," Wood (1999) is cited (with Ameriks 2003, Langton 2007, Kain 2004) as interpreting Kant as "a robust moral realist" on which rational nature has objective, agent-neutral, intrinsic value; in section 9, Wood (1999, 2007) is cited as doubting whether the Humanity Formula alone can capture all the duties Kant claims to derive from it.},
    note = "CORE ARGUMENT: Develops a systematic interpretation of Kant's ethics centered on the value of humanity/rational nature as an objective end in itself, reading Kant as a moral realist for whom the Categorical Imperative specifies how agents with this special status must be treated, in contrast to freedom-centered (Guyer) or purely proceduralist readings. RELEVANCE: One of the two principal monograph interpretations (with Guyer 2000) against which SEP situates the independence-thesis and autonomy debates; its humanity-based, realist grounding of the Categorical Imperative offers a distinct basis from which to ask whether the Universal Principle of Right can or cannot be derived. POSITION: Humanity-based moral realism; grounds the Categorical Imperative in the objective value of rational nature, aligning with derivation-friendly readings insofar as Right, too, concerns the treatment owed to rational agents as ends in themselves. No publisher metadata available from any queried API (S2, CrossRef, CORE); included with minimal fields per the no-fabrication rule.",
    keywords = "autonomy, humanity, moral-realism, Wood, High, no-publisher-found, INCOMPLETE, no-abstract"
}

@article{horn2016kants,
    author = "Horn, Christoph",
    title = "Kant's Political Philosophy as a Theory of Non-Ideal Normativity",
    journal = "Kant-Studien",
    year = "2016",
    number = "1",
    note = {CORE ARGUMENT: Proposes reading Kant's political philosophy as a distinct theory of "non-ideal normativity," addressed to the conditions of actual, imperfect political life (coercion, the state of nature, existing institutions) rather than as a direct extension of the ideal, unconditional normativity of the moral law; published in the same Kant-Studien issue as Guyer's "Twofold Morality of Recht," making the two papers direct interlocutors in the same debate. RELEVANCE: Offers a third way of framing this domain's central question — neither straightforward derivation nor strict independence, but a difference in normative register (ideal vs. non-ideal) between ethics and politics — that reframes what is at stake in reading Right as continuous or discontinuous with the Categorical Imperative. POSITION: Neither independence nor derivation in the usual sense; argues Kant's political philosophy constitutes a non-ideal normative theory distinct in kind, though not necessarily in ultimate source, from his ideal ethics.},
    keywords = "political-philosophy, non-ideal-theory, Horn, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: volume, doi"
}

@misc{tarasenkostruc2019kantian,
    author = "Tarasenko-Struc, Aleksy",
    title = "Kantian constructivism and the authority of others",
    year = "2019",
    volume = "28",
    number = "1",
    note = "CORE ARGUMENT: Argues that Christine Korsgaard's Kantian constructivism cannot accommodate genuine obligations to others: because Korsgaard holds that all obligation is grounded in an agent's obligating herself, she is committed to the view that obligations to others are ultimately grounded in corresponding obligations to oneself, which the paper argues rests on an objectionably egocentric conception of authority on which others possess authority over us only because we grant it to them. RELEVANCE: Directly bears on this domain's question of whether political obligation is a moral duty on Kantian-constructivist grounds, since a constructivism that cannot secure genuine other-regarding obligation faces particular difficulty explaining obligations to fellow citizens or to the state; complements the domain's other engagements with O'Neill's constructivism (Besch 2008, Watkins and Fitzpatrick 2002) by targeting Korsgaard's version specifically. POSITION: Critical of Korsgaardian constructivism; argues its self-legislation model yields an egocentric account of authority ill-suited to grounding obligations, including political ones, to others.",
    keywords = "constructivism, Korsgaard, authority, obligation, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@misc{schadow2013recht,
    author = "Schadow, Steffi",
    title = "Recht und Ethik in Kants Metaphysik der Sitten (MS 6:218–221 und TL 6:390 f.)",
    year = "2013",
    pages = "85--112",
    note = "CORE ARGUMENT: A close commentary on two specific passages of the Metaphysics of Morals (the general introduction at 6:218–221 and the transition passage at TL 6:390f.) in which Kant himself characterizes the relation between Recht (Right) and Ethik (Ethics/Virtue), examining how Kant's own architectonic remarks bear on the systematic unity of the two doctrines. RELEVANCE: A textually focused German-language companion to the English-language independence-thesis debate (Willaschek, Guyer, Zhang, in this domain and domain 1), grounding the abstract dispute over derivation versus independence in Kant's own explicit statements about the Recht/Ethik distinction at the specific loci scholars most often cite. POSITION: Exegetical; clarifies rather than adjudicates the derivation/independence dispute by close reading of Kant's own architectonic self-description.",
    keywords = "right-virtue-relation, architectonic, textual-commentary, German-scholarship, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc"
}

@misc{whelan2021realizing,
    author = "Whelan, Robert Patrick",
    title = "Realizing Freedom as Non-domination: Political Obligation in Kant's Doctrine of Right",
    year = "2021",
    volume = "28",
    number = "1",
    note = {CORE ARGUMENT: Develops an account of Kantian political obligation building on the non-domination reading of the innate right to freedom (the Ripstein-influenced view that freedom means being "one's own master," independent from domination by others), arguing that political obligation should be understood as required for realizing, rather than merely constraining, this freedom as non-domination. RELEVANCE: Directly addresses this domain's key question of whether political obligation is a moral duty by working through the non-domination framework (shared with Ripstein 2009 and the independence-thesis literature in domain 1) rather than through direct appeal to the Categorical Imperative, showing how a broadly independence-friendly reading of Right can still generate a robust account of political obligation. POSITION: Independence-friendly, non-domination account of political obligation, developed as an extension of the Ripsteinian formalist tradition rather than of the derivation view.},
    keywords = "political-obligation, non-domination, Ripstein, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@article{watkinsfitzpatrick2002oneill,
    author = "Watkins, Eric and Fitzpatrick, William",
    title = "O'Neill and Korsgaard on the Construction of Normativity",
    journal = "The Journal of Value Inquiry",
    year = "2002",
    volume = "36",
    number = "2-3",
    note = "CORE ARGUMENT: A comparative critical examination of O'Neill's and Korsgaard's constructivist accounts of how practical normativity is generated within a broadly Kantian framework, assessing whether either author's constructivist strategy succeeds in explaining the authority of moral (and, on O'Neill's extension, political) requirements without covertly presupposing the very normativity it aims to construct. RELEVANCE: Provides a comparative frame for the two constructivist figures most relevant to this domain (O'Neill's Constructions of Reason and Constructing Authorities, above; Korsgaard's self-legislation model, criticized by Tarasenko-Struc, above), helping to distinguish what is shared versus distinctive in their respective extensions of Kantian constructivism from ethics toward politics. POSITION: Critical assessment of both O'Neill's and Korsgaard's constructivist projects; does not itself defend either author's grounding strategy.",
    keywords = "constructivism, O'Neill, Korsgaard, normativity, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages, doi"
}
