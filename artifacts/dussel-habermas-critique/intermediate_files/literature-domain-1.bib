@comment{
====================================================================
DOMAIN: The Dussel-Apel-Habermas Dialogue (Historical and Textual Context)
SEARCH_DATE: 2026-06-08
PAPERS_FOUND: 13 total (High: 6, Medium: 5, Low: 2)
SEARCH_SOURCES: SEP, IEP, PhilPapers, Semantic Scholar, OpenAlex, CORE
====================================================================

DOMAIN_OVERVIEW:
This domain covers the documented intellectual exchange between Enrique Dussel,
Karl-Otto Apel, and (more indirectly) Jürgen Habermas — a North-South philosophical
dialogue that unfolded primarily in the 1990s and early 2000s around discourse ethics
and ethics of liberation. The central textual records are Dussel's own writings from
the "Underside of Modernity" period (1996 onwards), the collaborative volume
"Discourse Ethics and Ethics of Liberation" (Apel and Dussel), and Dussel's "Ethics
of Liberation" (1998/2013). Secondary literature reconstructing this exchange ranges
from survey articles in Spanish-language philosophy journals to English-language
scholarly chapters situating Dussel's engagement with Frankfurt Critical Theory.

The key scholarly question is whether Apel and Dussel reached genuine convergence or
simply registered irreducible differences: Apel conceded the need for a "Part B"
application of discourse ethics attentive to real asymmetries, while Dussel insisted
that material conditions (life as criterion) precede and cannot be derived from formal
communicative procedures. Habermas himself engaged less directly, but Dussel positioned
the Ethics of Liberation explicitly against Habermasian communicative ethics. Secondary
authors — Hurtado López, Zielinski, Vilchis Carlos, Sørensen, Rivera Sepúlveda, and
Rodríguez Reyes — reconstruct the chronology and philosophical substance of these
exchanges with varying degrees of detail.

A key organizational finding is that Apel, not Habermas, was Dussel's primary
interlocutor: Apel attended the Mainz/Frankfurt dialogues and produced written
responses, while Habermas's engagement was mediated and less direct. Allen's chapter
(2021) is the clearest English-language reconstruction situating Dussel against the
Frankfurt School as a whole. Mendieta's 1999 review essay and Dussel's own 1997
"Architectonic" article are foundational primary/secondary interface texts.

RELEVANCE_TO_PROJECT:
This domain provides the textual and historical scaffold for all other dimensions of
Dussel's critique of Habermas: without understanding the Apel-mediated exchange, the
logic of Dussel's objections to communicative ethics (Eurocentrism of the ideal
communication community, priority of material life over formal validity, the excluded
Other as starting point) cannot be properly contextualized. The chronology — 1990s
dialogues → 1998 Ethics of Liberation → 2000s reception — frames the research project.

NOTABLE_GAPS:
German-language secondary literature on the Frankfurt/Mainz dialogues themselves is
largely inaccessible in English databases; Apel's own written responses to Dussel
(in "Etica del Discurso y Etica de la Liberacion", 1992, co-authored with Dussel) were
not found as a verified standalone entry. Several Spanish-language articles lacked DOIs
and had no abstracts in any source.

SYNTHESIS_GUIDANCE:
The synthesis should distinguish between (a) secondary literature that reconstructs
the historical exchange, (b) primary texts in which Dussel explicitly engages Apel
and Habermas, and (c) commentary that situates this exchange in the broader North-South
or decolonial context. Allen (2021) and Mendieta (1999) are the anchor secondary texts
for English-language synthesis.

KEY_POSITIONS:
- Pro-dialogue convergence: [3 papers] — Hurtado López, Vilchis Carlos, Rodríguez Reyes: argue Apel-Dussel exchange produced genuine complementarity
- Dussel's critique as ideology critique: [2 papers] — Sørensen, Rivera Sepúlveda: read Dussel's challenge to discourse ethics as structural critique of Eurocentric formalism
- Contextual situating (Frankfurt School): [2 papers] — Allen, Mendieta: reconstruct Dussel's position within and against Critical Theory tradition
- Apel's responses reconstructed: [2 papers] — Zielinski, Roldán: document what Apel conceded and refused
====================================================================
}

@incollection{allen2021ethics,
  author = {Allen, Amy},
  title = {The Ethics and Politics of Progress: Dussel and the {Frankfurt School}},
  booktitle = {Decolonizing Ethics},
  year = {2021},
  pages = {167--181},
  publisher = {Penn State University Press},
  doi = {10.1515/9780271090320-010},
  note = {
CORE ARGUMENT: Allen situates Dussel's ethics of liberation in explicit confrontation with Frankfurt School critical theory — particularly Habermas's theory of communicative action and the discourse ethics of Apel. She argues that Dussel's critique of the Eurocentrism embedded in the ideal communication community constitutes a structural challenge to the normative foundations of the Frankfurt School, not merely a regional supplement. The chapter reconstructs where Dussel and Frankfurt theorists converge (on critique of instrumental reason, on universalism) and where Dussel's insistence on the exteriority of the Other marks an irreducible break.

RELEVANCE: This is the most direct English-language secondary reconstruction of Dussel's engagement with the Frankfurt School as a whole. It provides the conceptual framework for understanding why Apel, not merely Habermas, was Dussel's primary interlocutor, and why the material criterion of life (not formal communicative validity) is the philosophical crux of the dispute.

POSITION: Situates Dussel's ethics of liberation as a structural critique of Eurocentric universalism in Frankfurt School normative theory.
  },
  keywords = {Dussel, Frankfurt-School, Habermas, Apel, discourse-ethics, ethics-of-liberation, High, INCOMPLETE, no-abstract}
}

@article{mendieta1999review,
  author = {Mendieta, Eduardo},
  title = {Review Essay: Ethics for an Age of Globalization and Exclusion},
  journal = {Philosophy \& Social Criticism},
  year = {1999},
  volume = {25},
  number = {2},
  pages = {115--121},
  doi = {10.1177/019145379902500206},
  note = {
CORE ARGUMENT: Mendieta's review essay introduces Dussel's "Ethics of Liberation" to the English-language philosophical community and explicitly contextualizes it as a response to Apel and Habermas's discourse ethics. He reconstructs how Dussel appropriates the formal validity principle from Apel while subordinating it to the material criterion of life, tracing this as the key move in the North-South dialogue of the 1990s.

RELEVANCE: As a review by Dussel's principal English-language translator and intellectual collaborator, this essay offers a privileged reconstruction of the Apel-Dussel exchange and its significance. It is one of the earliest English-language secondary texts to frame the "Ethics of Liberation" explicitly in terms of its dialogue with Apel.

POSITION: Presents the Dussel-Apel exchange as a productive complementarity, with Dussel's material ethics correcting the formalism of Northern discourse ethics.
  },
  keywords = {Dussel, Apel, discourse-ethics, ethics-of-liberation, North-South-dialogue, High},
  abstract = {Dussel's ethics begins with a consideration of the importance of history for ethics in general and for us, in particular, in an age of globaliz ation and exclusion. The first part of the work concerns foundational ethics, where he grounds three principles: a material principle, a formal or validity principle, and a feasibility principle. The second part deals with critical ethics, where he grounds three additional principles of ethics: a principle of the recognition of the corporeal dignity of co-subjects, the critical-discur sive principle, and the liberation principle. This ethics offers itself as a third way between neo-Kantianism and neo-Aristotelianism, and as an ethics that reflects out of the pressing problem of the growing impoverishment of 75 per cent of humans on the planet.},
  abstract_source = {openalex},
}

@article{dussel1997architectonic,
  author = {Dussel, Enrique},
  title = {The Architectonic of the Ethics of Liberation},
  journal = {Philosophy \& Social Criticism},
  year = {1997},
  volume = {23},
  number = {3},
  pages = {1--35},
  doi = {10.1177/019145379702300301},
  note = {
CORE ARGUMENT: Dussel lays out the formal architecture of the Ethics of Liberation — the three principles (material, formal/discursive, and feasibility) — and explicitly positions the formal principle in relation to Apel and Habermas's discourse ethics. He concedes the necessity of the formal communicative principle while arguing it must be grounded in the prior material criterion of the reproduction of human life, a move that both incorporates and limits discourse ethics.

RELEVANCE: This is the primary text in which Dussel most systematically addresses his debt to and critique of Apel, making it the essential reference for any secondary reconstruction of what Dussel "took" from Apel and what he rejected. The 1997 publication coincides with the height of the Apel-Dussel dialogue period.

POSITION: Primary text representing Dussel's own formulation of the Apel dialogue — a position of critical appropriation of discourse ethics within a materially grounded liberation framework.
  },
  keywords = {Dussel, Apel, discourse-ethics, ethics-of-liberation, architectonic, primary-text, High},
  abstract = {This contribution is a critical and constructive engage ment with discourse ethics. First, it clarifies why discourse ethics has difficulties with the grounding and application of moral norms. Second, it turns to a positive appropriation of the formal and proce dural aspects of discourse ethics. The goal is the elaboration of an ethics that is able to incorporate the material aspects of goods and the formal dimension of ethical validity and consensuability. Every morality is the formal application of some substantive good. Every ethical perspective demands its evaluation in terms of its uni versability. In order to achieve this mediation, it is suggested that we must incorporate not only the historical dimension of moral systems, but also the role of critical consciousness and the negativity embod ied by those who are victims of the existing consensus. The essay con cludes with six points that need to be considered when formulating a material ethics that is universalizable and, most importantly, that can address the massive poverty and dehumanization of those excluded from the present community of communication.},
  abstract_source = {openalex},
}

@article{dussel1997principles,
  author = {Dussel, Enrique},
  title = {Principles, Mediations, and the {``Good''} as Synthesis: From {``Discourse Ethics''} to {``Ethics of Liberation''}},
  journal = {Philosophy Today},
  year = {1997},
  volume = {41},
  number = {Supplement},
  pages = {55--66},
  doi = {10.5840/philtoday199741supplement62},
  note = {
CORE ARGUMENT: Dussel traces the progression from discourse ethics (Apel-Habermas) to ethics of liberation by arguing that the formal principle of intersubjective validity must be supplemented by a material principle (life as content) and a feasibility principle (institutional-strategic mediation). He explicitly marks where discourse ethics is insufficient as a standalone framework and positions his own ethics as going "beyond" it by incorporating the material dimension.

RELEVANCE: This shorter programmatic article provides a compressed statement of Dussel's relationship to Apel-Habermas discourse ethics and is directly engaged with the Apel dialogue of the same period. It is useful for reconstructing Dussel's own framing of the dialogue at its peak.

POSITION: Dussel's own characterization of his move beyond discourse ethics toward a materially grounded liberation ethics.
  },
  keywords = {Dussel, Apel, Habermas, discourse-ethics, ethics-of-liberation, primary-text, High, INCOMPLETE, no-abstract}
}

@article{hurtadolopez2012pensar,
  author = {Hurtado L{\'o}pez, F{\'a}tima},
  title = {Pensar filos{\'o}ficamente desde un horizonte mundial: el di{\'a}logo entre la {\'e}tica del discurso ({Apel}) y la {\'e}tica de la liberaci{\'o}n ({Dussel})},
  journal = {Pensamiento. Revista de Investigaci{\'o}n e Informaci{\'o}n Filos{\'o}fica},
  year = {2012},
  volume = {68},
  pages = {477--500},
  note = {
CORE ARGUMENT: Hurtado López reconstructs the Apel-Dussel dialogue as an attempt to think philosophically from a genuinely world-historical horizon, arguing that both thinkers agree on the need for a universal ethics but diverge on whether formal communicative procedures or material conditions of life provide its ultimate ground. The article maps the specific textual exchanges and traces points of genuine philosophical convergence and unresolved tension.

RELEVANCE: This is a focused reconstruction of the Apel-Dussel dialogue in Spanish-language secondary literature, examining the substantive philosophical stakes rather than merely summarizing positions. It directly addresses the question of what each interlocutor conceded and what remained contested.

POSITION: Argues for partial convergence between discourse ethics and liberation ethics, while maintaining that Dussel's material principle corrects a deficit in Apel's formalism.
  },
  keywords = {Apel, Dussel, discourse-ethics, ethics-of-liberation, North-South-dialogue, High, INCOMPLETE, no-abstract}
}

@article{zielinski2019etica,
  author = {Zielinski, Juan Mat{\'i}as},
  title = {La {\'E}tica del {Discurso} frente al desaf{\'i}o de la {\'E}tica de la {Liberaci{\'o}n}},
  year = {2019},
  note = {
CORE ARGUMENT: Zielinski reconstructs Apel's specific arguments and responses in his dialogue with Dussel's Ethics of Liberation. The article exposes the main features of discourse ethics as Apel articulated them in response to liberation-ethical objections, including his treatment of the North-South problem, his engagement with Marx, and the conflict between materiality and formality in contemporary ethical discourse.

RELEVANCE: This is one of the few secondary texts focused specifically on what Apel conceded or refused in the dialogue — covering the textual record from Apel's side. It is essential for answering the question of Apel's role as mediating figure and for understanding the asymmetry between Apel's and Habermas's direct engagements with Dussel.

POSITION: Reconstructs the Apel side of the dialogue, showing that Apel acknowledged asymmetries in the real communication community while defending the ideal community as a necessary regulative principle.
  },
  keywords = {Apel, Dussel, discourse-ethics, ethics-of-liberation, North-South-dialogue, Medium, INCOMPLETE, no-abstract}
}

@article{sorensen2010dussel,
  author = {S{\o}rensen, Asger},
  title = {Dussel's Critique of Discourse Ethics as Critique of Ideology},
  year = {2010},
  howpublished = {\url{https://pure.au.dk/portal/da/publications/dussels-critique-of-discourse-ethics-as-critique-of-ideology(7ef476a3-969c-446e-b658-a3ff875ba236).html}},
  note = {
CORE ARGUMENT: Sørensen reads Dussel's engagement with discourse ethics not as a dialogue between complementary traditions but as an ideological critique: the ideal communication community as Apel and Habermas formulate it functions ideologically by masking the actual asymmetries and exclusions of the existing capitalist world-system. Dussel's liberation ethics exposes discourse ethics as ideology by revealing its presupposition of conditions that do not obtain for the poor and excluded.

RELEVANCE: This article provides a sharper critical framing of the Dussel-Apel encounter than the "complementarity" narrative — it reconstructs the debate as an ideological confrontation rather than a cooperative refinement. This is directly relevant for the research project's interest in the nature and depth of Dussel's critique.

POSITION: Represents the critical-ideological reading of Dussel's challenge to discourse ethics, positioning liberation ethics as unmasking rather than supplementing formal communicative universalism.
  },
  keywords = {Dussel, Apel, discourse-ethics, ideology-critique, ethics-of-liberation, Medium, INCOMPLETE, no-abstract}
}

@article{riverasepulveda2013controversias,
  author = {Rivera Sep{\'u}lveda, {\'A}lvaro Andr{\'e}s},
  title = {Controversias sobre la fundamentaci{\'o}n de la moral: consideraciones desde {Kant}, {Apel} y {Dussel}},
  year = {2013},
  note = {
CORE ARGUMENT: Rivera Sepúlveda traces the debate over moral foundations across Kant, Apel, and Dussel, arguing that Dussel's key challenge to Apel concerns the latter's failure to account for the necessary conditions for implementing discourse ethics — specifically, the absence of an ethics with content and the assumption of an ideal communication community designed by and for the Enlightenment societies of the North while ignoring Latin American precarity.

RELEVANCE: The article directly reconstructs Dussel's specific objections to Apel (absence of a material ethics, assumption of real communicative symmetry, Eurocentrism of the ideal community) and contextualizes these within the broader tradition from Kant. It supports analysis of what Dussel "refused" in Apel's framework.

POSITION: Emphasizes the structural incompatibility between discourse ethics and the conditions of the Latin American poor as the crux of Dussel's critique.
  },
  keywords = {Apel, Dussel, Kant, discourse-ethics, ethics-of-liberation, moral-foundations, Medium, INCOMPLETE, no-abstract}
}

@article{vilchiscarlos2020etica,
  author = {Vilchis Carlos, Onofre},
  title = {{\'E}tica del discurso y {\'E}tica de la liberaci{\'o}n: un di{\'a}logo que permite reflexionar la situaci{\'o}n actual y global durante y despu{\'e}s de la pandemia},
  year = {2020},
  note = {
CORE ARGUMENT: Vilchis Carlos reconstructs the Apel-Dussel dialogue by examining Dussel's direct texts engaging Apel — specifically "The Introduction of the Transformation of the Philosophy of K.O. Apel and the Philosophy of Liberation" and "The Reason of the Other" — to expose the material criterion of life as the central Dusselian addition to discourse ethics. The article clarifies Dussel's distinction between validity and truth as complementary moments, with truth tied to the affirmation of human life.

RELEVANCE: This article provides close textual engagement with the documents in which Dussel argues directly against and with Apel, making it useful for reconstructing the chronology and substance of the dialogue at the level of specific argumentative moves.

POSITION: Presents the Apel-Dussel dialogue as productive complementarity in which Dussel's material criterion of life supplements but does not simply replace discourse ethics.
  },
  keywords = {Apel, Dussel, discourse-ethics, ethics-of-liberation, material-principle, Medium, INCOMPLETE, no-abstract}
}

@article{roldan2015otro,
  author = {Rold{\'a}n, David A.},
  title = {El otro-concreto en la constituci{\'o}n de la subjetividad {\'e}tica: {Enrique Dussel}, la {\'e}tica del discurso y el comunitarianismo},
  year = {2015},
  note = {
CORE ARGUMENT: Roldán examines how Dussel constructs a theory of ethical subjectivity around the "concrete Other" through critical mediation of discourse ethics (Apel, Habermas) and communitarianism (MacIntyre, Taylor). From discourse ethics Dussel assimilates universality; from communitarianism, the demand for a material ethics of content. He critiques the formalism of discourse ethics while rejecting communitarian relativism — a dual appropriation that defines his dialogue with both traditions.

RELEVANCE: The article specifically reconstructs what Dussel took from Apel and Habermas and what he refused — a precise reconstruction of the "concessions and refusals" that the research project asks about. It also situates the Apel-Habermas interlocution within Dussel's broader engagements.

POSITION: Documents Dussel's partial reception and partial critique of discourse ethics as part of a threefold engagement (liberation ethics, discourse ethics, communitarianism).
  },
  keywords = {Dussel, Apel, Habermas, discourse-ethics, communitarianism, ethical-subjectivity, Medium, INCOMPLETE, no-abstract}
}

@article{rodrigezreyes2024dialogos,
  author = {Rodr{\'i}guez Reyes, Abdiel},
  title = {Di{\'a}logos interculturales entre la {\'e}tica de la liberaci{\'o}n y la {\'e}tica del discurso},
  year = {2024},
  doi = {10.5281/zenodo.12696730},
  note = {
CORE ARGUMENT: Written as a tribute to Dussel, this article reflects on the North-South intercultural dialogues — specifically the exchange between Apel's discourse ethics and Dussel's liberation ethics — as a model for philosophical dialogue across asymmetric geopolitical positions. Rodríguez Reyes emphasizes the relationship as one of genuine mutual engagement across cultural and political difference.

RELEVANCE: As a recent (2024) reflection on the historical Apel-Dussel dialogue, this article provides contemporary scholarly reception of the exchange and situates it within ongoing debates about intercultural philosophy and South-South/North-South dialogue. It updates the historiography of the encounter.

POSITION: Presents the Apel-Dussel exchange as a paradigm case of intercultural North-South dialogue in philosophy.
  },
  keywords = {Apel, Dussel, discourse-ethics, ethics-of-liberation, intercultural-dialogue, Low},
  abstract = {En ocasión de homenajear al maestro Enrique Dussel, hacemos una reflexión en torno a los diálogos interculturales Norte-Sur en particular, entre la ética del discurso propuesta por el gran filósofo alemán Karl Otto-Apel y, la ética de la liberación, desarrollada por Dussel.},
  abstract_source = {openalex},
}

@article{demenchonokhk2012rethinking,
  author = {Demench{\'o}nok, Edward},
  title = {Rethinking {Kant}'s Concept of Human Rights as Freedom},
  journal = {Filosofia Unisinos},
  year = {2012},
  volume = {13},
  number = {2 - suppl.},
  doi = {10.4013/fsu.2012.132(suppl).09},
  note = {
CORE ARGUMENT: Demenchónok examines debates over grounding human rights in a pluralistic world, analyzing discourse ethics (Apel, Habermas) alongside Dussel's liberation ethics as distinct but related responses to Kant's universalism. The article distinguishes what each tradition preserves and transforms from Kant, and explicitly places Apel, Habermas, and Dussel in triangular relationship around the question of human rights foundations.

RELEVANCE: One of the few secondary texts that discusses all three interlocutors — Apel, Habermas, and Dussel — in direct comparison, making it useful for tracing the exact points where Dussel diverges from or aligns with each. Supports analysis of Apel as the mediating figure between the Kantian-Habermasian tradition and Dussel's liberation ethics.

POSITION: Treats discourse ethics and liberation ethics as complementary responses to Kantian universalism, with Dussel providing the material and geopolitical supplement to Apel and Habermas.
  },
  keywords = {Apel, Habermas, Dussel, Kant, discourse-ethics, human-rights, Medium},
  abstract = {The paper examines the current debates regarding the grounding of human rights in a pluralistic, culturally diverse world. It analyses the challenges which come today from certain policies of human rights which instrumentalize them under the pretext of a “global war on terror” and redefi ne them in terms of democracy promotion and regime change, as well as those challenges which come from ideologies which question the core principles of human rights and provoke the so called “crisis of legitimization.” The paper argues for the necessity of restoring the genuine meaning of human rights and of the role of citizens in striving for their implementation. At the heart of the analysis is Kant’s concept of human rights as freedom. With Kant as its backdrop, the paper shows that the claim that religious worldviews provide the only intelligible foundation, as in Nicholas Wolterstorff, faces serious challenges in a pluralistic, culturally diverse world. The paper then analyzes the non-religious philosophical concepts which seek to develop an account of human rights that does not depend upon controversial metaphysical or religious doctrines. It examines an account of human rights from the perspective of discourse ethics as developed by Karl-Otto Apel and Jurgen Habermas. It also analyses the concepts of human dignity and “emerging morality” by Arturo Roig and the “ethics of liberation” by Enrique Dussel. The analysis shows the ongoing relevance of Kant’s ideas and their recent development by the theorists of discourse ethics and of dialogical and democratic cosmopolitanism. O texto examina os debates atuais a respeito da fundamentacao dos direitos humanos em um mundo pluralista e culturalmente diversifi cado. Analisa os desafi os que surgem atualmente de certas politicas de direitos humanos que os instrumentalizam sob o pretexto de uma “guerra global contra o terror” e os redefi ne em termos de promocao da democracia e regime de mudanca, assim como aqueles desafi os que surgem de ideologias que questionam os principios basicos dos direitos humanos e provocam a assim chamada “crise de legitimacao”. O texto argumenta pela necessidade de restaurar o signifi cado genuino de direitos humanos e do papel dos cidadaos em lutar por sua imple},
  abstract_source = {s2},
}

@article{curcocobos2015response,
  author = {Cobos, Felipe Curc{\'o}},
  title = {Latin American Political Thought as a Response to Discourse Ethics},
  journal = {Latin American Research Review},
  year = {2015},
  volume = {50},
  number = {4},
  pages = {69--87},
  doi = {10.1353/lar.2015.0052},
  note = {
CORE ARGUMENT: Curcó Cobos examines Latin American political philosophy — including Dussel's Ethics of Liberation — as a structural response to the discourse ethics tradition (Apel, Habermas). He argues that the Latin American tradition develops systematic critiques of discourse ethics' proceduralism by insisting on the embodied, historically situated, and materially conditioned character of political life, and that this constitutes a coherent alternative to the Northern paradigm.

RELEVANCE: Situates Dussel's engagement with Apel and Habermas within the broader pattern of Latin American philosophical response to discourse ethics, providing context for the Dussel-specific exchange. Useful for the research project's interest in how the dialogue was received in Latin American philosophy.

POSITION: Reads Latin American political philosophy, including Dussel, as constituting a coherent tradition of critique aimed specifically at the proceduralist assumptions of discourse ethics.
  },
  keywords = {Dussel, Apel, Habermas, discourse-ethics, Latin-American-philosophy, political-thought, Low},
  abstract = {This article offers an articulation of liberation philosophy, a Latin American form of political and philosophical thought that is largely not followed in European and Anglo-American political circles. Liberation philosophy has posed serious challenges to Jürgen Habermas’s and Karl-Otto Apel’s discourse ethics. Here I explain what these challenges consist of and argue that Apel’s response to Latin American political thought shows that discourse ethics can maintain internal consistency only if it is subsumed under the program of liberation philosophy.},
  abstract_source = {openalex},
}
