    {
      "openalex_id": "W4393080191",
      "doi": "10.4324/9781032705712",
      "title": "Endangered African Knowledges and the Challenge of Modernity",
      "authors": [
        {
          "name": "Donald Mark C. Ude",
          "openalex_id": "A5043209399",
