      "openalex_id": "W113225338",
      "doi": "10.5860/choice.192154",
      "title": "Prophetic visions of the past: pan-Caribbean representations of the Haitian Revolution",
      "authors": [
        {
          "name": "V\u00edctor Figueroa",
          "openalex_id": "A5055469363",
