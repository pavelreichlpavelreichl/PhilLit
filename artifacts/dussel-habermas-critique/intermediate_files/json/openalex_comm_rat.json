    {
      "openalex_id": "W2042057419",
      "doi": "10.4013/fsu.2012.132(suppl).09",
      "title": "Rethinking Kant\u2019s Concept of Human Rights as Freedom",
      "authors": [
        {
          "name": "Edward Demench\u00f3nok",
          "openalex_id": "A5084498250",
