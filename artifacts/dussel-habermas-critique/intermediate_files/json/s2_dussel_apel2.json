      "paperId": "0e598cb4a62ded17338011c7ff6aaa7b86000506",
      "title": "THE UNDERSIDE OF TECHNOLOGY: LIFECYCLES OF LIBERACI\u00d3N IN THE DIGITAL AGE",
      "authors": [
        {
          "name": "Carrie O'Connell",
          "authorId": "2309293830"
        },
        {
          "name": "Chad Thomas Van De Wiele",
          "authorId": "1755168757"
        },
        {
          "name": "Melina Garcia",
          "authorId": "2110689358"
        },
        {
          "name": "Michele Ferris Dobles",
          "authorId": "2238574369"
        },
