    {
      "paperId": "5e9d617ee23bb05d508e595e7464dcf8e7d89f86",
      "title": "Twenty Theses on Politics",
      "authors": [
        {
          "name": "Enrique Dussel",
          "authorId": "86952522"
        },
        {
          "name": "George Ciccariello-Maher",
