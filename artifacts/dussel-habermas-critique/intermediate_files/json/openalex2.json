      "title": "Loving the Many in the One: Augustine and the Love of Finite Goods",
      "authors": [
        {
          "name": "J. Warren Smith",
          "openalex_id": "A5100624156",
          "orcid": "https://orcid.org/0000-0001-7344-3054",
