      "title": "Social and Biological Context of Physical Culture and Sport",
      "authors": [
        {
          "name": "Jerzy Kosiewicz",
          "openalex_id": "A5020797545",
          "institutions": [
            "J\u00f3zef Pi\u0142sudski University of Physical Education in Warsaw"
