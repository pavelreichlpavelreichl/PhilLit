    {
      "openalex_id": "W7111592391",
      "doi": null,
      "title": "Political transformation in Enrique Dussel and the new right to liberation: In Memoriam",
      "authors": [
        {
          "name": "Pach\u00f3n Soto, Dami\u00e1n",
          "openalex_id": ""
