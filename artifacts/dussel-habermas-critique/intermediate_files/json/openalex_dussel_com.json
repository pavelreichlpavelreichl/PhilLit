    {
      "openalex_id": "W4415850960",
      "doi": "10.1177/0094582x251389502",
      "title": "Transmodern Geographies and Coloniality: On Enrique Dussel\u2019s Pluriversal Modernity",
      "authors": [
        {
          "name": "Don Thomas Deere",
          "openalex_id": "A5098810833"
