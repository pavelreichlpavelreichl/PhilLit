  note = {
CORE ARGUMENT: Rivera Sepúlveda traces the debate over moral foundations across Kant, Apel, and Dussel, arguing that Dussel's key challenge to Apel concerns the latter's failure to account for the necessary conditions for implementing discourse ethics — specifically, the absence of an ethics with content and the assumption of an ideal communication community designed by and for the Enlightenment societies of the North while ignoring Latin American precarity.

RELEVANCE: The article directly reconstructs Dussel's specific objections to Apel (absence of a material ethics, assumption of real communicative symmetry, Eurocentrism of the ideal community) and contextualizes these within the broader tradition from Kant. It supports analysis of what Dussel "refused" in Apel's framework.

POSITION: Emphasizes the structural incompatibility between discourse ethics and the conditions of the Latin American poor as the crux of Dussel's critique.
  },
  keywords = {Apel, Dussel, Kant, discourse-ethics, ethics-of-liberation, moral-foundations, Medium, INCOMPLETE, no-abstract}
}

@article{vilchiscarlos2020etica,
  author = {Vilchis Carlos, Onofre},
  title = {{\'E}tica del discurso y {\'E}tica de la liberaci{\'o}n: un di{\'a}logo que permite reflexionar la situaci{\'o}n actual y global durante y despu{\'e}s de la pandemia},
  year = {2020},
  note = {
CORE ARGUMENT: Vilchis Carlos reconstructs the Apel-Dussel dialogue by examining Dussel's direct texts engaging Apel — specifically "The Introduction of the Transformation of the Philosophy of K.O. Apel and the Philosophy of Liberation" and "The Reason of the Other" — to expose the material criterion of life as the central Dusselian addition to discourse ethics. The article clarifies Dussel's distinction between validity and truth as complementary moments, with truth tied to the affirmation of human life.

RELEVANCE: This article provides close textual engagement with the documents in which Dussel argues directly against and with Apel, making it useful for reconstructing the chronology and substance of the dialogue at the level of specific argumentative moves.

POSITION: Presents the Apel-Dussel dialogue as productive complementarity in which Dussel's material criterion of life supplements but does not simply replace discourse ethics.
  },
  keywords = {Apel, Dussel, discourse-ethics, ethics-of-liberation, material-principle, Medium, INCOMPLETE, no-abstract}
}

@article{roldan2015otro,
  author = {Rold{\'a}n, David A.},
  title = {El otro-concreto en la constituci{\'o}n de la subjetividad {\'e}tica: {Enrique Dussel}, la {\'e}tica del discurso y el comunitarianismo},
  year = {2015},
  note = {
CORE ARGUMENT: Roldán examines how Dussel constructs a theory of ethical subjectivity around the "concrete Other" through critical mediation of discourse ethics (Apel, Habermas) and communitarianism (MacIntyre, Taylor). From discourse ethics Dussel assimilates universality; from communitarianism, the demand for a material ethics of content. He critiques the formalism of discourse ethics while rejecting communitarian relativism — a dual appropriation that defines his dialogue with both traditions.

RELEVANCE: The article specifically reconstructs what Dussel took from Apel and Habermas and what he refused — a precise reconstruction of the "concessions and refusals" that the research project asks about. It also situates the Apel-Habermas interlocution within Dussel's broader engagements.

POSITION: Documents Dussel's partial reception and partial critique of discourse ethics as part of a threefold engagement (liberation ethics, discourse ethics, communitarianism).
  },
  keywords = {Dussel, Apel, Habermas, discourse-ethics, communitarianism, ethical-subjectivity, Medium, INCOMPLETE, no-abstract}
}

@article{rodrigezreyes2024dialogos,
  author = {Rodr{\'i}guez Reyes, Abdiel},
  title = {Di{\'a}logos interculturales entre la {\'e}tica de la liberaci{\'o}n y la {\'e}tica del discurso},
  year = {2024},
  doi = {10.5281/zenodo.12696730},
  note = {
CORE ARGUMENT: Written as a tribute to Dussel, this article reflects on the North-South intercultural dialogues — specifically the exchange between Apel's discourse ethics and Dussel's liberation ethics — as a model for philosophical dialogue across asymmetric geopolitical positions. Rodríguez Reyes emphasizes the relationship as one of genuine mutual engagement across cultural and political difference.

RELEVANCE: As a recent (2024) reflection on the historical Apel-Dussel dialogue, this article provides contemporary scholarly reception of the exchange and situates it within ongoing debates about intercultural philosophy and South-South/North-South dialogue. It updates the historiography of the encounter.

POSITION: Presents the Apel-Dussel exchange as a paradigm case of intercultural North-South dialogue in philosophy.
  },
  keywords = {Apel, Dussel, discourse-ethics, ethics-of-liberation, intercultural-dialogue, Low},
  abstract = {En ocasión de homenajear al maestro Enrique Dussel, hacemos una reflexión en torno a los diálogos interculturales Norte-Sur en particular, entre la ética del discurso propuesta por el gran filósofo alemán Karl Otto-Apel y, la ética de la liberación, desarrollada por Dussel.},
  abstract_source = {openalex},
}

@article{demenchonokhk2012rethinking,
  author = {Demench{\'o}nok, Edward},
  title = {Rethinking {Kant}'s Concept of Human Rights as Freedom},
  journal = {Filosofia Unisinos},
  year = {2012},
  volume = {13},
  number = {2 - suppl.},
  doi = {10.4013/fsu.2012.132(suppl).09},
  note = {
CORE ARGUMENT: Demenchónok examines debates over grounding human rights in a pluralistic world, analyzing discourse ethics (Apel, Habermas) alongside Dussel's liberation ethics as distinct but related responses to Kant's universalism. The article distinguishes what each tradition preserves and transforms from Kant, and explicitly places Apel, Habermas, and Dussel in triangular relationship around the question of human rights foundations.

RELEVANCE: One of the few secondary texts that discusses all three interlocutors — Apel, Habermas, and Dussel — in direct comparison, making it useful for tracing the exact points where Dussel diverges from or aligns with each. Supports analysis of Apel as the mediating figure between the Kantian-Habermasian tradition and Dussel's liberation ethics.

POSITION: Treats discourse ethics and liberation ethics as complementary responses to Kantian universalism, with Dussel providing the material and geopolitical supplement to Apel and Habermas.
  },
  keywords = {Apel, Habermas, Dussel, Kant, discourse-ethics, human-rights, Medium},
  abstract = {The paper examines the current debates regarding the grounding of human rights in a pluralistic, culturally diverse world. It analyses the challenges which come today from certain policies of human rights which instrumentalize them under the pretext of a “global war on terror” and redefi ne them in terms of democracy promotion and regime change, as well as those challenges which come from ideologies which question the core principles of human rights and provoke the so called “crisis of legitimization.” The paper argues for the necessity of restoring the genuine meaning of human rights and of the role of citizens in striving for their implementation. At the heart of the analysis is Kant’s concept of human rights as freedom. With Kant as its backdrop, the paper shows that the claim that religious worldviews provide the only intelligible foundation, as in Nicholas Wolterstorff, faces serious challenges in a pluralistic, culturally diverse world. The paper then analyzes the non-religious philosophical concepts which seek to develop an account of human rights that does not depend upon controversial metaphysical or religious doctrines. It examines an account of human rights from the perspective of discourse ethics as developed by Karl-Otto Apel and Jurgen Habermas. It also analyses the concepts of human dignity and “emerging morality” by Arturo Roig and the “ethics of liberation” by Enrique Dussel. The analysis shows the ongoing relevance of Kant’s ideas and their recent development by the theorists of discourse ethics and of dialogical and democratic cosmopolitanism. O texto examina os debates atuais a respeito da fundamentacao dos direitos humanos em um mundo pluralista e culturalmente diversifi cado. Analisa os desafi os que surgem atualmente de certas politicas de direitos humanos que os instrumentalizam sob o pretexto de uma “guerra global contra o terror” e os redefi ne em termos de promocao da democracia e regime de mudanca, assim como aqueles desafi os que surgem de ideologias que questionam os principios basicos dos direitos humanos e provocam a assim chamada “crise de legitimacao”. O texto argumenta pela necessidade de restaurar o signifi cado genuino de direitos humanos e do papel dos cidadaos em lutar por sua imple},
  abstract_source = {s2},
}

@article{apel1996discourse,
  author = {Apel, Karl-Otto and Mendieta, Eduardo},
  title = {{`Discourse ethics' before the challenge of `liberation philosophy'}},
  journal = {Philosophy \& Social Criticism},
  year = {1996},
  volume = {22},
  number = {2},
  pages = {1--25},
  doi = {10.1177/019145379602200201},
  note = {
  CORE ARGUMENT: Apel's interview-based response to Dussel's critique distinguishes between Part A (the grounding of discourse ethics in transcendental pragmatics) and Part B (the application of discourse ethics to historical-material conditions). Apel argues that liberation philosophy misreads discourse ethics by treating the ideal speech situation as a sociological description of real communicative communities rather than a counterfactual normative standard; Part B of discourse ethics, he contends, can and must address the asymmetrical material conditions of global capitalism and the situation of excluded victims.

  RELEVANCE: This is the primary philosophical response from within the discourse ethics tradition to Dussel's challenge, and Mendieta's editorial framing contextualizes the exchange for English-speaking readers. It directly addresses the question of whether ideal speech situation symmetry is blind to exclusion, or whether it is a standard against which exclusion can be criticized.

  POSITION: Discourse ethics response: the ideal/real distinction vindicates discourse ethics against the charge that it legitimizes existing exclusions.
  },
  keywords = {discourse-ethics, Apel, liberation-ethics, ideal-speech-situation, exclusion, High},
  abstract = {Mesurant la contribution d'E. Dussel au dialogue concernant la relation entre l'ethique du discours et la philosophie de la liberation, l'A. confronte la conception d'une economie transcendantale, developpee par Dussel, a sa propre conception realiste des rapports conflictuels entre le Nord et le Sud},
  abstract_source = {openalex},
}

@article{mendieta1995discourse,
  author = {Mendieta, Eduardo},
  title = {Discourse ethics and liberation ethics},
  journal = {Philosophy \& Social Criticism},
  year = {1995},
  volume = {21},
  number = {4},
  pages = {111--126},
  doi = {10.1177/019145379502100406},
  note = {
  CORE ARGUMENT: Mendieta argues that discourse ethics (Habermas and Apel) and liberation ethics (Dussel) are not fundamentally opposed but rather address complementary aspects of a complete moral theory. Discourse ethics provides formal criteria for validity; liberation ethics supplies the material criterion of the dignity of life and the obligation to the Other who calls from outside the existing communication community. The two ethics need each other: discourse ethics lacks the material principle and the perspective of the excluded, while liberation ethics lacks formal universalizability criteria.

  RELEVANCE: This early mediating essay by the major translator and interpreter of both traditions offers a complementarity thesis that subsequent scholarship has had to either affirm or contest. It is foundational for mapping the scholarly positions.

  POSITION: Complementarity thesis: discourse ethics and liberation ethics as jointly necessary components of a complete moral theory.
  },
  keywords = {discourse-ethics, liberation-ethics, Mendieta, complementarity, Habermas, Dussel, High},
  abstract = {L'A. souligne la complementarite de l'ethique du discours de Apel et de l'ethique de la liberation de Dussel, en ce sens qu'ils redefinissent et rearticulent les frontieres entre les notions du soi, de societe (monde) et de transcendance (Dieu). Tous deux ouvrent la voie a une nouvelle theorie morale en insistant a leur maniere sur les frontieres du discours philosophique},
  abstract_source = {openalex},
}

@incollection{schelkshorn2018discourse,
  author = {Schelkshorn, Hans},
  title = {Discourse and liberation: the claims and contexts of two types of universalistic ethics},
  booktitle = {A Matter of Discourse},
  editor = {Nascimento, Am{\'o}s},
  publisher = {Routledge},
  year = {2018},
  pages = {197--218},
  doi = {10.4324/9780429464683-9},
  note = {
  CORE ARGUMENT: Schelkshorn undertakes a systematic comparison of discourse ethics and ethics of liberation as two distinct forms of universalistic moral theory. He argues that both traditions share a commitment to universalism but ground it differently: discourse ethics in the formal-pragmatic presuppositions of argumentation, liberation ethics in the material principle of the reproduction of life and the ethical primacy of the victim. Schelkshorn argues that the two ethics are not simply complementary but represent different theoretical and contextual starting points, with liberation ethics arising from and oriented toward the perspective of marginalized communities in the Global South.

  RELEVANCE: This chapter provides one of the most carefully reconstructed comparative analyses available in English, directly addressing the formal-material distinction and the contextual embeddedness of each position.

  POSITION: Contextual differentiation: discourse ethics and liberation ethics as responding to different historical and geopolitical situations, not merely formally complementary.
  },
  keywords = {discourse-ethics, liberation-ethics, Schelkshorn, universalism, formal-material, High},
  abstract = {Discourse ethics continues the European tradition of universal morality at a purified level; it integrates critically the two waves of Enlightenment European history has crossed. The basic principle of discourse ethics is related to the rational adjudication between conflicting interests and claims. Discourse ethics reconstructs and grounds the moral intuition of universal justice with reference to a consciousness of the fallibilistic status of scientific theories and the experience of cultural relativism. Discourse ethics responds to Enrique Dussel’s problem through its demand for practical discourses, where all concerned should solve consensually their conflicting claims and interests. Discourse ethics and the ethics of liberation share the intention to overcome monological universalization through real interactions. The material implications of discourse ethics are immediately obvious under totalitarian conditions. Discourse ethics and liberation ethics try to reconstruct the anticipations which are included in moral intuitions.},
  abstract_source = {openalex},
}

@book{mills2018dussel,
  author = {Mills, Frederick B.},
  title = {Enrique {Dussel's} {Ethics} of {Liberation}: {An} {Introduction}},
  publisher = {Springer International Publishing},
  year = {2018},
  doi = {10.1007/978-3-319-94550-7},
  note = {
  CORE ARGUMENT: Mills provides a systematic introduction to Dussel's ethics of liberation, tracing its development across Dussel's major works and situating it in relation to Levinas, Marx, Apel, and Habermas. The book reconstructs Dussel's three material, formal, and feasibility principles and shows how the critique of discourse ethics fits within the larger architectonic of his liberation ethics.

  RELEVANCE: As an accessible secondary overview, Mills's book is important for the synthesis phase as it contextualizes Dussel's specific critiques of Habermas within his broader philosophical project. It also discusses how Dussel's integration of discourse-ethics elements (the formal-discursive principle) complicates simple opposition between the two thinkers.

  POSITION: Expository and interpretive introduction, broadly sympathetic to Dussel's project.
  },
  keywords = {Dussel, liberation ethics, introduction, Habermas, Apel, High, INCOMPLETE, no-abstract}
}

@article{saenz2017life,
  author = {S{\'a}enz, Mario},
  title = {Life and Ethics: On {Dussel}'s Ethics of Liberation},
  journal = {The Journal of Religion},
  year = {2017},
  volume = {97},
  number = {2},
  pages = {244--258},
  doi = {10.1086/690480},
  note = {
  CORE ARGUMENT: Saenz examines the role of life -- biological and social reproduction -- as the material foundation of Dussel's ethics of liberation, arguing that this life-centered materialism distinguishes Dussel sharply from both Kantian formalism and Habermasian proceduralism. He argues that Dussel's ethics is not merely a supplement to discourse ethics but a fundamental reconception of the conditions under which ethics is possible, grounded in the bodily reality of those rendered victims by the prevailing system.

  RELEVANCE: Provides a scholarly assessment of the material-life criterion as the central differentiating factor between liberation ethics and discourse ethics, contributing to the question of whether the positions are complementary or incompatible.

  POSITION: Dussel's life-materialism as constituting a genuinely different ethical orientation from Habermasian proceduralism.
  },
  keywords = {liberation-ethics, material-ethics, life, Dussel, Habermas, Saenz, Medium, INCOMPLETE, no-abstract}
}

@article{dallmayr2004underside,
  author = {Dallmayr, Fred},
  title = {The Underside of Modernity: {Adorno}, {Heidegger}, and {Dussel}},
  journal = {Constellations},
  year = {2004},
  volume = {11},
  number = {1},
  pages = {102--120},
  doi = {10.1111/j.1351-0487.2004.00365.x},
  note = {
  CORE ARGUMENT: Dallmayr places Dussel's philosophy of liberation in comparative dialogue with Adorno's negative dialectics and Heidegger's critique of modernity, arguing that all three think from the "underside" of Eurocentric reason. He argues that Dussel's engagement with Habermasian communicative reason is best understood as a critique of modernity's exclusionary underside: the communicative ideal occludes what Adorno called non-identity and what Dussel calls the exteriority of the Other.

  RELEVANCE: Situates Dussel's critique of Habermasian discourse ethics within broader Frankfurt School debates, providing a comparative framework that is directly relevant to understanding the relationship between liberation ethics and critical theory.

  POSITION: Positions Dussel's critique of Habermas as part of a broader tradition of critiquing Western modernity's exclusions from within and from without.
  },
  keywords = {Dussel, Adorno, Heidegger, modernity, Dallmayr, critical-theory, Habermas, Medium, INCOMPLETE, no-abstract}
}

@article{cobos2015latin,
  author = {Cobos, Felipe Curc{\'o}},
  title = {Latin American Political Thought as a Response to Discourse Ethics},
  journal = {Latin American Research Review},
  year = {2015},
  volume = {50},
  number = {4},
  pages = {69--87},
  doi = {10.1353/lar.2015.0052},
  note = {
  CORE ARGUMENT: Cobos examines how Latin American political thought -- including Dussel's ethics of liberation -- constitutes a distinctive response to the Habermasian and Apelian discourse ethics tradition. He argues that Latin American philosophers, drawing on the experience of colonial exclusion, developed a critique of discourse ethics' implicit Eurocentrism and its failure to account for the material conditions that prevent genuine communicative symmetry. The paper situates this response within Latin American intellectual history.

  RELEVANCE: Provides a scholarly contextualization of Dussel's engagement with discourse ethics within the broader intellectual history of Latin American political philosophy, relevant to understanding the stakes and reception of the debate.

  POSITION: Latin American political thought as offering a systematic and regionally grounded response to Eurocentric discourse ethics.
  },
  keywords = {Latin-American-philosophy, discourse-ethics, liberation-ethics, Cobos, Dussel, Habermas, Medium},
  abstract = {This article offers an articulation of liberation philosophy, a Latin American form of political and philosophical thought that is largely not followed in European and Anglo-American political circles. Liberation philosophy has posed serious challenges to Jürgen Habermas’s and Karl-Otto Apel’s discourse ethics. Here I explain what these challenges consist of and argue that Apel’s response to Latin American political thought shows that discourse ethics can maintain internal consistency only if it is subsumed under the program of liberation philosophy.},
  abstract_source = {openalex},
}

@misc{sorensen2011dussel,
  author = {S{\o}rensen, Asger},
  title = {{Dussel's Critique of Discourse Ethics as Critique of Ideology}},
  year = {2011},
  howpublished = {Public Reason, vol.~2, no.~2, pp.~84--101},
  note = {
  CORE ARGUMENT: Sorensen argues that Dussel's critique of Habermasian discourse ethics is best understood as a critique of ideology: the ideal speech situation functions ideologically by naturalizing the exclusion of those who cannot enter the communicative community on equal terms. By grounding moral validity in actual argumentative symmetry among existing participants, discourse ethics implicitly validates the inequalities that prevent the poor and colonized from participating as equals. Dussel's counter-move -- grounding ethics in the materiality of excluded victims -- is thus a form of ideology critique applied to moral philosophy itself.

  RELEVANCE: This paper provides an ideological-critique reading of the Dussel-Habermas relationship that connects liberation ethics to the Frankfurt School's broader project, directly relevant to the question of whether Dussel's critique is a supplementation or a fundamental challenge.

  POSITION: Dussel's critique as ideology critique: discourse ethics as legitimating exclusion, liberation ethics as exposing this ideological function.
  },
  keywords = {Sorensen, discourse-ethics, liberation-ethics, ideology-critique, Dussel, Habermas, web-source, Low, INCOMPLETE, no-abstract}
}

@article{maldonadotorres2011liberation,
  author = {Maldonado-Torres, Nelson},
  title = {Enrique Dussel's Liberation Thought in the Decolonial Turn},
  journal = {TRANSMODERNITY},
  year = {2011},
  volume = {1},
  number = {1},
  doi = {10.5070/t411000003},
  note = {
  CORE ARGUMENT: Maldonado-Torres situates Dussel's philosophy of liberation as a foundational
  moment in the broader "decolonial turn," distinguishing it from postcolonial theory and
  from Habermasian critical theory. He argues that Dussel's decisive contribution is to
  treat colonialism not as an external context but as constitutive of modernity's rationality
  itself — thereby making the decolonial critique a critique of modernity's self-understanding,
  not merely its applications. The essay traces how Dussel's analectic method, developed through
  Levinas's alterity, enables a position that neither accepts Habermas's unfinished-project
  framing nor retreats into postmodern relativism.

  RELEVANCE: Provides the clearest English-language account of how Dussel's modernity critique
  departs from Habermas at the level of philosophy of history — specifically the claim that
  Habermas's intra-European genealogy cannot generate the resources to critique the "irrational
  myth" of colonial modernity. Essential for the research project's framing of the Dussel-Habermas
  opposition.

  POSITION: Decolonial framing of Dussel's departure from Frankfurt School critical theory.
  },
  keywords = {transmodernity, decolonial-turn, modernity-critique, Frankfurt-School, High},
  abstract = {Liberation philosophy, as a Latin American project for critical thought, is one among many expressions of a shift in global power dynamics and in epistemic perspective that has taken place since the Second World War.* The European crisis, or more than a crisis, its own internal devastation after the war, opened at least three paths for the train of history and thought. On the one hand, the United States -which had proven itself as an international power through the expansion from the thirteen colonies, the war with Mexico, and the Spanish-American War -became after the Second World War a hegemonic force that would both assist and displace Northwestern Europe as the power-axis of the modern world-system. With this, Americanism -the triumphalist and assimilationist ideology of the United States which had already burst onto the scene with Theodore Roosevelt in the late nineteenth century -was decisively introduced to the rest of the world. This Americanist discourse would dictate the terms for the assimilation of non-Catholic European immigrants, some of which were seen as belonging to darker races. 1 This ideology has taken various turns with McCarthyism and Reagan in the context of the Cold War, and today it takes on a new spirit in formulations like that offered by Samuel P. Huntington, who has forcefully rearticulated Americanism with respect to immigrants and ethnic minorities in the United States. 2 But today, after the Cold War and the attacks of 11 September, it is no longer European immigrants that allegedly pose a "challenge" to U.S.-American identity, but rather Latin American (im)migrants, particularly Spanish-speaking Mexicans and Chicana/os. 3 There is, accordingly, a particular importance today for exploring the decolonial potential of those cultural forms originating in Latin America, Mexico, and in the borderlands between Mexico and the United States, among other "frontier" territories both to the north and south of this border. e second path that opened with the decline of Europe was, clearly, that of the Cold War rival of Americanism: Soviet communism. Soviet communism, or at least socialism (which is a different but related political system/ideology), would become for many a viable option for a different future, beyond both fascist and liberal Europe.},
  abstract_source = {openalex},
}

@incollection{maldonadotorres2008decolonial,
  author = {Maldonado-Torres, Nelson},
  title = {Enrique Dussel's Contribution to the De-colonial Turn},
  booktitle = {Against War: Views from the Underside of Modernity},
  year = {2008},
  pages = {187--236},
  publisher = {Duke University Press},
  doi = {10.1215/9780822388999-010},
  note = {
  CORE ARGUMENT: Maldonado-Torres reconstructs Dussel's intellectual trajectory from
  his early phenomenological work on Latin American otherness through his development
  of the 1492 thesis and transmodernity. The chapter argues that Dussel's most original
  contribution to the decolonial turn is his insistence that modernity's "underside"
  (the colonial encounter, the sacrificed victims of the "myth of modernity") is not
  peripheral but generative: colonialism produced both the material conditions and the
  philosophical self-image of Eurocentric modernity. This directly challenges Habermas's
  account in "The Philosophical Discourse of Modernity," which Maldonado-Torres reads
  as symptomatically Eurocentric in its genealogy.

  RELEVANCE: Offers the most detailed secondary treatment of Dussel's 1492 thesis as a
  critique of Habermasian philosophical historiography, and establishes why transmodernity
  is positioned as an alternative to Habermas's "unfinished project" rather than simply
  a supplement to it.

  POSITION: Reconstructive account of Dussel's decolonial contribution, situated against
  both postmodernism and Habermasian modernity completion.
  },
  keywords = {decolonial-turn, 1492-thesis, modernity-underside, Habermas-critique, High, INCOMPLETE, no-abstract}
}

@article{grosfoguel2011decolonizing,
  author = {Grosfoguel, Ram{\'o}n},
  title = {Decolonizing Post-Colonial Studies and Paradigms of Political-Economy: Transmodernity, Decolonial Thinking, and Global Coloniality},
  journal = {TRANSMODERNITY},
  year = {2011},
  volume = {1},
  number = {1},
  doi = {10.5070/t411000004},
  note = {
  CORE ARGUMENT: Grosfoguel argues that transmodernity as formulated by Dussel provides
  a framework that goes beyond both postcolonial studies (which remain within the epistemic
  assumptions of European modernity) and world-systems theory (which lacks an epistemic
  critique). He contends that Habermasian communicative rationality and its claims to
  universal validity are products of a particular locus of enunciation — the European
  "ego cogito" rooted in the "ego conquiro" of colonial violence — and cannot serve as
  the basis for cross-cultural validity claims without reproducing coloniality.

  RELEVANCE: Provides the world-systems theoretical context for Dussel's transmodernity,
  showing how it reconfigures the debate between Habermasian modernity and its critics.
  The paper makes explicit the connection between Quijano's coloniality of power and
  Dussel's transmodern framework, which the research project needs for the philosophy of
  history dimension.

  POSITION: World-systems / decolonial critique of Habermasian universalism and postcolonial
  studies' insufficient break from European epistemic frameworks.
  },
  keywords = {transmodernity, coloniality-of-power, world-systems, Habermas-critique, High},
  abstract = {Can we produce a radical anti-systemic politics beyond identity politics? 1 Is it possible to articulate a critical cosmopolitanism beyond nationalism and colonialism?},
  abstract_source = {openalex},
}

@article{dussel2012transmodernity,
  author = {Dussel, Enrique D.},
  title = {Transmodernity and Interculturality: An Interpretation from the Perspective of Philosophy of Liberation},
  journal = {TRANSMODERNITY},
  year = {2012},
  volume = {1},
  number = {3},
  doi = {10.5070/t413012881},
  note = {
  CORE ARGUMENT: Dussel articulates transmodernity as a positive project rather than merely
  a critique: it proposes a "South-South dialogue" among peripheral cultures that were
  colonized by Eurocentric modernity but not eliminated by it. Against Habermas's account
  of modernity as an unfinished project to be completed through communicative reason,
  Dussel argues that transmodernity requires dialogue among the "exteriorities" that
  European modernity excluded — a pluriversal rather than a universal horizon. The essay
  presents the analectic method as the philosophical procedure appropriate to this project.

  RELEVANCE: This is Dussel's own clearest formulation of transmodernity as a philosophical
  alternative to Habermas's modernity thesis, including the specific claim that interculturality
  (symmetric dialogue among peripheral traditions) replaces the Habermasian ideal speech
  situation as the normative horizon.

  POSITION: Dussel's affirmative formulation of transmodernity as a pluriversal counter to
  Habermasian communicative universalism.
  },
  keywords = {transmodernity, interculturality, analectical-method, pluriversality, Habermas-response, High},
  abstract = {Transmodernity and Interculturality: An Interpretation from the Perspective of Philosophy of Liberation},
  abstract_source = {openalex},
}

@article{alcoff2012transmodernism,
  author = {Mart{\'i}n Alcoff, Linda},
  title = {Enrique Dussel's Transmodernism},
  journal = {TRANSMODERNITY},
  year = {2012},
  volume = {1},
  number = {3},
  doi = {10.5070/t413012882},
  note = {
  CORE ARGUMENT: Alcoff reconstructs Dussel's transmodernism as a philosophical position
  that avoids both the Eurocentrism of Habermasian modernity-completion and the nihilism
  of postmodern anti-modernity. She argues that transmodernity is not simply a critique of
  modernity's exclusions but a substantive claim about the epistemological and normative
  resources held within peripheral cultures — resources that must contribute to any genuine
  universalism. Alcoff situates this against Habermas's claim that modernity's rational
  potential can be unlocked through an internal reconstruction of communicative reason,
  arguing that such internalism reproduces the colonial erasure of non-European contributions.

  RELEVANCE: Provides the philosophical epistemology of transmodernism — the claim about
  standpoint and locus of enunciation — that underpins Dussel's challenge to Habermasian
  universalism. The paper is key for the research project's treatment of how the modernity
  critique connects to epistemology.

  POSITION: Epistemological defense of transmodernism against Habermasian internalism,
  drawing on feminist standpoint theory and Latin American philosophy.
  },
  keywords = {transmodernism, epistemology, Habermas-modernity, feminist-standpoint, High},
  abstract = {Enrique Dussel’s Transmodernism},
  abstract_source = {openalex},
}

@article{dussel2012criticaltheory,
  author = {Dussel, Enrique},
  title = {From Critical Theory to the Philosophy of Liberation: Some Themes for Dialogue},
  journal = {TRANSMODERNITY},
  year = {2012},
  volume = {1},
  number = {2},
  doi = {10.5070/t412011806},
  note = {
  CORE ARGUMENT: Dussel explicitly addresses the relation between Habermas's critical theory
  and his own philosophy of liberation, identifying points of convergence (emancipatory
  interest, critique of domination, the need for communicative reason) and the decisive
  divergence: Habermas's critical theory is conducted from within European modernity and
  cannot account for the colonial Other that constitutes modernity's other face. Dussel
  argues that philosophy of liberation begins where critical theory stops — at the exteriority
  of the victims of modernity's sacrificial myth.

  RELEVANCE: This is the closest Dussel comes to a systematic comparative statement of his
  position vis-a-vis Habermas on the philosophy of history dimension of modernity. The paper
  connects directly to the research project's core question about what philosophy of history
  stakes are at issue in the Dussel-Habermas encounter.

  POSITION: Dussel's self-positioning of philosophy of liberation as completing and surpassing
  Habermasian critical theory by incorporating the colonial underside.
  },
  keywords = {critical-theory, Habermas-dialogue, philosophy-of-liberation, exteriority, High},
  abstract = {From Critical Theory to the Philosophy of Liberation: Some Themes for Dialogue},
  abstract_source = {openalex},
}

@article{maldonadotorres2012decolonial,
  author = {Maldonado-Torres, Nelson},
  title = {Thinking through the Decolonial Turn: Post-continental Interventions in Theory, Philosophy, and Critique---An Introduction},
  journal = {TRANSMODERNITY},
  year = {2012},
  volume = {1},
  number = {2},
  doi = {10.5070/t412011805},
  note = {
  CORE ARGUMENT: Maldonado-Torres introduces "post-continental" philosophy as a designation
  for thought that refuses to locate itself within the European continental tradition (including
  Habermas's Frankfurt School lineage) and instead begins from the colonial difference. The
  essay frames the decolonial turn as a philosophical reorientation at the level of the
  "geo-politics of knowledge" — the recognition that philosophical validity claims are
  always produced from a particular geopolitical location, and that Eurocentrism is
  constituted by the erasure of this situatedness.

  RELEVANCE: Provides the philosophical framework for the "decolonial turn" within which
  Dussel's critique of Habermas's modernity is located. The paper's account of post-continental
  philosophy clarifies what is at stake philosophically in refusing Habermas's intra-European
  genealogy of modernity.

  POSITION: Programmatic statement of decolonial/post-continental philosophy as an alternative
  to both European continental tradition and Habermasian communicative rationality.
  },
  keywords = {decolonial-turn, post-continental-philosophy, geopolitics-of-knowledge, Medium},
  abstract = {Thinking through the Decolonial Turn: Post-continental Interventions in Theory, Philosophy, and Critique—An Introduction},
  abstract_source = {openalex},
}

@article{suarez2021transmodernity,
  author = {Lozano Su{\'a}rez, Luz Mar{\'i}a},
  title = {Transmodernity: Method for a Decolonial Political Project. From Enrique Dussel to Santiago Castro-G{\'o}mez},
  journal = {Eidos},
  year = {2021},
  volume = {34},
  pages = {322--350},
  doi = {10.14482/eidos.34.199.8},
  note = {
  CORE ARGUMENT: Suárez analyzes how Dussel's transmodernity functions as a philosophical
  method rather than merely a cultural or political concept. She traces the uptake of
  Dussel's transmodern framework in Castro-Gómez's transmodern republicanism, showing
  how the decolonial critique of European modernity (including its Habermasian forms) is
  translated into a positive political-philosophical project. The article identifies
  transmodernity as a method of "analectic" mediation — taking the best of modernity's
  rational content while refusing its colonial self-understanding.

  RELEVANCE: Provides the methodological analysis of what Dussel's transmodernity proposes
  as an alternative to Habermasian "unfinished modernity," and shows how subsequent
  Latin American thinkers have developed the framework. Useful for the synthesis dimension
  of how Dussel's position can be reconstructed as a philosophical method.

  POSITION: Methodological reading of Dussel's transmodernity as a decolonial political
  philosophy, tracing its uptake and transformation in Castro-Gómez.
  },
  keywords = {transmodernity, decolonial-method, Castro-Gomez, analectical-method, Medium},
  abstract = {This article seeks to analyze how the sense of transmodernity is subsumed in phi- losopher Santiago Castro-Gómez, to propose an emancipatory policy. Transmodernity is a decolonial project proposed by Enrique Dussel in 1994. Modernity, defined as a sacrificial myth -eurocentric, colonizing, and capitalist- would be overcome from the moment in which it is possible to affirm the otherness of the universal cultures —ana- lectic—. Such a project of the Philosophy of Liberation can be conceived as a method that would take the best of modernity —its rational character—, but in an opposite sense to political, cultural, and economic domination. Gastro-Gómez assumes this method to propose a transmodern republicanism. In this text, the possible modernity/ coloniality dialog, corroborated by these two philosophers, will be established as the guiding thread to determine how a new way of understanding the ontology of eman- cipatory (not liberating) politics, presented by the Colombian philosopher, is possible.},
  abstract_source = {s2},
}

@article{pimenta2025modernity,
  author = {Pimenta, Tom{\'a}s Lima},
  title = {Enrique Dussel's Concept of Modernity: The Intellectual Evolution of a Complex Understanding of Our Age},
  journal = {Revista NUPEM},
  year = {2025},
  volume = {17},
  number = {40},
  doi = {10.33871/nupem.2025.17.40.8514},
  note = {
  CORE ARGUMENT: Pimenta reconstructs Dussel's concept of modernity as it evolved across
  five phases of his intellectual career, from his early phenomenological work through the
  1492 thesis and transmodernity. The article argues that Dussel's conception is not simply
  a critique of Eurocentrism but operates a "geopolitical turn" in philosophy: it relocates
  the question of modernity from internal European self-reflection (the Habermasian model)
  to a world-historical framework in which the Americas, Africa, and Asia are constitutive
  rather than peripheral. Economic history and world-systems analysis (Wallerstein) are
  shown to be philosophical resources, not just contextual background.

  RELEVANCE: Provides an up-to-date intellectual history of Dussel's modernity concept,
  tracing exactly where and how it departs from Habermasian accounts. The reconstruction
  of the role of world-systems theory in Dussel's philosophy of history is directly relevant
  to the research project's question about how the decolonial framing reshapes the critique
  beyond ethics into philosophy of history.

  POSITION: Intellectual-historical reconstruction of Dussel's modernity concept as a
  geopolitical turn that surpasses both Eurocentric and postmodern frameworks.
  },
  keywords = {Dussel-modernity, intellectual-history, world-systems, geopolitics-of-knowledge, High},
  abstract = {This paper examines Enrique Dussel’s concept of modernity by offering an intellectual reconstruction of the evolution of his thought and argues that his conception of modernity is not a reductionist idea of Eurocentrism and colonialism. It emphasizes his transdisciplinary approach, spanning from history, economic history, metaphysics, and ethics, providing a rich and unparalleled understanding of modernity. This perspective reveals crucial aspects of the genesis and essence of modernity, as well as key insights to interpret its current state and fate. For this purpose, Dussel’s intellectual trajectory is divided into different phases. For each period, it highlights his primary interlocutors, topics of investigation, and insights about the essence of modernity. In this context, this paper emphasizes the roles of economic history, World-System analysis, and geopolitics in his philosophical project. In short, it argues that Dussel’s theory of modernity operates as a geopolitical turn in philosophy.},
  abstract_source = {s2},
}

@article{pinton2025ego,
  author = {Pinton, Clara Isabel},
  title = {From Ego Conquiro to Ego Cogito: Dussel's Latin American History of Philosophy},
  journal = {RUDN Journal of Philosophy},
  year = {2025},
  volume = {29},
  number = {3},
  pages = {704--719},
  doi = {10.22363/2313-2302-2025-29-3-704-719},
  note = {
  CORE ARGUMENT: Pinton analyzes Dussel's argument in "1492: El encubrimiento del Otro"
  that the Cartesian ego cogito — Habermas's point of departure for the "philosophical
  discourse of modernity" — is historically posterior to and dependent upon the ego
  conquiro: the colonial subject constituted by the conquest of the Americas. The paper
  argues that Dussel's Latin American history of philosophy is not a supplement to
  European philosophy but a deconstructive genealogy that shows how the philosophical
  foundations of Habermasian modernity rest on a colonial erasure.

  RELEVANCE: Directly reconstructs Dussel's 1492 thesis as a critique of the Cartesian
  foundations of modern philosophy, showing why Habermas's starting point (the
  philosophical discourse of modernity rooted in subject philosophy) is already compromised
  by the colonial encounter that made it possible.

  POSITION: Deconstructive genealogy of modern subjectivity, reconstructing Dussel's
  argument that Descartes' ego cogito presupposes the colonial ego conquiro.
  },
  keywords = {1492-thesis, ego-conquiro, ego-cogito, Descartes, Habermas-genealogy, Medium},
  abstract = {Modern Western philosophy has long excluded Latin America from its historical and conceptual narrative, reinforcing a Eurocentric understanding of historical development. This study aims to challenge that exclusion by analyzing how Enrique Dussel’s philosophy - especially as developed in 1492: El encubrimiento del Otro and Meditaciones anticartesianas - reconstructs the origins of modern subjectivity from a Latin American, decolonial perspective. Through textual analysis of Dussel’s works and comparative readings of canonical European thinkers such as Hegel and Descartes, this research investigates the historical and ontological link between the ego cogito and the ego conquiro . Following a philosophical and critical-historical method, the study combines close exegesis with genealogical reconstruction to identify how the myth of modernity emerged through colonial conquest and philosophical erasure. The results reveal that, according to Dussel, the Cartesian subject - the foundation of modern philosophy - is only made possible through the prior conquest and objectification of the colonial Other. This encounter is not peripheral but constitutive: Latin America and the broader colonial world played a crucial role in the birth of modernity, both economically and philosophically, and ontologically. As highlighted in its conclusions, this study represents only an initial step: a deconstructive phase within the broader tradition of the Philosophy of Liberation. The study calls for the reconstruction of a philosophical canon that acknowledges its colonial foundations and includes the voices it has historically silenced. Ultimately, it argues that decolonizing philosophy, a process that broadly extends from Latin America to the entire peripheral world, is not only possible but also necessary for a more just and inclusive global thought.},
  abstract_source = {s2},
}

@article{dussel2025epistemological,
  author = {Dussel, Enrique},
  title = {Epistemological Decolonization of World History and Decolonizing the Conception of Modernity: Towards Transmodernity},
  journal = {TRANSMODERNITY},
  year = {2025},
  volume = {12},
  number = {2},
  doi = {10.5070/t4.42496},
  note = {
  CORE ARGUMENT: Dussel's late essay extends his 1492 thesis to a systematic critique of
  the Eurocentric periodization of world history — the very historical framework that
  Habermas's account of the "philosophical discourse of modernity" presupposes. Dussel
  argues that postmodernism, by rejecting modernity while remaining within its European
  frame, cannot articulate a genuinely global alternative. Transmodernity, by contrast,
  proposes a pluriversal framework that integrates the epistemological contributions of
  non-European civilizations suppressed by colonial modernity.

  RELEVANCE: The most recent statement of Dussel's transmodernity thesis, published
  posthumously, emphasizing its applicability as a critique of the Eurocentric
  periodization that subtends Habermasian modernity. Provides the research project with
  the final development of Dussel's philosophy of history argument.

  POSITION: Dussel's last systematic statement of transmodernity as an epistemological
  decolonization of the world-history framing that Habermas's modernity discourse
  presupposes.
  },
  keywords = {transmodernity, epistemological-decolonization, world-history, pluriversality, Medium},
  abstract = {This essay explores the epistemological decolonization of World History and the critique of modernity through a transmodern perspective. It challenges the Eurocentric periodization of history, emphasizing the erasure and misrepresentation of non-European civilizations in the global narrative. By examining the ideological constructs underpinning modernity, capitalism, and colonialism, the essay advocates for a pluriversal approach to knowledge and cultural traditions. It also critiques the inadequacies of postmodernism in addressing systemic inequities, proposing transmodernity as a framework for integrating diverse traditions and fostering dialogue among cultures of the Global South. Through this lens, the essay seeks to redefine the future of humanity and knowledge production.},
  abstract_source = {s2},
}

@article{kim2019analectics,
  author = {Kim, David Haekwon},
  title = {Alterity, Analectics, and the Challenges of Epistemic Decolonization},
  journal = {The Southern Journal of Philosophy},
  year = {2019},
  volume = {57},
  number = {S1},
  pages = {37--62},
  doi = {10.1111/sjp.12346},
  note = {
  CORE ARGUMENT: Kim distinguishes between philosophies that are "alterior" (emerging from culturally different but non-subordinated positions) and those that are "analectical" in Dussel's sense (emerging from a politically subordinated, excluded position within the modern world system). The analectical standpoint is not merely culturally other but politically marginalized -- it speaks from outside the existing community of communication. Kim uses this distinction to press for epistemic decolonization in philosophy as a discipline.

  RELEVANCE: Kim's analysis clarifies the analectical method as a response to the problem of who is included in the community of communication. The Dusselian notion that philosophy can only achieve universality by starting from the voice of the excluded -- rather than by enlarging a formal-pragmatic framework -- is here given its most careful English-language treatment. This is directly relevant to the question of whether analectics is an alternative to or a radicalization of universal pragmatics.

  POSITION: Analectical-decolonial: the community of communication must be reconstructed from the standpoint of the excluded Other, not merely formally extended.
  },
  keywords = {analectics, communicative-rationality, epistemic-decolonization, excluded-other, interculturality, High},
  abstract = {Abstract This essay explores some conceptual and diagnostic frameworks to advance epistemic decolonization in the US philosophical profession. A central focus is the distinction between those philosophies of formerly colonized peoples that are culturally alterior or, simply, alterior and those that are analectical in the Dusselian sense of emerging from a subordinated political position. The paper begins by reflecting upon connections between coloniality, the alterior, and the analectical to frame the discussion of epistemic decolonization in the philosophy profession. It then considers a knower's core theoretic reconstruction in the task of epistemic decolonization and identifies some ambiguities in reconciling alterior traditions with analectical theoretical reconstruction. The work of Charles Mills and Enrique Dussel are considered as case studies. The paper concludes with critical reflections on the institutional network of canon, curriculum, and other conceptual and credentialization structures that constitute institutional Eurocentrism.},
  abstract_source = {openalex},
}

@article{irvine2011ontological,
  author = {Irvine, Andrew B.},
  title = {An Ontological Critique of the Trans-Ontology of {Enrique Dussel}},
  journal = {Sophia},
  year = {2011},
  volume = {50},
  number = {4},
  pages = {603--624},
  doi = {10.1007/s11841-010-0210-8},
  note = {
  CORE ARGUMENT: Irvine challenges Dussel's claim that the analectic method enables philosophy to break out of Western ontological closure. He argues that Dussel's appeal to the "revelation of the Other" -- the ethical demand that comes from outside being and inaugurates the analectic movement -- is itself a philosophical gesture that remains intelligible only within a broadly Western ontological horizon. The "trans-ontological" move Dussel requires is, Irvine argues, not available to any philosophy that still uses the conceptual resources of phenomenology (Levinas, Heidegger).

  RELEVANCE: This critique bears on the key question of whether analectics can genuinely provide an alternative to universal pragmatics or whether it is a modification internal to the same conceptual space. If Irvine is right, then Dussel's positive alternative to communicative rationality faces a performative tension: it cannot establish the standpoint of the excluded Other without using philosophical tools it claims to transcend.

  POSITION: Internal critique: the analectic method cannot achieve the trans-ontological standpoint it requires and remains within the Western philosophical tradition it purports to surpass.
  },
  keywords = {analectics, analectic-method, trans-ontology, exteriority, Medium, INCOMPLETE, no-abstract},
}

@incollection{mendieta2018modernity,
  author = {Mendieta, Eduardo},
  title = {Modernity and postmodernity as challenges to discourse ethics: An ethics of global co-responsibility for an age of suspect foundationalism and rhetorical relativism},
  booktitle = {A Matter of Discourse},
  editor = {Nascimento, Am{\'o}s},
  publisher = {Routledge},
  year = {2018},
  pages = {219--242},
  doi = {10.4324/9780429464683-10},
  note = {
  CORE ARGUMENT: Mendieta argues that discourse ethics faces a double challenge from modernity/postmodernity: on one side, the conditions for unconstrained communication are historically unprecedented and unevenly distributed; on the other, the postmodern dissolution of foundations threatens to undermine the normative ambitions of any universalistic ethics. He proposes an ethics of global co-responsibility that would preserve the universalistic aspirations of discourse ethics while acknowledging the asymmetric material conditions that liberation philosophy highlights.

  RELEVANCE: Mendieta's chapter directly addresses whether discourse ethics can respond to the liberation-philosophy challenge while also resisting postmodern relativism. The "global co-responsibility" frame suggests that universal pragmatics needs not replacement but extension to encompass the asymmetric lifeworld conditions Dussel identifies.

  POSITION: Reformist: discourse ethics can be retained in modified form once it acknowledges global asymmetry -- a partial endorsement of Dussel's critique of universal pragmatics.
  },
  keywords = {discourse-ethics, universal-pragmatics, global-responsibility, liberation-ethics, Medium},
  abstract = {This chapter shows how Karl-Otto Apel’s discourse ethics may be seen as a moral theory that not only discerned and anticipated the critique of modernity by postmoderns, but also formulated an alternative that navigates between the Scylla of relativism and the Charybdis of foundationalism. Apel’s work can be described as the synthesis of three of the most important philosophical currents of twentieth century philosophy. While Apel’s context was post-World War II ravaged Europe, one poised before the dual abysses of decisionistic subjectivism and value neutral scientism, Enrique Dussel’s context was an underdeveloped, anthropologically, economically and politically stunted, colonized and exploited Latin America. If Apel’s quest for a planetary macro-ethics led him to postulate the need for the growth in a planetary public sphere in which many international organizations may adjudicate on world problems, Dussel’s similar quest has led him to discover the structural roots of the growing rift between First and Third World.},
  abstract_source = {openalex},
}

@article{demenchonok2025liberation,
  author = {Demenchonok, Edward V.},
  title = {Latin {American} Philosophy of Liberation and Intercultural Philosophy of Dialogue},
  journal = {RUDN Journal of Philosophy},
  year = {2025},
  volume = {29},
  number = {3},
  pages = {795--818},
  doi = {10.22363/2313-2302-2025-29-3-795-818},
  note = {
  CORE ARGUMENT: Demenchonok traces how Latin American philosophy of liberation (Dussel, Roig, Cea) generated the intercultural philosophy of dialogue associated primarily with Fornet-Betancourt. He argues that Fornet-Betancourt's "intercultural transformation of philosophy" -- based on a "contextualized and concrete universality" rather than an abstract universalism -- provides an alternative to both Habermasian universal pragmatics and postmodern relativism. The project requires not supplementing but transforming philosophical discourse from within the cultural embeddedness of each tradition.

  RELEVANCE: This article connects the liberation philosophy tradition to the intercultural philosophy movement, showing how Fornet-Betancourt's project offers a more developed version of the interculturality that Dussel's analectics anticipates. For the research project, this is relevant to the question of whether intercultural dialogue is best understood as supplementing or replacing universal pragmatics.

  POSITION: Intercultural transformation: universal pragmatics must be replaced by a culturally embedded dialogue that acknowledges the asymmetric standpoints of participants.
  },
  keywords = {interculturality, intercultural-philosophy, liberation-philosophy, Fornet-Betancourt, universal-pragmatics, Medium},
  abstract = {The research examines the Latin American philosophy of liberation (L. Cea, A. Roig, E. Dussel), from which the intercultural philosophy of dialogue was developed. The dialogue between Russian and Latin American philosophers and the recognition of the philosophy of liberation in Russia are shown. Attention is paid to the discussion about the dialectic of the universal and the culturally-specific, using the example of Latin American philosophy. The article examines intercultural philosophy, which justifies the right to cultural diversity and the normativity of dialogical relations in a culturally diverse world. It analyzes R. Fornet-Betancourt's project on the intercultural transformation of philosophy, which is based on the cultural embeddedness of philosophical traditions.},
  abstract_source = {semantic_scholar},
}

@article{mekonnen2018enlightening,
  author = {Mekonnen, Binyam},
  title = {Enlightening Global Communication: Liberation Philosophy and the Intercultural Stand of the {`Other'}},
  journal = {Ethiopian Journal of the Social Sciences and Humanities},
  year = {2018},
  volume = {13},
  number = {1},
  pages = {25},
  doi = {10.4314/ejossah.v13i1.2},
  note = {
  CORE ARGUMENT: Mekonnen traces how liberation theology and Dussel's liberation philosophy reconstruct "intercommunicative" relations from the standpoint of the historical Other. He argues that the enlightenment project of communicative rationality remained Eurocentric by failing to include the colonized Other in the "intercultural stand" -- the recognition that genuine communication requires acknowledging the Other's alterity. Dussel's contribution is to show that the emancipation of the Other is not the endpoint but the starting point of universal communication.

  RELEVANCE: Mekonnen's reading provides a concise account of how liberation philosophy reframes communicative rationality: not by rejecting it but by insisting that its universality is only achievable by beginning from the excluded Other's perspective. This is relevant to the project's question about whether Dussel's critique is reformist or more fundamentally critical.

  POSITION: Reconstructionist from the margins: communicative rationality can achieve universality only if reconstructed from the standpoint of the excluded.
  },
  keywords = {intercultural-communication, liberation-philosophy, communicative-rationality, excluded-other, Medium},
  abstract = {Based on historical records the second half of the twentieth century can be marked as a point of departure for a substantial movement on the topic of liberation across the world; liberation which is contained within a contentious critical popular voice of change on the prevailing and broad political structure of the world. In this period, in different corners of the world people were in protest and war to gain their long lived anguish of being free from the colonial culture of subjugation and exclusion. Although some of the revolutionary movements of this era tended to have economic, socio-cultural and other manifestations, the ultimate anomaly of all these questions were rooted in the ontological and practical premises of liberation, i.e. the enlightenment of the 'Other', the negation of an enforced hegemony, and the reformulation of an intercommunicative just and rational global history of humanity. The key concern of human redemption calls for self-realization as both a particular and universal being by means of methodic politicization. In this paper I sketch the main arguments of liberation theology and Enerique Dussel's liberation philosophy which work for the reconstruction of intersubjective and intercultural communications on the basis of dual redemption in one, which is, emancipation of the 'Other' as an initial and the emancipation of humankind as an end.},
  abstract_source = {core},
}

@incollection{zuniga2021grounding,
  author = {Z{\'u}{\~n}iga M., Jorge},
  title = {Ethics of Liberation and Discourse Ethics: On Grounding the Material Principle of Life},
  booktitle = {Decolonizing Ethics},
  editor = {Allen, Amy and Mendieta, Eduardo},
  publisher = {Penn State University Press},
  year = {2021},
  pages = {107--126},
  doi = {10.1515/9780271090320-007},
  note = {
  CORE ARGUMENT: Zuniga examines the relationship between the material principle of life in Dussel's ethics and the formal principle derived from discourse ethics/universal pragmatics. He argues that Dussel's material principle is irreducible to Habermasian-Apelian communicative conditions because it grounds normativity in the biological-material conditions for the reproduction of human life, not in the formal presuppositions of language use. This creates a genuine alternative to universal pragmatics, not merely a supplement.

  RELEVANCE: Zuniga's chapter provides the most focused analysis of how the material principle in Dussel's ethics functions as an alternative to the formal-pragmatic grounding of communicative rationality. This is directly relevant to the debate over whether Dussel offers a genuine alternative to Habermasian universalism or merely extends it.

  POSITION: Material-grounding: the ethics of liberation provides a genuinely different foundation than formal pragmatics, grounding norms in life rather than in the presuppositions of communication.
  },
  keywords = {ethics-of-liberation, discourse-ethics, material-principle, universal-pragmatics, communicative-rationality, High},
  abstract = {Chapter examining the relationship between Dussel's material principle of life and discourse ethics, arguing that the material principle of life is irreducible to formal communicative conditions and grounds an alternative to universal pragmatics.},
  abstract_source = {manual},
}

@book{allenMendieta2021,
  editor = {Allen, Amy and Mendieta, Eduardo},
  title = {Decolonizing Ethics: The Critical Theory of Enrique Dussel},
  publisher = {Penn State University Press},
  year = {2021},
  doi = {10.1515/9780271090320},
  note = {
  CORE ARGUMENT: This edited volume assembles leading scholars to assess Dussel's critical theory across multiple dimensions: its engagement with Frankfurt School thinkers (Habermas, Honneth, Adorno), its treatment of political violence, its feminist dimensions, and its place in the decolonial turn. The editors argue that Dussel's ethics of liberation represents a substantive and philosophically rigorous challenge to Eurocentrism within critical theory.

  RELEVANCE: As the most comprehensive recent English-language secondary treatment of Dussel's relationship to Frankfurt School critical theory, this volume is indispensable context for evaluating the reception of Dussel's critique of Habermas. Multiple chapters directly address the Habermas–Dussel exchange.

  POSITION: Collectively oriented toward sympathetic but rigorous critical engagement with Dussel's project.
  },
  keywords = {Dussel, Frankfurt School, Habermas, decolonizing, critical theory, High},
  abstract = {Enrique Dussel is Latin America’s foremost philosopher, renowned for his contributions to ethics, political philosophy, and liberation theology. Designed for classroom use, this collection of essays engages with Dussel’s encyclopedic work, making his valuable contributions accessible to English-speaking students. In addition to being one of the most original, prolific, and widely known members of the Latin American Philosophy of Liberation movement, Dussel has also made important contributions to world philosophy, the history of philosophy, the history of the Catholic Church in Latin America, and the understanding of Karl Marx. Dussel famously engaged in a decade-long debate with Karl-Otto Apel on the relationship between material and formal ethics—that is, between an ethics of the community of life and an ethics of the community of discourse—and he has produced novel interpretations and analyses of the concepts of alterity, exteriority, the other, and the world history of ethical systems. Most recently, Dussel extended his work on an ethics of liberation into a politics of liberation, developed over the course of three published volumes. In this book, scholars from around the world assess Dussel’s work in ways that are both appreciative and critical. Two essays by Dussel bookend the volume: the collection opens with a consideration of the (im)possibility of multiple modernities and ends with an autobiographical trajectory of the philosopher’s thinking. In addition to Dussel and the editors, the contributors to this volume include Linda Martín Alcoff, Don Thomas Deere, Oscar Guardiola-Rivera, Mario Sáenz Rovner, Alejandro A. Vallega, and Jorge Zúñiga M.},
  abstract_source = {openalex},
}

@article{quintanaPaz2014,
  author = {Quintana-Paz, Miguel {\'A}ngel},
  title = {Enrique {Dussel} and Liberation Theology: Violence or Dialogue?},
  journal = {Journal of Interdisciplinary Studies},
  year = {2014},
  volume = {26},
  number = {1},
  pages = {135--146},
  doi = {10.5840/jis2014261/27},
  note = {
  CORE ARGUMENT: Quintana-Paz argues that Dussel's ethics of liberation contains an internal contradiction: he borrows formal-discursive criteria (from Apel and Habermas) to legitimize political revolution, yet the very criteria—communicative consensus, discursive validity, feasibility—are conceptually incompatible with the use of violence that Dussel also seeks to justify. The essay exposes a tension between Dussel's procedural debts to discourse ethics and his substantive political commitments.

  RELEVANCE: This critique is directly relevant to the question of how much Dussel's liberation ethics depends on (and remains in tension with) Habermasian discourse ethics. It shows that Dussel's critique of Habermas does not free him from Habermasian normative categories.

  POSITION: Internal critique of Dussel's ethics; reveals philosophical dependence on discourse-ethics criteria while assessing the coherence of his liberation project.
  },
  keywords = {Dussel, liberation theology, violence, discourse ethics, critique, Medium},
  abstract = {For centuries, various disciplines have tried to tackle the topic of how legitimate it is to use violence in order to solve social problems. One of the most recent interdisciplinary approaches, most successful in present-day Latin America, is the so-called "Ethics of Liberation," designed by Enrique Dussel. Based on the Theology of Liberation, this theory goes beyond the limits of theology as a discipline and pleads for three ethical criteria that every political revolution must fulfill to use violence in a legitimate way. The first is a formal criterion, which basically takes after the ideal dialogue situation endorsed by Karl-Otto Apel and Jürgen Habermas, and purports to be rooted in yet another discipline, linguistics. The second is a material criterion, defined as the upshot of an acceptable welfare for all citizens, thus intimately linked with the discipline of economics and political philosophy. The third is a criterion of feasibility, which makes a revolt legitimate if, and only if, it has a reasonable possibility of succeeding; hence strategic issues take a leading role. This essay contends that each of these criteria is conceptually incompatible with violence. Hence, Dussel's arguments involve multiple contradictions as he aims to justify the use of violence precisely with these interdisciplinary criteria.},
  abstract_source = {openalex},
}

@article{meehan2000feminism,
  author = {Meehan, Johanna},
  title = {Feminism and {Habermas'} discourse ethics},
  journal = {Philosophy \& Social Criticism},
  year = {2000},
  volume = {26},
  number = {3},
  pages = {39--52},
  doi = {10.1177/019145370002600302},
  note = {
  CORE ARGUMENT: Meehan examines feminist critiques of Habermas's discourse ethics, arguing that while feminists are often suspicious of discourse ethics for its formalism and proceduralism, many of their misgivings are misplaced. Habermas's account of the intersubjective constitution of subjectivity and his defense of rational normativity are useful for feminist theory, though his reductive identification of subjectivity with language and rationality requires revision.

  RELEVANCE: Provides the feminist comparandum for Dussel's critique: where Dussel criticizes discourse ethics for ignoring material suffering and the victims of the world system, feminists target its formalism and gendered assumptions. Comparing both critiques illuminates the range of objections to Habermasian universalism.

  POSITION: Feminist partial defense and critique of Habermas's discourse ethics; relevant as a comparative benchmark.
  },
  keywords = {Habermas, feminism, discourse ethics, universalism, comparison, Medium},
  abstract = {Habermas’ account of the radically intersubjective constitution of subjectivity is of great use to feminist theorists, as is his defense of the rational character of normative claims. Feminists must however, reject his reductive identification of subjectivity with language and rationality. Some feminists’ concerns insist on continuing to distinguish morality from legality, something that Habermas, despite his own better intuitions and arguments, is sometimes disinclined to do.},
  abstract_source = {openalex},
}

@article{papastephanou2011eurocentrism,
  author = {Papastephanou, Marianna},
  title = {Eurocentrism beyond the `universalism vs. particularism' dilemma: {Habermas} and {Derrida's} joint plea for a new {Europe}},
  journal = {History of the Human Sciences},
  year = {2011},
  volume = {24},
  number = {5},
  pages = {142--166},
  doi = {10.1177/0952695111422317},
  note = {
  CORE ARGUMENT: Papastephanou argues that the charge of Eurocentrism against Habermas (and Derrida) cannot be adequately addressed through the standard universalism/particularism dichotomy. She examines whether Habermas and Derrida's joint 2003 plea for a European identity moves beyond Eurocentrism or reinstates it in subtler form, concluding that post-national universalism retains Eurocentric assumptions even in its most self-critical formulations.

  RELEVANCE: Provides a comparative perspective on the charge of Eurocentrism against Habermas from European scholarship—distinct from Dussel's Latin American liberation standpoint. Useful for the synthesis's treatment of how the charge of Eurocentrism appears across different critical traditions.

  POSITION: Critical from within European scholarship; neither fully defends nor fully condemns Habermas on Eurocentrism.
  },
  keywords = {Habermas, Eurocentrism, universalism, Derrida, comparative, Medium},
  abstract = {[[cosmopolitanismexpansionismidealismparticularismUNuniversalism ]] Is it Eurocentric on the part of western philosophers (Habermas, Derrida) or of researchers in human sciences to set out from a specific locality (Europe) to formulate ethico-political ideals with universal aspirations? In this article, I critique the ‘universalism vs. particularism’ framework within which the charge of Eurocentrism is deployed and I redefine the notion of Eurocentrism outside the drastic choice between universalism and particularism and in light of an ‘ec-centric’ reflection on the entanglement of the ‘We’ and the ‘others’. I illustrate my position by discussing the Habermasian–Derridean plea for the determination of new European political responsibilities beyond any Eurocentrism. I grant that the two philosophers go indeed beyond Eurocentrism as the latter is usually understood, i.e. along the axis ‘universal–particular’. Yet, without minimizing their political contribution, I detect subtler Eurocentrisms that pervade several assumptions of Habermas’s and Derrida’s collaborative efforts. I argue that a hasty enlisting of possibilities for a politically and morally pertinent European intervention in world affairs fails to account for other, more necessary steps in the direction of reforming the western consciousness and of going beyond less easily discernible Eurocentrisms such as those theorized within the proposed, reformulated notion.},
  abstract_source = {openalex},
}

@article{radhakrishnan2025critique,
  author = {Radhakrishnan, Shivani},
  title = {Critique as Coloniality: The Decolonial Challenge to Immanent Critique},
  journal = {Constellations},
  year = {2025},
  volume = {32},
  number = {3},
  pages = {476--483},
  doi = {10.1111/1467-8675.12790},
  note = {
  CORE ARGUMENT: Radhakrishnan argues that the Frankfurt School's methodological commitment to immanent critique—evaluating social practices by their own internal norms and potentials—is structurally unable to address colonial and postcolonial critique, because it anchors normativity in the very practices that have been shaped by colonial power. The decolonial challenge requires a form of critique that steps outside the immanent norms of modernity itself.

  RELEVANCE: This article is among the most recent contributions to the meta-level question of whether Frankfurt School critical theory (including Habermas's communicative-rationality framework) can be decolonized or must be replaced. It directly contextualizes Dussel's critique within a broader decolonial challenge to critical theory.

  POSITION: Strong decolonial critique; challenges the adequacy of immanent critique as a methodology for addressing colonial legacies.
  },
  keywords = {decolonial, immanent critique, Frankfurt School, Habermas, coloniality, High},
  abstract = {Frankfurt School methodology involves a lasting commitment to immanent critique. What distinguishes immanent critique from other forms of social criticism, scholars in this tradition argue, is that social practices are to be judged according to norms and potentials already contained within their objects. This article considers critical theory's relationship to coloniality by developing a three‐part challenge to the practice of immanent critique, drawing on insights of decolonial philosophers Anibal Quijano, Enrique Dussel, Maria Lugones, and Oyèrónkẹ́ Oyěwùmí. Immanent critics, I conclude, risk being inattentive to constitutive exclusions, reinscribing asymmetrical burdens on certain critics, and unwittingly replaying a mechanism of domination familiar from colonialism in and through their preferred method of critique. Accordingly, I argue that immanent critics should attend to relations of power that govern the practice of critique itself and offer reasons for being more pluralistic about our methods of criticism.},
  abstract_source = {s2},
}

@article{naicker2023decolonial,
  author = {Naicker, Veeran},
  title = {The problem of epistemological critique in contemporary {Decolonial} theory},
  journal = {Social Dynamics},
  year = {2023},
  volume = {49},
  number = {2},
  pages = {220--241},
  doi = {10.1080/02533952.2023.2226497},
  note = {
  CORE ARGUMENT: Naicker critically responds to decolonial theory's reductive generalizations about Western epistemology, arguing that its articulation of geopolitics and standpoint theory amounts to a simplistic inversion of colonial stereotypes. He argues that decolonial theory misrepresents Western epistemology by reducing it to a subject-object dualism, and that decolonial theory is itself self-defeating because it replicates the metaphysical errors it attributes to Western philosophy.

  RELEVANCE: Naicker's critique of decolonial theory as a whole is directly relevant to assessing the cogency of Dussel's critique of Habermas, since Dussel's liberation ethics is one of the foundational sources for the decolonial turn. The paper represents the critical-dissenting strand in the reception of this literature.

  POSITION: Philosophical critique of decolonial theory's epistemological foundations, including the Dussel-derived strands.
  },
  keywords = {decolonial theory, epistemological critique, Eurocentrism, assessment, dissenting, Medium},
  abstract = {ABSTRACT Decolonial theory argues that the coloniality of rational Western epistemology is the cause of all global crises, including violent patriarchy, racism and ecological destruction. Contemporary decolonial scholars consequently advocate de-linking from the colonial matrix of power which defines the modern world system. They promote a move towards an epistemologically pluriversal world, which they consider to be theoretically superior and a politically radical advance over postructuralism, postcolonialism and Marxism, which are denigrated as complicit iterations of Eurocentric coloniality. In this article, I critically respond to Decolonial theory’s reductive generalisations by demonstrating that its ostensibly constructivist articulation of geopolitics and standpoint theory amounts to a simplistic inversion of colonial stereotypes found in postcolonial analyses of colonial discourse. After establishing that Decolonial theory is unwittingly bound to a colonial, albeit inverted discourse of essentialist racialised morality, I exhibit that its stereotypical reduction of Western epistemology to a subject-object dualism misrepresents developments in Euro-American epistemology and continental philosophy of science, citing the case of French historical epistemology. I conclude by demonstrating that Decolonial theory is contradictory and self-defeating because it replicates metaphysical errors in Western philosophy and supports political values closer to the far right than leftist ideals of universality and a common world.},
  abstract_source = {s2},
}

@article{guennouni2025misreading,
  author = {Guennouni Idrissi, Achraf},
  title = {Misreading the {R{\=u}{\d{h}}}: {Taha Abderrahmane}, {Enrique Dussel} and the ethics of decolonial modernities},
  journal = {Postcolonial Studies},
  year = {2025},
  volume = {28},
  number = {2},
  pages = {132--155},
  doi = {10.1080/13688790.2025.2546187},
  note = {
  CORE ARGUMENT: Guennouni Idrissi examines two non-European critiques of Western modernity—Dussel's from Latin America and Taha Abderrahmane's from the Islamic tradition. He argues that Dussel's pluriversal framework misreads Taha's project, treating it as abstract universalism when it is in fact a form of decolonial ethical specificity. The article shows that Dussel's critique of Western universalism can itself commit the error of undifferentiated anti-universalism.

  RELEVANCE: This South–South comparison is uniquely relevant to the project's question of whether Dussel's critique of Habermasian universalism is itself universal or parochially Latin American. It extends the comparative dimension beyond the usual Frankfurt School versus liberation ethics axis.

  POSITION: Comparative postcolonial critique; exposes limitations in Dussel's pluriversal framework from a non-Western but non-Habermasian standpoint.
  },
  keywords = {Dussel, Taha Abderrahmane, modernity, pluriversality, postcolonial comparison, Medium},
  abstract = {ABSTRACT This article explores the contrasting perspectives of Moroccan philosopher Taha Abderrahmane and Latin American thinker Enrique Dussel on the question of multiple modernities within South–South intellectual dialogue. While Dussel, grounded in the philosophy of liberation, critiques modernity as an inherently Eurocentric and colonial construct – arguing that its universalization inevitably reproduces colonial logics – Taha offers a distinctive ethical reimagining of modernity. He differentiates between the universal spirit (rūḥ) of modernity, embodied in principles, such as intellectual maturity (rushd), critique (naqd) and universality (shumūl) and its historically contingent Western expressions. Against mimicry and secular developmentalism, Taha calls for a creative engagement (ibdāʿ) with the Islamic tradition (turāth) to cultivate a spiritually grounded, ethically transformative and non-imitative modernity. This article argues that while Dussel’s critique remains incisive, it ultimately misreads Taha’s project as abstract universalism, thereby overlooking its decolonial logic and ethical specificity. By redefining modernity through al-ibdāʿ al-mawṣūl (connected creativity), Taha confronts Eurocentric dominance and unsettles the very anti-universalist premises on which Dussel’s pluriversal framework rests. His vision gestures towards a temporally decolonized modernity rooted in ethical universality and pluriversal coexistence.},
  abstract_source = {s2},
}

@article{ahmad2025habermas,
  author = {Ahmad, Irfan},
  title = {{Habermas} as an ethnic thinker {Par Excellence}: on critique, {Palestine} and the role of intellectuals},
  journal = {Teaching in Higher Education},
  year = {2025},
  volume = {30},
  number = {7},
  pages = {1343--1362},
  doi = {10.1080/13562517.2025.2466001},
  note = {
  CORE ARGUMENT: Ahmad argues that Habermas's claims to universalism are structurally ethnic rather than genuinely universal—oriented toward delivery "to all" rather than construction "from all." Using Habermas's 2023 statement on the Israel-Palestine conflict as a test case, Ahmad contends that Habermas's universalism replicates a Eurocentric-Enlightenment framework that excludes non-European voices from the standpoint of critique.

  RELEVANCE: While not focused on Dussel specifically, this recent (2025) critique of Habermas's universalism closely parallels Dussel's central charge and serves as evidence that the debate about Habermasian universalism and its blind spots continues to generate new scholarship. It provides a current, non-Latin-American version of the Eurocentrism critique.

  POSITION: Strong external critique of Habermas's universalism as structurally ethnic; parallel to but independent of Dussel's critique.
  },
  keywords = {Habermas, universalism, Eurocentrism, critique, postcolonial, Low},
  abstract = {ABSTRACT Taking Habermas’ 2023 statement on Palestinians-Israel as the point of entry, this article examines his concept of critique. Against the dominant view of him as a philosopher of ‘universalism’ and ‘critical rationality,’ my thesis is that Habermas is an ethnic thinker, for, his ideas of critique and universalism unidirectionally rest on ‘to all’ rather than ‘from all.’ Consequently, it is missionary and borders on Islamophobia, particularly after 9/11. I show how Habermas’ denial of Palestinians’ genocide and his unqualified support to ‘Israel's right to exist’ as integral to Germany's ‘democratic ethos’ is neither an ample departure from his participation in the Hitler Youth nor from his understanding of the Enlightenment-modernity but largely their offshoots. I also juxtapose Habermas’ role as a public intellectual with that of Imam Malik (d. 795) who chose to be flogged rather than parrot unjust language of power elites. I conclude with three broad implications this article has in the field of teaching in higher education.},
  abstract_source = {s2},
}

