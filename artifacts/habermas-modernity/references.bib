@book{young1990justice,
  author = {Young, Iris Marion},
  title = {Justice and the Politics of Difference},
  year = {1990},
  publisher = {Princeton University Press},
  address = {Princeton},
  doi = {10.2307/j.ctvcm4g4q},
  note = {
  CORE ARGUMENT: Young challenges the distributive paradigm of justice and argues
  that oppression and domination -- structured group-based constraints on self-
  determination -- are the primary categories of social injustice. She criticizes
  deliberative theories, including Habermas', for assuming a homogeneous public
  and for privileging impartial, disembodied forms of reason. She calls for
  recognition of group difference in politics and for a "heterogeneous public"
  that can accommodate non-deliberative forms of expression.

  RELEVANCE: Young's critique of the ideal of impartiality and homogeneous publics
  in deliberative democracy is a central challenge to Habermas' public sphere
  framework. Her argument that deliberation masks structural privilege connects
  feminist critique with the broader critique of proceduralism.

  POSITION: Feminist critique of impartiality; politics of difference; group
  representation in deliberative democracy.
  },
  keywords = {Young, feminism, justice, deliberative-democracy, difference, politics, High},
  abstract = {This book challenges the prevailing philosophical reduction of social justice to distributive justice. It critically analyzes basic concepts underlying most theories of justice, including impartiality, formal equality, and the unitary moral subjectivity. Starting from claims of excluded groups about decision making, cultural expression, and division of labor, Iris Young defines concepts of domination and oppression to cover issues eluding the distributive model. Democratic theorists, according to Young do not adequately address the problem of an inclusive participatory framework. By assuming a homogeneous public, they fail to consider institutional arrangements for including people not culturally identified with white European male norms of reason and respectability. Young urges that normative theory and public policy should undermine group-based oppression by affirming rather than suppressing social group difference. Basing her vision of the good society on the differentiated, culturally plural network of contemporary urban life, she argues for a principle of group representation in democratic publics and for group-differentiated policies. "This is an innovative work, an important contribution to feminist theory and political thought, and one of the most impressive statements of the relationship between postmodernist critiques of universalism and concrete thinking.... Iris Young makes the most convincing case I know of for the emancipatory implications of postmodernism." --Seyla Benhabib, State University of New York at Stony Brook},
  abstract_source = {s2},
}

@book{young2000inclusion,
  author = {Young, Iris Marion},
  title = {Inclusion and Democracy},
  year = {2000},
  publisher = {Oxford University Press},
  address = {Oxford},
  doi = {10.1093/0198297556.001.0001},
  note = {
  CORE ARGUMENT: Young develops a comprehensive critique of deliberative democracy's
  communicative norms, arguing that requirements of argumentative rationality, civility,
  and common public interest systematically disadvantage marginalized groups. She proposes
  supplementing deliberation with greeting, rhetoric, and storytelling as legitimate
  political communication forms. The book also develops her theory of structural
  injustice and develops an account of differentiated solidarity.

  RELEVANCE: This is Young's most systematic engagement with deliberative democratic
  theory, including direct response to Habermasian models. It develops the feminist
  and postcolonial challenge to the norms embedded in the ideal speech situation and
  is essential for assessing whether Habermas' discourse ethics can be inclusively extended.

  POSITION: Feminist critique of deliberative norms; inclusive democratic communication.
  },
  keywords = {Young, deliberative-democracy, inclusion, feminist, communication, High},
  abstract = {Abstract Theorists of deliberative democracy have not sufficiently attended to the ways that processes of debate and decision making often marginalize individuals and groups not only because of their lesser social and economic power but also because the norms of political discussion are biased against some forms of expression. Democratic theory should include forms of acknowledgement, narrative, rhetoric, and public protest, along with argument, in its account of the normative ideals of political communication. Inclusive democracy involves more than the formal equality of all individuals and groups to enter the political process, but entails taking special measures to compensate for the social and economic inequalities of unjust social structures. Such special measures may require forms of group representation, in order that the particular social perspective of group members gains voice. Residential segregation poses particular problems for inclusive democracy in many societies. Organizing metropolitan governance systems with diverse representation may respond to such problems. In a globalized world, finally, the project of inclusive democracy involves criticizing adherence to nation‐state sovereignty and creating global level democratic institutions.},
  abstract_source = {openalex},
}

@article{young2001activist,
  author = {Young, Iris Marion},
  title = {Activist Challenges to Deliberative Democracy},
  journal = {Political Theory},
  year = {2001},
  volume = {29},
  number = {5},
  pages = {670--690},
  doi = {10.1177/0090591701029005004},
  note = {
  CORE ARGUMENT: Young argues that activist politics -- demonstrations, boycotts,
  consciousness-raising, direct action -- are not simply preludes to deliberation
  but constitute legitimate democratic practices in their own right. Deliberative
  norms assume conditions of equality that do not exist in unjust societies; activist
  challenges to deliberation are therefore expressions of democratic commitment
  rather than deviations from it. She develops a dialectic between activist and
  deliberative politics.

  RELEVANCE: This article directly challenges Habermas' account of legitimate
  political communication by expanding what counts as rational public discourse.
  It engages with the structural preconditions for ideal discourse and asks
  whether deliberative norms can be emancipatory in conditions of inequality.

  POSITION: Activist supplement to deliberative democracy; critique of deliberative
  proceduralism under structural inequality.
  },
  keywords = {Young, activism, deliberative-democracy, Habermas, political-theory, Medium},
  abstract = {It seems there is an insuperable contradiction between two conceptions of social change : one rooted in collective action and critique by activists, the other based on the construction of a collective agreement after a fair deliberation, as argued by deliberative democrats. Through a dialogue between these two positions, this essay casts a new light on certain limitations of deliberative democratic norms, especially in a context of wide structural inequalities, making public discussion hardly ever equitable. In so doing this essay emphasizes the democratic virtues of non-deliberative and contentious political practices. It is only by opening deliberation to non-argumentative and critical forms of expression that it can achieve its ideal of inclusion and social change.},
  abstract_source = {s2},
}

@book{benhabib1995feminist,
  author = {Benhabib, Seyla and Butler, Judith and Cornell, Drucilla and Fraser, Nancy},
  title = {Feminist Contentions: A Philosophical Exchange},
  year = {1995},
  publisher = {Routledge},
  address = {New York},
  note = {
  CORE ARGUMENT: This exchange collects essays by Benhabib, Butler, Cornell, and
  Fraser on the tensions between feminist theory, postmodernism, and normative political
  philosophy. Benhabib defends a "weak" universalism compatible with feminist critique;
  Butler challenges normative frameworks as inevitably exclusionary; Fraser mediates
  between the positions by distinguishing normative from descriptive uses of concepts.
  The volume crystallizes the key disputes within feminist critical theory about the
  adequacy of Habermasian frameworks.

  RELEVANCE: The exchange among these four thinkers is essential context for
  assessing the internal feminist debate over whether Habermasian communicative
  ethics can be reformed from within or must be rejected. It also captures the
  tension between feminist uses of Habermas and poststructuralist alternatives.

  POSITION: Feminist debate on universalism, postmodernism, and normative ethics;
  Benhabib's defense of transformative universalism.
  },
  keywords = {Benhabib, Butler, Fraser, feminist-theory, universalism, communicative-ethics, Medium, INCOMPLETE, no-abstract}
}

@article{couture1995feminist,
  author = {Couture, Tony},
  title = {Feminist Criticisms of {Habermas}'s Ethics and Politics},
  journal = {Dialogue},
  year = {1995},
  volume = {34},
  number = {2},
  pages = {259--280},
  doi = {10.1017/s0012217300014700},
  note = {
  CORE ARGUMENT: Couture surveys the major feminist criticisms of Habermas' discourse
  ethics and political theory, organized around three main objections: the gendered
  public/private split that Habermas inherits from liberal theory; the alleged
  masculinist bias in privileging argument-based reason over other forms of discourse;
  and the difficulty of including oppressed or marginalized groups in conditions of
  structural inequality. He assesses how much of the feminist critique can be
  absorbed by Habermas and how much represents a deeper challenge.

  RELEVANCE: This article provides a useful taxonomy of feminist objections to
  Habermas that helps structure the synthesis chapter. It distinguishes immanent
  feminist critique (Benhabib) from more radical feminist critiques (Young, Fraser)
  and assesses Habermas' capacity to respond.

  POSITION: Systematic survey of feminist-Habermas engagement; assesses scope of
  feminist critique.
  },
  keywords = {Couture, feminist-critique, Habermas, discourse-ethics, politics, Medium},
  abstract = {My project is to assess recent objections directed at Jürgen Habermas by Nancy Fraser, Iris Young and Seyla Benhabib. This dispute is significant because it concerns the value of the Enlightenment style, detached criticism promoted by Habermas as compared to new proposals about dissent from a stance connected to social movements. I argue that these feminist criticisms of Habermas's critical theory are compelling and that they require substantial changes in Habermas's thinking.},
  abstract_source = {openalex},
}

@book{bhambra2007rethinking,
  author = {Bhambra, Gurminder K.},
  title = {Rethinking Modernity: Postcolonialism and the Sociological Imagination},
  year = {2007},
  publisher = {Palgrave Macmillan},
  address = {Basingstoke},
  doi = {10.1057/9780230206410},
  note = {
  CORE ARGUMENT: Bhambra argues that the dominant sociological accounts of modernity
  -- Weberian rationalization, Habermasian communicative action, Eisenstadt's multiple
  modernities -- share a common Eurocentric assumption: that modernity originated
  internally within Europe and was then diffused outward. Against this, she argues
  that colonial connections were constitutive of European modernity itself, not merely
  its external effects. A "connected sociologies" approach requires including colonial
  and postcolonial histories within the explanatory framework of modernity, not
  treating them as local variants.

  RELEVANCE: Bhambra's critique of Habermas is among the most carefully argued
  postcolonial challenges to the Theory of Communicative Action. It targets Habermas'
  claim that modernity has an inner logic that can be reconstructed without taking
  colonial history seriously, and it has generated significant response in critical
  theory. Essential for the postcolonial section of the modernity review.

  POSITION: Postcolonial critique of Eurocentric sociological modernity; connected
  sociologies approach.
  },
  keywords = {Bhambra, postcolonial, modernity, Eurocentrism, connected-sociologies, High},
  abstract = {Arguing for the idea of connected histories, Bhambra presents a fundamental reconstruction of the idea of modernity in contemporary sociology. She criticizes the abstraction of European modernity from},
  abstract_source = {openalex},
}

@book{bhambra2014connected,
  author = {Bhambra, Gurminder K.},
  title = {Connected Sociologies},
  year = {2014},
  publisher = {Bloomsbury Academic},
  address = {London},
  doi = {10.5040/9781472544377},
  note = {
  CORE ARGUMENT: Bhambra extends her postcolonial critique of sociological theory into
  a methodological programme. "Connected sociologies" requires that all accounts of
  social phenomena incorporate global colonial histories as internal, not external,
  conditions. Applied to Habermas, this means that the lifeworld-system distinction
  and the colonization thesis cannot be made sense of without including colonial
  extraction as a formative system phenomenon -- a dimension Habermas consistently
  brackets.

  RELEVANCE: This book develops the programme introduced in Rethinking Modernity
  and extends it with reference to contemporary critical theory debates, including
  Habermas. It situates the postcolonial critique of Habermas within broader
  methodological debates in social theory.

  POSITION: Methodological postcolonialism; connected sociologies as alternative
  to Eurocentric social theory.
  },
  keywords = {Bhambra, postcolonial, connected-sociologies, methodology, social-theory, Medium},
  abstract = {<JATS1:p>This book outlines what theory for a global age might look like, positing an agenda for consideration, contestation and discussion, and a framework for the research-led volumes that follow in the series.</JATS1:p> <JATS1:p>Gurmider K. Bhambra takes up the classical concerns of sociology and social theory and shows how they are being rethought through an engagement with postcolonial studies, one of the most distinctive critical approaches of the past two decades. She also discusses the significance of the research programme surrounding coloniality and modernity that has emerged recently from Latin America.</JATS1:p>},
  abstract_source = {openalex},
}

@book{chakrabarty2000provincializing,
  author = {Chakrabarty, Dipesh},
  title = {Provincializing Europe: Postcolonial Thought and Historical Difference},
  year = {2000},
  publisher = {Princeton University Press},
  address = {Princeton},
  doi = {10.1515/9781400828654},
  note = {
  CORE ARGUMENT: Chakrabarty argues that European thought -- Enlightenment universalism,
  historicism, Habermasian modernity -- places non-European histories in a "waiting
  room" where they are figured as pre-modern, not-yet-rational, or traditional. He
  calls for "provincializing" European categories by showing how they suppress
  heterogeneous historical pasts and by developing "history 2" (subaltern, plural,
  non-homogenizing history) alongside the "history 1" of capital and Enlightenment
  rationality.

  RELEVANCE: Chakrabarty's critique of historicist teleology applies directly to
  Habermas' evolutionary theory of social rationalization, which places non-Western
  societies at earlier stages of a universal developmental trajectory. His work is
  central to the postcolonial critique of the implicit hierarchy in Habermas' theory
  of modernity.

  POSITION: Postcolonial critique of Enlightenment historicism; provincializing
  Europe as methodological programme.
  },
  keywords = {Chakrabarty, provincializing-Europe, postcolonial, historicism, modernity, High},
  abstract = {First published in 2000, Dipesh Chakrabarty's influential Provincializing Europe addresses the mythical figure of Europe that is often taken to be the original site of modernity in many histories of capitalist transition in non-Western countries. This imaginary Europe, Dipesh Chakrabarty argues, is built into the social sciences. The very idea of historicizing carries with it some peculiarly European assumptions about disenchanted space, secular time, and sovereignty. Measured against such mythical standards, capitalist transition in the third world has often seemed either incomplete or lacking. Provincializing Europe proposes that every case of transition to capitalism is a case of translation as well--a translation of existing worlds and their thought--categories into the categories and self-understandings of capitalist modernity. Now featuring a new preface in which Chakrabarty responds to his critics, this book globalizes European thought by exploring how it may be renewed both for and from the margins.},
  abstract_source = {openalex},
}

@article{dussel1993eurocentrism,
  author = {Dussel, Enrique},
  title = {Eurocentrism and Modernity (Introduction to the {Frankfurt} Lectures)},
  journal = {boundary 2},
  year = {1993},
  volume = {20},
  number = {3},
  pages = {65--76},
  doi = {10.2307/303341},
  note = {
  CORE ARGUMENT: Dussel argues that Habermas and Taylor share a Eurocentric assumption
  that modernity is an essentially European phenomenon whose origin lies in the
  Reformation, the Enlightenment, and German idealism. Dussel proposes that modernity
  actually begins in 1492 with the conquest of America, and that Europe's
  self-constitution as "center" of the world-system necessarily produced the
  "periphery" as its constitutive "other." The occlusion of the colonial encounter
  produces false universalism; a genuine alternative modernity would require incorporating
  the perspective of the colonized.

  RELEVANCE: Dussel develops the earliest and most direct confrontation between a
  Latin American liberation philosophy and Habermas' theory of modernity. His argument
  that Habermasian modernity is Euro-centric not accidentally but constitutively is
  essential for evaluating whether postcolonial critique requires fundamental revision
  of Habermas or only supplementation.

  POSITION: Liberation philosophy; transmodernity as alternative to Eurocentric
  modernity; 1492 as modernity's origin.
  },
  keywords = {Dussel, Eurocentrism, modernity, postcolonial, liberation-philosophy, High},
  abstract = {Modernity is, for many (for Jurgen Habermas or Charles Taylor, for example), an essentially or exclusively European phenomenon. In these lectures, I will argue that modernity is, in fact, a European phenomenon, but one constituted in a dialectical relation with a non-European alterity that is its ultimate content. Modernity appears when Europe affirms itself as the "center" of a World History that it inaugurates; the "periphery" that surrounds this center is consequently part of its self-definition. The occlusion of this periphery (and of the role of Spain and Portugal in the formation of the modern world system from the late fifteenth to the mid-seventeenth centuries) leads the major contemporary thinkers of the "center" into a Eurocentric fallacy in their understanding of modernity. If their understanding of the genealogy of modernity is thus partial and provincial, their attempts at a critique or defense of it are likewise unilateral and, in part, false.},
  abstract_source = {s2},
}

@book{bailey2014deprovincializing,
  author = {Bailey, Tom},
  title = {Deprovincializing {Habermas}: Global Perspectives},
  year = {2014},
  publisher = {Routledge India},
  doi = {10.4324/9781315734194},
  note = {
  CORE ARGUMENT: This edited volume assembles critical engagements with Habermas'
  political theory from non-Western perspectives, including Asian, African, Latin
  American, and Islamic standpoints. Rather than straightforwardly rejecting Habermas
  as Eurocentric, most contributors seek to reconstruct or "deprovincialize" his
  political theory by confronting it with non-Western contexts. The book also includes
  Habermas' own response to the charge of provincialism, making it a two-way
