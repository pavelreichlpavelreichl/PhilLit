@book{horkheimerAdorno1972dialectic,
  author = {Horkheimer, Max and Adorno, Theodor W.},
  title = {Dialectic of Enlightenment},
  year = {1972},
  publisher = {Herder and Herder},
  address = {New York},
  note = {
  CORE ARGUMENT: Horkheimer and Adorno argue that the Enlightenment project
  of demythologization turns against itself: the drive to master nature through
  instrumental reason reproduces the very domination it sought to overcome.
  All rationality collapses into the calculation of means, and myth itself is
  shown to have been a prefiguration of this instrumental logic. The culture
  industry chapter extends the diagnosis to mass culture, which they read as
  a mechanism for integrating individuals into the administered society.

  RELEVANCE: This text is the central object of Habermas' critique in The
  Theory of Communicative Action and The Philosophical Discourse of Modernity.
  Habermas takes issue with its monolithic account of rationality and its
  inability to ground normative critique, treating it as the pathological
  endpoint of a subject-centered philosophy of consciousness. Understanding
  the text is essential for understanding what Habermas is arguing against
  and what he aims to preserve from the critical tradition.

  POSITION: Foundational first-generation Frankfurt School; the paradigm case
  of "philosophy of the subject" that Habermas seeks to supersede.
  },
  keywords = {Frankfurt-School, Adorno, Horkheimer, instrumental-reason, Enlightenment, High, INCOMPLETE, no-abstract}
}

@article{habermas1982entwinement,
  author = {Habermas, Jurgen and Levin, Thomas Y.},
  title = {The Entwinement of Myth and Enlightenment: Re-Reading Dialectic of Enlightenment},
  journal = {New German Critique},
  year = {1982},
  issue = {26},
  pages = {13},
  doi = {10.2307/488023},
  note = {
  CORE ARGUMENT: Habermas reconstructs Horkheimer and Adorno's argument in the
  Dialectic of Enlightenment, accepting their diagnosis of the entwinement of
  myth and reason but contesting their conclusion that this exhausts the concept
  of reason. He argues that by abandoning the concept of communicative
  rationality — which retains emancipatory potential — they were left with a
