@book{neuhouser2008rousseautheodicy,
  author    = {Neuhouser, Frederick},
  title     = {Rousseau's Theodicy of Self-Love: Evil, Rationality, and the Drive for Recognition},
  year      = {2008},
  publisher = {Oxford University Press},
  doi       = {10.1093/acprof:oso/9780199542673.001.0001},
  note      = {CORE ARGUMENT: Neuhouser reconstructs Rousseau's theory of amour propre, arguing that it is not simply a vice but an inflamed form of the rational drive for recognition that, when properly ordered, is the basis of civic freedom and political community. RELEVANCE: Since Hegel explicitly inherits and transforms Rousseau's recognition-based social ontology (visible in the master-slave dialectic and Sittlichkeit), this study of the Rousseauian source illuminates what Hegel is appropriating and why the general will framework requires an institutional home. POSITION: Rational reconstruction of Rousseau's social psychology; foundational for the Rousseau-Hegel-Honneth lineage on recognition.},
  keywords  = {rousseau, amour-propre, recognition, social-freedom, Medium}
}

@article{church2010freedomdesire,
  author    = {Church, Jeffrey},
  title     = {The Freedom of Desire: Hegel's Response to Rousseau on the Problem of Civil Society},
  journal   = {American Journal of Political Science},
  year      = {2010},
  volume    = {54},
  number    = {1},
  pages     = {125--139},
  doi       = {10.1111/j.1540-5907.2009.00422.x},
  note      = {CORE ARGUMENT: Church argues that Hegel's theory of civil society constitutes a specific response to the Rousseauian problem of how to reconcile the particular desires of individuals with the general interest, proposing that Hegel's solution is to embed freedom in a system of needs where desire itself becomes rational. RELEVANCE: Directly addresses the Rousseau-Hegel transmission on the civil society question, providing fine-grained analysis of how Hegel transforms rather than merely inherits Rousseau's framework. POSITION: Critical theory of desire-based freedom within political economy.},
  keywords  = {hegel-rousseau, civil-society, desire, political-economy, Medium}
}

@article{clarke2011hegelcritiquefichte,
  author    = {Clarke, James},
  title     = {Hegel's Critique of Fichte in the 1802/3 Essay on Natural Right},
  journal   = {Inquiry},
  year      = {2011},
  volume    = {54},
  number    = {3},
  pages     = {207--225},
  doi       = {10.1080/0020174x.2011.574998},
  note      = {CORE ARGUMENT: Clarke reconstructs Hegel's critique of Fichte's formalist approach to natural law in the 1802/03 essay, arguing that Hegel's rejection of Fichte's deduction of right from pure practical reason is the key move that prepares the ground for his own ethical life (Sittlichkeit) framework. RELEVANCE: The 1802/03 Natural Law essay is the pivotal text in the transition from Hegel's early thought to the mature political philosophy; this article isolates the anti-Fichtean (and by extension anti-Kantian formalist) argument that drives the transition. POSITION: Developmental-historical reading of early Hegel's natural law essay.},
  keywords  = {natural-law, hegel-fichte, hegel-kant, 1802-essay, sittlichkeit, High}
}

@article{molloy2024hegelnatlaw,
  author    = {Molloy, Se\'{a}n},
  title     = {Hegel's First Attempt to Re-Philosophize Natural Law: Undistorted Intuition, Dead Laws and Ethical Life in `On the Scientific Ways of Treating Natural Law'},
  journal   = {Hegel Bulletin},
  year      = {2024},
  volume    = {46},
  number    = {3},
  pages     = {563--589},
  doi       = {10.1017/hgl.2024.51},
  note      = {CORE ARGUMENT: Molloy argues that received readings of Hegel's Natural Law essay distort its argument by assimilating it to other philosophers' frameworks; on a corrected reading, the essay establishes that empirical and formal approaches to natural law both fail because they abstract from the living ethical community (Sittlichkeit) that must be their actual ground. RELEVANCE: The most recent scholarly reconstruction of the 1802/03 essay and its critique of empirical natural law (Grotius, Hobbes) and formal natural law (Kant, Fichte), directly addressing how this essay sets up Hegel's mature political philosophy. POSITION: Revisionist reading against the dominant Ritter interpretation.},
  keywords  = {natural-law, 1802-essay, sittlichkeit, intellectual-background, High}
}
