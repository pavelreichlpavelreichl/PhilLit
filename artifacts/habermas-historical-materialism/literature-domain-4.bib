@misc{Habermas1979communication,
    author = {Habermas, J{\"u}rgen},
    title = "Communication and the Evolution of Society",
    year = "1979",
    doi = "10.2307/487856",
    note = {CORE ARGUMENT: This collection contains the programmatic essays "What Is Universal Pragmatics?" and "Toward a Reconstruction of Historical Materialism," in which Habermas appropriates Kohlberg's stage model of moral consciousness to construct a theory of social evolution driven by moral-practical learning rather than forces of production. Historical development is analyzed as the unfolding of successively more reflexive normative structures — from conventional to post-conventional morality — at the collective level. RELEVANCE: This is the primary source for Habermas's reconstruction of historical materialism as a theory of social evolution; it is indispensable for understanding how Piaget's cognitive-developmental model and Kohlberg's moral stage theory are transposed to the phylogenetic level of social formations. POSITION: Foundational statement of Habermas's developmental-logical theory of social evolution, positioning moral-practical learning as the evolutionary mechanism.},
    keywords = "social-evolution, developmental-logic, historical-materialism, moral-learning, Kohlberg, Piaget, High, METADATA\_CLEANED: type:@book->@misc"
}

@article{Habermas1975reconstruction,
    author = {Habermas, J{\"u}rgen},
    title = "Toward a Reconstruction of Historical Materialism",
    journal = "Theory and Society",
    year = "1975",
    volume = "2",
    pages = "287--300",
    doi = "10.1007/BF00212739",
    note = "CORE ARGUMENT: Habermas argues that historical materialism must be reconstructed around the evolution of normative structures and social learning rather than the development of productive forces, introducing the distinction between the logic of development (a reconstructible sequence of moral stages) and the dynamics of development (contingent historical triggers). Moral-practical learning in the intersubjective domain is posited as the primary mechanism of social evolution. RELEVANCE: This article is the earliest formulation of the key distinction between developmental logic and developmental dynamics, which is central to the project's concern with how Habermas displaces the Marxist production paradigm. POSITION: Programmatic reformulation of the evolutionary core of historical materialism within a communicative-action framework.",
    keywords = "historical-materialism, developmental-logic, social-evolution, moral-learning, High"
}

@article{Oh2023developmental,
    author = "Oh, Keunchang",
    title = "A Developmental Logic: {Habermas}'s Theory of Social Evolution",
    journal = "Theoria",
    year = "2023",
    doi = "10.1111/theo.12509",
    note = "CORE ARGUMENT: The paper reconstructs Habermas's theory of social norms and social evolution, focusing on the neglected distinction between developmental logic and developmental dynamics, and argues that Habermas underestimates developmental dynamics. Oh further distinguishes individual learning from social learning, contending that because social learning is non-cumulative (unlike phylogenetic cultural accumulation), learning does not guarantee social evolution as Habermas assumes. RELEVANCE: This is the most focused recent analysis of the logic/dynamics distinction at the center of Domain 4's inquiry, and directly engages Owen's and Allen's critiques of Habermas's evolutionism; it clarifies the conceptual architecture of Habermas's social evolution theory for the project's comparative purposes. POSITION: Internal critique of Habermas from within the reconstructive tradition, challenging the sufficiency of the learning-as-evolution model.",
    keywords = "developmental-logic, developmental-dynamics, social-learning, social-evolution, High"
}

@misc{Strydom1992ontogenetic,
    author = "Strydom, Piet",
    title = "The Ontogenetic Fallacy: The Immanent Critique of {Habermas}'s Developmental Logical Theory of Evolution",
    year = "1992",
    volume = "9",
    doi = "10.1177/026327692009003004",
    note = {CORE ARGUMENT: Strydom identifies and systematizes an immanent critique of Habermas developed by a circle of younger Frankfurt School authors (Honneth, Joas, Eder, Arnason), alleging that Habermas commits an "ontogenetic fallacy" — the illegitimate transfer of the developmental logic of individual cognitive ontogenesis to the level of collective social evolution — and surveys alternative approaches being developed within critical theory. RELEVANCE: This article is the defining articulation of the central methodological objection to Habermas's social evolution theory and documents the internal Frankfurt School debate about whether the Piaget-Kohlberg appropriation can be sustained; it is essential for assessing the limits of the developmental-logical framework. POSITION: Immanent critique from within critical theory, identifying the ontogenesis-phylogenesis analogy as the central flaw in Habermas's evolutionary theory.},
    keywords = "ontogenetic-fallacy, social-evolution, developmental-logic, Piaget, Frankfurt-School, High, METADATA\_CLEANED: journal, number, type:@article->@misc"
}

@misc{Strydom1987collective,
    author = "Strydom, Piet",
    title = "Collective Learning: {Habermas}'s Concessions and Their Theoretical Implications",
    year = "1987",
    volume = "13",
    note = "CORE ARGUMENT: Strydom examines Habermas's concessions to critics of his social evolution theory regarding the concept of collective learning, analyzing how Habermas's adjustments to accommodate critique generate new theoretical difficulties for the broader framework of reconstructed historical materialism. RELEVANCE: This article traces the internal development of Habermas's position under pressure from critics, showing how the concept of collective learning was refined and what theoretical costs those refinements incurred — directly relevant to the project's concern with the stability of learning as an evolutionary mechanism. POSITION: Critical reconstruction of the evolution of Habermas's own position on collective social learning.",
    keywords = "collective-learning, social-evolution, developmental-logic, High, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@article{Owen1998developmental,
    author = "Owen, David S.",
    title = "{Habermas}'s Developmental Logic Thesis: Universal or {Eurocentric}?",
    journal = "Philosophy Today",
    year = "1998",
    volume = "42",
    pages = "104--111",
    doi = "10.5840/PHILTODAY199842SUPPLEMENT68",
    note = "CORE ARGUMENT: Owen interrogates whether Habermas's developmental logic thesis — the claim that there is a universal, rationally reconstructible sequence of moral-evolutionary stages — is genuinely universal or whether it reflects a Eurocentric projection of a specifically Western developmental trajectory onto world history. RELEVANCE: This article provides a critical normative evaluation of the scope claims embedded in Habermas's social evolution theory, examining whether the stage model of worldview rationalization (mythical, religious-metaphysical, modern) can bear the weight of universalist claims the theory makes. POSITION: Postcolonial-inflected critique of the universalist pretensions of the developmental-logical framework.",
    keywords = "developmental-logic, Eurocentrism, social-evolution, worldview-rationalization, Medium"
}

@misc{Owen2012between,
    author = "Owen, David S.",
    title = "Between Reason and History: {Habermas} and the Idea of Progress",
    year = "2012",
    note = "CORE ARGUMENT: Owen provides the first book-length treatment in English of Habermas's theory of social evolution and progress, reconstructing its philosophical architecture — including the distinction between developmental logic and developmental dynamics, the appropriation of Piagetian and Kohlbergian stage theory, and the relation between progress, rationalization, and historical materialism. RELEVANCE: This monograph is the systematic secondary treatment of Domain 4's central topics, offering chapter-level analyses of the developmental theory of social evolution, the idea of a developmental logic of history, and Habermas's conception of progress. POSITION: Comprehensive reconstructive account of Habermas's evolutionism from a sympathetic but critical perspective.",
    keywords = "social-evolution, developmental-logic, progress, historical-materialism, Medium, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{Kirkpatrick2002evolution,
    author = "Kirkpatrick, Graeme",
    title = "Evolution or Progress? {A} ({Critical}) Defence of {Habermas}'s Theory of Social Development",
    year = "2002",
    note = "CORE ARGUMENT: Kirkpatrick defends Habermas's theory of social development against critics who conflate evolution with progress, arguing that the developmental-logical framework is compatible with a non-teleological account of historical change; the paper distinguishes what can and cannot be defended in Habermas's evolutionism. RELEVANCE: This provides a partial defense of the developmental-logical model and clarifies the distinction between normative reconstruction and empirical prediction, helping the project assess what exactly is at stake in the project's evaluation of Habermas's social evolution framework. POSITION: Qualified defense of Habermas's social evolutionism, distinguishing developmental logic from substantive teleology.",
    keywords = "social-evolution, developmental-logic, progress, Medium, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@article{Arnason1982universal,
    author = "Arnason, Johann P.",
    title = "Universal Pragmatics and Historical Materialism",
    journal = "Acta Sociologica",
    year = "1982",
    volume = "25",
    pages = "219--233",
    doi = "10.1177/000169938202500301",
    note = "CORE ARGUMENT: Arnason critically examines the relationship between Habermas's universal pragmatics — his theory of communicative competence grounded in speech-act validity claims — and the historical-materialist project of reconstructing social evolution, arguing that the former cannot straightforwardly ground a theory of the latter without confronting the problem of cultural diversity. RELEVANCE: This article situates the communicative-action framework within the broader context of historical materialism, addressing directly how universal pragmatics is meant to function as the normative basis for reconstructing evolutionary stages — a connection central to the project's analysis. POSITION: Immanent critique from a member of the Frankfurt School circle questioning the foundations of the communicative turn in historical materialism.",
    keywords = "universal-pragmatics, historical-materialism, social-evolution, communicative-action, Medium, METADATA\_CLEANED: number"
}

@article{Browne2019antinomies,
    author = "Browne, Craig",
    title = "The Antinomies of {Habermas}'s Reconstruction of Historical Materialism",
    journal = "Revista Inter-Legere",
    year = "2019",
    doi = "10.21680/1982-1662.2019V2N24ID17477",
    note = {CORE ARGUMENT: Browne argues that Habermas's major innovation — reconceptualizing the social relations of production as forms of social integration mediated by communication — is undermined by an "inflexible logic of development" and a disengagement from conflicts internal to material production; alternative contemporary social theories are proposed as resources for overcoming these limitations. RELEVANCE: This article directly addresses the project's question about how and whether Habermas's supplementation of the production paradigm with communicative learning succeeds, identifying the antinomies that result from the displacement of the economy by normative evolution. POSITION: Critique of Habermas's reconstruction from perspectives emphasizing social creativity, conflict, and institutional variation.},
    keywords = "historical-materialism, production-paradigm, social-evolution, communicative-action, Medium"
}

@misc{Delanty1997habermas,
    author = "Delanty, Gerard",
    title = "{Habermas} and Occidental Rationalism: The Politics of Identity, Social Learning, and the Cultural Limits of Moral Universalism",
    year = "1997",
    volume = "15",
    note = "CORE ARGUMENT: Delanty examines Habermas's theory of occidental rationalism and social learning, arguing that the cultural and political limits of Habermas's moral universalism are revealed by the politics of identity; the claim is that Habermas's evolutionary framework cannot adequately account for the particularist dimensions of collective identity formation. RELEVANCE: This article connects the social evolution thesis to debates about moral universalism and cultural particularity, which bears on the project's question about whether the moral-practical learning model provides a genuinely universal account of historical development or one that is culturally circumscribed. POSITION: Sociological critique of the cultural limits of Habermas's social learning model and its universalist moral claims.",
    keywords = "social-learning, moral-universalism, occidental-rationalism, worldview-rationalization, Medium, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@article{OrtegaEsquembre2018reception,
    author = "Ortega Esquembre, C{\'e}sar",
    title = "La recepci{\'o}n del pensamiento de {Marx} en el joven {Habermas}",
    journal = "Ideas y Valores",
    year = "2018",
    volume = "67",
    pages = "13--36",
    doi = "10.15446/IDEASYVALORES.V67N167.57601",
    note = "CORE ARGUMENT: The article analyzes how Habermas's early engagement with Marx — via Wellmer's critique of the Marxian historical materialism — shaped the formulation of his new theory of social evolution, showing which postulates of Marxism are transformed and which retained in Habermas's reconstructive project. RELEVANCE: This provides genealogical context for the project's central question about how Habermas's social evolution theory functions as a reconstruction of historical materialism, tracing the conceptual appropriation and transformation of Marx's framework. POSITION: Historical-reconstructive account of the Habermas-Marx relationship in the early theoretical development.",
    keywords = "historical-materialism, Marx, social-evolution, reconstruction, Low"
}

@misc{Mendieta2018axial,
    author = "Mendieta, Eduardo",
    title = "The Axial Age, Social Evolution, and Postsecular Consciousness",
    year = "2018",
    volume = "6",
    note = "CORE ARGUMENT: Mendieta examines how Habermas's theory of worldview rationalization — particularly the transition from mythical through religious-metaphysical to modern secular forms of consciousness — relates to Karl Jaspers's concept of the Axial Age, arguing that Habermas's postsecular turn reshapes but does not abandon the evolutionary framework. RELEVANCE: This connects the historical stages of worldview rationalization in Habermas's social evolution theory to the broader question of how religion and metaphysics function within developmental stages, addressing the project's interest in the evolutionary stage model. POSITION: Contextualizes Habermas's evolutionary stage model within debates about the axial age and postsecular theory.",
    keywords = "worldview-rationalization, axial-age, social-evolution, postsecular, Low, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@article{MejiaFernandez2022social,
    author = "Mej{\'i}a Fern{\'a}ndez, Ricardo and Romero, Javier",
    title = {Social Evolution in {J{\"u}rgen Habermas}: Towards a Weak Anthropological Naturalism between {Kant} and {Darwin}},
    journal = "Theoria",
    year = "2022",
    volume = "88",
    note = {CORE ARGUMENT: The article reconstructs Habermas's social evolution theory as a form of "weak anthropological naturalism" that mediates between Kantian normativism and Darwinian naturalism, showing how Habermas draws on evolutionary biology and developmental psychology while resisting a reductive naturalist account of social rationalization. RELEVANCE: This is directly relevant to understanding the philosophical foundations of Habermas's appropriation of Piaget's developmental psychology and the status of the normative claims embedded in the social evolution framework — central questions for the project's assessment of the theory's foundations. POSITION: Reconstructive philosophical account that situates Habermas's evolutionism within debates between naturalism and normativism.},
    keywords = "social-evolution, anthropological-naturalism, developmental-psychology, Piaget, Kant, Medium, METADATA\_CLEANED: number, pages"
}
