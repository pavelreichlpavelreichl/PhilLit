@article{habermas1975toward,
    author = "Habermas, J.",
    title = "Towards a reconstruction of historical materialism",
    journal = "Theory and Society",
    year = "1975",
    volume = "2",
    pages = "287--300",
    doi = "10.1007/BF00212739",
    note = "CORE ARGUMENT: Habermas argues that historical materialism must be reconstructed rather than restored: it conflates the logic of technical production (labor, purposive-rational action) with the logic of social evolution (communicative interaction and moral-practical development). He proposes that social evolution follows a developmental logic grounded in communicative competence, not in the growth of productive forces alone. RELEVANCE: This is the primary programmatic text for the domain; it establishes Habermas's own diagnosis of what is defective in Marx's framework and what the reconstruction must accomplish. It is the reference point for all secondary literature on Habermas's reading of classical historical materialism. POSITION: Habermas's own reformulation of Marxist social theory via the labor/interaction distinction.",
    keywords = "habermas, historical-materialism, reconstruction, labor-interaction, High"
}

@article{shoikhedbrod2024last,
    author = "Shoikhedbrod, Igor",
    title = "Still the ``Last Marxist''?",
    journal = "Res Philosophica",
    year = "2024",
    doi = "10.5840/resphilosophica20241012115",
    note = "CORE ARGUMENT: Habermas's recent engagement with Marx in Auch eine Geschichte der Philosophie (2019) has largely been overlooked; Shoikhedbrod traces two threads in Habermas's ongoing reconstruction---the labor/interaction distinction and the emancipatory potential of the democratic constitutional state---arguing that the reconstruction reveals genuine lacunae in Marx but also unacknowledged insights that Habermas has yet to adequately address. RELEVANCE: Provides an up-to-date assessment of Habermas's characterization of Marx across his career, with particular attention to how Habermas frames the deficiencies of classical historical materialism and what he takes the reconstruction to achieve. POSITION: Sympathetic critique arguing Habermas should more explicitly reclaim the Marxian heritage.",
    keywords = "habermas, marx, reconstruction, labor-interaction, constitutional-state, High"
}

@article{arnason1979rekonstruktion,
    author = "{\'{A}}rnason, J. P.",
    title = "Zur Rekonstruktion des historischen Materialismus",
    journal = "Telos",
    year = "1979",
    volume = "1979",
    pages = "201--218",
    doi = "10.3817/0379039201",
    note = "CORE ARGUMENT: Arnason's critical review of Habermas's book of the same title argues that the reconstruction, while departing from classical Marxism's productivism, imports its own developmental-logical framework that remains teleological; the essay examines the adequacy of Habermas's characterization of Marx's original theory as reductivist and monistic. RELEVANCE: One of the earliest and most cited scholarly responses to Habermas's 1976 book, directly assessing whether his portrait of orthodox historical materialism is accurate and whether the reconstruction solves the problems it identifies. POSITION: Immanent critique from within the Frankfurt School orbit, challenging both Habermas's reading of Marx and the coherence of the proposed reconstruction.",
    keywords = "habermas, historical-materialism, arnason, reconstruction-critique, High"
}

@misc{reichelt2000reconstruction,
    author = "Reichelt, H.",
    title = {J{\"u}rgen Habermas' Reconstruction of Historical Materialism},
    year = "2000",
    pages = "105--145",
    note = "CORE ARGUMENT: Reichelt critically examines Habermas's reconstruction as presented in the 1976 book, arguing that Habermas misreads the categorial structure of Marx's Capital---specifically the value-form analysis---by reducing Marx's framework to a simple base-superstructure model and a philosophy of labor, which distorts what historical materialism actually claims. RELEVANCE: Offers a detailed philological critique of Habermas's characterization of classical Marxist theory, directly relevant to understanding where Habermas's reading is selective or reductive in its target. POSITION: Marxian value-theoretic critique of Habermas's reconstruction.",
    keywords = "habermas, marx, value-form, reconstruction-critique, High, METADATA\_CLEANED: doi"
}

@article{keane1975tools,
    author = "Keane, John L.",
    title = "On Tools and Language: Habermas on Work and Interaction",
    journal = "New German Critique",
    year = "1975",
    pages = "82",
    doi = "10.2307/487655",
    note = "CORE ARGUMENT: Keane examines Habermas's foundational distinction between work (purposive-rational action) and interaction (communicative action), tracing its roots in the early Frankfurt School and in Habermas's reading of Hegel and Marx; he questions whether the distinction adequately captures the dialectical relationship between labor and language in Marx's own texts. RELEVANCE: Directly addresses the conceptual foundation on which Habermas constructs his critique of orthodox historical materialism, providing close analysis of how Habermas characterizes the Marxist category of labor. POSITION: Early critical engagement with the labor/interaction distinction as the hinge of Habermas's reconstruction.",
    keywords = "habermas, work, interaction, labor, historical-materialism, High"
}

@misc{bidet2008falling,
    author = "Bidet, Jacques",
    title = "Chapter Thirty-Six. Falling short of Marx: Habermas",
    year = "2008",
    doi = "10.1163/ej.9789004145986.i-813.187",
    note = "CORE ARGUMENT: Bidet argues that Habermas, from The Transformation of the Public Sphere through Legitimation Crisis, consistently refers to Marx but ultimately falls short of Marx's analytical achievements: Habermas restores the ideological unity of the category of productive force that Marx's analysis had shattered, and his conceptual separation of economics and politics reverses Marx's anti-liberal and anti-positivist breakthrough. RELEVANCE: Directly evaluates Habermas's characterization of historical materialism as a foil for his own theory, arguing that Habermas's Marx is a simplified reconstruction that loses what is most distinctive about Marxian political economy. POSITION: Marxist political-economic critique of Habermas's engagement with classical historical materialism.",
    keywords = "habermas, marx, historical-materialism, productive-force, legitimation-crisis, High"
}

@article{ortegaesquembre2018recepcion,
    author = "Ortega Esquembre, C{\'e}sar",
    title = "La recepci{\'o}n del pensamiento de Marx en el joven Habermas",
    journal = "Ideas Y Valores",
    year = "2018",
    volume = "67",
    pages = "13--36",
    doi = "10.15446/IDEASYVALORES.V67N167.57601",
    note = "CORE ARGUMENT: Analyzes the influence of Marx's thought on the formulation of Habermas's early theory, beginning from Wellmer's and Habermas's critiques of the Marxian conception of historical materialism, and then examines how Habermas reconstructs key postulates of Marxism on the basis of a new theory of social evolution, identifying which basic assumptions of Marx's theory are transformed in Habermas's conceptualization. RELEVANCE: Traces the genesis of Habermas's reading of Marx, showing which aspects of classical historical materialism Habermas retains, which he transforms, and how this shapes his later theory of communicative action. POSITION: Intellectual-historical reconstruction of the early Habermas-Marx relationship.",
    keywords = "habermas, marx, social-evolution, early-critical-theory, Medium"
}

@misc{giddens1982labour,
    author = "Giddens, Anthony",
    title = "Labour and Interaction",
    year = "1982",
    pages = "100--116",
    note = "CORE ARGUMENT: Giddens reads Habermas's project as centrally concerned with the reconstruction of historical materialism---a critical reformulation of Marx at both the meta-theoretical level and the level of industrial capitalism's development; he examines Habermas's work/interaction distinction and argues that, while it corrects productivism, it creates new difficulties in accounting for the interpenetration of the two domains. RELEVANCE: Provides a leading social theorist's close reading of Habermas's reconstruction program, including direct quotation of Habermas's methodological self-description, useful for understanding how Habermas frames his own departure from orthodox Marxism. POSITION: Sympathetic but critical social-theoretical engagement with Habermas's reconstruction framework.",
    keywords = "habermas, giddens, labour, interaction, reconstruction, Medium, METADATA\_CLEANED: doi"
}

@article{guanguiqin2008historical,
    author = "Guan, Gui-qin",
    title = "Historical Materialism in the Context of Reconstruction---Study on The Different Historical Concept between Marx and Habermas",
    journal = "Journal of Inner Mongolia University for Nationalities",
    year = "2008",
    note = "CORE ARGUMENT: Argues that Habermas considers Marx's historical materialism---formed under the conditions of liberal capitalism---inadequate for explaining advanced capitalist society, and thus proposes a reconstruction grounded in communicative action theory; the article contends that Habermas actually misinterprets the basic theory of historical materialism in this process and therefore does not achieve a genuine reconstruction. RELEVANCE: Offers a direct comparative analysis of Marx's and Habermas's historical concepts, directly addressing the question of how Habermas characterizes and reframes classical historical materialism. POSITION: Critical reading from a Marxist perspective arguing Habermas misreads his own target.",
    keywords = "habermas, marx, historical-materialism, communicative-action, reconstruction-critique, Medium"
}

@misc{strydom1992ontogenetic,
    author = "Strydom, Piet",
    title = "The Ontogenetic Fallacy: The Immanent Critique of Habermas's Developmental Logical Theory of Evolution",
    year = "1992",
    doi = "10.1177/026327692009003004",
    note = "CORE ARGUMENT: Strydom documents an immanent critique of Habermas's theory of socio-cultural evolution---which is central to his reconstruction of historical materialism---developed by younger Frankfurt School theorists (Arnason, Honneth, Joas, Eder); the critique targets Habermas's application of Piagetian developmental logic to social evolution as the ontogenetic fallacy, i.e., illegitimately projecting individual cognitive stages onto collective social processes. RELEVANCE: Situates Habermas's evolutionary framework for reconstructing historical materialism within its critical reception, showing how the developmental-logical scaffolding Habermas uses to replace classical Marxist stagism has been contested from within critical theory. POSITION: Immanent critique of the developmental logic at the core of Habermas's reconstruction.",
    keywords = "habermas, social-evolution, ontogenetic-fallacy, developmental-logic, reconstruction-critique, Medium, METADATA\\_CLEANED: journal, type:@article->@misc"
}

@article{raes1986legalisation,
    author = "Raes, Koen",
    title = "Legalisation, Communication and Strategy: A Critique of Habermas' Approach to Law",
    journal = "Journal of Law and Society",
    year = "1986",
    doi = "10.2307/1410280",
    note = "CORE ARGUMENT: Raes traces Habermas's reconstruction of historical materialism as the grounding for his approach to law and intersubjectivity: Habermas seeks to correct both Marx and Freud by recovering the intersubjective and communicative dimensions that their authors had neglected in favor of objectivistic frameworks, combining Fichte's concept of self-reflection with hermeneutics to produce a reconstructed historical materialism. RELEVANCE: Articulates how Habermas's characterization of the deficiency of orthodox historical materialism---its objectivism and neglect of communicative self-understanding---drives his broader theoretical project, including his account of law and legitimacy. POSITION: Critical analysis of Habermas's reconstruction as background to his legal theory.",
    keywords = "habermas, historical-materialism, law, intersubjectivity, communicative-action, Medium"
}

@article{stahl2013immanent,
    author = "Stahl, Titus",
    title = "Habermas and the Project of Immanent Critique",
    journal = "Constellations",
    year = "2013",
    doi = "10.1111/1467-8675.12057",
    note = "CORE ARGUMENT: Stahl examines how Habermas's Theory of Communicative Action offers a new account of the normative foundations of critical theory, locating normative demands within the socially instituted practice of communicative understanding; this involves a departure from the Marxian model in which normative critique is grounded in the logic of historical materialism. RELEVANCE: Clarifies the relationship between Habermas's communicative turn and the normative strategy of classical historical materialism, showing what Habermas takes to be inadequate in grounding critique in production relations and what he substitutes. POSITION: Systematic philosophical account of Habermas's normative departure from historical-materialist critique.",
    keywords = "habermas, immanent-critique, communicative-action, normative-foundations, Low"
}

@misc{habermas1971knowledge,
    author = {Habermas, J{\"u}rgen},
    title = "Knowledge and Human Interests",
    year = "1972",
    note = {CORE ARGUMENT: Habermas distinguishes three knowledge-constitutive interests---technical, practical, and emancipatory---grounded respectively in work, language (interaction), and critical self-reflection. The book argues that positivism suppresses the difference between technical control and genuine understanding, just as Marx suppressed the independent weight of communicative interaction by reducing species self-formation to labor. RELEVANCE: This is the foundational text for Habermas's critique of Marx's productivism: by showing that different cognitive interests generate incommensurable forms of knowledge, Habermas establishes that the paradigm of labor cannot be the sole carrier of emancipatory potential, since communicative and reflective interests operate by a distinct logic. The concept of an "emancipatory interest" grounded in self-reflection, not production, is the seed of communicative action theory. POSITION: Foundational statement of the labor/interaction distinction and the critique of Marx's reduction of the species' self-formative process to instrumental action.},
    keywords = "labor-interaction, knowledge-interests, critique-of-Marx, High, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@article{habermas1975reconstruction,
    author = {Habermas, J{\"u}rgen},
    title = "Towards a reconstruction of historical materialism",
    journal = "Theory and Society",
    year = "1975",
    volume = "2",
    pages = "287--300",
    doi = "10.1007/BF00212739",
    note = {CORE ARGUMENT: Habermas argues that historical materialism must be reconstructed, not rejected, by separating the logic of social evolution into two distinct tracks: the development of productive forces and the evolution of normative structures (moral-practical learning). Marx's error was to model the latter on the former, producing a latent Hegelian philosophy of history in materialist dress that makes normative progress a mere epiphenomenon of economic development. RELEVANCE: This article presents Habermas's positive programmatic alternative to the Marxist theory of history, directly addressing the "productivist" and "objectivist" deficiencies he diagnoses: normative learning has its own developmental logic tied to communicative competence, not to forces of production. It is the theoretical bridge between Knowledge and Human Interests and The Theory of Communicative Action. POSITION: Programmatic statement of Habermas's reconstructive approach to historical materialism, central to the normative deficit diagnosis.},
    keywords = "historical-materialism, reconstruction, normative-structures, social-evolution, High"
}

@misc{habermas1987tca2,
    author = {Habermas, J{\"u}rgen},
    title = "The Theory of Communicative Action, Volume 2: Lifeworld and System---A Critique of Functionalist Reason",
    year = "1987",
    note = {CORE ARGUMENT: Volume 2 develops the system/lifeworld distinction and applies it as a diagnostic of modernity: the "colonization of the lifeworld" by system imperatives (money and power) replaces communicative coordination with steering media. Habermas's critique of Marx becomes explicit here: Marxism misdiagnoses capitalist pathologies as contradictions in the system of production rather than as the one-sided rationalization of the lifeworld and the uncoupling of system and lifeworld. RELEVANCE: The deepening of the productivist critique of Marxism: Habermas argues that both orthodox Marxism and Second International theory remained trapped in the paradigm of production, unable to theorize legitimation crises, cultural impoverishment, or the normative dimensions of modernity. The shift to a communicative paradigm is presented as the solution to classical Marxism's theoretical shortcomings. POSITION: Mature statement of Habermas's communicative alternative to the Marxist paradigm of production; central to the critique of labor monism.},
    keywords = "lifeworld, system, colonization, communicative-action, critique-of-Marx, productivism, High, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@misc{habermas1987tca1,
    author = {Habermas, J{\"u}rgen},
    title = "The Theory of Communicative Action, Volume 1: Reason and the Rationalization of Society",
    year = "1984",
    note = "CORE ARGUMENT: Volume 1 constructs the theory of communicative rationality and surveys classical social theory (Marx, Weber, Mead, Durkheim, Parsons) as a prehistory of the lifeworld/system problematic. Habermas argues that Marx, despite identifying the contradiction between use-value and exchange-value, lacked a theory of communicative action and therefore could not explain the normative integration that capitalism simultaneously presupposes and erodes. RELEVANCE: Establishes the meta-theoretical framework---communicative vs. strategic action, formal vs. substantive rationality---that underwrites the critique of historical materialism's objectivism and its failure to distinguish technical and practical reason. Marx's identification of labor as sole medium of social constitution is shown to be a theoretically inadequate starting point for a critical theory of modernity. POSITION: Theoretical groundwork for Habermas's paradigm shift from production to communication as the basis of social theory.",
    keywords = "communicative-action, rationalization, critique-of-Marx, objectivism, High, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@article{antonio1989normative,
    author = "Antonio, Robert J.",
    title = "The Normative Foundations of Emancipatory Theory: Evolutionary Versus Pragmatic Perspectives",
    journal = "American Journal of Sociology",
    year = "1989",
    doi = "10.1086/229066",
    note = {CORE ARGUMENT: Antonio argues that Habermas's attempt to provide normative foundations for emancipatory critical theory through an evolutionary framework ultimately undermines the sociological powers of both Marx and Weber by subordinating historical analysis to a pseudohistorical normative argument. The evolutionary logic imports a covert teleology that contradicts the pragmatist orientation Habermas himself appropriates. RELEVANCE: Directly addresses the "normative deficit" that Habermas diagnoses in Marxism and asks whether Habermas's own solution---grounding norms in an evolutionary account of communicative competence---does not reproduce the philosophical-of-history deficiency it purports to correct. Essential for evaluating the adequacy of Habermas's normative reconstruction. POSITION: Critical perspective on the normative foundations of Habermas's reconstruction, arguing the evolutionary framework generates its own theoretical liabilities.},
    keywords = "normative-foundations, emancipatory-theory, evolutionary-theory, critique-of-Habermas, Medium"
}

@article{browne2019antinomies,
    author = "Browne, C.",
    title = "The Antinomies of {H}abermas' Reconstruction of Historical Materialism",
    journal = "Revista Inter-Legere",
    year = "2019",
    doi = "10.21680/1982-1662.2019V2N24ID17477",
    note = "CORE ARGUMENT: Browne identifies internal contradictions in Habermas's reconstruction of historical materialism: while Habermas's key innovation is reconceptualizing relations of production as forms of social integration mediated by systematically distorted communication, his framework is limited by an inflexible logic of development and a disengagement from conflicts internal to material production. RELEVANCE: Offers a balanced assessment of what Habermas's reconstruction achieves (a theory of ideology as distorted communication, a non-reductive account of normative structures) and where it fails (an over-schematic developmental logic, incomplete engagement with class conflict). Directly addresses both the strengths and weaknesses of the critique of historical materialism. POSITION: Represents an internal reconstruction that accepts Habermas's diagnosis of Marxism's shortcomings but argues the reconstructive program is itself incomplete.",
    keywords = "historical-materialism, reconstruction, antinomies, social-integration, Medium"
}

@article{finlayson2009morality,
    author = "Finlayson, J. G.",
    title = "Morality and Critical Theory: On the Normative Problem of {F}rankfurt {S}chool Social Criticism",
    journal = "Telos",
    year = "2009",
    volume = "2009",
    pages = "41--7",
    doi = "10.3817/0309146007",
    note = {CORE ARGUMENT: Finlayson reconstructs the "normative problem" that runs through Frankfurt School critical theory from Horkheimer to Habermas: the difficulty of grounding social criticism without appealing to a substantive moral theory that critical theory itself tends to undermine. Habermas's solution via discourse ethics is assessed as a significant advance but not a complete resolution. RELEVANCE: Places Habermas's critique of historical materialism's "normative deficit" within the broader Frankfurt School problematic: the diagnosis that Marxism lacks adequate normative foundations is not unique to Habermas but represents a central preoccupation of critical theory, and Habermas's communicative ethics is his distinctive response. Essential for understanding why the normative deficit diagnosis is philosophically pressing. POSITION: Situates Habermas's normative reconstruction in the context of the broader Frankfurt School tradition, tracking the shift from immanent critique to discourse ethics.},
    keywords = "normative-foundations, Frankfurt-School, critical-theory, discourse-ethics, High"
}

@article{prasai2024lifeworldization,
    author = "Prasai, Khagendra",
    title = "{H}abermas's Emancipation as Lifeworldization",
    journal = "New German Critique",
    year = "2024",
    doi = "10.1215/0094033x-11165849",
    note = {CORE ARGUMENT: Prasai argues that Habermas's distinction between his own utopia (preserving societal differentiation) and Marx's (dissolving it into a unified social whole) is not as clean as Habermas presents: his "radical democratic utopia" entails what Prasai calls "lifeworldization"---the primacy of communicative reason across all spheres---which undermines the system/lifeworld dualism that is supposed to differentiate Habermas from Marx. RELEVANCE: Shows that the very move by which Habermas distances himself from Marx's productivism (the system/lifeworld distinction) generates its own instabilities. The article clarifies the internal logic of Habermas's critique of historical materialism by revealing the tension between the diagnostic and the normative dimensions of his project. POSITION: Recent critical reading that interrogates the coherence of Habermas's normative alternative to Marx, relevant to the question of whether the critique of historical materialism's "latent Hegelian philosophy of history" is fully resolved.},
    keywords = "lifeworld, system, emancipation, critique-of-Marx, lifeworldization, Medium"
}

@article{arnason2025aristotle,
    author = "{\' A}rnason, Vilhj{\'a}lmur",
    title = "The Right Use of Reason in the Moral Theories of {A}ristotle and {H}abermas",
    journal = "Filozofia",
    year = "2025",
    doi = "10.31577/filozofia.2025.80.6.1",
    note = "CORE ARGUMENT: Arnason examines Habermas's appropriation of the Aristotelian distinction between technical and moral reason, arguing that while this distinction permeates Habermas's thought and underwrites the labor/interaction dichotomy, Habermas's emphasis on decontextualized norm-justification in discourse ethics diverges from Aristotle's focus on contextualized practical wisdom (phronesis). The paper argues that Aristotelian practical wisdom could strengthen discourse ethics but that Habermas's neo-Aristotelian reading blocks this. RELEVANCE: Provides a philosophical genealogy of the technical/practical reason distinction that is foundational to Habermas's critique of Marx's conflation of these two domains. By tracing this to Aristotle, the article situates Habermas's labor/interaction distinction within a long tradition of distinguishing poiesis from praxis, illuminating what is at stake philosophically in Habermas's critique of historical materialism. POSITION: Philosophical-historical perspective connecting the technical/practical reason distinction to its Aristotelian roots and assessing its implications for Habermas's normative theory.",
    keywords = "technical-reason, practical-reason, Aristotle, labor-interaction, normative-foundations, Low"
}

@misc{flynn2014system,
    author = "Flynn, Jeffrey",
    title = "System and lifeworld in {H}abermas' theory of democracy",
    year = "2014",
    volume = "40",
    pages = "205--214",
    doi = "10.1177/0191453713518326",
    note = {CORE ARGUMENT: Flynn examines the function of the system/lifeworld distinction in Habermas's democratic theory, arguing that the distinction carries the weight of both descriptive and normative work: it both explains how modern societies reproduce themselves and specifies which forms of integration are pathological. The analysis clarifies how the critique of "colonization" operationalizes Habermas's diagnosis of what is wrong with capitalist modernity. RELEVANCE: The system/lifeworld distinction is the theoretical successor to the labor/interaction distinction within The Theory of Communicative Action, and Flynn's analysis helps clarify how Habermas's critique of historical materialism's productivist paradigm is institutionalized in a theory of democratic pathology. Relevant to understanding how the normative deficit diagnosis is translated into a diagnostic framework for modernity. POSITION: Interpretive work clarifying the dual (descriptive/normative) function of the system/lifeworld distinction as it builds on the earlier critique of historical materialism.},
    keywords = "system-lifeworld, democracy, communicative-action, colonization, Low, METADATA\\_CLEANED: journal, type:@article->@misc"
}

@misc{Habermas1979communication,
    author = {Habermas, J{\"u}rgen},
    title = "Communication and the Evolution of Society",
    year = "1979",
    note = {CORE ARGUMENT: This collection gathers essays including "Toward a Reconstruction of Historical Materialism," "Moral Development and Ego Identity," and "Legitimation Problems in the Modern State," working out the species-competence thesis: communicative, moral-practical, and cognitive capacities of the species constitute the evolutionary learning mechanisms that historical materialism misidentifies as productive forces alone. RELEVANCE: Provides the substantive content of the reconstruction -- the role of universal pragmatics, ego-identity, and moral consciousness -- that must be understood before the system/lifeworld distinction in TCA can be grasped as a further development. POSITION: Primary Habermas text; the intermediate stage between the early 1975 article and the full TCA account.},
    keywords = "historical-materialism, species-competences, social-evolution, communicative-action, High, METADATA\\_CLEANED: publisher, type:@book->@misc"
}

@article{Pedersen2008method,
    author = "Pedersen, J{\o}rgen",
    title = "Habermas' Method: Rational Reconstruction",
    journal = "Philosophy of the Social Sciences",
    year = "2008",
    doi = "10.1177/0048393108319024",
    note = {CORE ARGUMENT: Pedersen clarifies what rational reconstruction consists in as a method: it occupies a space between the transcendental and the purely empirical, reconstructing the implicit know-how of competent speakers/actors into explicit rules, while remaining open to empirical disconfirmation. He shows how the method operates in two of Habermas's research programs (universal pragmatics and discourse ethics) and argues that the key unresolved problem is testability -- it is not clear how to falsify a reconstructive hypothesis. RELEVANCE: Directly addresses the methodological question central to this domain: what does "reconstruction" mean as a philosophical procedure, and what is its epistemic status relative to purely empirical social science? POSITION: Methodological analysis; sympathetic but identifies the testability problem as a fundamental difficulty.},
    keywords = "rational-reconstruction, methodology, universal-pragmatics, High"
}

@article{Shoikhedbrod2024lastmarxist,
    author = "Shoikhedbrod, Igor",
    title = "Still the ``{Last Marxist}''?: {Habermas}'s Ongoing ``{Reconstruction}'' of Historical Materialism",
    journal = "Res Philosophica",
    year = "2024",
    note = "CORE ARGUMENT: Shoikhedbrod examines two guiding threads in Habermas's reconstruction: the labour/interaction distinction (which points to lacunae in Marx's reduction of social relations to productive forces) and the emancipatory potential of the democratic constitutional state (which takes over where Marx's revolutionary proletariat fails). He argues the reconstruction reveals important insights in Marx still underaddressed by Habermas himself. RELEVANCE: Among the most recent sustained analyses of what Habermas retains versus revises from Marx, covering both the early reconstruction and Habermas's later work, making it useful for tracking the development of the program across decades. POSITION: Sympathetic reconstruction; argues for a productive tension between Habermas and Marx rather than a clean break.",
    keywords = "historical-materialism, labour-interaction, reconstruction, Marx, Medium, METADATA\\_CLEANED: volume, number, pages"
}

@misc{Rockmore1979reconstruction,
    author = "Rockmore, Tom",
    title = "Habermas and the Reconstruction of Historical Materialism",
    year = "1979",
    volume = "13",
    pages = "195--206",
    note = "CORE ARGUMENT: Rockmore maps Habermas's engagement with Marx as a four-stage process -- interpretation, critique, reconstruction, and rejection -- and argues that the reconstruction, despite its innovations, ultimately backtracks into a German idealist theory of reason by restoring a quasi-transcendental subject in the form of communicative rationality. RELEVANCE: An early and influential critique that frames the reconstruction as incomplete: Habermas escapes base/superstructure determinism but at the cost of an idealist residue, which is directly relevant to evaluating the system/lifeworld replacement. POSITION: Critical; the idealism objection to the reconstruction program.",
    keywords = "historical-materialism, reconstruction, communicative-rationality, idealism, Medium, METADATA\\_CLEANED: journal, number, doi, type:@article->@misc"
}

@article{Misgeld1981hermeneutics,
    author = "Misgeld, Diester",
    title = "Habermas's Retreat from Hermeneutics: Systems Integration, Social Integration and the Crisis of Legitimation",
    journal = "Ctheory",
    year = "1981",
    volume = "5",
    pages = "8--44",
    note = "CORE ARGUMENT: Misgeld argues that Habermas's turn to systems theory (Parsons/Luhmann) to handle system integration represents a retreat from his earlier hermeneutic commitments: social integration through communicative understanding is supplemented by, but risks being subordinated to, a functionalist account of systemic reproduction that is opaque to the actors within it. RELEVANCE: Directly addresses the social integration/system integration distinction and its implications for the two-level model of society, which is precisely how Habermas recasts the base/superstructure problem. POSITION: Critical of the systems-theoretic turn; argues it creates a tension with the hermeneutic and normative dimensions of the project.",
    keywords = "social-integration, system-integration, systems-theory, hermeneutics, Medium"
}

@misc{Teymoori2025identity,
    author = "Teymoori, Ali and Mataji, Amin",
    title = "Is it possible to form a rational identity? A critical reading of {Habermas}' account of social identity",
    year = "2025",
    doi = "10.1177/01914537251348412",
    note = "CORE ARGUMENT: Teymoori and Mataji argue that Habermas's procedural account of social identity is undermined by the stage-based framework of his historical account of societal evolution and by the insubstantial nature of social identity in his linguistic theory. They challenge the separation of system and lifeworld as a ground for social identity, arguing that rational identity must be rooted in both domains. RELEVANCE: Engages the species-competences thesis (identity as a reconstructed capacity) and the system/lifeworld distinction, providing a recent critical perspective on how those two pillars of the reconstruction relate to each other. POSITION: Critical; the stage-based framework and the system/lifeworld split are treated as mutually reinforcing limitations.",
    keywords = "social-identity, system-lifeworld, stage-based-evolution, species-competences, Medium, METADATA\\_CLEANED: journal, type:@article->@misc"
