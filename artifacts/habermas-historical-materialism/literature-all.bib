    note = "CORE ARGUMENT: Brand argues that Habermas's colonization thesis, by reducing political pathologies to systemic intrusions into the lifeworld, paradoxically undermines the autonomous political sphere that Arendt's action theory defends; the system/lifeworld distinction depoliticizes capitalist domination. RELEVANCE: Raises the core critical challenge to TCA's reconstitution of Marxian critique: if class conflict is recast as lifeworld pathology, the specifically political dimension of emancipation is obscured. This objection bears directly on Between Facts and Norms's subsequent attempt to reintegrate law and democracy into the Habermasian framework. POSITION: Critique of the colonization thesis as depoliticizing; draws on Arendt as a counterpoint to Habermas.",
    keywords = "colonization-thesis, politics, Arendt, lifeworld, Medium"
}

@article{ivkovic2010colonizationlifeworld,
    author = "Ivkovic, Marjan",
