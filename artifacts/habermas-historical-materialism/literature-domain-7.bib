@misc{heath2009habermas,
    author = "Heath, Joseph",
    title = "Habermas and Analytical Marxism",
    year = "2009",
    volume = "35",
    note = "Heath argues that both Habermas and the analytical Marxists, despite very different starting points, progressively talked themselves out of Marxism as they updated its foundations — Habermas by replacing labor with communicative action, the analytical Marxists by adopting rational-choice theory. The paper directly illuminates how Habermas's reconstruction of historical materialism severed the normative core of Marx's project from its materialist base, a central tension for any contemporary revival of Habermasian HM.",
    keywords = "habermas, analytical-marxism, historical-materialism, reconstruction, High, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@misc{dorahy2021habermas,
    author = "Dorahy, J. F.",
    title = "Habermas and the Critique of Political Economy",
    year = "2021",
    note = {Dorahy examines Habermas's substantive engagement with Marx's critique of political economy, arguing that Habermas's early diagnosis of the "primacy of the political" in late capitalism represents a significant departure from Marxist economic categories that shaped broader late-20th-century critical theory. This situates the HM reconstruction debate within the longer arc of Habermas's break from the Frankfurt School's political-economy orientation.},
    keywords = "habermas, political-economy, marx, late-capitalism, High, METADATA\_CLEANED: journal, volume, number, pages, type:@article->@misc"
}

@misc{pinzani2022habermas,
    author = "Pinzani, Alessandro",
    title = "Habermas and Capitalism: An Historic Overview",
    year = "2022",
    volume = "27",
    note = "Pinzani reconstructs Habermas's diagnoses of late capitalism from the 1970s through his later writings, engaging Streeck's charge that Habermas systematically underestimates capitalism's role in shaping the global order by fixating on bureaucracy and legality rather than economic structure. The piece directly bears on the question of whether Habermas's mature theory retains the normative resources of his earlier HM reconstruction or has fully displaced them.",
    keywords = "habermas, capitalism, streeck, legitimation, High, METADATA\_CLEANED: journal, number, pages, type:@article->@misc"
}

@article{shoikhedbrod2024last,
    author = "Shoikhedbrod, Igor",
    title = "Still the ``Last Marxist''?",
    journal = "Res Philosophica",
    year = "2024",
    note = {Shoikhedbrod interrogates the label of Habermas as the "last Marxist," assessing how far his legal and democratic theory retains a recognizably Marxist character after the communicative turn. The paper engages Habermas's ongoing debate with Streeck and is relevant for evaluating what, if anything, survives of Habermas's 1970s HM reconstruction in his later political philosophy.},
    keywords = "habermas, marxism, legal-philosophy, streeck, Medium, METADATA\_CLEANED: volume, number, pages"
}

@misc{shoikhedbrod2020revolution,
    author = "Shoikhedbrod, Igor",
    title = "Revolution or Legality? Confronting the Spectre of Marx in {Habermas}'s Legal Philosophy",
    note = "Shoikhedbrod argues that Habermas's theoretical dichotomy between revolution and legality reflects an ambivalent relationship to Marx's legacy, and examines its significance for Habermas's debate with Streeck on the tension between democracy and capitalism. The paper is relevant as a genealogical account of how Habermas's departure from HM shaped his normative theory of law and democratic legitimacy.",
    keywords = "habermas, marx, legal-philosophy, revolution, Medium, METADATA\_CLEANED: type:@article->@misc"
}

@misc{heath2017legitimation,
    author = "Heath, Joseph",
    title = {`{Legitimation} Crisis' in the Later Work of {J\"{u}rgen Habermas}},
    note = "Heath traces how Habermas's legitimation-crisis framework was revised across his later works, examining whether the original Marxist diagnosis of structural crisis tendencies in capitalism was preserved, attenuated, or abandoned. This provides essential context for assessing the continuity — or discontinuity — between Habermas's 1970s HM reconstruction and his mature communicative-action theory.",
    keywords = "habermas, legitimation-crisis, late-capitalism, reconstruction, High, METADATA\_CLEANED: type:@article->@misc"
}

@misc{sitton2003habermas,
    author = "Sitton, John",
    title = "Habermas and Contemporary Society",
    year = "2003",
    note = "Sitton reconstructs Habermas's substantive theory of contemporary capitalist society, tracing how Habermas builds on Weber's diagnosis of modernity to analyze the colonization of the lifeworld by systemic imperatives of money and power. The book provides a comprehensive account of how Habermas's systems/lifeworld dualism functions as a replacement for classical historical-materialist categories while preserving normative critical purchase.",
    keywords = "habermas, capitalism, lifeworld, systems-theory, Medium, METADATA\_CLEANED: type:@book->@misc"
}
