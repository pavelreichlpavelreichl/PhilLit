@article{habermas1975toward,
    author = "Habermas, J.",
    title = "Towards a reconstruction of historical materialism",
    journal = "Theory and Society",
    year = "1975",
    volume = "2",
    pages = "287--300",
    doi = "10.1007/BF00212739",
    note = "CORE ARGUMENT: Habermas argues that historical materialism must be reconstructed rather than restored: it conflates the logic of technical production (labor, purposive-rational action) with the logic of social evolution (communicative interaction and moral-practical development). He proposes that social evolution follows a developmental logic grounded in communicative competence, not in the growth of productive forces alone. RELEVANCE: This is the primary programmatic text for the domain; it establishes Habermas's own diagnosis of what is defective in Marx's framework and what the reconstruction must accomplish. It is the reference point for all secondary literature on Habermas's reading of classical historical materialism. POSITION: Habermas's own reformulation of Marxist social theory via the labor/interaction distinction.",
    keywords = "habermas, historical-materialism, reconstruction, labor-interaction, High"
}

@article{shoikhedbrod2024last,
    author = "Shoikhedbrod, Igor",
    title = "Still the ``Last Marxist''?",
    journal = "Res Philosophica",
    year = "2024",
    doi = "10.5840/resphilosophica20241012115",
    note = "CORE ARGUMENT: Habermas's recent engagement with Marx in Auch eine Geschichte der Philosophie (2019) has largely been overlooked; Shoikhedbrod traces two threads in Habermas's ongoing reconstruction---the labor/interaction distinction and the emancipatory potential of the democratic constitutional state---arguing that the reconstruction reveals genuine lacunae in Marx but also unacknowledged insights that Habermas has yet to adequately address. RELEVANCE: Provides an up-to-date assessment of Habermas's characterization of Marx across his career, with particular attention to how Habermas frames the deficiencies of classical historical materialism and what he takes the reconstruction to achieve. POSITION: Sympathetic critique arguing Habermas should more explicitly reclaim the Marxian heritage.",
    keywords = "habermas, marx, reconstruction, labor-interaction, constitutional-state, High"
}

@article{arnason1979rekonstruktion,
    author = "{\'{A}}rnason, J. P.",
    title = "Zur Rekonstruktion des historischen Materialismus",
    journal = "Telos",
    year = "1979",
    volume = "1979",
    pages = "201--218",
    doi = "10.3817/0379039201",
    note = "CORE ARGUMENT: Arnason's critical review of Habermas's book of the same title argues that the reconstruction, while departing from classical Marxism's productivism, imports its own developmental-logical framework that remains teleological; the essay examines the adequacy of Habermas's characterization of Marx's original theory as reductivist and monistic. RELEVANCE: One of the earliest and most cited scholarly responses to Habermas's 1976 book, directly assessing whether his portrait of orthodox historical materialism is accurate and whether the reconstruction solves the problems it identifies. POSITION: Immanent critique from within the Frankfurt School orbit, challenging both Habermas's reading of Marx and the coherence of the proposed reconstruction.",
    keywords = "habermas, historical-materialism, arnason, reconstruction-critique, High"
}

@misc{reichelt2000reconstruction,
    author = "Reichelt, H.",
    title = {J{\"u}rgen Habermas' Reconstruction of Historical Materialism},
    year = "2000",
    pages = "105--145",
    note = "CORE ARGUMENT: Reichelt critically examines Habermas's reconstruction as presented in the 1976 book, arguing that Habermas misreads the categorial structure of Marx's Capital---specifically the value-form analysis---by reducing Marx's framework to a simple base-superstructure model and a philosophy of labor, which distorts what historical materialism actually claims. RELEVANCE: Offers a detailed philological critique of Habermas's characterization of classical Marxist theory, directly relevant to understanding where Habermas's reading is selective or reductive in its target. POSITION: Marxian value-theoretic critique of Habermas's reconstruction.",
    keywords = "habermas, marx, value-form, reconstruction-critique, High, METADATA\_CLEANED: doi"
}

@article{keane1975tools,
    author = "Keane, John L.",
    title = "On Tools and Language: Habermas on Work and Interaction",
    journal = "New German Critique",
    year = "1975",
    pages = "82",
    doi = "10.2307/487655",
    note = "CORE ARGUMENT: Keane examines Habermas's foundational distinction between work (purposive-rational action) and interaction (communicative action), tracing its roots in the early Frankfurt School and in Habermas's reading of Hegel and Marx; he questions whether the distinction adequately captures the dialectical relationship between labor and language in Marx's own texts. RELEVANCE: Directly addresses the conceptual foundation on which Habermas constructs his critique of orthodox historical materialism, providing close analysis of how Habermas characterizes the Marxist category of labor. POSITION: Early critical engagement with the labor/interaction distinction as the hinge of Habermas's reconstruction.",
    keywords = "habermas, work, interaction, labor, historical-materialism, High"
}

@misc{bidet2008falling,
    author = "Bidet, Jacques",
    title = "Chapter Thirty-Six. Falling short of Marx: Habermas",
    year = "2008",
    doi = "10.1163/ej.9789004145986.i-813.187",
    note = "CORE ARGUMENT: Bidet argues that Habermas, from The Transformation of the Public Sphere through Legitimation Crisis, consistently refers to Marx but ultimately falls short of Marx's analytical achievements: Habermas restores the ideological unity of the category of productive force that Marx's analysis had shattered, and his conceptual separation of economics and politics reverses Marx's anti-liberal and anti-positivist breakthrough. RELEVANCE: Directly evaluates Habermas's characterization of historical materialism as a foil for his own theory, arguing that Habermas's Marx is a simplified reconstruction that loses what is most distinctive about Marxian political economy. POSITION: Marxist political-economic critique of Habermas's engagement with classical historical materialism.",
    keywords = "habermas, marx, historical-materialism, productive-force, legitimation-crisis, High"
}

@article{ortegaesquembre2018recepcion,
    author = "Ortega Esquembre, C{\'e}sar",
    title = "La recepci{\'o}n del pensamiento de Marx en el joven Habermas",
    journal = "Ideas Y Valores",
    year = "2018",
    volume = "67",
    pages = "13--36",
    doi = "10.15446/IDEASYVALORES.V67N167.57601",
    note = "CORE ARGUMENT: Analyzes the influence of Marx's thought on the formulation of Habermas's early theory, beginning from Wellmer's and Habermas's critiques of the Marxian conception of historical materialism, and then examines how Habermas reconstructs key postulates of Marxism on the basis of a new theory of social evolution, identifying which basic assumptions of Marx's theory are transformed in Habermas's conceptualization. RELEVANCE: Traces the genesis of Habermas's reading of Marx, showing which aspects of classical historical materialism Habermas retains, which he transforms, and how this shapes his later theory of communicative action. POSITION: Intellectual-historical reconstruction of the early Habermas-Marx relationship.",
    keywords = "habermas, marx, social-evolution, early-critical-theory, Medium"
}

@misc{giddens1982labour,
    author = "Giddens, Anthony",
    title = "Labour and Interaction",
    year = "1982",
    pages = "100--116",
    note = "CORE ARGUMENT: Giddens reads Habermas's project as centrally concerned with the reconstruction of historical materialism---a critical reformulation of Marx at both the meta-theoretical level and the level of industrial capitalism's development; he examines Habermas's work/interaction distinction and argues that, while it corrects productivism, it creates new difficulties in accounting for the interpenetration of the two domains. RELEVANCE: Provides a leading social theorist's close reading of Habermas's reconstruction program, including direct quotation of Habermas's methodological self-description, useful for understanding how Habermas frames his own departure from orthodox Marxism. POSITION: Sympathetic but critical social-theoretical engagement with Habermas's reconstruction framework.",
    keywords = "habermas, giddens, labour, interaction, reconstruction, Medium, METADATA\_CLEANED: doi"
}

@article{guanguiqin2008historical,
    author = "Guan, Gui-qin",
    title = "Historical Materialism in the Context of Reconstruction---Study on The Different Historical Concept between Marx and Habermas",
    journal = "Journal of Inner Mongolia University for Nationalities",
    year = "2008",
    note = "CORE ARGUMENT: Argues that Habermas considers Marx's historical materialism---formed under the conditions of liberal capitalism---inadequate for explaining advanced capitalist society, and thus proposes a reconstruction grounded in communicative action theory; the article contends that Habermas actually misinterprets the basic theory of historical materialism in this process and therefore does not achieve a genuine reconstruction. RELEVANCE: Offers a direct comparative analysis of Marx's and Habermas's historical concepts, directly addressing the question of how Habermas characterizes and reframes classical historical materialism. POSITION: Critical reading from a Marxist perspective arguing Habermas misreads his own target.",
    keywords = "habermas, marx, historical-materialism, communicative-action, reconstruction-critique, Medium"
}

@misc{strydom1992ontogenetic,
    author = "Strydom, Piet",
    title = "The Ontogenetic Fallacy: The Immanent Critique of Habermas's Developmental Logical Theory of Evolution",
    year = "1992",
    doi = "10.1177/026327692009003004",
    note = "CORE ARGUMENT: Strydom documents an immanent critique of Habermas's theory of socio-cultural evolution---which is central to his reconstruction of historical materialism---developed by younger Frankfurt School theorists (Arnason, Honneth, Joas, Eder); the critique targets Habermas's application of Piagetian developmental logic to social evolution as the ontogenetic fallacy, i.e., illegitimately projecting individual cognitive stages onto collective social processes. RELEVANCE: Situates Habermas's evolutionary framework for reconstructing historical materialism within its critical reception, showing how the developmental-logical scaffolding Habermas uses to replace classical Marxist stagism has been contested from within critical theory. POSITION: Immanent critique of the developmental logic at the core of Habermas's reconstruction.",
    keywords = "habermas, social-evolution, ontogenetic-fallacy, developmental-logic, reconstruction-critique, Medium, METADATA\\_CLEANED: journal, type:@article->@misc"
}

@article{raes1986legalisation,
    author = "Raes, Koen",
    title = "Legalisation, Communication and Strategy: A Critique of Habermas' Approach to Law",
    journal = "Journal of Law and Society",
    year = "1986",
    doi = "10.2307/1410280",
    note = "CORE ARGUMENT: Raes traces Habermas's reconstruction of historical materialism as the grounding for his approach to law and intersubjectivity: Habermas seeks to correct both Marx and Freud by recovering the intersubjective and communicative dimensions that their authors had neglected in favor of objectivistic frameworks, combining Fichte's concept of self-reflection with hermeneutics to produce a reconstructed historical materialism. RELEVANCE: Articulates how Habermas's characterization of the deficiency of orthodox historical materialism---its objectivism and neglect of communicative self-understanding---drives his broader theoretical project, including his account of law and legitimacy. POSITION: Critical analysis of Habermas's reconstruction as background to his legal theory.",
    keywords = "habermas, historical-materialism, law, intersubjectivity, communicative-action, Medium"
}

@article{stahl2013immanent,
    author = "Stahl, Titus",
    title = "Habermas and the Project of Immanent Critique",
    journal = "Constellations",
    year = "2013",
    doi = "10.1111/1467-8675.12057",
    note = "CORE ARGUMENT: Stahl examines how Habermas's Theory of Communicative Action offers a new account of the normative foundations of critical theory, locating normative demands within the socially instituted practice of communicative understanding; this involves a departure from the Marxian model in which normative critique is grounded in the logic of historical materialism. RELEVANCE: Clarifies the relationship between Habermas's communicative turn and the normative strategy of classical historical materialism, showing what Habermas takes to be inadequate in grounding critique in production relations and what he substitutes. POSITION: Systematic philosophical account of Habermas's normative departure from historical-materialist critique.",
    keywords = "habermas, immanent-critique, communicative-action, normative-foundations, Low"
}
