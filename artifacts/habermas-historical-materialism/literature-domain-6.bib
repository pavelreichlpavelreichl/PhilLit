@misc{Honneth1991critique,
    author = "Honneth, Axel",
    title = "The Critique of Power: Reflective Stages in a Critical Social Theory",
    year = "1991",
    doi = "10.2307/2075917",
    note = "CORE ARGUMENT: Honneth's foundational critique of both first-generation Frankfurt School critical theory and Habermas argues that Habermas's systems-theoretic dualism — dividing society into a normatively integrated lifeworld and functionally reproduced systems (money, power) — renders invisible the social struggles and power relations through which social reproduction is actually contested and transformed. By treating the economy and state as norm-free systems, Habermas forecloses the possibility of theorizing resistance and social conflict in terms of communicative and moral resources deployed within economic and political institutions themselves. RELEVANCE: This is the central text for understanding the immanent Frankfurt School critique of Habermas's reconstruction of historical materialism; it directly challenges Habermas's framework from within critical theory and provides the theoretical basis for Honneth's subsequent recognition theory as an alternative. POSITION: Accepts the communicative turn but rejects the systems-theoretic dualism as theoretically untenable and politically paralyzing.",
    keywords = "Honneth, systems-theory, power, critical-theory, High, METADATA\_CLEANED: type:@book->@misc"
}

@article{Ivkovic2015domination,
    author = "Ivkovic, Marjan",
    title = "The concept of social domination in Axel Honneth's critical theory",
    journal = "Sociologija",
    year = "2015",
    volume = "57",
    pages = "5--24",
    doi = "10.2298/soc1501005i",
    note = "CORE ARGUMENT: Reconstructs Honneth's early critique of Habermas in the Critique of Power, showing that Honneth sought to theorize social reproduction in action-theoretic terms — as shaped by inter-group dynamics of social conflict and domination — rather than Habermas's systems-theoretic approach. The paper traces how Honneth's critique of Habermas motivates the move to recognition theory while noting that social domination recedes from the center of Honneth's mature perspective. RELEVANCE: Provides a detailed secondary reconstruction of Honneth's specific objections to Habermas's reconstruction of historical materialism, clarifying the theoretical stakes of the transition from Habermas's framework to recognition theory. POSITION: Maps the internal Frankfurt School critique and its evolution from Honneth's early action-theoretic Marxism to his mature recognition theory.",
    keywords = "Honneth, domination, recognition, systems-theory, Medium"
}

@misc{Fraser1989unruly,
    author = "Fraser, Nancy",
    title = "Unruly Practices: Power, Discourse and Gender in Contemporary Social Theory",
    year = "1989",
    doi = "10.2307/1395284",
    note = "CORE ARGUMENT: Fraser's essays offer a feminist critique of Habermas's Theory of Communicative Action, arguing that his framework misclassifies the gender division of labor by treating the domestic sphere as exclusively lifeworld (communicatively integrated) rather than recognizing that domestic labor is simultaneously symbolic and economic. The public/private distinction central to Habermas's critical theory reproduces rather than interrogates the ideological separation that disadvantages women, and his needs interpretation framework fails to account for the political contestation over what counts as a need. RELEVANCE: Directly addresses the domain's key question about whether Habermas's reconstruction neglects class and gender in favor of communicative idealism; Fraser's critique from feminist political economy is one of the most influential challenges to the reconstruction. POSITION: Rejects Habermas's system/lifeworld dualism and public/private distinction as gender-blind, calling for integration of political economy with discourse analysis.",
    keywords = "Fraser, feminism, political-economy, gender, High, METADATA\_CLEANED: type:@book->@misc"
}

@article{Jutten2011colonization,
    author = {J{\"u}tten, Timo},
    title = "The Colonization Thesis: Habermas on Reification",
    journal = "International Journal of Philosophical Studies",
    year = "2011",
    doi = "10.1080/09672559.2011.629672",
    note = "CORE ARGUMENT: Argues that Habermas's colonization thesis — that reification arises when the communicative infrastructure of the lifeworld is colonized by money and power — remains compelling thirty years after the Theory of Communicative Action, but that Habermas's normative criticism of reification remains implicit and underdeveloped. A key weakness is Habermas's suggestion that reification effects follow from juridification of communicatively structured domains but not from the commodification of labor power, which Jütten criticizes as an inconsistency that privileges the lifeworld over economic relations. RELEVANCE: Engages directly with the Marxist charge that Habermas's framework systematically deprioritizes political economy by showing that the exclusion of labor commodification from the colonization thesis has normative consequences that Habermas never adequately justified. POSITION: Partially accepts the colonization thesis while exposing a significant inconsistency that suggests Habermas's framework is indeed biased against economic critique.",
    keywords = "reification, colonization, lifeworld, political-economy, Medium"
}

@article{Antonio1989normative,
    author = "Antonio, Robert J.",
    title = "The Normative Foundations of Emancipatory Theory: Evolutionary Versus Pragmatic Perspectives",
    journal = "American Journal of Sociology",
    year = "1989",
    doi = "10.1086/229066",
    note = "CORE ARGUMENT: Argues that Habermas's extensive reconstruction of Marx and Weber in the Theory of Communicative Action resorts to an evolutionary normative argument — grounding emancipatory claims in a quasi-biological theory of social learning stages — that both undermines the sociological powers of the classical theories it appropriates and contradicts the historicism of the American pragmatism it also draws upon. The evolutionary framework imposes a teleological narrative that contradicts Habermas's own anti-metaphysical commitments. RELEVANCE: Provides a sociological assessment of the Piagetian/Kohlbergian developmental framework that Habermas uses to reconstruct historical materialism, directly addressing the key question of whether this evolutionary theory is defensible. POSITION: Rejects the evolutionary normative justification as philosophically inconsistent and proposes pragmatist historicism as an alternative foundation for emancipatory theory.",
    keywords = "evolutionary-theory, pragmatism, normative-foundations, emancipation, High"
}

@misc{Lotz2015oberflache,
    author = "Lotz, Christian",
    title = {An der Oberfl{\"a}che der Tauschgesellschaft: Kritik der Kritischen Theorie},
    year = "2015",
    volume = "45",
    doi = "10.32387/PROKLA.V45I180.212",
    note = "CORE ARGUMENT: Argues that Habermas, Honneth, and Jaeggi's normative turn in critical theory — the introduction of a communicative and ethical paradigm — entails a loss of the dialectical concept of society and a non-normative concept of critique adequate to capitalist social totality. The paper calls for a return to a Marxian concept of critique as analysis of capitalist social totality constituted by money and labor, rather than grounding critique in ethical or communicative norms. RELEVANCE: Represents the strongest form of the charge that Habermas's shift from labor to communication is an instance of normative idealism that abandons the political economy dimension of critical theory; directly addresses the question of whether the reconstruction de-radicalizes Marxism. POSITION: Rejects the communicative turn entirely as ethical idealism and calls for return to Marxist critique of political economy.",
    keywords = "political-economy, idealism, Marxism, social-totality, High, METADATA\_CLEANED: type:@article->@misc"
}

@misc{Bohman1999marxism,
    author = "Bohman, James",
    editor = "Dews, Peter",
    title = "Habermas, Marxism and Social Theory: The Case for Pluralism in Critical Social Science",
    year = "1999",
    pages = "53--86",
    note = "CORE ARGUMENT: Examines Habermas's early work as a form of analytical Marxism — updating Marxism with state-of-the-art social science — but argues that Habermas, like the analytical Marxists, talked himself out of Marxism in any recognizable sense. The essay makes the case for theoretical pluralism in critical social science rather than a unified meta-theory of either communicative action or historical materialism. RELEVANCE: Situates Habermas's reconstruction within the broader trajectory of post-Marxist social theory, providing historical context for the charge that the reconstruction represents a retreat from Marxism toward liberal social theory. POSITION: Accepts the diagnosis that Habermas departed from Marxism but advocates methodological pluralism rather than a return to orthodox categories.",
    keywords = "analytical-Marxism, pluralism, critical-social-science, Medium, METADATA\_CLEANED: booktitle, type:@incollection->@misc"
}

@misc{Heath2014analytical,
    author = "Heath, Joseph",
    title = "Habermas and Analytical Marxism",
    year = "2014",
    note = "CORE ARGUMENT: Argues that Habermas's early work qualifies as that of an analytical Marxist in that both projects attempted to update Marxism with rigorous social science; the essay traces how, despite very different starting points, both Habermas and the analytical Marxists ended up talking themselves out of recognizably Marxist positions. This convergence reveals structural tendencies in any project that attempts to reconstruct Marxism on non-dogmatic social scientific grounds. RELEVANCE: Provides a comparative intellectual history that places Habermas's reconstruction in the context of the broader failure of post-war Marxist theory to preserve both scientific rigor and revolutionary normativity — directly relevant to the question of whether Habermas de-radicalizes Marxism. POSITION: Diagnoses the departure from Marxism as a structural outcome of the modernization of Marxist theory rather than an ideological choice.",
    keywords = "analytical-Marxism, de-radicalization, intellectual-history, Medium, METADATA\_CLEANED: type:@article->@misc"
}

@misc{Friberg2022criticizing,
    author = "Friberg, Carsten",
    title = "Criticizing critique: A discussion of Asger S{\o}rensen's Capitalism, Alienation and Critique",
    year = "2022",
    volume = "48",
    pages = "153--154",
    doi = "10.1177/01914537211059511",
    note = "CORE ARGUMENT: Discusses Sorensen's defence of classical critical theory against Habermas's call for a paradigm shift from consciousness to communication and Honneth's restricted social philosophy. Sorensen argues that the shift to communicative reason entails abandonment of uncompromising critique of political economy, capitalism, and ideology, and that a comprehensive critical theory must retain both the epistemology and dialectical metaphysics of classical critical theory. RELEVANCE: Engages the central question of whether Habermas's reconstruction de-radicalizes Marxism by abandoning critique of capitalism, framing the issue as a paradigm choice between communicative reason and dialectical materialism. POSITION: Advocates retention of political economy and dialectics against the communicative paradigm, representing the strongest form of the Marxist objection to Habermas.",
    keywords = "political-economy, classical-critical-theory, paradigm-shift, Marxism, Medium, METADATA\_CLEANED: journal, type:@article->@misc"
}

@misc{Sharlamanov2019liberalism,
    author = "Sharlamanov, Kire",
    title = "Habermas between Critical Theory and Liberalism",
    year = "2019",
    note = "CORE ARGUMENT: Identifies Habermas's normative idealism as the key turning point in his departure from Marxism: by insisting on the independence of the normative from material reality and severing the connection between base and superstructure, Habermas constructed a discursive theory that, especially from the late 1980s, takes liberal ideas seriously at the expense of critical materialist categories. The book traces turning points in Habermas's theoretical development and his transition from critical theory toward liberalism. RELEVANCE: Directly addresses the charge of liberalism and reformism leveled against Habermas's reconstruction, arguing that normative idealism — the hallmark of his post-Marxist theory — is what enables his convergence with liberalism. POSITION: Accepts the charge that Habermas has moved from critical theory to liberalism via normative idealism, rejecting the reconstruction as incompatible with Marxist materialism.",
    keywords = "liberalism, normative-idealism, base-superstructure, de-radicalization, Medium, METADATA\_CLEANED: type:@book->@misc"
}

@article{Lebow2023value,
    author = "Lebow, David G.",
    title = "The value form and the wounds of neoliberalism",
    journal = "Constellations",
    year = "2023",
    doi = "10.1111/1467-8675.12706",
    note = "CORE ARGUMENT: Argues that value form theory — combining Marxist critique of capitalist social relations with Frankfurt School recognition theory — provides a better framework for understanding neoliberal pathologies than either Habermas's colonization thesis or Foucauldian approaches. The paper argues that the fetishistic separation of economic and political discourses institutionalized by capitalist law is the fundamental developmental pathology of capitalist society, and that Habermas's colonization metaphor misdiagnoses this as external system intrusion rather than internal structural contradiction. RELEVANCE: Illustrates the contemporary development of value form theory as an alternative to Habermas that retains political economy critique; represents the trajectory of Marxist critical theory that explicitly breaks with Habermas's reconstruction. POSITION: Rejects Habermas's colonization framework in favor of value form theory, continuing the charge that Habermas fails to adequately theorize capitalist social relations.",
    keywords = "value-form, neoliberalism, colonization-thesis, political-economy, Low"
}
