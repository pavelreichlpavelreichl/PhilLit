@article{passmore1975poverty,
  author  = {Passmore, John},
  title   = {The Poverty of Historicism Revisited},
  journal = {History and Theory},
  year    = {1975},
  volume  = {14},
  number  = {4},
  pages   = {30},
  doi     = {10.2307/2504664},
  note    = {
  CORE ARGUMENT: Passmore argues that Popper's use of "historicism" is
  too sweeping and poorly defined, conflating at least three distinct positions:
  (1) a theory about the aims of the social sciences; (2) a way of practicing
  them; and (3) a comprehensive philosophical worldview. When examined precisely,
  Popper's logical argument against long-range prediction turns out to target
  only one of these, and imprecisely at that. Passmore concludes that Popper
  has sketched arguments that could be developed against certain forms of
  "evolutionary historicism" but has not provided the clean refutation he claims.

  RELEVANCE: This is one of the most careful analytic critiques of Popper's
  anti-historicism and is essential for any assessment of the Popperian case
  against the speculative tradition. It shows that the strength of Popper's
  argument depends critically on which version of historicism is in view, a
  point directly relevant to any project distinguishing Popper's usage from
  historians' usage of the same term.

  POSITION: Internal critique of Popperian anti-historicism; questions the
  precision and adequacy of Popper's central argument.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, historicism,
  abstract = {The Poverty of Historicism was designed as a political pamphlet, a tract for its times, as its dedication makes very clear: memory of the countless men and women of all creeds or nations or races who fell victims to the fascist and communist belief in Inexorable Laws of Human Destiny.' Historicism, as Popper understands it, is not just an intellectual error, of interest only to professional philosophers; it is a prime source of moral and political devastation. It carries with it, or is used to justify, a particular attitude to political reform. For a Popper-defined historicist, political reform, if it is to have any hope of being efficacious, must work with historical laws to change the entire condition of society; for Popper himself it should proceed by piece-meal engineering by setting up, in an experimental spirit, new institutions or attempting to improve, in that same spirit, the manner of working of existing institutions. In short, in attacking historicism, Popper was attacking totalitarianism and defending a meliorist democracy or, more accurately, since Popper has no great political expectations, a democracy which will do something to lessen human suffering.2 He was writing at a time, it must also be remembered, when to call Marxism scientific was to recommend it. (Nowadays to call it humanistic has the same effect.) Popper was particularly,},
  abstract_source = {openalex},
              critique-of-Popper, High}
}

@article{urbach1978popper,
  author  = {Urbach, Peter},
  title   = {Is Any of {Popper}'s Arguments Against Historicism Valid?},
  journal = {The British Journal for the Philosophy of Science},
  year    = {1978},
  volume  = {29},
  number  = {2},
  pages   = {117--130},
  doi     = {10.1093/bjps/29.2.117},
  note    = {
  CORE ARGUMENT: Urbach systematically examines each of Popper's arguments
  against historicism in The Poverty of Historicism and concludes that none
  of them is valid. The central "growth of knowledge" argument is faulted for
  depending on a questionable premise about the impossibility of self-prediction;
  the argument from the uniqueness of historical events is shown to prove too
  much (it would also rule out astronomy and meteorology); and the argument
  from the holism of social systems is said to confuse two distinct theses.

  RELEVANCE: This is the sharpest published refutation of Popper's logical
  arguments and represents a sustained defense (in effect) of the possibility
  of nomological social science, including potentially speculative historical
  theory. Essential for a balanced literature review that must assess whether
  the Popperian critique is decisive.

  POSITION: Analytical critique of Popper's anti-historicist arguments from
  within analytic philosophy of science; contrasts with Passmore's more
  conceptual critique.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, historicism,
              critique-of-Popper, High, INCOMPLETE, no-abstract}
}

@article{keaney1997poverty,
  author  = {Keaney, Michael},
  title   = {The Poverty of Rhetoricism: {Popper}, {Mises} and the Riches of Historicism},
  journal = {History of the Human Sciences},
  year    = {1997},
  volume  = {10},
  number  = {1},
  pages   = {1--22},
  doi     = {10.1177/095269519701000101},
  note    = {
  CORE ARGUMENT: Keaney argues that the "historicism" attacked by Popper and
  Mises is largely a fictional construct: genuine historicism (associated with
  the German Historical School and Meinecke) does not posit deterministic laws
  of development at all but rather insists on the individuality and
  context-dependence of historical phenomena. By attacking this straw man,
  Popper and Mises also discredit the valuable historicist insistence that
  history and the social sciences cannot be sharply separated. Mises's
  value-free social science is equally attacked as methodologically untenable.

  RELEVANCE: This article is directly relevant to the research project's
  concern with distinguishing Popper's anti-historicism from other critiques:
  it argues that Popper's "historicism" is not the genuine historicism of the
  German tradition but an invented target. This distinction between Popperian
  anti-historicism and hermeneutic (contextualist) historicism is central to
  any literature review on the speculative tradition.

  POSITION: Defense of genuine historicism against the Popperian critique;
  accuses Popper of terminological invention and political motivation.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, historicism,
  abstract = {The attacks on historicism by radical individualists such as Popper and Mises have had lasting repercussions in the social sciences. Specifically, the term is used to connote deterministic, teleological theories of history, associated with Hegelian notions of destiny and positivist ideas of historical laws. This article argues that historicism is very different in character, in that it essentially amounts to the belief that social science and history are one and the same, whilst emphasizing the separate epis temology of natural science. It rejects the fictitious historicism invented by Popper in his famous polemic, and challenges the idea of a value- free social science posited by Mises, who saw history and human action as logically distinct entities. In conclusion, it is argued that the mecha nistic rationalism that characterizes much of social science, particularly modern economics, should be supplementary, if anything, to the primacy of history. The notion of transcendent, value-free criteria upon which to construct social science is refuted.},
  abstract_source = {openalex},
              critique-of-Popper, German-Historical-School, Medium}
}

@article{suchting1972marx,
  author  = {Suchting, W. A.},
  title   = {Marx, {Popper}, and `Historicism'},
  journal = {Inquiry},
  year    = {1972},
  volume  = {15},
  number  = {1-4},
  pages   = {235--266},
  doi     = {10.1080/00201747208601662},
  note    = {
  CORE ARGUMENT: Suchting examines whether Marx's theory of historical
  development is in fact the kind of "historicism" that Popper refutes. He
  distinguishes four models of historical determinism and argues that (a) Popper
  mischaracterizes Marx's actual views; (b) his arguments against laws of
  historical development are not effective against the most defensible
  interpretation of Marx; and (c) the question of what sort of historical laws
  Marx posited remains genuinely open. The paper is partly a defense of Marx
  and partly a challenge to Popper's taxonomy.

  RELEVANCE: This is an important contribution to assessing whether the
  Popperian critique of "historicism" actually hits its intended target (Marx).
  Given that Marx is one of the central representatives of the speculative
  tradition, the question of whether Popper successfully refutes him bears
  directly on the research project.

  POSITION: Critical engagement with Popper's arguments from a Marx-sympathetic
  perspective; argues Popper misidentifies his target.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, Marx,
  abstract = {According to Sir Karl Popper, there is a harmful approach to the social sciences called ‘historicism’. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.},
  abstract_source = {openalex},
              historicism, critique-of-Popper, Medium}
}

@article{shearmur1998popper,
  author  = {Shearmur, Jeremy},
  title   = {Popper, {Hayek}, and the Poverty of Historicism {Part I}: A Largely Bibliographical Essay},
  journal = {Philosophy of the Social Sciences},
  year    = {1998},
  volume  = {28},
  number  = {3},
  pages   = {434--450},
  doi     = {10.1177/004839319802800307},
  note    = {
  CORE ARGUMENT: Shearmur reconstructs the intellectual relationship between
  Popper and Hayek in the development of The Poverty of Historicism, drawing on
  correspondence and unpublished materials. He shows that Hayek's influence on
  the book was substantial, particularly in shaping Popper's anti-scientism and
  his conception of the "social technologies" that legitimate social science
  should employ. The essay also surveys the secondary literature on Popper's
  anti-historicism up to the late 1990s, situating the key debates.

  RELEVANCE: This provides essential context for understanding the Popper--Hayek
  intellectual relationship and the shared anti-speculative project. It is
  particularly useful for distinguishing what is properly Popperian from what
  is Hayekian in the mid-century anti-historicist tradition.

  POSITION: Intellectual-historical contextualization of Popperian
  anti-historicism; shows the convergence of the two traditions.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, Hayek,
  abstract = {L'A. etudie les circonstances de la publication de «La pauvrete de l'historicisme», ouvrage rassemblant trois articles de K. Popper parus dans la revue «Economica», alors dirigee par Hayek. Sans entrer dans le debat sur la methodologie des sciences sociales qui a lie les deux penseurs, mais en retracant l'histoire du manuscrit a la lumiere de leur correspondance, l'A. reproduit ici le texte de la premiere partie de l'ouvrage avec les coupures qu'en avait extraites Hayek pour des raisons d'economie de place},
  abstract_source = {openalex},
              intellectual-history, Medium}
}

@article{hammersley2024popper,
  author  = {Hammersley, Martyn},
  title   = {Challenging Historicist Utopianism: {Karl Popper}'s Criticism of {Karl Mannheim}},
  journal = {History of European Ideas},
  year    = {2024},
  volume  = {51},
  number  = {4},
  pages   = {847--865},
  doi     = {10.1080/01916599.2024.2437376},
  note    = {
  CORE ARGUMENT: Hammersley examines Popper's extended critique of Karl
  Mannheim's sociology of knowledge and planning theory in The Open Society.
  He argues that Popper's critique of Mannheim represents an important case
  study in the application of anti-historicist arguments to a specific
  intellectual target: Mannheim's "utopian" planning rationalism (Ideology and
  Utopia, Man and Society in an Age of Reconstruction). Hammersley assesses
  the fairness and adequacy of Popper's reading of Mannheim.

  RELEVANCE: This is the most recent sustained study of a specific application
  of Popper's anti-historicist critique and is directly relevant to the
  research project. Mannheim sits at the intersection of sociology of knowledge
  and speculative philosophy of history; Popper's attack on him illustrates
  how the anti-historicist argument applies to figures beyond the canonical
  Hegel--Marx line.

  POSITION: Recent case study of Popperian anti-historicism applied to
  Mannheim; provides current scholarly assessment of the critique's reach.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, Mannheim,
  abstract = {ABSTRACT In his critique of historicism and utopian social engineering, Karl Popper treats various writers – notably, Plato, Hegel, and Marx – as expounding these mistaken ideas, and as illustrating the threat they pose to ‘the open society’. Among contemporaries, one of those he singles out for criticism is the sociologist Karl Mannheim. While he spends relatively little time discussing Mannheim’s work compared to that of Plato and Marx, I argue that Ideology and Utopia and Man and Society in an Age of Reconstruction may have had particular significance for Popper. I examine his evaluation of Mannheim’s work, assessing its accuracy, and what it reveals about the similarities and fundamental differences in the orientations of these two writers, both of whom had a significant impact upon social science in the twentieth century.},
  abstract_source = {s2},
              historicism, sociology-of-knowledge, Medium}
}

@article{tilley1982popper,
  author  = {Tilley, Nicholas},
  title   = {Popper, Historicism and Emergence},
  journal = {Philosophy of the Social Sciences},
  year    = {1982},
  volume  = {12},
  number  = {1},
  pages   = {59--67},
  doi     = {10.1177/004839318201200104},
  note    = {
  CORE ARGUMENT: Tilley argues that Popper's critique of historicism is
  complicated by his own commitment to emergence---the view that genuinely
  novel properties arise in complex systems and cannot be predicted from lower-
  level descriptions. Popper's acceptance of emergence in social systems
  appears to undermine some of his anti-historicist arguments (particularly
  against pro-naturalistic historicism), creating an internal tension in his
  position.

  RELEVANCE: This article identifies an important internal problem in Popper's
  anti-historicist position and is useful for assessing the coherence and limits
  of the argument. It also connects the debate to wider issues in philosophy of
  social science about reduction and supervenience.

  POSITION: Internal critique of Popper's anti-historicism based on his own
  philosophy of science commitments.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, emergence,
              historicism, Low, INCOMPLETE, no-abstract}
}

