@book{hayek2010studies,
  author    = {Hayek, Friedrich A.},
  editor    = {Caldwell, Bruce},
  title     = {Studies on the Abuse and Decline of Reason},
  year      = {2010},
  publisher = {Routledge},
  doi       = {10.4324/9780203375242},
  note      = {
  CORE ARGUMENT: This volume (edited by Caldwell for the Collected Works)
  gathers Hayek's methodological trilogy: "Individualism: True and False" (1946),
  "Scientism and the Study of Society" (1942--44), and "The Counter-Revolution
  of Science" (1941). The Caldwell edition includes extensive editorial
  apparatus contextualizing these texts within Hayek's "Abuse of Reason
  Project" and the broader Austrian tradition of Methodenstreit. Hayek's
  core argument is that the application of natural-science categories to social
  phenomena generates the fallacy of "constructivist rationalism"---the belief
  that social order can be rationally designed---which leads to socialism and
  totalitarianism.

  RELEVANCE: The definitive scholarly edition of Hayek's anti-scientism writings,
  with Caldwell's editorial contextualisation making clear how the critique of
  scientism is connected to the critique of central planning and speculative
  social engineering. Essential for any serious engagement with the Hayekian
  strand of the anti-historicist tradition.

  POSITION: Hayekian anti-scientism; edited critical edition with apparatus.
  },
  keywords = {anti-historicism-philosophy-social-science, Hayek, scientism,
               methodology, Austrian-economics, Medium, INCOMPLETE, no-abstract}
}

@article{costa2021hayek,
  author  = {Costa, Keanu Telles da and Angeli, Eduardo},
  title   = {Reason, Scientism, and Methodology: {Hayek}'s Adherence to Complexity through the Development of His Methodological Criticism in the Abuse of Reason Project},
  journal = {Brazilian Journal of Political Economy},
  year    = {2021},
  volume  = {41},
  number  = {3},
  pages   = {507--524},
  doi     = {10.1590/0101-31572021-3145},
  note    = {
  CORE ARGUMENT: Costa and Angeli trace the emergence of the concept of
  "complexity" in Hayek's work from the late 1930s through the 1940s, showing
  how it arises organically from his methodological critique of scientism in
  the Abuse of Reason Project. They argue that complexity is not merely a
  later addition but the unifying theme that ties together "Individualism: True
  and False," "Scientism and the Study of Society," and The Counter-Revolution
  of Science, and that it explains why simple-minded application of natural-
  science methods to society is bound to fail.

  RELEVANCE: This article provides recent scholarly reconstruction of the
  internal logic of Hayek's methodology and explains why his critique of
  scientism amounts to a critique of speculative social engineering. It
  complements the Caldwell edition by offering philosophical analysis of
  the complexity theme.

  POSITION: Recent philosophical-historical reconstruction of Hayek's
  anti-scientism via complexity theory.
  },
  keywords = {anti-historicism-philosophy-social-science, Hayek, scientism,
  abstract = {ABSTRACT This article presents a narrative on the emergence of the concept of complexity in Friedrich A. Hayek’s work. We show that complexity emerges from Hayek’s methodological concerns and, specifically, from his texts that compose the first two parts of the Abuse of Reason Project. Namely, a) ‘Individualism: True and False’, from 1946; b) ‘Scientism and the Study of Society’, published between 1942 and 1944; and c) ‘The Counter Revolution of Science’, from 1941. In this paper, we aim to expose that the concept of complexity emerges gradually and organically and is integrated with the Hayekian research program from the 1940s.},
  abstract_source = {s2},
              complexity, methodology, Medium}
}

@article{lourenzo2016hayek,
  author  = {Louren\c{c}o, Diogo},
  title   = {Hayek's ``{Scientism}'' Essay: The Social Aspects of Objectivity and the Mind},
  journal = {Erasmus Journal for Philosophy and Economics},
  year    = {2016},
  volume  = {9},
  number  = {2},
  pages   = {123--144},
  doi     = {10.23941/ejpe.v9i2.232},
  note    = {
  CORE ARGUMENT: Louren\c{c}o reconstructs Hayek's critique of scientism in
  "Scientism and the Study of Society" and identifies two problems: (1) Hayek's
  argument rests on an untenable appearance/reality distinction that separates
  the "naive" categories of everyday experience from the "objective" categories
  of natural science; and (2) Hayek's account of intersubjective understanding
  in social science requires a questionable assumption of mental similarity
  between scientist and subject. Alternative justifications for Hayek's
  conclusions are offered.

  RELEVANCE: This provides a detailed philosophical analysis of the key
  methodological text in Hayek's anti-historicist program, both reconstructing
  and critiquing the argument. Useful for the research project as it identifies
  where Hayek's anti-scientism is strong and where it faces difficulties.

  POSITION: Sympathetic-critical analysis of Hayek's methodological anti-
  naturalism.
  },
  keywords = {anti-historicism-philosophy-social-science, Hayek, scientism,
              philosophy-of-social-science, Medium}
}

% ============================================================
% BERLIN AND HISTORICAL DETERMINISM
% ============================================================
  abstract = {In his Scientism and the Study of Society, Hayek wishes to show the errors to which the moral scientist is led by emulating the methods of the natural sciences. The present paper argues that Hayek’s argument relies on a differentiation between the natural sciences and what he calls “ordinary experience” that is based on an unacceptable appearance-reality distinction and an implausible ontology. An alternative justification for the differentiation is offered by appealing to the manifold goals and social contexts of inquiry. Also, according to Hayek, the moral scientist needs to understand agents’ attitudes, and such understanding is possible because there is a similarity between the mind of the moral scientist and that of the agent. This paper tries to elucidate what Hayek thinks such similarity to be and how it may lead to the understanding of others. It proposes two alternatives: first, understanding as the projection of mental categories from behavioral evidence, and second, by looking forward to Hayek’s The Sensory Order, understanding as a functional correspondence between structures in the central nervous system.},
  abstract_source = {s2},

@article{maar2020berlin,
  author  = {Maar, Alexander},
  title   = {A Critical Commentary on {Isaiah Berlin}'s Philosophy of History},
  journal = {Revista Guaira\c{c}{\'a} de Filosofia},
  year    = {2020},
  volume  = {36},
  number  = {1},
  doi     = {10.5935/2179-9180.20200002},
  note    = {
  CORE ARGUMENT: Maar examines Berlin's argument in "Historical Inevitability"
  that determinism in history is incompatible with free will and moral
  responsibility. He reconstructs Berlin's thesis that historians are not mere
  chroniclers but need to issue moral evaluations, which presuppose that agents
  could have acted otherwise. Maar then criticizes Berlin on two points: (a)
  the move from determinism to historical inevitability is not logically
  necessary, and (b) compatibilist responses (holding that determinism is
  compatible with responsibility) were available to Berlin but he does not
  adequately address them.

  RELEVANCE: This provides critical analysis of Berlin's moral-philosophical
  argument against historical determinism, one of the three main strands of
  the mid-century anti-historicist tradition. The critique from compatibilism
  is important for assessing whether Berlin's argument provides a decisive
  case against speculative philosophies of history that invoke necessity.

  POSITION: Critical assessment of Berlin's "Historical Inevitability" argument;
  highlights the incompatibilism assumption and its vulnerability.
  },
  keywords = {anti-historicism-philosophy-social-science, Berlin, determinism,
  abstract = {Isaiah Berlin famously attacked a view he called historical inevitability. He believed that a causal view of history entails the adoption of an extreme deterministic position – a kind of determinism which would rule out the possibility of free will, turning moral responsibility a notion void of meaning. His thesis was also based on the assumption that historians are not just chroniclers of the past but need to engage in moral judgments; therefore should determinism hold true of our world, our moral language – and consequently much of our historical language – would need to undergo serious revision. In this brief article we look in some detail at the arguments offered by Berlin in support of his thesis and offer criticism.},
  abstract_source = {s2},
              moral-responsibility, historicism, Medium}
}

@article{birner2018popper,
  author  = {Birner, Jack},
  title   = {Karl {Popper}'s \textit{The Poverty of Historicism} after 60 Years},
  journal = {Metascience},
  year    = {2018},
  volume  = {27},
  number  = {2},
  pages   = {183--193},
  doi     = {10.1007/s11016-018-0303-5},
  note    = {
  CORE ARGUMENT: Birner offers a retrospective assessment of The Poverty of
  Historicism on its 60th anniversary, evaluating which of Popper's arguments
  have stood up and which have been refuted or superseded. He argues that the
  core logical argument (unpredictability of knowledge growth) retains force
  while some subsidiary arguments (especially those targeting holistic social
  engineering) are more vulnerable. He also situates the book in Popper's
  broader epistemological project and assesses its influence on subsequent
  philosophy of social science.

  RELEVANCE: This provides a recent scholarly balance-sheet for Popper's
  anti-historicist arguments, directly relevant to any assessment of whether
  the critique of the speculative tradition is successful. It also locates the
  book in the history of philosophy of social science.

  POSITION: Recent retrospective assessment of Popperian anti-historicism;
  useful for calibrating the current standing of these arguments.
  },
  keywords = {anti-historicism-philosophy-social-science, Popper, historicism,
              philosophy-of-social-science, Low, INCOMPLETE, no-abstract}
}

