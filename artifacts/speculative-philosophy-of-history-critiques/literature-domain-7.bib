@article{watkins1957historical,
  author  = {Watkins, J. W. N.},
  title   = {Historical Explanation in the Social Sciences},
  journal = {The British Journal for the Philosophy of Science},
  year    = {1957},
  volume  = {8},
  number  = {30},
  pages   = {104--117},
  doi     = {10.1093/bjps/viii.30.104},
  note    = {
  CORE ARGUMENT: Watkins articulates methodological individualism as a positive
  methodological thesis for the social sciences: social events and institutions
  must ultimately be explained by reference to the dispositions, beliefs, and
  situations of individual human beings. He contrasts this with "holistic" or
  "groupist" explanations and argues the latter are either eliminable in
  principle or not genuine explanations. The paper is the canonical
  formulation of the Popperian school's positive social-science methodology.

  RELEVANCE: Methodological individualism is the positive counterpart of
  Popper's anti-historicism: if history has no autonomous laws of development,
  then the appropriate social-science methodology is individualist explanation
  of particular events and institutions. Watkins's article is the locus
  classicus for this positive program.

  POSITION: Positive articulation of methodological individualism as
  the social-scientific alternative to historicism; belongs to the Popperian
  school.
  },
  keywords = {anti-historicism-philosophy-social-science, methodological-
              individualism, Watkins, Popper, social-science, High, INCOMPLETE, no-abstract}
}

@article{lukes1968methodological,
  author  = {Lukes, Steven},
  title   = {Methodological Individualism Reconsidered},
  journal = {The British Journal of Sociology},
  year    = {1968},
  volume  = {19},
  number  = {2},
  pages   = {119--129},
  doi     = {10.2307/588689},
  note    = {
  CORE ARGUMENT: Lukes argues that methodological individualism is either
  trivially true (all social events involve individuals) or self-contradictory
  (it relies on social-level concepts to characterize the individuals it invokes).
  He distinguishes several different theses that travel under the name
  "methodological individualism" and argues that the non-trivial versions are
  incoherent. The article helped shift debate from the political charge of
  historicism to the philosophical adequacy of its alternative.

  RELEVANCE: This is a key critical response to the Popperian school's positive
  methodology, showing that methodological individualism faces serious internal
  difficulties. For the research project, it illustrates that the anti-historicist
  alternative is not self-evidently adequate and that the debate has internal
  philosophical complexity.

  POSITION: Critical response to Popperian methodological individualism from
  within analytic social philosophy.
  },
  keywords = {anti-historicism-philosophy-social-science, methodological-
              individualism, Lukes, critique, social-science, Medium, INCOMPLETE, no-abstract}
}

@article{list2013methodological,
  author  = {List, Christian and Spiekermann, Kai},
  title   = {Methodological Individualism and Holism in Political Science: A Reconciliation},
  journal = {American Political Science Review},
  year    = {2013},
  volume  = {107},
  number  = {4},
  pages   = {629--643},
  doi     = {10.1017/s0003055413000373},
  note    = {
  CORE ARGUMENT: List and Spiekermann argue that the individualism--holism
  debate in political science rests on a false dichotomy. They propose a
  reconciliation: (1) all social phenomena result from underlying individual
  attitudes and behavior, so individualism is true at the ontological level;
  but (2) individual-level descriptions do not always capture all explanatorily
  salient properties---nonreductionistic (holist) explanations are mandated
  when social regularities are robust under variations in their individual-
  level realization. This framework allows both levels of description to be
  legitimate.

  RELEVANCE: This is the leading recent reconciliationist position in the
  methodological individualism debate and represents the current state of the
  field. For the research project, it shows how the dichotomy that animated
  the Popperian--Marxist dispute has been partially dissolved in contemporary
  analytic social science.

  POSITION: Reconciliationist position in current political science and
  philosophy of social science; moves beyond the original Popperian framework.
  },
  keywords = {anti-historicism-philosophy-social-science, methodological-
  abstract = {Political science is divided between methodological individualists, who seek to explain political phenomena by reference to individuals and their interactions, and holists (or nonreductionists), who consider some higher-level social entities or properties such as states, institutions, or cultures ontologically or causally significant. We propose a reconciliation between these two perspectives, building on related work in philosophy. After laying out a taxonomy of different variants of each view, we observe that (i) although political phenomena result from underlying individual attitudes and behavior, individual-level descriptions do not always capture all explanatorily salient properties, and (ii) nonreductionistic explanations are mandated when social regularities are robust to changes in their individual-level realization. We characterize the dividing line between phenomena requiring nonreductionistic explanation and phenomena permitting individualistic explanation and give examples from the study of ethnic conflicts, social-network theory, and international-relations theory.},
