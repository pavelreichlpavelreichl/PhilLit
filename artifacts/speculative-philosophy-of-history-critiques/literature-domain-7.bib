@book{popper1957poverty,
  author    = {Popper, Karl R.},
  title     = {The Poverty of Historicism},
  year      = {1957},
  publisher = {Routledge and Kegan Paul},
  address   = {London},
  note      = {
  CORE ARGUMENT: Popper argues that the social-scientific program of
  discovering laws of historical development to enable unconditional historical
  prediction is logically self-defeating: since the growth of human knowledge
  influences the course of history, and since we cannot predict future
  knowledge now (for to do so would be to possess it already), long-range
  historical prophecy is impossible in principle. This argument is the "logical
