@article{finney2013jenkins,
  author  = {Finney, Patrick},
  title   = {Keith {Jenkins} and the Heroic Age of {British} Postmodern Theory},
  journal = {Rethinking History},
  year    = {2013},
  volume  = {17},
  number  = {2},
  pages   = {172--190},
  doi     = {10.1080/13642529.2013.778123},
  note    = {
  CORE ARGUMENT: Finney examines Jenkins's distinctive contribution to
  British postmodern theory of history, arguing that Jenkins's radical
  application of Lyotard, Foucault, and Derrida to historiography
  represented a "heroic" but increasingly isolated attempt to push the
  postmodern critique of historical objectivity to its limit. Jenkins
  argued that history is always written in the service of power and that
  teleological narratives of emancipation are ideological constructions.

  RELEVANCE: This article provides intellectual-historical context for
  Jenkins's place in the broader postmodern historiography movement,
  situating his work within the reception of French poststructuralism
  in British historiography. Useful for understanding how the
  philosophical critique of speculative history was operationalized in
  historical practice.

  POSITION: Intellectual history of postmodern historiography;
  Jenkins as radical anti-teleological historian.
  },
  keywords  = {jenkins, postmodern-historiography, teleology-critique, secondary, Low, poststructuralism-postmodernism},
  abstract = {This piece offers a critical appraisal of Keith Jenkins' work over the last two decades, through the prism of my own personal engagement with his writing. It assesses how Re-thinking History (1991. London: Routledge) and his other works of the 1990s helped precipitate wide-ranging and tempestuous debates about the nature of historical knowledge that were unprecedented in the modern discipline of history in Britain (and beyond). It then traces how these debates developed into the 2000s, as Jenkins' own position hardened and the discipline absorbed the ‘postmodern’ challenge through partial incorporation, as evidenced inter alia by the emergence of new forms of theoretically-inflected cultural history. The impact of Jenkins' work on my own writing and teaching is discussed in an attempt to illuminate the broader collective experience of (parts of) a particular scholarly generation for which these titanic debates were a formative experience.},
  abstract_source = {openalex},
}
