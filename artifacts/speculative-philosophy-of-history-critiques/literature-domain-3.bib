}

@article{young2023uses,
  author  = {Young, Julian},
  title   = {The Uses and Misuses of History: Reflections on {Nietzsche}'s Second Untimely Meditation},
  journal = {Society},
  year    = {2023},
  volume  = {60},
  number  = {5},
  pages   = {670--683},
  doi     = {10.1007/s12115-023-00879-0},
  note    = {
  CORE ARGUMENT: Young argues that Nietzsche's second Untimely
  Meditation (On the Uses and Disadvantages of History for Life) should
