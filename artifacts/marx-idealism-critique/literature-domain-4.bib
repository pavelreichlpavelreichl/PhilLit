@misc{cohen1978karl,
    author = "Cohen, G. A.",
    title = "Karl Marx's Theory of History: A Defence",
    year = "1978",
    address = "Princeton, NJ",
    note = {CORE ARGUMENT: Cohen reconstructs historical materialism using the tools of analytic philosophy, defending a technologically deterministic reading of the base/superstructure distinction via functional explanation, explicitly rejecting "dialectical" argument as a legitimate mode of Marxist reasoning in favour of conceptual clarity and rigorous inference. The book's methodological introduction treats Hegelian dialectic as an obstacle to, rather than a resource for, understanding Marx. RELEVANCE: This is the founding text of Analytical Marxism and the primary target of dialectically-inclined replies (Sayers 1984 responds to it directly); it supplies the paradigm case of "rejecting the dialectic while retaining Marx's substantive claims" that the domain's key question interrogates. POSITION: Founding statement of the analytical-Marxist rejection of dialectical method.},
    keywords = "analytical-Marxism, Cohen, historical-materialism, dialectic-rejection, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{elster1985making,
    author = "Elster, Jon",
    title = "Making Sense of Marx",
    year = "1985",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    series = "Studies in Marxism and Social Theory",
    note = {CORE ARGUMENT: Elster subjects the whole of Marx's oeuvre to analytic and rational-choice scrutiny, concluding that Marx's economic theories are largely mistaken or irrelevant and that his most defensible legacy lies in the theories of alienation, exploitation, and class conflict once purged of dialectical and functionalist argumentation. Elster distinguishes several senses of "dialectic" in Marx (as method of presentation, as a body of Hegelian "laws," and as a description of self-undermining social contradictions), endorsing only the last as a genuine, non-exclusively-Marxist insight. RELEVANCE: Alongside Cohen 1978, this is the other founding text of Analytical Marxism and the fullest statement of the position that "dialectical method" should be dissolved into discrete, independently defensible theses; it directly frames the domain's second key question about how dialectically-inclined Marxists have replied. POSITION: Consolidating statement of the analytical-Marxist reconstruction of Marx without dialectic.},
    sep_context = {SEP "Analytical Marxism" (marxism-analytical), sec. 3.4 "Dialectic": cites Elster's account of three dialectical strands in Marx's work (Elster 1978, chs. 3-5; Elster 1985: 37-48; Elster 1986a: 34-39), of which two are judged valuable. Elster is described as "deeply unsympathetic" to dialectic as a method of presentation, finding the relevant Grundrisse/Capital passages "scarcely intelligible" (1985: 37); SEP contrasts this with Arthur 2004's "more positive account." SEP also cites Elster 1985: 5 on methodological individualism and 1985: 109 on Marx's anti-teleological remarks in the German Ideology.},
    keywords = "analytical-Marxism, Elster, rational-choice-Marxism, dialectic-rejection, High, INCOMPLETE, no-abstract"
}

@misc{elster2011hard,
    author = "Elster, Jon",
    title = "Hard and Soft Obscurantism in the Humanities and Social Sciences",
    year = "2011",
    volume = "58",
    note = {CORE ARGUMENT: Elster distinguishes "hard obscurantism" (deliberately opaque prose masking empty content) from "soft obscurantism" (loose, unfalsifiable use of concepts like contradiction, totality, and dialectic that trade on equivocation between literal and metaphorical senses), arguing that much dialectically-inflected Marxist and post-structuralist theorizing exemplifies the latter. He explicitly retrospectively characterizes analytical Marxism's own trajectory as a case of "intellectual autophagy" that revealed "non-bullshit Marxism" to be nearly an empty set. RELEVANCE: This is Elster's most explicit and mature statement of the charge that dialectical reasoning is obscurantist rather than merely mistaken, sharpening the methodological indictment that systematic-dialectics theorists (Arthur, Smith, Reuten) must answer; it also documents the later self-understanding of the analytical-Marxist project as having largely abandoned Marx. POSITION: Late, hardened statement of the analytical-Marxist charge that dialectic is obscurantist.},
    keywords = "analytical-Marxism, Elster, obscurantism, dialectic-rejection, methodology, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Abstract The paper argues that the contemporary social sciences and humanities are in a deep crisis, due to the prevalence of obscurantist arguments. Whereas many have denounced the “soft obscurantism” derived from what is sometimes called “French theory”, the “hard obscurantism” of many forms of mathematical and statistical social science also deserves to be singled out for criticism. The paper further argues that obscurantism does not merely represent a waste of intellectual effort, but has caused harm to countless individuals, ranging from parents of autistic children to market investors. Finally the paper considers some of the psychological mechanisms that may sustain obscurantism and constitute obstacles to overcoming it.",
    abstract_source = "openalex"
}

@misc{sayers1984marxism,
    author = "Sayers, Sean",
    title = "Marxism and the Dialectical Method: A Critique of G.A. Cohen",
    year = "1984",
    volume = "36",
    note = {CORE ARGUMENT: Sayers argues that the dialectical method is not a dispensable rhetorical overlay on Marx's theory of history but its necessary basis, focusing critically on Cohen's Karl Marx's Theory of History for giving an account of Marxism in "entirely non-dialectical—indeed, anti-dialectical" terms. He contends that without the dialectical framework (particularly the treatment of internal relations and historical development as a process of contradiction), Cohen's technological-functionalist reconstruction distorts core Marxist claims about the productive forces/relations of production relationship. RELEVANCE: This is the paradigm direct reply from the dialectically-inclined camp to the founding text of Analytical Marxism, making it central evidence for the domain's third key question about how Cohen's objections were answered; it is cited in SEP's Analytical Marxism entry as the leading instance of the "dialectic is indispensable" counter-criticism. POSITION: Direct critical response defending dialectical method against Cohen's analytical reconstruction.},
    sep_context = {SEP "Analytical Marxism" (marxism-analytical), sec. 6 "Overarching Criticisms": cites Sayers 1984 and 2015 as maintaining "that Marxism is necessarily committed to a 'dialectical' approach--sometimes based on a wider philosophy of 'internal relations'--which analytical Marxists are bound to reject," presented as one of two families of comprehensive methodological objections to Analytical Marxism.},
    keywords = "dialectic, Cohen-critique, Sayers, historical-materialism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@article{vanparijs1982perverse,
    author = "Parijs, Philippe Van",
    title = "Perverse Effects and Social Contradictions: Analytical Vindication of Dialectics?",
    journal = "The British Journal of Sociology",
    year = "1982",
    volume = "33",
    number = "4",
    note = {CORE ARGUMENT: Writing from within the analytical-Marxist September Group itself, Van Parijs argues that certain dialectical claims about capitalism's self-undermining "contradictions" can be analytically reconstructed as instances of perverse or counter-finalized collective effects (structurally similar to prisoner's-dilemma-type unintended aggregate outcomes), offering a partial, qualified vindication of dialectical description using non-dialectical, game-theoretic tools. RELEVANCE: This paper complicates any clean two-camp narrative for the domain, showing an analytical Marxist attempting to translate rather than simply reject dialectical claims, and anticipates the "modest dialectic" position later endorsed by Elster 1985. POSITION: Bridging position: partial analytical reconstruction, rather than wholesale rejection, of dialectical claims about social contradiction.},
    keywords = "analytical-Marxism, Van-Parijs, contradiction, dialectic, methodology, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Raymond Boudon's recent textbook La Logique du Social, constitutes a systematic attempt to provide sociology with solid foundations, by putting at its core the assumption that man acts rationally, or at least intentionally. Interactionist models, which rest on this assumption, Boudon argues, should replace determinist models, which assume that man is passively determined by social structures, roles or norms.l In particular, he argues that the notion of perverse effect, whose use presupposes the adoption of an interactionist perspective, should play a central role in the attempt to account for social change. In this review article, I shall focus on this notion and on the use Boudon makes of it in his theory of social change. I shall point out a number of obscurities and other defects, and make some suggestions as to how they can be remedied. In so doing, I shall draw heavily on two other books. One is an earlier collection of essays by Boudon, Effets Pervers et Ordre Social, which deals with such topics as educational reform and Rawlsian justice, the 'logic of relative frustration' and sociological determinism, and which provides a less systematic formulation of the ideas expressed in the textbook. As most of the essays make explicit use of the notion of 'perverse effect', their relevance to the concerns of this article are obvious enough. The other book I shall heavily draw on is a somewhat more technical one by Jon Elster, Logic and Society. The purpose of this book is to use various logical tools in order to work out a number of sociologically useful concepts. One of these is the concept of social contradiction, on which we shall concentrate in subsequent sections. Not only does this concept lie at the core of Elster's theory of social change-by itself a sufficient reason for wanting to undertake a comparison with the key notion in Boudon's treatment of change. As we shall see, it is also analytically related to Boudon's notion of perverse effect and, just like the latter, it only makes sense on the background of an intentional model of man.2 Bringing Boudon's and Elster's analyses of these issues together, will, I hope, help make the former more rigorous and the latter more",
    abstract_source = "openalex"
}

@book{arthur2004new,
    author = "Arthur, Christopher J.",
    title = {The New Dialectic and Marx's "Capital"},
    year = "2004",
    publisher = "Brill",
    address = "Leiden/Boston",
    series = "Historical Materialism Book Series",
    number = "1",
    note = {CORE ARGUMENT: Arthur argues that Capital's opening movement — from the commodity through the value-form to money and then to capital — is not a historical narrative but a systematic, dialectically necessitated exposition whose logical structure directly parallels categories from Hegel's Science of Logic (particularly Hegel's logic of essence and the movement from being-in-itself to being-for-itself), even though Marx's subject matter (the capital-relation) is materially and historically specific rather than the Idea. This is the founding statement of what came to be called "the New Dialectic." RELEVANCE: This is the central systematic-dialectics text named in the domain description and the primary target of both sympathetic elaboration (Bidet, Reuten, Smith) and hostile critique (Carchedi, Rosenthal) surveyed here; SEP's Analytical Marxism entry cites it as the leading "more positive account" of dialectical presentation against Elster's dismissal. POSITION: Founding statement of the "New Dialectic"/systematic-dialectics reading of Capital's presentation-order.},
    sep_context = {SEP "Analytical Marxism" (marxism-analytical), sec. 3.4 "Dialectic": after describing Elster's dismissal of dialectic as a method of presentation as finding Marx's Grundrisse/Capital passages "scarcely intelligible," SEP notes parenthetically "(For a more positive account, see Arthur 2004.)" as the counterpoint within the entry's discussion of dialectic.},
    keywords = "systematic-dialectics, Arthur, new-dialectic, value-form, Hegel-Capital, High, METADATA\_CLEANED: doi",
    abstract = "This book both argues for, and demonstrates, a new turn to dialectic. Marx's Capital was clearly influenced by Hegel's dialectical figures: here, case by case, the significance of these is clarified. More, it is argued that, instead of the dialectic of the rise and fall of social systems, what is needed is a method of articulating the dialectical relations characterising a given social whole. Marx learnt from Hegel the necessity for a systematic development, and integration, of categories; for example, the category of 'value' can be fully comprehended only in the context of the totality of capitalist relations. These studies thus shed new light on Marx's great work, while going beyond it in many respects.",
    abstract_source = "openalex"
}

@misc{ollman2003dance,
    author = "Ollman, Bertell",
    title = "Dance of the Dialectic: Steps in Marx's Method",
    year = "2003",
    address = "Urbana",
    note = {CORE ARGUMENT: Ollman reconstructs Marx's dialectical method as grounded in a "philosophy of internal relations," according to which the identity of any social entity (value, capital, class) is constituted by its relations to other entities within the totality of the capitalist system, rather than by fixed, externally-related properties; the dialectical procedures of abstraction, generalization, and the "process of ascension" from abstract to concrete are treated as consequences of this underlying ontology rather than as arbitrary Hegelian borrowings. RELEVANCE: Ollman supplies the fullest systematic account of "dialectical method" as an ontological and procedural commitment (rather than merely a presentational device), directly informing the domain's first key question about what retaining Hegel's method while rejecting idealist content could mean; his internal-relations framework is explicitly what Sayers 2015 (cited alongside Sayers 1984) invokes against analytical Marxism. POSITION: Systematic reconstruction of dialectical method as grounded in a philosophy of internal relations.},
    keywords = "dialectic, Ollman, internal-relations, method, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{ilyenkov1977dialectical,
    author = "Ilyenkov, Evald V.",
    title = "Dialectical Logic: Essays on Its History and Theory",
    year = "1977",
    address = "Moscow",
    note = {CORE ARGUMENT: Ilyenkov reconstructs dialectical logic as a materialist theory of concept-formation, centered on his analysis (developed at length in a companion study of Capital's opening chapters) of the "ascent from the abstract to the concrete" as the logical form proper to scientific theory-construction, arguing that Marx's Capital exemplifies this method by deriving the concrete totality of the capitalist economy from the simplest, most abstract determination (the commodity) through successive, necessitated conceptual mediations. RELEVANCE: As the most systematic Soviet-era (post-Stalinist) reconstruction of Marx's dialectical logic, this is the historical starting point for the entire abstract-to-concrete reading later developed by Arthur, Reuten, Smith, and Uchida in the Anglophone systematic-dialectics tradition named in the domain description. POSITION: Foundational Soviet materialist reconstruction of dialectical logic as the abstract-to-concrete method exemplified in Capital.},
    keywords = "dialectic, Ilyenkov, abstract-to-concrete, Soviet-Marxism, dialectical-logic, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{uchida1988marxs,
    author = "Uchida, Hiroshi",
    title = {Marx's "Grundrisse" and Hegel's "Logic"},
    year = "1988",
    publisher = "Routledge",
    address = "London/New York",
    note = {CORE ARGUMENT: Uchida undertakes a close, section-by-section comparison of Marx's 1857-58 Grundrisse manuscripts with the categorical structure of Hegel's Science of Logic, arguing that Marx's method of developing economic categories (particularly around production, circulation, and capital) exhibits a conceptual structure directly modeled on, though not reducible to, Hegel's logic — revealing what Uchida calls "the force of capital on modern life" as itself dialectically structured. RELEVANCE: This text supplies detailed textual evidence for the domain's second key question about the presentation-order isomorphism thesis, extending the systematic-dialectics reading back from Capital to its preparatory manuscript, the Grundrisse; it is directly named as a key theorist in the domain description. POSITION: Systematic-dialectics reading demonstrating structural parallels between the Grundrisse and Hegel's Logic.},
    keywords = "systematic-dialectics, Uchida, Grundrisse, Hegel-Logic, High, INCOMPLETE, no-abstract"
}

@article{reuten2000interconnection,
    author = "Reuten, Geert",
    title = "The Interconnection of Systematic Dialectics and Historical Materialism",
    journal = "Historical Materialism",
    year = "2000",
    volume = "7",
    number = "1",
    note = {CORE ARGUMENT: Reuten distinguishes systematic dialectics (the reconstruction, in Capital, of the necessary conceptual/categorical order of a given social system) from historical dialectics (the reconstruction of that system's actual historical genesis and development), arguing that value-form theory's methodological shift toward systematic dialectics does not abandon historical materialism but rather specifies its proper relation to systematic theory: the categories of Capital are systematically, not historically, ordered, even though the system they describe is itself a historical formation. RELEVANCE: This paper gives the clearest methodological statement of what "systematic dialectics" means as a research program distinct from historical narrative, directly addressing the domain's second key question about how the commodity-to-money-to-capital presentation-order is reconstructed as dialectically necessary. POSITION: Methodological statement of systematic dialectics and its relation to historical materialism, from within the value-form tradition.},
    keywords = "systematic-dialectics, Reuten, value-form, historical-materialism, methodology, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract This paper discusses some recent developments in the Marxian theory of value, called value-form theory, which have gone along with a methodological shift from a linear logic and historical dialectics to a dialectical logic and systematic dialectics. In order to appreciate these developments within the Marxian paradigm, it is useful to make two introductory remarks: first, on some peculiarities of Marxian discourse and, second, about discrepancies in Marx's Capital.",
    abstract_source = "openalex"
}

@misc{murray2009value,
    author = "Murray, Patrick",
    editor = "Chitty, Andrew and McIvor, Martin",
    title = "Value, Money and Capital in Hegel and Marx",
    booktitle = "Karl Marx and Contemporary Philosophy",
    year = "2009",
    address = "Basingstoke",
    note = {CORE ARGUMENT: Murray traces how Marx's derivation of value, money, and capital as forms in Capital draws on and transforms Hegelian logical categories (particularly the logic of essence and the distinction between "immediate" and "reflected" or "posited" determinations), arguing that Marx's value-form analysis requires this Hegelian logical apparatus to explain how value acquires an independent, objective form (money) that then appears to dominate its own social substance. RELEVANCE: Murray is named as a key systematic-dialectics theorist in the domain description; this piece supplies a concise statement of his broader "truly social" labour-theory-of-value position and its specifically Hegelian derivation of the money-form, directly bearing on the domain's second key question. POSITION: Value-form-theoretic account of the specifically Hegelian logical structure underlying Marx's derivation of money and capital.},
    keywords = "value-form, Murray, Hegel, money-form, systematic-dialectics, Medium, METADATA\_CLEANED: publisher, pages, doi, type:@incollection->@misc",
    abstract = "Some years ago I was surprised to receive a package in the mail from a former student.1 It took me a moment to recognize what was inside, a green ceramic ΔM. I had a good laugh. From our study of Capital, the student had gotten the idea loud and clear how preoccupied Marx is with ΔM, or what he calls ‘surplus value’. In thinking over Hegel’s treatment of property, contracts of exchange and civil society in the Philosophy of Right and earlier writings, I am struck by a simple fact: Hegel just does not seem to be interested in ΔM.2 Hegel is aware that ‘gain’ or ‘profit’ motivate what he calls the ‘reflective estate’ of trade and industry. And he recognizes that civil society is naturally expansive, with firms developing products and technologies in order to accumulate wealth. But the topic of surplus value simply does not move Hegel on grounds either of science — where does ΔM come from? — or social justice — what justification can be offered for ΔM?",
    abstract_source = "openalex"
}

@misc{smith1990analytical,
    author = "Smith, Tony",
    title = "Analytical Marxism and Marx's Systematic Dialectical Theory",
    year = "1990",
    volume = "23",
    number = "3",
    note = "CORE ARGUMENT: Smith directly contrasts the analytical-Marxist reconstruction project (Cohen, Elster, Roemer) with a systematic-dialectical reading of Capital, arguing that analytical Marxism's individualist, causal-explanatory framework cannot capture the categorial necessity by which Marx moves from the commodity-form to money to capital, and that this systematic ordering — not mere historical sequence or analytic decomposition — is essential to Capital's explanatory power regarding capital's self-expanding, crisis-prone character. RELEVANCE: This paper directly engages both traditions named in the domain description and is the clearest single article-length statement of the domain's third key question, evaluating analytical Marxism's rejection of dialectic against the systematic-dialectics alternative on its own methodological terms. POSITION: Systematic-dialectics rebuttal of analytical Marxism's rejection of dialectical necessity in Capital's argument.",
    keywords = "systematic-dialectics, analytical-Marxism, Tony-Smith, methodology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@article{smith1999relevance,
    author = "Smith, Tony",
    title = "The Relevance of Systematic Dialectics to Marxian Thought: A Reply to Rosenthal",
    journal = "Historical Materialism",
    year = "1999",
    volume = "4",
    number = "1",
    note = {CORE ARGUMENT: Smith responds to John Rosenthal's charge (in "The Escape from Hegel") that systematic-dialectics readings of Capital import a spurious, unmotivated Hegelian necessity into what is really an empirically contingent economic argument, defending the claim that Capital's opening chapters exhibit genuine categorial necessity (each category's inadequacy necessitating the emergence of the next) rather than merely a convenient expository order. RELEVANCE: Paired with Rosenthal 1999, this exchange is a direct, textually detailed instance of Marxist theorists disputing the coherence of the systematic-dialectics reconstruction from within the broadly dialectical camp, giving the domain's second key question its sharpest concrete test case. POSITION: Defence of categorial necessity in Capital's systematic-dialectical presentation against an internal Marxist critique.},
    keywords = "systematic-dialectics, Tony-Smith, Rosenthal-debate, necessity, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages, doi"
}

@misc{rosenthal1999escape,
    author = "Rosenthal, John",
    title = "The Escape from Hegel",
    year = "1999",
    volume = "63",
    number = "3",
    pages = "283--309",
    doi = "10.1177/003682379906300302",
    note = {CORE ARGUMENT: Rosenthal argues that systematic-dialectics readings of Capital (including Arthur's and Smith's) are compelled, on close inspection, to relax or abandon the strict categorial necessity they claim to find in Hegel's Logic, effectively "escaping from Hegel" while retaining Hegelian vocabulary; he contends the opening chapters of Capital are better explained by ordinary economic-theoretical considerations than by any dialectical derivation. RELEVANCE: This is the direct target of Smith's 1999 reply and thus supplies the domain's clearest case of an internal Marxist critique of the systematic-dialectics/value-form isomorphism-with-Hegel thesis, complementing the external analytical-Marxist critique from Cohen and Elster. POSITION: Internal Marxist critique arguing the systematic-dialectics reading of Capital cannot sustain genuine Hegelian necessity.},
    keywords = "systematic-dialectics, Rosenthal, critique, Hegel-Capital, Medium, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "At least since the publication of Roman Rosdolsky's The Making of Marx's Capital, the Grundrisse has been an essential refer-ence for anyone wishing to demonstrate a significant dependence of Marx's political economy upon Hegelian “logic.” Contrary to Rosdolsky's interpretation, however, the Grundrisse can in fact be read as the drama of Marx's escape from his Hegelian philosophical heritage. Hegel's “dialectical method” is not a method of logi-cal argumentation, but a “method” of paralogical mystification. Marx's own attempts to construct “dialectical derivations” of eco-nomic categories in the Grundrisse lead him into theoretical culs-de-sac, and he is only able to make real progress in his economic inves-tigations by precisely foregoing such adventures. The persistence, nonetheless, of certain characteristically Hegelian formulae - though, n.b., not characteristically Hegelian argumentational struc-tures - in Capital, and especially in the first chapter, is a function of the ontological peculiarity of Marx's initial object of inquiry, viz., money, and does not reflect any “methodological” choice. Marx's arguments in Capital are not “dialectical” but rather “transcenden-tal” in nature, starting from given market phenomena (prices, profit, etc.) and working back to their conditions of possibility.",
    abstract_source = "s2"
}

@article{carchedi2009fallacies,
    author = "Carchedi, Guglielmo",
    title = "The Fallacies of 'New Dialectics' and Value-Form Theory",
    journal = "Historical Materialism",
    year = "2009",
    volume = "17",
    number = "1",
    note = {CORE ARGUMENT: Carchedi argues that the "New Dialectics" associated with Arthur and value-form theory more broadly mistakes a purely logical/systematic ordering of categories for the historically and materially grounded dialectic Marx actually employs, contending that by severing systematic dialectics from historical-materialist content, the New Dialectic empties Marx's categories (value, money, capital) of their determinate economic content and reduces them to formal logical relations. RELEVANCE: This is a sustained critique of the systematic-dialectics/value-form program from within Marxist political economy (rather than from analytical Marxism), showing that the "Hegelian debt" question divides Marxists internally, not only along the analytical/dialectical fault line the domain's key questions foreground. POSITION: Marxist-economics critique of systematic dialectics/value-form theory as formalistic and historically ungrounded.},
    keywords = "systematic-dialectics, Carchedi, critique, value-form, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract Chris Arthur's approach aims at a systematic re-ordering of Marx's categories. This article argues that his approach is actually a different ordering of different categories that are positioned within a specific theoretical whole, a Hegelian re-interpretation of Marx and especially of abstract labour, which distances itself from Marx. While the debate has focused mainly on the philosophical aspects of Arthur's work, its economic features have not been the object of a systematic analysis. Yet, a full assessment of the 'New Dialectics' should include explicitly a systematic internal critique of its economic dimensions. The aim of this article is to assess the internal consistency of the economic ramifications of the 'New Dialectics'. The focus is on the notions of abstract labour, concrete labour, and exploitation. Arthur's faithfulness to Marx, or correspondence to Marx's quotations, is not the criterion used to assess the 'New Dialectics'. Rather, the criterion is whether it (a) discovers logical inconsistencies in Capital and (b) is itself free from inconsistencies. The answer is negative in both cases.",
    abstract_source = "openalex"
}

@article{bidet2005dialecticians,
    author = "Bidet, Jacques",
    title = "The Dialectician's Interpretation of Capital",
    journal = "Historical Materialism",
    year = "2005",
    volume = "13",
    note = {CORE ARGUMENT: Reviewing Arthur's The New Dialectic and Marx's "Capital," Bidet assesses the extent to which Arthur's reconstruction succeeds in showing genuine Hegelian derivational necessity in Capital's opening movement, raising specific objections about whether the transition from simple commodity circulation to capital is as logically compelled as Arthur claims, and comparing Arthur's reading with his own structuralist interpretation of Capital's architecture. RELEVANCE: As a detailed, book-length engagement with the central systematic-dialectics text in this domain, Bidet's review-essay supplies close textual scrutiny of the presentation-order isomorphism thesis central to the domain's second key question. POSITION: Critical but sympathetic engagement with Arthur's New Dialectic from an alternative (structuralist) Marxist standpoint.},
    keywords = "systematic-dialectics, Bidet, Arthur-critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: number, pages, doi"
}

@article{reichelt2007marxs,
    author = "Reichelt, Helmut",
    title = "Marx's Critique of Economic Categories: Reflections on the Problem of Validity in the Dialectical Method of Presentation in Capital",
    journal = "Historical Materialism",
    year = "2007",
    volume = "15",
    number = "4",
    pages = "3--52",
    doi = "10.1163/156920607x245823",
    note = {CORE ARGUMENT: Reichelt, a leading figure of the German "Neue Marx-Lektüre," argues that Marx's dialectical development of the money-form in Capital contains unresolved tensions concerning the validity (Geltung) of abstract labour as the substance of value, and proposes reworking Marx's derivation using conceptual resources from Hegel, Simmel, and Adorno to give a more consistent account of value and money as totality and abstraction. RELEVANCE: Reichelt supplies a further, German-tradition variant of systematic/value-form dialectics distinct from the Anglophone Arthur-Smith-Reuten axis, broadening the domain's coverage of how "dialectical method of presentation" has been reconstructed and criticized from within the value-form tradition itself. POSITION: Neue Marx-Lektüre critique and reconstruction of the dialectical derivation of the money-form in Capital.},
    keywords = "value-form, Reichelt, Neue-Marx-Lektuere, money-form, dialectic, Medium",
    abstract = "Abstract It has often been pointed out that the Marxian theory of value contains some inconsistencies, usually in relation to the concept of abstract labour. However, the contradiction between the concept of labour and the concept of validity with which Marx operates in Capital (without actually explaining this conception) has never been discussed. A detailed analysis shows that this concept of validity refers to the process of abstraction which is carried out by the participants of the exchange process. Only the rigorous comprehension of this process of abstraction can illuminate that for which the concept of abstract labour was developed: the unity and universality of value. On this basis, the paper criticises the Marxian development of the money-form and presents an alternative approach that builds on the aforementioned concept of validity. This concept is formulated in more depth by recourse to the works of Hegel, Simmel and Adorno. Furthermore, the paper reconsiders the dialectical development of categories in the light of this alternative conception of the money-form as totality and abstraction (in the sense of Hegel and the young Marx). Finally, the distinction between simple circulation and the process as a whole (found only in the Grundrisse) is explored and it is argued that, according to the novel reading proposed, it acquires a fundamental significance.",
    abstract_source = "openalex"
}

@misc{keikhaee2021historical,
    author = "Keikhaee, Aidin",
    title = "The Historical and the Transhistorical in Marx's Dialectical Method",
    year = "2021",
    volume = "49",
    number = "3",
    pages = "356--382",
    doi = "10.1177/01914537211040567",
    note = {CORE ARGUMENT: Against the dominant reading that treats the 1857 Grundrisse "Introduction" as offering a transhistorical abstract-to-concrete method that Marx later revised or abandoned, Keikhaee argues that a critical-historicist approach to economic categories, together with a specific understanding of the "reproduction of the concrete in thought," constitutes the stable core of Marx's dialectical method across the Introduction and Capital alike, and that the post-1857 shift to the commodity as starting point does not mark a methodological rupture. RELEVANCE: As recent scholarship, this piece shows the systematic-dialectics research program continuing to refine exactly what "Marx's dialectical method" denotes and whether it is stable across Marx's mature economic writings, directly bearing on the domain's first key question about the coherence of "retaining the dialectical method." POSITION: Recent reconstruction defending methodological continuity of Marx's dialectical method from the Grundrisse to Capital.},
    keywords = "dialectic, Keikhaee, Grundrisse, method, continuity, Low, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "This essay revisits the question of alterations in Marx’s view of method from the 1857 “Introduction” to Capital. In the wake of the belated upsurge of interest in Marx’s notebooks of 1857–8, posthumously published as the Grundrisse, a dominant interpretation has been developed in Marx scholarship which characterizes the method of the “Introduction” as an ascent from the (transhistorical) abstract to the (historical) concrete and, upon such characterization, stresses the mature Marx’s departure from it. Rereading the 1857 “Introduction” with an emphasis on the theoretical import of its examples, I argue, against this interpretation, that although this text does not provide a fully worked-out account of method, it nevertheless offers invaluable insights into some of the central methodological problems with which Marx was concerned and in response to which his dialectical method was developed. In particular, I highlight what could be called Marx’s critical historicist approach to the categories and argue that this approach, together with his specific understanding of the process of the reproduction of the concrete in thought, constitute the lasting pillars of Marx’s dialectical method, in the 1857 “Introduction” as well as in Capital. Finally, in a concluding section, I re-examine the methodological status of the commodity and argue that the post-1857 emergence of the commodity as Marx’s favourite starting point does not represent a fundamental change, or a reversal, in his view of method.",
    abstract_source = "s2"
}

@misc{kirkpatrick1994philosophical,
    author = "Kirkpatrick, Graeme",
    title = "Philosophical Foundations of Analytical Marxism",
    year = "1994",
    volume = "58",
    number = "1",
    note = {CORE ARGUMENT: Kirkpatrick traces Cohen's and Elster's methodological commitments to a broader analytic-philosophical background, arguing that Analytical Marxism's attempt to render Marx's thought "clear" through non-dialectical, individualist methods is self-undermining: the very clarificatory apparatus borrowed from analytic philosophy is, Kirkpatrick contends, corrosive to the practical-active meaning central to Marx's own thought, so that Analytical Marxism ends up dissolving rather than defending Marxism. RELEVANCE: This secondary paper situates the Cohen/Elster rejection of dialectic within a wider philosophical genealogy and offers a metatheoretical diagnosis of why the analytical and dialectical camps talk past one another, useful for framing the domain's overarching methodological stakes. POSITION: Metatheoretical critique diagnosing Analytical Marxism's non-dialectical method as self-defeating.},
    keywords = "analytical-Marxism, Kirkpatrick, methodology, critique, Low, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "The Analytical Marxian paradigm is motivated by a desire to make Marx's theory “clear.” Its criteria for success in this venture are drawn from one tendency within contemporary analytical philosophy. The works of G.A. Cohen and Jon Elster on Marx are best understood in the light of this philosophical background. The ultimately fatal limitations of the analytical paradigm as a whole, and of its interpretation of Marx's theory of history in particular, are derived from a contradiction at this philosophical level: Analytical Marxism attempts to make Marx's thought clear with a methodology which is fundamentally corrosive to the practical-active meaning of that thought.",
    abstract_source = "s2"
}
