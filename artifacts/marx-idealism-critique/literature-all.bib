@article{mikkelsen1981marxs,
    author = "Mikkelsen, Jon Mark",
    title = "Marx's Critique of Hegel's ``Rechtsphilosophie''",
    journal = "Auslegung: A Journal of Philosophy",
    year = "1981",
    doi = "10.17161/ajp.1808.9012",
    note = {CORE ARGUMENT: Mikkelsen provides a close, section-by-section textual analysis of Marx's marginal commentary on Hegel's Philosophy of Right, focused specifically on Marx's charge that Hegel's method converts the real subject (empirical social and political life) into a mere predicate of an abstract logical Subject (the Idea), and assesses how consistently Marx sustains this specific logical criticism across the manuscript. RELEVANCE: One of the few papers in this domain devoted entirely and narrowly to the internal logical structure of the 1843 manuscript's critique, offering fine-grained textual evidence for how the "subject-predicate inversion" charge is actually deployed paragraph by paragraph. POSITION: Close textual/logical analysis, largely sympathetic to the coherence of Marx's inversion charge against Hegel.},
    keywords = "1843-critique, subject-predicate-inversion, close-reading, Medium",
    abstract = "Shlomo Avineri has recently argued that the main contribution of Hegel to political theory 'is his concept of the state.[1] Anglo-American philosophers, however, have generally found an intimation of German fascism in this theoretical innovation; yet the first serious challenge to the merit of Hegel's concept of the state can be found within the history of German philosophy itself and dates from as early as 1843. For it was in that year that the young Karl Marx wrote the manuscript now generally referred to as the Kritik des HegeIschen Staatsrechts.[21 Moreover, Marx's critique, although not actually published until 1927, is generally considered to be devastating.(3] Even so, as Avineri and the editors of the English translation of the work emphasize, Marx remained indebted to Hegel despite the trenchant criticism of this work. Avineri, in fact, goes so far as to suggest that the entire Marxist program can be interpreted as an attempt to realize the Hegelian idea of the state through revolutionary praxis rather than the mystification of speculative philosophy. Thus, according to Avineri, as a consequence of his criticism of Hegel Marx came to appreciate the role of the economic order in the development of the state structure much more fully than Hegel and also that the analysis of economic conditions was a life-long task necessary to bring about the true Aufhebung des Staates.[41 But, the tendency of most contemporary commentators, following Engels and Lenin, has been to think that subsequent to his criticism of Hegel, Marx was unalterably critical of the concept of the state and believed not in its abolition and transcendence but simply in its destruction and withering away (Absterben des Staates).[51 I am not so much concerned with simply recounting Marx's cri-",
    abstract_source = "openalex"
}

@misc{rosenthal1999escape,
    author = "Rosenthal, John",
    title = "The Escape from Hegel",
    year = "1999",
    volume = "63",
    number = "3",
    pages = "283--309",
    doi = "10.1177/003682379906300302",
    note = {CORE ARGUMENT: Against readings (following Roman Rosdolsky) that treat the Grundrisse as demonstrating Marx's deep and continuing dependence on Hegelian logic, Rosenthal argues the Grundrisse actually dramatizes Marx's escape from that heritage: Marx's attempts at "dialectical derivations" of economic categories repeatedly lead to theoretical dead ends, and his genuine analytical progress comes precisely when he abandons dialectical argumentation for what Rosenthal calls "transcendental" reasoning from given market phenomena back to their conditions of possibility. RELEVANCE: Directly engages the Grundrisse's "Notebook on Method" material named in the domain brief and offers the strongest available textual case, within this bibliography, that "materialist inversion" is not a stable method Marx successfully transfers from Hegel but a project he tries and largely fails to sustain. POSITION: Rupture thesis -- the Grundrisse shows Marx's practical abandonment, not confirmation, of Hegelian dialectical method.},
    keywords = "grundrisse, notebook-on-method, rupture-thesis, High, METADATA\\\_CLEANED: journal, type:@article->@misc",
    abstract = "At least since the publication of Roman Rosdolsky's The Making of Marx's Capital , the Grundrisse has been an essential refer-ence for anyone wishing to demonstrate a significant dependence of Marx's political economy upon Hegelian “logic.” Contrary to Rosdolsky's interpretation, however, the Grundrisse can in fact be read as the drama of Marx's escape from his Hegelian philosophical heritage. Hegel's “dialectical method” is not a method of logi-cal argumentation, but a “method” of paralogical mystification. Marx's own attempts to construct “dialectical derivations” of eco-nomic categories in the Grundrisse lead him into theoretical culs-de-sac , and he is only able to make real progress in his economic inves-tigations by precisely foregoing such adventures. The persistence, nonetheless, of certain characteristically Hegelian formulae - though, n.b., not characteristically Hegelian argumentational struc-tures - in Capital , and especially in the first chapter, is a function of the ontological peculiarity of Marx's initial object of inquiry, viz., money, and does not reflect any “methodological” choice. Marx's arguments in Capital are not “dialectical” but rather “transcenden-tal” in nature, starting from given market phenomena (prices, profit, etc.) and working back to their conditions of possibility.",
    abstract_source = "openalex"
}

@article{horn2013enigma,
    author = "Horn, Alan James",
    title = "The Enigma of the Inversion, Part One: Rational Kernel and Mystical Shell",
    journal = "Critique",
    year = "2013",
    volume = "41",
    number = "1",
    pages = "23--54",
    doi = "10.1080/03017605.2013.776230",
    note = {CORE ARGUMENT: Horn undertakes a sustained study of the 1873 afterword's central metaphor -- Hegel's dialectic "standing on its head," containing a "rational kernel" within a "mystical shell" -- asking precisely what is supposed to be extracted (kernel) and discarded (shell), and argues that Marx's own formulations across different texts are not fully consistent on this point, generating a genuine interpretive "enigma" rather than a settled doctrine. RELEVANCE: The single most directly relevant paper in this domain to the project's question about the 1873 afterword's relation to earlier formulations of materialist inversion, since it treats the afterword's metaphor as a textual problem requiring reconstruction rather than as a self-explanatory slogan. POSITION: Diagnostic/skeptical -- treats "inversion" as textually underdetermined and contested rather than a stable, well-defined Marxian method.},
    keywords = "1873-afterword, materialist-inversion, rational-kernel, High",
    abstract = "The mystification which dialectic suffers in Hegel's hands, by no means prevents him from being the first to present its general form of working in a comprehensive and conscious manner. With him it is standing on its head. It must be turned right side up again, if you would discover the rational kernel within the mystical shell.1 1K. Marx, Capital, Vol. 1, Afterword to the second German edition, written 24 January 1873 (London: Lawrence \\\& Wishart, 1974), p. 29. This essay investigates what the determinate content of the “rational kernel within the mystical shell” of the Hegelian method could be. The manner in which Hegel mystifies the dialectic is further connected with Marx's theoretical advice that it “must be turned right side up again.”",
    abstract_source = "openalex"
}

@article{reichelt2007marxs,
    author = "Reichelt, Helmut",
    title = "Marx's Critique of Economic Categories: Reflections on the Problem of Validity in the Dialectical Method of Presentation in Capital",
    journal = "Historical Materialism",
    year = "2007",
    volume = "15",
    number = "4",
    pages = "3--52",
    doi = "10.1163/156920607X245823",
    note = {CORE ARGUMENT: Reichelt, a leading figure in the West German "New Reading of Marx" (Neue Marx-Lektüre), argues that Capital's dialectical presentation of categories (commodity, value, money) is not merely expository but constitutes a genuine logical derivation modeled on, and only comprehensible in light of, Hegel's Science of Logic, and defends the "validity" of this method against critics who treat it as dispensable rhetorical ornament. RELEVANCE: Represents the strongest "continuity of method" position among the Capital-focused papers in this bibliography, directly opposed to Rosenthal's and Carver's more skeptical readings, and gives the project a clear textual basis for the "method transfer" horn of the materialist-inversion question. POSITION: Strong continuity thesis -- Capital's method of presentation is substantively Hegelian-logical, not merely stylistically so.},
    keywords = "capital, method-of-presentation, hegels-logic, neue-marx-lekture, Medium",
    abstract = "Abstract It has often been pointed out that the Marxian theory of value contains some inconsistencies, usually in relation to the concept of abstract labour. However, the contradiction between the concept of labour and the concept of validity with which Marx operates in Capital (without actually explaining this conception) has never been discussed. A detailed analysis shows that this concept of validity refers to the process of abstraction which is carried out by the participants of the exchange process. Only the rigorous comprehension of this process of abstraction can illuminate that for which the concept of abstract labour was developed: the unity and universality of value. On this basis, the paper criticises the Marxian development of the money-form and presents an alternative approach that builds on the aforementioned concept of validity. This concept is formulated in more depth by recourse to the works of Hegel, Simmel and Adorno. Furthermore, the paper reconsiders the dialectical development of categories in the light of this alternative conception of the money-form as totality and abstraction (in the sense of Hegel and the young Marx). Finally, the distinction between simple circulation and the process as a whole (found only in the Grundrisse) is explored and it is argued that, according to the novel reading proposed, it acquires a fundamental significance.",
    abstract_source = "openalex"
}

@article{postonereinicke1974nicolaus,
    author = "Postone, Moishe and Reinicke, Helmut",
    title = "On Nicolaus's ``Introduction'' to the Grundrisse",
    journal = "Telos",
    year = "1974",
    volume = "1974",
    number = "22",
    pages = "130--148",
    doi = "10.3817/1274022130",
    note = {CORE ARGUMENT: Written as a critical response to Martin Nicolaus's introduction to the English translation of the Grundrisse, this article contests Nicolaus's characterization of Marx's 1857 "Introduction" and argues for a different reading of how Marx's methodological reflections there relate to Hegelian categories of the abstract and the concrete, the general and the specific. RELEVANCE: Engages directly with the Grundrisse's 1857 Introduction named in the domain brief, and because it is a direct response to a major English-language edition's framing essay, it offers insight into the reception history of the Grundrisse's methodological statements as much as into the text itself. POSITION: Contests standard (Nicolaus) framing of the 1857 Introduction's relation to Hegelian logic; part of the early Telos-circle engagement with Frankfurt-School-adjacent readings of Marx's method.},
    keywords = "grundrisse, 1857-introduction, reception-history, Medium",
    abstract = "Abstract By translating the extremely difficult text of the Grundrisse, Martin Nicolaus has made an important political contribution. His lengthy introduction to it is an attempt to generate a more thorough immanent analysis of the corpus of Marx's critique of political economy. In this respect, the Grundrisse is of central importance for the reconstruction of Marxian thought. It lacks the tight logical structure of Capital but has a broader explicit scope which adds depth and richness to an understanding of the categorical unfolding of the critique of political economy. While it clearly puts to rest any theory of a rupture between Marx's early and later works, the Grundrisse also presents developments in his thought which render untenable an unmediated identification of the categories of the works of 1844–46 (Economic and Philosophical Manuscripts, the “Theses on Feuerbach,” The German Ideology) with those of Capital; that is, an interpretation of the categories of the early works as the “philosophical underpinnings” of the later “economic” categories.",
    abstract_source = "openalex"
}

@article{barbour2023logic,
    author = "Barbour, Charles",
    title = "The Logic Question: Marx, Trendelenburg, and the Critique of Hegel",
    journal = "Historical Materialism",
    year = "2023",
    volume = "32",
    number = "3",
    pages = "252--281",
    doi = "10.1163/1569206x-bja10026",
    note = {CORE ARGUMENT: Barbour reconstructs the intellectual context of Adolf Trendelenburg's influential critique of Hegel's Logic -- a critique Marx read and drew upon -- and argues that important elements of Marx's own critique of Hegel's dialectic, often assumed to be original, are substantially indebted to this specifically logical, pre-Marxian "Logic Question" debate in 1840s German philosophy. RELEVANCE: Establishes that the materialist inversion of Hegel was not invented ex nihilo by Marx but drew on an existing philosophical controversy over the validity of Hegelian dialectical logic, complicating any account of the critique's development that treats it as internally generated purely from Marx's own theoretical trajectory. POSITION: Contextualist -- situates Marx's logical critique of Hegel within the broader mid-nineteenth-century "Logic Question" rather than treating it as sui generis.},
    keywords = "trendelenburg, hegels-logic, intellectual-context, High",
    abstract = "This paper provides a reconstruction and analysis of Marx’s early engagements with logic, and especially his studies of Hegel’s logic, on the one hand, and Hegel’s great if often overlooked critic Adolf Trendelenburg, on the other. It itemises the archival evidence that Marx read and planned to compose a Hegelian response to Trendelenburg’s devastating attack on dialectics in his 1840 Logische Untersuchungen – the work that arguably did more than any other single text to destroy the influence of Hegelianism among German intellectuals at the time. It argues that the young Marx was a more sophisticated reader of Hegel and of philosophy in general than is typically acknowledged. Against the backdrop of these claims, it then proposes a new reading of Marx’s work from 1839 to 1842 – one that takes the emphasis off the familiar distinction between materialism and idealism, which was as much an invention of Engels’s later interpretations of the early Marx as it was an invention of Marx himself, and places it instead on what early nineteenth-century thinkers would have understood to be the more comprehensive question of logic.",
    abstract_source = "s2"
}

@article{flohr2023karls,
    author = "Flohr, Mikkel",
    title = "Karl Marx's Critique of the State as an Alienation of Society in His 1843 Critique of Hegel's Doctrine of State",
    journal = "Distinktion: Journal of Social Theory",
    year = "2023",
    volume = "25",
    number = "3",
    pages = "361--385",
    doi = "10.1080/1600910X.2023.2173268",
    abstract = "Alienation became a central but controversial concept in the reception and interpretation of Karl Marx's thought after the posthumous publication of the Economic and Philosophical Manuscripts in 1932. Numerous interlocutors debated the content and configuration of Marx's concept of alienation and its relationship to G.W.F. Hegel and Ludwig Feuerbach, as well as his own subsequent critique of political economy. But these debates inadvertently ignored Marx's prior Critique of Hegel's Doctrine of State. This article aims to remedy this omission. Through close textual analysis and theoretical recontextualization I reconstruct and reinterpret Marx's elaborate critique of the modern sovereign state as an alienation of civil society rooted in the dynamics of the modern system of private property, which also sheds new light on Marx's concept of alienation, its relationship to prior political philosophy, (post-)Hegelian philosophy and his subsequent critique of political economy.",
    abstract_source = "semantic\\\_scholar",
    note = {CORE ARGUMENT: Flohr argues that the standard scholarly debate over Marx's concept of alienation -- typically framed as beginning with the 1844 Manuscripts and its relation to Hegel and Feuerbach -- has systematically overlooked the prior 1843 Critique of Hegel's Doctrine of State, where Marx already develops, through close paragraph-by-paragraph engagement with Hegel's text, an account of the modern sovereign state itself as a form of alienation rooted in the structure of private property. RELEVANCE: Directly relevant to the domain's textual-chronological aim of establishing where Marx's alienation vocabulary first appears in relation to Hegel, pushing the origin of "alienation" as a critical category back into the 1843 manuscript rather than treating 1844 as its point of departure. POSITION: Close textual reading that revises the standard periodization of Marx's alienation concept by relocating its origin within the 1843 Critique itself.},
    keywords = "1843-critique, alienation, state-theory, close-reading, High"
}

@misc{caligarisstarosta2014rational,
    author = "Caligaris, Gastón and Starosta, Guido",
    title = "Which `Rational Kernel'? Which `Mystical Shell'? A Contribution to the Debate on the Connection between Hegel's Logic and Marx's Capital",
    year = "2014",
    pages = "89--111",
    publisher = "Brill",
    note = {CORE ARGUMENT: Caligaris and Starosta intervene directly in the debate over the 1873 afterword's "rational kernel"/"mystical shell" metaphor, arguing against strong "homology thesis" readings that map Capital's categorial structure one-to-one onto Hegel's Science of Logic, while also rejecting readings that treat the Hegelian debt as merely rhetorical; they propose an intermediate account in which Marx appropriates specific logical forms (e.g., the movement from abstract to concrete) while transforming their content and function. RELEVANCE: Offers the most focused available treatment, within this bibliography, of exactly the interpretive question the domain brief poses about the 1873 afterword -- whether "inversion" is a method transfer, a content substitution, or both -- and stakes out an explicit middle position between those alternatives. POSITION: Intermediate/qualified continuity thesis, explicitly framed against both strong homology and pure-rhetoric readings of the 1873 afterword.},
    keywords = "1873-afterword, rational-kernel, homology-thesis, capital, High, METADATA\\\_CLEANED: booktitle, type:@incollection->@misc, METADATA\\_CLEANED: doi",
    abstract = "The question about Hegel's legacy in the Marxian critique of political economy has been one of the most widely debated issues within the history of Marxist thought. This debate about the significance of the Logic for the critique of political economy can be reframed in terms of Marx's well-known explicit statement about the relationship between his dialectical method and Hegel's: the key issue at stake seems to be the establishment of the precise nature of the rational kernel within the mystical shell. This chapter attempts to contribute to the debate by providing an alternative perspective on the connection between Hegel's Logic and Marx's Capital . According to the argument put forward in his book The Logic of Marx's 'Capital' , Hegel's Logic deals with the fundamental categories of thought that are necessary to grasp the inner intelligibility of reality. Keywords: Hegel's Logic ; Marx's Capital ; mystical shell; rational kernel",
    abstract_source = "openalex"
}

@misc{campbell1996failure,
    author = "Campbell, David",
    title = "The Failure of Marxism: The Concept of Inversion in Marx's Critique of Capitalism",
    year = "1996",
    note = {CORE ARGUMENT: Campbell treats "inversion" as Marx's single master concept for critique -- applied to Hegel's speculative philosophy, to commodity fetishism, and to ideology generally -- and argues that this concept, for all its polemical power, ultimately fails to do the philosophical work Marx requires of it, generating unresolved ambiguities between inversion as an epistemological error, a socio-structural phenomenon, and a rhetorical device. RELEVANCE: A book-length treatment focused entirely on the "inversion" concept named directly in the domain brief, offering the most sustained critical (rather than expository) engagement with Umstülpung as a candidate technical term across Marx's corpus, from the Hegel critique through Capital. POSITION: Critical of the coherence of "inversion" as a unified Marxian concept, arguing it papers over distinct and not fully compatible senses.},
    keywords = "materialist-inversion, umstulpung, critical-assessment, Medium, INCOMPLETE, METADATA\\\_CLEANED: publisher, type:@book->@misc"
}

@incollection{schuringa2023gattungswesen,
    author = "Schuringa, Christoph",
    title = "Gattungswesen and Universality: Feuerbach, Marx and German Idealism",
    booktitle = "Studies in German Idealism",
    year = "2023",
    pages = "247--262",
    publisher = "Springer International Publishing",
    note = {CORE ARGUMENT: Schuringa traces the concept of Gattungswesen (species-being), inherited from Feuerbach and central to Marx's 1844 Manuscripts, back into its German Idealist sources, arguing that Marx's use of the term retains a residual universalism drawn from the idealist tradition even as Marx redirects it toward a materialist account of concrete social relations, and that this tension is only partially resolved by the time of the German Ideology's critique of Feuerbachian abstraction. RELEVANCE: Supplies the connecting textual link between the Feuerbach-critique material central to the 1844 Manuscripts and The German Ideology's "Feuerbach" chapter, addressing the domain's coverage gap on how the critique of idealism is specifically mediated through the critique of Feuerbach. POSITION: Close conceptual-historical reading emphasizing the incomplete transformation of an idealist category (species-being) within Marx's developing materialism.},
    keywords = "feuerbach, species-being, german-idealism, 1844-manuscripts, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: doi"
}

@article{whyman2022egoism,
    author = "Whyman, Tom",
    title = "Egoism and Class Consciousness, or: Why Marx and Engels Wrote So Much About Stirner",
    journal = "Hegel Bulletin",
    year = "2022",
    volume = "44",
    number = "3",
    note = {CORE ARGUMENT: Whyman argues that the disproportionate length of the Stirner critique in The German Ideology (far exceeding the famous "chapter" on Feuerbach in most abridged editions) reflects genuine intellectual affinity rather than mere polemical excess. Marx and Engels credit Stirner with real advances on the critique of reason and on egoistic self-interest, but hold that Stirner gets the relation between the two "the wrong way around," which in turn forces Marx and Engels to clarify their own conception of communism by "turning Stirner on his head." RELEVANCE: Directly substantiates the project's third key question: it explains, on textual grounds, why Stirner functioned as more than an incidental foil, and shows how the polemic against him was constitutive (not merely destructive) of Marx's positive theory of communism and historical materialism. POSITION: Represents a revisionist reading that treats the Stirner polemic as philosophically productive rather than as a symptom of Marx and Engels's excessive, score-settling verbosity.},
    keywords = "stirner-marx, holy-family-german-ideology, egoism, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract Interest in The German Ideology has largely focused on the 'chapter' on Feuerbach--invariably the focus of the various abridgements in which the work is usually read. But this does not reflect the weighting of the text itself, which is dominated by Marx and Engels's critique of the radical egoist philosopher Max Stirner. Which begs the question: just why did they spend so much time and effort writing about Stirner? In this paper, I will provide an answer--which comes down to three related points. The first concerns the critique of reason; the second, egoistic self-interest. On both of these two points, Stirner makes a novel contribution--contributions which Marx and Engels feel clear affinities with. However, Stirner can ultimately be seen to get these two points, as it were, the wrong way around. This then leads to the third point: Stirner's misunderstanding of the nature of Communism. To clarify the nature of Communism, then, Marx and Engels were compelled to turn Stirner on his head.",
    abstract_source = "openalex"
}

@article{barbour2021karl,
    author = "Barbour, Charles",
    title = "Karl Marx, Bruno Bauer and the Ends of Classical German Theology",
    journal = "Critique",
    year = "2021",
    volume = "49",
    note = {CORE ARGUMENT: Barbour reassesses Marx's early collaboration with Bauer against the received view (partly derived from Marx and Engels's own retrospective accounts) that the "Young Hegelian moment" was excessively theoretical and liberal. Drawing on recent contextual scholarship on Bauer's political theology, Barbour argues the decisive shift in Marx's position was less a move from theory to practice than a move from a coded political theology of institutional struggle to a politics of mass democratic mobilization. RELEVANCE: Bears on key question 3 by reframing Bauer's significance as a foil: the essay shows that Marx's break with Bauer is best understood politically and theologically rather than as a simple graduation from "abstract" philosophy to "concrete" materialism, complicating any straightforward idealism-to-materialism narrative. POSITION: A contextualist, revisionist account that resists both the "liberal Young Hegelian" reading and a teleological reading of Marx's development toward historical materialism.},
    keywords = "bauer-marx, young-hegelians, political-theology, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "This paper aims to evaluate the political-theological significance of Karl Marx's early collaborations with his academic mentor and personal friend Bruno Bauer. For much of the twentieth century, and in part due to Marx's and Engels's own later reflections on their intellectual development, the dominant interpretations of this so-called 'Young Hegelian' moment in Marx's career tended to characterise it as excessively theoretical and essentially liberal in its orientation. However, more recent historical and contextual scholarship has revealed the limitations of this approach. Building on new political readings of Bauer's work in particular, and the theoretical polemics of the Vormarz more generally, I explore the radical and revolutionary implications of Marx's youthful writings. The salient shift in Marx's position was less from theory and liberalism to practice and communism, I maintain, than it was from a politics of institutional struggle via the coded discourse of political theology to one of mass mobilisation and democratic action.",
    abstract_source = "s2"
}

@misc{moggach2009subject,
    author = "Moggach, Douglas",
    title = "The Subject as Substance: Bruno Bauer's Critique of Stirner",
    year = "2009",
    volume = "41",
    number = "1",
    note = {CORE ARGUMENT: Moggach reconstructs Bauer's own critique of Stirner's egoism, showing how Bauer defended a post-Kantian "infinite self-consciousness" against Stirner's dissolution of all normative universals into the particular "unique one" (der Einzige). Bauer accuses Stirner of collapsing the subject back into mere substance, thereby losing the rational autonomy Bauer's Hegelian republicanism sought to preserve. RELEVANCE: Provides the internal Young Hegelian debate (Bauer versus Stirner) that forms the immediate background to Marx and Engels's own, distinct critique of Stirner in The German Ideology, allowing the project to situate Marx's polemic within a wider three-way argument rather than treating Bauer and Stirner as an undifferentiated set of "foils." POSITION: Represents the Bauer-centered strand of the New Hegelian/Young Hegelian revisionist scholarship (associated with Moggach's broader work on Bauer's political philosophy) that treats Bauer's post-Kantian perfectionism as a serious philosophical position rather than a mere way-station to Marx.},
    keywords = "bauer-marx, stirner-marx, young-hegelians, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@article{fromm2015empiricism,
    author = "Fromm, Georg H. and Almeida, Manuel S.",
    title = "Empiricism, Science, and Philosophy in The German Ideology",
    journal = "Rethinking Marxism",
    year = "2015",
    number = "1",
    note = {CORE ARGUMENT: The authors examine the methodological status of Marx and Engels's "empiricism" in The German Ideology's Feuerbach chapter, arguing that Marx's break with Feuerbachian and speculative philosophy involves a specific reconception of what counts as scientific, empirical knowledge of history and society -- one that is neither naive empiricism nor a return to Hegelian speculation. RELEVANCE: Speaks directly to key question 2 (what Marx retains from and rejects in Feuerbachian materialism), by clarifying the epistemological stakes of Marx's stated preference for "real, positive science" over both idealist speculation and Feuerbach's contemplative materialism. POSITION: A close textual reading situated within debates over the scientific status of historical materialism and its relation to empiricism.},
    keywords = "feuerbach-marx, german-ideology, materialism, High, METADATA\_CLEANED: volume, pages, doi",
    abstract = "Ever since the full text of The German Ideology appeared in 1932 it has been subject to persistent misreading due to the fact that the idiosyncratic nature of this work--as merely a rough, unedited, and unfinished draft as well as a fiercely polemical text--has been neglected. As a result, the majority of scholars have tended to claim that Marx and Engels in this work propose an empiricist or positivistic conception of human history and society. A critical reading that is sensitive to the peculiar nature of this text reveals that these common interpretations are wholly ungrounded and that, on the contrary, the authors develop their polemic against the Young Hegelians from an outlook that is deeply indebted to the Hegelian philosophical legacy (even though paradoxically the latter espouses an absolute idealistic viewpoint).",
    abstract_source = "openalex"
}

@article{kangal2020marx,
    author = "Kangal, Kaan",
    title = "Marx's `Bonn Notebooks' in Context: Reconsidering the Relationship between Bruno Bauer and Karl Marx Between 1839 and 1842",
    journal = "Historical Materialism",
    year = "2020",
    volume = "28",
    number = "4",
    note = {CORE ARGUMENT: Using Marx's unpublished "Bonn Notebooks," Kangal reconstructs the early, collaborative phase of the Marx-Bauer relationship (1839-42), before Bauer's turn to atheism was complete, showing that the two men's "turbulences," "detours," and "abandoned work" during this period reveal a more ambivalent and mutually formative relationship than the later, purely antagonistic image drawn from The Holy Family suggests. RELEVANCE: Directly answers key question 3 by supplying the textual-historical evidence for how significant Bauer was to Marx prior to becoming a foil -- establishing that Marx's later polemic in The Holy Family presupposes years of genuine intellectual partnership, not simply external opposition. POSITION: Represents recent archivally grounded MEGA-based scholarship that revises standard accounts of Marx's intellectual formation by attending closely to manuscript evidence rather than the published, retrospective narrative.},
    keywords = "bauer-marx, young-marx, textual-history, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract The following is a critical reconstruction of the collaboration between Bauer and Marx between 1839 and 1842. The turbulences in the period in question reveal themselves in Marx's thought as well as in his relationship with Bruno Bauer. Correspondingly, Marx's detours, false paths, dead ends and abandoned work are therefore made the focus of this study. The ambivalent initial relations between the two of them, which both made their collaboration possible and hindered it, clearly go back further than 1841, when Bauer was not yet an atheist and was still a proponent of church doctrine. This was the Bruno Bauer that Marx had come to know in the Doctor's Club. We then meet Bauer the atheist at the end of 1839 or perhaps the beginning of 1840, as he was planning a comprehensive attack on orthodox theology and wanted Marx to fight on his side. This attack continued in Bauer's Trumpet and in Hegel's Doctrine.",
    abstract_source = "openalex"
}

@misc{peled1992theology,
    author = "Peled, Yoav",
    title = "From Theology to Sociology: Bruno Bauer and Karl Marx on the Question of Jewish Emancipation",
    year = "1992",
    volume = "13",
    number = "3",
    note = {CORE ARGUMENT: Peled argues that Marx's response to Bauer's Die Judenfrage in "On the Jewish Question" shifts the terms of the debate over Jewish emancipation from the theological plane, on which Bauer had staged the argument, to a sociological plane, thereby launching Marx's critique of economic alienation as a byproduct of a debate initially framed by Bauer. RELEVANCE: Illustrates a concrete case in which polemical engagement with Bauer generates substantive philosophical advance in Marx's thought, supporting the project's account of the Young Hegelian milieu as productively, not merely negatively, formative for Marx's early materialism. POSITION: A contextualist account emphasizing the specific 1843 debate over Jewish emancipation as a hinge point in Marx's shift from theological to social-economic categories of critique.},
    keywords = "bauer-marx, jewish-question, alienation, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@article{thomas1975karl,
    author = "Thomas, Paul",
    title = "Karl Marx and Max Stirner",
    journal = "Political Theory",
    year = "1975",
    volume = "3",
    note = {CORE ARGUMENT: Thomas traces the direct textual confrontation between Marx and Stirner in The German Ideology, arguing that Marx's lengthy and often mocking refutation of Der Einzige und sein Eigenthum forced him to specify, against Stirner's radical nominalist individualism, what kind of "individual" and what kind of freedom historical materialism could coherently endorse. RELEVANCE: A foundational study for key question 3, directly tracing textual influence (rather than offering a general intellectual-historical survey) and establishing the terms in which Marx's critique of Stirner should be read as integral to, not peripheral to, the argument of The German Ideology. POSITION: An early and influential statement of the view that Stirner's egoism, however extravagant in presentation, posed a serious challenge that materially shaped Marx's mature conception of individuality and communism.},
    keywords = "stirner-marx, german-ideology, individualism, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "Few persons familiar with the writings of Marx would deny the importance of The German Ideology; yet its belated publication and translation has long had the effect of obscuring most of its contents. It has rarely been read in its entirety; the long section Marx devoted to a phrase-by-phrase dissection of Stirner's Der Einzige und sein Eigenthum, in particular, has been almost completely ignored. Because Roy Pascal's translation of The German Ideology omitted Marx's attack on Stirner, even though this section (Sankt Max) comprises fully three-quarters of the book Marx wrote, the erroneous belief seems to have grown up, even among Marxologists, that Sankt Max is irrelevant or unimportant. This belief is not supported by an examination of its text. Sankt Max is anything but peripheral to the argument of the rest of The German Ideology, a work whose most important themes are fully developed only in Sankt Max. Without an understanding of Stirner, the significance of The German Ideology cannot be fully grasped.",
    abstract_source = "openalex"
}

@misc{rosen1977bruno,
    author = "Rosen, Zvi",
    title = "Bruno Bauer and Karl Marx",
    year = "1977",
    note = {CORE ARGUMENT: Rosen provides the fullest monographic treatment of Bauer's influence on Marx's thought, reconstructing in detail the intellectual trajectory from their shared Hegelian starting point through Bauer's theory of self-consciousness and critique of religion to their eventual and decisive rupture, culminating in The Holy Family. RELEVANCE: Serves as the primary reference work for tracing, chapter by chapter, exactly which elements of Bauer's philosophy (the critique of religious alienation, the theory of infinite self-consciousness) Marx absorbed and transformed on his way toward historical materialism, directly addressing key question 3. POSITION: A comprehensive, textually grounded intellectual history that treats Bauer as a philosophically serious interlocutor whose specific arguments, not merely his general "Young Hegelian" orientation, shaped Marx's early development.},
    keywords = "bauer-marx, young-hegelians, monograph, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, doi, type:@book->@misc"
}

@book{breckman1999marx,
    author = "Breckman, Warren",
    title = "Marx, the Young Hegelians, and the Origins of Radical Social Theory",
    year = "1999",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Breckman situates the Young Hegelian movement, and Marx's emergence from it, within a longer German debate over the "personalist" conception of God and its political correlates, arguing that Feuerbach's, Bauer's, and Stirner's various critiques of religious and political personality supplied the categories through which Marx articulated his own critique of civil society and the state. RELEVANCE: Provides the broadest contextual frame for the whole domain, linking the religious critique undertaken by Feuerbach, Bauer, and Strauss to the political and social critique Marx develops, and thus helps connect this domain's material to the project's larger concern with Marx's critique of Hegel's idealist conception of history and the state. POSITION: A major synthetic intellectual history that reads the entire Young Hegelian episode through the lens of the crisis of religious and political "personality," rather than treating Feuerbach, Bauer, and Stirner as separable, discrete influences.},
    sep_context = {Cited in SEP 'Ludwig Andreas Feuerbach' (section 3, 'Feuerbach as Historian of Philosophy'): grouped with Gooch 2011 as recent scholarship on the Young Hegelians' opposition to right-wing Hegelians and "Positive Philosophy" in the late 1830s.},
    keywords = "young-hegelians, feuerbach-marx, bauer-marx, stirner-marx, monograph, High, METADATA\_CLEANED: doi",
    abstract = "This is the first major study of Marx and the Young Hegelians in twenty years. The book offers a new interpretation of Marx's early development, the political dimension of Young Hegelianism, and that movement's relationship to political and intellectual currents in early nineteenth-century Germany. Warren Breckman challenges the orthodox distinction drawn between the exclusively religious concerns of Hegelians in the 1830s and the sociopolitical preoccupations of the 1840s. He shows that there are inextricable connections between the theological, political and social discourses of the Hegelians in the 1830s. The book draws together an account of major figures such as Feuerbach and Marx, with discussions of lesser-known but significant figures such as Eduard Gans, August Cieszkowski, Moses Hess, F. W. J. Schelling as well as such movements as French Saint-Simonianism and 'positive philosophy'. Wide-ranging in scope and synthetic in approach, this is an important book for historians of philosophy, theology, political theory and nineteenth-century ideas.",
    abstract_source = "openalex"
}

@misc{brudney1998marxs,
    author = "Brudney, Daniel",
    title = "Marx's Attempt to Leave Philosophy",
    year = "1998",
    note = {CORE ARGUMENT: Brudney offers a sustained philosophical reading of Marx's early manuscripts, including a dedicated treatment of the "Theses on Feuerbach," arguing that Marx's ambition was not merely to correct Feuerbach's materialism but to escape the entire genre of philosophical argument that both Hegel and Feuerbach still practiced, replacing philosophical demonstration with a form of critical, practically oriented social theory. RELEVANCE: Central to key question 2: Brudney's chapter-length analysis of the Theses supplies a rigorous account of exactly what Marx retains (the demand that thought be practically efficacious) and rejects (Feuerbach's residual philosophical, contemplative stance) in the transition to historical materialism. POSITION: A distinctive philosophical (rather than purely historical) interpretation arguing that Marx's project is best understood as an attempted exit from philosophy as such, not simply a new philosophical position.},
    keywords = "feuerbach-marx, theses-on-feuerbach, monograph, High, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "Brudney traces post-Hegelian thought from Feuerbach through Bauer to Marx's work of 1844 and his Theses on Feuerbach, and ends with an examination of The German Ideology. He shows how Marx attempted to reveal humanity's nature and a notion of the good life, while polemicizing against any concern with metaphysics and epistemology.",
    abstract_source = "openalex"
}

@book{leopold2007young,
    author = "Leopold, David",
    title = "The Young Karl Marx: German Philosophy, Modern Politics, and Human Flourishing",
    year = "2007",
    publisher = "Cambridge University Press",
    note = "CORE ARGUMENT: Leopold reconstructs the philosophical development of the young Marx from his doctoral dissertation through the 1844 Manuscripts, giving close attention to Marx's shifting relationship to Feuerbach's anthropological materialism, Bauer's self-consciousness philosophy, and Stirner's egoism, and to how each contributed to Marx's emerging account of human flourishing and alienation. RELEVANCE: Offers one of the most detailed and philosophically careful accounts of how all three figures in this domain (Feuerbach, Bauer, Stirner) functioned together as resources and obstacles for the young Marx, making it a central synthesizing reference for the domain as a whole. POSITION: A rigorously textual and philosophically analytic study that resists both purely historicist and purely presentist readings of the young Marx, insisting on close engagement with the actual arguments of Feuerbach, Bauer, and Stirner.",
    keywords = "feuerbach-marx, bauer-marx, stirner-marx, young-marx, monograph, High, METADATA\_CLEANED: doi",
    abstract = "The Young Karl Marx is an innovative and important study of Marx's early writings. These writings provide the fascinating spectacle of a powerful and imaginative intellect wrestling with complex and significant issues, but they also present formidable interpretative obstacles to modern readers. David Leopold shows how an understanding of their intellectual and cultural context can illuminate the political dimension of these works. An erudite yet accessible discussion of Marx's influences and targets frames the author's critical engagement with Marx's account of the emergence, character, and (future) replacement of the modern state. This combination of historical and analytical approaches results in a sympathetic, but not uncritical, exploration of such fundamental themes as alienation, citizenship, community, anti-semitism, and utopianism.",
    abstract_source = "openalex"
}

@misc{mah1987end,
    author = "Mah, Harold",
    title = "The End of Philosophy and the Origin of Ideology: Karl Marx and the Crisis of the Young Hegelians",
    year = "1987",
    note = {CORE ARGUMENT: Mah argues that the "crisis" of the Young Hegelian movement after 1841 -- the increasing radicalization and mutual fragmentation of Feuerbach, Bauer, and Stirner's positions -- is constitutive of, not merely background to, Marx's development of the concept of "ideology" and his eventual claim to have left philosophy behind for a science of history. RELEVANCE: Useful for framing the domain as a single unfolding "crisis" rather than three separate influences, supporting the project's account of how Marx's idealism critique crystallizes specifically out of the internal collapse of the Hegelian school. POSITION: An intellectual-historical account that treats the concept of ideology itself as an artifact of the Young Hegelian crisis, linking Marx's epistemological claims to the sociological collapse of the movement he emerged from.},
    keywords = "young-hegelians, ideology, monograph, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{browning1999german,
    author = "Browning, Gary K.",
    title = "The German Ideology, Stirner and Hegel: The Theory of History and the History of Theory",
    year = "1999",
    publisher = "Palgrave Macmillan UK",
    note = "CORE ARGUMENT: Browning examines how Marx and Engels's critique of Stirner in The German Ideology is bound up with their emerging theory of history, arguing that refuting Stirner's ahistorical egoism required Marx and Engels to specify a materialist theory of historical development that itself remains in critical dialogue with Hegel's philosophy of history. RELEVANCE: Connects the Stirner polemic directly to the project's central concern with Marx's critique of the idealist conception of history, showing that the argument against Stirner is inseparable from the argument against residual Hegelian philosophy of history. POSITION: Situates the Stirner critique within a broader argument about continuity and rupture between Hegel's and Marx's theories of history, rather than treating it as a self-contained polemical episode.",
    keywords = "stirner-marx, german-ideology, philosophy-of-history, Medium, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "In this chapter it will be argued that The German Ideology should be analysed and interpreted as an integral whole. Its various sections, which have tended to be taken as detachable in previous interpretations, share a community of purpose and character. In design and practice The German Ideology is a work devoted to the history of theory. The character of the project upon which Marx and Engels are engaged in The German Ideology is clearly conveyed in the subtitles of its two volumes, 'Critique of Modern German Philosophy according to its representatives, Feuerbach, B. Bauer and Stirner', and 'Critique of German Socialism according to its various prophets'. The sections on Feuerbach, Bauer and Stirner, which constitute volume 1, criticise the respective philosophical positions of these Young Hegelian theorists by relating them to one another and tracing their derivation from Hegel's absolute idealism. The second volume, dealing with German socialism, criticises the attachment of German socialists to the language and concepts of philosophers in the Hegelian tradition analysed in the first volume.",
    abstract_source = "openalex"
}

@misc{thomson2004discovery,
    author = "Thomson, Ernie",
    title = "The Discovery of the Materialist Conception of History in the Writings of the Young Karl Marx",
    year = "2004",
    note = {CORE ARGUMENT: Thomson argues, against the "continuity thesis" associated with readings of Marx's development as a smooth unfolding, that the young Marx was a committed Feuerbachian in 1843-44 before breaking sharply and deliberately with Feuerbach in 1845, and offers an explanation of why this break took the particular form and timing it did, engaging critically with Althusser's "epistemological break" thesis in the process. RELEVANCE: Bears directly on key question 2 by providing a detailed chronological account of when and why Marx abandoned Feuerbachian materialism, and offers a historically specific alternative to Althusser's more structuralist account of the break. POSITION: A revisionist account within debates over Marx's intellectual continuity/discontinuity that treats the Feuerbach-to-materialist-history transition as a datable, motivated event rather than a gradual maturation.},
    keywords = "feuerbach-marx, young-marx, epistemological-break, INCOMPLETE, Medium, no-abstract"
}

@book{wartofsky1977feuerbach,
    author = "Wartofsky, Marx W.",
    title = "Feuerbach",
    year = "1977",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Wartofsky provides a comprehensive philosophical reconstruction of Feuerbach's intellectual development, including detailed treatment of the "transformative method" -- the technique, first applied to Hegel's Logic and then to Christian theology, of restoring predicates illegitimately hypostatized as an independent subject (Spirit, God) to their true subject, sensuous humanity. RELEVANCE: Supplies the fullest available account of the transformative method itself, which key question 1 identifies as the formal technique Marx inherits from Feuerbach and redeploys against Hegel's philosophy of the state and of history. POSITION: A comprehensive philosophical study of Feuerbach in his own right, read by later scholars (including Marx's own interpreters) as the standard account of the transformative method's structure and its application beyond the philosophy of religion.},
    keywords = "feuerbach-marx, transformative-method, monograph, Medium, INCOMPLETE, no-abstract"
}

@book{harvey1995feuerbach,
    author = "Harvey, Van A.",
    title = "Feuerbach and the Interpretation of Religion",
    year = "1995",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Harvey offers a systematic account of Feuerbach's theory of religion as "projection," analyzing the transformative method as the interpretive procedure by which Feuerbach reads religious and speculative-philosophical claims as disguised claims about human nature, and situates this method in relation to subsequent projection theories of religion. RELEVANCE: Provides an authoritative account of the mechanics of Feuerbach's method of critique specifically as applied to religion, which the project needs to establish precisely what Marx generalizes when he redirects Feuerbach's technique from theology to political economy and the state. POSITION: A philosophically rigorous study situated primarily within philosophy of religion rather than Marx scholarship, valuable here as a source on the transformative method independent of its Marxian afterlife.},
    keywords = "feuerbach-marx, transformative-method, religion, Medium, INCOMPLETE, no-abstract"
}

@misc{althusser2005formarx,
    author = "Althusser, Louis",
    title = "For Marx",
    year = "2005",
    address = "London",
    note = {CORE ARGUMENT: Collects Althusser's founding essays (1960-65) arguing that Marx's mature thought is separated from his Hegelian-humanist early writings by an "epistemological break" occurring around 1845. Introduces the concepts of "problematic" and symptomatic reading, and argues that the mature Marx replaces ideological notions of alienation and species-being with the scientific concepts of mode of production and overdetermined contradiction. RELEVANCE: This is the founding text of the break thesis and the primary source against which every subsequent continuity reading in this domain responds; it directly frames the question of whether Marx's critique of Hegelian idealism was completed in 1845 or continues throughout Capital. POSITION: Founding statement of the epistemological break (discontinuity) thesis.},
    keywords = "epistemological-break, Althusser, primary-source, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{althusserbalibar1970readingcapital,
    author = "Althusser, Louis and Balibar, Étienne",
    title = "Reading Capital",
    year = "1970",
    address = "London",
    note = {CORE ARGUMENT: A collaborative "symptomatic reading" of Capital that treats Marx's silences and theoretical gaps as evidence of an underlying but unstated "problematic," arguing that Capital's scientific object (the mode of production and its structural causality) is discontinuous with the humanist philosophical anthropology of Marx's early writings. RELEVANCE: Extends the epistemological-break thesis from For Marx into a close reading of Capital itself, making it the key primary source for assessing whether Marx's mature engagement with Hegelian categories (totality, contradiction) is scientific rather than idealist-philosophical in Althusser's sense. POSITION: Founding statement of structuralist ("symptomatic") reading as method for the discontinuity thesis.},
    keywords = "epistemological-break, Althusser, structuralism, primary-source, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@article{balibar1978bachelard,
    author = "Balibar, Etienne",
    title = "From Bachelard to Althusser: the concept of 'epistemological break'",
    journal = "Economy and Society",
    year = "1978",
    volume = "7",
    number = "3",
    pages = "207--237",
    doi = "10.1080/03085147800000013",
    abstract = "(1978). From Bachelard to Althusser: the concept of 'epistemological break'. Economy and Society: Vol. 7, No. 3, pp. 207-237.",
    abstract_source = "openalex",
    note = {CORE ARGUMENT: Traces the genealogy of the "epistemological break" from Gaston Bachelard's philosophy of science through Georges Canguilhem to Althusser's appropriation of it for reading Marx, examining how the concept's meaning shifted as it migrated from the history of the natural sciences to historical materialism. RELEVANCE: Provides the crucial historiographical background for evaluating whether "epistemological break" is a coherent, transferable concept when applied to Marx's relation to Hegel, since Balibar (Althusser's own collaborator) here scrutinizes the concept's original French epistemological context and its limits. POSITION: Internal, genealogical clarification and qualification of the break concept by a co-author of Reading Capital.},
    keywords = "epistemological-break, Bachelard, Althusser, historiography, High"
}

@misc{callinicos1976althussersmarxism,
    author = "Callinicos, Alex",
    title = "Althusser's Marxism",
    year = "1976",
    address = "London",
    note = "CORE ARGUMENT: A systematic critical exposition of Althusser's philosophy, including the theory of the epistemological break, structural causality, and overdetermination, assessing their coherence and their implications for Marxist theories of history and ideology. RELEVANCE: One of the earliest and most detailed critical responses to the break thesis from within the Marxist tradition, offering an assessment of whether Althusser's anti-humanist reading of Marx's rupture with Hegel is theoretically defensible. POSITION: Sympathetic but critical assessment of the epistemological-break thesis from a Trotskyist-influenced Marxist perspective.",
    keywords = "epistemological-break, Althusser, critical-response, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{elliott2006detour,
    author = "Elliott, Gregory",
    title = "Althusser: The Detour of Theory",
    year = "2006",
    address = "New York",
    note = {CORE ARGUMENT: Provides the fullest English-language account of Althusser's philosophico-political career, tracing the successive reformulations and eventual self-criticisms of the epistemological-break thesis across For Marx, Reading Capital, and Althusser's later "Marx in His Limits," where Althusser himself concedes that Marx never fully abandoned Hegelian teleology. RELEVANCE: Essential secondary source for tracking how the break thesis was revised and partially retracted by Althusser himself, showing that the "epistemological break" was never a static claim but a moving target reshaped under criticism (including from Thompson and others). POSITION: Comprehensive critical-historical reconstruction of the rise, mutation, and partial collapse of the epistemological-break thesis.},
    keywords = "epistemological-break, Althusser, historiography, self-criticism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{thompson1978poverty,
    author = "Thompson, E. P.",
    title = "The Poverty of Theory and Other Essays",
    year = "1978",
    address = "London",
    note = {CORE ARGUMENT: Mounts a polemical historicist attack on Althusserian structuralism, arguing that Althusser's "theoretical practice" and epistemological break eliminate human agency and historical process from Marxism, effectively substituting a new idealist rationalism (a Stalinism of theory) for genuine historical materialism. RELEVANCE: The most influential humanist-historicist rejection of the break thesis, framing Althusser's anti-humanism not as a scientific advance beyond idealism but as a new, more disguised form of idealist system-building — directly relevant to assessing what counts as genuinely overcoming Hegelian idealism. POSITION: Historicist/humanist repudiation of Althusserian structuralism as theoreticist idealism.},
    keywords = "epistemological-break, Althusser, historicism, critical-response, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{geras1983marxhumannature,
    author = "Geras, Norman",
    title = "Marx and Human Nature: Refutation of a Legend",
    year = "1983",
    address = "London",
    note = {CORE ARGUMENT: Argues against the widespread view (which Geras attributes largely to Althusserian influence) that Marx's historical materialism entailed a wholesale rejection of any concept of human nature; contends instead that a substantive, transhistorical conception of human nature does explanatory and normative work throughout Marx's later writings. RELEVANCE: A direct, sustained continuity-reading rebuttal to the Althusserian claim that "theoretical anti-humanism" is constitutive of Marx's scientific break with idealism, arguing the mature Marx retains categories continuous with his early Feuerbachian-inflected anthropology. POSITION: Continuity reading grounded in a defense of a Marxian theory of human nature against Althusserian anti-humanism.},
    keywords = "continuity, human-nature, Althusser, critical-response, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{meszaros1970alienation,
    author = "Mészáros, István",
    title = "Marx's Theory of Alienation",
    year = "1970",
    address = "London",
    note = {CORE ARGUMENT: Provides a systematic reconstruction of alienation as the central, unifying category of Marx's entire oeuvre, tracing its roots in Hegel and Feuerbach and arguing that the concept, far from being confined to the early manuscripts, structures Marx's mature critique of political economy in Capital. RELEVANCE: A foundational continuity-reading text explicitly named in the debate's historiography as an early and influential rival to the Althusserian break thesis, providing the detailed textual case for alienation's persistence into the "scientific" period. POSITION: Classical Hegelian-Marxist continuity reading centered on the persistence of alienation.},
    keywords = "continuity, alienation, Hegelian-Marxism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{ollman1971alienation,
    author = "Ollman, Bertell",
    title = "Alienation: Marx's Conception of Man in Capitalist Society",
    year = "1971",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    note = {CORE ARGUMENT: Reconstructs Marx's concept of alienation using a "philosophy of internal relations" derived partly from Hegel, arguing that Marx's mature social and economic categories (value, class, the state) can only be understood as elaborations of the relational ontology already present in the concept of alienated labor. RELEVANCE: Offers a methodological argument for continuity that runs counter to Althusser's claim that Marx's mature "science" operates with a wholly different, non-Hegelian logical structure, since Ollman locates a persistent Hegelian-relational method across Marx's career. POSITION: Continuity reading grounded in Marx's relational (quasi-Hegelian) dialectical method.},
    keywords = "continuity, alienation, dialectical-method, Hegelian-Marxism, Medium, INCOMPLETE, no-abstract"
}

@article{musto2015youngmarxmyth,
    author = "Musto, Marcello",
    title = "The 'Young Marx' Myth in Interpretations of the Economic–Philosophic Manuscripts of 1844",
    journal = "Critique",
    year = "2015",
    volume = "43",
    issue = "2",
    pages = "233--260",
    doi = "10.1080/03017605.2015.1051759",
    abstract = "Focusing on the dissemination and reception history of the Economic and Philosophic Manuscripts of 1844, this article will critically examine the famous controversy surrounding the relationship between Marx's 'early' and 'mature' writings. A review of all the major books published worldwide (especially in Germany, France, the Soviet Union and English-speaking countries) on Marx's early writings is followed by a plea for a new and rigorous reading of Marx's Paris manuscripts, which have been wrongly considered by almost all interpreters as a finished work. Careful textual analysis of the Economic and Philosophic Manuscripts of 1844 alongside the so-called Paris notebooks makes it possible to refute conceptions of the former as a fully fledged text either prefiguring Marx's thought as a whole (as Landshut or the French existentialists argued) or advancing a well-defined theory opposed to that of Marx's 'scientific' maturity (as Marxist-Leninist orthodoxy or Althusser claimed).",
    note = {CORE ARGUMENT: Reviews the international reception history of the 1844 Manuscripts and argues that both continuity readings (which treat the manuscripts as a finished statement of Marx's whole philosophy) and Althusserian discontinuity readings (which treat them as pure, superseded ideology) rest on a textually indefensible treatment of an unfinished, exploratory manuscript. RELEVANCE: Directly assesses the reliability of the textual basis on which the entire break/continuity debate rests, using philological evidence to argue that the "young Marx" invoked by both sides of the debate is substantially a retrospective construction rather than a textually grounded unity. POSITION: Philological/historiographical dissolution of the break-versus-continuity binary via reception history.},
    keywords = "continuity, philology, historiography, young-Marx, High"
}

@misc{cowling2023strategies,
    author = "Cowling, Mark",
    title = "Strategies of continuity and discontinuity in the interpretation of Marx's work: The case for discontinuity",
    year = "2023",
    volume = "48",
    issue = "1",
    pages = "95--117",
    doi = "10.1177/03098168221145366",
    abstract = "The publication of Marx's Economic and Philosophical Manuscripts (EPM) in German in 1933 immediately triggered off debate as to where the document fitted in Marx's theories generally. The obvious possibilities were first, that these writings could be dismissed as juvenilia, and that Marxism as understood by figures as diverse as Lenin, Kautsky, Bernstein, Rosa Luxemburg and Trotsky, none of whom said anything significant about alienation, could be studied and argued about while disregarding the EPM. Second, there were actually numerous reappearances of the theory of alienation in the writings of Marx after 1847, and the alienation theory must be very important in his mature writings. In what follows, I will argue the case for the unfashionable first alternative, but also be reviewing many of the arguments for and against continuity in Marx's work, hopefully making the article useful irrespective of which side one takes.",
    note = {CORE ARGUMENT: Surveys the full range of arguments for and against continuity between the 1844 Manuscripts and Marx's mature writings, and defends the "unfashionable" discontinuity position: that alienation theory, while occasionally recurring in vocabulary, does not play a load-bearing theoretical role in Marx's post-1847 political economy. RELEVANCE: A recent, balanced re-weighing of the entire evidentiary basis for the break/continuity debate that explicitly revisits Althusser's position alongside Mészáros's and Geras's, useful as a synthesis-stage guide to the state of the argument as of the 2020s. POSITION: Contemporary defense of a qualified discontinuity thesis, reviewing but ultimately rejecting the strong continuity case.},
    keywords = "discontinuity, alienation, continuity-debate, High, METADATA\_CLEANED: journal, type:@article->@misc"
}

@misc{fraser2006alienation,
    author = "Fraser, Nancy",
    title = "Alienation in the Older Marx",
    year = "2006",
    volume = "5",
    number = "3",
    note = "CORE ARGUMENT: Examines the recurrence of alienation vocabulary in Marx's later writings, arguing that both defenders of a sharp break (who ignore these passages) and defenders of continuity (who use the passages to claim alienation remains central without examining the specific contexts in which the term recurs) oversimplify the textual evidence. RELEVANCE: Offers a mediating, textually cautious position within the alienation-centered wing of the continuity debate, useful for showing that the break/continuity dichotomy itself may need to be replaced by a more fine-grained account of how specific concepts migrate and change function across Marx's corpus. POSITION: Qualified, textually cautious intervention in the continuity debate over alienation.",
    keywords = "continuity, alienation, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{lindner2011repenser,
    author = "Lindner, Urs",
    title = "Repenser la «coupure épistémologique»: lire Marx avec et contre Althusser",
    year = "2011",
    volume = "49",
    number = "1",
    note = {CORE ARGUMENT: Critically reconsiders Althusser's thesis that there is an epistemological break in Marx's work occurring in 1845-46, arguing that while an important break can indeed be located at this time, it cannot be adequately conceptualized as an "epistemological" transition from ideology to science; instead it should be understood as a transition from a young-Hegelian to a realist social philosophy. RELEVANCE: Proposes a middle path between the strict Althusserian break thesis and continuity readings by relocating the 1845 rupture from the register of epistemology (ideology versus science) to the register of philosophical anthropology and social ontology, directly bearing on how Marx's critique of Hegel should be periodized. POSITION: Revisionist position that accepts a 1845 break but reconceives its nature against Althusser's own epistemological framing.},
    keywords = "epistemological-break, Althusser, revision, Hegel, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@misc{coombs2015naming,
    author = "Coombs, Nathan",
    title = "Althusser's Science: Naming the Epistemological Break",
    year = "2015",
    address = "Edinburgh",
    doi = "10.1515/9780748699001-006",
    note = {CORE ARGUMENT: Examines how Althusser's naming and deployment of the "epistemological break" functioned polemically within debates over the scientificity of Marxism, situating the concept within the broader history of French epistemology (Bachelard, Canguilhem, Foucault) and its subsequent influence on French theory beyond Marxism. RELEVANCE: Contextualizes the epistemological-break concept as part of a wider mid-century French philosophical project concerned with demarcating science from ideology, helping clarify what intellectual resources Althusser drew on to characterize Marx's rupture with Hegelian idealism. POSITION: Historical-contextual account of the epistemological break as a strategic conceptual naming within French theory.},
    keywords = "epistemological-break, Althusser, French-epistemology, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, publisher, pages, type:@incollection->@misc"
}

@misc{kain1986marxmethod,
    author = "Kain, Philip J.",
    title = "Marx' Method, Epistemology, and Humanism: A Study in the Development of His Thought",
    year = "1986",
    address = "Dordrecht",
    series = "Sovietica",
    volume = "48",
    note = "CORE ARGUMENT: Argues that Marx's development cannot be divided into two neat periods (an early humanistic/philosophical period and a later scientific period, as Althusserians hold), nor can it be treated as an essentially unified whole (as strong continuity readings hold); instead Kain traces a deep-seated humanism in Marx's later writings that grows out of, but differs significantly from, the humanism of the early work. RELEVANCE: Offers a mediating position directly targeting the periodization question at the center of this domain, using Schiller's and Hegel's aesthetic models as a comparative lens to show why both the sharp-break and simple-unity theses fail to capture Marx's actual intellectual trajectory. POSITION: Mediating position rejecting both the strict Althusserian break thesis and simple continuity readings in favor of transformed continuity.",
    keywords = "periodization, humanism, continuity-debate, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{cohen1978karl,
    author = "Cohen, G. A.",
    title = "Karl Marx's Theory of History: A Defence",
    year = "1978",
    address = "Princeton, NJ",
    note = {CORE ARGUMENT: Cohen reconstructs historical materialism using the tools of analytic philosophy, defending a technologically deterministic reading of the base/superstructure distinction via functional explanation, explicitly rejecting "dialectical" argument as a legitimate mode of Marxist reasoning in favour of conceptual clarity and rigorous inference. The book's methodological introduction treats Hegelian dialectic as an obstacle to, rather than a resource for, understanding Marx. RELEVANCE: This is the founding text of Analytical Marxism and the primary target of dialectically-inclined replies (Sayers 1984 responds to it directly); it supplies the paradigm case of "rejecting the dialectic while retaining Marx's substantive claims" that the domain's key question interrogates. POSITION: Founding statement of the analytical-Marxist rejection of dialectical method.},
    keywords = "analytical-Marxism, Cohen, historical-materialism, dialectic-rejection, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{elster1985making,
    author = "Elster, Jon",
    title = "Making Sense of Marx",
    year = "1985",
    publisher = "Cambridge University Press",
    address = "Cambridge",
    series = "Studies in Marxism and Social Theory",
    note = {CORE ARGUMENT: Elster subjects the whole of Marx's oeuvre to analytic and rational-choice scrutiny, concluding that Marx's economic theories are largely mistaken or irrelevant and that his most defensible legacy lies in the theories of alienation, exploitation, and class conflict once purged of dialectical and functionalist argumentation. Elster distinguishes several senses of "dialectic" in Marx (as method of presentation, as a body of Hegelian "laws," and as a description of self-undermining social contradictions), endorsing only the last as a genuine, non-exclusively-Marxist insight. RELEVANCE: Alongside Cohen 1978, this is the other founding text of Analytical Marxism and the fullest statement of the position that "dialectical method" should be dissolved into discrete, independently defensible theses; it directly frames the domain's second key question about how dialectically-inclined Marxists have replied. POSITION: Consolidating statement of the analytical-Marxist reconstruction of Marx without dialectic.},
    sep_context = {SEP "Analytical Marxism" (marxism-analytical), sec. 3.4 "Dialectic": cites Elster's account of three dialectical strands in Marx's work (Elster 1978, chs. 3-5; Elster 1985: 37-48; Elster 1986a: 34-39), of which two are judged valuable. Elster is described as "deeply unsympathetic" to dialectic as a method of presentation, finding the relevant Grundrisse/Capital passages "scarcely intelligible" (1985: 37); SEP contrasts this with Arthur 2004's "more positive account." SEP also cites Elster 1985: 5 on methodological individualism and 1985: 109 on Marx's anti-teleological remarks in the German Ideology.},
    keywords = "analytical-Marxism, Elster, rational-choice-Marxism, dialectic-rejection, High, INCOMPLETE, no-abstract"
}

@misc{elster2011hard,
    author = "Elster, Jon",
    title = "Hard and Soft Obscurantism in the Humanities and Social Sciences",
    year = "2011",
    volume = "58",
    note = {CORE ARGUMENT: Elster distinguishes "hard obscurantism" (deliberately opaque prose masking empty content) from "soft obscurantism" (loose, unfalsifiable use of concepts like contradiction, totality, and dialectic that trade on equivocation between literal and metaphorical senses), arguing that much dialectically-inflected Marxist and post-structuralist theorizing exemplifies the latter. He explicitly retrospectively characterizes analytical Marxism's own trajectory as a case of "intellectual autophagy" that revealed "non-bullshit Marxism" to be nearly an empty set. RELEVANCE: This is Elster's most explicit and mature statement of the charge that dialectical reasoning is obscurantist rather than merely mistaken, sharpening the methodological indictment that systematic-dialectics theorists (Arthur, Smith, Reuten) must answer; it also documents the later self-understanding of the analytical-Marxist project as having largely abandoned Marx. POSITION: Late, hardened statement of the analytical-Marxist charge that dialectic is obscurantist.},
    keywords = "analytical-Marxism, Elster, obscurantism, dialectic-rejection, methodology, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "Abstract The paper argues that the contemporary social sciences and humanities are in a deep crisis, due to the prevalence of obscurantist arguments. Whereas many have denounced the “soft obscurantism” derived from what is sometimes called “French theory”, the “hard obscurantism” of many forms of mathematical and statistical social science also deserves to be singled out for criticism. The paper further argues that obscurantism does not merely represent a waste of intellectual effort, but has caused harm to countless individuals, ranging from parents of autistic children to market investors. Finally the paper considers some of the psychological mechanisms that may sustain obscurantism and constitute obstacles to overcoming it.",
    abstract_source = "openalex"
}

@misc{sayers1984marxism,
    author = "Sayers, Sean",
    title = "Marxism and the Dialectical Method: A Critique of G.A. Cohen",
    year = "1984",
    volume = "36",
    note = {CORE ARGUMENT: Sayers argues that the dialectical method is not a dispensable rhetorical overlay on Marx's theory of history but its necessary basis, focusing critically on Cohen's Karl Marx's Theory of History for giving an account of Marxism in "entirely non-dialectical—indeed, anti-dialectical" terms. He contends that without the dialectical framework (particularly the treatment of internal relations and historical development as a process of contradiction), Cohen's technological-functionalist reconstruction distorts core Marxist claims about the productive forces/relations of production relationship. RELEVANCE: This is the paradigm direct reply from the dialectically-inclined camp to the founding text of Analytical Marxism, making it central evidence for the domain's third key question about how Cohen's objections were answered; it is cited in SEP's Analytical Marxism entry as the leading instance of the "dialectic is indispensable" counter-criticism. POSITION: Direct critical response defending dialectical method against Cohen's analytical reconstruction.},
    sep_context = {SEP "Analytical Marxism" (marxism-analytical), sec. 6 "Overarching Criticisms": cites Sayers 1984 and 2015 as maintaining "that Marxism is necessarily committed to a 'dialectical' approach--sometimes based on a wider philosophy of 'internal relations'--which analytical Marxists are bound to reject," presented as one of two families of comprehensive methodological objections to Analytical Marxism.},
    keywords = "dialectic, Cohen-critique, Sayers, historical-materialism, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, type:@article->@misc"
}

@article{vanparijs1982perverse,
    author = "Parijs, Philippe Van",
    title = "Perverse Effects and Social Contradictions: Analytical Vindication of Dialectics?",
    journal = "The British Journal of Sociology",
    year = "1982",
    volume = "33",
    number = "4",
    note = {CORE ARGUMENT: Writing from within the analytical-Marxist September Group itself, Van Parijs argues that certain dialectical claims about capitalism's self-undermining "contradictions" can be analytically reconstructed as instances of perverse or counter-finalized collective effects (structurally similar to prisoner's-dilemma-type unintended aggregate outcomes), offering a partial, qualified vindication of dialectical description using non-dialectical, game-theoretic tools. RELEVANCE: This paper complicates any clean two-camp narrative for the domain, showing an analytical Marxist attempting to translate rather than simply reject dialectical claims, and anticipates the "modest dialectic" position later endorsed by Elster 1985. POSITION: Bridging position: partial analytical reconstruction, rather than wholesale rejection, of dialectical claims about social contradiction.},
    keywords = "analytical-Marxism, Van-Parijs, contradiction, dialectic, methodology, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Raymond Boudon's recent textbook La Logique du Social, constitutes a systematic attempt to provide sociology with solid foundations, by putting at its core the assumption that man acts rationally, or at least intentionally. Interactionist models, which rest on this assumption, Boudon argues, should replace determinist models, which assume that man is passively determined by social structures, roles or norms.l In particular, he argues that the notion of perverse effect, whose use presupposes the adoption of an interactionist perspective, should play a central role in the attempt to account for social change. In this review article, I shall focus on this notion and on the use Boudon makes of it in his theory of social change. I shall point out a number of obscurities and other defects, and make some suggestions as to how they can be remedied. In so doing, I shall draw heavily on two other books. One is an earlier collection of essays by Boudon, Effets Pervers et Ordre Social, which deals with such topics as educational reform and Rawlsian justice, the 'logic of relative frustration' and sociological determinism, and which provides a less systematic formulation of the ideas expressed in the textbook. As most of the essays make explicit use of the notion of 'perverse effect', their relevance to the concerns of this article are obvious enough. The other book I shall heavily draw on is a somewhat more technical one by Jon Elster, Logic and Society. The purpose of this book is to use various logical tools in order to work out a number of sociologically useful concepts. One of these is the concept of social contradiction, on which we shall concentrate in subsequent sections. Not only does this concept lie at the core of Elster's theory of social change-by itself a sufficient reason for wanting to undertake a comparison with the key notion in Boudon's treatment of change. As we shall see, it is also analytically related to Boudon's notion of perverse effect and, just like the latter, it only makes sense on the background of an intentional model of man.2 Bringing Boudon's and Elster's analyses of these issues together, will, I hope, help make the former more rigorous and the latter more",
    abstract_source = "openalex"
}

@book{arthur2004new,
    author = "Arthur, Christopher J.",
    title = {The New Dialectic and Marx's "Capital"},
    year = "2004",
    publisher = "Brill",
    address = "Leiden/Boston",
    series = "Historical Materialism Book Series",
    number = "1",
    note = {CORE ARGUMENT: Arthur argues that Capital's opening movement — from the commodity through the value-form to money and then to capital — is not a historical narrative but a systematic, dialectically necessitated exposition whose logical structure directly parallels categories from Hegel's Science of Logic (particularly Hegel's logic of essence and the movement from being-in-itself to being-for-itself), even though Marx's subject matter (the capital-relation) is materially and historically specific rather than the Idea. This is the founding statement of what came to be called "the New Dialectic." RELEVANCE: This is the central systematic-dialectics text named in the domain description and the primary target of both sympathetic elaboration (Bidet, Reuten, Smith) and hostile critique (Carchedi, Rosenthal) surveyed here; SEP's Analytical Marxism entry cites it as the leading "more positive account" of dialectical presentation against Elster's dismissal. POSITION: Founding statement of the "New Dialectic"/systematic-dialectics reading of Capital's presentation-order.},
    sep_context = {SEP "Analytical Marxism" (marxism-analytical), sec. 3.4 "Dialectic": after describing Elster's dismissal of dialectic as a method of presentation as finding Marx's Grundrisse/Capital passages "scarcely intelligible," SEP notes parenthetically "(For a more positive account, see Arthur 2004.)" as the counterpoint within the entry's discussion of dialectic.},
    keywords = "systematic-dialectics, Arthur, new-dialectic, value-form, Hegel-Capital, High, METADATA\_CLEANED: doi",
    abstract = "This book both argues for, and demonstrates, a new turn to dialectic. Marx's Capital was clearly influenced by Hegel's dialectical figures: here, case by case, the significance of these is clarified. More, it is argued that, instead of the dialectic of the rise and fall of social systems, what is needed is a method of articulating the dialectical relations characterising a given social whole. Marx learnt from Hegel the necessity for a systematic development, and integration, of categories; for example, the category of 'value' can be fully comprehended only in the context of the totality of capitalist relations. These studies thus shed new light on Marx's great work, while going beyond it in many respects.",
    abstract_source = "openalex"
}

@misc{ollman2003dance,
    author = "Ollman, Bertell",
    title = "Dance of the Dialectic: Steps in Marx's Method",
    year = "2003",
    address = "Urbana",
    note = {CORE ARGUMENT: Ollman reconstructs Marx's dialectical method as grounded in a "philosophy of internal relations," according to which the identity of any social entity (value, capital, class) is constituted by its relations to other entities within the totality of the capitalist system, rather than by fixed, externally-related properties; the dialectical procedures of abstraction, generalization, and the "process of ascension" from abstract to concrete are treated as consequences of this underlying ontology rather than as arbitrary Hegelian borrowings. RELEVANCE: Ollman supplies the fullest systematic account of "dialectical method" as an ontological and procedural commitment (rather than merely a presentational device), directly informing the domain's first key question about what retaining Hegel's method while rejecting idealist content could mean; his internal-relations framework is explicitly what Sayers 2015 (cited alongside Sayers 1984) invokes against analytical Marxism. POSITION: Systematic reconstruction of dialectical method as grounded in a philosophy of internal relations.},
    keywords = "dialectic, Ollman, internal-relations, method, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{ilyenkov1977dialectical,
    author = "Ilyenkov, Evald V.",
    title = "Dialectical Logic: Essays on Its History and Theory",
    year = "1977",
    address = "Moscow",
    note = {CORE ARGUMENT: Ilyenkov reconstructs dialectical logic as a materialist theory of concept-formation, centered on his analysis (developed at length in a companion study of Capital's opening chapters) of the "ascent from the abstract to the concrete" as the logical form proper to scientific theory-construction, arguing that Marx's Capital exemplifies this method by deriving the concrete totality of the capitalist economy from the simplest, most abstract determination (the commodity) through successive, necessitated conceptual mediations. RELEVANCE: As the most systematic Soviet-era (post-Stalinist) reconstruction of Marx's dialectical logic, this is the historical starting point for the entire abstract-to-concrete reading later developed by Arthur, Reuten, Smith, and Uchida in the Anglophone systematic-dialectics tradition named in the domain description. POSITION: Foundational Soviet materialist reconstruction of dialectical logic as the abstract-to-concrete method exemplified in Capital.},
    keywords = "dialectic, Ilyenkov, abstract-to-concrete, Soviet-Marxism, dialectical-logic, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@book{uchida1988marxs,
    author = "Uchida, Hiroshi",
    title = {Marx's "Grundrisse" and Hegel's "Logic"},
    year = "1988",
    publisher = "Routledge",
    address = "London/New York",
    note = {CORE ARGUMENT: Uchida undertakes a close, section-by-section comparison of Marx's 1857-58 Grundrisse manuscripts with the categorical structure of Hegel's Science of Logic, arguing that Marx's method of developing economic categories (particularly around production, circulation, and capital) exhibits a conceptual structure directly modeled on, though not reducible to, Hegel's logic — revealing what Uchida calls "the force of capital on modern life" as itself dialectically structured. RELEVANCE: This text supplies detailed textual evidence for the domain's second key question about the presentation-order isomorphism thesis, extending the systematic-dialectics reading back from Capital to its preparatory manuscript, the Grundrisse; it is directly named as a key theorist in the domain description. POSITION: Systematic-dialectics reading demonstrating structural parallels between the Grundrisse and Hegel's Logic.},
    keywords = "systematic-dialectics, Uchida, Grundrisse, Hegel-Logic, High, INCOMPLETE, no-abstract"
}

@article{reuten2000interconnection,
    author = "Reuten, Geert",
    title = "The Interconnection of Systematic Dialectics and Historical Materialism",
    journal = "Historical Materialism",
    year = "2000",
    volume = "7",
    number = "1",
    note = {CORE ARGUMENT: Reuten distinguishes systematic dialectics (the reconstruction, in Capital, of the necessary conceptual/categorical order of a given social system) from historical dialectics (the reconstruction of that system's actual historical genesis and development), arguing that value-form theory's methodological shift toward systematic dialectics does not abandon historical materialism but rather specifies its proper relation to systematic theory: the categories of Capital are systematically, not historically, ordered, even though the system they describe is itself a historical formation. RELEVANCE: This paper gives the clearest methodological statement of what "systematic dialectics" means as a research program distinct from historical narrative, directly addressing the domain's second key question about how the commodity-to-money-to-capital presentation-order is reconstructed as dialectically necessary. POSITION: Methodological statement of systematic dialectics and its relation to historical materialism, from within the value-form tradition.},
    keywords = "systematic-dialectics, Reuten, value-form, historical-materialism, methodology, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract This paper discusses some recent developments in the Marxian theory of value, called value-form theory, which have gone along with a methodological shift from a linear logic and historical dialectics to a dialectical logic and systematic dialectics. In order to appreciate these developments within the Marxian paradigm, it is useful to make two introductory remarks: first, on some peculiarities of Marxian discourse and, second, about discrepancies in Marx's Capital.",
    abstract_source = "openalex"
}

@misc{murray2009value,
    author = "Murray, Patrick",
    editor = "Chitty, Andrew and McIvor, Martin",
    title = "Value, Money and Capital in Hegel and Marx",
    booktitle = "Karl Marx and Contemporary Philosophy",
    year = "2009",
    address = "Basingstoke",
    note = {CORE ARGUMENT: Murray traces how Marx's derivation of value, money, and capital as forms in Capital draws on and transforms Hegelian logical categories (particularly the logic of essence and the distinction between "immediate" and "reflected" or "posited" determinations), arguing that Marx's value-form analysis requires this Hegelian logical apparatus to explain how value acquires an independent, objective form (money) that then appears to dominate its own social substance. RELEVANCE: Murray is named as a key systematic-dialectics theorist in the domain description; this piece supplies a concise statement of his broader "truly social" labour-theory-of-value position and its specifically Hegelian derivation of the money-form, directly bearing on the domain's second key question. POSITION: Value-form-theoretic account of the specifically Hegelian logical structure underlying Marx's derivation of money and capital.},
    keywords = "value-form, Murray, Hegel, money-form, systematic-dialectics, Medium, METADATA\_CLEANED: publisher, pages, doi, type:@incollection->@misc",
    abstract = "Some years ago I was surprised to receive a package in the mail from a former student.1 It took me a moment to recognize what was inside, a green ceramic ΔM. I had a good laugh. From our study of Capital, the student had gotten the idea loud and clear how preoccupied Marx is with ΔM, or what he calls ‘surplus value’. In thinking over Hegel’s treatment of property, contracts of exchange and civil society in the Philosophy of Right and earlier writings, I am struck by a simple fact: Hegel just does not seem to be interested in ΔM.2 Hegel is aware that ‘gain’ or ‘profit’ motivate what he calls the ‘reflective estate’ of trade and industry. And he recognizes that civil society is naturally expansive, with firms developing products and technologies in order to accumulate wealth. But the topic of surplus value simply does not move Hegel on grounds either of science — where does ΔM come from? — or social justice — what justification can be offered for ΔM?",
    abstract_source = "openalex"
}

@misc{smith1990analytical,
    author = "Smith, Tony",
    title = "Analytical Marxism and Marx's Systematic Dialectical Theory",
    year = "1990",
    volume = "23",
    number = "3",
    note = "CORE ARGUMENT: Smith directly contrasts the analytical-Marxist reconstruction project (Cohen, Elster, Roemer) with a systematic-dialectical reading of Capital, arguing that analytical Marxism's individualist, causal-explanatory framework cannot capture the categorial necessity by which Marx moves from the commodity-form to money to capital, and that this systematic ordering — not mere historical sequence or analytic decomposition — is essential to Capital's explanatory power regarding capital's self-expanding, crisis-prone character. RELEVANCE: This paper directly engages both traditions named in the domain description and is the clearest single article-length statement of the domain's third key question, evaluating analytical Marxism's rejection of dialectic against the systematic-dialectics alternative on its own methodological terms. POSITION: Systematic-dialectics rebuttal of analytical Marxism's rejection of dialectical necessity in Capital's argument.",
    keywords = "systematic-dialectics, analytical-Marxism, Tony-Smith, methodology, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc"
}

@article{smith1999relevance,
    author = "Smith, Tony",
    title = "The Relevance of Systematic Dialectics to Marxian Thought: A Reply to Rosenthal",
    journal = "Historical Materialism",
    year = "1999",
    volume = "4",
    number = "1",
    note = {CORE ARGUMENT: Smith responds to John Rosenthal's charge (in "The Escape from Hegel") that systematic-dialectics readings of Capital import a spurious, unmotivated Hegelian necessity into what is really an empirically contingent economic argument, defending the claim that Capital's opening chapters exhibit genuine categorial necessity (each category's inadequacy necessitating the emergence of the next) rather than merely a convenient expository order. RELEVANCE: Paired with Rosenthal 1999, this exchange is a direct, textually detailed instance of Marxist theorists disputing the coherence of the systematic-dialectics reconstruction from within the broadly dialectical camp, giving the domain's second key question its sharpest concrete test case. POSITION: Defence of categorial necessity in Capital's systematic-dialectical presentation against an internal Marxist critique.},
    keywords = "systematic-dialectics, Tony-Smith, Rosenthal-debate, necessity, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: pages, doi"
}

@article{carchedi2009fallacies,
    author = "Carchedi, Guglielmo",
    title = "The Fallacies of 'New Dialectics' and Value-Form Theory",
    journal = "Historical Materialism",
    year = "2009",
    volume = "17",
    number = "1",
    note = {CORE ARGUMENT: Carchedi argues that the "New Dialectics" associated with Arthur and value-form theory more broadly mistakes a purely logical/systematic ordering of categories for the historically and materially grounded dialectic Marx actually employs, contending that by severing systematic dialectics from historical-materialist content, the New Dialectic empties Marx's categories (value, money, capital) of their determinate economic content and reduces them to formal logical relations. RELEVANCE: This is a sustained critique of the systematic-dialectics/value-form program from within Marxist political economy (rather than from analytical Marxism), showing that the "Hegelian debt" question divides Marxists internally, not only along the analytical/dialectical fault line the domain's key questions foreground. POSITION: Marxist-economics critique of systematic dialectics/value-form theory as formalistic and historically ungrounded.},
    keywords = "systematic-dialectics, Carchedi, critique, value-form, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract Chris Arthur's approach aims at a systematic re-ordering of Marx's categories. This article argues that his approach is actually a different ordering of different categories that are positioned within a specific theoretical whole, a Hegelian re-interpretation of Marx and especially of abstract labour, which distances itself from Marx. While the debate has focused mainly on the philosophical aspects of Arthur's work, its economic features have not been the object of a systematic analysis. Yet, a full assessment of the 'New Dialectics' should include explicitly a systematic internal critique of its economic dimensions. The aim of this article is to assess the internal consistency of the economic ramifications of the 'New Dialectics'. The focus is on the notions of abstract labour, concrete labour, and exploitation. Arthur's faithfulness to Marx, or correspondence to Marx's quotations, is not the criterion used to assess the 'New Dialectics'. Rather, the criterion is whether it (a) discovers logical inconsistencies in Capital and (b) is itself free from inconsistencies. The answer is negative in both cases.",
    abstract_source = "openalex"
}

@article{bidet2005dialecticians,
    author = "Bidet, Jacques",
    title = "The Dialectician's Interpretation of Capital",
    journal = "Historical Materialism",
    year = "2005",
    volume = "13",
    note = {CORE ARGUMENT: Reviewing Arthur's The New Dialectic and Marx's "Capital," Bidet assesses the extent to which Arthur's reconstruction succeeds in showing genuine Hegelian derivational necessity in Capital's opening movement, raising specific objections about whether the transition from simple commodity circulation to capital is as logically compelled as Arthur claims, and comparing Arthur's reading with his own structuralist interpretation of Capital's architecture. RELEVANCE: As a detailed, book-length engagement with the central systematic-dialectics text in this domain, Bidet's review-essay supplies close textual scrutiny of the presentation-order isomorphism thesis central to the domain's second key question. POSITION: Critical but sympathetic engagement with Arthur's New Dialectic from an alternative (structuralist) Marxist standpoint.},
    keywords = "systematic-dialectics, Bidet, Arthur-critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: number, pages, doi"
}

@misc{keikhaee2021historical,
    author = "Keikhaee, Aidin",
    title = "The Historical and the Transhistorical in Marx's Dialectical Method",
    year = "2021",
    volume = "49",
    number = "3",
    pages = "356--382",
    doi = "10.1177/01914537211040567",
    note = {CORE ARGUMENT: Against the dominant reading that treats the 1857 Grundrisse "Introduction" as offering a transhistorical abstract-to-concrete method that Marx later revised or abandoned, Keikhaee argues that a critical-historicist approach to economic categories, together with a specific understanding of the "reproduction of the concrete in thought," constitutes the stable core of Marx's dialectical method across the Introduction and Capital alike, and that the post-1857 shift to the commodity as starting point does not mark a methodological rupture. RELEVANCE: As recent scholarship, this piece shows the systematic-dialectics research program continuing to refine exactly what "Marx's dialectical method" denotes and whether it is stable across Marx's mature economic writings, directly bearing on the domain's first key question about the coherence of "retaining the dialectical method." POSITION: Recent reconstruction defending methodological continuity of Marx's dialectical method from the Grundrisse to Capital.},
    keywords = "dialectic, Keikhaee, Grundrisse, method, continuity, Low, METADATA\_CLEANED: journal, type:@article->@misc",
    abstract = "This essay revisits the question of alterations in Marx’s view of method from the 1857 “Introduction” to Capital. In the wake of the belated upsurge of interest in Marx’s notebooks of 1857–8, posthumously published as the Grundrisse, a dominant interpretation has been developed in Marx scholarship which characterizes the method of the “Introduction” as an ascent from the (transhistorical) abstract to the (historical) concrete and, upon such characterization, stresses the mature Marx’s departure from it. Rereading the 1857 “Introduction” with an emphasis on the theoretical import of its examples, I argue, against this interpretation, that although this text does not provide a fully worked-out account of method, it nevertheless offers invaluable insights into some of the central methodological problems with which Marx was concerned and in response to which his dialectical method was developed. In particular, I highlight what could be called Marx’s critical historicist approach to the categories and argue that this approach, together with his specific understanding of the process of the reproduction of the concrete in thought, constitute the lasting pillars of Marx’s dialectical method, in the 1857 “Introduction” as well as in Capital. Finally, in a concluding section, I re-examine the methodological status of the commodity and argue that the post-1857 emergence of the commodity as Marx’s favourite starting point does not represent a fundamental change, or a reversal, in his view of method.",
    abstract_source = "s2"
}

@misc{kirkpatrick1994philosophical,
    author = "Kirkpatrick, Graeme",
    title = "Philosophical Foundations of Analytical Marxism",
    year = "1994",
    volume = "58",
    number = "1",
    note = {CORE ARGUMENT: Kirkpatrick traces Cohen's and Elster's methodological commitments to a broader analytic-philosophical background, arguing that Analytical Marxism's attempt to render Marx's thought "clear" through non-dialectical, individualist methods is self-undermining: the very clarificatory apparatus borrowed from analytic philosophy is, Kirkpatrick contends, corrosive to the practical-active meaning central to Marx's own thought, so that Analytical Marxism ends up dissolving rather than defending Marxism. RELEVANCE: This secondary paper situates the Cohen/Elster rejection of dialectic within a wider philosophical genealogy and offers a metatheoretical diagnosis of why the analytical and dialectical camps talk past one another, useful for framing the domain's overarching methodological stakes. POSITION: Metatheoretical critique diagnosing Analytical Marxism's non-dialectical method as self-defeating.},
    keywords = "analytical-Marxism, Kirkpatrick, methodology, critique, Low, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "The Analytical Marxian paradigm is motivated by a desire to make Marx's theory “clear.” Its criteria for success in this venture are drawn from one tendency within contemporary analytical philosophy. The works of G.A. Cohen and Jon Elster on Marx are best understood in the light of this philosophical background. The ultimately fatal limitations of the analytical paradigm as a whole, and of its interpretation of Marx's theory of history in particular, are derived from a contradiction at this philosophical level: Analytical Marxism attempts to make Marx's thought clear with a methodology which is fundamentally corrosive to the practical-active meaning of that thought.",
    abstract_source = "s2"
}

@misc{dahbour2017totality,
    author = "Dahbour, Omar",
    title = "Totality, Reason, Dialectics: The Importance of Hegel for Critical Theory from Lukács to Honneth",
    year = "2017",
    pages = "87--108",
    note = "CORE ARGUMENT: Traces how Hegel's categories of totality and reason are transmitted from Lukács through subsequent Frankfurt-School-adjacent critical theory down to Axel Honneth, arguing that the viability of critical theory as a distinctively dialectical (rather than merely normative) project depends on how much of this Hegelian inheritance is retained. RELEVANCE: Provides a genealogical map connecting Lukács's reification theory to later reception, useful for showing how the Hegelian totality concept both grounds and becomes contested within the critical-theory tradition descending from Marx's critique of idealism. POSITION: Hegelian-Marxist continuity thesis, tracking the diminishing but persistent role of Hegelian totality in critical theory.",
    keywords = "Lukacs, totality, reification, Frankfurt-School, Honneth, Medium, METADATA\\_CLEANED: booktitle, publisher, type:@incollection->@misc, METADATA\_CLEANED: doi",
    abstract = {Critical theory has usually been regarded as a unique amalgamation of ideas drawn from Marx, Weber, and Freud, among other sources. What this view tends to minimize or overlook is the unique role of the critical theorists, beginning with Georg Lukács (a critical theorist "before the fact"), in reviving, interpreting, and further developing a distinctively Hegelian approach to the problems of knowledge, culture, and politics. This chapter first demonstrates the role of critical theorists in reviving Hegelianism in the early twentieth century. Then, it outlines the role of Hegelian philosophy as the basis for concepts of totality in the thought of Georg Lukács and Max Horkheimer, and of rationality in the thought of Herbert Marcuse and Theodor Adorno. The critique of, and then return to, Hegel in the work of Jürgen Habermas and Axel Honneth is also considered. The chapter concludes with an evaluation of three historical interpretations of the significance of the Hegelian element in critical theory, a consideration of the limits of Hegelianism for critical theory, and a suggestion of a fourth interpretation.},
    abstract_source = "openalex"
}

@article{rockmore1992fichte,
    author = "Rockmore, Tom",
    title = "Fichte, Lask, and Lukács's Hegelian Marxism",
    journal = "Journal of the History of Philosophy",
    year = "1992",
    volume = "30",
    number = "4",
    note = {CORE ARGUMENT: Argues that Lukács's Hegelian reconstruction of Marxism in History and Class Consciousness is mediated as much by Neo-Kantian and Fichtean sources (particularly Emil Lask) as by Hegel directly, complicating any simple picture of a "return to Hegel." RELEVANCE: Shows that the philosophical genealogy of Lukács's anti-positivist Marxism is more heterogeneous than the Lukács-completes-Hegel narrative suggests, important for precisely locating what in Lukács's dialectic is Hegelian and what is Neo-Kantian/Fichtean. POSITION: Historical-philosophical reconstruction of Lukács's sources, qualifying the standard Hegelian-Marxist genealogy.},
    keywords = "Lukacs, Fichte, Neo-Kantianism, Hegelian-Marxism, Medium, METADATA\\_CLEANED: pages, doi",
    abstract = "With Karl Korsch, Georg Lukács is widely known as one of the two founders of Hegelian Marxism. Although Lukács is one of the most significant students of Hegel in this century, Marxist or otherwise, and although his Marxism is partially based on his reading of Hegel's position, it is an error to consider his Marxism as basically Hegelian for two reasons. First, Lukács's reading of classical German philosophy depends crucially on his creative extension of Kant's problem of the thing-in-itself to all of classical German philosophy from Kant to Hegel. Second, Lukács argues in detail that classical German philosophy is unable to resolve the problem of the thing-in-itself, but that the latter is resolved by Marx. Lukács's reading of Marx's solution of the Kantian problem, which he extends to all of classical German philosophy, depends on his appropriation of Fichte's position. This article discusses the nature and significance of Fichte's role, both directly and through the intermediary of Emil Lask, in the constitution of Lukács's distinctive form of Marxism, arguing that Lukács's Marxism is not only Hegelian, but Kantian, Fichtean, and neo-Kantian as well.",
    abstract_source = "openalex"
}

@misc{chari2010toward,
    author = "Chari, Anita",
    title = "Toward a Political Critique of Reification: Lukács, Honneth and the Aims of Critical Theory",
    year = "2010",
    volume = "36",
    note = {CORE ARGUMENT: Contrasts Lukács's political-economic account of reification, rooted in the commodity form and revolutionary class praxis, with Honneth's later recognition-theoretic reinterpretation of reification as a "forgetting" of primary intersubjective recognition, arguing that Honneth's move loses the critical purchase on capitalism that made Lukács's original category powerful. RELEVANCE: Directly addresses how far Lukács's Hegelian-Marxist reconstruction of Marx's critique of capitalism can be dissociated from its politically totalizing framework without losing its critical force — central to assessing what survives of Marx's Hegelian inheritance in later critical theory. POSITION: Defends the political-economic (Lukácsian) reading of reification against recognition-theoretic revisionism.},
    keywords = "Lukacs, reification, Honneth, critical-theory, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article engages Axel Honneth's recent work on Georg Lukács' concept of reification in order to formulate a politically relevant and historically specific critique of capitalism that is applicable to theorizing contemporary democratic practice. I argue that Honneth's attempt to reorient the critique of reification within the terms of a theory of recognition has done so at the cost of sacrificing the core of the concept, which forged a connection between the socio-political analysis of capitalist domination and an analysis of the unengaged, spectatorial stance of human beings toward the world, showing how they together impede emancipatory social transformation. In order to accomplish the unfinished task of rendering the critique of reification applicable to contemporary critical theory, I seek to synthesize the advantages of Honneth's approach, which focuses on the normative aspects of the critique of reification, with Lukács' emphasis on the practical, political-economic dimensions of reification and the historically specific pathologies of the capitalist social form.",
    abstract_source = "openalex"
}

@misc{kavoulakos2017philosophy,
    author = "Kavoulakos, Konstantinos",
    title = "Philosophy of Praxis or Philosophical Anthropology? Andrew Feenberg and Axel Honneth on Lukács's Theory of Reification",
    year = "2017",
    publisher = "Springer International Publishing",
    note = {CORE ARGUMENT: Compares Feenberg's "philosophy of praxis" reading of Lukács, which foregrounds practical, transformative rationality, with Honneth's "philosophical anthropology" reading, which grounds reification in a prior anthropological capacity for recognition, arguing the two readings imply divergent assessments of how thoroughly Lukács's reification theory remains tied to Hegelian dialectical totality. RELEVANCE: Clarifies competing frameworks for interpreting exactly how Hegelian Lukács's central category is, directly bearing on whether reification should be read as a dialectical-historical or quasi-transcendental anthropological concept. POSITION: Comparative analysis of two rival receptions of Lukács's Hegelian Marxism within contemporary critical theory.},
    keywords = "Lukacs, reification, Feenberg, Honneth, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{pitkin1987rethinking,
    author = "Pitkin, Hanna Fenichel",
    title = "Rethinking Reification",
    year = "1987",
    volume = "16",
    note = {CORE ARGUMENT: Critically examines the concept of reification as developed from Marx through Lukács, arguing that the concept trades on an ambiguous and ultimately untenable contrast between "authentic" unreified social relations and reified "thing-like" ones, and proposes a reconstruction that avoids this metaphysical baggage. RELEVANCE: Offers a sustained philosophical critique of the Lukácsian reification concept that is central to the Hegelian-Marxist tradition, useful for assessing whether the concept coherently expresses Marx's critique of idealist/naturalized social forms or imports unexamined Hegelian assumptions about an original, non-alienated subject-object unity. POSITION: Critical reconstruction of reification theory, skeptical of its Hegelian metaphysical commitments.},
    keywords = "Lukacs, reification, Hegel, critique, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{negt1975theory,
    author = "Negt, Oskar",
    title = "Theory, Empiricism and Class Struggle: On the Problem of Constitution in Karl Korsch",
    journal = "Telos",
    year = "1975",
    volume = "1975",
    note = {CORE ARGUMENT: Reconstructs Korsch's theory of the "constitution" of Marxist theory out of the concrete historical struggles of the working class, arguing that for Korsch Marxist theory is not a set of empirical propositions to be verified but a moment internal to revolutionary practice itself, which is what commits Marxism to remaining "philosophy" rather than becoming positive science. RELEVANCE: Directly engages Korsch's central thesis in Marxism and Philosophy that Marxism must retain a dialectically self-reflective, non-positivist character, providing the theoretical vocabulary (theory-practice unity, historical constitution) needed to state precisely what Korsch's anti-positivism amounts to. POSITION: Sympathetic reconstruction of Korsch's theory-practice unity thesis against positivist and mechanistic Marxism.},
    keywords = "Korsch, theory-practice, positivism, Marxism-as-philosophy, High, METADATA\\_CLEANED: number, pages, doi",
    abstract = "Today, within the framework of the newly posed task of a revolutionary restoration of Marxism, it becomes increasingly urgent to find solutions to problems directly relating to three main areas: the establishment of a materialist social research (without which Marxist theory threatens to lose its empirical substance) which is necessitated by the given experience organized by the division of labor in the particular sciences; the reformulation of the concept of objective truth as found in a rudimentary but formally undeveloped form in the Theses on Feuerbach; and, finally, within the context of late capitalism, the specified determination of revolutionary, transforming, and historical praxis as the essence of the dialectic between forces and relations of production (as well as between production and class struggle), which materializes in the structure of the social objects and needs.",
    abstract_source = "openalex"
}

@article{browner1977karl,
    author = "Browner, Stephen Eric",
    title = "Karl Korsch: Revolutionary Theory",
    journal = "Telos",
    year = "1977",
    note = {CORE ARGUMENT: A review of Douglas Kellner's edited English-language collection Karl Korsch: Revolutionary Theory (University of Texas Press, 1977), situating Korsch's Marxism and Philosophy and later writings within the crisis of orthodox Marxism after 1917 and arguing that Korsch's insistence on the historicity of Marxist theory itself anticipates central themes of subsequent Western Marxism. RELEVANCE: Situates Korsch's anti-positivist, historicizing conception of Marxist theory within the broader crisis of Second/Third International orthodoxy, clarifying why Korsch's argument that "Marxism must remain a philosophy" was received as a scandal by party orthodoxy. POSITION: Historically contextualizing appraisal of Korsch as founding figure of Western Marxism.},
    keywords = "Korsch, Western-Marxism, historicism, orthodoxy, Medium, METADATA\\_CLEANED: volume, number, pages, doi",
    abstract = "Review of: Douglas Kellner, ed. Karl Korsch: Revolutionary Theory. Austin, Tex.: University of Texas Press, 1977. 299 pages.",
    abstract_source = "openalex"
}

@article{devlin2021karl,
    author = "Devlin, Nicholas",
    title = "Karl Korsch and Marxism's Interwar Moment, 1917--1933",
    journal = "History of European Ideas",
    year = "2021",
    volume = "48",
    abstract = "This article offers a major reinterpretation of the nature of interwar Marxist theory. It does so by offering a new reading of the work of Karl Korsch in the context of a network of ex-communist intellectuals. In Marxism and Philosophy (1923), Korsch responded to the split in the labour movement with a radical new claim to Marxist orthodoxy. Rather than engaging in Marx exegesis, he aimed to turn the Marxist 'method' on Marxism's own history. In the narrative he constructed, Bolshevik-inspired Communism appeared as the next logical step in the dialectic. But this argument rested on a historicisation of Marx's own writing that led to an unresolvable tension in Korsch's work that threatened to undermine its claim to Marxist orthodoxy. Once it is understood that Marxism was a political currency as much as a purely theoretical space of argument, Korsch's reluctance to resolve the tension one way or the other becomes understandable. This reinterpretation of Korsch's work challenges the 'Western Marxism' paradigm in which he has been read, showing that Korsch's work presupposed a reading of revolutionary success and potential rather than defeat and that he did not advocate a turn to superstructural or cultural questions in the manner supposed.",
    note = {CORE ARGUMENT: Reinterprets Korsch's Marxism and Philosophy as a historicizing intervention in interwar debates over Marxist orthodoxy rather than as straightforward Marx exegesis, arguing Korsch turned the Marxist method reflexively onto Marxism's own history, and that this generated an unresolved tension between claiming orthodoxy and historicizing Marx's writing itself. RELEVANCE: Directly revises the standard "Western Marxism" framing (associated with Lukács, Korsch, and Frankfurt) by showing Korsch's argument was oriented to revolutionary possibility rather than defeatist cultural retreat, complicating simple genealogies of the tradition this domain covers. POSITION: Revisionist intellectual history that challenges the retrospective "Western Marxism" categorization of Korsch.},
    keywords = "Korsch, Western-Marxism, historiography, orthodoxy, High, METADATA\\_CLEANED: number, pages, doi"
}

@misc{rockwell2018hegel,
    author = "Rockwell, Russell",
    title = "Hegel in Herbert Marcuse's Hegelian Marxism, Critical Theory, and Value Theory",
    year = "2018",
    publisher = "Springer International Publishing",
    note = "CORE ARGUMENT: Examines how Hegel's dialectic operates across the different phases of Marcuse's career — from Reason and Revolution's defense of Hegelian negativity, through Marcuse's engagement with Marx's Grundrisse, to his later value-theoretic concerns — arguing for continuity in Marcuse's use of Hegelian negation as a critical, non-affirmative category. RELEVANCE: Provides a career-spanning account of how one major Frankfurt School figure sustained a Hegelian dialectical framework specifically for critiquing both idealist philosophy and positivist social science, central to the key question of how Frankfurt School theorists deploy Hegelian dialectics against both poles. POSITION: Continuity thesis regarding Marcuse's Hegelian Marxism across his corpus.",
    keywords = "Marcuse, Hegel, Frankfurt-School, negativity, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{anderson1993hegel,
    author = "Anderson, Kevin",
    title = "On Hegel and the Rise of Social Theory: A Critical Appreciation of Herbert Marcuse's Reason and Revolution, Fifty Years Later",
    year = "1993",
    volume = "11",
    number = "3",
    note = "CORE ARGUMENT: Reassesses Marcuse's Reason and Revolution (1941) fifty years after publication, arguing that Marcuse's central claim — that Hegel's dialectic of negativity anticipates and is completed by Marx's critical social theory — remains a defensible corrective to positivist social theory even where Marcuse's specific readings of Hegel have since been revised by scholarship. RELEVANCE: Provides a direct scholarly reassessment of Marcuse's founding Frankfurt School argument that Hegelian negative reason, rather than static idealist system-building, is what passes into Marx's critique of capitalist society — precisely the thesis at stake in this domain's account of Frankfurt School dialectics. POSITION: Sympathetic critical reappraisal of Marcuse's Hegelian-Marxist reading of Reason and Revolution.",
    keywords = "Marcuse, Hegel, Reason-and-Revolution, Frankfurt-School, High, METADATA\\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "A critical reappraisal of Herbert Marcuse's Reason and Revolution: Hegel and the Rise of Social Theory (1941), fifty years after its original publication, assessing the enduring value and the limitations of Marcuse's reading of Hegel's dialectic as anticipating Marx's critical social theory.",
    abstract_source = "openalex"
}

@misc{finlayson2017hegel,
    author = "Finlayson, James Gordon",
    editor = "Moyar, Dean",
    title = "Hegel and the Frankfurt School",
    year = "2017",
    abstract = "Hegel's philosophy exerted a magnetic attraction on the various thinkers that comprise the Frankfurt school. This chapter aims to gauge and specify the relation that three members of the 'inner circle' of the Frankfurt school (Horkheimer, Adorno, and Marcuse) have to Hegel. It concludes that the young Horkheimer is a Hegelian-Marxist who endorses a qualified Hegelianism, while claiming that Hegel's idealist metaphysics had become obsolete and superseded by a combination of sociology, psychology, and materialist historiography. Adorno remains a more committed Hegelian (and a Marxist-Hegelian) who sees his own dialectical approach to philosophy as emerging from and consistent with an immanent criticism of Hegel. Both, however, tend to reject Hegel's philosophy of objective spirit as conservative apology for the Prussian state. Marcuse, by contrast, is a Hegelian-Marxist who has a more scholarly, nuanced, and charitable approach to Hegel, placing more emphasis on the critical moment in Hegel's conception of reason.",
    note = "CORE ARGUMENT: Compares the specific relations to Hegel held by Horkheimer, Adorno, and Marcuse, concluding that Horkheimer endorses only a qualified Hegelianism (rejecting Hegel's idealist metaphysics in favor of sociology and materialist history), Adorno remains the most committed Hegelian via immanent critique, and Marcuse offers the most scholarly and charitable reading, emphasizing Hegel's critical rather than systematic moment. RELEVANCE: Gives a differentiated, figure-by-figure account of exactly how the first-generation Frankfurt School used Hegelian dialectic against both idealist metaphysics and positivist/vulgar materialism, directly answering this domain's key question about Frankfurt School uses of Hegel. POSITION: Comparative analysis distinguishing degrees and kinds of Hegelianism among first-generation Frankfurt School theorists.",
    keywords = "Frankfurt-School, Horkheimer, Adorno, Marcuse, Hegel, High, METADATA\\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc"
}

@book{postone1993time,
    author = "Postone, Moishe",
    title = "Time, Labor, and Social Domination",
    year = "1993",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Reinterprets Marx's mature critique of political economy as a fundamentally Hegelian, but non-humanist and non-class-subject-centered, critique of the abstract, quasi-automatic domination exercised by value and abstract labor time in capitalist society, arguing that both "traditional Marxism" (which affirms labor as trans-historically emancipatory) and Lukácsian Hegelian Marxism (which posits the proletariat as the Hegelian identical subject-object of history) misread this structure. RELEVANCE: Offers a major alternative reconstruction of Marx's relation to Hegel that neither collapses into Lukács's totality/class-subject model nor into Althusserian anti-Hegelian scientism, directly relevant to assessing what, in Marx's mature economic categories, remains genuinely Hegelian. POSITION: Distinct third position — a non-humanist, non-Lukácsian Hegelian-Marxist reading of Capital as critique of abstract domination.},
    keywords = "Postone, Hegel, abstract-domination, value-theory, High, METADATA\\_CLEANED: doi",
    abstract = "Moishe Postone undertakes a fundamental reinterpretation of Karl Marx's mature critical theory. He calls into question many of the presuppositions of traditional Marxist analyses and offers new interpretations of Marx's central arguments, developing concepts aimed at grasping the essential character and historical development of modern society and at overcoming the familiar dichotomies of structure and action, meaning and material life. According to this interpretation, Marx identifies the core of the capitalist system with an impersonal form of social domination generated by labor itself, rather than simply with market mechanisms and private property; proletarian labor and the industrial production process are characterized as expressions of domination rather than as means of human emancipation. This reformulation, Postone argues, provides the foundation for a critical social theory more adequate to late twentieth-century capitalism.",
    abstract_source = "openalex"
}

@misc{arthur2000from,
    author = "Arthur, Christopher J.",
    title = "From the Critique of Hegel to the Critique of Capital",
    year = "2000",
    publisher = "Palgrave Macmillan UK",
    note = {CORE ARGUMENT: Traces the trajectory from Marx's early critique of Hegel's Philosophy of Right to the systematic-dialectical structure of Capital, arguing that Marx's mature economic categories (value-form, capital as automatic subject) preserve a genuinely Hegelian dialectical logic even as they abandon Hegel's idealist content, so that Capital itself is best read as an immanent critique conducted in a transformed Hegelian method. RELEVANCE: Provides a "New Dialectics" account of Hegel's continued methodological presence in Marx's mature economic writing, offering a middle position between the humanist alienation-continuity thesis and the anti-Hegelian scientistic reading by locating Hegel's survival specifically at the level of dialectical method rather than either alienation-humanism or class-subject totality. POSITION: Systematic-dialectical reading emphasizing Hegel's methodological (not humanist-alienation) survival in Capital.},
    keywords = "Hegel, Marx, Capital, systematic-dialectic, dialectical-method, Medium, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "The thesis of this essay is that the critique of Hegel cannot be separated from the critique of capital, and that the critique of economic categories is greatly advanced if modelled on the critique of Hegel. It is in truth the very same critique that is to be employed. This identity arises in virtue of the fact that Hegel's standpoint may be seen as a philosophical absolutisation of the standpoint of capital, on the one hand; and in virtue of the nature of capital on the other, for the form of capital may be understood as homologous with that of Hegel's 'Idea'.",
    abstract_source = "openalex"
}

@misc{dunayevskaya2018theory,
    author = "Dunayevskaya, Raya",
    editor = "Dmitryev, Franklin",
    title = "The Theory of Alienation: Marx's Debt to Hegel",
    year = "2018",
    publisher = "Brill",
    abstract = {The topic "Marx's Debt to Hegel," is neither merely academic, nor does it pertain only to the historical period of Marx's lifetime. From the Hungarian revolt to the African revolutions, from the student demonstrators in Japan to the Negro revolution in the U.S., the struggle for freedom has transformed reality and pulled Hegelian dialectics out of the academic halls and philosophy books onto the living stage of history. It is true that this transformation of Hegel into a contemporary has been via Marx. It is no accident, however, that Russian Communism's attack on Marx has been via Hegel. Because they recognize in the so-called mystical Absolute "the negation of the negation," the revolution against themselves, Hegel remains so alive and worrisome to the Russian rulers today.},
    note = {CORE ARGUMENT: Argues, from the founding perspective of Marxist-Humanism, that Marx's theory of alienation is inseparable from his debt to the Hegelian dialectic of negativity (the "negation of the negation"), and that Soviet-era attacks on the young Marx's Hegelian-inflected humanism were simultaneously attacks on the revolutionary, self-transforming core of Hegel's dialectic that Marx had inherited and preserved. RELEVANCE: A primary Marxist-Humanist statement that alienation is a retained and deepened Hegelian category throughout Marx's work, directly representing one pole of this domain's central alienation/humanism debate, and explicitly framing the stakes (Stalinist "scientific" Marxism's rejection of both Hegel and the young Marx) that motivate the opposing anti-humanist position. POSITION: Marxist-Humanist continuity thesis: alienation as Marx's permanent, Hegel-derived critical category.},
    keywords = "Dunayevskaya, alienation, Hegel, Marxist-Humanism, negation-of-negation, High, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@book{ollman1977alienation,
    author = "Ollman, Bertell",
    title = "Alienation",
    year = "1977",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Reconstructs Marx's theory of alienation through his underlying "philosophy of internal relations" (a methodological legacy of Hegelian relational ontology), arguing that alienation names the rupture, under capitalism, of the internally related unity between the worker and his productive activity, its product, his species-being, and other workers — a unity that is restored, not abandoned, as the organizing logic of Marx's mature economic categories. RELEVANCE: One of the most sustained defenses of alienation as a structurally central, Hegelian-derived category running throughout Marx's work rather than a discarded early-humanist residue, providing the systematic counterpart to Meszaros's and Petrović's arguments on the humanist side of the debate. POSITION: Humanist-continuity thesis grounded in a relational (quasi-Hegelian) reading of Marx's dialectical method.},
    keywords = "Ollman, alienation, internal-relations, Hegel, humanism, High, METADATA\\_CLEANED: doi",
    abstract = "In this book, Professor Ollman reconstructs Marx's theory of alienation from its constituent parts and offers it as a vantage point from which to view the rest of Marxism. The book further contains a detailed examination of Marx's philosophy of internal relations, the neglected logical foundation of his method, and provides a systematic account of Marx's conception of human nature. In this edition Professor Ollman replies to his critics in 'More on internal relations,' provides a more systematic discussion of Marx's theory of ideology, and sets the treatment of political alienation within the broader framework of Marx's theory of the state as a model of how an approach based on internal relations can be used to integrate various apparently contradictory interpretations of Marx's views.",
    abstract_source = "openalex"
}

@misc{petrovic1963marx,
    author = "Petrovic, Gajo",
    title = "Marx's Theory of Alienation",
    year = "1963",
    volume = "23",
    number = "3",
    note = {CORE ARGUMENT: Argues, from the Yugoslav Praxis-school perspective, that alienation is the central category of Marx's entire theoretical project, not a youthful, pre-scientific concern superseded by the categories of Capital, because the mature critique of commodity fetishism and capital as an alien, self-moving power is itself a continuation and deepening of the 1844 Manuscripts' analysis of estranged labor. RELEVANCE: An early and influential statement of the humanist-continuity position that directly anticipates and parallels Meszaros's and Ollman's later book-length arguments, useful as a compact, citable articulation of the "alienation persists" thesis this domain's key questions ask about. POSITION: Humanist-continuity thesis, articulated from within the Yugoslav Praxis school of Marxist humanism.},
    keywords = "Petrovic, alienation, humanism, Praxis-school, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, doi, type:@article->@misc"
}

@article{levine1976marxism,
    author = "Levine, Norman",
    title = "Marxism and Hegel",
    journal = "The American Historical Review",
    year = "1976",
    note = {CORE ARGUMENT: A review of Lucio Colletti's Marxism and Hegel (trans. Lawrence Garner), engaging Colletti's central claim that Hegel's dialectical logic — resting on the identity and mutual interpenetration of contradictory opposites — is fundamentally incompatible with Marx's materialist, non-contradictory conception of real oppositions, so that Marx's mature thought requires a decisive break from Hegelian dialectical logic rather than its completion. RELEVANCE: Represents the anti-Hegelian pole of this domain's alienation/humanism debate through direct engagement with Colletti's argument that dialectical "contradiction" is a category error when applied to real, non-logical oppositions in nature and society — the clearest logical (rather than merely political) case against reading Marx as a completion of Hegel. POSITION: Engages and assesses Colletti's anti-Hegelian, anti-dialectical-materialist reading of Marx.},
    keywords = "Colletti, Hegel, dialectical-logic, anti-Hegelian, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: volume, number, doi"
}

@book{anderson2022lenin,
    author = "Anderson, Kevin B.",
    title = "Lenin, Hegel, and Western Marxism",
    year = "2022",
    publisher = "Brill",
    note = {CORE ARGUMENT: Examines Lenin's 1914-15 Hegel Notebooks and argues that Lenin's serious, sympathetic engagement with Hegel's Science of Logic constitutes an underappreciated precursor to and resource for the Hegelian Marxism later developed independently by Lukács and Korsch, complicating any sharp opposition between "orthodox" Leninist Marxism and Western Marxist Hegelianism. RELEVANCE: Extends this domain's scope by showing that the impulse to reread Marx through Hegel was not confined to Lukács, Korsch, and the Frankfurt School but had a parallel, largely unpublished counterpart within Bolshevik theory itself, complicating the standard contrast between Second/Third International orthodoxy and Western Marxist Hegelianism. POSITION: Revisionist argument for a Hegelian-Marxist reading of Lenin, bridging orthodox and Western Marxist traditions.},
    keywords = "Lenin, Hegel, Western-Marxism, dialectical-logic, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: doi"
}

@book{hegel1975lectures,
    author = "Hegel, Georg Wilhelm Friedrich and Forbes, Duncan",
    title = "Lectures on the Philosophy of World History",
    year = "1975",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Hegel's introductory lectures argue that world history is the rational, necessary unfolding of Spirit's self-realization as freedom, proceeding through successive epochs (Oriental despotism, Greco-Roman citizenship, the Germanic-Christian world) in which an ever-larger portion of humanity becomes recognized as free. Reason "rules the world" and history is therefore intelligible as a single providential process, apprehended retrospectively by philosophy (the "cunning of reason" whereby individual passions and interests serve ends they do not themselves intend). RELEVANCE: This is the primary Hegelian text against which Marx's materialist conception of history is standardly read as a polemical inversion; it establishes the precise content (directionality, necessity, epochal succession, providential rationality) that later debates ask whether Marx retains, rejects, or unwittingly reproduces in materialist form. POSITION: Paradigm statement of providential, teleological idealist philosophy of history.},
    keywords = "Hegel, philosophy-of-history, teleology, cunning-of-reason, High, primary-source, METADATA\_CLEANED: doi",
    abstract = "An English translation of Hegel's introduction to his lectures on the philosophy of history, based directly on the standard German edition by Johannes Hoffmeister, first published in 1955. The previous English translation, by J. Sibree, first appeared in 1857 and was based on the defective German edition of Karl Hegel, to which Hoffmeister's edition added a large amount of new material previously unknown to English readers, derived from earlier editors. In the introduction to his lectures, Hegel lays down the principles and aims which underlie his philosophy of history, and provides an outline of the philosophy of history itself. The comprehensive and voluminous survey of world history which followed the introduction in the original lectures is of less interest to students of Hegel's thought than the introduction, and is therefore not included in this volume.",
    abstract_source = "openalex"
}

@book{popper2012opensociety,
    author = "Popper, Karl",
    title = "The Open Society and Its Enemies",
    year = "2012",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Popper's second volume (originally subtitled "The High Tide of Prophecy: Hegel, Marx, and the Aftermath") argues that Hegel's dialectical philosophy of history and Marx's materialist theory of history share a common "historicist" logical structure: both claim to have discovered inexorable laws governing the overall direction of history, and both use this claim to justify totalitarian political conclusions. Popper treats Marx's productive-forces determinism as a materialist transposition of Hegel's Spirit rather than a genuine break with idealist historicism. RELEVANCE: This is the foundational statement of the "Marx as covert Hegelian" charge that organizes much of the later analytic literature in this domain (Suchting, Hudelson, Honderich); it directly poses the question the project's title addresses — whether Marx's materialist history is a genuine alternative to, or merely an inversion of, idealist teleology. POSITION: Anti-historicist critique treating Hegel and Marx as a single target.},
    keywords = "Popper, historicism, Hegel, Marx, teleology, critique, High, primary-source, METADATA\_CLEANED: doi",
    abstract = "Written in political exile in New Zealand during the Second World War and published in two volumes in 1945, The Open Society and its Enemies was hailed by Bertrand Russell as a 'vigorous and profound defence of democracy'. This legendary attack on the philosophies of Plato, Hegel and Marx prophesied the collapse of communism in Eastern Europe and exposed the fatal flaws of socially engineered political systems. It remains highly readable, erudite and lucid and as essential reading today as on publication in 1945. It is available here in a special centenary single-volume edition.",
    abstract_source = "openalex"
}

@book{popper2013poverty,
    author = "Popper, Karl",
    title = "The Poverty of Historicism",
    year = "2013",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Popper defines "historicism" as the doctrine that history is governed by discoverable laws which permit prediction of its overall course, and argues this doctrine is both methodologically confused (it mistakes historical trends for laws) and politically dangerous. Although aimed at a general target, the argument is explicitly framed to indict both Hegelian and Marxist philosophies of history as instances of the same error. RELEVANCE: Supplies the methodological core of Popper's critique that Suchting and Hudelson (below) contest point by point; central to assessing whether "determinism" in historical materialism is the same kind of claim as Hegel's providential necessity. POSITION: General methodological indictment of teleological/law-governed philosophies of history, targeting Hegel and Marx jointly.},
    keywords = "Popper, historicism, determinism, methodology, High, primary-source, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@misc{cohen2000karlmarx,
    author = "Cohen, G. A.",
    title = "Karl Marx's Theory of History: A Defence",
    year = "2000",
    edition = "Expanded",
    address = "Oxford",
    note = {CORE ARGUMENT: Cohen reconstructs historical materialism as resting on a "development thesis" (the productive forces tend to develop through history) and a "primacy thesis" (relations of production are explained by their function in developing the productive forces, not vice versa), defended via functional explanation: a set of relations of production obtains because it is suited to developing the forces of production, on the model of functional explanation in evolutionary biology. RELEVANCE: The central text of this domain's largest debate cluster. Cohen's functional reconstruction is precisely the point at which critics allege that historical materialism reintroduces a covert, quasi-Hegelian teleology (productive forces "needing" to develop) that Marx's own texts do not warrant; virtually every other secondary source in this file responds to, defends, or revises this book. POSITION: Technological-determinist, functionalist reconstruction of historical materialism.},
    keywords = "Cohen, historical-materialism, functional-explanation, determinism, base-superstructure, High, primary-source, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{wrightlevinesober1992reconstructing,
    author = "Wright, Erik Olin and Levine, Andrew and Sober, Elliott",
    title = "Reconstructing Marxism: Essays on Explanation and the Theory of History",
    year = "1992",
    address = "London/New York",
    note = {CORE ARGUMENT: Against Cohen's functionalist and technological-determinist reading, the authors defend a more pluralistic, "rational choice Marxist" reconstruction of historical materialism that abandons strong claims about the primacy and autonomous development of productive forces in favor of piecemeal causal and intentional explanations grounded in class conflict and the choices of situated agents. RELEVANCE: Represents the principal analytic-Marxist alternative to Cohen's teleology-adjacent functionalism; central to the structure/ agency question in the domain brief, since it relocates historical explanation from impersonal developmental tendencies to agents' reasons and struggles. POSITION: Rational-choice/methodological-individualist reconstruction of historical materialism, opposed to functionalist determinism.},
    keywords = "Wright, Levine, Sober, rational-choice-Marxism, structure-agency, functional-explanation, High, primary-source, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{little1994review,
    author = "Little, Daniel",
    title = "Reconstructing Marxism: Essays on Explanation and the Theory of History",
    year = "1994",
    number = "1",
    note = "CORE ARGUMENT: A critical review of Wright, Levine, and Sober's Reconstructing Marxism, assessing how successfully the rational-choice reconstruction of historical materialism replaces Cohen's functionalist and technological-determinist framework while still preserving explanatorily useful generalizations about class and historical change. RELEVANCE: Provides an independent scholarly assessment of the structure/agency alternative to Cohen represented by Wright, Levine, and Sober, useful for gauging how the analytic-Marxist field received the rational-choice reconstruction. POSITION: Sympathetic-critical assessment of rational-choice Marxism as an alternative to functionalist historical materialism.",
    keywords = "review, rational-choice-Marxism, structure-agency, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@article{parkinson1989hegel,
    author = "Parkinson, G. H. R.",
    title = "Hegel, Marx and the Cunning of Reason",
    journal = "Philosophy",
    year = "1989",
    note = {CORE ARGUMENT: Parkinson examines Hegel's doctrine of the "cunning of reason" — whereby world-historical individuals unwittingly serve Spirit's rational ends through the pursuit of their own passions and interests — and traces the extent to which an analogous structure survives in Marx's account of how individuals acting from private, material motives nonetheless bring about historically necessary transformations of the mode of production. RELEVANCE: Directly addresses the domain's central question of what Marx rejects versus retains from Hegel's teleological philosophy of history; a key resource for distinguishing "directionality without Spirit" from full-blown providential teleology. POSITION: Comparative analysis arguing for significant structural continuity between Hegel's cunning of reason and Marx's account of unintended historical outcomes.},
    keywords = "Hegel, Marx, cunning-of-reason, teleology, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "This paper is concerned with two theories of history—those of Hegel and of Marx. Its primary aim is to clarify. The writings of Hegel are notoriously obscure, and those of Marx have been variously interpreted, so there is room for a paper which tries to ensure that when the theories of history propounded by Marx and Hegel are criticized, what are criticized are views which they actually held. It is no part of this paper's thesis that, in his theory of history, Marx consciously borrowed from Hegel. But it will be argued that there is more of Hegel in Marx than is sometimes supposed, and that if this fact is ignored one seriously distorts Marx.",
    abstract_source = "openalex"
}

@article{yangyeomans2023taking,
    author = "Yang, Chen and Yeomans, Christopher",
    title = "Taking the Teleology of History Seriously: Lessons from Hegel's Logic",
    journal = "Hegel Bulletin",
    year = "2023",
    volume = "44",
    number = "1",
    note = {CORE ARGUMENT: The authors argue that Hegel's teleological conception of history should be understood via the account of teleology developed in the Science of Logic — as a structure of self-determining, internally purposive development — rather than as external, providence-imposed design, and that this logical grounding clarifies what is philosophically distinctive (and defensible) about Hegel's claim that history has a rational direction. RELEVANCE: Offers a contemporary, technically precise account of what "teleology" means in Hegel's philosophy of history, providing the conceptual baseline against which the charge that historical materialism is "covertly teleological" can be evaluated with more precision than the looser sense of teleology used in the Popperian critique. POSITION: Reconstructive defense of Hegelian historical teleology grounded in the logic of self-determining purposiveness.},
    keywords = "Hegel, teleology, philosophy-of-history, logic, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract To oversimplify quite a bit, scholars' presentation of Hegel's teleology constitutes a continuum according to how more-or-less secured the progress towards the goal is supposed to be, which tracks roughly the nature of the end and its necessity. In this article, rather than focus on the end and progress towards it, we will focus on the means and structure of teleological relationships on Hegel's account. This focus follows from an essential feature of Hegel's discussion of teleology in the Logic, in which teleology is introduced to solve a problem in the individuation of entities. It will turn out that the fullest actualization of the end is in the durable means, which is also thereby individuated. And it will turn out that the paradigmatic historical means—the state—is tensed, as it were, between the end and its realization that makes it synchronically historical. This synchronic historicity is missing in the usual progressive and thus diachronic accounts of the teleological process of history. But first we step back even farther (at least historically). We begin by taking up the two most important philosophical accounts of teleology for Hegel, namely those of Aristotle and Kant. Then we go to Hegel's Logic for his reconstruction of teleological processes against the background of the explanatory need for individuation. We focus on four aspects of Hegel's account: that teleology is a structure of reciprocal interaction, that the purpose is an immanent governing principle, that change is the price of immanence, and that the durable means is the teleological object par excellence. Finally, we trace these features through Hegel's account of world history and conclude with some brief remarks on the historicity of the state described in the Philosophy of Right.",
    abstract_source = "openalex"
}

@misc{wood1986historical,
    author = "Wood, Allen W.",
    title = "Historical materialism and functional explanation",
    year = "1986",
    volume = "29",
    note = "CORE ARGUMENT: Wood examines whether Cohen's functional explanations of relations of production by their effect on productive forces can be philosophically legitimate without specifying the causal mechanisms that would make such functional dependencies operative, and assesses how far Marx's own texts commit him to this style of explanation as opposed to a looser, non-functionalist form of historical materialism. RELEVANCE: A central piece in the functional-explanation controversy that is this domain's largest cluster; directly interrogates whether functionalism is where historical materialism's covert teleology, if any, actually resides. POSITION: Critical assessment of functional explanation as the foundation of historical materialism, sympathetic to a non-functionalist alternative reading of Marx.",
    keywords = "functional-explanation, Cohen, historical-materialism, determinism, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This paper is a critical examination of one central theme in Jon Elster's Making Sense of Marx; Elster's defense of 'methodological individualism' in social science and his related critique of Marx's use of 'functional explanation'. The paper does not quarrel with Elster's claim that the particular instances of functional explanation advanced by Marx are defective; what it criticizes is Elster's attempt to raise principled, philosophical objections to this type of explanation in the social sciences. It is argued that Elster's philosophical critique of functional explanation rests on a caricature of this kind of explanation, just as his critique of Marx's use of teleology in the philosophy of history rests on a caricature of the kinds of teleological claims Marx is concerned to make. The paper ends with a brief discussion of a recently published passage from Marx's notebooks of 1861–1863, where Elster claims to have found Marx explicitly criticizing capitalist exploitation as an injustice to the workers.",
    abstract_source = "openalex"
}

@misc{honderich1982against,
    author = "Honderich, Ted",
    title = "Against teleological historical materialism",
    year = "1982",
    volume = "25",
    number = "4",
    note = {CORE ARGUMENT: Honderich argues directly against teleological readings of historical materialism, including Cohen's functionalist reconstruction, contending that attributing to productive forces a tendency or disposition to develop — and explaining relations of production by that development — imports an unwarranted, quasi-purposive structure into what should be a straightforwardly causal, non-teleological materialist theory of history. RELEVANCE: One of the earliest and most explicit statements of the "covert teleology" charge against Cohen's reconstruction specifically (as opposed to the broader Popperian charge against historicism in general), making it central evidence for the domain's key question about functional explanation and teleology. POSITION: Anti-teleological, causal-materialist critique of Cohen's functionalist historical materialism.},
    keywords = "teleology, functional-explanation, Cohen, determinism, High, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Marx may be taken to hold that productive forces (e.g. the steam engine) explain productive relations (e.g. capitalism) more than the other way on, and that productive relations explain superstructures (e.g. the legal system) more than the other way on. There are no satisfactory standard causal understandings of these claims about explanatory primacy. That is, no standard causal understanding saves Marx from the traditional objection that relations very greatly affect forces, and superstructures very greatly affect relations. One satisfactorily articulated attempt to save Marx has been the attempt to understand the claims teleologically. Three such understandings can be distinguished, but they do not work. The first fails since it attempts to explain events by way of abstract objects. The second fails since it attempts to explain a thing by means of that thing. The third fails for a related reason. Each understanding also fails for another reason as fundamental. So‐called teleological explanations are in fact claims that standard causal explanations exist, which relevant explanations conflict with the ruling idea of Marx's philosophy, that history is somehow independent of men's consciousness and wills. There may be no evidence that Marx himself intended historical materialism to be understood teleologically. There may be evidence against.",
    abstract_source = "openalex"
}

@misc{cohen2013reply,
    author = "Cohen, G. A.",
    editor = "Wolff, Jonathan",
    title = "Reply to Elster on ``Marxism, Functionalism, and Game Theory''",
    year = "2013",
    note = "CORE ARGUMENT: Cohen responds to Elster's methodological-individualist objections to functional explanation in historical materialism, defending the view that functional explanations can be legitimate even without a fully specified elaborating mechanism, provided there is independent evidence of a functional correlation between explanandum and explanans (on the model of evolutionary biology prior to the articulation of genetic mechanisms). RELEVANCE: Cohen's direct rebuttal to the most sustained methodological challenge to his reconstruction, essential for presenting both sides of the functional-explanation dispute rather than only the critics' position. POSITION: Defense of functional explanation against methodological-individualist objections.",
    keywords = "functional-explanation, Cohen, Elster, methodological-individualism, High, METADATA\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc",
    abstract = "In this chapter, the author responds to Jon Elster's criticism of his use of functional explanation in his account of historical materialism. Elster rejects the association between Marxism and functional explanation, arguing that there is no scope for functional explanation in social science. He therefore concludes that the Marxist theory of society and history should abandon functional explanation and that it should, instead, draw for its explanations on the resources of game theory. The author offers an explanation of historical materialist theory that he attributes, on a textual basis, to Karl Marx, and that he articulates and defends in his book Karl Marx's Theory of History. He asserts that game theory cannot replace functional explanation within Marxist social analysis and that it has no place at the heart of historical materialism, alongside functional explanation.",
    abstract_source = "openalex"
}

@misc{elster1990marxism,
    author = "Elster, Jon",
    title = "Marxism and Methodological Individualism",
    year = "1990",
    address = "Oxford",
    note = "CORE ARGUMENT: Elster argues that adequate explanations in Marxist social theory must ultimately be grounded in the intentional actions of individuals, and that functionalist explanations of the kind Cohen offers — where social structures are explained by their beneficial consequences for other structures rather than by the intentions of agents who produce and sustain them — are explanatorily inadequate unless supplemented with an account of the individual-level mechanisms that generate the alleged functional correlation. RELEVANCE: The clearest statement of the methodological-individualist, agency-centered objection to functionalist historical materialism that organizes the structure/agency dimension of this domain; directly informs the later rational-choice Marxist reconstruction by Wright, Levine, and Sober. POSITION: Methodological individualism against functionalist explanation in Marxist theory.",
    keywords = "methodological-individualism, functional-explanation, Elster, structure-agency, High, METADATA\_CLEANED: booktitle, publisher, doi, pages, type:@incollection->@misc",
    abstract = "Abstract 'God is the productive forces.' This joke of Paul Lafargue's expresses well enough a particular Marxist approach that I shall take issue with in the present chapter. Such an approach involves seeking out the motor forces of history, as well as the stabilizing forces of societies. It uses abstractions such as 'productive forces', 'relations of production', 'classes', 'state', or 'ideologies' without indicating how these are anchored in individual actions, motivations, and beliefs. According to this view, history is the self-realization of Humanity, of Man rather than of men. Capitalist exploitation and domination are the fact of Capital, which takes precedence in the order of explanation over individual capitals.",
    abstract_source = "openalex"
}

@misc{dickman1990two,
    author = "Dickman, Joel",
    title = "Two Qualms about Functionalist Marxism",
    year = "1990",
    volume = "57",
    number = "4",
    note = "CORE ARGUMENT: Dickman raises two philosophy-of-science objections to Cohen-style functional explanation in Marxism: first, that the analogy to functional explanation in evolutionary biology is disanalogous in ways that undermine its explanatory legitimacy in the social case, and second, that even granting the analogy, functional explanations of this kind cannot do the specific explanatory work historical materialism requires of them (namely, explaining epochal transitions rather than mere stability). RELEVANCE: Supplies a philosophy-of-science perspective on the functional-explanation debate, complementing the more directly Marxological objections of Elster and Wood, and sharpening the question of whether functionalism smuggles in directionality (teleology) that a genuinely causal explanation would not license. POSITION: Philosophy-of-science critique of the biological analogy underlying Cohen's functionalism.",
    keywords = "functional-explanation, Cohen, philosophy-of-science, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "In Karl Marx's Theory of History: A Defence (1978), G. A. Cohen has developed a distinctively functionalist interpretation of historical materialism. In this paper I outline Cohen's novel reconstruction of Marx and subject it to two independent internal criticisms. I first argue that explanations cannot conform to Cohen's functionalist model. I then suggest that even if there could be explanations having the structure he has proposed, they would fail to be helpful in illuminating the causal kernel of Marx's theory. Finally I sketch a neglected but more promising approach to clarifying historical materialism, due to Geoffrey Hellman.",
    abstract_source = "openalex"
}

@misc{lukes1982can,
    author = "Lukes, Steven",
    title = "Can the Base be Distinguished from the Superstructure?",
    year = "1982",
    volume = "4",
    note = "CORE ARGUMENT: Lukes interrogates whether the base/superstructure distinction can be drawn in a way that is both non-trivial (the relations of production must be characterizable independently of the legal and political categories that supposedly belong to the superstructure) and textually faithful to Marx, arguing that standard formulations face a dilemma between circularity and historical inaccuracy. RELEVANCE: Directly addresses the domain's question about the status of the base/superstructure metaphor — whether it is a genuinely materialist architecture or an unstable device that covertly imports the very idealist categories (legal/political forms) it is meant to explain away. POSITION: Skeptical critique of the coherence of the base/superstructure distinction as standardly formulated.",
    keywords = "base-superstructure, historical-materialism, Marx, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {Abstract This article considers Cohen's claim that the economic structure or base can be conceived independently of the superstructure by adressing his attempt to identify "a rechtsfrei (moralitätsfrei, etc.) economic structure to explain law (morals, etc.)". It examines his programme of presenting relations of production as a set of (non-normative) powers and constraints that 'match' the rights and obligations of property relations. It is argued that, first, Cohen does not carry through this programme rigorously but, second, he could not do so, since it cannot be carried out at all. Three arguments are advanced, the first two against the possibility of a determinate 'objective' account of such powers and constraints, the third against the possibility of abstracting norms (constitutive and regulative, formal and informal) from contractual relationships: it is argued that one cannot identify the powers and constraints embodied in norm-governed economic relationships independently of the norms which govern them. Alternative interpretations are considered of Cohen's programme that might escape these objections, but these are rejected as untrue to his purpose, and in any case ineffective. It is concluded that Cohen fails to distinguish base from superstructure in the manner required.},
    abstract_source = "openalex"
}

@misc{farrelly2005historical,
    author = "Farrelly, Colin",
    title = "Historical Materialism and Supervenience",
    year = "2005",
    volume = "35",
    number = "4",
    note = "CORE ARGUMENT: Farrelly proposes reconstructing the base/superstructure relation using the philosophical concept of supervenience — the superstructure supervenes on, without being reducible to, the economic base — as a way of preserving materialist explanatory priority while avoiding the difficulties Lukes and others raise about drawing the distinction in non-circular terms. RELEVANCE: Offers a contemporary technical alternative to functionalist readings of base/superstructure, directly engaging the question of whether a non-teleological, non-reductive materialist architecture for historical explanation is available. POSITION: Supervenience-based reconstruction of the base/superstructure relation as an alternative to functionalist and reductive readings.",
    keywords = "base-superstructure, supervenience, historical-materialism, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "In this article I put forth a new interpretation of historical materialism titled the supervenient interpretation. Drawing on the insights of analytical Marxism and utilizing the concept of supervenience, I advance two central claims. First, that Marx's synchronic materialism maintains that the superstructure supervenes naturally on the economic structure. Second, that diachronic materialism maintains that the relations of production supervene naturally on the forces of production. Taken together, these two theses help bring to the fore the central tenets of historical materialism. Furthermore, they help resolve what I call the problem of reductionism and the problem of verification.",
    abstract_source = "openalex"
}

@misc{ruben1981cohen,
    author = "Ruben, David-Hillel",
    title = "Cohen, Marx and the Primacy Thesis",
    year = "1981",
    volume = "11",
    note = {CORE ARGUMENT: Ruben scrutinizes Cohen's "primacy thesis" (that the character of the relations of production is explained by their suitability for developing the productive forces, rather than the reverse) and questions whether the textual and philosophical evidence Cohen marshals actually establishes primacy in the strong, explanatorily asymmetric sense Cohen's functionalism requires. RELEVANCE: A focused early critique of the specific thesis that gives Cohen's reconstruction its determinist, quasi-directional character; useful for showing how quickly Cohen's central claims attracted sustained analytic scrutiny. POSITION: Critical analytic scrutiny of the primacy thesis underlying Cohen's technological determinism.},
    keywords = "Cohen, primacy-thesis, determinism, historical-materialism, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "As Jon Elster remarked in an earlier review, G. A. Cohen's Karl Marx's Theory of History: A Defence 'sets a new standard for Marxist philosophy'. In one way, the praise is too faint. Existing paradigms of continental Marxist philosophy are marred by an absence of careful definition, clear and precise argumentation, and the sort of sustained discussion that is committed to the teasing out of the intellectual difficulties of the author's own position – in short, marred by an absence of those virtues in the attainment of which the philosophy practised in Britain, the United States, and the Scandinavian countries on the whole excels. Cohen would, presumably, agree that this has nothing intrinsically to do with Marx, or Marxism, but in the main arises from the fortuitous coupling of Marxism with continental philosophical fashions. What is perhaps less faint praise of Cohen is to say that his book is good philosophy (without the qualifying adjective 'Marxist'). It is an ingenious and imaginative volume, in which precision and detailed attention to argument count for everything.",
    abstract_source = "openalex"
}

@misc{taylor1980review,
    author = "Taylor, Charles",
    title = "G. A. Cohen Karl Marx's Theory of History: A Defense",
    year = "1980",
    volume = "10",
    note = "CORE ARGUMENT: Taylor's early critical notice of Cohen's book questions whether the sharp separation of productive forces from social relations that Cohen's functionalism requires is sustainable, given that productive forces themselves (skill, cooperation, organization) are arguably partly constituted by social relations — a criticism that bears on whether Cohen's reconstruction achieves genuine explanatory priority or merely stipulates it. RELEVANCE: An influential early philosophical response that helped set the terms of the subsequent functional-explanation debate; useful for establishing the reception history of Cohen's book among leading philosophers outside analytic Marxism proper. POSITION: Skeptical of the conceptual separability of forces and relations of production presupposed by Cohen's technological determinism.",
    keywords = "Cohen, review, historical-materialism, productive-forces, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{suchting1972marx,
    author = "Suchting, W. A.",
    title = "Marx, Popper, and `historicism'",
    year = "1972",
    volume = "15",
    note = {CORE ARGUMENT: Suchting mounts a detailed rebuttal of Popper's charge that Marx's theory of history is a species of "historicism" in Popper's pejorative sense, arguing that Popper conflates several distinct claims (holism, essentialism, unconditional prediction, large-scale utopian engineering) that Marx's actual theory does not jointly endorse, and that Marx's claims about tendencies in productive-force development are considerably more modest than Popper's target. RELEVANCE: A sustained, close textual rebuttal of the Popperian "covert teleology/historicism" charge that is central to this domain's key questions, providing the strongest counter-case to Popper within the literature gathered here. POSITION: Defense of Marx against the charge of Hegelian-style historicism, distinguishing Marx's modest tendential claims from Popper's target.},
    keywords = "Popper, historicism, Marx, determinism, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "According to Sir Karl Popper, there is a harmful approach to the social sciences called 'historicism'. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.",
    abstract_source = "openalex"
}

@misc{hudelson1980poppers,
    author = "Hudelson, Richard",
    title = "Popper's critique of Marx",
    year = "1980",
    number = "3",
    note = "CORE ARGUMENT: Hudelson evaluates Popper's specific arguments against Marx's theory of history (as distinct from Popper's more general arguments against historicism), arguing that several of Popper's central charges — particularly regarding unconditional historical prediction — rest on a misreading of Marx's actual methodological commitments, which are more conditional and tendential than Popper allows. RELEVANCE: Complements Suchting's rebuttal with a more narrowly focused analysis of Popper's arguments specifically targeting Marx (rather than historicism in general), useful for isolating exactly which parts of the Popperian critique survive scrutiny. POSITION: Partial defense of Marx against Popper, conceding some force to the critique while rejecting its strongest formulations.",
    keywords = "Popper, Marx, historicism, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{casal2020gacohens,
    author = "Casal, Paula",
    title = "G. A. Cohen's historical materialism: a feminist critique",
    year = "2020",
    volume = "25",
    number = "3",
    note = {CORE ARGUMENT: Casal argues that Cohen's technological-determinist reconstruction of historical materialism, by privileging the development of productive forces as the motor of historical change, systematically obscures the causal and explanatory significance of reproductive labor, gender relations, and the household economy in historical transformation, and that a materialism attentive to these factors would look substantially different from Cohen's model. RELEVANCE: Extends the critique of Cohen beyond internal philosophy-of-explanation objections (Elster, Wood, Ruben) to a substantive critique of what counts as "material" and "productive" in the theory, bearing on whether Cohen's determinism inherits an unreflective, narrowly economistic inheritance from the Hegelian world-historical framework it claims to reject. POSITION: Feminist-materialist critique of the scope and priorities of Cohen's technological determinism.},
    keywords = "Cohen, feminist-critique, historical-materialism, determinism, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Forty years on, G. A. Cohen's reconstruction and defence of Marx's theory of history is still widely considered among the best of its kind, and it remains unsurpassed in clarity, argumentation and textual support. This article presents an under-explored critique of the theory that arises once we recognize that it is meant to apply to the circumstances of women as well as men. The article argues that, when extended to women, the reconstructed theory's predictions fail to materialize, its characterizations of historical stages fall apart, and its functional explanations appear implausible. In addition, although the theory claims to be able to explain the emergence and diffusion of different ideologies by their effects on productive development, it cannot plausibly explain the presence of sexist ideologies despite their pervasive and profound impact across history. The article concludes by showing that these flaws highlight the many respects in which Cohen's orthodox version of Marxism is a conservative ideology, and one that egalitarians in particular should view with suspicion.",
    abstract_source = "openalex"
}

@misc{coram1989social,
    author = "Coram, B. T.",
    title = "Social Relations and Forces of Production: A Criticism of Cohen's Defense of Materialism",
    year = "1989",
    volume = "15",
    note = "CORE ARGUMENT: Coram argues that Cohen's attempt to keep social relations of production conceptually and causally distinct from productive forces (a distinction his primacy thesis and functional explanation both require) fails, because the productive forces Cohen treats as explanatorily basic are themselves partly constituted by social relations, undermining the asymmetric explanatory priority central to Cohen's determinism. RELEVANCE: Reinforces and extends the Taylor-style objection that Cohen's forces/relations distinction cannot bear the explanatory weight of a determinist theory, directly bearing on whether historical materialism's claimed directionality is well-founded or an artifact of Cohen's categorial stipulations. POSITION: Conceptual critique of the forces/relations distinction underlying Cohen's technological determinism.",
    keywords = "Cohen, productive-forces, relations-of-production, determinism, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{post2021structure,
    author = "Post, Charles",
    title = "Structure and Agency in Historical Materialism: A Response to Knafo and Teschke",
    journal = "Historical Materialism",
    year = "2021",
    volume = "29",
    number = "3",
    note = {CORE ARGUMENT: Responding to Political Marxist critics who charge that his account of social-property relations reintroduces transhistorical "laws of motion" incompatible with genuine historical agency, Post argues that social-property relations can structure agents' actions and generate determinate "developmental patterns" specific to each mode of production without thereby positing ahistorical, quasi-teleological laws that operate independently of class struggle. RELEVANCE: A recent, live instance of the structure/agency debate within historical materialism, showing that the question of whether structural explanation in Marxism smuggles in an illegitimate determinism (of the kind associated with Hegelian necessity) remains actively contested in contemporary Political Marxism, not merely a legacy of the 1970s-80s Cohen debates. POSITION: Defends structural (social-property-relations) explanation in historical materialism against the charge of illegitimate, quasi-teleological determinism, while affirming the causal significance of class agency.},
    keywords = "structure-agency, historical-materialism, political-Marxism, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "This essay argues that Knafo and Teschke fundamentally misread Brenner's original contribution to the transition debate. They equate his rejection of trans-historical or trans-modal laws of motion with the notion that social-property relations do not have strong rules of reproduction that structure the actions of agents and give rise to `developmental patterns' specific to each form of social labour. Knafo and Teschke's critique of Brenner's analysis of capitalist expansion and crisis is also theoretically and empirically questionable.",
    abstract_source = "s2"
}

@book{boveiri2024marxian,
    author = "Boveiri, Kaveh",
    title = "Marxian Totality",
    year = "2024",
    publisher = "Brill",
    note = {CORE ARGUMENT: Boveiri examines Marx's concept of social totality as developed through a critical inversion of Hegelian totality, arguing that Marx retains a structurally holistic conception of society and history from Hegel's logic while relocating its ground from Spirit's self-determination to the totality of material social relations and their contradictions. RELEVANCE: Directly engages the "inversion" thesis at the center of this domain — how much of Hegel's systematic, holistic conception of history Marx preserves even while rejecting its idealist metaphysical ground — complementing the narrower functional-explanation debate with a broader account of Marx's inheritance of Hegelian totality. POSITION: Argues for substantial structural continuity between Hegelian and Marxian conceptions of historical totality, mediated by a critical inversion of their metaphysical ground.},
    keywords = "Hegel, Marx, totality, dialectic, inversion, Medium, METADATA\_CLEANED: doi",
    abstract = "The present volume represents the first book-length monograph on the Marxian concept of totality as seen from a philosophical and sociopolitical perspective. Drawing on a large number of classical and contemporary works, Boveiri elucidates the distinctive features of Marxian totality with a particular focus on its methodology. The work has four fundamental elements, or moments. First, it develops arguments against undialectical conceptions of totality. Then it presents a critical reading of Hegelian totality focused on The Science of Logic. Its penultimate section examines the shortcomings of two well-known conceptions of totality, one by Georg Lukács, another by Karel Kosík, before a final section examines in detail the developmental characteristics of Marxian totality. The volume concludes with a chapter dealing with methodological implications.",
    abstract_source = "openalex"
}

@book{levine2012marxs,
    author = "Levine, Norman",
    title = "Marx's Discourse with Hegel",
    year = "2012",
    publisher = "Palgrave Macmillan UK",
    note = "CORE ARGUMENT: Levine undertakes an extensive archival reconstruction, using the MEGA edition, of exactly which works of Hegel's Marx owned, annotated, and could have read at each stage of his intellectual development, arguing that Marx appropriated Hegel's method while rejecting Hegel's system and that prior scholarship routinely overstated Marx's direct textual access to specific Hegelian works. RELEVANCE: This is a direct, book-length answer to the domain's first key question — how MEGA2-enabled philology changes what can legitimately be claimed about Marx's documented engagement with Hegel, as opposed to inferred or assumed influence. POSITION: MEGA2-based philological reconstruction of the Marx-Hegel relationship, contesting looser genealogical claims made by earlier interpretive traditions.",
    keywords = "MEGA2-philology, Marx-Hegel-relation, textual-history, High, METADATA\_CLEANED: doi",
    abstract = "The end of Stalinist Russia, China's change under Deng Xiaoping and the publication of previously unexplored documents of Marx in the MEGA2 opened a new epoch in the analysis of Marx. Marx's Discourse",
    abstract_source = "openalex"
}

@misc{roth2009karl,
    author = "Roth, Regina",
    title = "Karl Marx's Original Manuscripts in the Marx-Engels-Gesamtausgabe (MEGA): Another View on Capital",
    year = "2009",
    publisher = "Palgrave Macmillan UK",
    note = {CORE ARGUMENT: Drawing on her editorial work for MEGA2, Roth shows how examination of Marx's preparatory manuscripts and multiple drafts for "Capital" (rather than only the Engels-edited published volumes) reveals a more fluid, revised, and unfinished text than the standard printed edition suggests, with implications for how the dialectical presentation of Volumes 2 and 3 should be read. RELEVANCE: Provides direct evidence for the domain's central philological claim — that MEGA2 access to Marx's actual working manuscripts (as opposed to Engels's editorial reconstructions) has altered what can be asserted about the systematicity and completeness of Marx's dialectical exposition in "Capital." POSITION: MEGA2 editorial philology as a corrective to Engels-mediated readings of Capital's structure.},
    keywords = "MEGA2-philology, Capital-manuscripts, textual-history, High, INCOMPLETE, no-abstract, METADATA\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{fareldkuch2020from,
    editor = "Fareld, Victoria and Kuch, Hannes",
    title = "From Marx to Hegel and Back",
    year = "2020",
    note = {CORE ARGUMENT: The editors frame this volume around the question of how the Hegel-Marx relationship should be re-read in light of the contemporary revival of interest in both thinkers, moving away from older reception narratives (materialist inversion, humanist critique) toward essays that treat the relationship as still philosophically open and productive for critical social theory. RELEVANCE: A programmatic recent (2020) collection explicitly organized around the premise motivating this domain — that renewed interest in Marx requires renewed interpretation of his relation to Hegel — and thus useful for establishing the contemporary state of the field. POSITION: Represents the "Marx/Hegel revival" framing that groups much of the post-2010 literature surveyed in this domain.},
    keywords = "marx-revival, Hegel-Marx-relation, edited-volume, Medium, METADATA\_CLEANED: publisher, doi, type:@book->@misc",
    abstract = "The relation between Hegel and Marx is among the most interpreted in the history of philosophy. Given the contemporary renaissance of Marx and Marxist theories, how should we re-read the Hegel-Marx connection today? What place does Hegel have in contemporary critical thinking? Most schools of Marxism regard Marx's inversion of Hegel's dialectics as a progressive development, leaving behind Hegel's idealism by transforming it into a materialist critique of political economy. Other Marxist approaches argue that the mature Marx completely broke with Hegel. By contrast, this book offers a wide-ranging and innovative understanding of Hegel as an empirically informed theorist of the social, political, and economic world. It proposes a movement 'from Marx to Hegel and back', by exploring the intersections where the two thinkers can be read as mutually complementing or even reinforcing one another. With a particular focus on essential concepts like recognition, love, revolution, freedom, and the idea",
    abstract_source = "openalex"
}

@book{musto2020marx,
    editor = "Musto, Marcello",
    title = "The Marx Revival: Key Concepts and New Critical Interpretations",
    year = "2020",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Musto assembles specialists to reassess twenty-two key Marxian concepts in light of what Marx actually wrote (as established by the ongoing MEGA2 edition and renewed attention to previously neglected manuscripts), the respects in which these concepts require updating, and their continued relevance to contemporary capitalism. RELEVANCE: A landmark programmatic statement of the "new critical interpretation" approach this domain tracks — concept-by-concept reassessment grounded in MEGA2-informed philology rather than in inherited twentieth-century orthodoxies, including contributions bearing directly on ecology and non-Western societies. POSITION: Institutionalizes the post-2010 "Marx revival" as a distinct interpretive moment, self-consciously informed by MEGA2 and the New Reading literature.},
    keywords = "marx-revival, MEGA2-philology, edited-volume, High, METADATA\_CLEANED: doi",
    abstract = {The planet is in deep trouble because of capitalism, and Karl Marx, freed from the chains of "real socialism", is being rediscovered all around the world as the thinker who provided us with its most insightful critique. The Marx Revival is the best, most complete and most modern guide to Marx's ideas that has appeared since the fall of the Berlin Wall. Written by highly reputed international experts, in a clear form accessible to a wider public, it brings together the liveliest and most thought-provoking contemporary interpretations of Marx's work. It presents what he actually wrote in respect of 22 key concepts, the areas that require updating as a result of changes since the late-nineteenth century, and the reasons why it is still of such relevance in today's world. The result is a collection that will prove indispensable both for specialists and for a new generation approaching Marx's work for the first time.},
    abstract_source = "openalex"
}

@article{lietzschwarz2023value,
    author = "Lietz, Barbara and Schwarz, Winfried",
    title = "Value, Exchange, and Heinrich's `New Reading of Marx': Remarks on Marx's Value-Theory, 1867--72",
    journal = "Historical Materialism",
    year = "2023",
    note = {CORE ARGUMENT: Lietz and Schwarz examine Michael Heinrich's "New Reading" value-theoretic interpretation against the successive editions and revisions of "Capital" Volume 1 between 1867 and 1872, querying whether Heinrich's monetary, non-substantialist reconstruction of Marx's value theory is textually supported by Marx's own revisions during this period. RELEVANCE: A direct, textually detailed engagement with the specific claims of the German New Reading of Marx as transmitted through Heinrich, addressing this domain's second key question about what the value-form-theoretic Heinrich school actually argues and how well its claims withstand close textual scrutiny. POSITION: Critical internal engagement with Heinrich's New Reading value-form interpretation, from within the value-theory debate rather than from the systematic-dialectics tradition.},
    keywords = "New-Reading-of-Marx, Heinrich, value-form, High, METADATA\_CLEANED: pages, doi",
    abstract = "The exclusive emergence of value and abstract human labour through exchange of mere products is a fundamental principle within the 'New Reading of Marx', especially that of Michael Heinrich. He invokes both Capital and the manuscript Additions and Changes, where Marx revised his value-form analysis for the second edition of Capital. However, this manuscript does not support Heinrich's view. In the same handwritten manuscript, Marx drafted the subsection on the fetishism of the commodity with two passages that Heinrich claims as evidence for his interpretation. Against this, we elaborate Marx's understanding of abstract human labour as the specific social character of private labour; it does not result from exchange but rather is its prerequisite. Heinrich's attempt fails to include demand in the magnitude of value. Finally, he does not explain the value-formation by circulation and production. Rather, his one-sided view of exchange means, by way of its logical implications, that the capitalist production process is no longer the unity of the labour process and the valorisation process, but mere production of use-values.",
    abstract_source = "openalex"
}

@misc{bonefeld2020capital,
    author = "Bonefeld, Werner",
    title = "Capital Par Excellence: On Money as an Obscure Thing",
    year = "2020",
    pages = "33--56",
    note = {CORE ARGUMENT: Bonefeld, a leading figure associated with "Open Marxism" and closely aligned with the Neue Marx-Lektüre's value-form emphasis, analyzes money in Marx's Capital as the "obscure" and mystified appearance-form of the value-relation, arguing that Marx's critique of political economy must be read as a critique of the reified, fetishized forms capitalist social relations assume rather than as a positive economic theory. RELEVANCE: Represents the Anglophone "Open Marxism" strand closely allied with the German New Reading of Marx, illustrating how value-form/money-form analysis is deployed as a distinctively non-systematic-dialectical mode of Hegelian-inflected critique. POSITION: Open Marxism / value-form critique, adjacent to but distinct from the Backhaus- Reichelt-Heinrich lineage narrowly construed.},
    keywords = "New-Reading-of-Marx, Open-Marxism, value-form, money-fetishism, Medium, METADATA\_CLEANED: journal, number, doi, type:@article->@misc",
    abstract = "Against the background of the contemporary debate about financialisation, the paper conceptualises the capitalist labour economy as fundamentally a monetary system. It argues that money is not a capitalist means of organising its labour economy but that it is rather a capitalist end. The argument examines and finds wanting conceptions of money in political economy, including Keynesianism and neoliberalism, and argues that the debate about financialisation is fundamentally based on the propositions of political economy. It holds that Marx's critique of political economy conceives of money as the form of value and expounds money-making as the purpose of the capital labour economy. Thus, the labour theory of value is fundamentally a monetary theory of value, labour is the means of valorisation, and that is, of money in process, and as such capital. Making money out of money is capital as its most rational. In the form of credit, money posits wealth as a claim on future surplus value.",
    abstract_source = "openalex"
}

@article{ng2015ideology,
    author = "Ng, Karen",
    title = "Ideology Critique from Hegel and Marx to Critical Theory",
    journal = "Constellations",
    year = "2015",
    volume = "22",
    number = "3",
    pages = "393--404",
    doi = "10.1111/1467-8675.12170",
    note = "CORE ARGUMENT: Ng traces the concept of ideology critique from its roots in Hegel's account of self-consciousness and contradiction through Marx's transformation of it into a critique of material social forms, arguing that later critical theory's ideology critique remains indebted to structural features first articulated by Hegel and reworked by Marx. RELEVANCE: Offers a recent (2015) reassessment of exactly which formal-methodological resources Marx inherited from Hegel in developing ideology critique, situating this inheritance within the trajectory that runs into Frankfurt School critical theory — useful for tracing continuities the New Reading literature treats mainly at the level of value-form. POSITION: Critical-theoretic reconstruction of the Hegel-Marx methodological inheritance, emphasizing continuity through the concept of immanent critique.",
    keywords = "ideology-critique, critical-theory, Hegel-Marx-relation, Medium, INCOMPLETE, no-abstract"
}

@article{moseley2025introduction,
    author = "Moseley, Fred",
    title = "Introduction to Marx's Theory of Value in Chapter 1 of Capital: A Critique of Heinrich's Value-Form Interpretation",
    journal = "World Review of Political Economy",
    year = "2025",
    volume = "16",
    number = "4",
    note = {CORE ARGUMENT: Summarizing his book-length study, Moseley argues on close textual grounds that Chapter 1 of Capital Volume 1 analyzes a "representative commodity" whose value is derived from the exchange-value relations among all commodities in normal proportions, and contends this textual reading directly contradicts Heinrich's monetary value-form interpretation as presented in Heinrich's "How to Read Marx's Capital" (2021). RELEVANCE: A sustained, recent, chapter-and-verse critique of Heinrich's New Reading interpretation of Marx's opening value-theoretic categories, giving the literature review a clear statement of the internal Marxological dispute the New Reading has generated. POSITION: Traditional (substantialist, labor-time) reading of Marx's value theory, explicitly opposed to the New Reading of Marx's monetary/value-form interpretation.},
    keywords = "New-Reading-of-Marx, Heinrich, value-form, critique, High, METADATA\_CLEANED: doi",
    abstract = "This article is an introduction to my recent book Marx's Theory of Value in Chapter 1 of Capital: A Critique of Heinrich's Value-Form Interpretation. My book is a detailed textual study of Chapter 1 of Volume 1 of Capital and of Michael Heinrich's value-form interpretation of Chapter 1, as presented in his 2021 book How to Read Marx's Capital. This article focuses on the following two main conclusions of my book in order to give the reader an idea of the close textual analysis of my book: (1) The subject of analysis of Chapter 1 is a representative commodity, which Marx used to analyze the properties that each commodity shares in common with all other commodities (especially its exchange-value). (2) The value of commodities is derived from an analysis of the exchange-value of the representative commodity, which is its equality with all other commodities in normal proportions that are mutually consistent.",
    abstract_source = "s2"
}

@article{liu2023form,
    author = "Liu, Xiaoxia",
    title = "Form of Manifestation of Value: Heinrich's Monetary Theory of Value -- A Review of the Philosophical Methodology Based on Marx's Labour Theory of Value",
    journal = "Critique",
    year = "2023",
    volume = "51",
    note = {CORE ARGUMENT: Liu argues that Marx's method proceeds from abstraction to the concrete via intermediate determinations, and contends that Heinrich's "monetary theory of value" — which replaces the labor theory of value with an emphasis on money as a social necessity — reflects an inadequate, merely formal grasp of Marx's dialectical methodology that fixates on value's form of manifestation at the expense of its substance. RELEVANCE: A further sustained critique of Heinrich's New Reading interpretation, this time explicitly framed as a dispute over Marx's inheritance of Hegelian dialectical method (abstract-to-concrete movement) rather than only over value-theoretic content, bearing directly on the domain's second key question. POSITION: Defends a "dialectical," labor-theoretic reading of Marx's value theory against the New Reading's monetary/value-form reinterpretation.},
    keywords = "New-Reading-of-Marx, Heinrich, dialectical-method, critique, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "Marx's scientific labour theory of value is fundamentally inseparable from his philosophical method of advancing from the thinking abstract to the thinking concrete. He employs the power of abstraction to reveal the essential determination of value, and then to accomplish a generalisation of the commonness of all commodity-money relations. Through the intermediate links, Marx advances from the abstract to the concrete, grasping the historical individuality and form of manifestation of value in the specific capitalist phase. Heinrich is acutely aware of the methodological revolution achieved by Marx in his treatment of value theory, and, therefore, advocates examining the value theory from the philosophical methodological perspective. However, in his view, it is the emphasis on the form of value that is Marx's fundamental critique to the political economy, with money as a necessity in the capitalist society. Consequently, he proposes the term 'monetary theory of value' to replace Marx's labour theory of value. Heinrich, who lacks the scientific power of abstraction, directly focuses on the concrete phase of capitalism and, thus, merely attaches great importance to the external form of manifestation of value. The underlying cause of his deficiency is the philosophical methodology he adheres to, i.e. the formal dialectics.",
    abstract_source = "openalex"
}

@article{schimmenti2024marxs,
    author = "Schimmenti, Gabriele",
    title = "Marx's Dissertation in Light of the Value-Form",
    journal = "Historical Materialism",
    year = "2024",
    note = {CORE ARGUMENT: Schimmenti reads Marx's 1841 doctoral dissertation on Epicurean and Democritean natural philosophy through the categories of Hegelian logic later deployed in the value-form analysis of Capital, arguing that the dissertation already displays a documented first confrontation with Hegel's method (specifically Darstellung) rather than, as Althusser claimed, a merely "scholastic exercise." RELEVANCE: Extends value-form-theoretic reading (a hallmark of New Reading scholarship) backward onto Marx's earliest philosophical writing, offering a genuinely recent (2024) reassessment of when and how Marx's engagement with Hegel's logical method began. POSITION: Value-form-theoretic continuity thesis — Marx's mature dialectical method has roots traceable to his dissertation-era engagement with Hegel's logic.},
    keywords = "value-form, dissertation, Hegel-logic, Darstellung, High, METADATA\_CLEANED: doi",
    abstract = "My article investigates Marx's dissertation from the perspective of the categories of Hegelian logic employed in the writings on the critique of political economy and, in particular, in the analysis of the value-form (Wertform) in Capital. The aim of my contribution is to show how Marx's early writing is not intended as a mere 'exercice encore scolaire' (Althusser), but as the first documented confrontation with Hegel's logic. Marx's early writing displays a moment of elaboration and acquisition of Hegel's method. I argue that the Epicurean atom represents a developing contradiction, and that the dissertation follows a precise Darstellung, which extends from the metaphysical and physical principle to the abstract subjectivity of Epicurean atomism.",
    abstract_source = "openalex"
}

@misc{ricci2024specter,
    author = "Ricci, Andrea",
    title = "The Specter of Value: The Beginning of Marx's Capital and Hegel's Logic of Being",
    year = "2024",
    note = {CORE ARGUMENT: Ricci argues that Marx's derivation of the value-form from the isolated commodity in the opening of Capital directly draws on Hegel's Logic of Being, producing a "materialist inversion" in which value becomes a spectral, fetishized real abstraction that unconsciously governs capitalist social praxis; the article traces this abstraction's historical genesis to the dispossession analyzed in the chapters on primitive accumulation. RELEVANCE: A recent, textually precise account of exactly how Hegel's Logic of Being structures the opening categories of Capital, and one of the few recent pieces to connect this properly logical reading to the history of dispossession (colonialism, the commons) that opens onto the domain's interest in global/postcolonial angles. POSITION: Systematic reading of Capital's opening as structured by Hegel's Logic of Being, combined with attention to value's real-historical (colonial, dispossessive) genesis.},
    keywords = "Hegel-Logic-of-Being, value-form, primitive-accumulation, Medium, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "The beginning of Marx's Capital has references to Hegel's Logic of Being. From the individual commodity considered in isolation, Marx derives the value form as the germ cell of capitalist society. Marx's materialist inversion of the Hegelian dialectic posits the value form as a spectral objectivity that constitutes the real abstraction specific to capitalism. As the most abstract expression of capital, it rules unconsciously the totality of social praxis as an absolute fetish. Value arises from a double mystification: the reification of capitalist social relations of production in an objective abstract form, and its representation in concrete objects, as commodities and money in circulation. Value, as the real abstraction of capitalist social relations of production, is the disjunctive synthesis between the despotic command of capital in production and the reciprocity of exchange in circulation. In the final chapter on primitive accumulation, Marx identifies its historical genesis in the dispossession of the commons, which, by separating the subjective from the objective conditions of production, gives rise to the capital-wage labour relation.",
    abstract_source = "s2"
}

@misc{ramassanmiguel2024concepto,
    author = "Ramas San Miguel, Clara",
    title = "El concepto de apariencia en la cr{\'i}tica de la econom{\'i}a pol{\'i}tica de Marx y la doctrina de la esencia de Hegel",
    year = "2024",
    volume = "49",
    note = {CORE ARGUMENT: Ramas San Miguel argues that Marx's critique of political economy relies on a concept of "appearance" (Erscheinung) whose logical structure is derived from Hegel's Doctrine of Essence in the Science of Logic, and that this borrowing is essential to understanding how Marx can treat categories such as price or wages as both real and systematically misleading "forms of appearance" of underlying value-relations. RELEVANCE: A recent, focused textual study of a specific Hegelian logical resource (the Essence-Appearance distinction) underlying Marx's critique of political economy, extending the domain's coverage of which parts of Hegel's Logic (beyond the Logic of Being) recent scholarship locates within Marx's mature method. POSITION: Close textual reconstruction of Marx's debt to Hegel's Doctrine of Essence, situated within recent Spanish-language Marx-Hegel scholarship.},
    keywords = "Hegel-Doctrine-of-Essence, appearance, value-form, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {El presente art{\'i}culo relaciona el concepto de apariencia en la cr{\'i}tica de la econom{\'i}a pol{\'i}tica de Marx con "La doctrina de la esencia" de la Ciencia de la l{\'o}gica de Hegel. Tras presentar algunas cuestiones de m{\'e}todo y el proyecto de Marx desde las categor{\'i}as de fetichismo y mistificaci{\'o}n como formas de apariencia, se realiza la lectura de la cr{\'i}tica de la econom{\'i}a pol{\'i}tica de Marx desde las tres secciones de la Wesenslogik: apariencia, aparici{\'o}n y realidad efectiva. La sociedad moderna aparecer{\'a} como una totalidad que produce su representaci{\'o}n invertida, aprehendida en sucesivas determinaciones cada vez m{\'a}s concretas, desde la esfera de circulaci{\'o}n, el valor, el dinero y el capital hasta las formas derivadas de plusvalor y el sistema de apariencia en la F{\'o}rmula Trinitaria. Por {\'u}ltimo, se plantean algunas cuestiones sobre cr{\'i}tica y sistema.},
    abstract_source = "s2"
}

@article{saito2020marxs,
    author = "Saito, Kohei",
    title = "Marx's Theory of Metabolism in the Age of Global Ecological Crisis",
    journal = "Historical Materialism",
    year = "2020",
    volume = "28",
    note = {CORE ARGUMENT: Saito distinguishes three levels at which Marx's concept of "metabolic rift" operates (universal, social, and historically specific to capitalism) and argues that reconstructing these levels, on the basis of Marx's late natural-scientific notebooks (made accessible through MEGA2), provides the theoretical foundation for an ecological reading of Marx's critique of political economy and postcapitalist theory. RELEVANCE: The central statement of the ecological reassessment of Marx this domain tracks, explicitly grounded in MEGA2 access to Marx's unpublished natural-science notebooks and directly responsive to the domain's third key question about new (here, ecological) angles on Marx's thought. POSITION: Ecological (metabolic-rift) reading of Marx, grounded in MEGA2-based recovery of Marx's late notebooks rather than in the published texts alone.},
    keywords = "ecology, metabolic-rift, MEGA2-philology, Saito, High, METADATA\_CLEANED: number, pages, doi",
    abstract = "When the existing order cannot offer a solution, the solution to climate crisis must come from the radical left, and this is precisely why Karl Marx's idea of ecosocialism is more important than ever. In this context, it is worth revisiting not only the legacy of Istv{\'a}n M{\'e}sz{\'a}ros's theory of 'social metabolism' and that of his successors -- who can be categorised as comprising the 'metabolic rift school', which includes John Bellamy Foster, Paul Burkett, and Brett Clark --, but also Karl Marx's own theory of metabolism. In order to highlight the contemporary importance of Marx's theory of metabolism after its long suppression in the twentieth century, this paper aims at classifying the three different levels of Marx's concept of 'metabolic rift', which also entails clarifying three different levels of 'metabolic shift' as the theoretical foundation for updating Marx's theory of postcapitalism in the age of global ecological crisis.",
    abstract_source = "s2"
}

@misc{musto2025marx,
    author = "Musto, Marcello",
    title = "Marx on the Centrality of the Peripheries for the Global Revolution",
    year = "2025",
    note = "CORE ARGUMENT: Musto examines the final, least-studied phase of Marx's intellectual development — his late writings and notebooks on non-Western societies, including the correspondence on the Russian commune and critiques of European colonialism — arguing this material challenges the enduring characterization of Marx as a Eurocentric, economically determinist thinker and instead shows him emphasizing the specificity of historical conditions and human agency over any unilinear developmental scheme. RELEVANCE: A direct, recent statement of the global/postcolonial reassessment of Marx this domain tracks, based on Marx's late manuscripts and notebooks whose full scholarly accessibility depends substantially on MEGA2, and answering the domain's third key question about non-Western and global angles. POSITION: Anti-Eurocentric, anti-determinist reading of the late Marx, emphasizing historical specificity and the political centrality of peripheral/non-Western societies.",
    keywords = "global-Marx, postcolonial, non-Western-societies, Musto, High, METADATA\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "This text presents an examination of Karl Marx's final and mostly unexplored phase of intellectual development and suggests a reassessment of some of his key ideas. It challenges the long-lasting misrepresentation of Marx as a Eurocentric and economistic thinker. It reconsiders Marx's ideas in light of his late remarks on non-Western societies and the critique of European colonialism and shows how Marx avoided economic determinism unlike many of his followers. The article shows that Marx highlighted the specificity of historical conditions and the centrality of human intervention in the shaping of reality and the achievement of revolution and change.",
    abstract_source = "openalex"
}

@misc{zambrana2025philosophy,
    author = "Zambrana, Roc{\'i}o",
    title = "Philosophy in the Severe Style: Method and Value in Rose's Hegel and Marx",
    year = "2025",
    note = {CORE ARGUMENT: Responding to Gillian Rose's claim in "Hegel Contra Sociology" that Marx and Marxism retreat from Hegel's "severe style" of speculative thinking into a distinction between thought and actuality that forecloses a proper account of capital, Zambrana argues that Marx in fact pursues speculative thinking in his account of capital's self-valorizing logic, and that Stephanie Smallwood's history of the Atlantic slave trade is decisive for extending this speculative account beyond free wage-labor to the historical genesis of the capital-relation and the money-form itself in the trade in enslaved persons. RELEVANCE: One of very few recent pieces to bring the Marx-Hegel "speculative method" debate into direct contact with the history of racial slavery and racial capitalism, addressing the domain's interest in new (here, racial/historical) angles on the relationship beyond value-form technicalities. POSITION: Defends Marx's speculative-dialectical debt to Hegel against Rose's charge of retreat, while extending its scope via Smallwood to the racialized genesis of capital.},
    keywords = "Gillian-Rose, speculative-method, racial-capitalism, Zambrana, Medium, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc",
    abstract = {In Hegel Contra Sociology, Gillian Rose argues that Hegel's political theory is written in the "severe style," marking speculative thinking as the appropriate mode of exposition of capitalist modernity. By taking distance from Hegel, she maintains, Marx and Marxism retain a distinction between thought and actuality that forecloses a proper account of capital. I argue that Marx pursues speculative thinking when accounting for capital's logic of self-valorization. Speculative thinking in Rose's sense allows us to move beyond production, linking self-valorization to the historical coming to be of capital. Stephanie Smallwood's work is decisive, moving beyond the commodification of labor power for the extraction of surplus value in free labor, tracing the genesis of the capital relation and the money-form itself to the circulation of African people as commodities in the trade. This is not the prehistory of capital, a primitive accumulation, but the totality of conditions that articulate capital's movement.},
    abstract_source = "s2"
}

@article{ninos2024hegels,
    author = "Ninos, Giannis",
    title = "Hegel's Theory of Finite Cognition and Marx's Critique of Political Economy",
    journal = "Hegel Bulletin",
    year = "2024",
    volume = "46",
    pages = "489--514",
    doi = "10.1017/hgl.2024.22",
    note = "CORE ARGUMENT: Ninos argues that Hegel's distinction between analytic and synthetic finite cognition in the Science of Logic provides the methodological framework Marx uses, chiefly in the Grundrisse, to periodize the development of classical political economy, and that Marx's immanent critique of Ricardo's method specifically targets the limitations of synthetic cognition as Hegel diagnosed them. RELEVANCE: Identifies and develops what the article itself frames as an underexplored Hegelian resource (finite cognition) shaping Marx's methodological self-understanding in the Grundrisse, illustrating the kind of granular, textually specific reassessment recent Hegel-Marx scholarship has pursued beyond the systematic-dialectics and New Reading debates. POSITION: Close methodological reconstruction locating a specific, previously underexamined Hegelian logical resource within Marx's critique of political economy.",
    keywords = "Hegel-Logic, finite-cognition, Grundrisse, Ricardo-critique, Medium",
    abstract = "The article examines the role of Hegel's theory of finite cognition in Marx's critique of classical political economy. I argue that Hegel's distinction of finite cognition between analytic and synthetic in the Science of Logic constitutes the methodological framework through which Marx delineates the different stages of the development of political economy. Focusing on the Grundrisse, I reveal the Hegelian influence behind Marx's statements on previous political economists' methods. Thus, Marx's immanent critique of the classical political economy is construed as undertaken from the level of the systematic dialectical method of Capital, and is modelled on Hegel's immanent critique of analytic and synthetic cognition from the perspective of absolute cognition. In this context, and focusing on Marx's critique of Ricardo's method, I argue that the latter's limitations are associated with the deficiencies of synthetic cognition as presented by Hegel. Therefore, the article sheds light on an important yet underexplored topic of the Hegel-Marx relationship. By indicating the centrality of Hegel's theory of finite cognition in Marx's methodological underpinnings, the article provides a new perspective on Hegel-Marx scholarship.",
    abstract_source = "s2"
}

