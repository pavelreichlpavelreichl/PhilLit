@book{marx1970critique,
    author = "Marx, Karl",
    editor = "O'Malley, Joseph",
    title = "Critique of Hegel's `Philosophy of Right'",
    year = "1970",
    publisher = "Cambridge University Press",
    address = "Cambridge, England",
    note = {CORE ARGUMENT: Marx's unfinished 1843 manuscript, a paragraph-by-paragraph commentary on paragraphs 261--313 of Hegel's Philosophy of Right, argues that Hegel systematically inverts the real relation between the state and civil society: where Hegel derives the family and civil society as moments generated by the self-development of the rational state (the Idea), Marx insists the state is in fact a product of, and dependent upon, actually existing social and material relations. Marx charges Hegel with "logical, pantheistic mysticism" -- treating empirical institutions as predicates of an abstract logical Subject (the Idea) rather than treating the Idea as an abstraction from real, empirical subjects. RELEVANCE: This is the primary text on which nearly every close-reading paper in this domain (Fine, O'Malley, Mikkelsen, Barbour, Flohr) directly comments; it is the textual point of origin for the "materialist inversion" formula that recurs, transformed, in the 1873 afterword thirty years later. POSITION: Primary source; O'Malley's is the standard scholarly English edition, containing his own introductory essay on the text's composition and reception.},
    keywords = "primary-source, 1843-critique, philosophy-of-right, materialist-inversion, High, INCOMPLETE"
}

@book{avineri1968social,
    author = "Avineri, Shlomo",
    title = "The Social and Political Thought of Karl Marx",
    year = "1968",
    publisher = "Cambridge University Press",
    doi = "10.1017/CBO9781139171410",
    note = {CORE ARGUMENT: Avineri reconstructs Marx's political thought as continuous with and growing directly out of Hegelian categories rather than as their simple negation, arguing that Marx's account of civil society, alienation, and the state retains a Hegelian dialectical structure even as its content (private property, class) is inverted. Avineri traces this Hegelian inheritance from the 1843 Critique through Capital, treating the 1843 manuscript as the decisive moment at which Marx begins to historicize Hegel's categories. RELEVANCE: Supplies the chronological and conceptual scaffolding -- what Marx read, when, and in what order -- against which more narrowly textual papers in this domain (e.g., Mikkelsen, Flohr) can be situated; its "Hegelian origins" thesis is a direct counterweight to readings (Rosenthal, Campbell) that stress Marx's escape from Hegel. POSITION: Continuity thesis -- Marx's mature categories are transformed Hegelian categories, not a wholesale rejection of dialectical form.},
    keywords = "hegelian-origins, intellectual-biography, continuity-thesis, High",
    abstract = "Ever since the discovery of Marx's Early Writings, most of the literature concerned with Marx's intellectual development has centred around the so-called gap between the 'young' Marx, who was considered to be a humanist thinker, and the 'older' Marx, who was held to be a determinist with little concern for anything outside his narrow theory of historical materialism. Dr Avineri claims that such a gap between the 'young' and 'older' Marx did not exist. He supports his claim by a detailed study of the whole corpus of Marx's writing on social and political thought.",
    abstract_source = "openalex"
}

@misc{mclellan1970before,
