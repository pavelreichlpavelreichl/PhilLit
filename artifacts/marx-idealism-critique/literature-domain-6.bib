@book{hegel1975lectures,
    author = "Hegel, Georg Wilhelm Friedrich and Forbes, Duncan",
    title = "Lectures on the Philosophy of World History",
    year = "1975",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Hegel's introductory lectures argue that world history is the rational, necessary unfolding of Spirit's self-realization as freedom, proceeding through successive epochs (Oriental despotism, Greco-Roman citizenship, the Germanic-Christian world) in which an ever-larger portion of humanity becomes recognized as free. Reason "rules the world" and history is therefore intelligible as a single providential process, apprehended retrospectively by philosophy (the "cunning of reason" whereby individual passions and interests serve ends they do not themselves intend). RELEVANCE: This is the primary Hegelian text against which Marx's materialist conception of history is standardly read as a polemical inversion; it establishes the precise content (directionality, necessity, epochal succession, providential rationality) that later debates ask whether Marx retains, rejects, or unwittingly reproduces in materialist form. POSITION: Paradigm statement of providential, teleological idealist philosophy of history.},
    keywords = "Hegel, philosophy-of-history, teleology, cunning-of-reason, High, primary-source, METADATA\_CLEANED: doi",
    abstract = "An English translation of Hegel's introduction to his lectures on the philosophy of history, based directly on the standard German edition by Johannes Hoffmeister, first published in 1955. The previous English translation, by J. Sibree, first appeared in 1857 and was based on the defective German edition of Karl Hegel, to which Hoffmeister's edition added a large amount of new material previously unknown to English readers, derived from earlier editors. In the introduction to his lectures, Hegel lays down the principles and aims which underlie his philosophy of history, and provides an outline of the philosophy of history itself. The comprehensive and voluminous survey of world history which followed the introduction in the original lectures is of less interest to students of Hegel's thought than the introduction, and is therefore not included in this volume.",
    abstract_source = "openalex"
}

@book{popper2012opensociety,
    author = "Popper, Karl",
    title = "The Open Society and Its Enemies",
    year = "2012",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Popper's second volume (originally subtitled "The High Tide of Prophecy: Hegel, Marx, and the Aftermath") argues that Hegel's dialectical philosophy of history and Marx's materialist theory of history share a common "historicist" logical structure: both claim to have discovered inexorable laws governing the overall direction of history, and both use this claim to justify totalitarian political conclusions. Popper treats Marx's productive-forces determinism as a materialist transposition of Hegel's Spirit rather than a genuine break with idealist historicism. RELEVANCE: This is the foundational statement of the "Marx as covert Hegelian" charge that organizes much of the later analytic literature in this domain (Suchting, Hudelson, Honderich); it directly poses the question the project's title addresses — whether Marx's materialist history is a genuine alternative to, or merely an inversion of, idealist teleology. POSITION: Anti-historicist critique treating Hegel and Marx as a single target.},
    keywords = "Popper, historicism, Hegel, Marx, teleology, critique, High, primary-source, METADATA\_CLEANED: doi",
    abstract = "Written in political exile in New Zealand during the Second World War and published in two volumes in 1945, The Open Society and its Enemies was hailed by Bertrand Russell as a 'vigorous and profound defence of democracy'. This legendary attack on the philosophies of Plato, Hegel and Marx prophesied the collapse of communism in Eastern Europe and exposed the fatal flaws of socially engineered political systems. It remains highly readable, erudite and lucid and as essential reading today as on publication in 1945. It is available here in a special centenary single-volume edition.",
    abstract_source = "openalex"
}

@book{popper2013poverty,
    author = "Popper, Karl",
    title = "The Poverty of Historicism",
    year = "2013",
    publisher = "Routledge",
    note = {CORE ARGUMENT: Popper defines "historicism" as the doctrine that history is governed by discoverable laws which permit prediction of its overall course, and argues this doctrine is both methodologically confused (it mistakes historical trends for laws) and politically dangerous. Although aimed at a general target, the argument is explicitly framed to indict both Hegelian and Marxist philosophies of history as instances of the same error. RELEVANCE: Supplies the methodological core of Popper's critique that Suchting and Hudelson (below) contest point by point; central to assessing whether "determinism" in historical materialism is the same kind of claim as Hegel's providential necessity. POSITION: General methodological indictment of teleological/law-governed philosophies of history, targeting Hegel and Marx jointly.},
    keywords = "Popper, historicism, determinism, methodology, High, primary-source, INCOMPLETE, no-abstract, METADATA\_CLEANED: doi"
}

@misc{cohen2000karlmarx,
    author = "Cohen, G. A.",
    title = "Karl Marx's Theory of History: A Defence",
    year = "2000",
    edition = "Expanded",
    address = "Oxford",
    note = {CORE ARGUMENT: Cohen reconstructs historical materialism as resting on a "development thesis" (the productive forces tend to develop through history) and a "primacy thesis" (relations of production are explained by their function in developing the productive forces, not vice versa), defended via functional explanation: a set of relations of production obtains because it is suited to developing the forces of production, on the model of functional explanation in evolutionary biology. RELEVANCE: The central text of this domain's largest debate cluster. Cohen's functional reconstruction is precisely the point at which critics allege that historical materialism reintroduces a covert, quasi-Hegelian teleology (productive forces "needing" to develop) that Marx's own texts do not warrant; virtually every other secondary source in this file responds to, defends, or revises this book. POSITION: Technological-determinist, functionalist reconstruction of historical materialism.},
    keywords = "Cohen, historical-materialism, functional-explanation, determinism, base-superstructure, High, primary-source, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{wrightlevinesober1992reconstructing,
    author = "Wright, Erik Olin and Levine, Andrew and Sober, Elliott",
    title = "Reconstructing Marxism: Essays on Explanation and the Theory of History",
    year = "1992",
    address = "London/New York",
    note = {CORE ARGUMENT: Against Cohen's functionalist and technological-determinist reading, the authors defend a more pluralistic, "rational choice Marxist" reconstruction of historical materialism that abandons strong claims about the primacy and autonomous development of productive forces in favor of piecemeal causal and intentional explanations grounded in class conflict and the choices of situated agents. RELEVANCE: Represents the principal analytic-Marxist alternative to Cohen's teleology-adjacent functionalism; central to the structure/ agency question in the domain brief, since it relocates historical explanation from impersonal developmental tendencies to agents' reasons and struggles. POSITION: Rational-choice/methodological-individualist reconstruction of historical materialism, opposed to functionalist determinism.},
    keywords = "Wright, Levine, Sober, rational-choice-Marxism, structure-agency, functional-explanation, High, primary-source, INCOMPLETE, no-abstract, METADATA\_CLEANED: publisher, type:@book->@misc"
}

@misc{little1994review,
    author = "Little, Daniel",
    title = "Reconstructing Marxism: Essays on Explanation and the Theory of History",
    year = "1994",
    number = "1",
    note = "CORE ARGUMENT: A critical review of Wright, Levine, and Sober's Reconstructing Marxism, assessing how successfully the rational-choice reconstruction of historical materialism replaces Cohen's functionalist and technological-determinist framework while still preserving explanatorily useful generalizations about class and historical change. RELEVANCE: Provides an independent scholarly assessment of the structure/agency alternative to Cohen represented by Wright, Levine, and Sober, useful for gauging how the analytic-Marxist field received the rational-choice reconstruction. POSITION: Sympathetic-critical assessment of rational-choice Marxism as an alternative to functionalist historical materialism.",
    keywords = "review, rational-choice-Marxism, structure-agency, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@article{parkinson1989hegel,
    author = "Parkinson, G. H. R.",
    title = "Hegel, Marx and the Cunning of Reason",
    journal = "Philosophy",
    year = "1989",
    note = {CORE ARGUMENT: Parkinson examines Hegel's doctrine of the "cunning of reason" — whereby world-historical individuals unwittingly serve Spirit's rational ends through the pursuit of their own passions and interests — and traces the extent to which an analogous structure survives in Marx's account of how individuals acting from private, material motives nonetheless bring about historically necessary transformations of the mode of production. RELEVANCE: Directly addresses the domain's central question of what Marx rejects versus retains from Hegel's teleological philosophy of history; a key resource for distinguishing "directionality without Spirit" from full-blown providential teleology. POSITION: Comparative analysis arguing for significant structural continuity between Hegel's cunning of reason and Marx's account of unintended historical outcomes.},
    keywords = "Hegel, Marx, cunning-of-reason, teleology, High, METADATA\_CLEANED: volume, number, pages, doi",
    abstract = "This paper is concerned with two theories of history—those of Hegel and of Marx. Its primary aim is to clarify. The writings of Hegel are notoriously obscure, and those of Marx have been variously interpreted, so there is room for a paper which tries to ensure that when the theories of history propounded by Marx and Hegel are criticized, what are criticized are views which they actually held. It is no part of this paper's thesis that, in his theory of history, Marx consciously borrowed from Hegel. But it will be argued that there is more of Hegel in Marx than is sometimes supposed, and that if this fact is ignored one seriously distorts Marx.",
    abstract_source = "openalex"
}

@article{yangyeomans2023taking,
    author = "Yang, Chen and Yeomans, Christopher",
    title = "Taking the Teleology of History Seriously: Lessons from Hegel's Logic",
    journal = "Hegel Bulletin",
    year = "2023",
    volume = "44",
    number = "1",
    note = {CORE ARGUMENT: The authors argue that Hegel's teleological conception of history should be understood via the account of teleology developed in the Science of Logic — as a structure of self-determining, internally purposive development — rather than as external, providence-imposed design, and that this logical grounding clarifies what is philosophically distinctive (and defensible) about Hegel's claim that history has a rational direction. RELEVANCE: Offers a contemporary, technically precise account of what "teleology" means in Hegel's philosophy of history, providing the conceptual baseline against which the charge that historical materialism is "covertly teleological" can be evaluated with more precision than the looser sense of teleology used in the Popperian critique. POSITION: Reconstructive defense of Hegelian historical teleology grounded in the logic of self-determining purposiveness.},
    keywords = "Hegel, teleology, philosophy-of-history, logic, High, METADATA\_CLEANED: pages, doi",
    abstract = "Abstract To oversimplify quite a bit, scholars' presentation of Hegel's teleology constitutes a continuum according to how more-or-less secured the progress towards the goal is supposed to be, which tracks roughly the nature of the end and its necessity. In this article, rather than focus on the end and progress towards it, we will focus on the means and structure of teleological relationships on Hegel's account. This focus follows from an essential feature of Hegel's discussion of teleology in the Logic, in which teleology is introduced to solve a problem in the individuation of entities. It will turn out that the fullest actualization of the end is in the durable means, which is also thereby individuated. And it will turn out that the paradigmatic historical means—the state—is tensed, as it were, between the end and its realization that makes it synchronically historical. This synchronic historicity is missing in the usual progressive and thus diachronic accounts of the teleological process of history. But first we step back even farther (at least historically). We begin by taking up the two most important philosophical accounts of teleology for Hegel, namely those of Aristotle and Kant. Then we go to Hegel's Logic for his reconstruction of teleological processes against the background of the explanatory need for individuation. We focus on four aspects of Hegel's account: that teleology is a structure of reciprocal interaction, that the purpose is an immanent governing principle, that change is the price of immanence, and that the durable means is the teleological object par excellence. Finally, we trace these features through Hegel's account of world history and conclude with some brief remarks on the historicity of the state described in the Philosophy of Right.",
    abstract_source = "openalex"
}

@misc{wood1986historical,
    author = "Wood, Allen W.",
    title = "Historical materialism and functional explanation",
    year = "1986",
    volume = "29",
    note = "CORE ARGUMENT: Wood examines whether Cohen's functional explanations of relations of production by their effect on productive forces can be philosophically legitimate without specifying the causal mechanisms that would make such functional dependencies operative, and assesses how far Marx's own texts commit him to this style of explanation as opposed to a looser, non-functionalist form of historical materialism. RELEVANCE: A central piece in the functional-explanation controversy that is this domain's largest cluster; directly interrogates whether functionalism is where historical materialism's covert teleology, if any, actually resides. POSITION: Critical assessment of functional explanation as the foundation of historical materialism, sympathetic to a non-functionalist alternative reading of Marx.",
    keywords = "functional-explanation, Cohen, historical-materialism, determinism, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This paper is a critical examination of one central theme in Jon Elster's Making Sense of Marx; Elster's defense of 'methodological individualism' in social science and his related critique of Marx's use of 'functional explanation'. The paper does not quarrel with Elster's claim that the particular instances of functional explanation advanced by Marx are defective; what it criticizes is Elster's attempt to raise principled, philosophical objections to this type of explanation in the social sciences. It is argued that Elster's philosophical critique of functional explanation rests on a caricature of this kind of explanation, just as his critique of Marx's use of teleology in the philosophy of history rests on a caricature of the kinds of teleological claims Marx is concerned to make. The paper ends with a brief discussion of a recently published passage from Marx's notebooks of 1861–1863, where Elster claims to have found Marx explicitly criticizing capitalist exploitation as an injustice to the workers.",
    abstract_source = "openalex"
}

@misc{honderich1982against,
    author = "Honderich, Ted",
    title = "Against teleological historical materialism",
    year = "1982",
    volume = "25",
    number = "4",
    note = {CORE ARGUMENT: Honderich argues directly against teleological readings of historical materialism, including Cohen's functionalist reconstruction, contending that attributing to productive forces a tendency or disposition to develop — and explaining relations of production by that development — imports an unwarranted, quasi-purposive structure into what should be a straightforwardly causal, non-teleological materialist theory of history. RELEVANCE: One of the earliest and most explicit statements of the "covert teleology" charge against Cohen's reconstruction specifically (as opposed to the broader Popperian charge against historicism in general), making it central evidence for the domain's key question about functional explanation and teleology. POSITION: Anti-teleological, causal-materialist critique of Cohen's functionalist historical materialism.},
    keywords = "teleology, functional-explanation, Cohen, determinism, High, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Marx may be taken to hold that productive forces (e.g. the steam engine) explain productive relations (e.g. capitalism) more than the other way on, and that productive relations explain superstructures (e.g. the legal system) more than the other way on. There are no satisfactory standard causal understandings of these claims about explanatory primacy. That is, no standard causal understanding saves Marx from the traditional objection that relations very greatly affect forces, and superstructures very greatly affect relations. One satisfactorily articulated attempt to save Marx has been the attempt to understand the claims teleologically. Three such understandings can be distinguished, but they do not work. The first fails since it attempts to explain events by way of abstract objects. The second fails since it attempts to explain a thing by means of that thing. The third fails for a related reason. Each understanding also fails for another reason as fundamental. So‐called teleological explanations are in fact claims that standard causal explanations exist, which relevant explanations conflict with the ruling idea of Marx's philosophy, that history is somehow independent of men's consciousness and wills. There may be no evidence that Marx himself intended historical materialism to be understood teleologically. There may be evidence against.",
    abstract_source = "openalex"
}

@misc{cohen2013reply,
    author = "Cohen, G. A.",
    editor = "Wolff, Jonathan",
    title = "Reply to Elster on ``Marxism, Functionalism, and Game Theory''",
    year = "2013",
    note = "CORE ARGUMENT: Cohen responds to Elster's methodological-individualist objections to functional explanation in historical materialism, defending the view that functional explanations can be legitimate even without a fully specified elaborating mechanism, provided there is independent evidence of a functional correlation between explanandum and explanans (on the model of evolutionary biology prior to the articulation of genetic mechanisms). RELEVANCE: Cohen's direct rebuttal to the most sustained methodological challenge to his reconstruction, essential for presenting both sides of the functional-explanation dispute rather than only the critics' position. POSITION: Defense of functional explanation against methodological-individualist objections.",
    keywords = "functional-explanation, Cohen, Elster, methodological-individualism, High, METADATA\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc",
    abstract = "In this chapter, the author responds to Jon Elster's criticism of his use of functional explanation in his account of historical materialism. Elster rejects the association between Marxism and functional explanation, arguing that there is no scope for functional explanation in social science. He therefore concludes that the Marxist theory of society and history should abandon functional explanation and that it should, instead, draw for its explanations on the resources of game theory. The author offers an explanation of historical materialist theory that he attributes, on a textual basis, to Karl Marx, and that he articulates and defends in his book Karl Marx's Theory of History. He asserts that game theory cannot replace functional explanation within Marxist social analysis and that it has no place at the heart of historical materialism, alongside functional explanation.",
    abstract_source = "openalex"
}

@misc{elster1990marxism,
    author = "Elster, Jon",
    title = "Marxism and Methodological Individualism",
    year = "1990",
    address = "Oxford",
    note = "CORE ARGUMENT: Elster argues that adequate explanations in Marxist social theory must ultimately be grounded in the intentional actions of individuals, and that functionalist explanations of the kind Cohen offers — where social structures are explained by their beneficial consequences for other structures rather than by the intentions of agents who produce and sustain them — are explanatorily inadequate unless supplemented with an account of the individual-level mechanisms that generate the alleged functional correlation. RELEVANCE: The clearest statement of the methodological-individualist, agency-centered objection to functionalist historical materialism that organizes the structure/agency dimension of this domain; directly informs the later rational-choice Marxist reconstruction by Wright, Levine, and Sober. POSITION: Methodological individualism against functionalist explanation in Marxist theory.",
    keywords = "methodological-individualism, functional-explanation, Elster, structure-agency, High, METADATA\_CLEANED: booktitle, publisher, doi, pages, type:@incollection->@misc",
    abstract = "Abstract 'God is the productive forces.' This joke of Paul Lafargue's expresses well enough a particular Marxist approach that I shall take issue with in the present chapter. Such an approach involves seeking out the motor forces of history, as well as the stabilizing forces of societies. It uses abstractions such as 'productive forces', 'relations of production', 'classes', 'state', or 'ideologies' without indicating how these are anchored in individual actions, motivations, and beliefs. According to this view, history is the self-realization of Humanity, of Man rather than of men. Capitalist exploitation and domination are the fact of Capital, which takes precedence in the order of explanation over individual capitals.",
    abstract_source = "openalex"
}

@misc{dickman1990two,
    author = "Dickman, Joel",
    title = "Two Qualms about Functionalist Marxism",
    year = "1990",
    volume = "57",
    number = "4",
    note = "CORE ARGUMENT: Dickman raises two philosophy-of-science objections to Cohen-style functional explanation in Marxism: first, that the analogy to functional explanation in evolutionary biology is disanalogous in ways that undermine its explanatory legitimacy in the social case, and second, that even granting the analogy, functional explanations of this kind cannot do the specific explanatory work historical materialism requires of them (namely, explaining epochal transitions rather than mere stability). RELEVANCE: Supplies a philosophy-of-science perspective on the functional-explanation debate, complementing the more directly Marxological objections of Elster and Wood, and sharpening the question of whether functionalism smuggles in directionality (teleology) that a genuinely causal explanation would not license. POSITION: Philosophy-of-science critique of the biological analogy underlying Cohen's functionalism.",
    keywords = "functional-explanation, Cohen, philosophy-of-science, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "In Karl Marx's Theory of History: A Defence (1978), G. A. Cohen has developed a distinctively functionalist interpretation of historical materialism. In this paper I outline Cohen's novel reconstruction of Marx and subject it to two independent internal criticisms. I first argue that explanations cannot conform to Cohen's functionalist model. I then suggest that even if there could be explanations having the structure he has proposed, they would fail to be helpful in illuminating the causal kernel of Marx's theory. Finally I sketch a neglected but more promising approach to clarifying historical materialism, due to Geoffrey Hellman.",
    abstract_source = "openalex"
}

@misc{lukes1982can,
    author = "Lukes, Steven",
    title = "Can the Base be Distinguished from the Superstructure?",
    year = "1982",
    volume = "4",
    note = "CORE ARGUMENT: Lukes interrogates whether the base/superstructure distinction can be drawn in a way that is both non-trivial (the relations of production must be characterizable independently of the legal and political categories that supposedly belong to the superstructure) and textually faithful to Marx, arguing that standard formulations face a dilemma between circularity and historical inaccuracy. RELEVANCE: Directly addresses the domain's question about the status of the base/superstructure metaphor — whether it is a genuinely materialist architecture or an unstable device that covertly imports the very idealist categories (legal/political forms) it is meant to explain away. POSITION: Skeptical critique of the coherence of the base/superstructure distinction as standardly formulated.",
    keywords = "base-superstructure, historical-materialism, Marx, High, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = {Abstract This article considers Cohen's claim that the economic structure or base can be conceived independently of the superstructure by adressing his attempt to identify "a rechtsfrei (moralitätsfrei, etc.) economic structure to explain law (morals, etc.)". It examines his programme of presenting relations of production as a set of (non-normative) powers and constraints that 'match' the rights and obligations of property relations. It is argued that, first, Cohen does not carry through this programme rigorously but, second, he could not do so, since it cannot be carried out at all. Three arguments are advanced, the first two against the possibility of a determinate 'objective' account of such powers and constraints, the third against the possibility of abstracting norms (constitutive and regulative, formal and informal) from contractual relationships: it is argued that one cannot identify the powers and constraints embodied in norm-governed economic relationships independently of the norms which govern them. Alternative interpretations are considered of Cohen's programme that might escape these objections, but these are rejected as untrue to his purpose, and in any case ineffective. It is concluded that Cohen fails to distinguish base from superstructure in the manner required.},
    abstract_source = "openalex"
}

@misc{farrelly2005historical,
    author = "Farrelly, Colin",
    title = "Historical Materialism and Supervenience",
    year = "2005",
    volume = "35",
    number = "4",
    note = "CORE ARGUMENT: Farrelly proposes reconstructing the base/superstructure relation using the philosophical concept of supervenience — the superstructure supervenes on, without being reducible to, the economic base — as a way of preserving materialist explanatory priority while avoiding the difficulties Lukes and others raise about drawing the distinction in non-circular terms. RELEVANCE: Offers a contemporary technical alternative to functionalist readings of base/superstructure, directly engaging the question of whether a non-teleological, non-reductive materialist architecture for historical explanation is available. POSITION: Supervenience-based reconstruction of the base/superstructure relation as an alternative to functionalist and reductive readings.",
    keywords = "base-superstructure, supervenience, historical-materialism, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "In this article I put forth a new interpretation of historical materialism titled the supervenient interpretation. Drawing on the insights of analytical Marxism and utilizing the concept of supervenience, I advance two central claims. First, that Marx's synchronic materialism maintains that the superstructure supervenes naturally on the economic structure. Second, that diachronic materialism maintains that the relations of production supervene naturally on the forces of production. Taken together, these two theses help bring to the fore the central tenets of historical materialism. Furthermore, they help resolve what I call the problem of reductionism and the problem of verification.",
    abstract_source = "openalex"
}

@misc{ruben1981cohen,
    author = "Ruben, David-Hillel",
    title = "Cohen, Marx and the Primacy Thesis",
    year = "1981",
    volume = "11",
    note = {CORE ARGUMENT: Ruben scrutinizes Cohen's "primacy thesis" (that the character of the relations of production is explained by their suitability for developing the productive forces, rather than the reverse) and questions whether the textual and philosophical evidence Cohen marshals actually establishes primacy in the strong, explanatorily asymmetric sense Cohen's functionalism requires. RELEVANCE: A focused early critique of the specific thesis that gives Cohen's reconstruction its determinist, quasi-directional character; useful for showing how quickly Cohen's central claims attracted sustained analytic scrutiny. POSITION: Critical analytic scrutiny of the primacy thesis underlying Cohen's technological determinism.},
    keywords = "Cohen, primacy-thesis, determinism, historical-materialism, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "As Jon Elster remarked in an earlier review, G. A. Cohen's Karl Marx's Theory of History: A Defence 'sets a new standard for Marxist philosophy'. In one way, the praise is too faint. Existing paradigms of continental Marxist philosophy are marred by an absence of careful definition, clear and precise argumentation, and the sort of sustained discussion that is committed to the teasing out of the intellectual difficulties of the author's own position – in short, marred by an absence of those virtues in the attainment of which the philosophy practised in Britain, the United States, and the Scandinavian countries on the whole excels. Cohen would, presumably, agree that this has nothing intrinsically to do with Marx, or Marxism, but in the main arises from the fortuitous coupling of Marxism with continental philosophical fashions. What is perhaps less faint praise of Cohen is to say that his book is good philosophy (without the qualifying adjective 'Marxist'). It is an ingenious and imaginative volume, in which precision and detailed attention to argument count for everything.",
    abstract_source = "openalex"
}

@misc{taylor1980review,
    author = "Taylor, Charles",
    title = "G. A. Cohen Karl Marx's Theory of History: A Defense",
    year = "1980",
    volume = "10",
    note = "CORE ARGUMENT: Taylor's early critical notice of Cohen's book questions whether the sharp separation of productive forces from social relations that Cohen's functionalism requires is sustainable, given that productive forces themselves (skill, cooperation, organization) are arguably partly constituted by social relations — a criticism that bears on whether Cohen's reconstruction achieves genuine explanatory priority or merely stipulates it. RELEVANCE: An influential early philosophical response that helped set the terms of the subsequent functional-explanation debate; useful for establishing the reception history of Cohen's book among leading philosophers outside analytic Marxism proper. POSITION: Skeptical of the conceptual separability of forces and relations of production presupposed by Cohen's technological determinism.",
    keywords = "Cohen, review, historical-materialism, productive-forces, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@misc{suchting1972marx,
    author = "Suchting, W. A.",
    title = "Marx, Popper, and `historicism'",
    year = "1972",
    volume = "15",
    note = {CORE ARGUMENT: Suchting mounts a detailed rebuttal of Popper's charge that Marx's theory of history is a species of "historicism" in Popper's pejorative sense, arguing that Popper conflates several distinct claims (holism, essentialism, unconditional prediction, large-scale utopian engineering) that Marx's actual theory does not jointly endorse, and that Marx's claims about tendencies in productive-force development are considerably more modest than Popper's target. RELEVANCE: A sustained, close textual rebuttal of the Popperian "covert teleology/historicism" charge that is central to this domain's key questions, providing the strongest counter-case to Popper within the literature gathered here. POSITION: Defense of Marx against the charge of Hegelian-style historicism, distinguishing Marx's modest tendential claims from Popper's target.},
    keywords = "Popper, historicism, Marx, determinism, Medium, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "According to Sir Karl Popper, there is a harmful approach to the social sciences called 'historicism'. This takes their principal aim to be historical prediction of an unconditional sort and the chief means to this the discovery of laws of historical development. The chief exemplar is held to be Marx. This paper distinguishes two possible sorts of laws of historical development. Popper's arguments against each are rejected. Which sort it is most plausible to ascribe to Marx is considered. Four models of historical determinism are distinguished and the question of Marx's view or views on the question is discussed in terms of them.",
    abstract_source = "openalex"
}

@misc{hudelson1980poppers,
    author = "Hudelson, Richard",
    title = "Popper's critique of Marx",
    year = "1980",
    number = "3",
    note = "CORE ARGUMENT: Hudelson evaluates Popper's specific arguments against Marx's theory of history (as distinct from Popper's more general arguments against historicism), arguing that several of Popper's central charges — particularly regarding unconditional historical prediction — rest on a misreading of Marx's actual methodological commitments, which are more conditional and tendential than Popper allows. RELEVANCE: Complements Suchting's rebuttal with a more narrowly focused analysis of Popper's arguments specifically targeting Marx (rather than historicism in general), useful for isolating exactly which parts of the Popperian critique survive scrutiny. POSITION: Partial defense of Marx against Popper, conceding some force to the critique while rejecting its strongest formulations.",
    keywords = "Popper, Marx, historicism, critique, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, volume, pages, doi, type:@article->@misc"
}

@misc{casal2020gacohens,
    author = "Casal, Paula",
    title = "G. A. Cohen's historical materialism: a feminist critique",
    year = "2020",
    volume = "25",
    number = "3",
    note = {CORE ARGUMENT: Casal argues that Cohen's technological-determinist reconstruction of historical materialism, by privileging the development of productive forces as the motor of historical change, systematically obscures the causal and explanatory significance of reproductive labor, gender relations, and the household economy in historical transformation, and that a materialism attentive to these factors would look substantially different from Cohen's model. RELEVANCE: Extends the critique of Cohen beyond internal philosophy-of-explanation objections (Elster, Wood, Ruben) to a substantive critique of what counts as "material" and "productive" in the theory, bearing on whether Cohen's determinism inherits an unreflective, narrowly economistic inheritance from the Hegelian world-historical framework it claims to reject. POSITION: Feminist-materialist critique of the scope and priorities of Cohen's technological determinism.},
    keywords = "Cohen, feminist-critique, historical-materialism, determinism, Medium, METADATA\_CLEANED: journal, pages, doi, type:@article->@misc",
    abstract = "Forty years on, G. A. Cohen's reconstruction and defence of Marx's theory of history is still widely considered among the best of its kind, and it remains unsurpassed in clarity, argumentation and textual support. This article presents an under-explored critique of the theory that arises once we recognize that it is meant to apply to the circumstances of women as well as men. The article argues that, when extended to women, the reconstructed theory's predictions fail to materialize, its characterizations of historical stages fall apart, and its functional explanations appear implausible. In addition, although the theory claims to be able to explain the emergence and diffusion of different ideologies by their effects on productive development, it cannot plausibly explain the presence of sexist ideologies despite their pervasive and profound impact across history. The article concludes by showing that these flaws highlight the many respects in which Cohen's orthodox version of Marxism is a conservative ideology, and one that egalitarians in particular should view with suspicion.",
    abstract_source = "openalex"
}

@misc{coram1989social,
    author = "Coram, B. T.",
    title = "Social Relations and Forces of Production: A Criticism of Cohen's Defense of Materialism",
    year = "1989",
    volume = "15",
    note = "CORE ARGUMENT: Coram argues that Cohen's attempt to keep social relations of production conceptually and causally distinct from productive forces (a distinction his primacy thesis and functional explanation both require) fails, because the productive forces Cohen treats as explanatorily basic are themselves partly constituted by social relations, undermining the asymmetric explanatory priority central to Cohen's determinism. RELEVANCE: Reinforces and extends the Taylor-style objection that Cohen's forces/relations distinction cannot bear the explanatory weight of a determinist theory, directly bearing on whether historical materialism's claimed directionality is well-founded or an artifact of Cohen's categorial stipulations. POSITION: Conceptual critique of the forces/relations distinction underlying Cohen's technological determinism.",
    keywords = "Cohen, productive-forces, relations-of-production, determinism, Medium, INCOMPLETE, no-abstract, METADATA\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{post2021structure,
    author = "Post, Charles",
    title = "Structure and Agency in Historical Materialism: A Response to Knafo and Teschke",
    journal = "Historical Materialism",
    year = "2021",
    volume = "29",
    number = "3",
    note = {CORE ARGUMENT: Responding to Political Marxist critics who charge that his account of social-property relations reintroduces transhistorical "laws of motion" incompatible with genuine historical agency, Post argues that social-property relations can structure agents' actions and generate determinate "developmental patterns" specific to each mode of production without thereby positing ahistorical, quasi-teleological laws that operate independently of class struggle. RELEVANCE: A recent, live instance of the structure/agency debate within historical materialism, showing that the question of whether structural explanation in Marxism smuggles in an illegitimate determinism (of the kind associated with Hegelian necessity) remains actively contested in contemporary Political Marxism, not merely a legacy of the 1970s-80s Cohen debates. POSITION: Defends structural (social-property-relations) explanation in historical materialism against the charge of illegitimate, quasi-teleological determinism, while affirming the causal significance of class agency.},
    keywords = "structure-agency, historical-materialism, political-Marxism, Medium, METADATA\_CLEANED: pages, doi",
    abstract = "This essay argues that Knafo and Teschke fundamentally misread Brenner's original contribution to the transition debate. They equate his rejection of trans-historical or trans-modal laws of motion with the notion that social-property relations do not have strong rules of reproduction that structure the actions of agents and give rise to `developmental patterns' specific to each form of social labour. Knafo and Teschke's critique of Brenner's analysis of capitalist expansion and crisis is also theoretically and empirically questionable.",
    abstract_source = "s2"
}

@book{boveiri2024marxian,
    author = "Boveiri, Kaveh",
    title = "Marxian Totality",
    year = "2024",
    publisher = "Brill",
    note = {CORE ARGUMENT: Boveiri examines Marx's concept of social totality as developed through a critical inversion of Hegelian totality, arguing that Marx retains a structurally holistic conception of society and history from Hegel's logic while relocating its ground from Spirit's self-determination to the totality of material social relations and their contradictions. RELEVANCE: Directly engages the "inversion" thesis at the center of this domain — how much of Hegel's systematic, holistic conception of history Marx preserves even while rejecting its idealist metaphysical ground — complementing the narrower functional-explanation debate with a broader account of Marx's inheritance of Hegelian totality. POSITION: Argues for substantial structural continuity between Hegelian and Marxian conceptions of historical totality, mediated by a critical inversion of their metaphysical ground.},
    keywords = "Hegel, Marx, totality, dialectic, inversion, Medium, METADATA\_CLEANED: doi",
    abstract = "The present volume represents the first book-length monograph on the Marxian concept of totality as seen from a philosophical and sociopolitical perspective. Drawing on a large number of classical and contemporary works, Boveiri elucidates the distinctive features of Marxian totality with a particular focus on its methodology. The work has four fundamental elements, or moments. First, it develops arguments against undialectical conceptions of totality. Then it presents a critical reading of Hegelian totality focused on The Science of Logic. Its penultimate section examines the shortcomings of two well-known conceptions of totality, one by Georg Lukács, another by Karel Kosík, before a final section examines in detail the developmental characteristics of Marxian totality. The volume concludes with a chapter dealing with methodological implications.",
    abstract_source = "openalex"
}
