@misc{dahbour2017totality,
    author = "Dahbour, Omar",
    title = "Totality, Reason, Dialectics: The Importance of Hegel for Critical Theory from Lukács to Honneth",
    year = "2017",
    pages = "87--108",
    note = "CORE ARGUMENT: Traces how Hegel's categories of totality and reason are transmitted from Lukács through subsequent Frankfurt-School-adjacent critical theory down to Axel Honneth, arguing that the viability of critical theory as a distinctively dialectical (rather than merely normative) project depends on how much of this Hegelian inheritance is retained. RELEVANCE: Provides a genealogical map connecting Lukács's reification theory to later reception, useful for showing how the Hegelian totality concept both grounds and becomes contested within the critical-theory tradition descending from Marx's critique of idealism. POSITION: Hegelian-Marxist continuity thesis, tracking the diminishing but persistent role of Hegelian totality in critical theory.",
    keywords = "Lukacs, totality, reification, Frankfurt-School, Honneth, Medium, METADATA\\_CLEANED: booktitle, publisher, type:@incollection->@misc, METADATA\_CLEANED: doi",
    abstract = {Critical theory has usually been regarded as a unique amalgamation of ideas drawn from Marx, Weber, and Freud, among other sources. What this view tends to minimize or overlook is the unique role of the critical theorists, beginning with Georg Lukács (a critical theorist "before the fact"), in reviving, interpreting, and further developing a distinctively Hegelian approach to the problems of knowledge, culture, and politics. This chapter first demonstrates the role of critical theorists in reviving Hegelianism in the early twentieth century. Then, it outlines the role of Hegelian philosophy as the basis for concepts of totality in the thought of Georg Lukács and Max Horkheimer, and of rationality in the thought of Herbert Marcuse and Theodor Adorno. The critique of, and then return to, Hegel in the work of Jürgen Habermas and Axel Honneth is also considered. The chapter concludes with an evaluation of three historical interpretations of the significance of the Hegelian element in critical theory, a consideration of the limits of Hegelianism for critical theory, and a suggestion of a fourth interpretation.},
    abstract_source = "openalex"
}

@article{rockmore1992fichte,
    author = "Rockmore, Tom",
    title = "Fichte, Lask, and Lukács's Hegelian Marxism",
    journal = "Journal of the History of Philosophy",
    year = "1992",
    volume = "30",
    number = "4",
    note = {CORE ARGUMENT: Argues that Lukács's Hegelian reconstruction of Marxism in History and Class Consciousness is mediated as much by Neo-Kantian and Fichtean sources (particularly Emil Lask) as by Hegel directly, complicating any simple picture of a "return to Hegel." RELEVANCE: Shows that the philosophical genealogy of Lukács's anti-positivist Marxism is more heterogeneous than the Lukács-completes-Hegel narrative suggests, important for precisely locating what in Lukács's dialectic is Hegelian and what is Neo-Kantian/Fichtean. POSITION: Historical-philosophical reconstruction of Lukács's sources, qualifying the standard Hegelian-Marxist genealogy.},
    keywords = "Lukacs, Fichte, Neo-Kantianism, Hegelian-Marxism, Medium, METADATA\\_CLEANED: pages, doi",
    abstract = "With Karl Korsch, Georg Lukács is widely known as one of the two founders of Hegelian Marxism. Although Lukács is one of the most significant students of Hegel in this century, Marxist or otherwise, and although his Marxism is partially based on his reading of Hegel's position, it is an error to consider his Marxism as basically Hegelian for two reasons. First, Lukács's reading of classical German philosophy depends crucially on his creative extension of Kant's problem of the thing-in-itself to all of classical German philosophy from Kant to Hegel. Second, Lukács argues in detail that classical German philosophy is unable to resolve the problem of the thing-in-itself, but that the latter is resolved by Marx. Lukács's reading of Marx's solution of the Kantian problem, which he extends to all of classical German philosophy, depends on his appropriation of Fichte's position. This article discusses the nature and significance of Fichte's role, both directly and through the intermediary of Emil Lask, in the constitution of Lukács's distinctive form of Marxism, arguing that Lukács's Marxism is not only Hegelian, but Kantian, Fichtean, and neo-Kantian as well.",
    abstract_source = "openalex"
}

@misc{chari2010toward,
    author = "Chari, Anita",
    title = "Toward a Political Critique of Reification: Lukács, Honneth and the Aims of Critical Theory",
    year = "2010",
    volume = "36",
    note = {CORE ARGUMENT: Contrasts Lukács's political-economic account of reification, rooted in the commodity form and revolutionary class praxis, with Honneth's later recognition-theoretic reinterpretation of reification as a "forgetting" of primary intersubjective recognition, arguing that Honneth's move loses the critical purchase on capitalism that made Lukács's original category powerful. RELEVANCE: Directly addresses how far Lukács's Hegelian-Marxist reconstruction of Marx's critique of capitalism can be dissociated from its politically totalizing framework without losing its critical force — central to assessing what survives of Marx's Hegelian inheritance in later critical theory. POSITION: Defends the political-economic (Lukácsian) reading of reification against recognition-theoretic revisionism.},
    keywords = "Lukacs, reification, Honneth, critical-theory, High, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc",
    abstract = "This article engages Axel Honneth's recent work on Georg Lukács' concept of reification in order to formulate a politically relevant and historically specific critique of capitalism that is applicable to theorizing contemporary democratic practice. I argue that Honneth's attempt to reorient the critique of reification within the terms of a theory of recognition has done so at the cost of sacrificing the core of the concept, which forged a connection between the socio-political analysis of capitalist domination and an analysis of the unengaged, spectatorial stance of human beings toward the world, showing how they together impede emancipatory social transformation. In order to accomplish the unfinished task of rendering the critique of reification applicable to contemporary critical theory, I seek to synthesize the advantages of Honneth's approach, which focuses on the normative aspects of the critique of reification, with Lukács' emphasis on the practical, political-economic dimensions of reification and the historically specific pathologies of the capitalist social form.",
    abstract_source = "openalex"
}

@misc{kavoulakos2017philosophy,
    author = "Kavoulakos, Konstantinos",
    title = "Philosophy of Praxis or Philosophical Anthropology? Andrew Feenberg and Axel Honneth on Lukács's Theory of Reification",
    year = "2017",
    publisher = "Springer International Publishing",
    note = {CORE ARGUMENT: Compares Feenberg's "philosophy of praxis" reading of Lukács, which foregrounds practical, transformative rationality, with Honneth's "philosophical anthropology" reading, which grounds reification in a prior anthropological capacity for recognition, arguing the two readings imply divergent assessments of how thoroughly Lukács's reification theory remains tied to Hegelian dialectical totality. RELEVANCE: Clarifies competing frameworks for interpreting exactly how Hegelian Lukács's central category is, directly bearing on whether reification should be read as a dialectical-historical or quasi-transcendental anthropological concept. POSITION: Comparative analysis of two rival receptions of Lukács's Hegelian Marxism within contemporary critical theory.},
    keywords = "Lukacs, reification, Feenberg, Honneth, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{pitkin1987rethinking,
    author = "Pitkin, Hanna Fenichel",
    title = "Rethinking Reification",
    year = "1987",
    volume = "16",
    note = {CORE ARGUMENT: Critically examines the concept of reification as developed from Marx through Lukács, arguing that the concept trades on an ambiguous and ultimately untenable contrast between "authentic" unreified social relations and reified "thing-like" ones, and proposes a reconstruction that avoids this metaphysical baggage. RELEVANCE: Offers a sustained philosophical critique of the Lukácsian reification concept that is central to the Hegelian-Marxist tradition, useful for assessing whether the concept coherently expresses Marx's critique of idealist/naturalized social forms or imports unexamined Hegelian assumptions about an original, non-alienated subject-object unity. POSITION: Critical reconstruction of reification theory, skeptical of its Hegelian metaphysical commitments.},
    keywords = "Lukacs, reification, Hegel, critique, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, number, pages, doi, type:@article->@misc"
}

@article{negt1975theory,
    author = "Negt, Oskar",
    title = "Theory, Empiricism and Class Struggle: On the Problem of Constitution in Karl Korsch",
    journal = "Telos",
    year = "1975",
    volume = "1975",
    note = {CORE ARGUMENT: Reconstructs Korsch's theory of the "constitution" of Marxist theory out of the concrete historical struggles of the working class, arguing that for Korsch Marxist theory is not a set of empirical propositions to be verified but a moment internal to revolutionary practice itself, which is what commits Marxism to remaining "philosophy" rather than becoming positive science. RELEVANCE: Directly engages Korsch's central thesis in Marxism and Philosophy that Marxism must retain a dialectically self-reflective, non-positivist character, providing the theoretical vocabulary (theory-practice unity, historical constitution) needed to state precisely what Korsch's anti-positivism amounts to. POSITION: Sympathetic reconstruction of Korsch's theory-practice unity thesis against positivist and mechanistic Marxism.},
    keywords = "Korsch, theory-practice, positivism, Marxism-as-philosophy, High, METADATA\\_CLEANED: number, pages, doi",
    abstract = "Today, within the framework of the newly posed task of a revolutionary restoration of Marxism, it becomes increasingly urgent to find solutions to problems directly relating to three main areas: the establishment of a materialist social research (without which Marxist theory threatens to lose its empirical substance) which is necessitated by the given experience organized by the division of labor in the particular sciences; the reformulation of the concept of objective truth as found in a rudimentary but formally undeveloped form in the Theses on Feuerbach; and, finally, within the context of late capitalism, the specified determination of revolutionary, transforming, and historical praxis as the essence of the dialectic between forces and relations of production (as well as between production and class struggle), which materializes in the structure of the social objects and needs.",
    abstract_source = "openalex"
}

@article{browner1977karl,
    author = "Browner, Stephen Eric",
    title = "Karl Korsch: Revolutionary Theory",
    journal = "Telos",
    year = "1977",
    note = {CORE ARGUMENT: A review of Douglas Kellner's edited English-language collection Karl Korsch: Revolutionary Theory (University of Texas Press, 1977), situating Korsch's Marxism and Philosophy and later writings within the crisis of orthodox Marxism after 1917 and arguing that Korsch's insistence on the historicity of Marxist theory itself anticipates central themes of subsequent Western Marxism. RELEVANCE: Situates Korsch's anti-positivist, historicizing conception of Marxist theory within the broader crisis of Second/Third International orthodoxy, clarifying why Korsch's argument that "Marxism must remain a philosophy" was received as a scandal by party orthodoxy. POSITION: Historically contextualizing appraisal of Korsch as founding figure of Western Marxism.},
    keywords = "Korsch, Western-Marxism, historicism, orthodoxy, Medium, METADATA\\_CLEANED: volume, number, pages, doi",
    abstract = "Review of: Douglas Kellner, ed. Karl Korsch: Revolutionary Theory. Austin, Tex.: University of Texas Press, 1977. 299 pages.",
    abstract_source = "openalex"
}

@article{devlin2021karl,
    author = "Devlin, Nicholas",
    title = "Karl Korsch and Marxism's Interwar Moment, 1917--1933",
    journal = "History of European Ideas",
    year = "2021",
    volume = "48",
    abstract = "This article offers a major reinterpretation of the nature of interwar Marxist theory. It does so by offering a new reading of the work of Karl Korsch in the context of a network of ex-communist intellectuals. In Marxism and Philosophy (1923), Korsch responded to the split in the labour movement with a radical new claim to Marxist orthodoxy. Rather than engaging in Marx exegesis, he aimed to turn the Marxist 'method' on Marxism's own history. In the narrative he constructed, Bolshevik-inspired Communism appeared as the next logical step in the dialectic. But this argument rested on a historicisation of Marx's own writing that led to an unresolvable tension in Korsch's work that threatened to undermine its claim to Marxist orthodoxy. Once it is understood that Marxism was a political currency as much as a purely theoretical space of argument, Korsch's reluctance to resolve the tension one way or the other becomes understandable. This reinterpretation of Korsch's work challenges the 'Western Marxism' paradigm in which he has been read, showing that Korsch's work presupposed a reading of revolutionary success and potential rather than defeat and that he did not advocate a turn to superstructural or cultural questions in the manner supposed.",
    note = {CORE ARGUMENT: Reinterprets Korsch's Marxism and Philosophy as a historicizing intervention in interwar debates over Marxist orthodoxy rather than as straightforward Marx exegesis, arguing Korsch turned the Marxist method reflexively onto Marxism's own history, and that this generated an unresolved tension between claiming orthodoxy and historicizing Marx's writing itself. RELEVANCE: Directly revises the standard "Western Marxism" framing (associated with Lukács, Korsch, and Frankfurt) by showing Korsch's argument was oriented to revolutionary possibility rather than defeatist cultural retreat, complicating simple genealogies of the tradition this domain covers. POSITION: Revisionist intellectual history that challenges the retrospective "Western Marxism" categorization of Korsch.},
    keywords = "Korsch, Western-Marxism, historiography, orthodoxy, High, METADATA\\_CLEANED: number, pages, doi"
}

@misc{rockwell2018hegel,
    author = "Rockwell, Russell",
    title = "Hegel in Herbert Marcuse's Hegelian Marxism, Critical Theory, and Value Theory",
    year = "2018",
    publisher = "Springer International Publishing",
    note = "CORE ARGUMENT: Examines how Hegel's dialectic operates across the different phases of Marcuse's career — from Reason and Revolution's defense of Hegelian negativity, through Marcuse's engagement with Marx's Grundrisse, to his later value-theoretic concerns — arguing for continuity in Marcuse's use of Hegelian negation as a critical, non-affirmative category. RELEVANCE: Provides a career-spanning account of how one major Frankfurt School figure sustained a Hegelian dialectical framework specifically for critiquing both idealist philosophy and positivist social science, central to the key question of how Frankfurt School theorists deploy Hegelian dialectics against both poles. POSITION: Continuity thesis regarding Marcuse's Hegelian Marxism across his corpus.",
    keywords = "Marcuse, Hegel, Frankfurt-School, negativity, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@misc{anderson1993hegel,
    author = "Anderson, Kevin",
    title = "On Hegel and the Rise of Social Theory: A Critical Appreciation of Herbert Marcuse's Reason and Revolution, Fifty Years Later",
    year = "1993",
    volume = "11",
    number = "3",
    note = "CORE ARGUMENT: Reassesses Marcuse's Reason and Revolution (1941) fifty years after publication, arguing that Marcuse's central claim — that Hegel's dialectic of negativity anticipates and is completed by Marx's critical social theory — remains a defensible corrective to positivist social theory even where Marcuse's specific readings of Hegel have since been revised by scholarship. RELEVANCE: Provides a direct scholarly reassessment of Marcuse's founding Frankfurt School argument that Hegelian negative reason, rather than static idealist system-building, is what passes into Marx's critique of capitalist society — precisely the thesis at stake in this domain's account of Frankfurt School dialectics. POSITION: Sympathetic critical reappraisal of Marcuse's Hegelian-Marxist reading of Reason and Revolution.",
    keywords = "Marcuse, Hegel, Reason-and-Revolution, Frankfurt-School, High, METADATA\\_CLEANED: journal, doi, type:@article->@misc",
    abstract = "A critical reappraisal of Herbert Marcuse's Reason and Revolution: Hegel and the Rise of Social Theory (1941), fifty years after its original publication, assessing the enduring value and the limitations of Marcuse's reading of Hegel's dialectic as anticipating Marx's critical social theory.",
    abstract_source = "openalex"
}

@misc{finlayson2017hegel,
    author = "Finlayson, James Gordon",
    editor = "Moyar, Dean",
    title = "Hegel and the Frankfurt School",
    year = "2017",
    abstract = "Hegel's philosophy exerted a magnetic attraction on the various thinkers that comprise the Frankfurt school. This chapter aims to gauge and specify the relation that three members of the 'inner circle' of the Frankfurt school (Horkheimer, Adorno, and Marcuse) have to Hegel. It concludes that the young Horkheimer is a Hegelian-Marxist who endorses a qualified Hegelianism, while claiming that Hegel's idealist metaphysics had become obsolete and superseded by a combination of sociology, psychology, and materialist historiography. Adorno remains a more committed Hegelian (and a Marxist-Hegelian) who sees his own dialectical approach to philosophy as emerging from and consistent with an immanent criticism of Hegel. Both, however, tend to reject Hegel's philosophy of objective spirit as conservative apology for the Prussian state. Marcuse, by contrast, is a Hegelian-Marxist who has a more scholarly, nuanced, and charitable approach to Hegel, placing more emphasis on the critical moment in Hegel's conception of reason.",
    note = "CORE ARGUMENT: Compares the specific relations to Hegel held by Horkheimer, Adorno, and Marcuse, concluding that Horkheimer endorses only a qualified Hegelianism (rejecting Hegel's idealist metaphysics in favor of sociology and materialist history), Adorno remains the most committed Hegelian via immanent critique, and Marcuse offers the most scholarly and charitable reading, emphasizing Hegel's critical rather than systematic moment. RELEVANCE: Gives a differentiated, figure-by-figure account of exactly how the first-generation Frankfurt School used Hegelian dialectic against both idealist metaphysics and positivist/vulgar materialism, directly answering this domain's key question about Frankfurt School uses of Hegel. POSITION: Comparative analysis distinguishing degrees and kinds of Hegelianism among first-generation Frankfurt School theorists.",
    keywords = "Frankfurt-School, Horkheimer, Adorno, Marcuse, Hegel, High, METADATA\\_CLEANED: booktitle, publisher, doi, type:@incollection->@misc"
}

@book{postone1993time,
    author = "Postone, Moishe",
    title = "Time, Labor, and Social Domination",
    year = "1993",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Reinterprets Marx's mature critique of political economy as a fundamentally Hegelian, but non-humanist and non-class-subject-centered, critique of the abstract, quasi-automatic domination exercised by value and abstract labor time in capitalist society, arguing that both "traditional Marxism" (which affirms labor as trans-historically emancipatory) and Lukácsian Hegelian Marxism (which posits the proletariat as the Hegelian identical subject-object of history) misread this structure. RELEVANCE: Offers a major alternative reconstruction of Marx's relation to Hegel that neither collapses into Lukács's totality/class-subject model nor into Althusserian anti-Hegelian scientism, directly relevant to assessing what, in Marx's mature economic categories, remains genuinely Hegelian. POSITION: Distinct third position — a non-humanist, non-Lukácsian Hegelian-Marxist reading of Capital as critique of abstract domination.},
    keywords = "Postone, Hegel, abstract-domination, value-theory, High, METADATA\\_CLEANED: doi",
    abstract = "Moishe Postone undertakes a fundamental reinterpretation of Karl Marx's mature critical theory. He calls into question many of the presuppositions of traditional Marxist analyses and offers new interpretations of Marx's central arguments, developing concepts aimed at grasping the essential character and historical development of modern society and at overcoming the familiar dichotomies of structure and action, meaning and material life. According to this interpretation, Marx identifies the core of the capitalist system with an impersonal form of social domination generated by labor itself, rather than simply with market mechanisms and private property; proletarian labor and the industrial production process are characterized as expressions of domination rather than as means of human emancipation. This reformulation, Postone argues, provides the foundation for a critical social theory more adequate to late twentieth-century capitalism.",
    abstract_source = "openalex"
}

@misc{arthur2000from,
    author = "Arthur, Christopher J.",
    title = "From the Critique of Hegel to the Critique of Capital",
    year = "2000",
    publisher = "Palgrave Macmillan UK",
    note = {CORE ARGUMENT: Traces the trajectory from Marx's early critique of Hegel's Philosophy of Right to the systematic-dialectical structure of Capital, arguing that Marx's mature economic categories (value-form, capital as automatic subject) preserve a genuinely Hegelian dialectical logic even as they abandon Hegel's idealist content, so that Capital itself is best read as an immanent critique conducted in a transformed Hegelian method. RELEVANCE: Provides a "New Dialectics" account of Hegel's continued methodological presence in Marx's mature economic writing, offering a middle position between the humanist alienation-continuity thesis and the anti-Hegelian scientistic reading by locating Hegel's survival specifically at the level of dialectical method rather than either alienation-humanism or class-subject totality. POSITION: Systematic-dialectical reading emphasizing Hegel's methodological (not humanist-alienation) survival in Capital.},
    keywords = "Hegel, Marx, Capital, systematic-dialectic, dialectical-method, Medium, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc",
    abstract = "The thesis of this essay is that the critique of Hegel cannot be separated from the critique of capital, and that the critique of economic categories is greatly advanced if modelled on the critique of Hegel. It is in truth the very same critique that is to be employed. This identity arises in virtue of the fact that Hegel's standpoint may be seen as a philosophical absolutisation of the standpoint of capital, on the one hand; and in virtue of the nature of capital on the other, for the form of capital may be understood as homologous with that of Hegel's 'Idea'.",
    abstract_source = "openalex"
}

@misc{dunayevskaya2018theory,
    author = "Dunayevskaya, Raya",
    editor = "Dmitryev, Franklin",
    title = "The Theory of Alienation: Marx's Debt to Hegel",
    year = "2018",
    publisher = "Brill",
    abstract = {The topic "Marx's Debt to Hegel," is neither merely academic, nor does it pertain only to the historical period of Marx's lifetime. From the Hungarian revolt to the African revolutions, from the student demonstrators in Japan to the Negro revolution in the U.S., the struggle for freedom has transformed reality and pulled Hegelian dialectics out of the academic halls and philosophy books onto the living stage of history. It is true that this transformation of Hegel into a contemporary has been via Marx. It is no accident, however, that Russian Communism's attack on Marx has been via Hegel. Because they recognize in the so-called mystical Absolute "the negation of the negation," the revolution against themselves, Hegel remains so alive and worrisome to the Russian rulers today.},
    note = {CORE ARGUMENT: Argues, from the founding perspective of Marxist-Humanism, that Marx's theory of alienation is inseparable from his debt to the Hegelian dialectic of negativity (the "negation of the negation"), and that Soviet-era attacks on the young Marx's Hegelian-inflected humanism were simultaneously attacks on the revolutionary, self-transforming core of Hegel's dialectic that Marx had inherited and preserved. RELEVANCE: A primary Marxist-Humanist statement that alienation is a retained and deepened Hegelian category throughout Marx's work, directly representing one pole of this domain's central alienation/humanism debate, and explicitly framing the stakes (Stalinist "scientific" Marxism's rejection of both Hegel and the young Marx) that motivate the opposing anti-humanist position. POSITION: Marxist-Humanist continuity thesis: alienation as Marx's permanent, Hegel-derived critical category.},
    keywords = "Dunayevskaya, alienation, Hegel, Marxist-Humanism, negation-of-negation, High, METADATA\\_CLEANED: booktitle, pages, doi, type:@incollection->@misc"
}

@book{ollman1977alienation,
    author = "Ollman, Bertell",
    title = "Alienation",
    year = "1977",
    publisher = "Cambridge University Press",
    note = {CORE ARGUMENT: Reconstructs Marx's theory of alienation through his underlying "philosophy of internal relations" (a methodological legacy of Hegelian relational ontology), arguing that alienation names the rupture, under capitalism, of the internally related unity between the worker and his productive activity, its product, his species-being, and other workers — a unity that is restored, not abandoned, as the organizing logic of Marx's mature economic categories. RELEVANCE: One of the most sustained defenses of alienation as a structurally central, Hegelian-derived category running throughout Marx's work rather than a discarded early-humanist residue, providing the systematic counterpart to Meszaros's and Petrović's arguments on the humanist side of the debate. POSITION: Humanist-continuity thesis grounded in a relational (quasi-Hegelian) reading of Marx's dialectical method.},
    keywords = "Ollman, alienation, internal-relations, Hegel, humanism, High, METADATA\\_CLEANED: doi",
    abstract = "In this book, Professor Ollman reconstructs Marx's theory of alienation from its constituent parts and offers it as a vantage point from which to view the rest of Marxism. The book further contains a detailed examination of Marx's philosophy of internal relations, the neglected logical foundation of his method, and provides a systematic account of Marx's conception of human nature. In this edition Professor Ollman replies to his critics in 'More on internal relations,' provides a more systematic discussion of Marx's theory of ideology, and sets the treatment of political alienation within the broader framework of Marx's theory of the state as a model of how an approach based on internal relations can be used to integrate various apparently contradictory interpretations of Marx's views.",
    abstract_source = "openalex"
}

@misc{petrovic1963marx,
    author = "Petrovic, Gajo",
    title = "Marx's Theory of Alienation",
    year = "1963",
    volume = "23",
    number = "3",
    note = {CORE ARGUMENT: Argues, from the Yugoslav Praxis-school perspective, that alienation is the central category of Marx's entire theoretical project, not a youthful, pre-scientific concern superseded by the categories of Capital, because the mature critique of commodity fetishism and capital as an alien, self-moving power is itself a continuation and deepening of the 1844 Manuscripts' analysis of estranged labor. RELEVANCE: An early and influential statement of the humanist-continuity position that directly anticipates and parallels Meszaros's and Ollman's later book-length arguments, useful as a compact, citable articulation of the "alienation persists" thesis this domain's key questions ask about. POSITION: Humanist-continuity thesis, articulated from within the Yugoslav Praxis school of Marxist humanism.},
    keywords = "Petrovic, alienation, humanism, Praxis-school, High, INCOMPLETE, no-abstract, METADATA\\_CLEANED: journal, doi, type:@article->@misc"
}

@article{levine1976marxism,
    author = "Levine, Norman",
    title = "Marxism and Hegel",
    journal = "The American Historical Review",
    year = "1976",
    note = {CORE ARGUMENT: A review of Lucio Colletti's Marxism and Hegel (trans. Lawrence Garner), engaging Colletti's central claim that Hegel's dialectical logic — resting on the identity and mutual interpenetration of contradictory opposites — is fundamentally incompatible with Marx's materialist, non-contradictory conception of real oppositions, so that Marx's mature thought requires a decisive break from Hegelian dialectical logic rather than its completion. RELEVANCE: Represents the anti-Hegelian pole of this domain's alienation/humanism debate through direct engagement with Colletti's argument that dialectical "contradiction" is a category error when applied to real, non-logical oppositions in nature and society — the clearest logical (rather than merely political) case against reading Marx as a completion of Hegel. POSITION: Engages and assesses Colletti's anti-Hegelian, anti-dialectical-materialist reading of Marx.},
    keywords = "Colletti, Hegel, dialectical-logic, anti-Hegelian, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: volume, number, doi"
}

@book{anderson2022lenin,
    author = "Anderson, Kevin B.",
    title = "Lenin, Hegel, and Western Marxism",
    year = "2022",
    publisher = "Brill",
    note = {CORE ARGUMENT: Examines Lenin's 1914-15 Hegel Notebooks and argues that Lenin's serious, sympathetic engagement with Hegel's Science of Logic constitutes an underappreciated precursor to and resource for the Hegelian Marxism later developed independently by Lukács and Korsch, complicating any sharp opposition between "orthodox" Leninist Marxism and Western Marxist Hegelianism. RELEVANCE: Extends this domain's scope by showing that the impulse to reread Marx through Hegel was not confined to Lukács, Korsch, and the Frankfurt School but had a parallel, largely unpublished counterpart within Bolshevik theory itself, complicating the standard contrast between Second/Third International orthodoxy and Western Marxist Hegelianism. POSITION: Revisionist argument for a Hegelian-Marxist reading of Lenin, bridging orthodox and Western Marxist traditions.},
    keywords = "Lenin, Hegel, Western-Marxism, dialectical-logic, Medium, INCOMPLETE, no-abstract, METADATA\\_CLEANED: doi"
}
